// The search keys that find the code implementing each keyword, for the
// Pilot / Rust column of the keyword matrix.
//
// For each keyword: Rust keys (seed token `TokenKind::Kw*`, modifier act
// `ModAct::*`, AST node kinds `NodeKind::*`, or another identifier), Pilot
// keys (node kinds `nk_*()` or another identifier), and concept words: a
// function or file whose name holds one as an `_`-separated part is code for
// the keyword. The tool adds on its own: the keyword's receptor bindings from
// stdlib/core/core.pilot (`(kind, sub)` and `is_rec(kind)`), its
// `nameof(word)` and the `word(..) => quote` syntax rules written for it.
// A keyword missing here is found only through those.
pkg km.keys;

/// The search keys of one keyword; each list is words separated by spaces.
pub struct SearchKeys {
    pub word: str;
    pub rust: str;
    pub pilot: str;
    pub parts: str;
}

fn search_keys(word: str, rust: str, pilot: str, parts: str) -> SearchKeys {
    return SearchKeys { word: word, rust: rust, pilot: pilot, parts: parts };
}

/// The table, by keyword.
pub fn search_key_table() -> Map<str, SearchKeys> {
    let rows: List<SearchKeys> = [
        search_keys(nameof(Align), "", "", "align layout"),
        search_keys(nameof(Flags), "", "", "flags bitflags"),
        search_keys(nameof(Stack), "", "", "stack"),
        search_keys(nameof(__engine), "TokenKind::KwEngine", "", ""),
        search_keys(nameof(adapter), "", "", "adapter"),
        search_keys(nameof(as), "", "", "cast casts convert"),
        search_keys(nameof(asm), "TokenKind::KwAsm NodeKind::PolyglotBlock", "", "asm polyglot"),
        search_keys(nameof(assembly), "NodeKind::PolyglotBlock", "", "polyglot"),
        search_keys(nameof(assert), "", "", "assert"),
        search_keys(nameof(assume), "", "", "hint hints"),
        search_keys(nameof(async), "ModAct::Async", "", "async"),
        search_keys(nameof(atomic), "", "", "atomic"),
        search_keys(nameof(await), "", "", "await select"),
        search_keys(nameof(become), "", "", "become tail"),
        search_keys(nameof(break), "NodeKind::BreakStmt", "nk_break()", "break"),
        search_keys(nameof(call), "", "", "call_quote"),
        search_keys(nameof(case), "NodeKind::MatchArm", "nk_arm()", "arm arms pattern patterns"),
        search_keys(nameof(catch), "NodeKind::CatchClause NodeKind::CatchRecoveryExpr", "nk_catch() nk_catch_recovery()", "catch"),
        search_keys(nameof(coalesce), "", "nk_coalesce()", "coalesce"),
        search_keys(nameof(commit), "", "", "sql"),
        search_keys(nameof(comptime), "TokenKind::KwComptime NodeKind::ComptimeExpr", "nk_comptime()", "comptime"),
        search_keys(nameof(const), "ModAct::Const NodeKind::ConstDecl", "nk_const()", "const consts"),
        search_keys(nameof(context), "", "", "context"),
        search_keys(nameof(continue), "NodeKind::ContinueStmt", "nk_continue()", "continue"),
        search_keys(nameof(database), "", "", "database sql"),
        search_keys(nameof(deadline), "", "", "deadline rt"),
        search_keys(nameof(default), "NodeKind::PatWildcard", "nk_pat_wildcard()", "default exhaustive"),
        search_keys(nameof(defer), "TokenKind::KwDefer NodeKind::DeferStmt", "nk_defer()", "defer"),
        search_keys(nameof(each), "", "", "each"),
        search_keys(nameof(else), "", "", "else"),
        search_keys(nameof(ensures), "", "", "contract contracts ensures"),
        search_keys(nameof(enter), "", "", "lifecycle"),
        search_keys(nameof(enum), "NodeKind::TypeAdtDecl NodeKind::AdtVariant", "nk_adt() nk_variant()", "enum variant variants"),
        search_keys(nameof(errdefer), "", "", "errdefer"),
        search_keys(nameof(exit), "", "", "lifecycle"),
        search_keys(nameof(export), "", "", "visibility vis export"),
        search_keys(nameof(ext), "ModAct::Ext NodeKind::ExtendDecl", "nk_extend()", "ext extend extension"),
        search_keys(nameof(extern), "NodeKind::PolyglotBlock", "", "polyglot extern foreign"),
        search_keys(nameof(field), "", "", "accessor accessors property"),
        search_keys(nameof(file), "", "", "visibility vis"),
        search_keys(nameof(flat), "", "", "flat flatten splat"),
        search_keys(nameof(fn), "TokenKind::KwFn NodeKind::FnDecl NodeKind::LambdaExpr", "nk_fn() nk_lambda()", ""),
        search_keys(nameof(for), "NodeKind::ForExpr", "nk_for()", "for enumerator"),
        search_keys(nameof(frame), "AbiFrame", "AbiFrame", "call_quote"),
        search_keys(nameof(from), "", "", "query linq"),
        search_keys(nameof(get), "NodeKind::IndexerDecl", "nk_indexer()", "accessor accessors property properties getter"),
        search_keys(nameof(grad), "", "", "call_quote grad dual"),
        search_keys(nameof(guard), "NodeKind::GuardStmt", "nk_guard()", "guard"),
        search_keys(nameof(if), "TokenKind::KwIf NodeKind::IfExpr", "nk_if()", ""),
        search_keys(nameof(in), "", "", "membership"),
        search_keys(nameof(int), "", "", "visibility vis"),
        search_keys(nameof(interface), "TokenKind::KwInterface NodeKind::InterfaceDecl", "nk_interface()", "interface interfaces"),
        search_keys(nameof(invariant), "", "", "invariant invariants"),
        search_keys(nameof(iso), "ModAct::Iso", "", "iso isolated"),
        search_keys(nameof(isolate), "", "", "isolate"),
        search_keys(nameof(let), "TokenKind::KwLet NodeKind::LetStmt", "nk_let()", ""),
        search_keys(nameof(lib), "", "", "polyglot"),
        search_keys(nameof(loop), "TokenKind::KwLoop NodeKind::WhileStmt", "nk_while()", "loop loops"),
        search_keys(nameof(lvl), "ModAct::Ring", "", "clearance ring"),
        search_keys(nameof(nameof), "", "", "nameof"),
        search_keys(nameof(noalloc), "ModAct::NoAlloc", "", "noalloc"),
        search_keys(nameof(old), "", "", "contract contracts"),
        search_keys(nameof(op), "NodeKind::OperatorDecl", "nk_operator()", "operator operators op"),
        search_keys(nameof(open), "", "", "visibility vis"),
        search_keys(nameof(packed), "", "", "packed layout"),
        search_keys(nameof(pairs), "", "", "pairs"),
        search_keys(nameof(partial), "ModAct::Partial", "", "partial"),
        search_keys(nameof(periodic), "", "", "periodic rt"),
        search_keys(nameof(pkg), "NodeKind::ImportDecl", "", "visibility vis package"),
        search_keys(nameof(plan), "EffectPlan", "EffectPlan", "call_quote"),
        search_keys(nameof(priv), "", "", "visibility vis"),
        search_keys(nameof(prot), "", "", "visibility vis"),
        search_keys(nameof(pub), "", "", "visibility vis"),
        search_keys(nameof(pure), "ModAct::Pure", "", "pure purity effects"),
        search_keys(nameof(quote), "TokenKind::KwQuote", "", "quote"),
        search_keys(nameof(ref), "TokenKind::KwRef", "", "borrow borrows alias"),
        search_keys(nameof(region), "", "", "region arena"),
        search_keys(nameof(requires), "", "", "contract contracts requires"),
        search_keys(nameof(return), "TokenKind::KwReturn NodeKind::ReturnStmt", "nk_return()", "return exits"),
        search_keys(nameof(rollback), "", "", "sql"),
        search_keys(nameof(savepoint), "", "", "sql"),
        search_keys(nameof(scope), "NodeKind::ScopeDecl", "nk_scope()", "scope lifecycle"),
        search_keys(nameof(select), "", "", "select"),
        search_keys(nameof(self), "", "", "receiver"),
        search_keys(nameof(set), "NodeKind::IndexerDecl", "nk_indexer()", "setter setters property properties"),
        search_keys(nameof(sig), "", "", "call_quote signal reactive"),
        search_keys(nameof(sizeof), "", "", "sizeof size"),
        search_keys(nameof(spawn), "", "", "spawn select"),
        search_keys(nameof(splat), "", "", "splat spread"),
        search_keys(nameof(splice), "", "", "splice call_quote quote"),
        search_keys(nameof(static), "ModAct::Static", "", "static"),
        search_keys(nameof(struct), "TokenKind::KwStruct NodeKind::StructDecl", "nk_struct()", "struct structs record records"),
        search_keys(nameof(switch), "NodeKind::MatchExpr", "nk_match()", "switch match"),
        search_keys(nameof(sync), "", "", "sync"),
        search_keys(nameof(syntax), "", "", "syntax macro macros"),
        search_keys(nameof(then), "", "", "then"),
        search_keys(nameof(transaction), "", "", "transaction sql"),
        search_keys(nameof(try), "NodeKind::TryStmt NodeKind::TryPropagateExpr", "nk_try() nk_try_propagate()", "try"),
        search_keys(nameof(type), "", "", "alias aliases"),
        search_keys(nameof(type_construct), "", "", "type_construct construct"),
        search_keys(nameof(unit), "NodeKind::UnitLit unit_literal UNIT_LITERAL HOOK_UNIT_LITERAL compile_unit_lit", "nk_unit_lit() unit_literal unit_decl bind_unit_literal lower_unit_literal convert_unit_literal_to_base unit_literal_call", "units dimension dimensional unit_decl unit_literal"),
        search_keys(nameof(unreachable), "", "", "hint hints unreachable"),
        search_keys(nameof(until), "NodeKind::WhileStmt", "nk_while()", "until"),
        search_keys(nameof(use), "NodeKind::ImportDecl", "", "import imports module modules"),
        search_keys(nameof(value), "", "", "setter setters"),
        search_keys(nameof(var), "ModAct::Mut NodeKind::VarStmt", "nk_var()", "var mutable"),
        search_keys(nameof(where), "", "", "query linq"),
        search_keys(nameof(while), "NodeKind::WhileStmt", "nk_while()", "while loop loops"),
        search_keys(nameof(with), "", "", "with"),
        search_keys(nameof(within), "", "", "within rt"),
        search_keys(nameof(without), "", "", "without"),
        search_keys(nameof(yield), "TokenKind::KwYield NodeKind::YieldStmt", "nk_yield()", "generator yield"),
    ];
    var out: Map<str, SearchKeys> = [:];
    for row in rows {
        out.set(row.word, row);
    }
    return out;
}
