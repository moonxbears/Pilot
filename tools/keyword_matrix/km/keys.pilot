// The search keys that find the code implementing each keyword, for the
// Pilot / Rust column of the keyword matrix.
//
// For each keyword: Rust keys (seed token `TokenKind::Kw*`, modifier act
// `ModAct::*`, AST node kinds `NodeKind::*`, or another identifier), Pilot
// keys (node kinds `nk_*()` or another identifier), and concept words: a
// function or file whose name holds one as an `_`-separated part is code for
// the keyword. The tool adds on its own: the keyword's receptor bindings from
// stdlib/core/core.pilot (`(kind, sub)` and `is_rec(kind)`), its
// `nameof(word)` and the `word(..) => quote` syntax rules written for it.
// A keyword missing here is found only through those.
pkg km.keys;

/// The search keys of one keyword; each list is words separated by spaces.
pub struct SearchKeys {
    pub word: str;
    pub rust: str;
    pub pilot: str;
    pub parts: str;
}

fn search_keys(word: str, rust: str, pilot: str, parts: str) -> SearchKeys {
    return SearchKeys { word: word, rust: rust, pilot: pilot, parts: parts };
}

/// The table, by keyword.
pub fn search_key_table() -> Map<str, SearchKeys> {
    let rows: List<SearchKeys> = [
        search_keys("Align", "", "", "align layout"),
        search_keys("Flags", "", "", "flags bitflags"),
        search_keys("Stack", "", "", "stack"),
        search_keys("__engine", "TokenKind::KwEngine", "", ""),
        search_keys("adapter", "", "", "adapter"),
        search_keys("as", "", "", "cast casts convert"),
        search_keys("asm", "TokenKind::KwAsm NodeKind::PolyglotBlock", "", "asm polyglot"),
        search_keys("assembly", "NodeKind::PolyglotBlock", "", "polyglot"),
        search_keys("assert", "", "", "assert"),
        search_keys("assume", "", "", "hint hints"),
        search_keys("async", "ModAct::Async", "", "async"),
        search_keys("atomic", "", "", "atomic"),
        search_keys("await", "", "", "await select"),
        search_keys("become", "", "", "become tail"),
        search_keys("break", "NodeKind::BreakStmt", "nk_break()", "break"),
