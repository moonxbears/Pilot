        search_keys("catch", "NodeKind::CatchClause NodeKind::CatchRecoveryExpr", "nk_catch() nk_catch_recovery()", "catch"),
        search_keys("coalesce", "", "nk_coalesce()", "coalesce"),
        search_keys("commit", "", "", "sql"),
