// ==============================================================================
// FILE: tools/byte_rank.pilot
// Measures how often each byte value occurs in a corpus of text and prints
// stdlib/core/byte_rank.pilot, the rank table string search uses.
// ==============================================================================
// Usage (the corpus the checked-in table was measured on):
//
//   pilot run tools/byte_rank.pilot -- $(find stdlib selfhost docs runtime/c \
//       -name '*.pilot' -o -name '*.md' -o -name '*.h' | sort) \
//       > stdlib/core/byte_rank.pilot
//
// Each byte value's rank is its position when the 256 values are sorted by
// how often they occur, rarest first (ties by byte value): rank 0 is the
// rarest. Rank only orders bytes, so any corpus close to what programs
// search gives a table that works; one far from it only makes search pick
// worse anchors, never wrong answers.
use std.env;
use Pilot.Core.File;

fn main() {
    var counts: List<i64> = [];
    var b = 0;
    while b < 256 {
        counts.push(0);
        b = b + 1;
    }
    var files = 0;
    var total = 0;
    for path in env.args() {
        let text = File.read_text(path);
        let n = text.len();
        var i: usize = 0;
        while i < n {
            let x = text.byte_at(i) as i64;
            counts[x] = counts[x] + 1;
            i = i + 1;
        }
        files = files + 1;
        total = total + n;
    }
    // A byte's rank: how many byte values are rarer, or as rare and lower.
    var rank: List<i64> = [];
    b = 0;
    while b < 256 {
        var below = 0;
        var c = 0;
        while c < 256 {
            if counts[c] < counts[b] || (counts[c] == counts[b] && c < b) { below = below + 1; }
            c = c + 1;
        }
        rank.push(below);
        b = b + 1;
    }
    print("// ==============================================================================");
    print("// FILE: stdlib/core/byte_rank.pilot");
    print("// How common each byte value is in text, for choosing search anchors.");
    print("// ==============================================================================");
    print("// Generated by tools/byte_rank.pilot (which says how to run it again) from");
    print(f"// {files} files, {total} bytes of this repository's Pilot, Markdown and C.");
    print("// `byte_rank()[b]` is byte value b's position when the 256 values are");
    print("// sorted rarest first: 0 is the rarest. Substring search compares the two");
    print("// rarest bytes of the needle at each position before anything else");
    print("// (runtime/c/pilot_rt_str.h), so it seldom stops where the needle is not.");
    print("// The C emitter writes this table into every module that searches text");
    print("// (selfhost/transpile/c_family.pilot).");
    print("pub pkg Pilot.Core.ByteRank;");
    print("");
    print("pub fn byte_rank() -> List<i64> => [");
    var row = 0;
    while row < 16 {
        var line = "   ";
        var c = 0;
        while c < 16 {
            line = line + f" {rank[row * 16 + c]},";
            c = c + 1;
        }
        print(line);
        row = row + 1;
    }
    print("];");
}
