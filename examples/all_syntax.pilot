// ==============================================================================
// Pilot Omnibus Syntax Showcase: Complete Canonical Language Specification
// ==============================================================================
// Demonstrates every canonical syntactic construct, modifier, operator,
// 2-bit hardware lattice contract, distributive header, and homoiconic form
// available in the Pilot programming language.

// ==============================================================================
// 1. Preprocessor Directives
// ==============================================================================
#define PILOT_OMNIBUS_SHOWCASE
#define FEATURE_EXPERIMENTAL
#undef LEGACY_MODE
#pragma once

#region Type System and Model Definitions

// ==============================================================================
// 2. Module Imports & Foreign Library Declarations
// ==============================================================================
use Pilot.Math as math;
use Pilot.Sys as system;
use Pilot.Collections.{HashMap};

extern "python" lib "numpy" {
    fn polyglot_array_rank() -> i64;
}

extern "c" lib "libc" fn pilot_puts(msg: str) -> i32;

extern "rust" lib "libphysics" {
    fn simulate_step(dt: f32) -> void;
    fn get_particle_count() -> i32;
    fn compute_impulse(mass: f32, velocity: f32) -> f32;
}

extern "csharp" lib "System.Data" {
    struct SqlConnection : IValue {
        pub:
            fn open() -> void;
            fn close() -> void;
    }
}

// ==============================================================================
// 3. Structs, Interfaces, Bundles, Facets, Enums, Typestates & Actors
// ==============================================================================

pub struct Point : IValue {
    pub:
        x: f64;
        y: f64;
}

pub struct Config : IValue {
    pub:
        host: str;
        port: i64;
        secure: bool;
}

pub struct Vector3 : IValue {
    pub:
        x: f64;
        y: f64;
        z: f64;

        op + (other: Vector3) -> Vector3 {
            return Vector3(self.x + other.x, self.y + other.y, self.z + other.z);
        }
}

pub interface ISerializable {
    fn serialize() -> str;
}

pub interface IDeserializable<T> {
    fn deserialize(payload: str) -> T;
}

// Algebraic Sum Types (`enum` with Payload Variants)
pub enum Shape {
    Circle(radius: f64),
    Rectangle(width: f64, height: f64),
    Polygon(pts: Point[]),
    Origin,
}

[Typestate]
pub enum ConnectionState {
    Disconnected,
    Connecting,
    Connected,
    Reconnecting(i64),
}

// Field Bundle (`*Bundle`) & Method Facet (`*Facet`) Composition
pub struct NodeIdentityBundle : IValue {
    pub:
        var node_epoch: i64 = 1;
}

pub struct NodeDiagnosticsFacet {
    pub pure fn health_code() -> i64 => 200;
}

// Rich Struct with Distributive Headers, Implicit Properties & Fluid Builders
pub struct NetworkNode : IValue {
    *NodeIdentityBundle;
    *NodeDiagnosticsFacet;

    priv:
        var _id: i64 = 0;
        var _name: str = "node";

    pub:
        var tags: str[] = [];
        var phase: ConnectionState = ::Disconnected;

        // Implicit property (`field` backing slot + `value` setter parameter):
        status: str = "idle" {
            get => field;
            set => { field = value; }
        }

        self(id: i64, name: str) {
            ._id = id;
            ._name = name;
            .status = "initialized";
        }

        pure fn get_id() -> i64 => ._id;
        pure fn get_name() -> str => ._name;

        var fn set_title(title: str) -> NetworkNode {
            ._name = title;
            return self;
        }

        var fn set_status(st: str) -> NetworkNode {
            .status = st;
            return self;
        }

        var fn add_tag(tag: str) -> NetworkNode {
            .tags.append(tag);
            return self;
        }
}

[Actor]
pub struct EventBus : IValue {
    pub:
        var event_count: i64 = 0;

        async var fn publish(topic: str, payload: str) -> void {
            .event_count += 1;
        }
}

// Named Scoped Lexical Extension (`:` target syntax)
pub ext StringHelpers : str {
    pub pure fn shout() -> str {
        return self + "!";
    }
}

// Type Adapter Conversion
adapter str -> i64 {
    return 42;
}

#endregion Type System and Model Definitions

// ==============================================================================
// 4. Module-Level Bindings & Homoiconic Syntax Rules
// ==============================================================================
pub let MAX_CONNECTIONS: i64 = 4096;
pub let APP_NAME: str = "Pilot Omnibus";
priv var g_transaction_id: i64 = 1000;

pub syntax {
    log_metric(name, value) => quote {
        print($name + ": " + $value)
    };
}

// ==============================================================================
// 5. Functions, Attributes, Design-by-Contract & Closures
// ==============================================================================

pub pure fn square(x: i64) -> i64 => x * x;

pub pure fn identity<T>(val: T) -> T => val;

comptime fn compute_factorial(n: i64) -> i64 {
    var acc = 1;
    for i in 2..=n {
        acc = acc * i;
    }
    return acc;
}

let FACT_5: i64 = comptime(compute_factorial(5));

pub fn safe_bank_withdraw(var balance: i64, amount: i64) -> i64
    requires amount > 0 && balance >= amount
    ensures result == old(balance) - amount
{
    balance = balance - amount;
    return balance;
}

pub pure fn factorial(n: i64) -> i64 {
    if n <= 1 {
        return 1;
    }
    return n * factorial(n - 1);
}

pub async fn fetch_remote_status(endpoint: str) -> str {
    return "ONLINE: " + endpoint;
}

pub fn get_service_data(db: str) -> str
    where context(db: str)
{
    return "Data queried from: " + db;
}

pub pure fn ComputeImpulse(mass: f64, velocity: f64) -> f64 {
    return 0.5 * mass * velocity * velocity;
}

// ==============================================================================
// 6. Statement & Expression Tour
// ==============================================================================
pub database AppDb {
    pub uri: str;
}

pub fn run_omnibus_showcase() -> void {
    print("=== Pilot Omnibus Syntax Tour ===");

    // --- 6.1 Variable Bindings, Distributive Blocks & Primitives ---
    let immutable_int: i64 = 42;
    let hex_val: i64 = 0x2A;
    let bin_val: i64 = 0b101010;
    let oct_val: i64 = 0o52;
    let float_val: f64 = 3.1415926535;
    let scientific: f64 = 1.0e-4;
    let boolean_val: bool = true;
    let char_val: char = 'P';
    let f_string: str = f"Interpolated integer: {immutable_int}, float: {float_val}";

    // Distributive binding block (`AGENTS.md` §2.9):
    let i64 {
        batch_a = 10,
        batch_b = 20,
        batch_c = 12,
    };

    var mutable_counter: i64 = batch_a + batch_b + batch_c;
    mutable_counter += 1;
    mutable_counter *= 2;

    let counter_ref: ref<i64> = ref mutable_counter;

    // --- 6.2 Real-Time Duration, Frequency & Memory Literals ---
    let clk_ns = 25ns;
    let sensor_us = 250us;
    let cycle_ms = 10ms;
    let timeout_s = 2s;
    let freq_khz = 50kHz;
    let freq_ghz = 2.4GHz;
    let buffer_kb = 64KB;
    let cache_mb = 16MB;

    // --- 6.3 Collections, Splat (`*`) & Key-Value Pairs (`**`) ---
    let numbers_list: i64[] = [1, 2, 3, 4, 5,];
    let string_map: map<str, i64> = ["alpha": 1, "beta": 2, "gamma": 3,];
    let number_tuple = (10, "tuple_element", true, 3.14,);
    let matrix_2d = [[1.0, 2.0,], [3.0, 4.0,],];

    let spread_list = [0, *numbers_list, 99,];
    let first_elem = numbers_list[0];
    let sliced_sublist = numbers_list[1..4];
    let map_lookup = string_map["alpha"];

    // 3-Tier `for` collection yield expression:
    let odd_squares: i64[] = for x in numbers_list {
        if x % 2 != 0 {
            yield x * x;
        }
    };

    // --- 6.4 Control Flow: `if` / `else if` / `else` ---
    let category = if immutable_int > 100 {
        "high"
    } else if immutable_int < 0 {
        "negative"
    } else {
        "standard"
    };

    // --- 6.5 Loops: `while`, `until`, 3-Tier `for` (`ScalarBreak` + `then`) ---
    var loop_i = 0;
    while loop_i < 5 {
        loop_i += 1;
    }

    var bounded_i = 0;
    until bounded_i >= 100 {
        bounded_i += 1;
    }

    var sum = 0;
    for num in 0..10 {
        sum += num;
    }

    let found_row = for row in 0..<5 {
        for col in 0..<5 {
            if col == 1 {
                continue;
            }
            if row == 2 && col == 2 {
                break;
            }
        }
        if row == 2 {
            break row;
        }
    } then -1;

    // --- 6.6 `guard` & LIFO `defer` ---
    guard immutable_int > 0 else {
        print("Guard assertion failed!");
        return;
    }

    defer {
        print("Execution completed: running LIFO defer cleanup step 2");
    }
    defer {
        print("Execution completed: running LIFO defer cleanup step 1");
    }

    // --- 6.7 Values-First Error & Null-Safety (`T?`, `??`, `T ! E`) ---
    let nullable_val: str? = none;
    let fallback_val = nullable_val ?? "default_text";

    // --- 6.8 Fluid Builder Cascades (`..`) & Safe Cascades (`?..`) ---
    var node = NetworkNode(1, "gateway_primary");
    node..set_title("Master Controller")..set_status("Synchronized")..add_tag("cluster-a")..add_tag("ha-master");

    let maybe_node: NetworkNode? = node;
    maybe_node?..set_status("Safe cascade verified");

    // --- 6.9 Exhaustive Pattern Branching (`switch`) ---
    let shape_inst: Shape = ::Rectangle(10.0, 10.0);
    let shape_desc = switch shape_inst {
        case Origin: "origin";
        case Circle(r): f"circle radius {r}";
        case Rectangle(w, h) if w == h: f"square of side {w}";
        case Rectangle(w, h): f"rectangle {w}x{h}";
        case Polygon(pts): f"polygon with {len(pts)} points";
        default: "unknown shape";
    };

    let score = 85;
    let grade = switch score {
        case (90..=100): "A";
        case (80..=89):  "B";
        case (70..=79):  "C";
        case 0 | 1 | 2:  "Critical Failure";
        default:         "Passing";
    };

    // --- 6.10 Closures & Pipelines (`|>`, `<|`) ---
    let add_five = (x: i64) => x + 5;
    let double_val = (x: i64) => x * 2;
    let piped_value = 10 |> add_five |> double_val;
    let rev_piped = double_val <| 25;

    // --- 6.11 Arithmetic, Logical & Bitwise Operators ---
    let arithmetic = (10 + 5 - 2) * 4 / 2;
    let bitwise = (0b1100 & 0b1010) | (0b0011 ^ 0b0001) << 1 >> 1;
    let bit_not = ~bitwise;
    let logical = (true && !false) || (false && true);

    // --- 6.12 Real-Time & Deterministic Arena Regions ---
    noalloc {
        let local_val = 100;
        let double_local = local_val * 2;
    }

    region TransientArena {
        let arena_scratch = [1, 2, 3,];
    }

    deadline 50ms {
        let d_val = 10;
    }

    within 100ms {
        let w_val = 20;
    }

    periodic 10ms {
        let p_val = 30;
        break;
    }

    // --- 6.13 Concurrency, Channels & Multiplexing ---
    let ch = Channel<i64>(10);
    spawn {
        ch <- 42;
    }
    let received_data = <-ch;

    atomic {
        mutable_counter += 1;
    }
    sync {
        let sync_var = 1;
    }
    isolate {
        let iso_var = 2;
    }

    select {
        let val = <-ch;
        print(f"Channel read: {val}");
        ch <- 100;
    }

    // --- 6.14 Relational LINQ Queries, Set Algebra & Embedded SQL ---
    let users_table = [
        ["id": 1, "name": "Alice",   "role": "admin",    "active": true,],
        ["id": 2, "name": "Bob",     "role": "engineer", "active": true,],
        ["id": 3, "name": "Charlie", "role": "guest",    "active": false,],
    ];

    let active_admins = from u in users_table
        where u["active"] == true && u["role"] == "admin"
        order by u["name"] ascending
        select u["name"];

    let engineer_names = from u in users_table
        where u["role"] == "engineer"
        select u["name"];

    let combined_users = active_admins union engineer_names;
    let intersect_users = active_admins intersect engineer_names;
    let except_users = active_admins except engineer_names;

    transaction {
        savepoint sp1;
        commit;
        rollback;
    }

    sql {
        INSERT INTO users (id, name) VALUES (10, 'Dave') ON CONFLICT DO NOTHING;
        UPDATE users SET active = 0 WHERE id = 10;
        DELETE FROM users WHERE id = 999;
    }

    // --- 6.15 Scoped Contexts & Lexical Extensions ---
    use ext StringHelpers {
        let shouted_text = "pilot language".shout();
    }

    context(db = "production_cluster_db") {
        let db = "production_cluster_db";
        let service_resp = get_service_data(db);
    }

    // --- 6.16 Homoiconic Quoting, AST Splicing & 6 Call-Quoting Modes ---
    let status_keyword = :active;
    let role_keyword = :user/role;

    let quoted_ast = quote { 1 + 2 * 3 };
    let spliced_ast = quote { 100 + $quoted_ast };

    let v: f64 = 5.0;
    let shallow_quoted = ComputeImpulse!(10.0, 5.0);
    let deep_quoted = ComputeImpulse!!(~10.0, v);
    let abi_frame = ComputeImpulse!&(10.0, 5.0);
    let reactive_graph = ComputeImpulse!^(10.0, 5.0);
    let adjoint_dual = ComputeImpulse!@(10.0, 5.0);
    let dry_run_plan = ComputeImpulse!?(10.0, 5.0);

    let struct_type_name = nameof(NetworkNode);
    log_metric("cpu_utilization", "85%");

    // --- 6.17 Inline Polyglot & Assembly Blocks ---
    python {
        print("Executing inline Python 3.12 interop block")
    }

    js {
        console.log("Executing inline JavaScript V8 interop block");
    }

    c {
        printf("Executing inline C11 block\n");
    }

    cpp {
        // inline C++20 block
    }

    rust {
        // inline Rust block
    }

    lua {
        print("Executing inline Lua 5.4 block")
    }

    asm {
        nop
    }

    print("=== Pilot Omnibus Syntax Tour Finished Successfully ===");
}

// ==============================================================================
// 7. Entry Point
// ==============================================================================
pub fn main() -> void {
    run_omnibus_showcase();
}
