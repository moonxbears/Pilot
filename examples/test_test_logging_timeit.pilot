// SPDX-License-Identifier: MIT
// Integration Test: Pilot.Unittest, Pilot.Logging, Pilot.Timeit
// Multi-OS validation across Linux, Windows, macOS, Android, iOS, and WebAssembly.

use Pilot.Unittest as unittest;
use Pilot.Logging as logging;
use Pilot.Timeit as timeit;

// ============================================================================
// 1. Test Pilot.Unittest
// ============================================================================

struct MathTestCase : IValue {
    pub:
    var base: unittest.TestCase;

    self() {
        self.base = unittest.TestCase("MathTestCase");
    }

    fn test_arithmetic() -> void {
        self.base.assertEqual(2 + 2, 4, "2 + 2 must equal 4");
        self.base.assertNotEqual(2 * 3, 7, "2 * 3 != 7");
        self.base.assertTrue(10 > 5, "10 is greater than 5");
        self.base.assertFalse(3 > 9, "3 is not greater than 9");
        self.base.assertIn("pilot", "hello pilot world", "substring check");
        self.base.assertNotIn("rust", "hello pilot world", "absence check");
        self.base.assertIsNone(none, "must be none");
        self.base.assertIsNotNone(42, "must not be none");
        self.base.assertAlmostEqual(3.14159265, 3.1415927, 5, "almost equal to 5 decimal places");
    }

    var fn run(result: any = none) -> unittest.TestResult {
        var r = if result != none { result } else { unittest.TestResult() };
        r.startTest(self.base);
        self.base.setUp();
        self.test_arithmetic();
        self.base.tearDown();
        r.addSuccess(self.base);
        r.stopTest(self.base);
        return r;
    }
}

fn test_unittest_suite() -> void {
    print("=== Testing Pilot.Unittest ===");
    var tc = MathTestCase();
    var suite = unittest.TestSuite();
    suite.addTest(tc);
    assert(suite.countTestCases() == 1, "suite should contain 1 test case");

    let runner = unittest.TextTestRunner(1);
    let test_res = runner.run(suite);

    assert(test_res.wasSuccessful(), "MathTestCase must pass successfully");
    assert(test_res.testsRun == 1, "1 test must have run");
    assert(len(test_res.failures) == 0, "No failures expected");
    assert(len(test_res.errors) == 0, "No errors expected");
    print("Pilot.Unittest passed!");
}

// ============================================================================
// 2. Test Pilot.Logging
// ============================================================================

fn test_logging_suite() -> void {
    print("=== Testing Pilot.Logging ===");

    // Level conversions
    assert(logging.getLevelName(logging.DEBUG) == "DEBUG", "DEBUG name match");
    assert(logging.getLevelName(logging.INFO) == "INFO", "INFO name match");
    assert(logging.getLevelName(logging.WARNING) == "WARNING", "WARNING name match");
    assert(logging.getLevelName(logging.ERROR) == "ERROR", "ERROR name match");
    assert(logging.getLevelName(logging.CRITICAL) == "CRITICAL", "CRITICAL name match");

    assert(logging.getLevelByName("info") == 20, "infoByName is 20");
    assert(logging.getLevelByName("ERROR") == 40, "errorByName is 40");

    // Logger configuration
    var log = logging.getLogger("test_logger");
    log.setLevel(logging.DEBUG);
    assert(log.isEnabledFor(logging.DEBUG), "logger should be enabled for DEBUG");
    assert(log.isEnabledFor(logging.INFO), "logger should be enabled for INFO");

    // Handler and Formatter
    let fmt = logging.Formatter("[%(levelname)s] %(name)s - %(message)s");
    var handler = logging.StreamHandler(logging.DEBUG);
    handler.setFormatter(fmt);
    log.addHandler(handler);

    // Filter
    let filter = logging.Filter("test_logger");
    log.addFilter(filter);

    // Logging calls
    log.debug("Debugging diagnostic trace");
    log.info("Informational event processed");
    log.warning("Warning condition detected");
    log.error("Recoverable error handled");
    log.critical("Critical security condition");

    // Module-level basicConfig
    logging.basicConfig(logging.INFO, "%(levelname)s:%(message)s");
    logging.info("Root logger basicConfig message");

    print("Pilot.Logging passed!");
}

// ============================================================================
// 3. Test Pilot.Timeit
// ============================================================================

fn dummy_compute() -> i64 {
    var total: i64 = 0;
    for i in 0..100 {
        total = total + i;
    }
    return total;
}

fn test_timeit_suite() -> void {
    print("=== Testing Pilot.Timeit ===");

    let t0 = timeit.default_timer();
    assert(t0 >= 0.0, "default_timer returns non-negative float");

    // Timer execution
    let t = timeit.Timer(dummy_compute);
    let elapsed = t.timeit(500);
    assert(elapsed >= 0.0, "timeit elapsed is non-negative");

    // Repeat execution
    let runs = t.repeat(3, 100);
    assert(len(runs) == 3, "repeat should return 3 results");
    for r in runs {
        assert(r >= 0.0, "individual run timing non-negative");
    }

    // Top-level functions
    let quick_time = timeit.timeit(dummy_compute, none, 100);
    assert(quick_time >= 0.0, "convenience timeit non-negative");

    print("Pilot.Timeit passed!");
}

fn main() -> void {
    print("Starting integration tests for unittest, logging, and timeit...");
    test_unittest_suite();
    test_logging_suite();
    test_timeit_suite();
    print("ALL TESTS IN Pilot.Unittest, Pilot.Logging, AND Pilot.Timeit PASSED!");
}
