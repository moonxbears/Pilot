println("=== PILOT EXECUTION RUNTIME DEMO ===");

pub pure fn greet(name: str) -> str {
    return "Hello, " + name + "!";
}

let greeting = greet("Pilot Developer");
println(greeting);

// Guard, Early Exit & Arithmetic
pub fn process_data(value: i64) -> i64 {
    if value <= 0 {
        println("[guard] Value must be positive!");
        return -1;
    }
    let scaled = value * 10;
    println("[process] Scaled positive value: " + scaled);
    return scaled;
}

let out_ok = process_data(5);
let out_bad = process_data(-3);

// Iterative Fibonacci on 32-Bit Register `PilVM` v3
pub pure fn fibonacci(n: i64) -> i64 {
    var a: i64 = 0;
    var b: i64 = 1;
    var i: i64 = 0;
    while i < n {
        let next = a + b;
        a = b;
        b = next;
        i = i + 1;
    }
    return a;
}

let fib12 = fibonacci(12);
println("[vm] fibonacci(12) = " + fib12);

// Constant-Map Lookup & Homoiconic `syntax` Expansion
