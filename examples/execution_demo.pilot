// Pilot Execution Demo Script
// Demonstrating functions, collections, pattern switching, guard/defer, cascades, and root methods

use Pilot.Numpy.{eye};

println("=== PILOT EXECUTION RUNTIME DEMO ===");

fn greet(name: str) -> str {
    return f"Hello, {name}!";
}

let greeting = greet("Pilot Developer");
println(greeting);

// Guard & Defer
fn process_data(value: i64) -> i64 {
    defer {
        println("[defer] Cleanup executed successfully.");
    }

    guard value > 0 else {
        println("[guard] Value must be positive!");
        return -1;
    }

    println(f"[process] Processing positive value: {value}");
    return value * 10;
}

process_data(5);

// Collection Pattern Switching
let numbers = [10, 20, 30, 40, 50];
switch numbers {
    case [first, ..middle, last]: {
        println(f"Pattern matched collection with middle count: {len(middle)}");
    }
    default: {
        println("Other collection pattern");
    }
}

// Matrix Operations
let id3 = eye(3);
println("3x3 Identity Matrix: " + id3.to_string());

// Root Value Methods
let num: i64 = 12345;
println("Type of num: " + num.type_of());
println("Hash of num: " + num.hash().to_string());

println("=== DEMO FINISHED SUCCESSFULLY ===");
