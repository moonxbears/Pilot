// SPDX-License-Identifier: MIT
// Integration Test: std.numpy, std.pandas, std.matplotlib
// Multi-OS validation for scientific computing across Linux, Windows, macOS, Android, iOS, and WebAssembly.

import std.numpy as np;
import std.pandas as pd;
import std.matplotlib as plt;

def test_numpy_suite() {
    print("=== Testing std.numpy ===");

    // 1. Array creation & properties
    let a = np.array([[1.0, 2.0], [3.0, 4.0]]);
    assert(a.ndim == 2, "2D ndarray ndim check");
    assert(a.shape[0] == 2 and a.shape[1] == 2, "2x2 shape check");
    assert(a.size == 4, "size check 4");
    assert(a.at2d(0, 1) == 2.0, "indexing at (0, 1)");

    // 2. Transposition & Reshape
    let a_t = a.transpose();
    assert(a_t.at2d(0, 1) == 3.0, "transposed item at (0, 1)");
    assert(a_t.at2d(1, 0) == 2.0, "transposed item at (1, 0)");

    let flattened = a.flatten();
    assert(flattened.ndim == 1, "flattened ndim 1");
    assert(flattened.size == 4, "flattened size 4");

    let reshaped = a.reshape([4, 1]);
    assert(reshaped.shape[0] == 4 and reshaped.shape[1] == 1, "reshaped 4x1");

    // 3. Statistical reducers
    assert(a.sum() == 10.0, "sum of [[1, 2], [3, 4]] is 10");
    assert(a.mean() == 2.5, "mean of [[1, 2], [3, 4]] is 2.5");
    assert(a.min() == 1.0, "min is 1.0");
    assert(a.max() == 4.0, "max is 4.0");
    assert(a.argmin() == 0, "argmin is 0");
    assert(a.argmax() == 3, "argmax is 3");

    // 4. Matrix multiplication (matmul & dot)
    let b = np.array([[2.0, 0.0], [1.0, 2.0]]);
    let c = np.matmul(a, b);
    // [1*2 + 2*1, 1*0 + 2*2] = [4, 4]
    // [3*2 + 4*1, 3*0 + 4*2] = [10, 8]
    assert(c.at2d(0, 0) == 4.0, "matmul (0, 0)");
    assert(c.at2d(0, 1) == 4.0, "matmul (0, 1)");
    assert(c.at2d(1, 0) == 10.0, "matmul (1, 0)");
    assert(c.at2d(1, 1) == 8.0, "matmul (1, 1)");

    // 5. Utility generators
    let z = np.zeros([2, 3]);
    assert(z.size == 6, "zeros size 6");
    assert(z.at2d(1, 2) == 0.0, "zeros val 0");

    let ones_arr = np.ones([2, 2]);
    assert(ones_arr.sum() == 4.0, "ones sum 4.0");

    let rng = np.arange(0.0, 10.0, 2.0);
    assert(rng.size == 5, "arange size 5");
    assert(rng.item(4) == 8.0, "arange last element 8.0");

    let lin = np.linspace(0.0, 1.0, 5);
    assert(lin.size == 5, "linspace size 5");
    assert(lin.item(0) == 0.0, "linspace start 0.0");
    assert(lin.item(4) == 1.0, "linspace end 1.0");

    let identity_matrix = np.eye(3);
    assert(identity_matrix.at2d(0, 0) == 1.0, "eye diagonal 1.0");
    assert(identity_matrix.at2d(0, 1) == 0.0, "eye off-diagonal 0.0");
    assert(identity_matrix.sum() == 3.0, "eye trace sum 3.0");

    // 6. Elementwise arithmetic
    let added = a.add(2.0);
    assert(added.at2d(0, 0) == 3.0, "add scalar check");

    let scaled = a.mul(3.0);
    assert(scaled.at2d(1, 1) == 12.0, "multiply scalar check");

    print("std.numpy passed!");
}

def test_pandas_suite() {
    print("=== Testing std.pandas ===");

    // 1. Series
    let s = pd.Series([10, 25, 40, 55], ["q1", "q2", "q3", "q4"], "revenue");
    assert(s.count() == 4, "series count 4");
    assert(s.iloc(0) == 10, "series iloc 0");
    assert(s.at("q3") == 40, "series at key q3");
    assert(s.sum() == 130.0, "series sum 130.0");
    assert(s.mean() == 32.5, "series mean 32.5");
    assert(s.min() == 10, "series min 10");
    assert(s.max() == 55, "series max 55");

    let sub_s = s.head(2);
    assert(sub_s.count() == 2, "head count 2");
    assert(sub_s.iloc(1) == 25, "head iloc 1");

    // 2. DataFrame
    let df_data = {
        "id": [101, 102, 103],
        "name": ["Alice", "Bob", "Charlie"],
        "score": [95.0, 88.5, 91.0]
    };
    let df = pd.DataFrame(df_data, ["id", "name", "score"]);
    assert(df.shape()[0] == 3 and df.shape()[1] == 3, "df shape 3x3");

    // Column extraction
    let score_col = df.col("score");
    assert(score_col.count() == 3, "col count 3");
    assert(score_col.mean() == 91.5, "score col mean 91.5");

    // Row extraction
    let row0 = df.iloc(0);
    assert(row0["name"] == "Alice", "row0 name Alice");

    // Column projection & drop
    let projected = df.select(["name", "score"]);
    assert(projected.shape()[1] == 2, "projected columns count 2");

    let dropped = df.drop("id");
    assert(dropped.shape()[1] == 2, "dropped column id");

    // Column assignment
    let updated = df.assign("passed", [true, true, true]);
    assert(updated.shape()[1] == 4, "assigned column count 4");

    // CSV round-trip
    let csv_text = df.to_csv();
    assert(len(csv_text) > 0, "csv_text generated");

    print("std.pandas passed!");
}

def test_matplotlib_suite() {
    print("=== Testing std.matplotlib ===");

    // 1. Pyplot configuration
    let fig = plt.figure([50, 12]);
    plt.title("Sample Performance Metric");
    plt.xlabel("Epoch");
    plt.ylabel("Accuracy");
    plt.grid(true);
    plt.legend();

    // 2. Plotting series
    plt.plot([0, 1, 2, 3, 4], [0.1, 0.4, 0.7, 0.85, 0.95], "Model A", "*", "blue");
    plt.scatter([0, 1, 2, 3, 4], [0.15, 0.35, 0.65, 0.8, 0.9], "Model B", "o", "red");

    // 3. Render checks
    let ascii_chart = fig.render_ascii();
    assert(len(ascii_chart) > 0, "ASCII chart rendered");

    let svg_chart = fig.render_svg();
    assert(len(svg_chart) > 0, "SVG chart rendered");

    // 4. Bar chart & Hist chart
    plt.clf();
    plt.bar(["Q1", "Q2", "Q3", "Q4"], [12.0, 18.0, 24.0, 30.0], "Sales");
    plt.hist([1.0, 2.0, 2.5, 3.0, 3.5, 4.0, 4.5, 5.0], 5, "Distribution");
    let hist_ascii = fig.render_ascii();
    assert(len(hist_ascii) > 0, "Histogram ASCII rendered");

    print("std.matplotlib passed!");
}

def main() {
    print("Starting integration tests for scientific standard libraries...");
    test_numpy_suite();
    test_pandas_suite();
    test_matplotlib_suite();
    print("ALL TESTS IN std.numpy, std.pandas, AND std.matplotlib PASSED!");
}
