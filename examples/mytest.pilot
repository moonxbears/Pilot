use Pilot.Collections.*;
use Pilot.Core.Keywords::*;
use Pilot.Core.Reflect::*;

var category = 0;
while category <= 16 {
    let scope = reflect_category_scope(category);
    let badge = reflect_category_badge(category);
    print("Category " + category + " [" + badge + "]: " + scope);
    category = category + 1;
}



