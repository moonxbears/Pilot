class apples {
    generator:
        for i in ["test", "also_test", 1..10] {
            var f"field_{i}": int = 0;
            def f"get_{i}"(self) -> int {
                return self.f"field_{i}";
            }
        }
}

let b = apples();
b.field_test = 10;
b.field_also_test = 31;
b.field_1 = 1002;
print(b.get_test());
print(b.get_also_test());
print(b.get_1());

def main() -> void {
    let a = apples();
    a.field_test = 42;
    a.field_also_test = 84;
    a.field_1 = 100;
    print(a.get_test());
    print(a.get_also_test());
    print(a.get_1());
}