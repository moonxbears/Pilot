// =============================================================================
// Tutorial 05: Structs, Implicit Properties, Extensions & Fluid Cascades (..)
// =============================================================================

// --- 1. Value Structs, Constructors and Implicit-Receiver Methods ---
struct NetworkPacket : IValue {
    pub var source_id: i64 = 0;
    pub var destination_id: i64 = 0;
    pub var payload: str = "";
    pub var encrypted: bool = false;

    pub self() {
        .source_id = 0;
        .destination_id = 0;
        .payload = "";
        .encrypted = false;
    }

    pub var fn set_source(src: i64) -> void {
        .source_id = src;
    }

    pub var fn set_destination(dst: i64) -> void {
        .destination_id = dst;
    }

    pub var fn attach_payload(data: str) -> void {
        .payload = data;
    }

    pub var fn set_encrypted(state: bool) -> void {
        .encrypted = state;
    }
}

// --- 2. Fluid Builder Cascades (..) ---
// The cascade operator (..) invokes methods on a receiver while returning
// the receiver itself, eliminating repetitive boilerplate variables.
var packet = NetworkPacket();
packet..set_source(101)..set_destination(202)..attach_payload("SENSOR_TELEMETRY")..set_encrypted(true);

println(f"Configured packet for destination: {packet.destination_id}");

// --- 3. Nullable Values and Safe Cascades (?..) ---
var maybe_packet: NetworkPacket? = packet;
maybe_packet?..attach_payload("SAFE_UPDATE");

// --- 4. Interfaces and Extensions ---
interface IDescribable {
    fn describe() -> str;
}

pub ext NetworkPacket {
    pub pure fn summary() -> str {
        return f"Packet[src={.source_id}, dst={.destination_id}]";
    }
}

println(packet.summary());
