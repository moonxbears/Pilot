// =============================================================================
// Tutorial 06: Values-First Errors (`T ! E`), `option<T>` (`T?`), `guard` & `defer`
// =============================================================================

// --- 1. Null-Safety (`T?`), Safe Navigation (`?.`) & Coalesce (`??`) ---
let nullable_text: str? = none;
let length_display = nullable_text ?? "Default Text";
println(f"Display: {length_display}");

var fallback_config: str? = none;
fallback_config = fallback_config ?? "production.env";

// --- 2. Flat Happy-Path Early Exit with `guard` ---
fn process_user_id(raw_id: i64?) -> str {
    guard some raw_id else {
        return "ERROR: Missing user ID";
    }
    return f"Processing user ID: {raw_id}";
}

println(process_user_id(none));
println(process_user_id(42));

// --- 3. Deterministic Scope Cleanup with `defer` ---
fn run_transaction() -> void {
    println("Acquiring database connection lock...");
    defer {
        println("Releasing database connection lock (deferred cleanup).");
    }
    println("Executing transactional operations...");
}

run_transaction();

// --- 4. Values-First Error Propagation (`T ! E` + Postfix `?` + `catch`) ---
pub pure fn checked_divide(numerator: i64, denominator: i64) -> i64 ! str {
    guard denominator != 0 else {
        return err("DivideByZero");
    }
    return ok(numerator / denominator);
}

pub fn compute_ratio(a: i64, b: i64) -> i64 ! str {
    let q = checked_divide(a, b)?;
    return ok(q * 10);
}

let safe_val = compute_ratio(100, 0) catch err_msg => {
    println(f"Recovered values-first error: {err_msg}");
    -1
};
println(f"Final computed value: {safe_val}");
