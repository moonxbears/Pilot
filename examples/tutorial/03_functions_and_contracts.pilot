// =============================================================================
// Tutorial 03: Functions, Return Types, Lambdas & Design-by-Contract
// =============================================================================

// --- 1. Basic Functions ---
// Defined with 'def' or 'fn'. Return type indicated by '-> Type'.
def add_integers(a: int, b: int) -> int {
    return a + b
}

// --- 2. Default Parameters ---
def format_log(msg: str, level: str = "INFO") -> str {
    return f"[{level}] {msg}"
}

// --- 3. Short Expression-Bodied Functions (=>) ---
def square(x: int) -> int => x * x;
def is_even(n: int) -> bool => n % 2 == 0;

// --- 4. First-Class Lambdas ---
let multiplier = lambda x: x * 3;
let transformed = multiplier(10)

// --- 5. Design-by-Contract: requires & ensures ---
// Preconditions (requires) and Postconditions (ensures) are verified at boundaries.
def safe_divide(numerator: int, denominator: int) -> int
    requires denominator != 0
    ensures result * denominator <= numerator
{
    return numerator / denominator
}

// Testing function calls
let sum_res = add_integers(20, 22)
let log_entry = format_log("System operational", "SUCCESS")
let quotient = safe_divide(100, 4)

println(f"Sum: {sum_res}, Log: {log_entry}, Div: {quotient}")
