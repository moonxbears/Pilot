// =============================================================================
// Tutorial 07: Structured Concurrency, `async` / `await`, `spawn` & Channels
// =============================================================================

use Pilot.Asyncio as asyncio;

// --- 1. Typed Communication Channels (`<-`) ---
let data_ch = Channel(10);
let control_ch = Channel(5);

// --- 2. Asynchronous Functions & Concurrent `spawn` ---
async fn compute_telemetry(sensor_id: i64) -> i64 {
    println(f"Computing telemetry for sensor {sensor_id}...");
    return sensor_id * 100;
}

let task_a = spawn(compute_telemetry(1));
let task_b = spawn(compute_telemetry(2));

let res_a = await(task_a);
let res_b = await(task_b);
println(f"Telemetry results: {res_a}, {res_b}");

// --- 3. Non-Blocking Channel Send & Receive (`<-`) ---
data_ch <- 42;
control_ch <- "STATUS_OK";

let received_val = <-data_ch;
let control_msg = <-control_ch;
println(f"Channel payload={received_val}, control={control_msg}");

// --- 4. Event-Loop Task Combinators ---
let gathered = asyncio.gather([
    () => 10,
    () => 20,
    () => 30,
]);
println(f"Gathered async batch: {gathered}");
println("Tutorial 07 completed successfully.");
