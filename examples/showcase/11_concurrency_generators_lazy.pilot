// ==============================================================================
// Concept 11: Generators & Collecting `for` Expressions
// ==============================================================================
// Runs with `pilot run` and on the PilIR interpreter (`pilot ir run`).
// Tasks, channels, `select` and lazy values are not built yet; see
// docs/concepts/11-concurrency-generators-lazy.md.

// --- 1. A generator runs only as items are asked for ---

// The return type is inferred from the `yield` operands: Generator<i64>.
fn fibonacci(limit: i64) {
    var a = 0;
    var b = 1;
    var count = 0;
    while count < limit {
        yield a;
        let next = a + b;
        a = b;
        b = next;
        count = count + 1;
    }
}

// --- 2. `yield` is an expression: `.send(v)` gives it a value ---

fn accumulator(start: i64) -> Generator<i64, i64> {
    var total = start;
    loop {
        let delta = yield total;
        total = total + delta;
    }
}

// --- 3. `yield *xs` hands out every item of another sequence ---

fn header_then(rows: Generator<str>) -> Generator<str> {
    yield *["id", "name"];
    yield *rows;
}

fn rows() -> Generator<str> {
    yield "1 ada";
    yield "2 grace";
}

// --- 4. Leaving early ends the generator and runs its `defer`s ---

fn naturals() -> Generator<i64> {
    defer { print("naturals: closed"); }
    var i = 0;
    loop {
        yield i;
        i = i + 1;
    }
}

fn main() {
    print("--- 1. Pulling items ---");
    let fib = fibonacci(7);
    print(fib.next() ?? -1);
    print(fib.next() ?? -1);
    for x in fib {
        print(x);
    }
    print(fib.is_done);

    print("--- 2. Sending values in ---");
    let acc = accumulator(10);
    print(acc.next() ?? -1);
    print(acc.send(25) ?? -1);
    print(acc.send(-5) ?? -1);
    acc.close();
    print(acc.is_done);

    print("--- 3. Delegation ---");
    for line in header_then(rows()) {
        print(line);
    }

    print("--- 4. Early exit ---");
    for n in naturals() {
        if n == 3 { break; }
        print(n);
    }

    print("--- 5. Collecting for ---");
    let squares = for i in 1..=5 { yield i * i; };
    print(squares);
    let odd_squares = for s in squares { if s % 2 != 0 { yield s; } };
    print(odd_squares);
}
