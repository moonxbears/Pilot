// =============================================================================
// Showcase 27: First-Class Fluid Cascades, Pipeline Operators & Fallback Expressions
// =============================================================================
// Demonstrates:
//   1. Fluid Method Cascades (`..` / `?..`):
//      - Smalltalk / Dart-style receiver retention across multi-mutation calls
//   2. Cascade Result Binding (`..method() -> let binding`):
//      - Extracts intermediate returns without losing fluent chaining
//   3. Pipeline Operator (`|>`):
//      - Left-to-right function application: `x |> f |> g`
//   4. Null-Coalescing (`??`) and Safe Navigation (`?.`, `?[...]`):
//      - Defensive access with localized default fallback
//   5. Values-First Error Recovery Expression (`catch`):
//      - Localized inline error fallback without heavy try-catch blocks
// =============================================================================

println("==================================================================");
println(" Showcase 27: Fluid Cascades, Pipeline & Advanced Expressions     ");
println("==================================================================");

// -----------------------------------------------------------------------------
// 1. Fluid Method Cascades (`..`) on Configurable Client
// -----------------------------------------------------------------------------
struct HttpClientConfig : IValue {
    pub var host: str = "localhost";
    pub var port: i64 = 80;
    pub var use_tls: bool = false;
    pub var timeout_ms: i64 = 5000;
    pub var auth_token: str = "";

    pub self() {
        .host = "localhost";
        .port = 80;
        .use_tls = false;
        .timeout_ms = 5000;
        .auth_token = "";
    }

    pub var fn set_host(h: str) {
        .host = h;
    }

    pub var fn set_port(p: i64) {
        .port = p;
    }

    pub var fn enable_tls() {
        .use_tls = true;
    }

    pub var fn generate_session_token() -> str {
        .auth_token = "tok_live_98a72b";
        return .auth_token;
    }

    pub pure fn describe() -> str {
        let scheme = if .use_tls { "https" } else { "http" };
        return f"{scheme}://{.host}:{.port} (timeout={.timeout_ms}ms)";
    }
}

let client = HttpClientConfig()
    ..set_host("api.telemetry.pilot.dev")
    ..set_port(443)
    ..enable_tls()
    ..generate_session_token() -> let session_key;

println("\n[1] Fluid Cascaded Client Configuration:");
println(f"  Endpoint:    {client.describe()}");
println(f"  Bound Token: {session_key}");

// -----------------------------------------------------------------------------
// 2. Functional Pipeline Operator (`|>`)
// -----------------------------------------------------------------------------
fn sanitize_metric(value: f64) -> f64 {
    return if value >= 0.0 { value } else { 0.0 };
}

fn amplify_gain(signal: f64) -> f64 {
    return signal * 2.5;
}

fn quantize_sample(reading: f64) -> i64 {
    return i64(reading + 0.5);
}

let raw_input = 14.8;
let final_signal = raw_input
    |> sanitize_metric
    |> amplify_gain
    |> quantize_sample;

println("\n[2] Pipeline Operator (|>) Transformation:");
println(f"  Raw Input:    {raw_input}");
println(f"  Final Signal: {final_signal}");

// -----------------------------------------------------------------------------
// 3. Null-Coalescing (`??`) and Safe Navigation (`?.`)
// -----------------------------------------------------------------------------
struct ServerProfile : IValue {
    pub var region: str? = none;
    pub var fallback_region: str = "us-east-1";

    pub self() {
        .region = none;
        .fallback_region = "us-east-1";
    }
}

let profile = ServerProfile();
let resolved_region = profile.region ?? profile.fallback_region;
let safe_len = profile.region?.len ?? 0;

println("\n[3] Null-Safety Coalescing & Safe Navigation:");
println(f"  Resolved Region: {resolved_region}");
println(f"  Region Length:   {safe_len}");

// -----------------------------------------------------------------------------
// 4. Inline Error Recovery Expression (`catch`)
// -----------------------------------------------------------------------------
fn load_port_from_env(env_var: str) -> i64 ! str {
    if env_var == "INVALID" {
        return fail("Invalid port string format");
    }
    return 8080;
}

let configured_port = load_port_from_env("INVALID") catch 3000;
let standard_port = load_port_from_env("VALID") catch 3000;

println("\n[4] Localized Error Recovery (catch):");
println(f"  Configured Port (recovered from error): {configured_port}");
println(f"  Standard Port (normal path):            {standard_port}");

println("\n>>> Showcase 27 Complete! <<<\n");
