// ==============================================================================
// Concept 07: Contextual Parameters (Native Dependency Injection)
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Contextual Parameters (Native DI)");
println("==================================================");

struct Logger : IValue {
    pub var service_name: str;

    pub self(service_name: str) {
        .service_name = service_name;
    }

    pub fn log(message: str) {
        println(f"  [LOGGER - {.service_name}] {message}");
    }
}

struct DatabaseConnection : IValue {
    pub var connection_string: str;

    pub self(connection_string: str) {
        .connection_string = connection_string;
    }

    pub fn query(sql: str) -> str {
        println(f"  [DATABASE - {.connection_string}] Executed: {sql}");
        return "QUERY_OK";
    }
}

// Functions declare contextual requirements via `where context(...)`:
fn low_level_save_entry(entry_id: i64) -> str
    where context(db: DatabaseConnection, logger: Logger)
{
    logger.log(f"Writing entry #{entry_id} to persistence storage...");
    db.query(f"INSERT INTO telemetry_entries VALUES ({entry_id});");
    logger.log(f"Entry #{entry_id} successfully committed.");
    return "SAVED";
}

fn intermediate_workflow(entry_id: i64) -> str
    where context(db: DatabaseConnection, logger: Logger)
{
    logger.log(f"Initiating intermediate workflow for entry #{entry_id}");
    // Neither 'db' nor 'logger' need to be passed explicitly at the call site!
    let status = low_level_save_entry(entry_id);
    return status;
}

fn top_level_handler(payload_id: i64) -> str
    where context(db: DatabaseConnection, logger: Logger)
{
    logger.log(f"Top-level request received for payload {payload_id}");
    return intermediate_workflow(payload_id);
}

println("\n--- Initializing Contextual Dependencies ---");
let main_db = DatabaseConnection("postgresql://prod-cluster.internal:5432/app");
let app_logger = Logger("AuthService");

println("Binding dependencies into execution environment via 'context(...)':");

context(db = main_db, logger = app_logger) {
    let db = main_db;
    let logger = app_logger;
    println("\nCalling top_level_handler(7712)... Notice how db & logger are implicitly routed!");
    let outcome = top_level_handler(7712);
    println(f"\nFinal Outcome: {outcome}");
}

println("\n>>> Concept 07 Demonstration Complete! <<<\n");
