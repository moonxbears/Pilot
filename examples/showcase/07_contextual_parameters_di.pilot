// ==============================================================================
// Concept 07: Contextual Parameters (Native Dependency Injection)
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Contextual Parameters (Native DI)");
println("==================================================");

struct Logger : IValue {
    pub var service_name: str;

    pub self(service_name: str) {
        .service_name = service_name;
    }

    pub fn log(message: str) {
        println(f"  [LOGGER - {.service_name}] {message}");
    }
}

struct DatabaseConnection : IValue {
    pub var connection_string: str;

    pub self(connection_string: str) {
        .connection_string = connection_string;
    }

    pub fn query(sql: str) -> str {
        println(f"  [DATABASE - {.connection_string}] Executed: {sql}");
        return "QUERY_OK";
    }
}

// Functions declare what they need with 'context':
fn low_level_save_record(record_id: i64, context db: DatabaseConnection, context logger: Logger) -> str {
    logger.log(f"Writing record #{record_id} to persistence storage...");
    db.query(f"INSERT INTO telemetry_records VALUES ({record_id});");
    logger.log(f"Record #{record_id} successfully committed.");
    return "SAVED";
}

fn intermediate_workflow(record_id: i64, context db: DatabaseConnection, context logger: Logger) -> str {
    logger.log(f"Initiating intermediate workflow for record #{record_id}");
    // Neither 'db' nor 'logger' need to be passed explicitly!
    // They are automatically and implicitly routed down the call stack.
    let status = low_level_save_record(record_id);
    return status;
}

fn top_level_handler(payload_id: i64, context db: DatabaseConnection, context logger: Logger) -> str {
    logger.log(f"Top-level request received for payload {payload_id}");
    return intermediate_workflow(payload_id);
}

println("\n--- Initializing Contextual Dependencies ---");
let main_db = DatabaseConnection("postgresql://prod-cluster.internal:5432/app");
let app_logger = Logger("AuthService");

println("Binding dependencies into execution environment via 'with context':");

with context db = main_db, logger = app_logger {
    println("\nCalling top_level_handler(7712)... Notice how db & logger are implicitly passed!");
    let outcome = top_level_handler(7712);
    println(f"\nFinal Outcome: {outcome}");
}

println("\n>>> Concept 07 Demonstration Complete! <<<\n");
