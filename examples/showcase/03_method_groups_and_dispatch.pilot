// ==============================================================================
// Concept 03: Method Groups, Switchboards, Currying, Unions & Broadcasts
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Advanced Method Groups & Dispatch");
println("==================================================");

// 1. Switchboard (Auto-Routing Maps over Heterogeneous Collections)
println("\n--- 1. Auto-Routing Switchboard ---");

fn process_item(item: i64) -> str {
    return f"Integer Doubled: {item * 2}";
}

fn process_item(item: str) -> str {
    return f"String Uppercase: {item}";
}

fn process_item(item: i64[]) -> str {
    return f"Slice Count: {len(item)} elements";
}

let mixed_collection = [42, "pilot language", [1, 2, 3, 4], 100];
println(f"Original heterogeneous collection: {mixed_collection}");

println("\nMapping method group 'process_item' directly across collection:");
let routed_results = mixed_collection.map(process_item);
for res in routed_results {
    println(f"  -> {res}");
}

// 2. Method Group Currying (The Signature Sieve)
println("\n--- 2. Method Group Currying (Signature Sieve) ---");

struct Circle : IValue {
    pub radius: f64 = 12.0;
    pub self() { .radius = 12.0; }
}

struct Square : IValue {
    pub side: f64 = 8.0;
    pub self() { .side = 8.0; }
}

struct Triangle : IValue {
    pub angle: f64 = 60.0;
    pub self() { .angle = 60.0; }
}

fn draw(shape: Circle, color: str) -> str {
    return f"Drawing Circle with radius {shape.radius} in {color}";
}

fn draw(shape: Square, color: str) -> str {
    return f"Drawing Square with side {shape.side} in {color}";
}

fn draw(shape: Triangle, angle: f64) -> str {
    return f"Drawing Triangle rotated at {angle} deg";
}

println("Initial 'draw' method group has 3 overloads: (Circle, str), (Square, str), (Triangle, f64).");

// Supplying only color="Crimson" sieves out Triangle!
let draw_crimson = draw(color = "Crimson");
println("Currying draw(color = 'Crimson') narrowed the group to Circle and Square overloads.");

let my_circle = Circle();
let my_square = Square();

println(f"  Result: {draw_crimson(my_circle)}");
println(f"  Result: {draw_crimson(my_square)}");

// 3. Method Group Fallback and Union (|)
println("\n--- 3. Group Fallback and Union (|) ---");

struct UserProfile : IValue {
    pub name: str = "Alice";
    pub self() { .name = "Alice"; }
}

struct SystemConfig : IValue {
    pub version: str = "2.4.0";
    pub self() { .version = "2.4.0"; }
}

struct JsonHandler : IValue {
    pub static pure fn serialize(target: UserProfile) -> str {
        return f"{{\"type\": \"user\", \"name\": \"{target.name}\"}}";
    }
}

struct XmlHandler : IValue {
    pub static pure fn serialize(target: SystemConfig) -> str {
        return f"<config version=\"{target.version}\" />";
    }
}

// Merge JsonHandler.serialize and XmlHandler.serialize into one logical pipeline!
let universal_serializer = JsonHandler.serialize | XmlHandler.serialize;
println("Constructed union: JsonHandler.serialize | XmlHandler.serialize");

let user_obj = UserProfile();
let config_obj = SystemConfig();

println(f"Serializing UserProfile:  {universal_serializer(user_obj)}");
println(f"Serializing SystemConfig: {universal_serializer(config_obj)}");

// 4. Multi-Cast Execution (The Broadcast *)
println("\n--- 4. Multi-Cast Execution (Broadcast *) ---");

interface ISystemEvent {
    pub event_id: i64 { get; }
}

struct SystemEventBundle : IValue {
    pub event_id: i64 = 9001;
}

struct NetworkAlert : ISystemEvent, IValue {
    *SystemEventBundle;
    pub message: str = "High Latency Warning";

    pub self() {
        .event_id = 9001;
        .message = "High Latency Warning";
    }
}

fn on_alert(ev: NetworkAlert) -> str {
    println(f"  [Subscriber 1: Network Alert Handler] Received: {ev.message}");
    return "Handled by AlertHandler";
}

fn on_alert(ev: ISystemEvent) -> str {
    println(f"  [Subscriber 2: Global Event Telemetry] Logged event ID: {ev.event_id}");
    return "Handled by Telemetry";
}

let alert = NetworkAlert();
println("Broadcasting alert to on_alert*(alert)...");
let broadcast_responses = on_alert*(alert);
println(f"All matching subscribers triggered simultaneously: {broadcast_responses}");

println("\n>>> Concept 03 Demonstration Complete! <<<\n");
