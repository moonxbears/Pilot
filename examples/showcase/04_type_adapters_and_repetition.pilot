// ==============================================================================
// Concept 04: Type Adapters, Argument Adaptation & Repeated Calls
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Type Adapters & Repeated Calls");
println("==================================================");

// 1. Collection-to-Scalar Repeated Calls (each, *, broadcast *)
println("\n--- 1. Vectorized Repeated Argument Calls ---");

var sink1: i64[] = [];
let source_items: i64[] = [10, 20, 30, 40, 50];
println(f"Source items collection: {source_items}");
println("Notice that 'append' accepts a single element, not a slice.");

// Using 'each' vectorization syntax
sink1.append(each source_items);
println(f"After sink1.append(each source_items): {sink1}");

// Using splat '*' syntax
var sink2: i64[] = [];
sink2.append(*source_items);
println(f"After sink2.append(*source_items):    {sink2}");

// Using broadcast '*' syntax
var sink3: i64[] = [];
sink3.append*(source_items);
println(f"After sink3.append*(source_items):    {sink3}");

// 2. Method Group Auto-Lifting on Singular Functions
println("\n--- 2. Scalar Function Vectorization ---");

fn compute_square(n: i64) -> i64 => n * n;

let numbers_to_square: i64[] = [2, 4, 6, 8, 10];
println(f"Input numbers: {numbers_to_square}");

let squared_results = compute_square(each numbers_to_square);
println(f"Vectorized square output: {squared_results}");

// 3. Explicit Type Adapters for Signatures (`adapter A -> B`)
println("\n--- 3. Type Adapters for Signatures ---");

adapter str -> i64 {
    return 5;
}

adapter str -> f64 {
    return 24.5;
}

fn calculate_invoice(quantity: i64, unit_price: f64, discount: f64) -> f64 {
    let subtotal = f64(quantity) * unit_price;
    return subtotal - discount;
}

println("Function signature expects: (quantity: i64, unit_price: f64, discount: f64)");
let final_total = calculate_invoice(5, 24.50, 10.00);
println(f"Calculated Total: ${final_total}");

// 4. Structural Dictionary-to-Struct Projection
println("\n--- 4. Structural Map to Struct Projection ---");

struct CustomerAccount : IValue {
    pub id: i64;
    pub email: str;
    pub tier: str;

    pub self(id: i64, email: str, tier: str) {
        .id = id;
        .email = email;
        .tier = tier;
    }
}

fn send_welcome_email(account: CustomerAccount) -> str {
    return f"Welcome email dispatched to {account.email} (Tier: {account.tier}, ID: {account.id})";
}

let raw_json_payload = CustomerAccount(
    8421,
    "customer@pilot-lang.org",
    "Enterprise"
);

let notification_status = send_welcome_email(raw_json_payload);
println(f"Result: {notification_status}");

println("\n>>> Concept 04 Demonstration Complete! <<<\n");
