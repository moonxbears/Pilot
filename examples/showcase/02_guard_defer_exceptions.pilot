// ==============================================================================
// Concept 02: Guard Preconditions, Defer Cleanup & Error Recovery
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Guard, Defer & Error Handling");
println("==================================================");

// 1. Guard Preconditions
println("\n--- 1. Guard Statements (Precondition Enforcement) ---");

fn process_transaction(user_id: i64, balance: f64, amount: f64) -> str {
    println(f"Attempting transaction: user={user_id}, balance={balance}, amount={amount}");

    guard user_id > 0 else {
        println(f"  [GUARD FAILED] Invalid user ID: {user_id}");
        return "Transaction Rejected";
    }

    guard amount > 0.0 else {
        println(f"  [GUARD FAILED] Transfer amount must be positive: {amount}");
        return "Transaction Rejected";
    }

    guard balance >= amount else {
        println(f"  [GUARD FAILED] Insufficient funds! Needed {amount} but only had {balance}");
        return "Transaction Rejected";
    }

    let remaining = balance - amount;
    println(f"  [GUARD PASSED] Approved! New balance: {remaining}");
    return "Transaction Success";
}

let res1 = process_transaction(101, 500.0, 150.0);
println(f"Result 1: {res1}");

let res2 = process_transaction(101, 100.0, 300.0);
println(f"Result 2: {res2}");

// 2. Defer Cleanup (LIFO Order Execution)
println("\n--- 2. Defer Statements (Guaranteed Cleanup) ---");

fn simulate_resource_workflow() -> void {
    println("Entering workflow: opening connections...");

    defer {
        println("  [DEFER 1] Closing primary database connection.");
    }

    defer {
        println("  [DEFER 2] Releasing network socket handle.");
    }

    defer {
        println("  [DEFER 3] Flushing buffered log stream to disk.");
    }

    println("Workflow active: processing critical payload...");
    println("Workflow completing: preparing function return...");
}

simulate_resource_workflow();
println("Workflow finished and all deferred actions executed in LIFO order!");

// 3. Values-First Error Propagation & Structured Recovery (`T ! E` + `try` / `catch`)
println("\n--- 3. Values-First Error Propagation (`T ! E`, `?`, `defer` & `catch`) ---");

fn checked_division(numerator: f64, denominator: f64) -> f64 ! str {
    guard denominator != 0.0 else {
        return err("DivideByZeroError: Denominator cannot be zero.");
    }
    return ok(numerator / denominator);
}

fn dangerous_division(numerator: f64, denominator: f64) -> f64? {
    println(f"\nEvaluating: {numerator} / {denominator}");
    defer {
        println("  [DEFER CLEANUP] Cleanup complete (always runs on scope exit).");
    }
    try {
        let quotient = checked_division(numerator, denominator)?;
        println(f"  Computed quotient: {quotient}");
        return quotient;
    } catch err {
        println(f"  [CAUGHT ERROR] Handled values-first failure gracefully: {err}");
        return none;
    }
}

let ok_div = dangerous_division(100.0, 4.0);
let err_div = dangerous_division(42.0, 0.0);
println(f"Division outcomes: ok={ok_div}, err={err_div}");

println("\n>>> Concept 02 Demonstration Complete! <<<\n");
