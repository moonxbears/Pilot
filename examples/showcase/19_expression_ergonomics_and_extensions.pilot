// =============================================================================
// Showcase 19: Unified Expression Ergonomics, Struct-Like Primitive Literals
//              & Zero-Cost Extensions
// =============================================================================

// 1. Zero-Cost Extensions with Computed Properties & Generic Slices
pub ext str {
    pub IsBlank: bool {
        get => len(.Trim()) == 0;
    }

    pub pure fn Slugify() -> str => .Trim().ToLower().Replace(" ", "-");
}

pub ext i64[] {
    pub pure fn Mean() -> f64? {
        if len(self) == 0 {
            return none;
        }
        return .Sum().ToFloat() / f64(len(self));
    }
}

// 2. Struct-Like Methods & Properties on Unboxed Primitive Literals
let hex = (255).ToHex();
let bits = (16).BitLength();
let lerped = (0.5).Lerp(0.0, 100.0);
let flag_label = true.Toggle().Select("Active", "Standby");
let period_sec = 50kHz.Period();
let buf_bytes = 64KB.ToBytes();

// 3. Expression-Oriented Control Flow, Block Expressions & Fluent Member Piping
let score = 94;
let badge = if score >= 90 { "Gold" } else if score >= 75 { "Silver" } else { "Bronze" };
let dist = {
    let dx = 3.0;
    let dy = 4.0;
    (dx * dx + dy * dy).Sqrt()
};
let route = "  /API V2/Users  " |> .Trim() |> .ToLower() |> .Replace(" ", "-");
let weights = [ :low, :high, :low ].Map((k) => if k == :low { 10 } else { 100 });

println(f"Hex={hex}, Bits={bits}, Lerp={lerped}, Flag={flag_label}, Period={period_sec}s, Bytes={buf_bytes}");
println(f"Badge={badge}, Dist={dist}, Route={route}, Mean={weights.Mean()}");

// 4. Self-Returning Cascade (`..`) with Momentary Output Capture vs Pipeline (`|>`)
struct PacketBuilder : IValue {
    pub var parts: str[] = [];

    pub self() {
        .parts = [];
    }

    pub var fn add_header(h: str) -> void {
        .parts.append(h);
    }

    pub var fn push_payload(body: str) -> i64 {
        .parts.append(body);
        return len(body);
    }

    pub var fn seal(payload_bytes: i64, checksum: str) -> void {
        .parts.append(f"len={payload_bytes}:{checksum}");
    }

    pub pure fn checksum_tag() -> str => f"crc{len(.parts)}";
}

var pkt = PacketBuilder();
let body_len = pkt.push_payload("HELLO-PILOT");
let tag = pkt.checksum_tag();
let recorded_len = pkt.push_payload("ACK");
pkt..add_header("SYN")..seal(body_len + recorded_len, tag);

println(f"Cascade self parts={pkt.parts}, captured body_len={body_len}, recorded_len={recorded_len}, tag={tag}");
