// =============================================================================
// Showcase 34: SQL Datasets & Compile-Time Column Property Inference
// =============================================================================
// Demonstrates:
//   1. Parameterized Database Blocks:
//      - `sql(conn) { ... }`, `postgresql(conn) { ... }`, `sqlite(conn) { ... }`
//   2. Compile-Time SQL Query Analysis & Type Inference:
//      - Column names and expressions (`count(*) as total`, `u.salary * 1.1`)
//        synthesize concrete typed `RowRecord` fields at compile time.
//   3. Direct Property & Indexer Access:
//      - Accessing `row.name` or `row["name"]` yields static types with zero `any` fallback.
//   4. Fluid In-Memory `Table<TRow>` & Dataset Emulation:
//      - Uniform query chaining (`.where()`, `.limit()`, `.first()`) across
//        in-memory collections and external databases.
// =============================================================================

println("==================================================================");
println(" Showcase 34: SQL Datasets & Compile-Time Column Inference        ");
println("==================================================================");

// -----------------------------------------------------------------------------
// 1. Parameterized SQL Connection Block with Compile-Time Inferred Row Record
// -----------------------------------------------------------------------------
let pg_conn: str = "postgres://app_user:secret@localhost:5432/corp_metrics";
let sql_conn: str = "sqlite://home/moony/Documents/dev/personal/crm_entities.db";
println("\n[1] Executing Parameterized SQL Block with Compile-Time Inference:");

let metrics_dataset = sqlite {
    select "Company ID", "Company Name", count(*) as total_events, revenue * 1.1 as adjusted_revenue
    from companies
};

println("Dataset returned from query block. Inferred row properties:");
println("  - id: i64");
println("  - name: str");
println("  - total_events: i64");
println("  - adjusted_revenue: f64");

// -----------------------------------------------------------------------------
// 2. Chained Query Methods on Query Result
// -----------------------------------------------------------------------------
println("\n[2] Applying Native Query Methods (.where, .limit):");
let filtered_metrics = metrics_dataset
    .where((r) => r.id > 1)
    .limit(3);

for rec in metrics_dataset {
    println(f"  Metric #{rec.id} [{rec.name}] -> events={rec.total_events}");
}

// -----------------------------------------------------------------------------
// 3. In-Memory Relational `Table<TRow>` & Dataset Emulation
// -----------------------------------------------------------------------------
println("\n[3] In-Memory Relational Table Operations:");

struct Table<TRow> : IValue {
    pub var rows: TRow[];

    pub self(initial_records: TRow[]) {
        .rows = initial_records;
    }

    pub var fn insert(rec: TRow) -> Table<TRow> {
        .rows.append(rec);
        return self;
    }

    pub pure fn where(pred: (TRow) => bool) -> Table<TRow> {
        var matched: TRow[] = [];
        for r in .rows {
            if pred(r) {
                matched.append(r);
            }
        }
        return Table(matched);
    }

    pub pure fn project<TOut>(map_fn: (TRow) => TOut) -> TOut[] {
        var out: TOut[] = [];
        for r in .rows {
            out.append(map_fn(r));
        }
        return out;
    }

    pub pure fn limit(count: i64) -> Table<TRow> {
        var res: TRow[] = [];
        let total_len = len(.rows);
        let n = if count < total_len { count } else { total_len };
        for i in 0..<n {
            res.append(.rows[i]);
        }
        return Table(res);
    }

    pub pure fn first() -> TRow? {
        return if len(.rows) > 0 { .rows[0] } else { none };
    }
}

let customer_table = Table([
    ["id": 101, "name": "Acme Corp",  "tier": "Enterprise", "mrr": 4500.0,],
    ["id": 102, "name": "Beta Labs",  "tier": "Growth",     "mrr": 1200.0,],
    ["id": 103, "name": "Gamma Devs", "tier": "Enterprise", "mrr": 8900.0,],
]);

let enterprise_customers = customer_table
    .where((c) => c["tier"] == "Enterprise")
    .where((c) => c["mrr"] > 2000.0)
    .limit(5);

println("Filtered Enterprise Customers:");
for cust in enterprise_customers.rows {
    println(f"  {cust[\"name\"]} -> MRR: ${cust[\"mrr\"]}");
}

if some top_enterprise = enterprise_customers.first() {
    println(f"\nTop Enterprise Account: {top_enterprise[\"name\"]}");
}

println("\n>>> Showcase 34 Execution Complete! <<<\n");
