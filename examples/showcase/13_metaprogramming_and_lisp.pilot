// ==============================================================================
// Concept 13: Homoiconic Lisp Metaprogramming & Base Object Introspection
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Metaprogramming & Base Objects");
println("==================================================");

// 1. Base Root Value Capabilities (`IAnyValue` / `IValue`)
println("\n--- 1. Root Value Introspection & Reflection ---");

struct SystemCoordinate : IValue {
    pub x: f64;
    pub y: f64;

    pub self(x: f64, y: f64) {
        .x = x;
        .y = y;
    }

    pub pure fn to_string() -> str {
        return f"Coord({.x}, {.y})";
    }

    pub pure fn type_of() -> str {
        return "SystemCoordinate";
    }

    pub pure fn equals(other: SystemCoordinate?) -> bool {
        if some coord = other {
            return (.x == coord.x) && (.y == coord.y);
        }
        return false;
    }
}

let c1 = SystemCoordinate(15.0, 30.0);
let c2: SystemCoordinate? = SystemCoordinate(15.0, 30.0);
let c3: SystemCoordinate? = SystemCoordinate(99.0, 0.0);

println(f"Coordinate Instance c1: {c1.to_string()}");
println(f"Coordinate Type:        {c1.type_of()}");
println(f"c1.equals(c2):          {c1.equals(c2)}");
println(f"c1.equals(c3):          {c1.equals(c3)}");
println(f"c1.equals(none):        {c1.equals(none)}");

// 2. Homoiconic LISP Primitives (cons, car, cdr, atom)
println("\n--- 2. Homoiconic S-Expression Primitives ---");

let item_a = "node_alpha";
let item_b = "node_beta";
let item_c = "node_gamma";

println(f"Symbols constructed: {item_a}, {item_b}, {item_c}");

// Construct pair/list using cons:
let list_pair = cons(item_a, cons(item_b, item_c));
println(f"Constructed S-expression list via cons: {list_pair}");

let first_item = car(list_pair);
let tail_items = cdr(list_pair);

println(f"car(list_pair): {first_item}");
println(f"cdr(list_pair): {tail_items}");
println(f"atom(item_a):   {atom(item_a)}");
println(f"atom(list_pair):{atom(list_pair)}");

println("\n>>> Concept 13 Demonstration Complete! <<<\n");
