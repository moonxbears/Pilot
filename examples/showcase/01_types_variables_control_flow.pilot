// ==============================================================================
// Concept 01: Types, Variables, Collections & Control Flow
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Types, Variables & Control Flow");
println("==================================================");

// 1. Variables and Static Type Inference
println("\n--- 1. Variable Declarations ---");
let inferred_num = 42;
let explicit_text: str = "Pilot Language";
let decimal_val: f64 = 3.14159;
let flag: bool = true;

println(f"Inferred integer: {inferred_num}");
println(f"Explicit string:  {explicit_text}");
println(f"Float precision:  {decimal_val}");
println(f"Boolean flag:     {flag}");

// 2. Rich Collection Data Structures
println("\n--- 2. Collections (Slices, Maps, Tuples) ---");
var numbers: i64[] = [10, 20, 30, 40, 50];
println(f"Initial list: {numbers}");

// Appending and indexing
numbers.append(60);
println(f"Appended 60:  {numbers}");
println(f"First item:   {numbers[0]}");
println(f"Last item:    {numbers[len(numbers) - 1]}");
println(f"List length:  {len(numbers)}");

// Maps (Dictionaries)
let user_map = {
    "username": "isaac_pilot",
    "role": "Lead Architect",
    "level": 99,
};
println(f"\nMap dictionary: {user_map}");
println(f"Username:       {user_map['username']}");
println(f"Role:           {user_map['role']}");

// 3. Control Flow: If-Else & Loops
println("\n--- 3. Control Flow ---");
let score = 85;
println(f"Evaluating score: {score}");
if score >= 90 {
    println("Grade: A - Exceptional!");
} else if score >= 80 {
    println("Grade: B - Very Good!");
} else {
    println("Grade: C - Passing.");
}

println("\nIterating with for-in loop:");
for item in ["Alpha", "Beta", "Gamma"] {
    println(f"  -> Node: {item}");
}

println("\nCounting down with while loop:");
var countdown = 3;
while countdown > 0 {
    println(f"  Countdown: {countdown}...");
    countdown = countdown - 1;
}
println("  Liftoff!");

// 4. Safe Navigation (?.) and Cascade (..) Operators
println("\n--- 4. Safe Navigation & Cascade Operations ---");

struct SystemProfile : IValue {
    pub var title: str = "Root Node";
    pub var status: str = "Active";

    pub self() {
        .title = "Root Node";
        .status = "Active";
    }

    pub var fn set_title(new_title: str) -> void {
        .title = new_title;
    }

    pub var fn set_status(new_status: str) -> void {
        .status = new_status;
    }
}

var node = SystemProfile();
println(f"Original Profile: {node.title} [{node.status}]");

// Cascade operator allows fluid builder-pattern chaining without re-referencing
node..set_title("Master Controller")..set_status("Synchronized");
println(f"After Cascades:   {node.title} [{node.status}]");

// Safe navigation gracefully handles none without throwing exceptions
let empty_target: SystemProfile? = none;
let safe_result = empty_target?.title ?? "unbound";
println(f"Safe navigation on none result: {safe_result}");

println("\n>>> Concept 01 Demonstration Complete! <<<\n");
