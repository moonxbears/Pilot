// =============================================================================
// Showcase 21: Advanced Type Inference — Bidirectional, Flow-Sensitive & Row-Polymorphic
// =============================================================================

pub struct Product : IValue {
    pub:
        title: str;
        price: f64;
        in_stock: bool;

        self(title: str, price: f64, in_stock: bool) {
            .title = title;
            .price = price;
            .in_stock = in_stock;
        }
}

pub struct Frame2D : IValue {
    pub:
        width: i64;
        height: i64;
        name: str;

        self(width: i64, height: i64, name: str) {
            .width = width;
            .height = height;
            .name = name;
        }
}

pub struct Canvas2D : IValue {
    pub:
        width: f64;
        height: f64;

        self(width: f64, height: f64) {
            .width = width;
            .height = height;
        }
}

// 1. Structural Row Polymorphism: infers `({ width: T, height: T, ..R } where T: INumber<T>) -> T`
fn compute_area(surface) => surface.width * surface.height;

let frame_area = compute_area(Frame2D(1920, 1080, "HD"));
let canvas_area = compute_area(Canvas2D(12.5, 8.0));

println(f"Frame area (i64): {frame_area}");
println(f"Canvas area (f64): {canvas_area}");

// 2. Tarjan SCC Fixed-Point Mutual Recursion
fn is_even_step(n: i64) -> bool => if n == 0 { true } else { is_odd_step(n - 1) };
fn is_odd_step(n: i64) -> bool => if n == 0 { false } else { is_even_step(n - 1) };

println(f"is_even_step(10) = {is_even_step(10)}");

// 3. Dominator Control-Flow Narrowing
fn format_discount(code: str?, base_price: f64) -> str {
    guard some code else {
        return f"${base_price} (no promo)";
    }
    return f"${base_price * 0.9} (promo: {code})";
}

println(format_discount("PILOT16", 100.0));
println(format_discount(none, 100.0));
