// ==============================================================================
// Concept 05: Algebraic Struct/Interface Composition & Typestate Machines
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Algebraic Composition & Typestates");
println("==================================================");

// 1. Algebraic Bundle/Interface Composition (`*Bundle`, `|`, `&`, `-`)
println("\n--- 1. Algebraic Struct & Interface Composition ---");

interface IIdentifiable {
    pub pure fn verify_token() -> str;
}

interface ISecurable {
    pub pure fn check_clearance() -> str;
}

struct IdentityBundle : IValue {
    pub var username: str = "captain_eva";

    pub pure fn verify_token() -> str => "TOKEN_VALID_992";
}

struct SecurityBundle : IValue {
    pub var clearance_ring: i64 = 5;

    pub pure fn check_clearance() -> str => "LEVEL_5_CLEAR";
}

struct BillingBundle : IValue {
    pub var credit_balance: f64 = 7500.0;

    pub var fn deduct_credits(amount: f64) -> f64 {
        .credit_balance = .credit_balance - amount;
        return .credit_balance;
    }
}

// Splice `*Bundle` carriers to satisfy composite interface contracts (`IIdentifiable`, `ISecurable`)
struct Commander : IIdentifiable, ISecurable, IValue {
    *IdentityBundle;
    *SecurityBundle;

    pub self() {
        .username = "captain_eva";
        .clearance_ring = 5;
    }
}

// Algebraic Type Composition (`|`, `&`, `-`)
type RolePrincipal = Commander | IdentityBundle;
type PrivilegedPrincipal = IIdentifiable & ISecurable;
type RestrictedPrincipal = IdentityBundle - SecurityBundle;

let cmd = Commander();
println("Commander Instance Created:");
println(f"  Username:        {cmd.username}");
println(f"  Verify Token:    {cmd.verify_token()}");
println(f"  Clearance Ring:  {cmd.clearance_ring}");
println(f"  Check Clearance: {cmd.check_clearance()}");

struct GuestUser : IIdentifiable, IValue {
    *IdentityBundle;

    pub self() {
        .username = "guest_observer";
    }
}

let guest = GuestUser();
println(f"\nGuest Instance Created: Username={guest.username}");

// 2. Compile-Time Typestates (`state` State Machines)
println("\n--- 2. Compile-Time Typestate Machines ---");

[Typestate]
enum SocketPhase {
    Disconnected,
    Connected,
}

struct ConnectedSocket : IValue {
    pub host: str;
    pub port: i64;

    pub self(host: str, port: i64) {
        .host = host;
        .port = port;
    }

    pub pure fn current_state() -> str => "Connected";

    pub fn transmit(message: str) -> str {
        println(f"  [TRANSMIT] Sending encrypted packet: '{message}'");
        return "ACK: 200 OK";
    }

    pub fn disconnect() -> DisconnectedSocket {
        println("  [TRANSITION] Closing socket and releasing buffer...");
        return DisconnectedSocket("closed");
    }
}

struct DisconnectedSocket : IValue {
    pub endpoint: str;

    pub self(endpoint: str) {
        .endpoint = endpoint;
    }

    pub pure fn current_state() -> str => "Disconnected";

    pub fn connect(host: str, port: i64) -> ConnectedSocket {
        println(f"  [TRANSITION] Connecting to {host}:{port}...");
        return ConnectedSocket(host, port);
    }
}

let socket = DisconnectedSocket("unbound");
println(f"Initial socket created. Current State: {socket.current_state()}");

// Transition DisconnectedSocket -> ConnectedSocket
let active_socket = socket.connect("api.pilot-lang.org", 443);
println(f"Current State: {active_socket.current_state()}");

let reply = active_socket.transmit("GET /telemetry/stream HTTP/1.1");
println(f"Server Response: {reply}");

// Transition ConnectedSocket -> DisconnectedSocket
let idle_socket = active_socket.disconnect();
println(f"Current State: {idle_socket.current_state()}");

println("\n>>> Concept 05 Demonstration Complete! <<<\n");
