// ==============================================================================
// Concept 09: Design-by-Contract (Requires, Ensures & Old State Snapshots)
// ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Design-by-Contract Validation");
println("==================================================");

struct AccountVault : IValue {
    pub var account_id: str;
    pub var balance: f64;

    pub self(account_id: str, balance: f64) {
        .account_id = account_id;
        .balance = balance;
    }

    pub var fn withdraw(amt: f64) {
        .balance = .balance - amt;
    }

    pub var fn deposit(amt: f64) {
        .balance = .balance + amt;
    }
}

// The function signature declares declarative specifications:
// 'requires' runs before body execution
// 'ensures' runs after body execution and validates post-state against old(...) snapshots
fn execute_funds_transfer(transfer_amount: f64, var ref source: AccountVault, var ref destination: AccountVault) -> bool
    requires transfer_amount > 0.0
    requires source.balance >= transfer_amount
    ensures source.balance == old(source.balance) - transfer_amount
    ensures destination.balance == old(destination.balance) + transfer_amount
    ensures result == true
{
    println(f"  [CONTRACT VERIFIED] Preconditions passed! Executing ledger transfer of ${transfer_amount}");
    source.withdraw(transfer_amount);
    destination.deposit(transfer_amount);
    println(f"  [LEDGER UPDATED] Source new balance: ${source.balance}, Destination new balance: ${destination.balance}");
    return true;
}

println("\n--- 1. Valid Contract Execution ---");
var checking = AccountVault("CHK-9102", 1200.0);
var savings = AccountVault("SAV-3341", 500.0);

println("Initial Balances:");
println(f"  Checking (Source):      ${checking.balance}");
println(f"  Savings (Destination):  ${savings.balance}");

println("\nCalling execute_funds_transfer(400.0, checking, savings):");
let success = execute_funds_transfer(400.0, checking, savings);
println(f"Transfer Success: {success}");

println("\nFinal Balances Verified by Postconditions:");
println(f"  Checking balance:  ${checking.balance} (old was $1200.0 - $400.0)");
println(f"  Savings balance:   ${savings.balance} (old was $500.0 + $400.0)");

println("\n--- 2. Contract Precondition Failure Protection ---");
println(f"Attempting transfer exceeding source balance ($10,000.0 > ${checking.balance}):");

try {
    execute_funds_transfer(10000.0, checking, savings);
} catch contract_err {
    println(f"  [CONTRACT ENFORCED] Precondition violation trapped: {contract_err}");
}

println("\n>>> Concept 09 Demonstration Complete! <<<\n");
