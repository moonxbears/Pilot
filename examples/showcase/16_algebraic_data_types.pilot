// ==============================================================================
// Concept 16: Algebraic Data Types (ADTs) & Exhaustive Pattern Switching
// ==============================================================================

println("==========================================================");
println(" PILOT SHOWCASE: Algebraic Data Types & Exhaustive Switch");
println("==========================================================");

// 1. Immutable `0b00` Value-Semantic Product Types (`struct : IValue`)
println("\n--- 1. Value-Semantic Product Structs & Unboxed Storage ---");

pub struct Point : IValue {
    pub:
        x: f64;
        y: f64;

        self(x: f64 = 0.0, y: f64 = 0.0) {
            .x = x;
            .y = y;
        }
}

let p1 = Point(3.0, 4.0);
let p2 = Point(3.0, 4.0);

println(f"Point p1:                       ({p1.x}, {p1.y})");
println(f"Structural equality (p1 == p2): {p1.x == p2.x && p1.y == p2.y}");

// 2. Discriminated Sum Types (`enum`) & Compact Tagged Unions
println("\n--- 2. First-Class Sum Types & Compact Tagged Unions ---");

pub enum Shape {
    Circle(radius: f64),
    Rectangle(width: f64, height: f64),
    Polygon(pts: Point[]),
    Origin,
}

let shapes: Shape[] = [
    ::Origin,
    ::Circle(5.0),
    ::Rectangle(6.0, 6.0),
    ::Rectangle(4.0, 9.0),
    ::Polygon([Point(0.0, 0.0), Point(3.0, 4.0), Point(6.0, 0.0),]),
];

pub pure fn describe_shape(s: Shape) -> str {
    return switch s {
        case Origin: "Origin (0, 0)";
        case Circle(r): f"Circle(r={r})";
        case Rectangle(w, h) if w == h: f"Square(side={w})";
        case Rectangle(w, h): f"Rectangle({w} x {h})";
        case Polygon([]): "Empty Polygon";
        case Polygon([first_pt, ..rest]): f"Polygon(start=({first_pt.x}, {first_pt.y}), +{len(rest)} pts)";
    };
}

for s in shapes {
    println(f"  -> {describe_shape(s)}");
}

// 3. Generic & Recursive ADTs (`Expr<T>`)
println("\n--- 3. Generic & Recursive ADTs (Expr<T> Evaluator) ---");

pub enum Expr<T> {
    Const(val: T),
    Add(lhs: Expr<T>, rhs: Expr<T>),
    Mul(lhs: Expr<T>, rhs: Expr<T>),
}

pub pure fn eval_expr(expr: Expr<i64>) -> i64 {
    return switch expr {
        case Const(v): v;
        case Add(l, r): eval_expr(l) + eval_expr(r);
        case Mul(l, r): eval_expr(l) * eval_expr(r);
    };
}

pub pure fn format_expr(expr: Expr<i64>) -> str {
    return switch expr {
        case Const(v): f"{v}";
        case Add(l, r): f"({format_expr(l)} + {format_expr(r)})";
        case Mul(l, r): f"({format_expr(l)} * {format_expr(r)})";
    };
}

let c10: Expr<i64> = ::Const(10);
let c4: Expr<i64>  = ::Const(4);
let c3: Expr<i64>  = ::Const(3);
let sum_node: Expr<i64> = ::Add(c10, c4);
let tree: Expr<i64> = ::Mul(sum_node, c3);
println(f"Expression AST:                 {format_expr(tree)} = {eval_expr(tree)}");

// 4. Range Patterns & Conditional Bindings
println("\n--- 4. Deep Destructuring, Parenthesized Ranges & Conditional Guard ---");

pub enum ResponseMsg {
    OkBatch(items: i64[]),
    Pending,
    Running,
    StatusCode(code: i64),
}

pub pure fn inspect_response(msg: ResponseMsg) -> str {
    return switch msg {
        case OkBatch([first, ..rest]): f"OK head={first} (remaining={len(rest)})";
        case Pending | Running: "In-flight async job";
        case StatusCode(n) if n >= 0 && n < 10: "Priority tier [0, 10)";
        case StatusCode(n) if n >= 200 && n <= 299: "HTTP 2xx Success";
        default: "Unhandled payload";
    };
}

pub pure fn classify_http_code(code: i64) -> str {
    return switch code {
        case (0 ..< 10):  "Priority tier [0, 10)";
        case (200 .. 299): "HTTP 2xx Success";
        default:          "Other status code";
    };
}

let msg_ok: ResponseMsg = ::OkBatch([42, 99, 105,]);
let msg_run: ResponseMsg = ::Running;
println(f"  OkBatch([42, 99, 105]) => {inspect_response(msg_ok)}");
println(f"  Running                => {inspect_response(msg_run)}");
println(f"  7                      => {classify_http_code(7)}");
println(f"  204                    => {classify_http_code(204)}");

println("\n>>> Concept 16 Demonstration Complete! <<<\n");
