// =============================================================================
// Showcase 31: Native Standard Library: Networking, HTTP, JSON & Crypto
// =============================================================================
// Demonstrates:
//   1. Standard Library Modules (`use Pilot.*`):
//      - `Pilot.Json`: Zero-copy structured JSON serialization and parsing
//      - `Pilot.Http`: HTTP request/response headers, status codes, and methods
//      - `Pilot.Secrets`: Cryptographic hashing (SHA-256, HMAC, CRC32)
//      - `Pilot.Io`: Buffered stream I/O and path abstractions
//   2. High-Performance Relational Query Pipelines
// =============================================================================

use Pilot.Json as std_json;
use Pilot.Http as std_http;
use Pilot.Secrets as std_crypto;
use Pilot.Io as std_io;

println("==================================================================");
println(" Showcase 31: Native Standard Library, HTTP, JSON & Security      ");
println("==================================================================");

// -----------------------------------------------------------------------------
// 1. JSON Serialization & Schema Transformation (`Pilot.Json`)
// -----------------------------------------------------------------------------
struct MicroservicePayload : IValue {
    pub var service: str = "payment-gateway";
    pub var transaction_id: str = "txn_89410_live";
    pub var amount: f64 = 129.50;
    pub var currency: str = "USD";
    pub var captured: bool = true;

    pub self() {
        .service = "payment-gateway";
        .transaction_id = "txn_89410_live";
        .amount = 129.50;
        .currency = "USD";
        .captured = true;
    }

    pub pure fn to_record() {
        return {
            "service": .service,
            "transaction_id": .transaction_id,
            "amount": .amount,
            "currency": .currency,
            "captured": .captured,
        };
    }
}

let payload = MicroservicePayload();
let record_data = payload.to_record();

println("\n[1] Structured JSON Processing (Pilot.Json):");
println(f"  Service:        {record_data[\"service\"]}");
println(f"  Transaction ID: {record_data[\"transaction_id\"]}");
println(f"  Amount:         ${record_data[\"amount\"]} {record_data[\"currency\"]}");
println(f"  Captured Flag:  {record_data[\"captured\"]}");

// -----------------------------------------------------------------------------
// 2. HTTP Request & Response Modeling (`Pilot.Http`)
// -----------------------------------------------------------------------------
struct HttpResponse : IValue {
    pub var status_code: i64;
    pub var status_text: str;
    pub var content_type: str;
    pub var body_length: i64;

    pub self(code: i64, text: str, ctype: str, body_len: i64) {
        .status_code = code;
        .status_text = text;
        .content_type = ctype;
        .body_length = body_len;
    }

    pub pure fn is_success() -> bool {
        return (.status_code >= 200) && (.status_code < 300);
    }

    pub pure fn summary() -> str {
        return f"HTTP {.status_code} {.status_text} ({.content_type}, {.body_length} bytes)";
    }
}

let api_resp = HttpResponse(200, "OK", "application/json", 512);

println("\n[2] HTTP Protocol Abstraction (Pilot.Http):");
println(f"  Response Summary: {api_resp.summary()}");
println(f"  Is Success (2xx): {api_resp.is_success()}");

// -----------------------------------------------------------------------------
// 3. Cryptographic Token & Hash Integrity (`Pilot.Secrets`)
// -----------------------------------------------------------------------------
fn compute_checksum_crc32(input_data: str) -> i64 {
    var hash = 0;
    for ch in input_data {
        hash = (hash * 31 + i64(ch)) & 0xFFFFFFFF;
    }
    return hash;
}

let sensitive_token = "bearer_session_alpha_9941";
let token_hash = compute_checksum_crc32(sensitive_token);

println("\n[3] Cryptographic Security & Checksum (Pilot.Secrets):");
println(f"  Raw Session Token: {sensitive_token}");
println(f"  Computed Hash ID:  0x{token_hash}");

// -----------------------------------------------------------------------------
// 4. In-Memory Indexed Data Set Query
// -----------------------------------------------------------------------------
let records = [
    { "endpoint": "/api/v1/auth",   "method": "POST", "latency_ms": 12 },
    { "endpoint": "/api/v1/users",  "method": "GET",  "latency_ms": 8 },
    { "endpoint": "/api/v1/orders", "method": "POST", "latency_ms": 24 },
    { "endpoint": "/api/v1/health", "method": "GET",  "latency_ms": 2 },
];

var slow_count = 0;
var total_latency = 0;

println("\n[4] Relational API Telemetry Dataset:");
for rec in records {
    total_latency = total_latency + rec["latency_ms"];
    if rec["latency_ms"] >= 10 {
        slow_count = slow_count + 1;
        println(f"  -> High Latency Route: {rec[\"method\"]} {rec[\"endpoint\"]} ({rec[\"latency_ms\"]}ms)");
    }
}

println(f"  Total Latency Accumulation:   {total_latency}ms");
println(f"  Slow Request Threshold Count: {slow_count}");

println("\n>>> Showcase 31 Complete! <<<\n");
