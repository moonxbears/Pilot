// =============================================================================
// Showcase 30: Interactive Debug Adapter Protocol (DAP) & GUI Debugging
// =============================================================================
// Demonstrates:
//   1. Full Debug Adapter Protocol (DAP) Implementation:
//      - Native integration with VS Code GUI debugger via `pilot-dap`
//   2. Breakpoints & Flow Control:
//      - Line breakpoints, conditional breakpoints, and hit count limits
//      - Step Over (`next`), Step In (`stepIn`), Step Out (`stepOut`), Continue
//   3. Three-Tier Scope Inspection:
//      - Locals: Active stack frame bindings
//      - Registers: Virtual machine register allocations (r0..r63)
//      - Globals: Module-level variables and imported declarations
//   4. Interactive Variable Evaluation & Watch Expressions:
//      - Dynamic expressions evaluated in live stack frame context
// =============================================================================

println("==================================================================");
println(" Showcase 30: Interactive Debug Adapter Protocol (DAP) Debugging  ");
println("==================================================================");

// -----------------------------------------------------------------------------
// 1. Nested Function Stack Frames
// -----------------------------------------------------------------------------
fn compute_factor(base: i64, exponent: i64) -> i64 {
    // Breakpoint: inspect base, exponent, and local product in VS Code DAP
    var product = 1;
    for i in 0..exponent {
        product = product * base;
    }
    return product;
}

fn analyze_sample_series(name: str, values: i64[]) -> i64 {
    // Breakpoint: Step Into compute_factor from this stack frame
    var total_accum = 0;
    for val in values {
        let scaled = compute_factor(val, 2);
        total_accum = total_accum + scaled;
    }
    return total_accum;
}

let series_name = "TelemetryClusterA";
let readings: i64[] = [2, 3, 4, 5];

println("\n[1] Executing Nested Call Frames (Traceable in DAP Call Stack):");
let analysis_result = analyze_sample_series(series_name, readings);
println(f"  Series Name:        {series_name}");
println(f"  Analysis Aggregate: {analysis_result}");

// -----------------------------------------------------------------------------
// 2. Structured Data Model for Watch Expressions
// -----------------------------------------------------------------------------
struct DiagnosticSession : IValue {
    pub var session_id: i64;
    pub var target_node: str;
    pub var error_count: i64 = 0;
    pub var is_active: bool = true;

    pub self(id: i64, node: str) {
        .session_id = id;
        .target_node = node;
        .error_count = 0;
        .is_active = true;
    }

    pub var fn record_fault(code: i64) {
        .error_count = .error_count + 1;
    }

    pub pure fn health_score() -> f64 {
        if .error_count == 0 {
            return 100.0;
        }
        return 100.0 / f64(.error_count + 1);
    }
}

var session = DiagnosticSession(4001, "worker-node-03");
session.record_fault(101);
session.record_fault(102);

println("\n[2] Inspected Struct State (Visible in DAP Variables View):");
println(f"  Session ID:    {session.session_id}");
println(f"  Target Node:   {session.target_node}");
println(f"  Fault Count:   {session.error_count}");
println(f"  Health Score:  {session.health_score()}%");

// -----------------------------------------------------------------------------
// 3. Conditional Breakpoint Demonstration Invariant
// -----------------------------------------------------------------------------
var accumulated_sum = 0;
for counter in 1..10 {
    accumulated_sum = accumulated_sum + counter;
    // Set conditional breakpoint in VS Code: `counter == 5`
    if counter == 5 {
        println("\n[3] Reached Conditional Breakpoint Trigger point (counter == 5):");
        println(f"  Intermediate Sum: {accumulated_sum}");
    }
}

println(f"\n  Final Loop Sum: {accumulated_sum}");

println("\n>>> Showcase 30 Complete! <<<\n");
