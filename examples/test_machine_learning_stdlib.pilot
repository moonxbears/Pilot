// Integration Test: std.scikit (Machine Learning)
// Multi-OS validation for ML estimators, transformers, and evaluation metrics across Linux, Windows, macOS, Android, iOS, and WebAssembly.

import std.scikit as skl;
import std.numpy as np;

def test_preprocessing() {
    print("=== Testing std.scikit Preprocessing ===");

    // 1. StandardScaler
    let X = [
        [10.0, 100.0],
        [20.0, 200.0],
        [30.0, 300.0]
    ];
    let scaler = skl.StandardScaler();
    let scaled = scaler.fit_transform(X);
    assert(len(scaled) == 3, "scaled rows 3");
    assert(scaler.mean_[0] == 20.0, "mean col 0 is 20.0");
    assert(scaler.mean_[1] == 200.0, "mean col 1 is 200.0");

    let reconstructed = scaler.inverse_transform(scaled);
    assert(reconstructed[1][0] >= 19.9 and reconstructed[1][0] <= 20.1, "reconstructed row 1 col 0");

    // 2. MinMaxScaler
    let min_max = skl.MinMaxScaler(0.0, 1.0);
    let mm_scaled = min_max.fit_transform(X);
    assert(mm_scaled[0][0] == 0.0, "min normalized to 0.0");
    assert(mm_scaled[2][0] == 1.0, "max normalized to 1.0");
    assert(mm_scaled[1][0] == 0.5, "mid normalized to 0.5");

    // 3. LabelEncoder
    let labels = ["cat", "dog", "cat", "bird", "dog"];
    let le = skl.LabelEncoder();
    let encoded = le.fit_transform(labels);
    assert(len(encoded) == 5, "encoded length 5");
    assert(encoded[0] == encoded[2], "identical classes have identical codes");

    let decoded = le.inverse_transform(encoded);
    assert(decoded[0] == "cat", "decoded 0 is cat");
    assert(decoded[1] == "dog", "decoded 1 is dog");
    assert(decoded[3] == "bird", "decoded 3 is bird");

    print("Preprocessing tests passed!");
}

def test_supervised_learning() {
    print("=== Testing std.scikit Supervised Learning ===");

    // 1. LinearRegression: y = 2.0 * x0 + 3.0 * x1 + 5.0
    var X_reg: [[f64]] = [];
    var y_reg: [f64] = [];
    for i in 0..<20 {
        let x0 = float(i);
        let x1 = float(i % 5);
        let y = 2.0 * x0 + 3.0 * x1 + 5.0;
        X_reg.append([x0, x1]);
        y_reg.append(y);
    }

    let reg = skl.LinearRegression(true);
    reg.fit(X_reg, y_reg);
    let preds = reg.predict(X_reg);

    let mse = skl.mean_squared_error(y_reg, preds);
    let r2 = skl.r2_score(y_reg, preds);
    assert(mse < 1.0, "linear regression MSE is low");
    assert(r2 > 0.95, "linear regression R2 is high");

    // 2. LogisticRegression: Binary Classification
    var X_clf: [[f64]] = [];
    var y_clf: [f64] = [];
    // Class 0: centered around (1, 1)
    X_clf.append([0.5, 0.5]); y_clf.append(0.0);
    X_clf.append([1.0, 1.2]); y_clf.append(0.0);
    X_clf.append([1.5, 0.8]); y_clf.append(0.0);
    // Class 1: centered around (5, 5)
    X_clf.append([4.5, 5.0]); y_clf.append(1.0);
    X_clf.append([5.2, 4.8]); y_clf.append(1.0);
    X_clf.append([5.5, 5.5]); y_clf.append(1.0);

    let clf = skl.LogisticRegression(0.2, 500);
    clf.fit(X_clf, y_clf);
    let clf_preds = clf.predict(X_clf);
    let acc = skl.accuracy_score(y_clf, clf_preds);
    assert(acc == 1.0, "logistic regression separates trivial clusters");

    // 3. KNeighborsClassifier
    let knn = skl.KNeighborsClassifier(3);
    knn.fit(X_clf, y_clf);
    let knn_preds = knn.predict(X_clf);
    let knn_acc = skl.accuracy_score(y_clf, knn_preds);
    assert(knn_acc == 1.0, "KNN classification accuracy 100%");

    print("Supervised learning tests passed!");
}

def test_unsupervised_and_metrics() {
    print("=== Testing std.scikit Clustering & Evaluation Metrics ===");

    // 1. KMeans Clustering
    var X_clusters: [[f64]] = [];
    // Cluster 0: points near 0
    X_clusters.append([0.1, 0.2]);
    X_clusters.append([0.2, 0.1]);
    X_clusters.append([0.0, 0.3]);
    // Cluster 1: points near 10
    X_clusters.append([10.0, 10.1]);
    X_clusters.append([9.9, 10.2]);
    X_clusters.append([10.2, 9.8]);

    let km = skl.KMeans(2, 50);
    km.fit(X_clusters);
    assert(len(km.cluster_centers_) == 2, "2 cluster centers identified");
    assert(km.inertia_ < 2.0, "tight cluster inertia");

    let labels = km.predict([[0.0, 0.0], [10.0, 10.0]]);
    assert(labels[0] != labels[1], "two distinct points map to distinct clusters");

    // 2. Metrics & Model Selection
    let y_true = [1.0, 0.0, 1.0, 1.0, 0.0, 1.0];
    let y_pred = [1.0, 0.0, 1.0, 0.0, 0.0, 1.0];

    let cm = skl.confusion_matrix(y_true, y_pred);
    assert(cm[0][0] == 2, "true negatives count 2");
    assert(cm[1][1] == 3, "true positives count 3");

    let prec = skl.precision_score(y_true, y_pred);
    let rec = skl.recall_score(y_true, y_pred);
    let f1 = skl.f1_score(y_true, y_pred);
    assert(prec == 1.0, "precision is 1.0 (no false positives)");
    assert(rec == 0.75, "recall is 3/4 = 0.75");
    assert(f1 > 0.8, "f1 score > 0.8");

    // 3. train_test_split
    let split_res = skl.train_test_split(X_clusters, [0.0, 0.0, 0.0, 1.0, 1.0, 1.0], 0.33);
    assert(len(split_res[0]) == 4, "train samples 4");
    assert(len(split_res[1]) == 2, "test samples 2");

    print("Unsupervised learning & metrics tests passed!");
}

def main() {
    print("Starting integration tests for std.scikit (Machine Learning)...");
    test_preprocessing();
    test_supervised_learning();
    test_unsupervised_and_metrics();
    print("ALL TESTS IN std.scikit PASSED SUCCESSFULLY!");
}
