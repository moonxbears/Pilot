import std.math as math;
import std.random as random;
import std.secrets as secrets;
import std.decimal as decimal;

def test_math() {
    // 1. Python math functions
    let f1 = math.fabs(-42.5);
    let s1 = math.copysign(10.0, -1.0);
    let t1 = math.trunc(-3.7);
    let m1 = math.fmod(10.5, 3.0);
    let h1 = math.hypot(3.0, 4.0); // 5.0
    let d1 = math.dist((0.0, 0.0), (3.0, 4.0)); // 5.0
    let c1 = math.comb(5, 2); // 10
    let p1 = math.perm(5, 2); // 20
    let close = math.isclose(0.1 + 0.2, 0.3, 0.00001);
    let product = math.prod([2, 3, 4]); // 24.0
    let deg = math.degrees(3.141592653589793); // 180.0
    let rad = math.radians(180.0);
    let fin = math.isfinite(100.0);
}

def test_random() {
    // 1. Python random functions
    random.seed(42);
    let r_float = random.random();
    let r_uni = random.uniform(1.0, 10.0);
    let r_int = random.randint(1, 100);
    let r_range = random.randrange(0, 100, 5);

    let items = ["apple", "banana", "cherry", "date"];
    let ch = random.choice(items);
    let chs = random.choices(items, 3);
    let shuf = random.shuffle(items);
    let samp = random.sample(items, 2);
    let g = random.gauss(0.0, 1.0);
    let tri = random.triangular(0.0, 10.0, 5.0);
}

def test_secrets() {
    // 1. Cryptographically secure random tokens
    let bytes_token = secrets.token_bytes(16);
    let hex_token = secrets.token_hex(16);
    let url_token = secrets.token_urlsafe(16);

    // 2. Cryptographic integers & choices
    let below = secrets.randbelow(100);
    let bits = secrets.randbits(16);
    let chosen = secrets.choice(["secret_key_1", "secret_key_2", "secret_key_3"]);

    // 3. Constant-time digest comparison
    let match_res = secrets.compare_digest("secret_password", "secret_password");
    let mismatch = secrets.compare_digest("secret_password", "wrong_password");
}

def test_decimal() {
    // 1. Exact Decimal Arithmetic (0.1 + 0.2 == 0.3)
    let d1 = decimal.Decimal("0.1");
    let d2 = decimal.Decimal("0.2");
    let d3 = d1.add(d2); // Exactly 0.3!
    let d_target = decimal.Decimal("0.3");
    let is_exact: bool = d3.eq(d_target);

    // 2. Subtraction, Multiplication, Division
    let diff = d3.sub(d1); // 0.2
    let prod = d1.mul(decimal.Decimal("10")); // 1.0
    let div_res = decimal.Decimal("1").div(decimal.Decimal("2")); // 0.5

    // 3. String formatting & conversion
    let s_out = d3.to_string();
    let f_val = d3.to_f64();
    let i_val = decimal.Decimal("42.8").to_int(); // 42

    // 4. Quantize rounding
    let d_pi = decimal.Decimal("3.14159");
    let rounded = d_pi.quantize(decimal.Decimal("0.01")); // 3.14

    // 5. Context management
    let ctx = decimal.getcontext();
    decimal.setcontext(decimal.Context(16, decimal.ROUND_HALF_UP));
}

def main() {
    test_math();
    test_random();
    test_secrets();
    test_decimal();
    print("All math, random, secrets, and decimal tests executed cleanly!");
}
