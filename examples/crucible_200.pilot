// ============================================================================
// CRUCIBLE-200: COMPILER & ABI TORTURE SPECIFICATION (PILOT IMPLEMENTATION)
// Expected 64-bit Output: 0x00C5009106A1013B
// ============================================================================

// --- PILLAR 1: STRUCT ABI, SRET (>16 BYTES), AND ODD-SIZED VALUE PASSING ---

struct OddHeader {
    var tag: u8
    var flags: u8
    var pad: u8 // 3-byte odd size to stress register packing & stack alignment
}

struct TransformFrame {
    var x: i32
    var y: i32
    var z: i32
    var weight: i64
    var mask: u16
    var hop: u8
    var pad: u8 // 28-byte size forces hidden sret pointer on SysV & Win64 ABIs
}

def step_frame(var f: TransformFrame, h: OddHeader, delta: i32) -> TransformFrame {
    f.x = f.x + (delta * i32(h.tag))
    f.y = f.y - delta
    f.z = f.z ^ i32(h.flags)
    f.weight = (f.weight * 3) + i64(f.x)
    f.mask = (f.mask << 1) | (u16(h.tag) & 1)
    f.hop = f.hop + 1
    return f // Must write to caller's sret slot without clobbering frame
}

def test_pillar_1() -> u64 {
    let f0 = TransformFrame(10, 20, 0x55, 7, 3, 1, 0)
    let h0 = OddHeader(3, 0x0F, 0xAA)
    let h1 = OddHeader(2, 0x33, 0xBB)

    // Pass f0 by value; f0 itself must remain unmodified in caller scope
    let f1 = step_frame(f0, h0, 4)
    let f2 = step_frame(f1, h1, -2)

    // Verify f0 was not aliased/mutated by step_frame
    if f0.x != 10 or f0.hop != 1 {
        return 0xDEAD
    }

    var arena: TransformFrame[] = [f0, f2]
    // Must mutate in-place in the array, NOT mutate a temporary rvalue copy
    arena[1].hop = arena[1].hop + 10

    let res = arena[1]
    let total = i64(res.x) + i64(res.y) + i64(res.z)
              + res.weight + i64(res.mask) + i64(res.hop)
    return u64(total) & 0xFFFF // Expected: 315 (0x013B)
}

// --- PILLAR 2: SUB-WORD BIT MANIPULATION, PROMOTION & SIGN EXTENSION ---

def test_pillar_2() -> u64 {
    // 1. Logical vs Arithmetic shift on sub-word 1-byte integers
    let raw_u8: u8 = 0xE8 // 232 unsigned
    let raw_i8: i8 = -24  // 0xE8 in two's complement

    let u_shr: i32 = i32(raw_u8 >> 2) // Must be 58 (0x3A), zero-filled
    let i_shr: i32 = i32(raw_i8 >> 2) // Must be -6 (0xFA), sign-extended

    // 2. Unaligned 11-bit cross-byte extraction from packed little-endian stream
    let stream: u8[] = [0xAB, 0xCD, 0xEF, 0x12]
    let packed: u32 = u32(stream[0])
                    | (u32(stream[1]) << 8)
                    | (u32(stream[2]) << 16)
                    | (u32(stream[3]) << 24)

    // Extract 11 bits starting at bit offset 5 -> 0x066D (1645)
    let field11: i32 = i32((packed >> 5) & 0x7FF)

    let total: i32 = u_shr + i_shr + field11
    return u64(total) & 0xFFFF // Expected: 58 - 6 + 1645 = 1697 (0x06A1)
}

// --- PILLAR 3: RECURSIVE TAGGED UNIONS, PAYLOAD ALIGNMENT & STRIDE ---

type ExprNode =
    | Lit(val: i64)
    | UnaryInvert(child: i32, shift: u8)
    | BinOp(op: u8, left: i32, right: i32)
    | Ternary(cond: i32, then_br: i32, else_br: i32)

def eval_ast(nodes: ExprNode[], idx: i32) -> i64 {
    let node = nodes[int(idx)]
    return match node {
        case ExprNode.Lit(val) => val
        case ExprNode.UnaryInvert(child, shift) => {
            let v = eval_ast(nodes, child)
            return (~v) ^ (1 << i64(shift))
        }
        case ExprNode.BinOp(op, left, right) => {
            let l = eval_ast(nodes, left)
            let r = eval_ast(nodes, right)
            if op == 0 { return l + r }
            if op == 1 { return l - r }
            if op == 2 { return l * r }
            return 0
        }
        case ExprNode.Ternary(cond, then_br, else_br) => {
            if eval_ast(nodes, cond) != 0 {
                return eval_ast(nodes, then_br)
            } else {
                return eval_ast(nodes, else_br)
            }
        }
    }
}

def test_pillar_3() -> u64 {
    let tree: ExprNode[] = [
        ExprNode.Lit(42),                             // [0] = 42
        ExprNode.Lit(10),                             // [1] = 10
        ExprNode.BinOp(1, 0, 1),                      // [2] = 42 - 10 = 32
        ExprNode.Lit(5),                              // [3] = 5
        ExprNode.BinOp(2, 2, 3),                      // [4] = 32 * 5 = 160
        ExprNode.UnaryInvert(1, 2),                   // [5] = (~10) ^ 4 = -15
        ExprNode.Ternary(2, 4, 5),                    // [6] = 32 != 0 ? 160 : -15
        ExprNode.BinOp(0, 6, 5)                       // [7] = 160 + (-15) = 145
    ]
    let result = eval_ast(tree, 7)
    return u64(result) & 0xFFFF // Expected: 145 (0x0091)
}

// --- PILLAR 4: CONTROL FLOW, SHORT-CIRCUIT, SHADOWING & DEFER LIFETIMES ---

class FlowState {
    var counter: i32 = 0
}

def step_counter(s: FlowState, mult: i32) -> i32 {
    s.counter = (s.counter * mult) + 1
    return s.counter
}

def combine_ordered(a: i32, b: i32) -> i32 {
    return (a * 10) + b
}

def cond_false(s: FlowState) -> bool {
    s.counter = s.counter + 5
    return false
}

def cond_true(s: FlowState) -> bool {
    s.counter = s.counter + 7
    return true
}

def poison_side_effect(s: FlowState) -> bool {
    s.counter = s.counter + 9999 // Must NEVER execute
    return true
}

def test_pillar_4() -> u64 {
    let st = FlowState()
    st.counter = 1

    // 1. Left-to-right call argument evaluation order:
    // Arg 1: (1 * 2) + 1 = 3. Arg 2: (3 * 3) + 1 = 10. Combine: 3*10 + 10 = 40.
    let order_val = combine_ordered(step_counter(st, 2), step_counter(st, 3))

    // 2. Short-circuit evaluation must skip RHS side effects
    if cond_false(st) and poison_side_effect(st) {
        return 0xBAD1
    }
    if cond_true(st) or poison_side_effect(st) {
        // st.counter is now 10 + 5 + 7 = 22
    }

    // 3. Lexical shadowing + loop continue/break + scope-exit defer cleanup
    let shadow: i32 = 100
    var loop_sum: i32 = 0
    var defer_trace: i32 = 0

    for i in 0..5 {
        defer { defer_trace = (defer_trace * 2) + 1 }

        let shadow: i32 = i32(i) * 10 // Shadows outer `shadow`
        if i == 1 {
            continue // Must trigger `defer` before jumping to i = 2
        }
        if i == 3 {
            break    // Must trigger `defer` before exiting loop
        }
        loop_sum = loop_sum + shadow // Runs for i=0 (0) and i=2 (20) -> 20
    }
    // `defer` ran 4 times (i = 0, 1, 2, 3): 0 -> 1 -> 3 -> 7 -> 15
    // Outer `shadow` must still be 100

    let total = order_val + st.counter + loop_sum + defer_trace + shadow
    return u64(total) & 0xFFFF // Expected: 40 + 22 + 20 + 15 + 100 = 197 (0x00C5)
}

def main() -> u64 {
    let p1 = test_pillar_1()
    let p2 = test_pillar_2()
    let p3 = test_pillar_3()
    let p4 = test_pillar_4()

    print("--- CRUCIBLE-200 TORTURE BENCHMARK ---")
    print("Pillar 1 (Expected 315 / 0x013B):")
    print(p1)
    print("Pillar 2 (Expected 1697 / 0x06A1):")
    print(p2)
    print("Pillar 3 (Expected 145 / 0x0091):")
    print(p3)
    print("Pillar 4 (Expected 197 / 0x00C5):")
    print(p4)

    let combined = (p4 << 48) | (p3 << 32) | (p2 << 16) | p1
    print("Combined 64-bit Output (Expected 55451193293472059 / 0x00C5009106A1013B):")
    print(combined)

    return combined
}
