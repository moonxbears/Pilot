lexer grammar ConcurrencyLexer;

// =============================================================================
// DOMAIN: Asynchronous & Multi-Threaded Concurrency (Lexer)
// =============================================================================

ASYNC       : 'async';
AWAIT       : 'await';
SPAWN       : 'spawn';
PARALLEL    : 'parallel';
CHAN        : 'chan';
CHANNEL     : 'channel';
ACTOR       : 'actor';
ATOMIC      : 'atomic';
SYNC        : 'sync';
LOCK        : 'lock';
ISOLATE     : 'isolate';
SELECT      : 'select';
CASE        : 'case';
TIMEOUT     : 'timeout';
DEFAULT     : 'default';

ARROW_LEFT  : '<-';
