// std.logging — Multi-OS Flexible Logging Framework
// Modeled after Python's `logging` module (CPython Lib/logging/__init__.py, handlers.py)
// Compatible with Linux, Windows, macOS, Android, iOS, and WebAssembly targets.

pub pkg Pilot.Logging;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// ============================================================================
// 1. Log Levels & Constants (Python: logging.CRITICAL, ERROR, etc.)
// ============================================================================

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __fs_write_text(path: str, content: str) -> any;
    fn __time_perf_counter() -> f64;
}

pub const CRITICAL: i64 = 50;
pub const FATAL: i64 = 50;
pub const ERROR: i64 = 40;
pub const WARNING: i64 = 30;
pub const WARN: i64 = 30;
pub const INFO: i64 = 20;
pub const DEBUG: i64 = 10;
pub const NOTSET: i64 = 0;

pub fn getLevelName(level: i64) -> str {
    if level >= 50 { return "CRITICAL"; }
    if level >= 40 { return "ERROR"; }
    if level >= 30 { return "WARNING"; }
    if level >= 20 { return "INFO"; }
    if level >= 10 { return "DEBUG"; }
    return "NOTSET";
}

pub fn getLevelByName(name: str) -> i64 {
    let upper = name.to_upper();
    if upper == "CRITICAL" || upper == "FATAL" { return 50; }
    if upper == "ERROR" { return 40; }
    if upper == "WARNING" || upper == "WARN" { return 30; }
    if upper == "INFO" { return 20; }
    if upper == "DEBUG" { return 10; }
    return 0;
}

// ============================================================================
// 2. LogRecord (Python: logging.LogRecord)
// ============================================================================

pub struct LogRecord : IValue {
    pub:
        name:      str;
        levelno:   i64;
        levelname: str;
        msg:       str;
        message:   str;
        created:   f64;
        msecs:     f64;

        self(name: str, levelno: i64, msg: str) {
            let ts: f64 = __time_perf_counter();
            let whole_int: i64 = ts as i64;
            let whole: f64 = whole_int as f64;
            .name = name;
            .levelno = levelno;
            .levelname = getLevelName(levelno);
            .msg = msg;
            .message = msg;
            .created = ts;
            .msecs = (ts - whole) * 1000.0;
        }

        fn getMessage() -> str {
            return self.msg;
        }

        fn to_str() -> str {
            return f"<LogRecord: {self.name}, {self.levelname}, \"{self.msg}\">";
        }
}

// ============================================================================
// 3. Formatter & Filters (Python: logging.Formatter, Filter)
// ============================================================================

pub struct Formatter : IValue {
    pub:
        _fmt:    str;
        datefmt: str;

        self(fmt: str = "%(levelname)s:%(name)s:%(message)s", datefmt: str = "") {
            ._fmt = fmt;
            .datefmt = datefmt;
        }

        fn formatTime(rec: any, datefmt: str = "") -> str {
            return str(rec.created);
        }

        fn format(rec: any) -> str {
            var s = self._fmt;
            s = s.replace("%(name)s", rec.name);
            s = s.replace("%(levelname)s", rec.levelname);
            s = s.replace("%(levelno)d", str(rec.levelno));
            s = s.replace("%(message)s", rec.getMessage());
            s = s.replace("%(asctime)s", self.formatTime(rec, self.datefmt));
            return s;
        }
}

pub struct Filter : IValue {
    pub:
        name: str;

        self(name: str = "") {
            .name = name;
        }

        fn filter(rec: any) -> bool {
            if len(self.name) == 0 {
                return true;
            }
            if self.name == rec.name {
                return true;
            }
            if rec.name.starts_with(self.name + ".") {
                return true;
            }
            return false;
        }
}

// ============================================================================
// 4. Log Handlers (Python: logging.Handler, StreamHandler, FileHandler)
// ============================================================================

pub struct Handler : IValue {
    pub:
        level:     i64;
        formatter: Formatter;
        filters:   Filter[];

        self(level: i64 = NOTSET) {
            .level = level;
            .formatter = Formatter();
            .filters = [];
        }

        var fn setLevel(level: i64) {
            self.level = level;
        }

        var fn setFormatter(fmt: Formatter) {
            self.formatter = fmt;
        }

        var fn addFilter(flt: Filter) {
            self.filters.append(flt);
        }

        var fn removeFilter(flt: Filter) {
            var filtered = [];
            for f in self.filters {
                if f != flt {
                    filtered.append(f);
                }
            }
            self.filters = filtered;
        }

        fn filter(rec: any) -> bool {
            for f in self.filters {
                if !f.filter(rec) {
                    return false;
                }
            }
            return true;
        }

        fn format(rec: any) -> str {
            return self.formatter.format(rec);
        }

        fn emit(rec: any) {
            // Base handler no-op
        }

        fn handle(rec: any) -> bool {
            if rec.levelno < self.level {
                return false;
            }
            if !self.filter(rec) {
                return false;
            }
            self.emit(rec);
            return true;
        }

        fn flush() {
            // Flush buffer
        }

        fn close() {
            // Close resources
        }
}

pub struct StreamHandler : IValue {
    pub:
        level:     i64;
        formatter: Formatter;
        filters:   Filter[];

        self(level: i64 = NOTSET) {
            .level = level;
            .formatter = Formatter();
            .filters = [];
        }

        var fn setLevel(level: i64) {
            self.level = level;
        }

        var fn setFormatter(fmt: Formatter) {
            self.formatter = fmt;
        }

        var fn addFilter(flt: Filter) {
            self.filters.append(flt);
        }

        var fn removeFilter(flt: Filter) {
            var filtered = [];
            for f in self.filters {
                if f != flt {
                    filtered.append(f);
                }
            }
            self.filters = filtered;
        }

        fn filter(rec: any) -> bool {
            for f in self.filters {
                if !f.filter(rec) {
                    return false;
                }
            }
            return true;
        }

        fn format(rec: any) -> str {
            return self.formatter.format(rec);
        }

        fn emit(rec: any) {
            let msg = self.format(rec);
            print(msg);
        }

        fn handle(rec: any) -> bool {
            if rec.levelno < self.level {
                return false;
            }
            if !self.filter(rec) {
                return false;
            }
            self.emit(rec);
            return true;
        }

        fn flush() {}
        fn close() {}
}

pub struct FileHandler : IObject {
    pub:
        filename:  str;
        mode:      str;
        level:     i64;
        formatter: Formatter;
        filters:   Filter[];

        self(filename: str, mode: str = "a", level: i64 = NOTSET) {
            .filename = filename;
            .mode = mode;
            .level = level;
            .formatter = Formatter();
            .filters = [];
        }

        ~self() {
            .close();
        }

        var fn setLevel(level: i64) {
            self.level = level;
        }

        var fn setFormatter(fmt: Formatter) {
            self.formatter = fmt;
        }

        var fn addFilter(flt: Filter) {
            self.filters.append(flt);
        }

        var fn removeFilter(flt: Filter) {
            var filtered = [];
            for f in self.filters {
                if f != flt {
                    filtered.append(f);
                }
            }
            self.filters = filtered;
        }

        fn filter(rec: any) -> bool {
            for f in self.filters {
                if !f.filter(rec) {
                    return false;
                }
            }
            return true;
        }

        fn format(rec: any) -> str {
            return self.formatter.format(rec);
        }

        fn emit(rec: any) {
            let msg = self.format(rec) + "\n";
            __fs_write_text(self.filename, msg);
        }

        fn handle(rec: any) -> bool {
            if rec.levelno < self.level {
                return false;
            }
            if !self.filter(rec) {
                return false;
            }
            self.emit(rec);
            return true;
        }

        fn flush() {}
        fn close() {}
}

pub struct NullHandler : IValue {
    pub:
        level:     i64;
        formatter: Formatter;
        filters:   Filter[];

        self() {
            .level = NOTSET;
            .formatter = Formatter();
            .filters = [];
        }

        fn setLevel(level: i64) {}
        fn setFormatter(fmt: Formatter) {}
        fn addFilter(flt: Filter) {}
        fn removeFilter(flt: Filter) {}
        fn handle(rec: any) -> bool { return false; }
        fn emit(rec: any) {}
        fn flush() {}
        fn close() {}
}

// ============================================================================
// 5. Logger (Python: logging.Logger)
// ============================================================================

pub struct Logger : IValue {
    pub:
        name:      str;
        level:     i64;
        parent:    any;
        handlers:  any[];
        filters:   Filter[];
        disabled:  bool;
        propagate: bool;

        self(name: str, level: i64 = NOTSET) {
            .name = name;
            .level = level;
            .parent = none;
            .handlers = [];
            .filters = [];
            .disabled = false;
            .propagate = true;
        }

        var fn setLevel(level: i64) {
            self.level = level;
        }

        fn isEnabledFor(level: i64) -> bool {
            if self.disabled {
                return false;
            }
            return level >= self.getEffectiveLevel();
        }

        fn getEffectiveLevel() -> i64 {
            if self.level != NOTSET {
                return self.level;
            }
            if self.parent != none {
                return self.parent.getEffectiveLevel();
            }
            return INFO;
        }

        var fn addHandler(h: any) {
            self.handlers.append(h);
        }

        var fn removeHandler(h: any) {
            var remaining = [];
            for item in self.handlers {
                if item != h {
                    remaining.append(item);
                }
            }
            self.handlers = remaining;
        }

        var fn addFilter(f: Filter) {
            self.filters.append(f);
        }

        var fn removeFilter(f: Filter) {
            var remaining = [];
            for item in self.filters {
                if item != f {
                    remaining.append(item);
                }
            }
            self.filters = remaining;
        }

        fn filter(rec: any) -> bool {
            for f in self.filters {
                if !f.filter(rec) {
                    return false;
                }
            }
            return true;
        }

        fn callHandlers(rec: any) {
            for h in self.handlers {
                h.handle(rec);
            }
            if self.propagate && self.parent != none {
                self.parent.callHandlers(rec);
            }
        }

        fn handle(rec: any) {
            if self.disabled {
                return;
            }
            if self.filter(rec) {
                self.callHandlers(rec);
            }
        }

        fn makeRecord(name: str, level: i64, msg: str) -> LogRecord {
            return LogRecord(name, level, msg);
        }

        fn log(level: i64, msg: str) {
            if self.isEnabledFor(level) {
                let rec = self.makeRecord(self.name, level, msg);
                self.handle(rec);
            }
        }

        fn debug(msg: str) {
            self.log(DEBUG, msg);
        }

        fn info(msg: str) {
            self.log(INFO, msg);
        }

        fn warning(msg: str) {
            self.log(WARNING, msg);
        }

        fn warn(msg: str) {
            self.log(WARNING, msg);
        }

        fn error(msg: str) {
            self.log(ERROR, msg);
        }

        fn critical(msg: str) {
            self.log(CRITICAL, msg);
        }

        fn fatal(msg: str) {
            self.log(CRITICAL, msg);
        }
}

// ============================================================================
// 6. Global Logger Registry & Helpers (Python: logging.getLogger, basicConfig)
// ============================================================================

struct _LoggerManager : IValue {
    pub:
        root:    Logger;
        loggers: map;

        self() {
            var root_logger = Logger("root", WARNING);
            root_logger.addHandler(StreamHandler(NOTSET));
            .root = root_logger;
            .loggers = {};
        }

        var fn getLogger(name: str = "") -> Logger {
            if len(name) == 0 || name == "root" {
                return self.root;
            }
            if self.loggers.contains_key(name) {
                return self.loggers[name];
            }
            var logger = Logger(name, NOTSET);
            logger.parent = self.root;
            self.loggers[name] = logger;
            return logger;
        }
}

var _MANAGER: _LoggerManager = _LoggerManager();

pub fn getLogger(name: str = "root") -> Logger {
    return _MANAGER.getLogger(name);
}

pub fn basicConfig(level: i64 = INFO, format: str = "", filename: str = "") {
    var root = getLogger("root");
    root.setLevel(level);
    root.handlers = [];

    let fmt_str = if len(format) > 0 { format } else { "%(levelname)s:%(name)s:%(message)s" };
    let formatter = Formatter(fmt_str);

    if len(filename) > 0 {
        var fh = FileHandler(filename, "a", level);
        fh.setFormatter(formatter);
        root.addHandler(fh);
    } else {
        var sh = StreamHandler(level);
        sh.setFormatter(formatter);
        root.addHandler(sh);
    }
}

pub fn debug(msg: str) { getLogger("root").debug(msg); }
pub fn info(msg: str) { getLogger("root").info(msg); }
pub fn warning(msg: str) { getLogger("root").warning(msg); }
pub fn warn(msg: str) { getLogger("root").warn(msg); }
pub fn error(msg: str) { getLogger("root").error(msg); }
pub fn critical(msg: str) { getLogger("root").critical(msg); }
pub fn fatal(msg: str) { getLogger("root").fatal(msg); }
pub fn log(level: i64, msg: str) { getLogger("root").log(level, msg); }

pub fn disable(level: i64 = CRITICAL) {
    var root = getLogger("root");
    if level >= CRITICAL {
        root.disabled = true;
    }
}
