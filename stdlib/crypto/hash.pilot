    if i == 69 { return 2731055270; }
    if i == 70 { return 3203993006; }
    if i == 71 { return 320620315; }
    if i == 72 { return 587496836; }
    if i == 73 { return 1086792851; }
    if i == 74 { return 365543100; }
    if i == 75 { return 2618297676; }
    if i == 76 { return 3409855158; }
    if i == 77 { return 4234509866; }
    if i == 78 { return 987167468; }
    return 1246189591;
}

pub fn sha512_init_k_table(kmap: i64) -> i64 {
    var i = 0;
    while i < 80 {
        __engine("map_set", kmap, i, sha512_k_hi(i));
        __engine("map_set", kmap, 100 + i, sha512_k_lo(i));
        i = i + 1;
    }
    return kmap;
}

pub pure fn sha512_padded_byte(bmap: i64, blen: i64, padded_len: i64, idx: i64) -> i64 {
    if idx < blen {
        return (__engine("map_get", bmap, idx) + 0) & 255;
    }
    if idx == blen {
        return 128;
    }
    if idx >= padded_len - 8 {
        let bit_len = blen * 8;
        let shift = (padded_len - 1 - idx) * 8;
        if shift >= 64 { return 0; }
        return (bit_len >> shift) & 255;
    }
    return 0;
}

pub fn sha512_store_u32_be(st: i64, base_b: i64, w: i64) -> i64 {
    let u = w & 4294967295;
    __engine("map_set", st, base_b, (u >> 24) & 255);
    __engine("map_set", st, base_b + 1, (u >> 16) & 255);
    __engine("map_set", st, base_b + 2, (u >> 8) & 255);
    __engine("map_set", st, base_b + 3, u & 255);
    return st;
}

pub fn sha512_hash_byte_map(bmap: i64, blen: i64) -> i64 {
    let st = __engine("map_new");
    sha512_init_k_table(st);

    var h0_h = 1779033703; var h0_l = 4089235720;
    var h1_h = 3144134277; var h1_l = 2227873595;
    var h2_h = 1013904242; var h2_l = 4271175723;
    var h3_h = 2773480762; var h3_l = 1595750129;
    var h4_h = 1359893119; var h4_l = 2917565137;
    var h5_h = 2600822924; var h5_l = 725511199;
    var h6_h = 528734635;  var h6_l = 4215389547;
    var h7_h = 1541459225; var h7_l = 327033209;

    let padded_len = ((blen + 17 + 127) / 128) * 128;
    var blk = 0;
    while blk < padded_len {
        var t = 0;
        while t < 16 {
            let base = blk + (t * 8);
            let b0 = sha512_padded_byte(bmap, blen, padded_len, base);
            let b1 = sha512_padded_byte(bmap, blen, padded_len, base + 1);
            let b2 = sha512_padded_byte(bmap, blen, padded_len, base + 2);
            let b3 = sha512_padded_byte(bmap, blen, padded_len, base + 3);
            let b4 = sha512_padded_byte(bmap, blen, padded_len, base + 4);
            let b5 = sha512_padded_byte(bmap, blen, padded_len, base + 5);
            let b6 = sha512_padded_byte(bmap, blen, padded_len, base + 6);
            let b7 = sha512_padded_byte(bmap, blen, padded_len, base + 7);
            let wh = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 4294967295;
            let wl = ((b4 << 24) | (b5 << 16) | (b6 << 8) | b7) & 4294967295;
            __engine("map_set", st, 200 + t, wh);
            __engine("map_set", st, 300 + t, wl);
            t = t + 1;
        }
        while t < 80 {
            let w15_h = __engine("map_get", st, 200 + t - 15) + 0;
            let w15_l = __engine("map_get", st, 300 + t - 15) + 0;
            let w2_h = __engine("map_get", st, 200 + t - 2) + 0;
            let w2_l = __engine("map_get", st, 300 + t - 2) + 0;
            let w16_h = __engine("map_get", st, 200 + t - 16) + 0;
            let w16_l = __engine("map_get", st, 300 + t - 16) + 0;
            let w7_h = __engine("map_get", st, 200 + t - 7) + 0;
            let w7_l = __engine("map_get", st, 300 + t - 7) + 0;

            let s0_h = sha512_lsigma0_hi(w15_h, w15_l);
            let s0_l = sha512_lsigma0_lo(w15_h, w15_l);
            let s1_h = sha512_lsigma1_hi(w2_h, w2_l);
            let s1_l = sha512_lsigma1_lo(w2_h, w2_l);

            let sum_l = w16_l + s0_l + w7_l + s1_l;
            let wt_l = sum_l & 4294967295;
            let wt_h = (w16_h + s0_h + w7_h + s1_h + (sum_l >> 32)) & 4294967295;
            __engine("map_set", st, 200 + t, wt_h);
            __engine("map_set", st, 300 + t, wt_l);
            t = t + 1;
        }

        var a_h = h0_h; var a_l = h0_l;
        var b_h = h1_h; var b_l = h1_l;
        var c_h = h2_h; var c_l = h2_l;
        var d_h = h3_h; var d_l = h3_l;
        var e_h = h4_h; var e_l = h4_l;
        var f_h = h5_h; var f_l = h5_l;
        var g_h = h6_h; var g_l = h6_l;
        var h_h = h7_h; var h_l = h7_l;

        t = 0;
        while t < 80 {
            let wt_h = __engine("map_get", st, 200 + t) + 0;
            let wt_l = __engine("map_get", st, 300 + t) + 0;
            let kt_h = __engine("map_get", st, t) + 0;
            let kt_l = __engine("map_get", st, 100 + t) + 0;

            let t1_l_sum = h_l + sha512_sigma1_lo(e_h, e_l) + sha256_ch(e_l, f_l, g_l) + kt_l + wt_l;
            let t1_l = t1_l_sum & 4294967295;
            let t1_h = (h_h + sha512_sigma1_hi(e_h, e_l) + sha256_ch(e_h, f_h, g_h) + kt_h + wt_h + (t1_l_sum >> 32)) & 4294967295;

            let t2_l_sum = sha512_sigma0_lo(a_h, a_l) + sha256_maj(a_l, b_l, c_l);
            let t2_l = t2_l_sum & 4294967295;
            let t2_h = (sha512_sigma0_hi(a_h, a_l) + sha256_maj(a_h, b_h, c_h) + (t2_l_sum >> 32)) & 4294967295;

            h_h = g_h; h_l = g_l;
            g_h = f_h; g_l = f_l;
            f_h = e_h; f_l = e_l;
            let ne_l = d_l + t1_l;
            e_l = ne_l & 4294967295;
            e_h = (d_h + t1_h + (ne_l >> 32)) & 4294967295;
            d_h = c_h; d_l = c_l;
            c_h = b_h; c_l = b_l;
            b_h = a_h; b_l = a_l;
            let na_l = t1_l + t2_l;
            a_l = na_l & 4294967295;
            a_h = (t1_h + t2_h + (na_l >> 32)) & 4294967295;
            t = t + 1;
        }

        let s0l = h0_l + a_l; h0_l = s0l & 4294967295; h0_h = (h0_h + a_h + (s0l >> 32)) & 4294967295;
        let s1l = h1_l + b_l; h1_l = s1l & 4294967295; h1_h = (h1_h + b_h + (s1l >> 32)) & 4294967295;
        let s2l = h2_l + c_l; h2_l = s2l & 4294967295; h2_h = (h2_h + c_h + (s2l >> 32)) & 4294967295;
        let s3l = h3_l + d_l; h3_l = s3l & 4294967295; h3_h = (h3_h + d_h + (s3l >> 32)) & 4294967295;
        let s4l = h4_l + e_l; h4_l = s4l & 4294967295; h4_h = (h4_h + e_h + (s4l >> 32)) & 4294967295;
        let s5l = h5_l + f_l; h5_l = s5l & 4294967295; h5_h = (h5_h + f_h + (s5l >> 32)) & 4294967295;
        let s6l = h6_l + g_l; h6_l = s6l & 4294967295; h6_h = (h6_h + g_h + (s6l >> 32)) & 4294967295;
        let s7l = h7_l + h_l; h7_l = s7l & 4294967295; h7_h = (h7_h + h_h + (s7l >> 32)) & 4294967295;

        blk = blk + 128;
    }

    sha512_store_u32_be(st, 0, h0_h);  sha512_store_u32_be(st, 4, h0_l);
    sha512_store_u32_be(st, 8, h1_h);  sha512_store_u32_be(st, 12, h1_l);
    sha512_store_u32_be(st, 16, h2_h); sha512_store_u32_be(st, 20, h2_l);
    sha512_store_u32_be(st, 24, h3_h); sha512_store_u32_be(st, 28, h3_l);
    sha512_store_u32_be(st, 32, h4_h); sha512_store_u32_be(st, 36, h4_l);
    sha512_store_u32_be(st, 40, h5_h); sha512_store_u32_be(st, 44, h5_l);
    sha512_store_u32_be(st, 48, h6_h); sha512_store_u32_be(st, 52, h6_l);
    sha512_store_u32_be(st, 56, h7_h); sha512_store_u32_be(st, 60, h7_l);

    let hex_str = hash_hex_u32_be(h0_h) + hash_hex_u32_be(h0_l)
        + hash_hex_u32_be(h1_h) + hash_hex_u32_be(h1_l)
        + hash_hex_u32_be(h2_h) + hash_hex_u32_be(h2_l)
        + hash_hex_u32_be(h3_h) + hash_hex_u32_be(h3_l)
        + hash_hex_u32_be(h4_h) + hash_hex_u32_be(h4_l)
        + hash_hex_u32_be(h5_h) + hash_hex_u32_be(h5_l)
        + hash_hex_u32_be(h6_h) + hash_hex_u32_be(h6_l)
        + hash_hex_u32_be(h7_h) + hash_hex_u32_be(h7_l);
    __engine("map_set", st, "hex", hex_str);
    return st;
}

pub fn sha512_hex(msg: str) -> str {
    let n = msg.len();
    let bmap = __engine("map_new");
    var i = 0;
    while i < n {
        __engine("map_set", bmap, i, msg.byte_at(i));
        i = i + 1;
    }
    let res = sha512_hash_byte_map(bmap, n);
    return __engine("map_get", res, "hex");
}

// ============================================================================
// Official BLAKE3 Compression & Multi-Chunk Merkle Tree Hash
// ============================================================================

pub pure fn blake3_g_mix(a: i64, b: i64, c: i64, d: i64, mx: i64, my: i64) -> i64 {
    let a1 = (a + b + mx) & 4294967295;
    let d1 = rotr32(d ^ a1, 16);
    let c1 = (c + d1) & 4294967295;
    let b1 = rotr32(b ^ c1, 12);
    let a2 = (a1 + b1 + my) & 4294967295;
    let d2 = rotr32(d1 ^ a2, 8);
    let c2 = (c1 + d2) & 4294967295;
    let b2 = rotr32(b1 ^ c2, 7);
    return (a2 ^ b2 ^ c2 ^ d2) & 4294967295;
}

pub pure fn blake3_iv(i: i64) -> i64 {
    if i == 0 { return 1779033703; }
    if i == 1 { return 3144134277; }
    if i == 2 { return 1013904242; }
    if i == 3 { return 2773480762; }
    if i == 4 { return 1359893119; }
    if i == 5 { return 2600822924; }
    if i == 6 { return 528734635; }
    return 1541459225;
}

pub pure fn blake3_msg_perm(i: i64) -> i64 {
    if i == 0 { return 2; }
    if i == 1 { return 6; }
    if i == 2 { return 3; }
    if i == 3 { return 10; }
    if i == 4 { return 7; }
    if i == 5 { return 0; }
    if i == 6 { return 4; }
    if i == 7 { return 13; }
    if i == 8 { return 1; }
    if i == 9 { return 11; }
    if i == 10 { return 12; }
    if i == 11 { return 5; }
    if i == 12 { return 9; }
    if i == 13 { return 14; }
    if i == 14 { return 15; }
    return 8;
}

pub fn blake3_qround(st: i64, ai: i64, bi: i64, ci: i64, di: i64, mx: i64, my: i64) -> i64 {
    let a0 = __engine("map_get", st, ai) + 0;
    let b0 = __engine("map_get", st, bi) + 0;
    let c0 = __engine("map_get", st, ci) + 0;
    let d0 = __engine("map_get", st, di) + 0;

    let a1 = (a0 + b0 + mx) & 4294967295;
    let d1 = rotr32(d0 ^ a1, 16);
    let c1 = (c0 + d1) & 4294967295;
    let b1 = rotr32(b0 ^ c1, 12);
    let a2 = (a1 + b1 + my) & 4294967295;
    let d2 = rotr32(d1 ^ a2, 8);
    let c2 = (c1 + d2) & 4294967295;
    let b2 = rotr32(b1 ^ c2, 7);

    __engine("map_set", st, ai, a2);
    __engine("map_set", st, bi, b2);
    __engine("map_set", st, ci, c2);
    __engine("map_set", st, di, d2);
    return st;
}

// `st`: indices 0..15 = state words, 16..31 = message words, 32..47 = temp permute, 48..55 = cv
pub fn blake3_compress_in_place(st: i64, counter: i64, block_len: i64, flags: i64) -> i64 {
    var i = 0;
    while i < 8 {
        __engine("map_set", st, i, __engine("map_get", st, 48 + i) + 0);
        i = i + 1;
    }
    __engine("map_set", st, 8, blake3_iv(0));
    __engine("map_set", st, 9, blake3_iv(1));
    __engine("map_set", st, 10, blake3_iv(2));
    __engine("map_set", st, 11, blake3_iv(3));
    __engine("map_set", st, 12, counter & 4294967295);
    __engine("map_set", st, 13, (counter >> 32) & 4294967295);
    __engine("map_set", st, 14, block_len & 4294967295);
    __engine("map_set", st, 15, flags & 4294967295);

    var r = 0;
    while r < 7 {
        blake3_qround(st, 0, 4, 8, 12, __engine("map_get", st, 16) + 0, __engine("map_get", st, 17) + 0);
        blake3_qround(st, 1, 5, 9, 13, __engine("map_get", st, 18) + 0, __engine("map_get", st, 19) + 0);
        blake3_qround(st, 2, 6, 10, 14, __engine("map_get", st, 20) + 0, __engine("map_get", st, 21) + 0);
        blake3_qround(st, 3, 7, 11, 15, __engine("map_get", st, 22) + 0, __engine("map_get", st, 23) + 0);
        blake3_qround(st, 0, 5, 10, 15, __engine("map_get", st, 24) + 0, __engine("map_get", st, 25) + 0);
        blake3_qround(st, 1, 6, 11, 12, __engine("map_get", st, 26) + 0, __engine("map_get", st, 27) + 0);
        blake3_qround(st, 2, 7, 8, 13, __engine("map_get", st, 28) + 0, __engine("map_get", st, 29) + 0);
        blake3_qround(st, 3, 4, 9, 14, __engine("map_get", st, 30) + 0, __engine("map_get", st, 31) + 0);
        if r < 6 {
            var pi = 0;
            while pi < 16 {
                let src_idx = blake3_msg_perm(pi);
                __engine("map_set", st, 32 + pi, __engine("map_get", st, 16 + src_idx) + 0);
                pi = pi + 1;
            }
            pi = 0;
            while pi < 16 {
                __engine("map_set", st, 16 + pi, __engine("map_get", st, 32 + pi) + 0);
                pi = pi + 1;
            }
        }
        r = r + 1;
    }

    i = 0;
    while i < 8 {
        let s_lo = __engine("map_get", st, i) + 0;
        let s_hi = __engine("map_get", st, i + 8) + 0;
        let cv_i = __engine("map_get", st, 48 + i) + 0;
        __engine("map_set", st, i, (s_lo ^ s_hi) & 4294967295);
        __engine("map_set", st, i + 8, (s_hi ^ cv_i) & 4294967295);
        i = i + 1;
    }
    return st;
}

pub pure fn blake3_msg_byte(msg: str, mlen: i64, idx: i64) -> i64 {
    if idx < mlen {
        return msg.byte_at(idx) & 255;
    }
    return 0;
}

pub fn blake3_load_msg_block(st: i64, msg: str, mlen: i64, blk_offset: i64, blk_len: i64) -> i64 {
    let end_off = blk_offset + blk_len;
    var wi = 0;
    while wi < 16 {
        let p = blk_offset + (wi * 4);
        let b0 = if p < end_off { blake3_msg_byte(msg, mlen, p) } else { 0 };
        let b1 = if p + 1 < end_off { blake3_msg_byte(msg, mlen, p + 1) } else { 0 };
        let b2 = if p + 2 < end_off { blake3_msg_byte(msg, mlen, p + 2) } else { 0 };
        let b3 = if p + 3 < end_off { blake3_msg_byte(msg, mlen, p + 3) } else { 0 };
        let w = (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & 4294967295;
        __engine("map_set", st, 16 + wi, w);
        wi = wi + 1;
    }
    return st;
}

pub fn blake3_hex(msg: str) -> str {
    let mlen = msg.len();
    let st = __engine("map_new");

    if mlen <= 1024 {
        var i = 0;
        while i < 8 {
            __engine("map_set", st, 48 + i, blake3_iv(i));
            i = i + 1;
        }
        let num_blocks = if mlen == 0 { 1 } else { (mlen + 63) / 64 };
        var b_idx = 0;
        while b_idx < num_blocks {
            let b_start = b_idx * 64;
            let rem = mlen - b_start;
            let b_len = if mlen == 0 { 0 } else if rem > 64 { 64 } else { rem };
            blake3_load_msg_block(st, msg, mlen, b_start, b_len);
            var flags = 0;
            if b_idx == 0 { flags = flags | 1; }
            if b_idx + 1 == num_blocks { flags = flags | 2 | 8; }
            blake3_compress_in_place(st, 0, b_len, flags);
            if b_idx + 1 < num_blocks {
                var ci = 0;
                while ci < 8 {
                    __engine("map_set", st, 48 + ci, __engine("map_get", st, ci) + 0);
                    ci = ci + 1;
                }
            }
            b_idx = b_idx + 1;
        }
        var hex_s = "";
        var hi = 0;
        while hi < 8 {
            hex_s = hex_s + hash_hex_u32_le(__engine("map_get", st, hi) + 0);
            hi = hi + 1;
        }
        return hex_s;
    }

    // Multi-chunk Merkle stack: stack depth `d` stored at `100 + d * 8 + i`
    let total_chunks = (mlen + 1023) / 1024;
    var stack_len = 0;
    var chunk_idx = 0;
    while chunk_idx < total_chunks {
        let c_start = chunk_idx * 1024;
        let c_rem = mlen - c_start;
        let c_len = if c_rem > 1024 { 1024 } else { c_rem };
        var i = 0;
        while i < 8 {
            __engine("map_set", st, 48 + i, blake3_iv(i));
            i = i + 1;
        }
        let num_blocks = (c_len + 63) / 64;
        var b_idx = 0;
        while b_idx < num_blocks {
            let b_start = c_start + (b_idx * 64);
            let b_rem = (c_start + c_len) - b_start;
            let b_len = if b_rem > 64 { 64 } else { b_rem };
            blake3_load_msg_block(st, msg, mlen, b_start, b_len);
            var flags = 0;
            if b_idx == 0 { flags = flags | 1; }
            if b_idx + 1 == num_blocks { flags = flags | 2; }
            blake3_compress_in_place(st, chunk_idx, b_len, flags);
            var ci = 0;
            while ci < 8 {
                __engine("map_set", st, 48 + ci, __engine("map_get", st, ci) + 0);
                ci = ci + 1;
            }
            b_idx = b_idx + 1;
        }

        var cur_h = 0;
        if (chunk_idx + 1) < total_chunks {
            var fold = 1;
            while fold == 1 {
                if stack_len > 0 {
                    let top_h = __engine("map_get", st, 300 + stack_len - 1) + 0;
                    if top_h == cur_h {
                        stack_len = stack_len - 1;
                        let l_base = 100 + (stack_len * 8);
                        var wi = 0;
                        while wi < 8 {
                            __engine("map_set", st, 16 + wi, __engine("map_get", st, l_base + wi) + 0);
                            __engine("map_set", st, 24 + wi, __engine("map_get", st, 48 + wi) + 0);
                            __engine("map_set", st, 48 + wi, blake3_iv(wi));
                            wi = wi + 1;
                        }
                        blake3_compress_in_place(st, 0, 64, 4);
                        wi = 0;
                        while wi < 8 {
                            __engine("map_set", st, 48 + wi, __engine("map_get", st, wi) + 0);
                            wi = wi + 1;
                        }
                        cur_h = top_h + 1;
                    } else {
                        fold = 0;
                    }
                } else {
                    fold = 0;
                }
            }
            var si = 0;
            while si < 8 {
                __engine("map_set", st, 100 + (stack_len * 8) + si, __engine("map_get", st, 48 + si) + 0);
                si = si + 1;
            }
            __engine("map_set", st, 300 + stack_len, cur_h);
            stack_len = stack_len + 1;
        } else {
            while stack_len > 1 {
                stack_len = stack_len - 1;
                let l_base = 100 + (stack_len * 8);
                var wi = 0;
                while wi < 8 {
                    __engine("map_set", st, 16 + wi, __engine("map_get", st, l_base + wi) + 0);
                    __engine("map_set", st, 24 + wi, __engine("map_get", st, 48 + wi) + 0);
                    __engine("map_set", st, 48 + wi, blake3_iv(wi));
                    wi = wi + 1;
                }
                blake3_compress_in_place(st, 0, 64, 4);
                wi = 0;
                while wi < 8 {
                    __engine("map_set", st, 48 + wi, __engine("map_get", st, wi) + 0);
                    wi = wi + 1;
                }
            }
            stack_len = stack_len - 1;
            let root_l = 100 + (stack_len * 8);
            var rwi = 0;
            while rwi < 8 {
                __engine("map_set", st, 16 + rwi, __engine("map_get", st, root_l + rwi) + 0);
                __engine("map_set", st, 24 + rwi, __engine("map_get", st, 48 + rwi) + 0);
                __engine("map_set", st, 48 + rwi, blake3_iv(rwi));
                rwi = rwi + 1;
            }
            blake3_compress_in_place(st, 0, 64, 12);
            var hex_s = "";
            var hi = 0;
            while hi < 8 {
                hex_s = hex_s + hash_hex_u32_le(__engine("map_get", st, hi) + 0);
                hi = hi + 1;
            }
            return hex_s;
        }
        chunk_idx = chunk_idx + 1;
    }
    return "";
}

pub fn blake3_digest(msg: str) -> Digest256 {
    let hex_s = blake3_hex(msg);
    return Digest256 {
        h0: hex_s.byte_at(0),
        h1: hex_s.byte_at(1),
        h2: hex_s.byte_at(2),
        h3: hex_s.byte_at(3),
        hex_prefix: hex_s,
    };
}
