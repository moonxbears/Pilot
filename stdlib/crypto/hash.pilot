// ============================================================================
// FILE: stdlib/crypto/hash.pilot
// Milestone 58.2: Spec-Compliant Cryptographic Hashes & HMAC in Pilot
// Implements RFC 6234 SHA-256 & SHA-512, official BLAKE3 multi-chunk Merkle
// tree hashing, and RFC 2104 HMAC-SHA256 in pure Pilot.
// ============================================================================

[Layout(c_abi)]
pub struct Digest256 : IValue {
    pub h0: i64;
    pub h1: i64;
    pub h2: i64;
    pub h3: i64;
    pub hex_prefix: str;
}

pub pure fn rotr32(x: i64, n: i64) -> i64 {
    let u = x & 4294967295;
    if n <= 0 { return u; }
    return ((u >> n) | ((u << (32 - n)) & 4294967295)) & 4294967295;
}

pub pure fn sha256_ch(x: i64, y: i64, z: i64) -> i64 {
    let not_x = (x & 4294967295) ^ 4294967295;
    return ((x & y) ^ (not_x & z)) & 4294967295;
}

pub pure fn sha256_maj(x: i64, y: i64, z: i64) -> i64 {
    return ((x & y) ^ (x & z) ^ (y & z)) & 4294967295;
}

pub pure fn sha256_sigma0(x: i64) -> i64 {
    return rotr32(x, 2) ^ rotr32(x, 13) ^ rotr32(x, 22);
}

pub pure fn sha256_sigma1(x: i64) -> i64 {
    return rotr32(x, 6) ^ rotr32(x, 11) ^ rotr32(x, 25);
}

pub pure fn sha256_lsigma0(x: i64) -> i64 {
    let u = x & 4294967295;
    return rotr32(u, 7) ^ rotr32(u, 18) ^ (u >> 3);
}

pub pure fn sha256_lsigma1(x: i64) -> i64 {
    let u = x & 4294967295;
    return rotr32(u, 17) ^ rotr32(u, 19) ^ (u >> 10);
}

pub pure fn hash_hex_nibble(v: i64) -> str {
    let idx = v & 15;
    return "0123456789abcdef".slice(idx, idx + 1);
}

pub pure fn hash_hex_byte(b: i64) -> str {
    let u = b & 255;
    return hash_hex_nibble(u >> 4) + hash_hex_nibble(u);
}

pub pure fn hash_hex_u32_be(w: i64) -> str {
    let u = w & 4294967295;
    return hash_hex_byte(u >> 24) + hash_hex_byte(u >> 16) + hash_hex_byte(u >> 8) + hash_hex_byte(u);
}

pub pure fn hash_hex_u32_le(w: i64) -> str {
    let u = w & 4294967295;
    return hash_hex_byte(u) + hash_hex_byte(u >> 8) + hash_hex_byte(u >> 16) + hash_hex_byte(u >> 24);
}

pub pure fn sha256_k_const(i: i64) -> i64 {
    if i < 16 {
        if i == 0 { return 1116352408; }
        if i == 1 { return 1899447441; }
        if i == 2 { return 3049323471; }
        if i == 3 { return 3921009573; }
        if i == 4 { return 961987163; }
        if i == 5 { return 1508970993; }
        if i == 6 { return 2453635748; }
        if i == 7 { return 2870763221; }
        if i == 8 { return 3624381080; }
        if i == 9 { return 310598401; }
        if i == 10 { return 607225278; }
        if i == 11 { return 1426881987; }
        if i == 12 { return 1925078388; }
        if i == 13 { return 2162078206; }
        if i == 14 { return 2614888103; }
        return 3248222580;
    }
    if i < 32 {
        if i == 16 { return 3835390401; }
        if i == 17 { return 4022224774; }
        if i == 18 { return 264347078; }
        if i == 19 { return 604807628; }
        if i == 20 { return 770255983; }
        if i == 21 { return 1249150122; }
        if i == 22 { return 1555081692; }
        if i == 23 { return 1996064986; }
        if i == 24 { return 2554220882; }
        if i == 25 { return 2821834349; }
        if i == 26 { return 2952996808; }
        if i == 27 { return 3210313671; }
        if i == 28 { return 3336571891; }
        if i == 29 { return 3584528711; }
        if i == 30 { return 113926993; }
        return 338241895;
    }
    if i < 48 {
        if i == 32 { return 666307205; }
        if i == 33 { return 773529912; }
        if i == 34 { return 1294757372; }
        if i == 35 { return 1396182291; }
        if i == 36 { return 1695183700; }
        if i == 37 { return 1986661051; }
        if i == 38 { return 2177026350; }
        if i == 39 { return 2456956037; }
        if i == 40 { return 2730485921; }
        if i == 41 { return 2820302411; }
        if i == 42 { return 3259730800; }
        if i == 43 { return 3345764771; }
        if i == 44 { return 3516065817; }
        if i == 45 { return 3600352804; }
        if i == 46 { return 4094571909; }
        return 275423344;
    }
    if i == 48 { return 430227734; }
    if i == 49 { return 506948616; }
    if i == 50 { return 659060556; }
    if i == 51 { return 883997877; }
    if i == 52 { return 958139571; }
    if i == 53 { return 1322822218; }
    if i == 54 { return 1537002063; }
    if i == 55 { return 1747873779; }
    if i == 56 { return 1955562222; }
    if i == 57 { return 2024104815; }
    if i == 58 { return 2227730452; }
    if i == 59 { return 2361852424; }
    if i == 60 { return 2428436474; }
    if i == 61 { return 2756734187; }
    if i == 62 { return 3204031479; }
    return 3329325298;
}

pub pure fn sha256_padded_byte(bmap: i64, blen: i64, padded_len: i64, idx: i64) -> i64 {
    if idx < blen {
        return (__engine("map_get", bmap, idx) + 0) & 255;
    }
    if idx == blen {
        return 128;
    }
    if idx >= padded_len - 8 {
        let bit_len = blen * 8;
        let shift = (padded_len - 1 - idx) * 8;
        if shift >= 64 { return 0; }
        return (bit_len >> shift) & 255;
    }
    return 0;
}

pub fn sha256_hash_byte_map(bmap: i64, blen: i64) -> i64 {
    var h0 = 1779033703;
    var h1 = 3144134277;
    var h2 = 1013904242;
    var h3 = 2773480762;
    var h4 = 1359893119;
    var h5 = 2600822924;
    var h6 = 528734635;
    var h7 = 1541459225;

    let padded_len = ((blen + 9 + 63) / 64) * 64;
    let wmap = __engine("map_new");
    var blk = 0;
    while blk < padded_len {
        var t = 0;
        while t < 16 {
            let base = blk + (t * 4);
            let b0 = sha256_padded_byte(bmap, blen, padded_len, base);
            let b1 = sha256_padded_byte(bmap, blen, padded_len, base + 1);
            let b2 = sha256_padded_byte(bmap, blen, padded_len, base + 2);
            let b3 = sha256_padded_byte(bmap, blen, padded_len, base + 3);
            let word = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & 4294967295;
            __engine("map_set", wmap, t, word);
            t = t + 1;
        }
        while t < 64 {
            let w15 = __engine("map_get", wmap, t - 15) + 0;
            let w2 = __engine("map_get", wmap, t - 2) + 0;
            let w16 = __engine("map_get", wmap, t - 16) + 0;
            let w7 = __engine("map_get", wmap, t - 7) + 0;
            let wt = (w16 + sha256_lsigma0(w15) + w7 + sha256_lsigma1(w2)) & 4294967295;
            __engine("map_set", wmap, t, wt);
            t = t + 1;
        }

        var a = h0;
        var b = h1;
        var c_v = h2;
        var d = h3;
        var e = h4;
        var f = h5;
        var g = h6;
        var h = h7;

        t = 0;
        while t < 64 {
            let wt = __engine("map_get", wmap, t) + 0;
            let kt = sha256_k_const(t);
            let t1 = (h + sha256_sigma1(e) + sha256_ch(e, f, g) + kt + wt) & 4294967295;
            let t2 = (sha256_sigma0(a) + sha256_maj(a, b, c_v)) & 4294967295;
            h = g;
            g = f;
            f = e;
            e = (d + t1) & 4294967295;
            d = c_v;
            c_v = b;
            b = a;
            a = (t1 + t2) & 4294967295;
            t = t + 1;
        }

        h0 = (h0 + a) & 4294967295;
        h1 = (h1 + b) & 4294967295;
        h2 = (h2 + c_v) & 4294967295;
        h3 = (h3 + d) & 4294967295;
        h4 = (h4 + e) & 4294967295;
        h5 = (h5 + f) & 4294967295;
        h6 = (h6 + g) & 4294967295;
        h7 = (h7 + h) & 4294967295;
        blk = blk + 64;
    }

    let out = __engine("map_new");
    __engine("map_set", out, "h0", h0);
    __engine("map_set", out, "h1", h1);
    __engine("map_set", out, "h2", h2);
    __engine("map_set", out, "h3", h3);
    __engine("map_set", out, "h4", h4);
    __engine("map_set", out, "h5", h5);
    __engine("map_set", out, "h6", h6);
    __engine("map_set", out, "h7", h7);

    var wi = 0;
    while wi < 8 {
        let hv = __engine("map_get", out, "h" + wi) + 0;
        let base_b = wi * 4;
        __engine("map_set", out, base_b, (hv >> 24) & 255);
        __engine("map_set", out, base_b + 1, (hv >> 16) & 255);
        __engine("map_set", out, base_b + 2, (hv >> 8) & 255);
        __engine("map_set", out, base_b + 3, hv & 255);
        wi = wi + 1;
    }

    let hex_str = hash_hex_u32_be(h0) + hash_hex_u32_be(h1) + hash_hex_u32_be(h2) + hash_hex_u32_be(h3)
        + hash_hex_u32_be(h4) + hash_hex_u32_be(h5) + hash_hex_u32_be(h6) + hash_hex_u32_be(h7);
    __engine("map_set", out, "hex", hex_str);
    return out;
}

pub fn sha256_hex(msg: str) -> str {
    let n = msg.len();
    let bmap = __engine("map_new");
    var i = 0;
    while i < n {
        __engine("map_set", bmap, i, msg.byte_at(i));
        i = i + 1;
    }
    let res = sha256_hash_byte_map(bmap, n);
    return __engine("map_get", res, "hex");
}

pub fn sha256_digest(msg: str) -> Digest256 {
    let n = msg.len();
    let bmap = __engine("map_new");
    var i = 0;
    while i < n {
        __engine("map_set", bmap, i, msg.byte_at(i));
        i = i + 1;
    }
    let res = sha256_hash_byte_map(bmap, n);
    return Digest256 {
        h0: __engine("map_get", res, "h0") + 0,
        h1: __engine("map_get", res, "h1") + 0,
        h2: __engine("map_get", res, "h2") + 0,
        h3: __engine("map_get", res, "h3") + 0,
        hex_prefix: __engine("map_get", res, "hex"),
    };
}

// ============================================================================
// RFC 2104 HMAC-SHA256
// ============================================================================

pub fn hmac_sha256_hex(key: str, msg: str) -> str {
    let klen = key.len();
    let kblock = __engine("map_new");
    if klen > 64 {
        let raw_k = __engine("map_new");
        var ki = 0;
        while ki < klen {
            __engine("map_set", raw_k, ki, key.byte_at(ki));
            ki = ki + 1;
        }
        let kh = sha256_hash_byte_map(raw_k, klen);
        var j = 0;
        while j < 32 {
            __engine("map_set", kblock, j, __engine("map_get", kh, j) + 0);
            j = j + 1;
        }
        while j < 64 {
            __engine("map_set", kblock, j, 0);
            j = j + 1;
        }
    } else {
        var j = 0;
        while j < klen {
            __engine("map_set", kblock, j, key.byte_at(j));
            j = j + 1;
        }
        while j < 64 {
            __engine("map_set", kblock, j, 0);
            j = j + 1;
        }
    }

    let mlen = msg.len();
    let inner_in = __engine("map_new");
    var i = 0;
    while i < 64 {
        let kb = __engine("map_get", kblock, i) + 0;
        __engine("map_set", inner_in, i, (kb ^ 54) & 255);
        i = i + 1;
    }
    var mi = 0;
    while mi < mlen {
        __engine("map_set", inner_in, 64 + mi, msg.byte_at(mi));
        mi = mi + 1;
    }
    let inner_hash = sha256_hash_byte_map(inner_in, 64 + mlen);

    let outer_in = __engine("map_new");
    i = 0;
    while i < 64 {
        let kb = __engine("map_get", kblock, i) + 0;
        __engine("map_set", outer_in, i, (kb ^ 92) & 255);
        i = i + 1;
    }
    var di = 0;
    while di < 32 {
        __engine("map_set", outer_in, 64 + di, __engine("map_get", inner_hash, di) + 0);
        di = di + 1;
    }
    let outer_hash = sha256_hash_byte_map(outer_in, 96);
    return __engine("map_get", outer_hash, "hex");
}

pub fn hmac_sha256_tag(key: str, msg: str) -> i64 {
    let hex_s = hmac_sha256_hex(key, msg);
    return hex_s.byte_at(0);
}

// ============================================================================
// RFC 6234 SHA-512 (64-bit word operations via exact (hi32, lo32) pairs)
// ============================================================================

pub pure fn rotr64_hi(h: i64, l: i64, n: i64) -> i64 {
    let uh = h & 4294967295;
    let ul = l & 4294967295;
    if n == 0 { return uh; }
    if n < 32 {
        return ((uh >> n) | ((ul << (32 - n)) & 4294967295)) & 4294967295;
    }
    if n == 32 { return ul; }
    let k = n - 32;
    return ((ul >> k) | ((uh << (32 - k)) & 4294967295)) & 4294967295;
}

pub pure fn rotr64_lo(h: i64, l: i64, n: i64) -> i64 {
    let uh = h & 4294967295;
    let ul = l & 4294967295;
    if n == 0 { return ul; }
    if n < 32 {
        return ((ul >> n) | ((uh << (32 - n)) & 4294967295)) & 4294967295;
    }
    if n == 32 { return uh; }
    let k = n - 32;
    return ((uh >> k) | ((ul << (32 - k)) & 4294967295)) & 4294967295;
}

pub pure fn shr64_hi(h: i64, n: i64) -> i64 {
    return (h & 4294967295) >> n;
}

pub pure fn shr64_lo(h: i64, l: i64, n: i64) -> i64 {
    let uh = h & 4294967295;
    let ul = l & 4294967295;
    return ((ul >> n) | ((uh << (32 - n)) & 4294967295)) & 4294967295;
}

pub pure fn sha512_sigma0_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 28) ^ rotr64_hi(h, l, 34) ^ rotr64_hi(h, l, 39);
}

pub pure fn sha512_sigma0_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 28) ^ rotr64_lo(h, l, 34) ^ rotr64_lo(h, l, 39);
}

pub pure fn sha512_sigma1_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 14) ^ rotr64_hi(h, l, 18) ^ rotr64_hi(h, l, 41);
}

pub pure fn sha512_sigma1_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 14) ^ rotr64_lo(h, l, 18) ^ rotr64_lo(h, l, 41);
}

pub pure fn sha512_lsigma0_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 1) ^ rotr64_hi(h, l, 8) ^ shr64_hi(h, 7);
}

pub pure fn sha512_lsigma0_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 1) ^ rotr64_lo(h, l, 8) ^ shr64_lo(h, l, 7);
}

pub pure fn sha512_lsigma1_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 19) ^ rotr64_hi(h, l, 61) ^ shr64_hi(h, 6);
}

pub pure fn sha512_lsigma1_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 19) ^ rotr64_lo(h, l, 61) ^ shr64_lo(h, l, 6);
}

