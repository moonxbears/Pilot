    2, 6, 3, 10, 7, 0, 4, 13, 1, 11, 12, 5, 9, 14, 15, 8,
];
// ============================================================================
// Shared byte and word buffers
// ============================================================================

// A list of `n` zero words.
pub fn hash_zero_words(n: i64) -> List<i64> {
    var out: List<i64> = [];
    var i = 0;
    while i < n {
        out.push(0);
        i = i + 1;
    }
    return out;
}

// The bytes of `msg`, one item per byte.
pub fn hash_str_bytes(msg: str) -> List<i64> {
    let n = msg.len();
    var out: List<i64> = [];
    var i = 0;
    while i < n {
        let b: i64 = msg.byte_at(i);
        out.push(b);
        i = i + 1;
    }
    return out;
}

// Appends the four big-endian bytes of the 32-bit word `w`.
pub fn hash_push_u32_be(var ref out: List<i64>, w: i64) {
    let u = w & MAX_32_BIT;
    out.push((u >> 24) & 255);
    out.push((u >> 16) & 255);
    out.push((u >> 8) & 255);
    out.push(u & 255);
}

// The big-endian bytes of a list of 32-bit words (a SHA digest's bytes).
pub fn hash_words_be_bytes(ref words: List<i64>) -> List<i64> {
    var out: List<i64> = [];
    var i = 0;
    while i < words.len() {
        hash_push_u32_be(out, words[i]);
        i = i + 1;
    }
    return out;
}

// The lowercase hex of a list of 32-bit words, each written big-endian.
pub fn hash_words_hex_be(words: List<i64>) -> str {
    var hex_s = "";
    var i = 0;
    while i < words.len() {
        hex_s = hex_s + hash_hex_u32_be(words[i]);
        i = i + 1;
    }
    return hex_s;
}

// ============================================================================
// RFC 6234 SHA-256
// ============================================================================

pub pure fn sha256_padded_byte(ref bytes: List<i64>, blen: i64, padded_len: i64, idx: i64) -> i64 {
    if idx < blen {
        return bytes[idx] & 255;
    }
    if idx == blen {
        return 128;
    }
    if idx >= padded_len - 8 {
        let bit_len = blen * 8;
        let shift = (padded_len - 1 - idx) * 8;
        if shift >= 64 { return 0; }
        return (bit_len >> shift) & 255;
    }
    return 0;
}

// The eight state words H0..H7 of SHA-256 over the first `blen` items of `bytes`.
pub fn sha256_words(ref bytes: List<i64>, blen: i64) -> List<i64> {
    var h0 = 1779033703;
    var h1 = 3144134277;
    var h2 = 1013904242;
    var h3 = 2773480762;
    var h4 = 1359893119;
    var h5 = 2600822924;
    var h6 = 528734635;
    var h7 = 1541459225;

    let padded_len = ((blen + 9 + 63) / 64) * 64;
    var w = hash_zero_words(64);
    let k = SHA256_K;
    var blk = 0;
    while blk < padded_len {
        var t = 0;
        while t < 16 {
            let base = blk + (t * 4);
            let b0 = sha256_padded_byte(bytes, blen, padded_len, base);
            let b1 = sha256_padded_byte(bytes, blen, padded_len, base + 1);
            let b2 = sha256_padded_byte(bytes, blen, padded_len, base + 2);
            let b3 = sha256_padded_byte(bytes, blen, padded_len, base + 3);
            w[t] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & MAX_32_BIT;
            t = t + 1;
        }
        while t < 64 {
            let w15 = w[t - 15];
            let w2 = w[t - 2];
            let w16 = w[t - 16];
            let w7 = w[t - 7];
            w[t] = (w16 + sha256_lsigma0(w15) + w7 + sha256_lsigma1(w2)) & MAX_32_BIT;
            t = t + 1;
        }

        var a = h0;
        var b = h1;
        var c_v = h2;
        var d = h3;
        var e = h4;
        var f = h5;
        var g = h6;
        var h = h7;

        t = 0;
        while t < 64 {
            let wt = w[t];
            let kt = k[t];
            let t1 = (h + sha256_sigma1(e) + sha256_ch(e, f, g) + kt + wt) & MAX_32_BIT;
            let t2 = (sha256_sigma0(a) + sha256_maj(a, b, c_v)) & MAX_32_BIT;
            h = g;
            g = f;
            f = e;
            e = (d + t1) & MAX_32_BIT;
            d = c_v;
            c_v = b;
            b = a;
            a = (t1 + t2) & MAX_32_BIT;
            t = t + 1;
        }

        h0 = (h0 + a) & MAX_32_BIT;
        h1 = (h1 + b) & MAX_32_BIT;
        h2 = (h2 + c_v) & MAX_32_BIT;
        h3 = (h3 + d) & MAX_32_BIT;
        h4 = (h4 + e) & MAX_32_BIT;
        h5 = (h5 + f) & MAX_32_BIT;
        h6 = (h6 + g) & MAX_32_BIT;
        h7 = (h7 + h) & MAX_32_BIT;
        blk = blk + 64;
    }
    return [h0, h1, h2, h3, h4, h5, h6, h7];
}

pub fn sha256_hex(msg: str) -> str {
    let bytes = hash_str_bytes(msg);
    let h = sha256_words(bytes, msg.len());
    return hash_words_hex_be(h);
}

pub fn sha256_digest(msg: str) -> Digest256 {
    let bytes = hash_str_bytes(msg);
    let h = sha256_words(bytes, msg.len());
    return Digest256 {
        h0: h[0],
        h1: h[1],
        h2: h[2],
        h3: h[3],
        hex_prefix: hash_words_hex_be(h),
    };
}

// ============================================================================
// RFC 2104 HMAC-SHA256
// ============================================================================

pub fn hmac_sha256_hex(key: str, msg: str) -> str {
    let klen = key.len();
    var kblock = hash_str_bytes(key);
    if klen > 64 {
        let kh = sha256_words(kblock, klen);
        kblock = hash_words_be_bytes(kh);
    }
    while kblock.len() < 64 {
        kblock.push(0);
    }

    let mlen = msg.len();
    var inner_in: List<i64> = [];
    var i = 0;
    while i < 64 {
        inner_in.push((kblock[i] ^ 54) & 255);
        i = i + 1;
    }
    var mi = 0;
    while mi < mlen {
        let mb: i64 = msg.byte_at(mi);
        inner_in.push(mb);
        mi = mi + 1;
    }
    let inner_hash = sha256_words(inner_in, 64 + mlen);

    var outer_in: List<i64> = [];
    i = 0;
    while i < 64 {
        outer_in.push((kblock[i] ^ 92) & 255);
        i = i + 1;
    }
    var di = 0;
    while di < 8 {
        hash_push_u32_be(outer_in, inner_hash[di]);
        di = di + 1;
    }
    let outer_hash = sha256_words(outer_in, 96);
    return hash_words_hex_be(outer_hash);
}

pub fn hmac_sha256_tag(key: str, msg: str) -> i64 {
    let hex_s = hmac_sha256_hex(key, msg);
    return hex_s.byte_at(0);
}

// ============================================================================
// RFC 6234 SHA-512 (64-bit word operations via exact (hi32, lo32) pairs)
// ============================================================================

pub pure fn rotr64_hi(h: i64, l: i64, n: i64) -> i64 {
    let uh = h & MAX_32_BIT;
    let ul = l & MAX_32_BIT;
    if n == 0 { return uh; }
    if n < 32 {
        return ((uh >> n) | ((ul << (32 - n)) & MAX_32_BIT)) & MAX_32_BIT;
    }
    if n == 32 { return ul; }
    let k = n - 32;
    return ((ul >> k) | ((uh << (32 - k)) & MAX_32_BIT)) & MAX_32_BIT;
}

pub pure fn rotr64_lo(h: i64, l: i64, n: i64) -> i64 {
    let uh = h & MAX_32_BIT;
    let ul = l & MAX_32_BIT;
    if n == 0 { return ul; }
    if n < 32 {
        return ((ul >> n) | ((uh << (32 - n)) & MAX_32_BIT)) & MAX_32_BIT;
    }
    if n == 32 { return uh; }
    let k = n - 32;
    return ((uh >> k) | ((ul << (32 - k)) & MAX_32_BIT)) & MAX_32_BIT;
}

pub pure fn shr64_hi(h: i64, n: i64) -> i64 {
    return (h & MAX_32_BIT) >> n;
}

pub pure fn shr64_lo(h: i64, l: i64, n: i64) -> i64 {
    let uh = h & MAX_32_BIT;
    let ul = l & MAX_32_BIT;
    return ((ul >> n) | ((uh << (32 - n)) & MAX_32_BIT)) & MAX_32_BIT;
}

pub pure fn sha512_sigma0_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 28) ^ rotr64_hi(h, l, 34) ^ rotr64_hi(h, l, 39);
}

pub pure fn sha512_sigma0_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 28) ^ rotr64_lo(h, l, 34) ^ rotr64_lo(h, l, 39);
}

pub pure fn sha512_sigma1_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 14) ^ rotr64_hi(h, l, 18) ^ rotr64_hi(h, l, 41);
}

pub pure fn sha512_sigma1_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 14) ^ rotr64_lo(h, l, 18) ^ rotr64_lo(h, l, 41);
}

pub pure fn sha512_lsigma0_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 1) ^ rotr64_hi(h, l, 8) ^ shr64_hi(h, 7);
}

pub pure fn sha512_lsigma0_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 1) ^ rotr64_lo(h, l, 8) ^ shr64_lo(h, l, 7);
}

pub pure fn sha512_lsigma1_hi(h: i64, l: i64) -> i64 {
    return rotr64_hi(h, l, 19) ^ rotr64_hi(h, l, 61) ^ shr64_hi(h, 6);
}

pub pure fn sha512_lsigma1_lo(h: i64, l: i64) -> i64 {
    return rotr64_lo(h, l, 19) ^ rotr64_lo(h, l, 61) ^ shr64_lo(h, l, 6);
}
pub pure fn sha512_padded_byte(ref bytes: List<i64>, blen: i64, padded_len: i64, idx: i64) -> i64 {
    if idx < blen {
        return bytes[idx] & 255;
    }
    if idx == blen {
        return 128;
    }
    if idx >= padded_len - 8 {
        let bit_len = blen * 8;
        let shift = (padded_len - 1 - idx) * 8;
        if shift >= 64 { return 0; }
        return (bit_len >> shift) & 255;
    }
    return 0;
}

// The sixteen 32-bit halves (H0 hi, H0 lo, .., H7 hi, H7 lo) of SHA-512 over
// the first `blen` items of `bytes`; `hash_words_be_bytes` gives the 64 digest bytes.
pub fn sha512_words(ref bytes: List<i64>, blen: i64) -> List<i64> {
    var h0_h = 1779033703; var h0_l = 4089235720;
    var h1_h = 3144134277; var h1_l = 2227873595;
    var h2_h = 1013904242; var h2_l = 4271175723;
    var h3_h = 2773480762; var h3_l = 1595750129;
    var h4_h = 1359893119; var h4_l = 2917565137;
    var h5_h = 2600822924; var h5_l = 725511199;
    var h6_h = 528734635;  var h6_l = 4215389547;
    var h7_h = 1541459225; var h7_l = 327033209;

    let padded_len = ((blen + 17 + 127) / 128) * 128;
    var w_hi = hash_zero_words(80);
    var w_lo = hash_zero_words(80);
    let k_hi = SHA512_K_HI;
    let k_lo = SHA512_K_LO;
    var blk = 0;
    while blk < padded_len {
        var t = 0;
        while t < 16 {
            let base = blk + (t * 8);
            let b0 = sha512_padded_byte(bytes, blen, padded_len, base);
            let b1 = sha512_padded_byte(bytes, blen, padded_len, base + 1);
            let b2 = sha512_padded_byte(bytes, blen, padded_len, base + 2);
            let b3 = sha512_padded_byte(bytes, blen, padded_len, base + 3);
            let b4 = sha512_padded_byte(bytes, blen, padded_len, base + 4);
            let b5 = sha512_padded_byte(bytes, blen, padded_len, base + 5);
            let b6 = sha512_padded_byte(bytes, blen, padded_len, base + 6);
            let b7 = sha512_padded_byte(bytes, blen, padded_len, base + 7);
            w_hi[t] = ((b0 << 24) | (b1 << 16) | (b2 << 8) | b3) & MAX_32_BIT;
            w_lo[t] = ((b4 << 24) | (b5 << 16) | (b6 << 8) | b7) & MAX_32_BIT;
            t = t + 1;
        }
        while t < 80 {
            let w15_h = w_hi[t - 15];
            let w15_l = w_lo[t - 15];
            let w2_h = w_hi[t - 2];
            let w2_l = w_lo[t - 2];
            let w16_h = w_hi[t - 16];
            let w16_l = w_lo[t - 16];
            let w7_h = w_hi[t - 7];
            let w7_l = w_lo[t - 7];

            let s0_h = sha512_lsigma0_hi(w15_h, w15_l);
            let s0_l = sha512_lsigma0_lo(w15_h, w15_l);
            let s1_h = sha512_lsigma1_hi(w2_h, w2_l);
            let s1_l = sha512_lsigma1_lo(w2_h, w2_l);

            let sum_l = w16_l + s0_l + w7_l + s1_l;
            w_lo[t] = sum_l & MAX_32_BIT;
            w_hi[t] = (w16_h + s0_h + w7_h + s1_h + (sum_l >> 32)) & MAX_32_BIT;
            t = t + 1;
        }

        var a_h = h0_h; var a_l = h0_l;
        var b_h = h1_h; var b_l = h1_l;
        var c_h = h2_h; var c_l = h2_l;
        var d_h = h3_h; var d_l = h3_l;
        var e_h = h4_h; var e_l = h4_l;
        var f_h = h5_h; var f_l = h5_l;
        var g_h = h6_h; var g_l = h6_l;
        var h_h = h7_h; var h_l = h7_l;

        t = 0;
        while t < 80 {
            let wt_h = w_hi[t];
            let wt_l = w_lo[t];
            let kt_h = k_hi[t];
            let kt_l = k_lo[t];

            let t1_l_sum = h_l + sha512_sigma1_lo(e_h, e_l) + sha256_ch(e_l, f_l, g_l) + kt_l + wt_l;
            let t1_l = t1_l_sum & MAX_32_BIT;
            let t1_h = (h_h + sha512_sigma1_hi(e_h, e_l) + sha256_ch(e_h, f_h, g_h) + kt_h + wt_h + (t1_l_sum >> 32)) & MAX_32_BIT;

            let t2_l_sum = sha512_sigma0_lo(a_h, a_l) + sha256_maj(a_l, b_l, c_l);
            let t2_l = t2_l_sum & MAX_32_BIT;
            let t2_h = (sha512_sigma0_hi(a_h, a_l) + sha256_maj(a_h, b_h, c_h) + (t2_l_sum >> 32)) & MAX_32_BIT;

            h_h = g_h; h_l = g_l;
            g_h = f_h; g_l = f_l;
            f_h = e_h; f_l = e_l;
            let ne_l = d_l + t1_l;
            e_l = ne_l & MAX_32_BIT;
            e_h = (d_h + t1_h + (ne_l >> 32)) & MAX_32_BIT;
            d_h = c_h; d_l = c_l;
            c_h = b_h; c_l = b_l;
            b_h = a_h; b_l = a_l;
            let na_l = t1_l + t2_l;
            a_l = na_l & MAX_32_BIT;
            a_h = (t1_h + t2_h + (na_l >> 32)) & MAX_32_BIT;
            t = t + 1;
        }

        let s0l = h0_l + a_l; h0_l = s0l & MAX_32_BIT; h0_h = (h0_h + a_h + (s0l >> 32)) & MAX_32_BIT;
        let s1l = h1_l + b_l; h1_l = s1l & MAX_32_BIT; h1_h = (h1_h + b_h + (s1l >> 32)) & MAX_32_BIT;
        let s2l = h2_l + c_l; h2_l = s2l & MAX_32_BIT; h2_h = (h2_h + c_h + (s2l >> 32)) & MAX_32_BIT;
        let s3l = h3_l + d_l; h3_l = s3l & MAX_32_BIT; h3_h = (h3_h + d_h + (s3l >> 32)) & MAX_32_BIT;
        let s4l = h4_l + e_l; h4_l = s4l & MAX_32_BIT; h4_h = (h4_h + e_h + (s4l >> 32)) & MAX_32_BIT;
        let s5l = h5_l + f_l; h5_l = s5l & MAX_32_BIT; h5_h = (h5_h + f_h + (s5l >> 32)) & MAX_32_BIT;
        let s6l = h6_l + g_l; h6_l = s6l & MAX_32_BIT; h6_h = (h6_h + g_h + (s6l >> 32)) & MAX_32_BIT;
        let s7l = h7_l + h_l; h7_l = s7l & MAX_32_BIT; h7_h = (h7_h + h_h + (s7l >> 32)) & MAX_32_BIT;

        blk = blk + 128;
    }
    return [
        h0_h, h0_l, h1_h, h1_l, h2_h, h2_l, h3_h, h3_l,
        h4_h, h4_l, h5_h, h5_l, h6_h, h6_l, h7_h, h7_l,
    ];
}

pub fn sha512_hex(msg: str) -> str {
    let bytes = hash_str_bytes(msg);
    let h = sha512_words(bytes, msg.len());
    return hash_words_hex_be(h);
}

// ============================================================================
// Official BLAKE3 Compression & Multi-Chunk Merkle Tree Hash
// ============================================================================

// Runs G on state words `ai`, `bi`, `ci`, `di` of `st` with the message words
// at `xi` and `yi`.
pub fn blake3_qround(var ref st: List<i64>, ai: i64, bi: i64, ci: i64, di: i64, xi: i64, yi: i64) {
    let a0 = st[ai];
    let b0 = st[bi];
    let c0 = st[ci];
    let d0 = st[di];
    let mx = st[xi];
    let my = st[yi];

    let a1 = (a0 + b0 + mx) & MAX_32_BIT;
    let d1 = rotr32(d0 ^ a1, 16);
    let c1 = (c0 + d1) & MAX_32_BIT;
    let b1 = rotr32(b0 ^ c1, 12);
    let a2 = (a1 + b1 + my) & MAX_32_BIT;
    let d2 = rotr32(d1 ^ a2, 8);
    let c2 = (c1 + d2) & MAX_32_BIT;
    let b2 = rotr32(b1 ^ c2, 7);

    st[ai] = a2;
    st[bi] = b2;
    st[ci] = c2;
    st[di] = d2;
}

// `st` (56 words): 0..15 = state words, 16..31 = message words,
// 32..47 = permutation scratch, 48..55 = chaining value.
pub fn blake3_compress_in_place(var ref st: List<i64>, counter: i64, block_len: i64, flags: i64) {
    let iv = BLAKE3_IV;
    let perm = BLAKE3_MSG_PERM;
    var i = 0;
    while i < 8 {
        st[i] = st[48 + i];
        i = i + 1;
    }
    st[8] = iv[0];
    st[9] = iv[1];
    st[10] = iv[2];
    st[11] = iv[3];
    st[12] = counter & MAX_32_BIT;
    st[13] = (counter >> 32) & MAX_32_BIT;
    st[14] = block_len & MAX_32_BIT;
    st[15] = flags & MAX_32_BIT;

    var r = 0;
    while r < 7 {
        blake3_qround(st, 0, 4, 8, 12, 16, 17);
        blake3_qround(st, 1, 5, 9, 13, 18, 19);
        blake3_qround(st, 2, 6, 10, 14, 20, 21);
        blake3_qround(st, 3, 7, 11, 15, 22, 23);
        blake3_qround(st, 0, 5, 10, 15, 24, 25);
        blake3_qround(st, 1, 6, 11, 12, 26, 27);
        blake3_qround(st, 2, 7, 8, 13, 28, 29);
        blake3_qround(st, 3, 4, 9, 14, 30, 31);
        if r < 6 {
            var pi = 0;
            while pi < 16 {
                st[32 + pi] = st[16 + perm[pi]];
                pi = pi + 1;
            }
            pi = 0;
            while pi < 16 {
                st[16 + pi] = st[32 + pi];
                pi = pi + 1;
            }
        }
        r = r + 1;
    }

    i = 0;
    while i < 8 {
        let s_lo = st[i];
        let s_hi = st[i + 8];
        let cv_i = st[48 + i];
        st[i] = (s_lo ^ s_hi) & MAX_32_BIT;
        st[i + 8] = (s_hi ^ cv_i) & MAX_32_BIT;
        i = i + 1;
    }
}

pub pure fn blake3_msg_byte(msg: str, mlen: i64, idx: i64) -> i64 {
    if idx < mlen {
        return msg.byte_at(idx) & 255;
    }
    return 0;
}
pub fn blake3_load_msg_block(var ref st: List<i64>, msg: str, mlen: i64, blk_offset: i64, blk_len: i64) {
    let end_off = blk_offset + blk_len;
    var wi = 0;
    while wi < 16 {
        let p = blk_offset + (wi * 4);
        let b0 = if p < end_off { blake3_msg_byte(msg, mlen, p) } else { 0 };
        let b1 = if p + 1 < end_off { blake3_msg_byte(msg, mlen, p + 1) } else { 0 };
        let b2 = if p + 2 < end_off { blake3_msg_byte(msg, mlen, p + 2) } else { 0 };
        let b3 = if p + 3 < end_off { blake3_msg_byte(msg, mlen, p + 3) } else { 0 };
        st[16 + wi] = (b0 | (b1 << 8) | (b2 << 16) | (b3 << 24)) & MAX_32_BIT;
        wi = wi + 1;
    }
}

// Loads `left` (8 words of `stack_cv` at `l_base`) and the current chaining
// value as a parent block, and resets the chaining value to the IV.
pub fn blake3_load_parent(var ref st: List<i64>, ref stack_cv: List<i64>, l_base: i64) {
    let iv = BLAKE3_IV;
    var wi = 0;
    while wi < 8 {
        st[16 + wi] = stack_cv[l_base + wi];
        st[24 + wi] = st[48 + wi];
        st[48 + wi] = iv[wi];
        wi = wi + 1;
    }
}

// Copies the first 8 output words into the chaining value.
pub fn blake3_keep_cv(var ref st: List<i64>) {
    var ci = 0;
    while ci < 8 {
        st[48 + ci] = st[ci];
        ci = ci + 1;
    }
}

// Sets the chaining value to the IV.
pub fn blake3_reset_cv(var ref st: List<i64>) {
    let iv = BLAKE3_IV;
    var i = 0;
    while i < 8 {
        st[48 + i] = iv[i];
        i = i + 1;
    }
}

// The first 8 output words as little-endian hex (the 32-byte BLAKE3 digest).
pub fn blake3_out_hex(st: List<i64>) -> str {
    var hex_s = "";
    var hi = 0;
    while hi < 8 {
        hex_s = hex_s + hash_hex_u32_le(st[hi]);
        hi = hi + 1;
    }
    return hex_s;
}

pub fn blake3_hex(msg: str) -> str {
    let mlen = msg.len();
    var st = hash_zero_words(56);

    if mlen <= 1024 {
        blake3_reset_cv(st);
        let num_blocks = if mlen == 0 { 1 } else { (mlen + 63) / 64 };
        var b_idx = 0;
        while b_idx < num_blocks {
            let b_start = b_idx * 64;
            let rem = mlen - b_start;
            let b_len = if mlen == 0 { 0 } else if rem > 64 { 64 } else { rem };
            blake3_load_msg_block(st, msg, mlen, b_start, b_len);
            var flags = 0;
            if b_idx == 0 { flags = flags | 1; }
            if b_idx + 1 == num_blocks { flags = flags | 2 | 8; }
            blake3_compress_in_place(st, 0, b_len, flags);
            if b_idx + 1 < num_blocks {
                blake3_keep_cv(st);
            }
            b_idx = b_idx + 1;
        }
        return blake3_out_hex(st);
    }

    // Multi-chunk Merkle stack: entry `d` holds a chaining value at
    // `stack_cv[d * 8 ..]` and its subtree height at `stack_h[d]`.
    var stack_cv: List<i64> = [];
    var stack_h: List<i64> = [];
    let total_chunks = (mlen + 1023) / 1024;
    var stack_len = 0;
    var chunk_idx = 0;
    while chunk_idx < total_chunks {
        let c_start = chunk_idx * 1024;
        let c_rem = mlen - c_start;
        let c_len = if c_rem > 1024 { 1024 } else { c_rem };
        blake3_reset_cv(st);
        let num_blocks = (c_len + 63) / 64;
        var b_idx = 0;
        while b_idx < num_blocks {
            let b_start = c_start + (b_idx * 64);
            let b_rem = (c_start + c_len) - b_start;
            let b_len = if b_rem > 64 { 64 } else { b_rem };
            blake3_load_msg_block(st, msg, mlen, b_start, b_len);
            var flags = 0;
            if b_idx == 0 { flags = flags | 1; }
            if b_idx + 1 == num_blocks { flags = flags | 2; }
            blake3_compress_in_place(st, chunk_idx, b_len, flags);
            blake3_keep_cv(st);
            b_idx = b_idx + 1;
        }

        var cur_h = 0;
        if (chunk_idx + 1) < total_chunks {
            var fold = 1;
            while fold == 1 {
                if stack_len > 0 {
                    let top_h = stack_h[stack_len - 1];
                    if top_h == cur_h {
                        stack_len = stack_len - 1;
                        blake3_load_parent(st, stack_cv, stack_len * 8);
                        blake3_compress_in_place(st, 0, 64, 4);
                        blake3_keep_cv(st);
                        cur_h = top_h + 1;
                    } else {
                        fold = 0;
                    }
                } else {
                    fold = 0;
                }
            }
            let s_base = stack_len * 8;
            var si = 0;
            while si < 8 {
                if s_base + si < stack_cv.len() {
                    stack_cv[s_base + si] = st[48 + si];
                } else {
                    stack_cv.push(st[48 + si]);
                }
                si = si + 1;
            }
            if stack_len < stack_h.len() {
                stack_h[stack_len] = cur_h;
            } else {
                stack_h.push(cur_h);
            }
            stack_len = stack_len + 1;
        } else {
            while stack_len > 1 {
                stack_len = stack_len - 1;
                blake3_load_parent(st, stack_cv, stack_len * 8);
                blake3_compress_in_place(st, 0, 64, 4);
                blake3_keep_cv(st);
            }
            stack_len = stack_len - 1;
            blake3_load_parent(st, stack_cv, stack_len * 8);
            blake3_compress_in_place(st, 0, 64, 12);
            return blake3_out_hex(st);
        }
        chunk_idx = chunk_idx + 1;
    }
    return "";
}

pub fn blake3_digest(msg: str) -> Digest256 {
    let hex_s = blake3_hex(msg);
    return Digest256 {
        h0: hex_s.byte_at(0),
        h1: hex_s.byte_at(1),
        h2: hex_s.byte_at(2),
        h3: hex_s.byte_at(3),
        hex_prefix: hex_s,
    };
}
