// SPDX-License-Identifier: MIT AND PSF-2.0
// std.encoding — Zero-Copy Byte/UTF-8 Codecs (`hex`, `base64`, `base64url`) & RFC-3986 `url` / Query Parsers
// Standard library zero-copy byte codecs and RFC-3986 URL parsing.

pub pkg Pilot.Encoding;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __utf8_encode_slice(text: str) -> any;
    fn __utf8_validate_slice(buf: any) -> i64;
    fn __utf8_decode_slice(buf: any) -> str;
    fn __slice_subview(buf: any, start: i64, length: i64) -> any;
    fn __slice_push(buf: any, byte_val: i64);
    fn __slice_byte_at(buf: any, idx: i64) -> i64;
}

pub type DecodeError = InvalidChar(ch: str, offset: i64)
                     | InvalidLength(len_val: i64, msg: str)
                     | InvalidPadding(offset: i64, msg: str)
                     | InvalidUtf8(offset: i64, msg: str)
                     | BadPercentEscape(seq: str, offset: i64);

pub fn format_decode_error(err: DecodeError) -> str {
    switch err {
        case DecodeError.InvalidChar(ch, off):
            return f"InvalidChar('{ch}' at byte {off})";
        case DecodeError.InvalidLength(n, msg):
            return f"InvalidLength({n}): {msg}";
        case DecodeError.InvalidPadding(off, msg):
            return f"InvalidPadding(at {off}): {msg}";
        case DecodeError.InvalidUtf8(off, msg):
            return f"InvalidUtf8(at {off}): {msg}";
        case DecodeError.BadPercentEscape(seq, off):
            return f"BadPercentEscape('{seq}' at {off})";
    }
}

const _HEX_LOWER: str = "0123456789abcdef";
const _HEX_UPPER: str = "0123456789ABCDEF";
const _B64_STD: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
const _B64_URL: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

fn __to_utf8_bytes(data: any) -> any {
    let kind: str = type_of(data);
    if kind == "slicebuffer" {
        return data;
    }
    if kind == "list" || kind == "tuple" {
        let count: i64 = len(data);
        var buf = slice_buffer(count, "u8");
        for i in 0..<count {
            __slice_push(buf, (data[i] as i64) & 255);
        }
        return buf;
    }
    if kind == "object" {
        return data.raw_buffer();
    }
    return __utf8_encode_slice(str(data));
}

fn __decode_utf8_strict(buf: any) -> str ! DecodeError {
    let bad_idx: i64 = __utf8_validate_slice(buf);
    if bad_idx >= 0 {
        return fail(DecodeError.InvalidUtf8(bad_idx, "invalid UTF-8 byte sequence"));
    }
    return ok(__utf8_decode_slice(buf));
}

fn __coerce_encoded_str(encoded: any) -> str ! DecodeError {
    let kind: str = type_of(encoded);
    if kind == "string" || kind == "str" {
        return ok(encoded);
    }
    if kind == "slicebuffer" {
        let s = __decode_utf8_strict(encoded)?;
        return ok(s);
    }
    if kind == "object" {
        let s = __decode_utf8_strict(encoded.raw_buffer())?;
        return ok(s);
    }
    return ok(str(encoded));
}

fn __hex_nibble(code: i64) -> i64 {
    if code >= 48 && code <= 57 {
        return code - 48;
    }
    if code >= 97 && code <= 102 {
        return 10 + (code - 97);
    }
    if code >= 65 && code <= 70 {
        return 10 + (code - 65);
    }
    return -1;
}

fn __b64_sextet(code: i64, url_safe: bool) -> i64 {
    if code >= 65 && code <= 90 {
        return code - 65;
    }
    if code >= 97 && code <= 122 {
        return 26 + (code - 97);
    }
    if code >= 48 && code <= 57 {
        return 52 + (code - 48);
    }
    if url_safe {
        if code == 45 {
            return 62;
        }
        if code == 95 {
            return 63;
        }
    } else {
        if code == 43 {
            return 62;
        }
        if code == 47 {
            return 63;
        }
    }
    return -1;
}

fn __is_unreserved_rfc3986(b: i64) -> bool {
    if (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) {
        return true;
    }
    // '-' (45), '.' (46), '_' (95), '~' (126)
    return b == 45 || b == 46 || b == 95 || b == 126;
}

// ============================================================================
// 1. Hexadecimal Codec (RFC 4648 §8)
// ============================================================================

pub fn hex_encode(data: any, upper: bool = false) -> str {
    let buf = __to_utf8_bytes(data);
    let n: i64 = len(buf);
    if n == 0 {
        return "";
    }
    let alphabet: str = if upper { _HEX_UPPER } else { _HEX_LOWER };
    var out_bytes = slice_buffer(n * 2, "u8");
    for i in 0..<n {
        let b: i64 = __slice_byte_at(buf, i);
        let hi: i64 = (b >> 4) & 15;
        let lo: i64 = b & 15;
        __slice_push(out_bytes, alphabet.char_code_at(hi));
        __slice_push(out_bytes, alphabet.char_code_at(lo));
    }
    return __utf8_decode_slice(out_bytes);
}

pub fn hex_decode_bytes(encoded_in: any) -> SliceBuffer<u8> ! DecodeError {
    let encoded: str = __coerce_encoded_str(encoded_in)?;
    let n: i64 = len(encoded);
    if (n % 2) != 0 {
        return fail(DecodeError.InvalidLength(n, "hex input must have an even number of characters"));
    }
    var out_buf = slice_buffer(n / 2, "u8");
    var i: i64 = 0;
    while i < n {
        let c_hi: i64 = encoded.char_code_at(i);
        let v_hi: i64 = __hex_nibble(c_hi);
        if v_hi < 0 {
            return fail(DecodeError.InvalidChar(encoded[i..(i + 1)], i));
        }
        let c_lo: i64 = encoded.char_code_at(i + 1);
        let v_lo: i64 = __hex_nibble(c_lo);
        if v_lo < 0 {
            return fail(DecodeError.InvalidChar(encoded[(i + 1)..(i + 2)], i + 1));
        }
        __slice_push(out_buf, (v_hi << 4) | v_lo);
        i = i + 2;
    }
    return ok(out_buf);
}

pub fn hex_decode(encoded: any) -> str ! DecodeError {
    let buf = hex_decode_bytes(encoded)?;
    let decoded = __decode_utf8_strict(buf)?;
    return ok(decoded);
}

// ============================================================================
// 2. Base64 & Base64URL Codecs (RFC 4648 §4 & §5)
// ============================================================================

fn __b64_encode_core(data: any, alphabet: str, pad: bool) -> str {
    let buf = __to_utf8_bytes(data);
    let n: i64 = len(buf);
    if n == 0 {
        return "";
    }
    let out_cap: i64 = ((n + 2) / 3) * 4;
    var out_bytes = slice_buffer(out_cap, "u8");
    var i: i64 = 0;
    while (i + 3) <= n {
        let b0: i64 = __slice_byte_at(buf, i);
        let b1: i64 = __slice_byte_at(buf, i + 1);
        let b2: i64 = __slice_byte_at(buf, i + 2);
        let triple: i64 = (b0 << 16) | (b1 << 8) | b2;
        __slice_push(out_bytes, alphabet.char_code_at((triple >> 18) & 63));
        __slice_push(out_bytes, alphabet.char_code_at((triple >> 12) & 63));
        __slice_push(out_bytes, alphabet.char_code_at((triple >> 6) & 63));
        __slice_push(out_bytes, alphabet.char_code_at(triple & 63));
        i = i + 3;
    }

    let rem: i64 = n - i;
    if rem == 1 {
        let b0: i64 = __slice_byte_at(buf, i);
        __slice_push(out_bytes, alphabet.char_code_at((b0 >> 2) & 63));
        __slice_push(out_bytes, alphabet.char_code_at((b0 & 3) << 4));
        if pad {
            __slice_push(out_bytes, 61);
            __slice_push(out_bytes, 61);
        }
    } else if rem == 2 {
        let b0: i64 = __slice_byte_at(buf, i);
        let b1: i64 = __slice_byte_at(buf, i + 1);
        let pair: i64 = (b0 << 8) | b1;
        __slice_push(out_bytes, alphabet.char_code_at((pair >> 10) & 63));
        __slice_push(out_bytes, alphabet.char_code_at((pair >> 4) & 63));
        __slice_push(out_bytes, alphabet.char_code_at((pair & 15) << 2));
        if pad {
            __slice_push(out_bytes, 61);
        }
    }

    return __utf8_decode_slice(out_bytes);
}

fn __b64_decode_core(encoded: str, url_safe: bool) -> SliceBuffer<u8> ! DecodeError {
    // Collect non-CR/LF characters alongside original string offsets
    var codes = [];
    var offsets = [];
    let raw_len: i64 = len(encoded);
    for idx in 0..<raw_len {
        let c: i64 = encoded.char_code_at(idx);
        if c == 10 || c == 13 {
            continue;
        }
        codes.append(c);
        offsets.append(idx);
    }

    let n: i64 = len(codes);
    if n == 0 {
        return ok(slice_buffer(0, "u8"));
    }

    if !url_safe && (n % 4) != 0 {
        return fail(DecodeError.InvalidLength(n, "standard base64 input length must be a multiple of 4"));
    }
    if (n % 4) == 1 {
        return fail(DecodeError.InvalidLength(n, "base64 input length mod 4 cannot equal 1"));
    }

    // Virtual padding for unpadded base64url
    let rem4: i64 = n % 4;
    if rem4 == 2 {
        codes.append(61);
        offsets.append(raw_len);
        codes.append(61);
        offsets.append(raw_len);
    } else if rem4 == 3 {
        codes.append(61);
        offsets.append(raw_len);
    }

    let total: i64 = len(codes);
    var out_buf = slice_buffer((total / 4) * 3, "u8");
    var q: i64 = 0;
    while q < total {
        let is_last: bool = (q + 4) == total;
        let c0: i64 = codes[q];
        let c1: i64 = codes[q + 1];
        let c2: i64 = codes[q + 2];
        let c3: i64 = codes[q + 3];

        if c0 == 61 {
            return fail(DecodeError.InvalidPadding(offsets[q], "unexpected '=' at start of base64 quantum"));
        }
        if c1 == 61 {
            return fail(DecodeError.InvalidPadding(offsets[q + 1], "unexpected '=' at second position of base64 quantum"));
        }
        if !is_last && (c2 == 61 || c3 == 61) {
            let bad_off: i64 = if c2 == 61 { offsets[q + 2] } else { offsets[q + 3] };
            return fail(DecodeError.InvalidPadding(bad_off, "padding '=' only allowed in final base64 quantum"));
        }
        if c2 == 61 && c3 != 61 {
            return fail(DecodeError.InvalidPadding(offsets[q + 2], "'=' must be followed by '=' in final base64 quantum"));
        }

        let s0: i64 = __b64_sextet(c0, url_safe);
        if s0 < 0 {
            let off0: i64 = offsets[q];
            return fail(DecodeError.InvalidChar(encoded[off0..(off0 + 1)], off0));
        }
        let s1: i64 = __b64_sextet(c1, url_safe);
        if s1 < 0 {
            let off1: i64 = offsets[q + 1];
            return fail(DecodeError.InvalidChar(encoded[off1..(off1 + 1)], off1));
        }

        if c2 == 61 {
            // 2 chars + "==" -> 1 byte (RFC 4648 §3.5: low 4 bits of s1 must be 0)
            if (s1 & 15) != 0 {
                return fail(DecodeError.InvalidPadding(offsets[q + 1], "non-zero trailing pad bits in 2-char base64 quantum"));
            }
            __slice_push(out_buf, ((s0 << 2) | (s1 >> 4)) & 255);
        } else if c3 == 61 {
            // 3 chars + "=" -> 2 bytes (RFC 4648 §3.5: low 2 bits of s2 must be 0)
            let s2: i64 = __b64_sextet(c2, url_safe);
            if s2 < 0 {
                let off2: i64 = offsets[q + 2];
                return fail(DecodeError.InvalidChar(encoded[off2..(off2 + 1)], off2));
            }
            if (s2 & 3) != 0 {
                return fail(DecodeError.InvalidPadding(offsets[q + 2], "non-zero trailing pad bits in 3-char base64 quantum"));
            }
            __slice_push(out_buf, ((s0 << 2) | (s1 >> 4)) & 255);
            __slice_push(out_buf, (((s1 & 15) << 4) | (s2 >> 2)) & 255);
        } else {
            // Full 4 chars -> 3 bytes
            let s2: i64 = __b64_sextet(c2, url_safe);
            if s2 < 0 {
                let off2: i64 = offsets[q + 2];
                return fail(DecodeError.InvalidChar(encoded[off2..(off2 + 1)], off2));
            }
            let s3: i64 = __b64_sextet(c3, url_safe);
            if s3 < 0 {
                let off3: i64 = offsets[q + 3];
                return fail(DecodeError.InvalidChar(encoded[off3..(off3 + 1)], off3));
            }
            let triple: i64 = (s0 << 18) | (s1 << 12) | (s2 << 6) | s3;
            __slice_push(out_buf, (triple >> 16) & 255);
            __slice_push(out_buf, (triple >> 8) & 255);
            __slice_push(out_buf, triple & 255);
        }

        q = q + 4;
    }

    return ok(out_buf);
}

pub fn base64_encode(data: any) -> str {
    return __b64_encode_core(data, _B64_STD, true);
}

pub fn base64_decode_bytes(encoded_in: any) -> SliceBuffer<u8> ! DecodeError {
    let encoded: str = __coerce_encoded_str(encoded_in)?;
    let out_buf = __b64_decode_core(encoded, false)?;
    return ok(out_buf);
}

pub fn base64_decode(encoded: any) -> str ! DecodeError {
    let buf = base64_decode_bytes(encoded)?;
    let decoded = __decode_utf8_strict(buf)?;
    return ok(decoded);
}

pub fn base64url_encode(data: any, pad: bool = false) -> str {
    return __b64_encode_core(data, _B64_URL, pad);
}

pub fn base64url_decode_bytes(encoded_in: any) -> SliceBuffer<u8> ! DecodeError {
    let encoded: str = __coerce_encoded_str(encoded_in)?;
    let out_buf = __b64_decode_core(encoded, true)?;
    return ok(out_buf);
}

pub fn base64url_decode(encoded: any) -> str ! DecodeError {
    let buf = base64url_decode_bytes(encoded)?;
    let decoded = __decode_utf8_strict(buf)?;
    return ok(decoded);
}

// ============================================================================
// 3. RFC 3986 Percent-Encoding, Query Strings & Structured `Url`
// ============================================================================

pub fn url_encode(text: str, space_as_plus: bool = false) -> str {
    let buf = __utf8_encode_slice(text);
    let n: i64 = len(buf);
    if n == 0 {
        return "";
    }
    var out_bytes = slice_buffer(n * 3, "u8");
    for i in 0..<n {
        let b: i64 = __slice_byte_at(buf, i);
        if __is_unreserved_rfc3986(b) {
            __slice_push(out_bytes, b);
        } else if b == 32 && space_as_plus {
            __slice_push(out_bytes, 43);
        } else {
            __slice_push(out_bytes, 37);
            __slice_push(out_bytes, _HEX_UPPER.char_code_at((b >> 4) & 15));
            __slice_push(out_bytes, _HEX_UPPER.char_code_at(b & 15));
        }
    }
    return __utf8_decode_slice(out_bytes);
}

pub fn url_decode_bytes(encoded_in: any, plus_as_space: bool = false) -> SliceBuffer<u8> ! DecodeError {
    let src_bytes = __to_utf8_bytes(encoded_in);
    let n: i64 = len(src_bytes);
    var out_buf = slice_buffer(n, "u8");
    var i: i64 = 0;
    while i < n {
        let b: i64 = __slice_byte_at(src_bytes, i);
        if b == 43 && plus_as_space {
            __slice_push(out_buf, 32);
            i = i + 1;
        } else if b == 37 {
            if (i + 2) >= n {
                let rem_view = __slice_subview(src_bytes, i, n - i);
                let rem_seq = __utf8_decode_slice(rem_view);
                return fail(DecodeError.BadPercentEscape(rem_seq, i));
            }
            let hi: i64 = __hex_nibble(__slice_byte_at(src_bytes, i + 1));
            let lo: i64 = __hex_nibble(__slice_byte_at(src_bytes, i + 2));
            if hi < 0 || lo < 0 {
                let bad_view = __slice_subview(src_bytes, i, 3);
                let bad_seq = __utf8_decode_slice(bad_view);
                return fail(DecodeError.BadPercentEscape(bad_seq, i));
            }
            __slice_push(out_buf, (hi << 4) | lo);
            i = i + 3;
        } else {
            __slice_push(out_buf, b);
            i = i + 1;
        }
    }
    return ok(out_buf);
}

pub fn url_decode(encoded: any, plus_as_space: bool = false) -> str ! DecodeError {
    let buf = url_decode_bytes(encoded, plus_as_space)?;
    let decoded = __decode_utf8_strict(buf)?;
    return ok(decoded);
}

pub fn query_encode(params: any) -> str {
    let entries = if type_of(params) == "map" || type_of(params) == "object" {
        __map_entries_sorted(params)
    } else {
        params
    };
    var out: str = "";
    var first: bool = true;
    for pair in entries {
        let k_enc = url_encode(str(pair[0]), true);
        let v_enc = url_encode(str(pair[1]), true);
        if !first {
            out = out + "&";
        }
        out = out + k_enc + "=" + v_enc;
        first = false;
    }
    return out;
}

pub fn query_parse(query_str: str) -> map ! DecodeError {
    var clean: str = query_str;
    if len(clean) > 0 && clean[0..1] == "?" {
        clean = clean[1..len(clean)];
    }
    var out = {};
    if len(clean) == 0 {
        return ok(out);
    }
    let parts: str[] = clean.split("&");
    for part in parts {
        if len(part) == 0 {
            continue;
        }
        let eq_idx: i64 = part.index_of("=");
        if eq_idx < 0 {
            let k = url_decode(part, true)?;
            out[k] = "";
        } else {
            let raw_k = part[0..eq_idx];
            let raw_v = part[(eq_idx + 1)..len(part)];
            let k = url_decode(raw_k, true)?;
            let v = url_decode(raw_v, true)?;
            out[k] = v;
        }
    }
    return ok(out);
}

pub fn query_parse_multi(query_str: str) -> map ! DecodeError {
    var clean: str = query_str;
    if len(clean) > 0 && clean[0..1] == "?" {
        clean = clean[1..len(clean)];
    }
    var out = {};
    if len(clean) == 0 {
        return ok(out);
    }
    let parts: str[] = clean.split("&");
    for part in parts {
        if len(part) == 0 {
            continue;
        }
        let eq_idx: i64 = part.index_of("=");
        var k: str = "";
        var v: str = "";
        if eq_idx < 0 {
            k = url_decode(part, true)?;
        } else {
            k = url_decode(part[0..eq_idx], true)?;
            v = url_decode(part[(eq_idx + 1)..len(part)], true)?;
        }
        if out.contains_key(k) {
            out[k].append(v);
        } else {
            out[k] = [v];
        }
    }
    return ok(out);
}

pub struct Url : IValue {
    pub:
        scheme:   str;
        userinfo: str;
        host:     str;
        port:     any;
        path:     str;
        query:    str;
        fragment: str;

        self(
            scheme: str,
            userinfo: str,
            host: str,
            port_opt: any,
            path: str,
            query: str,
            fragment: str
        ) {
            self.scheme = scheme;
            self.userinfo = userinfo;
            self.host = host;
            self.port = port_opt;
            self.path = path;
            self.query = query;
            self.fragment = fragment;
        }

        fn has_port() -> bool {
            return __opt_is_some(self.port);
        }

        fn port_or(default_port: i64) -> i64 {
            if __opt_is_some(self.port) {
                return __opt_unwrap(self.port);
            }
            return default_port;
        }

        fn origin() -> str {
            if len(self.scheme) == 0 || len(self.host) == 0 {
                return "";
            }
            var res: str = self.scheme + "://" + self.host;
            if __opt_is_some(self.port) {
                res = res + ":" + str(__opt_unwrap(self.port));
            }
            return res;
        }

        fn query_params() -> map ! DecodeError {
            return query_parse(self.query);
        }

        fn with_query(params: any) -> Url {
            let q_str = if type_of(params) == "string" || type_of(params) == "str" { params } else { query_encode(params) };
            return Url(self.scheme, self.userinfo, self.host, self.port, self.path, q_str, self.fragment);
        }

        fn to_str() -> str {
            var out: str = "";
            if len(self.scheme) > 0 {
                out = out + self.scheme + ":";
            }
            if len(self.host) > 0 || len(self.scheme) > 0 {
                if len(self.host) > 0 {
                    out = out + "//";
                    if len(self.userinfo) > 0 {
                        out = out + self.userinfo + "@";
                    }
                    out = out + self.host;
                    if __opt_is_some(self.port) {
                        out = out + ":" + str(__opt_unwrap(self.port));
                    }
                }
            }
            out = out + self.path;
            if len(self.query) > 0 {
                out = out + "?" + self.query;
            }
            if len(self.fragment) > 0 {
                out = out + "#" + self.fragment;
            }
            return out;
        }
}

pub fn parse_url(raw_url: str) -> Url ! DecodeError {
    if len(raw_url) == 0 {
        return fail(DecodeError.InvalidLength(0, "empty URL"));
    }

    var rest: str = raw_url;
    var fragment: str = "";
    var query: str = "";
    var scheme: str = "";
    var userinfo: str = "";
    var host: str = "";
    var port_opt: any = none;
    var path_part: str = "";

    // 1. Extract `#fragment`
    let hash_idx: i64 = rest.index_of("#");
    if hash_idx >= 0 {
        fragment = rest[(hash_idx + 1)..len(rest)];
        rest = rest[0..hash_idx];
    }

    // 2. Extract `?query`
    let q_idx: i64 = rest.index_of("?");
    if q_idx >= 0 {
        query = rest[(q_idx + 1)..len(rest)];
        rest = rest[0..q_idx];
    }

    // 3. Extract `scheme://` (or `scheme:`)
    let s_sep: i64 = rest.index_of("://");
    if s_sep > 0 {
        scheme = rest[0..s_sep].to_lower();
        let after_scheme = rest[(s_sep + 3)..len(rest)];
        let slash_idx: i64 = after_scheme.index_of("/");
        var authority: str = "";
        if slash_idx >= 0 {
            authority = after_scheme[0..slash_idx];
            path_part = after_scheme[slash_idx..len(after_scheme)];
        } else {
            authority = after_scheme;
            path_part = "";
        }

        // Extract optional `userinfo@`
        let at_idx: i64 = authority.last_index_of("@");
        var host_port: str = authority;
        if at_idx >= 0 {
            userinfo = authority[0..at_idx];
            host_port = authority[(at_idx + 1)..len(authority)];
        }

        // IPv6 `[::1]:port` vs regular `host:port`
        if len(host_port) > 0 && host_port[0..1] == "[" {
            let close_br: i64 = host_port.index_of("]");
            if close_br < 0 {
                return fail(DecodeError.InvalidChar("[", s_sep + 3));
            }
            host = host_port[0..(close_br + 1)];
            if (close_br + 1) < len(host_port) {
                if host_port[(close_br + 1)..(close_br + 2)] != ":" {
                    return fail(DecodeError.InvalidChar(host_port[(close_br + 1)..(close_br + 2)], close_br + 1));
                }
                let p_raw = host_port[(close_br + 2)..len(host_port)];
                let p_parsed = __parse_int_strict(p_raw, 10);
                if __opt_is_none(p_parsed) {
                    return fail(DecodeError.InvalidChar(p_raw, close_br + 2));
                }
                let p_val: i64 = __opt_unwrap(p_parsed);
                if p_val < 0 || p_val > 65535 {
                    return fail(DecodeError.InvalidLength(p_val, "URL port must be in 0..65535"));
                }
                port_opt = some(p_val);
            }
        } else {
            let colon_idx: i64 = host_port.last_index_of(":");
            if colon_idx >= 0 {
                host = host_port[0..colon_idx];
                let p_raw = host_port[(colon_idx + 1)..len(host_port)];
                let p_parsed = __parse_int_strict(p_raw, 10);
                if __opt_is_none(p_parsed) {
                    return fail(DecodeError.InvalidChar(p_raw, colon_idx + 1));
                }
                let p_val: i64 = __opt_unwrap(p_parsed);
                if p_val < 0 || p_val > 65535 {
                    return fail(DecodeError.InvalidLength(p_val, "URL port must be in 0..65535"));
                }
                port_opt = some(p_val);
            } else {
                host = host_port;
            }
        }
    } else {
        path_part = rest;
    }

    return ok(Url(scheme, userinfo, host, port_opt, path_part, query, fragment));
}
