// Native TOML v1.0.0 parser and serializer for configuration files.
//
// Target OS Platforms:
//   - Linux, Windows, macOS, Android, iOS, and WebAssembly

pub pkg Pilot.Tomllib;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Formats.*;
use Pilot.Io.Fs as std_fs;

/// Error value returned when a TOML document cannot be parsed.
/// Python reference: tomllib.TOMLDecodeError
pub struct TOMLDecodeError : IValue {
    pub:
        msg:  str;
        line: i64;
        col:  i64;

        self(msg: str, line: i64 = 1, col: i64 = 1) {
            .msg = msg;
            .line = line;
            .col = col;
        }

        fn to_string() -> str {
            return f"TOMLDecodeError: {self.msg} (at line {self.line}, column {self.col})";
        }
}

/// Parses a TOML string into a native Pilot map/dictionary.
/// Python reference: tomllib.loads(s, /)
pub fn loads(s: str) -> map ! TOMLDecodeError {
    let parse_res = toml_parse(s);
    switch parse_res {
        case ok(tbl):
            return ok(tbl);
        case fail(err): {
            switch err {
                case ParseError.Syntax(_, msg, ln, cl):
                    return fail(TOMLDecodeError(msg, ln, cl));
                case ParseError.PrematureEof(_, ln, cl):
                    return fail(TOMLDecodeError("Premature end of TOML document", ln, cl));
                case ParseError.BadEscape(_, seq, ln, cl):
                    return fail(TOMLDecodeError(f"Invalid escape sequence: {seq}", ln, cl));
                case ParseError.BadNumber(_, raw, ln, cl):
                    return fail(TOMLDecodeError(f"Invalid TOML number: {raw}", ln, cl));
                case ParseError.DuplicateKey(_, key, ln, cl):
                    return fail(TOMLDecodeError(f"Duplicate key or re-defined table: {key}", ln, cl));
            }
        }
    }
}

/// Parses a TOML document from a filesystem path.
/// Python reference: tomllib.load(fp, /)
pub fn load(file_path: str) -> map ! TOMLDecodeError {
    let text_res = std_fs.read_text(file_path);
    if __result_is_err(text_res) {
        return fail(TOMLDecodeError(f"Could not read TOML file: {file_path}", 1, 1));
    }
    let content: str = __result_unwrap_ok(text_res);
    return loads(content);
}

/// Serializes a Pilot dictionary into a valid TOML document string.
pub fn dumps(doc: any) -> str {
    return toml_stringify(doc);
}

/// Serializes a Pilot dictionary into a TOML document and writes it to a file.
pub fn dump(doc: any, file_path: str) -> bool {
    let content = dumps(doc);
    let write_res = std_fs.write_text(file_path, content);
    return !__result_is_err(write_res);
}
