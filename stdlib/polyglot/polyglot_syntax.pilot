// =========================================================================
// FILE: stdlib/polyglot/polyglot_syntax.pilot
// OPT-IN FFI (`extern`) & INLINE POLYGLOT BLOCK SYNTAX PACKAGE
// =========================================================================
pub pkg Pilot.Polyglot.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    bind_receptor(nameof(extern),     7,  0);
    bind_receptor(nameof(lib),        8,  0);
}

// Inline foreign-language blocks, `word { .. }` and `word("..")`, are not
// built yet (M58): no engine runs one, so each stops the build at the seam
// `polyglot.inline`, at the word, instead of being parsed into a node nothing
// runs (PROP-009 section 17). A word starts a block only when a name, a
// literal or `{` follows it, or `(`; elsewhere, and in a file that declares a
// function of that name, it is an ordinary name
// (tests/conformance/types/polyglot_words_as_names).
pub syntax {
    c $r:Rest => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    c ( $r:Rest ) => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    cpp $r:Rest => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    cpp ( $r:Rest ) => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    rust $r:Rest => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    rust ( $r:Rest ) => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    rs $r:Rest => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    rs ( $r:Rest ) => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    python $r:Rest => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    python ( $r:Rest ) => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    py $r:Rest => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
    py ( $r:Rest ) => quote { form(CoreForm::RejectWord, "SEAM001: unconnected seam `polyglot.inline`: inline foreign-language blocks are not built yet; no engine runs one (M58)", $r) };
