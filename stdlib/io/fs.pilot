// std.fs — Fallible (`! IoError`) Filesystem Operations, Zero-Copy `mmap` Views, Directory Walk & Globbing
// Participates seamlessly in `fn!?(...)` transactional Copy-on-Write dry-runs (`EffectPlan`).

pub pkg Pilot.Io.Fs;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Io.*;
use Pilot.Io.Path as std_path;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __fs_exists(path: str) -> bool;
    fn __fs_is_file(path: str) -> bool;
    fn __fs_is_dir(path: str) -> bool;
    fn __fs_file_size(path: str) -> any;
    fn __fs_read_text(path: str) -> any;
    fn __fs_read_bytes(path: str) -> any;
    fn __fs_list_dir(path: str) -> any;
    fn __fs_walk_dir(path: str) -> any;
    fn __fs_mmap_read(path: str, elem_type: str = "u8") -> any;
    fn __fs_mmap_rw(path: str, capacity: i64 = 0, elem_type: str = "u8") -> any;
    fn __fs_write_text(path: str, content: str, append: bool = false) -> any;
    fn __fs_copy_file(src: str, dst: str, overwrite: bool = false) -> any;
    fn __fs_move_file(src: str, dst: str, overwrite: bool = false) -> any;
    fn __fs_remove_file(path: str) -> any;
    fn __fs_mkdir(path: str, recursive: bool = true) -> any;
    fn __fs_rmdir(path: str, recursive: bool = false) -> any;
    fn __os_cwd() -> str;
    fn __os_temp_dir() -> str;
    fn __dfa_is_match(pattern: any, text: str) -> bool;
}

pub fn exists(path: str) -> bool {
    return __fs_exists(path);
}

pub fn is_file(path: str) -> bool {
    return __fs_is_file(path);
}

pub fn is_dir(path: str) -> bool {
    return __fs_is_dir(path);
}

pub fn cwd() -> str {
    return std_path.normalize(__os_cwd());
}

pub fn temp_dir() -> str {
    return std_path.normalize(__os_temp_dir());
}

pub fn file_size(path: str) -> i64 ! IoError {
    let res = __fs_file_size(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn read_text(path: str) -> str ! IoError {
    let res = __fs_read_text(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn read_lines(path: str) -> str[] ! IoError {
    let content = read_text(path)?;
    let norm = content.replace("\r\n", "\n");
    return ok(norm.split("\n"));
}

pub fn read_bytes(path: str) -> SliceBuffer<u8> ! IoError {
    let res = __fs_read_bytes(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn write_text(path: str, content: str) -> i64 ! IoError {
    let res = __fs_write_text(path, content, false);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn append_text(path: str, content: str) -> i64 ! IoError {
    let res = __fs_write_text(path, content, true);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn remove_file(path: str) -> bool ! IoError {
    let res = __fs_remove_file(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn copy_file(src: str, dst: str, overwrite: bool = false) -> bool ! IoError {
    let res = __fs_copy_file(src, dst, overwrite);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn move_file(src: str, dst: str, overwrite: bool = false) -> bool ! IoError {
    let res = __fs_move_file(src, dst, overwrite);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn create_dir(path: str, recursive: bool = true) -> bool ! IoError {
    let res = __fs_mkdir(path, recursive);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn remove_dir(path: str, recursive: bool = false) -> bool ! IoError {
    let res = __fs_rmdir(path, recursive);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn list_dir(path: str) -> str[] ! IoError {
    let res = __fs_list_dir(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

pub fn walk_dir(path: str) -> str[] ! IoError {
    let res = __fs_walk_dir(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

// Zero-Copy Read-Only OS `mmap` File View (`SliceBuffer<u8>` or typed scalar view)
pub fn mmap_read(path: str, elem_type: str = "u8") -> SliceBuffer<u8> ! IoError {
    let res = __fs_mmap_read(path, elem_type);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

// Zero-Copy Read-Write OS `mmap` Shared File View
pub fn mmap_rw(path: str, capacity: i64, elem_type: str = "u8") -> SliceBuffer<u8> ! IoError {
    let res = __fs_mmap_rw(path, capacity, elem_type);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

// Pure Wildcard / Glob Matcher (PSF-2.0 CPython fnmatch scaffold converted to DFA regex)
pub fn fnmatch(name_str: str, pattern: str) -> bool {
    var dfa_pat: str = "^";
    let n: i64 = len(pattern);
    var i: i64 = 0;
    while i < n {
        let ch = pattern[i..(i + 1)];
        if ch == "*" {
            dfa_pat = dfa_pat + ".*";
        } else if ch == "?" {
            dfa_pat = dfa_pat + ".";
        } else if ch == "." || ch == "+" || ch == "(" || ch == ")" || ch == "^" || ch == "$" || ch == "|" || ch == "\\" {
            dfa_pat = dfa_pat + "\\" + ch;
        } else if ch == "[" {
            var j: i64 = i + 1;
            if j < n && pattern[j..(j + 1)] == "!" {
                j = j + 1;
            }
            if j < n && pattern[j..(j + 1)] == "]" {
                j = j + 1;
            }
            while j < n && pattern[j..(j + 1)] != "]" {
                j = j + 1;
            }
            if j >= n {
                dfa_pat = dfa_pat + "\\[";
            } else {
                var inner = pattern[(i + 1)..j];
                if len(inner) > 0 && inner[0..1] == "!" {
                    inner = "^" + inner[1..len(inner)];
                }
                dfa_pat = dfa_pat + "[" + inner + "]";
                i = j;
            }
        } else {
            dfa_pat = dfa_pat + ch;
        }
        i = i + 1;
    }
    dfa_pat = dfa_pat + "$";
    return __dfa_is_match(dfa_pat, name_str);
}

// Directory Globbing supporting both single-directory (`*.pilot`) and recursive (`**/*.pilot`) patterns
pub fn glob(root_dir: str, pattern: str) -> str[] ! IoError {
    let norm_root = std_path.normalize(root_dir);
    let clean_pat = pattern.replace("\\", "/");
    let is_recursive: bool = clean_pat.contains("**");

    let candidates = if is_recursive {
        walk_dir(norm_root)?
    } else {
        list_dir(norm_root)?
    };

    var leaf_pat: str = clean_pat;
    if len(clean_pat) >= 3 && clean_pat[0..3] == "**/" {
        leaf_pat = clean_pat[3..len(clean_pat)];
    }

    var matched = [];
    for entry in candidates {
        let norm_entry = std_path.normalize(entry);
        let rel_opt = std_path.relative_to(norm_entry, norm_root);
        let rel_str = if __opt_is_some(rel_opt) { __opt_unwrap(rel_opt) } else { norm_entry };
        let fname_opt = std_path.file_name(norm_entry);
        let fname_str = if __opt_is_some(fname_opt) { __opt_unwrap(fname_opt) } else { rel_str };

        if is_recursive && clean_pat != leaf_pat {
            if fnmatch(fname_str, leaf_pat) || fnmatch(rel_str, leaf_pat) {
                matched.append(norm_entry);
            }
        } else if fnmatch(rel_str, clean_pat) || fnmatch(fname_str, clean_pat) {
            matched.append(norm_entry);
        }
    }
    return ok(matched);
}
