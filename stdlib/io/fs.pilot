// std.fs — Fallible (`! IoError`) Filesystem Operations, Zero-Copy `mmap` Views, Directory Walk & Globbing
// Participates seamlessly in `fn!?(...)` transactional Copy-on-Write dry-runs (`EffectPlan`).

from std.io import IoError;
import std.path as std_path;

def exists(path: str) -> bool {
    return __fs_exists(path);
}

def is_file(path: str) -> bool {
    return __fs_is_file(path);
}

def is_dir(path: str) -> bool {
    return __fs_is_dir(path);
}

def cwd() -> str {
    return std_path.normalize(__os_cwd());
}

def temp_dir() -> str {
    return std_path.normalize(__os_temp_dir());
}

def file_size(path: str) -> i64 ! IoError {
    let res = __fs_file_size(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def read_text(path: str) -> str ! IoError {
    let res = __fs_read_text(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def read_lines(path: str) -> [str] ! IoError {
    let content = read_text(path)?;
    let norm = __str_replace(content, "\r\n", "\n");
    return ok(__str_split(norm, "\n"));
}

def read_bytes(path: str) -> SliceBuffer ! IoError {
    let res = __fs_read_bytes(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def write_text(path: str, content: str) -> i64 ! IoError {
    let res = __fs_write_text(path, content, false);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def append_text(path: str, content: str) -> i64 ! IoError {
    let res = __fs_write_text(path, content, true);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def remove_file(path: str) -> bool ! IoError {
    let res = __fs_remove_file(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def copy_file(src: str, dst: str, overwrite: bool = false) -> bool ! IoError {
    let res = __fs_copy_file(src, dst, overwrite);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def move_file(src: str, dst: str, overwrite: bool = false) -> bool ! IoError {
    let res = __fs_move_file(src, dst, overwrite);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def create_dir(path: str, recursive: bool = true) -> bool ! IoError {
    let res = __fs_mkdir(path, recursive);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def remove_dir(path: str, recursive: bool = false) -> bool ! IoError {
    let res = __fs_rmdir(path, recursive);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def list_dir(path: str) -> [str] ! IoError {
    let res = __fs_list_dir(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

def walk_dir(path: str) -> [str] ! IoError {
    let res = __fs_walk_dir(path);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

// Zero-Copy Read-Only OS `mmap` File View (`SliceBuffer<u8>` or typed scalar view)
def mmap_read(path: str, elem_type: str = "u8") -> SliceBuffer ! IoError {
    let res = __fs_mmap_read(path, elem_type);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

// Zero-Copy Read-Write OS `mmap` Shared File View
def mmap_rw(path: str, capacity: i64, elem_type: str = "u8") -> SliceBuffer ! IoError {
    let res = __fs_mmap_rw(path, capacity, elem_type);
    if __result_is_err(res) {
        return fail(__result_unwrap_err(res));
    }
    return ok(__result_unwrap_ok(res));
}

// Pure Wildcard / Glob Matcher (PSF-2.0 CPython fnmatch scaffold converted to DFA regex)
def fnmatch(name_str: str, pattern: str) -> bool {
    var dfa_pat: str = "^";
    let n: i64 = len(pattern);
    var i: i64 = 0;
    while i < n {
        let ch = __str_slice(pattern, i, i + 1);
        if ch == "*" {
            dfa_pat = dfa_pat + ".*";
        } elif ch == "?" {
            dfa_pat = dfa_pat + ".";
        } elif ch == "." or ch == "+" or ch == "(" or ch == ")" or ch == "^" or ch == "$" or ch == "|" or ch == "\\" {
            dfa_pat = dfa_pat + "\\" + ch;
        } elif ch == "[" {
            var j: i64 = i + 1;
            if j < n and __str_slice(pattern, j, j + 1) == "!" {
                j = j + 1;
            }
            if j < n and __str_slice(pattern, j, j + 1) == "]" {
                j = j + 1;
            }
            while j < n and __str_slice(pattern, j, j + 1) != "]" {
                j = j + 1;
            }
            if j >= n {
                dfa_pat = dfa_pat + "\\[";
            } else {
                var inner = __str_slice(pattern, i + 1, j);
                if len(inner) > 0 and __str_slice(inner, 0, 1) == "!" {
                    inner = "^" + __str_slice(inner, 1, len(inner));
                }
                dfa_pat = dfa_pat + "[" + inner + "]";
                i = j;
            }
        } else {
            dfa_pat = dfa_pat + ch;
        }
        i = i + 1;
    }
    dfa_pat = dfa_pat + "$";
    return __dfa_is_match(dfa_pat, name_str);
}

// Directory Globbing supporting both single-directory (`*.pilot`) and recursive (`**/*.pilot`) patterns
def glob(root_dir: str, pattern: str) -> [str] ! IoError {
    let norm_root = std_path.normalize(root_dir);
    let clean_pat = __str_replace(pattern, "\\", "/");
    let is_recursive: bool = __str_index_of(clean_pat, "**", 0) >= 0;

    let candidates = if is_recursive {
        walk_dir(norm_root)?
    } else {
        list_dir(norm_root)?
    };

    var leaf_pat: str = clean_pat;
    if __str_slice(clean_pat, 0, 3) == "**/" {
        leaf_pat = __str_slice(clean_pat, 3, len(clean_pat));
    }

    var matched = [];
    for entry in candidates {
        let norm_entry = std_path.normalize(entry);
        let rel_opt = std_path.relative_to(norm_entry, norm_root);
        let rel_str = if __opt_is_some(rel_opt) { __opt_unwrap(rel_opt) } else { norm_entry };
        let fname_opt = std_path.file_name(norm_entry);
        let fname_str = if __opt_is_some(fname_opt) { __opt_unwrap(fname_opt) } else { rel_str };

        if is_recursive and clean_pat != leaf_pat {
            if fnmatch(fname_str, leaf_pat) or fnmatch(rel_str, leaf_pat) {
                matched.append(norm_entry);
            }
        } elif fnmatch(rel_str, clean_pat) or fnmatch(fname_str, clean_pat) {
            matched.append(norm_entry);
        }
    }
    return ok(matched);
}
