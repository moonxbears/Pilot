// SPDX-License-Identifier: MIT
// std.io — Values-First `IoError` ADT, Null-Safe (`T?`) EOF Streams & Fallible (`! IoError`) Buffered I/O
// Adheres to Pilot Invariant #7: zero `raise`/`try`/`except`; recoverable failures return `T ! IoError`.

pub pkg Pilot.Io;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __fs_read_text(path: str) -> any;
    fn __fs_write_text(path: str, content: str, append: bool = false) -> any;
    fn __slice_subview(buf: any, start: i64, length: i64) -> any;
    fn __utf8_encode_slice(text: str) -> any;
}

pub type IoError = NotFound(path: str)
                 | PermissionDenied(path: str)
                 | InvalidPath(msg: str)
                 | AlreadyExists(path: str)
                 | UnexpectedEof(msg: str)
                 | Other(msg: str);

pub fn format_io_error(err: IoError) -> str {
    switch err {
        case IoError.NotFound(p):
            return f"NotFound: {p}";
        case IoError.PermissionDenied(p):
            return f"PermissionDenied: {p}";
        case IoError.InvalidPath(m):
            return f"InvalidPath: {m}";
        case IoError.AlreadyExists(p):
            return f"AlreadyExists: {p}";
        case IoError.UnexpectedEof(m):
            return f"UnexpectedEof: {m}";
        case IoError.Other(m):
            return f"IoError: {m}";
    }
}

// In-memory UTF-8 text accumulator
pub struct StringBuffer : IValue {
    pub:
        _chunks: str[];
        _len:    i64;

        self(initial: str = "") {
            ._chunks = [];
            ._len = 0;
            if len(initial) > 0 {
                self._chunks.append(initial);
                self._len = len(initial);
            }
        }

        fn len() -> i64 {
            return self._len;
        }

        fn is_empty() -> bool {
            return self._len == 0;
        }

        var fn write(text: str) {
            if len(text) > 0 {
                self._chunks.append(text);
                self._len = self._len + len(text);
            }
        }

        var fn write_line(line: str = "") {
            self.write(line + "\n");
        }

        var fn clear() {
            self._chunks = [];
            self._len = 0;
        }

        fn to_str() -> str {
            var out: str = "";
            for c in self._chunks {
                out = out + c;
            }
            return out;
        }
}

// Null-safe (`none` on EOF) buffered text & byte reader
pub struct BufferedReader : IValue {
    pub:
        _text:       str;
        _bytes:      any;
        _char_pos:   i64;
        _byte_pos:   i64;
        source_path: str;

        self(content: str, source_path: str = "<memory>") {
            ._text = content;
            ._bytes = __utf8_encode_slice(content);
            ._char_pos = 0;
            ._byte_pos = 0;
            .source_path = source_path;
        }

        fn is_eof() -> bool {
            return self._char_pos >= len(self._text);
        }

        // Returns `str?`: `some(line)` (without trailing `\r\n` / `\n`) or `none` when at EOF
        var fn read_line() -> str? {
            let total: i64 = len(self._text);
            if self._char_pos >= total {
                return none;
            }
            let nl_idx: i64 = self._text.index_of("\n", self._char_pos);
            if nl_idx < 0 {
                let rem = self._text[self._char_pos..total];
                self._char_pos = total;
                self._byte_pos = len(self._bytes);
                return some(rem);
            }
            var line_end: i64 = nl_idx;
            if line_end > self._char_pos && self._text[(line_end - 1)..line_end] == "\r" {
                line_end = line_end - 1;
            }
            let line_str = self._text[self._char_pos..line_end];
            self._char_pos = nl_idx + 1;
            return some(line_str);
        }

        var fn read_lines() -> str[] {
            var lines = [];
            while !self.is_eof() {
                let next_l = self.read_line();
                if __opt_is_some(next_l) {
                    lines.append(__opt_unwrap(next_l));
                } else {
                    break;
                }
            }
            return lines;
        }

        // Zero-copy subview over the reader's `SliceBuffer<u8>` (`none` at byte EOF)
        var fn read_bytes(max_bytes: i64) -> any? {
            let total_b: i64 = len(self._bytes);
            if self._byte_pos >= total_b || max_bytes <= 0 {
                return none;
            }
            let count: i64 = min(max_bytes, total_b - self._byte_pos);
            let view = __slice_subview(self._bytes, self._byte_pos, count);
            self._byte_pos = self._byte_pos + count;
            return some(view);
        }

        var fn read_remaining() -> str {
            let total: i64 = len(self._text);
            if self._char_pos >= total {
                return "";
            }
            let rem = self._text[self._char_pos..total];
            self._char_pos = total;
            return rem;
        }
}

pub fn open_reader(path: str) -> BufferedReader ! IoError {
    let raw_res = __fs_read_text(path);
    if __result_is_err(raw_res) {
        return fail(__result_unwrap_err(raw_res));
    }
    return ok(BufferedReader(__result_unwrap_ok(raw_res), path));
}

pub fn reader_from_string(content: str) -> BufferedReader {
    return BufferedReader(content, "<string>");
}

// Fallible (`! IoError`) buffered file writer (participates in `fn!?(...)` CoW shadow dry-runs!)
pub struct BufferedWriter : IValue {
    pub:
        target_path:   str;
        append_mode:   bool;
        _buffer:       StringBuffer;
        _flushed_once: bool;
        _closed:       bool;

        self(target_path: str, append_mode: bool = false) {
            .target_path = target_path;
            .append_mode = append_mode;
            ._buffer = StringBuffer("");
            ._flushed_once = false;
            ._closed = false;
        }

        fn buffered_len() -> i64 {
            return self._buffer.len();
        }

        var fn write(text: str) {
            if self._closed {
                panic("BufferedWriter.write called on closed writer");
            }
            self._buffer.write(text);
        }

        var fn write_line(line: str = "") {
            self.write(line + "\n");
        }

        var fn flush() -> i64 ! IoError {
            if self._buffer.is_empty() && self._flushed_once {
                return ok(0);
            }
            let payload = self._buffer.to_str();
            let should_append: bool = self.append_mode || self._flushed_once;
            let write_res = __fs_write_text(self.target_path, payload, should_append);
            if __result_is_err(write_res) {
                return fail(__result_unwrap_err(write_res));
            }
            self._buffer.clear();
            self._flushed_once = true;
            return ok(__result_unwrap_ok(write_res));
        }

        var fn close() -> i64 ! IoError {
            if self._closed {
                return ok(0);
            }
            let flushed = self.flush()?;
            self._closed = true;
            return ok(flushed);
        }
}

pub fn open_writer(path: str, append_mode: bool = false) -> BufferedWriter ! IoError {
    if len(path) == 0 {
        return fail(IoError.InvalidPath("empty path"));
    }
    return ok(BufferedWriter(path, append_mode));
}
