// std.path — Cross-Platform Lexical Path Manipulation (PSF-2.0 CPython posixpath/pathlib scaffold)

pub pkg Pilot.Io.Path;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __os_is_windows() -> bool;
    fn __dfa_is_match(pattern: any, text: str) -> bool;
}

pub fn separator() -> str {
    if __os_is_windows() {
        return "\\";
    }
    return "/";
}

fn _to_slashes(raw: str) -> str {
    return raw.replace("\\", "/");
}

fn _has_windows_drive(clean: str) -> bool {
    if len(clean) < 2 {
        return false;
    }
    let c0: i64 = clean.char_code_at(0);
    let c1: i64 = clean.char_code_at(1);
    let is_alpha: bool = (c0 >= 65 && c0 <= 90) || (c0 >= 97 && c0 <= 122);
    return is_alpha && c1 == 58;
}

pub fn is_absolute(raw_path: str) -> bool {
    let s = _to_slashes(raw_path);
    if len(s) == 0 {
        return false;
    }
    if s[0..1] == "/" {
        return true;
    }
    if _has_windows_drive(s) {
        if len(s) == 2 {
            return true;
        }
        return s[2..3] == "/";
    }
    return false;
}

pub fn normalize(raw_path: str) -> str {
    let slashed = _to_slashes(raw_path);
    if len(slashed) == 0 {
        return ".";
    }

    var prefix: str = "";
    var rest: str = slashed;

    if _has_windows_drive(slashed) {
        prefix = slashed[0..2];
        rest = slashed[2..len(slashed)];
        if len(rest) > 0 && rest[0..1] == "/" {
            prefix = prefix + "/";
            rest = rest[1..len(rest)];
        }
    } else if slashed[0..1] == "/" {
        prefix = "/";
        rest = slashed[1..len(slashed)];
    }

    let raw_parts = rest.split("/");
    var stack = [];
    let rooted: bool = len(prefix) > 0 && prefix[(len(prefix) - 1)..len(prefix)] == "/";

    for seg in raw_parts {
        if len(seg) == 0 || seg == "." {
            continue;
        }
        if seg == ".." {
            let n: i64 = len(stack);
            if n > 0 && stack[n - 1] != ".." {
                stack.remove_at(n - 1);
            } else if !rooted {
                stack.append("..");
            }
        } else {
            stack.append(seg);
        }
    }

    var joined: str = "";
    for i in 0..<len(stack) {
        if i > 0 {
            joined = joined + "/";
        }
        joined = joined + stack[i];
    }

    if len(prefix) > 0 {
        if len(joined) == 0 {
            return prefix;
        }
        return prefix + joined;
    }

    if len(joined) == 0 {
        return ".";
    }
    return joined;
}

pub fn join(base_path: str, child_path: str) -> str {
    if len(child_path) == 0 {
        return normalize(base_path);
    }
    if is_absolute(child_path) {
        return normalize(child_path);
    }
    if len(base_path) == 0 || base_path == "." {
        return normalize(child_path);
    }
    let clean_base = _to_slashes(base_path);
    if clean_base[(len(clean_base) - 1)..len(clean_base)] == "/" {
        return normalize(clean_base + child_path);
    }
    return normalize(clean_base + "/" + child_path);
}

pub fn join_all(segments: any) -> str {
    var acc: str = "";
    for seg in segments {
        if len(acc) == 0 {
            acc = str(seg);
        } else {
            acc = join(acc, str(seg));
        }
    }
    if len(acc) == 0 {
        return ".";
    }
    return acc;
}

pub fn parent(raw_path: str) -> str? {
    let norm = normalize(raw_path);
    if norm == "/" || norm == "." {
        return none;
    }
    if _has_windows_drive(norm) && (len(norm) == 2 || len(norm) == 3) {
        return none;
    }
    let slash_idx: i64 = norm.last_index_of("/");
    if slash_idx < 0 {
        return some(".");
    }
    if slash_idx == 0 {
        return some("/");
    }
    if slash_idx == 2 && _has_windows_drive(norm) {
        return some(norm[0..3]);
    }
    return some(norm[0..slash_idx]);
}

pub fn file_name(raw_path: str) -> str? {
    let norm = normalize(raw_path);
    if norm == "/" || norm == "." {
        return none;
    }
    if _has_windows_drive(norm) && len(norm) <= 3 {
        return none;
    }
    let slash_idx: i64 = norm.last_index_of("/");
    if slash_idx < 0 {
        return some(norm);
    }
    let tail = norm[(slash_idx + 1)..len(norm)];
    if len(tail) == 0 {
        return none;
    }
    return some(tail);
}

pub fn extension(raw_path: str) -> str? {
    let fname_opt = file_name(raw_path);
    if __opt_is_none(fname_opt) {
        return none;
    }
    let fname = __opt_unwrap(fname_opt);
    let dot_idx: i64 = fname.last_index_of(".");
    if dot_idx <= 0 || dot_idx == len(fname) - 1 {
        return none;
    }
    return some(fname[(dot_idx + 1)..len(fname)]);
}

pub fn stem(raw_path: str) -> str? {
    let fname_opt = file_name(raw_path);
    if __opt_is_none(fname_opt) {
        return none;
    }
    let fname = __opt_unwrap(fname_opt);
    let dot_idx: i64 = fname.last_index_of(".");
    if dot_idx <= 0 {
        return some(fname);
    }
    return some(fname[0..dot_idx]);
}

pub fn with_extension(raw_path: str, new_ext: str) -> str {
    let par_opt = parent(raw_path);
    let st_opt = stem(raw_path);
    let base_stem = if __opt_is_some(st_opt) { __opt_unwrap(st_opt) } else { normalize(raw_path) };
    let clean_ext = if len(new_ext) > 0 && new_ext[0..1] == "." {
        new_ext[1..len(new_ext)]
    } else {
        new_ext
    };
    let updated_name = if len(clean_ext) > 0 { f"{base_stem}.{clean_ext}" } else { base_stem };
    if __opt_is_some(par_opt) {
        let p = __opt_unwrap(par_opt);
        if p == "." {
            return updated_name;
        }
        return join(p, updated_name);
    }
    return updated_name;
}

pub fn components(raw_path: str) -> str[] {
    let norm = normalize(raw_path);
    var out = [];
    var rest: str = norm;
    if _has_windows_drive(norm) {
        if len(norm) >= 3 && norm[2..3] == "/" {
            out.append(norm[0..3]);
            rest = norm[3..len(norm)];
        } else {
            out.append(norm[0..2]);
            rest = norm[2..len(norm)];
        }
    } else if norm[0..1] == "/" {
        out.append("/");
        rest = norm[1..len(norm)];
    }
    if len(rest) > 0 && rest != "." {
        for part in rest.split("/") {
            if len(part) > 0 {
                out.append(part);
            }
        }
    } else if norm == "." {
        out.append(".");
    }
    return out;
}

pub fn split_all(raw_path: str) -> str[] {
    return components(raw_path);
}

pub fn dirname(raw_path: str) -> str {
    let par_opt = parent(raw_path);
    if __opt_is_some(par_opt) {
        return __opt_unwrap(par_opt);
    }
    return normalize(raw_path);
}

pub fn basename(raw_path: str) -> str {
    let fname_opt = file_name(raw_path);
    if __opt_is_some(fname_opt) {
        return __opt_unwrap(fname_opt);
    }
    return "";
}

pub fn splitext(raw_path: str) -> str[] {
    let norm = _to_slashes(raw_path);
    let slash_idx: i64 = norm.last_index_of("/");
    let dot_idx: i64 = norm.last_index_of(".");
    if dot_idx <= slash_idx + 1 || dot_idx == len(norm) - 1 {
        return [norm, ""];
    }
    return [norm[0..dot_idx], norm[dot_idx..len(norm)]];
}

pub fn relative_to(target_path: str, base_path: str) -> str? {
    let norm_t = normalize(target_path);
    let norm_b = normalize(base_path);
    if norm_t == norm_b {
        return some(".");
    }
    let prefix = if norm_b == "/" { "/" } else { norm_b + "/" };
    if len(norm_t) > len(prefix) && norm_t[0..len(prefix)] == prefix {
        return some(norm_t[len(prefix)..len(norm_t)]);
    }
    return none;
}

pub fn relpath(target_path: str, base_path: str = ".") -> str {
    let rel_opt = relative_to(target_path, base_path);
    if __opt_is_some(rel_opt) {
        return __opt_unwrap(rel_opt);
    }
    return normalize(target_path);
}

pub fn glob_match(pattern: str, name_str: str) -> bool {
    var dfa_pat: str = "^";
    let n: i64 = len(pattern);
    var i: i64 = 0;
    while i < n {
        let ch = pattern[i..(i + 1)];
        if ch == "*" {
            dfa_pat = dfa_pat + ".*";
        } else if ch == "?" {
            dfa_pat = dfa_pat + ".";
        } else if ch == "." || ch == "+" || ch == "(" || ch == ")" || ch == "^" || ch == "$" || ch == "|" || ch == "\\" {
            dfa_pat = dfa_pat + "\\" + ch;
        } else if ch == "[" {
            var j: i64 = i + 1;
            if j < n && pattern[j..(j + 1)] == "!" {
                j = j + 1;
            }
            if j < n && pattern[j..(j + 1)] == "]" {
                j = j + 1;
            }
            while j < n && pattern[j..(j + 1)] != "]" {
                j = j + 1;
            }
            if j >= n {
                dfa_pat = dfa_pat + "\\[";
            } else {
                var inner = pattern[(i + 1)..j];
                if len(inner) > 0 && inner[0..1] == "!" {
                    inner = "^" + inner[1..len(inner)];
                }
                dfa_pat = dfa_pat + "[" + inner + "]";
                i = j;
            }
        } else {
            dfa_pat = dfa_pat + ch;
        }
        i = i + 1;
    }
    dfa_pat = dfa_pat + "$";
    return __dfa_is_match(dfa_pat, name_str);
}

// Object-oriented cross-platform `Path` value wrapper
pub struct Path : IValue {
    pub:
        raw: str;

        self(raw_path: str) {
            .raw = normalize(raw_path);
        }

        fn to_str() -> str {
            return self.raw;
        }

        fn is_absolute() -> bool {
            return is_absolute(self.raw);
        }

        fn join(child: str) -> Path {
            return Path(join(self.raw, child));
        }

        fn parent() -> Path? {
            let p = parent(self.raw);
            if __opt_is_some(p) {
                return some(Path(__opt_unwrap(p)));
            }
            return none;
        }

        fn file_name() -> str? {
            return file_name(self.raw);
        }

        fn stem() -> str? {
            return stem(self.raw);
        }

        fn extension() -> str? {
            return extension(self.raw);
        }

        fn with_extension(ext: str) -> Path {
            return Path(with_extension(self.raw, ext));
        }

        fn components() -> str[] {
            return components(self.raw);
        }
}
