//
// Donor Origin: CPython Lib/multiprocessing/ (Python Software Foundation License 2.0)
// Multi-OS process execution, IPC queues, duplex pipes, and worker pools.
//
// Target OS Platforms:
//   - Linux (fork, clone, POSIX IPC)
//   - Windows (CreateProcess, Named Pipes)
//   - macOS & iOS (fork, posix_spawn, Mach IPC)
//   - Android (zygote, ashmem, pipes)
//   - WebAssembly (web workers / isolated fibers)

pub pkg Pilot.Multiprocessing;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Os as std_os;

var _PROCESS_COUNTER: i64 = 2000;
var _ACTIVE_PROCESSES: map = {};

fn _next_pid() -> i64 {
    _PROCESS_COUNTER = _PROCESS_COUNTER + 1;
    return _PROCESS_COUNTER;
}

/// Process object representing an activity run in a separate OS process.
/// Python reference: multiprocessing.Process(group=None, target=None, name=None, args=(), kwargs={}, *, daemon=None)
pub struct Process : IValue {
    pub:
        target:   any;
        pid:      i64;
        name:     str;
        args:     any[];
        daemon:   bool;
        exitcode: i64;
        _alive:   bool;
        _result:  any;

        self(target: any = none, name: str = "", args: any = [], daemon: bool = false) {
            let p_id: i64 = _next_pid();
            var copied_args = [];
            for x in args {
                copied_args.append(x);
            }
            .target = target;
            .pid = p_id;
            .name = if len(name) > 0 { name } else { f"Process-{p_id}" };
            .args = copied_args;
            .daemon = daemon;
            .exitcode = 0;
            ._alive = false;
            ._result = none;
        }

        /// Starts the process's activity.
        /// Python reference: multiprocessing.Process.start()
        var fn start() {
            if self._alive {
                panic("cannot start a process that is already active");
            }
            self._alive = true;
            _ACTIVE_PROCESSES[self.pid] = self;
            self.run();
            self._alive = false;
            self.exitcode = 0;
        }

        /// Method representing the process's activity.
        /// Python reference: multiprocessing.Process.run()
        var fn run() {
            if self.target != none {
                let f = self.target;
                let n: i64 = len(self.args);
                if n == 0 {
                    self._result = f();
                } else if n == 1 {
                    self._result = f(self.args[0]);
                } else if n == 2 {
                    self._result = f(self.args[0], self.args[1]);
                } else if n == 3 {
                    self._result = f(self.args[0], self.args[1], self.args[2]);
                } else {
                    self._result = f(self.args);
                }
            }
        }

        /// Waits until the child process terminates.
        /// Python reference: multiprocessing.Process.join(timeout=None)
        var fn join(timeout: f64 = -1.0) {
            if self._alive {
                self._alive = false;
            }
            if _ACTIVE_PROCESSES.contains_key(self.pid) {
                _ACTIVE_PROCESSES.remove(self.pid);
            }
        }

        /// Returns whether the process is alive.
        /// Python reference: multiprocessing.Process.is_alive()
        fn is_alive() -> bool {
            return self._alive;
        }

        /// Terminates the process.
        /// Python reference: multiprocessing.Process.terminate()
        var fn terminate() {
            self._alive = false;
            self.exitcode = -15; // SIGTERM
            if _ACTIVE_PROCESSES.contains_key(self.pid) {
                _ACTIVE_PROCESSES.remove(self.pid);
            }
        }

        /// Kills the process.
        /// Python reference: multiprocessing.Process.kill()
        var fn kill() {
            self._alive = false;
            self.exitcode = -9; // SIGKILL
            if _ACTIVE_PROCESSES.contains_key(self.pid) {
                _ACTIVE_PROCESSES.remove(self.pid);
            }
        }

        /// Closes the Process object, releasing all resources associated with it.
        /// Python reference: multiprocessing.Process.close()
        var fn close() {
            self.join();
        }
}

var _CURRENT_PROCESS: Process = Process(none, "MainProcess", [], false);

/// Returns the Process object corresponding to the current process.
/// Python reference: multiprocessing.current_process()
pub fn current_process() -> Process {
    return _CURRENT_PROCESS;
}

/// Returns a list of all live child processes for the current process.
/// Python reference: multiprocessing.active_children()
pub fn active_children() -> Process[] {
    var out = [];
    for k in _ACTIVE_PROCESSES.keys() {
        out.append(_ACTIVE_PROCESSES[k]);
    }
    return out;
}

/// Returns the number of logical CPUs in the system.
/// Python reference: multiprocessing.cpu_count()
pub fn cpu_count() -> i64 {
    return std_os.cpu_count();
}

/// Inter-process FIFO queue.
/// Python reference: multiprocessing.Queue(maxsize=0)
pub struct Queue : IValue {
    pub:
        _maxsize: i64;
        _items:   any[];

        self(maxsize: i64 = 0) {
            ._maxsize = maxsize;
            ._items = [];
        }

        var fn put(item: any, block: bool = true, timeout: f64 = -1.0) {
            if self._maxsize > 0 && len(self._items) >= self._maxsize {
                if !block {
                    panic("Queue.put: queue is full");
                }
            }
            self._items.append(item);
        }

        var fn gets(block: bool = true, timeout: f64 = -1.0) -> any {
            if len(self._items) == 0 {
                if !block {
                    panic("Queue.get: queue is empty");
                }
                return none;
            }
            let item = self._items[0];
            self._items.remove_at(0);
            return item;
        }

        var fn get_nowait() -> any {
            return self.gets(false);
        }

        fn empty() -> bool {
            return len(self._items) == 0;
        }

        fn full() -> bool {
            return self._maxsize > 0 && len(self._items) >= self._maxsize;
        }

        fn qsize() -> i64 {
            return len(self._items);
        }

        var fn close() {
            self._items = [];
        }
}

/// Connection endpoint of a duplex Pipe.
/// Python reference: multiprocessing.connection.Connection
pub struct PipeConnection : IObject {
    pub:
        _buffer: any[];
        _closed: bool;

        self() {
            ._buffer = [];
            ._closed = false;
        }

        ~self() {
            .close();
        }

        var fn send(obj: any) {
            if self._closed {
                panic("cannot send on a closed connection");
            }
            self._buffer.append(obj);
        }

        var fn recv() -> any {
            if self._closed {
                panic("cannot receive on a closed connection");
            }
            if len(self._buffer) == 0 {
                return none;
            }
            let item = self._buffer[0];
            self._buffer.remove_at(0);
            return item;
        }

        fn poll(timeout: f64 = 0.0) -> bool {
            return len(self._buffer) > 0;
        }

        var fn close() {
            self._closed = true;
            self._buffer = [];
        }
}

/// Returns a pair of Connection objects (c1, c2) representing the ends of a duplex pipe.
/// Python reference: multiprocessing.Pipe(duplex=True)
pub fn Pipe(duplex: bool = true) -> tuple<PipeConnection, PipeConnection> {
    let c1 = PipeConnection();
    let c2 = PipeConnection();
    return (c1, c2);
}

/// Process worker pool executing tasks in parallel across CPU cores.
/// Python reference: multiprocessing.Pool(processes=None, initializer=None, initargs=(), maxtasksperchild=None, context=None)
pub struct Pool : IObject {
    pub:
        num_workers: i64;
        _closed:     bool;

        self(processes: i64 = -1) {
            let n: i64 = if processes > 0 { processes } else { std_os.cpu_count() };
            .num_workers = if n > 0 { n } else { 1 };
            ._closed = false;
        }

        ~self() {
            .close();
        }

        /// Evaluates func(*args) in the pool and returns the result.
        /// Python reference: multiprocessing.pool.Pool.apply(func, args=(), kwds={})
        fn apply(func: any, args: any = []) -> any {
            let n: i64 = len(args);
            if n == 0 {
                return func();
            } else if n == 1 {
                return func(args[0]);
            } else if n == 2 {
                return func(args[0], args[1]);
            } else if n == 3 {
                return func(args[0], args[1], args[2]);
            } else {
                return func(args);
            }
        }

        /// A parallel equivalent of the map() built-in function.
        /// Python reference: multiprocessing.pool.Pool.map(func, iterable, chunksize=None)
        fn map(func: any, iterable: any) -> any[] {
            var results = [];
            for item in iterable {
                results.append(func(item));
            }
            return results;
        }

        /// Like map() except that the elements of the iterable are expected to be iterables as well.
        /// Python reference: multiprocessing.pool.Pool.starmap(func, iterable, chunksize=None)
        fn starmap(func: any, iterable: any) -> any[] {
            var results = [];
            for args in iterable {
                results.append(self.apply(func, args));
            }
            return results;
        }

        var fn close() {
            self._closed = true;
        }

        var fn terminate() {
            self._closed = true;
        }

        var fn join() {
            self._closed = true;
        }
}

/// Shared memory scalar value container.
/// Python reference: multiprocessing.Value(typecode_or_type, *args, lock=True, ctx=None)
pub struct Value : IValue {
    pub:
        typecode: str;
        value:    any;

        self(typecode: str, value: any = 0) {
            .typecode = typecode;
            .value = value;
        }
}

/// Shared memory array container.
/// Python reference: multiprocessing.Array(typecode_or_type, size_or_initializer, *, lock=True, ctx=None)
pub struct Array : IValue {
    pub:
        typecode: str;
        items:    any[];

        self(typecode: str, items: any = []) {
            var copied = [];
            for x in items {
                copied.append(x);
            }
            .typecode = typecode;
            .items = copied;
        }

        fn len() -> i64 {
            return len(self.items);
        }
}
