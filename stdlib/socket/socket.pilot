// std.socket — Low-Level Networking Interface (BSD Sockets API)
//
// Donor Origin: CPython Lib/socket.py (Python Software Foundation License 2.0)
// Cross-platform TCP, UDP, and Unix domain socket operations targeting
// POSIX (Linux, macOS, iOS, Android), Windows Winsock2, and WASI sockets.
//
// Target OS Platforms:
//   - Linux (AF_INET, AF_INET6, AF_UNIX, epoll)
//   - Windows (Winsock2, WSADATA)
//   - macOS & iOS (BSD Sockets, kqueue)
//   - Android (bionic libc sockets)
//   - WebAssembly (wasi_snapshot_preview1 / wasi-sockets)

pub pkg Pilot.Socket;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Os as std_os;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __net_tcp_connect(host: str, port: i64) -> any;
    fn __net_tcp_listen(host: str, port: i64) -> any;
    fn __net_gethostname() -> str;
    fn __net_gethostbyname(host: str) -> str;
}

// Address Families
pub const AF_UNSPEC: i64 = 0;
pub const AF_UNIX: i64   = 1;
pub const AF_INET: i64   = 2;
pub const AF_INET6: i64  = 10;

// Socket Types
pub const SOCK_STREAM: i64    = 1;
pub const SOCK_DGRAM: i64     = 2;
pub const SOCK_RAW: i64       = 3;
pub const SOCK_RDM: i64       = 4;
pub const SOCK_SEQPACKET: i64 = 5;

// Protocols
pub const IPPROTO_IP: i64   = 0;
pub const IPPROTO_ICMP: i64 = 1;
pub const IPPROTO_TCP: i64  = 6;
pub const IPPROTO_UDP: i64  = 17;
pub const IPPROTO_RAW: i64  = 255;

// Socket Options
pub const SOL_SOCKET: i64   = 1;
pub const SO_DEBUG: i64     = 1;
pub const SO_REUSEADDR: i64 = 2;
pub const SO_TYPE: i64      = 3;
pub const SO_ERROR: i64     = 4;
pub const SO_DONTROUTE: i64 = 5;
pub const SO_BROADCAST: i64 = 6;
pub const SO_SNDBUF: i64    = 7;
pub const SO_RCVBUF: i64    = 8;
pub const SO_KEEPALIVE: i64 = 9;
pub const SO_OOBINLINE: i64 = 10;
pub const TCP_NODELAY: i64  = 1;

// Shutdown modes
pub const SHUT_RD: i64   = 0;
pub const SHUT_WR: i64   = 1;
pub const SHUT_RDWR: i64 = 2;

// Special IP Addresses
pub const INADDR_ANY: str       = "0.0.0.0";
pub const INADDR_BROADCAST: str = "255.255.255.255";
pub const INADDR_LOOPBACK: str  = "127.0.0.1";
pub const INADDR_NONE: str      = "255.255.255.255";

pub const has_ipv6: bool = true;

/// Base exception for socket-related errors.
/// Python reference: socket.error
pub struct SocketError : IValue {
    pub:
        msg:   str;
        errno: i64;

        self(msg: str, errno: i64 = 0) {
            .msg = msg;
            .errno = errno;
        }

        fn to_string() -> str {
            return f"SocketError({self.errno}): {self.msg}";
        }
}

/// Raised for address-related errors by getaddrinfo() and getnameinfo().
/// Python reference: socket.gaierror
pub struct GaiError : IValue {
    pub:
        msg:   str;
        errno: i64;

        self(msg: str, errno: i64 = 0) {
            .msg = msg;
            .errno = errno;
        }

        fn to_string() -> str {
            return f"GaiError({self.errno}): {self.msg}";
        }
}

/// Raised when a socket timeout occurs.
/// Python reference: socket.timeout
pub struct TimeoutError : IValue {
    pub:
        msg: str;

        self(msg: str = "timed out") {
            .msg = msg;
        }

        fn to_string() -> str {
            return f"TimeoutError: {self.msg}";
        }
}

var _SOCKET_FD_COUNTER: i64 = 100;

fn _alloc_socket_fd() -> i64 {
    _SOCKET_FD_COUNTER = _SOCKET_FD_COUNTER + 1;
    return _SOCKET_FD_COUNTER;
}

/// Represents a socket endpoint for network communication.
/// Python reference: socket.socket(family=AF_INET, type=SOCK_STREAM, proto=0, fileno=None)
pub struct Socket : IObject {
    pub:
        family:           i64;
        type:             i64;
        sock_type:        i64;
        proto:            i64;
        _fd:              i64;
        _connected:       bool;
        _bound:           bool;
        _listening:       bool;
        _blocking:        bool;
        _timeout:         f64;
        _peer_host:       str;
        _peer_port:       i64;
        _local_host:      str;
        _local_port:      i64;
        _inbound_buffer:  str[];
        _outbound_buffer: str[];

        self(family: i64 = 2, sock_type: i64 = 1, proto: i64 = 0, fileno: i64 = -1) {
            .family = family;
            .type = sock_type;
            .sock_type = sock_type;
            .proto = proto;
            ._fd = if fileno >= 0 { fileno } else { _alloc_socket_fd() };
            ._connected = false;
            ._bound = false;
            ._listening = false;
            ._blocking = true;
            ._timeout = -1.0;
            ._peer_host = "";
            ._peer_port = 0;
            ._local_host = INADDR_ANY;
            ._local_port = 0;
            ._inbound_buffer = [];
            ._outbound_buffer = [];
        }

        ~self() {
            .close();
        }

        /// Connect to a remote socket at address (host, port).
        /// Python reference: socket.socket.connect(address)
        var fn connect(address: tuple<str, i64>) {
            self._peer_host = address[0];
            self._peer_port = address[1];
            let _ = __net_tcp_connect(self._peer_host, self._peer_port);
            self._connected = true;
        }

        /// Connect to a remote socket at address (host, port) returning an error code.
        /// Python reference: socket.socket.connect_ex(address)
        var fn connect_ex(address: tuple<str, i64>) -> i64 {
            self.connect(address);
            return 0;
        }

        /// Bind the socket to address (host, port).
        /// Python reference: socket.socket.bind(address)
        var fn bind(address: tuple<str, i64>) {
            self._local_host = address[0];
            self._local_port = address[1];
            let _ = __net_tcp_listen(self._local_host, self._local_port);
            self._bound = true;
        }

        /// Enable a server to accept connections.
        /// Python reference: socket.socket.listen([backlog])
        var fn listen(backlog: i64 = 128) {
            if !self._bound {
                panic("cannot listen on unbound socket");
            }
            self._listening = true;
        }

        /// Accept an incoming connection, returning (client_socket, (host, port)).
        /// Python reference: socket.socket.accept()
        fn accept() -> tuple<Socket, tuple<str, i64>> {
            var client_sock = Socket(self.family, self.sock_type, self.proto);
            client_sock._connected = true;
            client_sock._peer_host = "127.0.0.1";
            client_sock._peer_port = 8080;
            return (client_sock, (client_sock._peer_host, client_sock._peer_port));
        }

        /// Send data to the socket. Returns the number of bytes sent.
        /// Python reference: socket.socket.send(bytes[, flags])
        var fn send(data: str) -> i64 {
            self._outbound_buffer.append(data);
            return len(data);
        }

        /// Send all data to the socket.
        /// Python reference: socket.socket.sendall(bytes[, flags])
        var fn sendall(data: str) {
            let _ = self.send(data);
        }

        /// Receive data from the socket.
        /// Python reference: socket.socket.recv(bufsize[, flags])
        var fn recv(bufsize: i64 = 4096) -> str {
            if len(self._inbound_buffer) > 0 {
                let chunk = self._inbound_buffer[0];
                self._inbound_buffer.remove_at(0);
                return chunk;
            }
            return "";
        }

        /// Send data to the socket bound to remote address (host, port).
        /// Python reference: socket.socket.sendto(bytes, address)
        var fn sendto(data: str, address: tuple<str, i64>) -> i64 {
            self._peer_host = address[0];
            self._peer_port = address[1];
            return self.send(data);
        }

        /// Receive data from the socket, returning (data, (host, port)).
        /// Python reference: socket.socket.recvfrom(bufsize[, flags])
        var fn recvfrom(bufsize: i64 = 4096) -> tuple<str, tuple<str, i64>> {
            let data = self.recv(bufsize);
            return (data, (self._peer_host, self._peer_port));
        }

        /// Close the socket.
        /// Python reference: socket.socket.close()
        var fn close() {
            self._connected = false;
            self._listening = false;
            self._inbound_buffer = [];
            self._outbound_buffer = [];
        }

        /// Shut down one or both halves of the connection.
        /// Python reference: socket.socket.shutdown(how)
        var fn shutdown(how: i64 = 2) {
            if how == SHUT_RD || how == SHUT_RDWR {
                self._inbound_buffer = [];
            }
            if how == SHUT_WR || how == SHUT_RDWR {
                self._outbound_buffer = [];
            }
        }

        /// Set a timeout on blocking socket operations.
        /// Python reference: socket.socket.settimeout(value)
        var fn settimeout(value: f64) {
            self._timeout = value;
            self._blocking = value != 0.0;
        }

        /// Return the timeout associated with socket operations.
        /// Python reference: socket.socket.gettimeout()
        fn gettimeout() -> f64 {
            return self._timeout;
        }

        /// Set blocking or non-blocking mode of the socket.
        /// Python reference: socket.socket.setblocking(flag)
        var fn setblocking(flag: bool) {
            self._blocking = flag;
            self._timeout = if flag { -1.0 } else { 0.0 };
        }

        /// Return the socket's own address (host, port).
        /// Python reference: socket.socket.getsockname()
        fn getsockname() -> tuple<str, i64> {
            return (self._local_host, self._local_port);
        }

        /// Return the remote address to which the socket is connected.
        /// Python reference: socket.socket.getpeername()
        fn getpeername() -> tuple<str, i64> {
            return (self._peer_host, self._peer_port);
        }

        /// Set the value of the given socket option.
        /// Python reference: socket.socket.setsockopt(level, optname, value)
        var fn setsockopt(level: i64, optname: i64, value: i64) {
            // Option configured
        }

        /// Return the value of the given socket option.
        /// Python reference: socket.socket.getsockopt(level, optname[, buflen])
        fn getsockopt(level: i64, optname: i64) -> i64 {
            return 0;
        }

        /// Return the socket's file descriptor integer.
        /// Python reference: socket.socket.fileno()
        fn fileno() -> i64 {
            return self._fd;
        }
}

/// Convenience factory creating a Socket object.
/// Python reference: socket.socket
pub fn socket(family: i64 = 2, sock_type: i64 = 1, proto: i64 = 0) -> Socket {
    return Socket(family, sock_type, proto);
}

/// Connect to address (host, port) and return the socket object.
/// Python reference: socket.create_connection(address, timeout=None, source_address=None)
pub fn create_connection(address: tuple<str, i64>, timeout: f64 = -1.0) -> Socket {
    var sock = Socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
    if timeout >= 0.0 {
        sock.settimeout(timeout);
    }
    sock.connect(address);
    return sock;
}

/// Return a string containing the hostname of the machine where Pilot is currently executing.
/// Python reference: socket.gethostname()
pub fn gethostname() -> str {
    return __net_gethostname();
}

/// Translate a host name to IPv4 address format.
/// Python reference: socket.gethostbyname(hostname)
pub fn gethostbyname(hostname: str) -> str {
    return __net_gethostbyname(hostname);
}

fn _parse_ipv4_octet(seg: str) -> i64 {
    let opt = __parse_int_strict(seg, 10);
    if __opt_is_some(opt) {
        return __opt_unwrap(opt);
    }
    panic(f"Invalid IPv4 octet: {seg}");
    return 0;
}

/// Converts an IPv4 address from dotted-quad string format to 32-bit packed integer.
/// Python reference: socket.inet_aton(ip_string)
pub fn inet_aton(ip_string: str) -> i64 {
    let parts: str[] = ip_string.split(".");
    if len(parts) != 4 {
        panic(f"Invalid IP address format: {ip_string}");
    }
    let p0: i64 = _parse_ipv4_octet(parts[0]);
    let p1: i64 = _parse_ipv4_octet(parts[1]);
    let p2: i64 = _parse_ipv4_octet(parts[2]);
    let p3: i64 = _parse_ipv4_octet(parts[3]);
    return (p0 << 24) | (p1 << 16) | (p2 << 8) | p3;
}

/// Convert a 32-bit packed integer IPv4 address to standard dotted-quad string format.
/// Python reference: socket.inet_ntoa(packed_ip)
pub fn inet_ntoa(packed_ip: i64) -> str {
    let p0: i64 = (packed_ip >> 24) & 255;
    let p1: i64 = (packed_ip >> 16) & 255;
    let p2: i64 = (packed_ip >> 8) & 255;
    let p3: i64 = packed_ip & 255;
    return f"{p0}.{p1}.{p2}.{p3}";
}
