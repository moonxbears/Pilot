            b1:      1,
            b8:      8,
            b16:     16,
            b32:     32,
            b64:     64,
            b128:    128,
        },

        // 5. 2-Bit Hardware Type Lattice Masks
        Lattice = {
            value:     0b00,
            reference: 0b01,
            object:    0b10,
            guard:     0b11,
        },

        // 6. Core Modifier, Keyword & Clearance Ring Constants
        Tokens = {
            attr_lang:    "Lang",
            attr_bits:    "Bits",
            attr_layout:  "Layout",
            attr_inline:  "Inline",
            attr_lattice: "Lattice",
            attr_naming:  "EnforceCoreNaming",
            attr_syntax:  "SyntaxMacro",

            vis_priv:     "priv",
            vis_file:     "file",
            vis_prot:     "prot",
            vis_pkg:      "pkg",
            vis_int:      "int",
            vis_pub:      "pub",
            vis_open:     "open",
            vis_export:   "export",

            mod_pure:     "pure",
            mod_static:   "static",
            mod_const:    "const",
            mod_var:      "var",
            mod_iso:      "iso",
            mod_partial:  "partial",
