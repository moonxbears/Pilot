// =========================================================================
// FILE: stdlib/core/core.pilot
// STAGE 1 SELF-GENESIS BOOTSTRAP
// At Line 1, strictly the 14 Rust seed tokens exist:
//   __engine, struct, interface, fn, let, ref, if, loop,
//   return, yield, defer, comptime, quote, asm
// Everything else in Pilot is birthed from `Cfg` below.
// =========================================================================
comptime {
    let Cfg = {
        // 1. Private Rust `__engine(...)` Callback Hook Names (30 Hooks)
        Hooks = {
            bind_attr:    "register_bracket_attribute",
            bind_lang:    "bind_lang_item",
            reg_layout:   "set_register_layout",
            mem_layout:   "set_memory_layout",
            pratt_op:     "register_pratt_op",
            inline_hint:  "set_inline_hint",
            syntax_kw:    "register_syntax_keyword",
            modifier:     "register_modifier",
            param_mod:    "register_parametric_modifier",
            module_kw:    "register_module_kw",
            receiver_id:  "bind_receiver_ident",
            jmp_exit:     "cfg_jump_loop_exit",
            jmp_head:     "cfg_jump_loop_head",
            decl_op:      "decl_operator_fn",
            ssa_binop:    "emit_ssa_binop",
            ssa_unop:     "emit_ssa_unop",
            ssa_cast:     "emit_ssa_cast",
            ssa_load:     "emit_ssa_load",
            ssa_store:    "emit_ssa_store",
            ssa_gep:      "emit_ssa_gep",
            is_comptime:  "query_is_comptime_vm",
            t_sizeof:     "type_sizeof",
            t_alignof:    "type_alignof",
            t_offsetof:   "type_offsetof",
            t_fields:     "type_fields_of",
            diag_err:     "emit_diagnostic_error",
            lattice_bind: "bind_lattice_kind",
            lattice_get:  "get_lattice_bits",
            core_naming:  "enforce_core_naming_lint",
            seal_bridge:  "seal_bootstrap_bridge",
        },

        // 2. Canonical `[Lang("...")]` Identifiers (Exported to `stdlib/core/*`)
        Lang = {
            any_t:    "IAnyValue",
            val_t:    "IValue",
            ref_t:    "IReference",
            obj_t:    "IObject",
            guard_t:  "IGuard",
            void_t:   "void",
            never_t:  "never",
            bool_t:   "bool",
            char_t:   "char",
            i8_t:     "i8",
            i16_t:    "i16",
            i32_t:    "i32",
            i64_t:    "i64",
            i128_t:   "i128",
            isize_t:  "isize",
            u8_t:     "u8",
            u16_t:    "u16",
            u32_t:    "u32",
            u64_t:    "u64",
            u128_t:   "u128",
            usize_t:  "usize",
            f16_t:    "f16",
            f32_t:    "f32",
            f64_t:    "f64",
            f128_t:   "f128",
            str_t:    "str",
            ptr_t:    "ptr",
            slice_t:  "slice",
            stride_t: "stride",
            array_t:  "array",
            tuple_t:  "tuple",
            opt_t:    "option",
            res_t:    "result",
            union_t:  "union",
            fn_t:     "fn",
            range_t:  "range",
            span_t:   "span",
            step_t:   "step",
            from_t:   "from",
            until_t:  "until",
            full_t:   "full",
            splat_t:  "splat",
            pairs_t:  "pairs",
            expand_t: "expand",
            map_t:    "map",
            frame_t:  "frame",
            type_t:   "type",
            ast_t:    "ast",
        },

        // 3. Backend SSA Instruction Opcodes
        Ssa = {
            add:     "add",
            sub:     "sub",
            mul:     "mul",
            sdiv:    "sdiv",
            udiv:    "udiv",
            srem:    "srem",
            urem:    "urem",
            fadd:    "fadd",
            fsub:    "fsub",
            fmul:    "fmul",
            fdiv:    "fdiv",
            and_b:   "and",
            or_b:    "or",
            xor_b:   "xor",
            shl:     "shl",
            lshr:    "lshr",
            ashr:    "ashr",
            eq:      "eq",
            ne:      "ne",
            ult:     "ult",
            ule:     "ule",
            ugt:     "ugt",
            uge:     "uge",
            slt:     "slt",
            sle:     "sle",
            sgt:     "sgt",
            sge:     "sge",
            flt:     "flt",
            fle:     "fle",
            feq:     "feq",
            neg:     "neg",
            fneg:    "fneg",
            not_b:   "not",
            bitnot:  "bitnot",
            zext:    "zext",
            sext:    "sext",
            trunc:   "trunc",
            bitcast: "bitcast",
            sitofp:  "sitofp",
            uitofp:  "uitofp",
            fptosi:  "fptosi",
            fptoui:  "fptoui",
        },

        // 4. Hardware Register Classes & Bit Widths
        Reg = {
            gpr_u:   gpr_unsigned,
            gpr_s:   gpr_signed,
            simd_f:  simd_float,
            raw_ptr: raw_ptr,
            b0:      0,
            b8:      8,
            b16:     16,
            b32:     32,
            b64:     64,
            b128:    128,
        },

        // 5. 2-Bit Hardware Type Lattice Masks
        Lattice = {
            value:     0b00,
            reference: 0b01,
            object:    0b10,
            guard:     0b11,
        },

        // 6. Core Modifier, Keyword & Clearance Ring Constants
        Tokens = {
            attr_lang:    "Lang",
            attr_bits:    "Bits",
            attr_layout:  "Layout",
            attr_op:      "Operator",
            attr_inline:  "Inline",
            attr_lattice: "Lattice",
            attr_naming:  "EnforceCoreNaming",
            attr_syntax:  "SyntaxMacro",

            vis_priv:     "priv",
            vis_file:     "file",
            vis_pkg:      "pkg",
            vis_int:      "int",
            vis_pub:      "pub",
            vis_export:   "export",

            mod_pure:     "pure",
            mod_static:   "static",
            mod_const:    "const",
            mod_var:      "var",
            mod_iso:      "iso",
            mod_partial:  "partial",
            mod_ext:      "ext",

            act_pure:     "effect_pure",
            act_static:   "storage_static",
            act_const:    "binding_const",
            act_var:      "binding_mutable",
            act_iso:      "perceus_isolated",
            act_partial:  "merge_type_members",
            act_ext:      "extension_member",
            act_ring:     "set_clearance_ring",
            act_pkg:      "declare_package_scope",
            act_use:      "import_symbol_path",

            kw_syntax:    "syntax",
            kw_lvl:       "lvl",
            kw_pkg:       "pkg",
            kw_use:       "use",
            kw_self:      "self",

            ring_public:  0,
            ring_simd:    80,
            ring_kernel:  90,
            ring_genesis: 100,
        },

        // 7. Once-in-Genesis Pratt Operator Table Constants
        Ops = {
            fix_prefix:  prefix,
            fix_infix:   infix,
            fix_postfix: postfix,
            assoc_left:  left,
            assoc_right: right,
            assoc_none:  none,

            prec_coal:   10,
            prec_or:     15,
            prec_and:    20,
            prec_bitor:  30,
            prec_xor:    32,
            prec_bitand: 35,
            prec_range:  40,
            prec_eq:     45,
            prec_cmp:    50,
            prec_shift:  55,
            prec_add:    60,
            prec_mul:    70,
            prec_unary:  80,
            prec_splat:  90,
            prec_post:   95,

            sym_coal:    "??",
            sym_bitor:   "|",
            sym_xor:     "^",
            sym_bitand:  "&",
            sym_range:   "..",
            sym_span:    "..=",
            sym_eq:      "==",
            sym_ne:      "!=",
            sym_lt:      "<",
            sym_gt:      ">",
            sym_le:      "<=",
            sym_ge:      ">=",
            sym_shl:     "<<",
            sym_shr:     ">>",
            sym_add:     "+",
            sym_sub:     "-",
            sym_mul:     "*",
            sym_div:     "/",
            sym_rem:     "%",
            sym_not:     "!",
            sym_bitnot:  "~",
            sym_pairs:   "**",
            sym_expand:  "*..",
        },
    };
}

// =========================================================================
// STEP 1: DEFINE & BIND CORE `[...]` BRACKET ATTRIBUTES
// =========================================================================
comptime fn Lang(target_decl, item_name) =>
    __engine(Cfg.Hooks.bind_lang, target_decl, item_name);

comptime fn Bits(target_type, width, reg_class) =>
    __engine(Cfg.Hooks.reg_layout, target_type, width, reg_class);

comptime fn Layout(target_type, mode) =>
    __engine(Cfg.Hooks.mem_layout, target_type, mode);

comptime fn Operator(target_fn, fixity, prec, assoc) =>
    __engine(Cfg.Hooks.pratt_op, target_fn, fixity, prec, assoc);

comptime fn Inline(target_fn, mode) =>
    __engine(Cfg.Hooks.inline_hint, target_fn, mode);

comptime fn Lattice(target_iface, mask) =>
    __engine(Cfg.Hooks.lattice_bind, target_iface, mask);

comptime fn EnforceCoreNaming(target_pkg) =>
    __engine(Cfg.Hooks.core_naming, target_pkg);

comptime fn SyntaxMacro(transformer_fn, kw_token) =>
    __engine(Cfg.Hooks.syntax_kw, kw_token, transformer_fn);

comptime {
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_lang,    Lang);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_bits,    Bits);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_layout,  Layout);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_op,      Operator);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_inline,  Inline);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_lattice, Lattice);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_naming,  EnforceCoreNaming);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_syntax,  SyntaxMacro);
}

// =========================================================================
// STEP 2: SELF-BOOTSTRAP THE `syntax` KEYWORD
// =========================================================================
[SyntaxMacro(Cfg.Tokens.kw_syntax)]
comptime fn __bootstrap_syntax(kw_name, params, body) => quote {
    [SyntaxMacro($kw_name)]
    comptime fn __syntax_rule($params) { $body }
};

// =========================================================================
// STEP 3: REGISTER MODIFIERS, MODULE KEYWORDS, RECEIVER & PRATT PRECEDENCES
// =========================================================================
comptime {
    // 1. Short Access Visibility Rings (0..5)
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_priv,    0);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_file,    1);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_pkg,     2);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_int,     3);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_pub,     4);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_export,  5);

    // 2. Semantic Declaration & Mutability Modifiers (`var` replaces `mut`)
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_pure,    Cfg.Tokens.act_pure);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_static,  Cfg.Tokens.act_static);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_const,   Cfg.Tokens.act_const);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_var,     Cfg.Tokens.act_var);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_iso,     Cfg.Tokens.act_iso);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_partial, Cfg.Tokens.act_partial);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_ext,     Cfg.Tokens.act_ext);

    // 3. Clearance Ring (`lvl`), Package (`pkg`), Import (`use`) & Implicit `self`
    __engine(Cfg.Hooks.param_mod,   Cfg.Tokens.kw_lvl,  Cfg.Tokens.act_ring);
    __engine(Cfg.Hooks.module_kw,   Cfg.Tokens.kw_pkg,  Cfg.Tokens.act_pkg);
    __engine(Cfg.Hooks.module_kw,   Cfg.Tokens.kw_use,  Cfg.Tokens.act_use);
    __engine(Cfg.Hooks.receiver_id, Cfg.Tokens.kw_self);

    // 4. Register Global Pratt Operator Precedences ONCE for the Entire Language
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_coal,   Cfg.Ops.fix_infix,   Cfg.Ops.prec_coal,   Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_bitor,  Cfg.Ops.fix_infix,   Cfg.Ops.prec_bitor,  Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_xor,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_xor,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_bitand, Cfg.Ops.fix_infix,   Cfg.Ops.prec_bitand, Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_range,  Cfg.Ops.fix_infix,   Cfg.Ops.prec_range,  Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_span,   Cfg.Ops.fix_infix,   Cfg.Ops.prec_range,  Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_eq,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_eq,     Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_ne,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_eq,     Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_lt,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_gt,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_le,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_ge,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_shl,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_shift,  Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_shr,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_shift,  Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_add,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_sub,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_mul,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_mul,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_div,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_mul,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_rem,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_mul,    Cfg.Ops.assoc_left);

    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_not,    Cfg.Ops.fix_prefix,  Cfg.Ops.prec_unary,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_sub,    Cfg.Ops.fix_prefix,  Cfg.Ops.prec_unary,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_bitnot, Cfg.Ops.fix_prefix,  Cfg.Ops.prec_unary,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_mul,    Cfg.Ops.fix_prefix,  Cfg.Ops.prec_splat,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_pairs,  Cfg.Ops.fix_prefix,  Cfg.Ops.prec_splat,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_expand, Cfg.Ops.fix_prefix,  Cfg.Ops.prec_splat,  Cfg.Ops.assoc_right);

    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_not,    Cfg.Ops.fix_postfix, Cfg.Ops.prec_post,   Cfg.Ops.assoc_left);
}

[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Genesis;

// =========================================================================
// STEP 4: PAIRED CFG KEYWORDS (`break`, `continue`, `op`) & SSA/REFLECTION HOOKS
// =========================================================================
pub syntax {
    break()       => __engine(Cfg.Hooks.jmp_exit);
    continue()    => __engine(Cfg.Hooks.jmp_head);
    op(sig, body) => __engine(Cfg.Hooks.decl_op, sig, body);
}

// Ring 80 (`lvl(80)`): Restricted to `Pilot.Core` SIMD/Primitive Implementations
pub lvl(Cfg.Tokens.ring_simd) comptime fn {
    __ssa(opcode, lhs, rhs)       => __engine(Cfg.Hooks.ssa_binop, opcode, lhs, rhs);
    __ssa_unary(opcode, val)      => __engine(Cfg.Hooks.ssa_unop, opcode, val);
    __ssa_cast(opcode, val, T)    => __engine(Cfg.Hooks.ssa_cast, opcode, val, T);
    __ssa_load(ptr_val)           => __engine(Cfg.Hooks.ssa_load, ptr_val);
    __ssa_store(ptr_val, val)     => __engine(Cfg.Hooks.ssa_store, ptr_val, val);
    __ssa_gep(base_ptr, elem_idx) => __engine(Cfg.Hooks.ssa_gep, base_ptr, elem_idx);
}

// Ring 0 (`lvl(0)`): Public Compile-Time Reflection & Introspection Intrinsics
pub lvl(Cfg.Tokens.ring_public) comptime fn {
    __is_comptime()               => __engine(Cfg.Hooks.is_comptime);
    sizeof(T)                     => __engine(Cfg.Hooks.t_sizeof, T);
    alignof(T)                    => __engine(Cfg.Hooks.t_alignof, T);
    offsetof(T, field_sym)        => __engine(Cfg.Hooks.t_offsetof, T, field_sym);
    fields_of(T)                  => __engine(Cfg.Hooks.t_fields, T);
    compile_error(msg)            => __engine(Cfg.Hooks.diag_err, msg);
    lattice_bits_of(T)            => __engine(Cfg.Hooks.lattice_get, T);
}

// =========================================================================
// STEP 5: SEED PRIMITIVES (`bool` & `usize`) FOR STAGE 2/3 BOOTSTRAPPING
// =========================================================================
pub partial struct {
    [Lang(Cfg.Lang.bool_t), Bits(Cfg.Reg.b8, Cfg.Reg.gpr_u)]
    bool {
        pub pure:
            op !  ()          -> bool => __ssa(Cfg.Ssa.xor_b, self, true);
            op &  (rhs: bool) -> bool => __ssa(Cfg.Ssa.and_b, self, rhs);
            op |  (rhs: bool) -> bool => __ssa(Cfg.Ssa.or_b,  self, rhs);
            op ^  (rhs: bool) -> bool => __ssa(Cfg.Ssa.xor_b, self, rhs);
            op == (rhs: bool) -> bool => __ssa(Cfg.Ssa.eq,    self, rhs);
            op != (rhs: bool) -> bool => __ssa(Cfg.Ssa.ne,    self, rhs);
    }

    [Lang(Cfg.Lang.usize_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)]
    usize {
        pub pure:
            op +  (rhs: usize) -> usize => __ssa(Cfg.Ssa.add,  self, rhs);
            op -  (rhs: usize) -> usize => __ssa(Cfg.Ssa.sub,  self, rhs);
            op *  (rhs: usize) -> usize => __ssa(Cfg.Ssa.mul,  self, rhs);
            op /  (rhs: usize) -> usize => __ssa(Cfg.Ssa.udiv, self, rhs);
            op %  (rhs: usize) -> usize => __ssa(Cfg.Ssa.urem, self, rhs);
            op &  (rhs: usize) -> usize => __ssa(Cfg.Ssa.and_b,self, rhs);
            op |  (rhs: usize) -> usize => __ssa(Cfg.Ssa.or_b, self, rhs);
            op ^  (rhs: usize) -> usize => __ssa(Cfg.Ssa.xor_b,self, rhs);
            op << (rhs: usize) -> usize => __ssa(Cfg.Ssa.shl,  self, rhs);
            op >> (rhs: usize) -> usize => __ssa(Cfg.Ssa.lshr, self, rhs);
            op == (rhs: usize) -> bool  => __ssa(Cfg.Ssa.eq,   self, rhs);
            op != (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ne,   self, rhs);
            op <  (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ult,  self, rhs);
            op <= (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ule,  self, rhs);
            op >  (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ugt,  self, rhs);
            op >= (rhs: usize) -> bool  => __ssa(Cfg.Ssa.uge,  self, rhs);
    }
}

// =========================================================================
// STEP 6: PERMANENTLY SEAL THE RAW `__engine` BRIDGE
// No file loaded after `stdlib/core/core.pilot` may invoke `__engine(...)`!
// =========================================================================
comptime {
    __engine(Cfg.Hooks.seal_bridge);
}
