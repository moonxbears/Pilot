            urem_euc:"urem_euc",
            cmp3_s:  "cmp3_s",
            cmp3_u:  "cmp3_u",
        },

        // 4. Hardware Register Classes & Bit Widths
        Reg = {
            gpr_u:   gpr_unsigned,
            gpr_s:   gpr_signed,
            simd_f:  simd_float,
            simd_v:  simd_vector,
            raw_ptr: raw_ptr,
