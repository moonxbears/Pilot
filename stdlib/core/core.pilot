            pin_t:    "pin",
            open_t:   "open",
            after_t:  "after",
            order_t:  "order",
            signal_t: "signal",
            call_expr_slot:   "shallow_quote",
            signal_slot:      "reactive_signal",
            dual_slot:        "symbolic_adjoint",
            effect_plan_slot: "effect_dry_run",
            attr_slot:        "attribute",
            interceptor_slot: "interceptor",
            formula_slot:     "formula",
            reactive_slot:    "reactive",
            inherited_slot:   "inherited",
            ecs_rule_slot:    "ecs_rule",
            patch_attr_slot:  "patch_attribute",
            ide_token_slot:   "ide_token_attribute",
            ide_policy_slot:  "ide_context_policy",
        },

        // 3. Backend SSA Instruction Opcodes
        Ssa = {
            add:     "add",
            sub:     "sub",
            mul:     "mul",
            sdiv:    "sdiv",
            udiv:    "udiv",
            srem:    "srem",
            urem:    "urem",
