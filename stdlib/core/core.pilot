// =========================================================================
// STEP 1: DEFINE & BIND CORE `[...]` BRACKET ATTRIBUTES
// =========================================================================
comptime fn Lang(target_decl, item_name) =>
    __engine(Cfg.Hooks.bind_lang, target_decl, item_name);

comptime fn Bits(target_type, width, reg_class) =>
    __engine(Cfg.Hooks.reg_layout, target_type, width, reg_class);

comptime fn Layout(target_type, mode) =>
    __engine(Cfg.Hooks.mem_layout, target_type, mode);

comptime fn Operator(target_fn, fixity, prec, assoc) =>
    __engine(Cfg.Hooks.pratt_op, target_fn, fixity, prec, assoc);

comptime fn Inline(target_fn, mode) =>
    __engine(Cfg.Hooks.inline_hint, target_fn, mode);

comptime fn Lattice(target_iface, mask) =>
    __engine(Cfg.Hooks.lattice_bind, target_iface, mask);

comptime fn EnforceCoreNaming(target_pkg) =>
    __engine(Cfg.Hooks.core_naming, target_pkg);

comptime fn SyntaxMacro(transformer_fn, kw_token) =>
    __engine(Cfg.Hooks.syntax_kw, kw_token, transformer_fn);

comptime {
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_lang,    Lang);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_bits,    Bits);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_layout,  Layout);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_op,      Operator);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_inline,  Inline);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_lattice, Lattice);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_naming,  EnforceCoreNaming);
    __engine(Cfg.Hooks.bind_attr, Cfg.Tokens.attr_syntax,  SyntaxMacro);
}

// =========================================================================
// STEP 2: SELF-BOOTSTRAP THE `syntax` KEYWORD
// =========================================================================
[SyntaxMacro(Cfg.Tokens.kw_syntax)]
comptime fn __bootstrap_syntax(kw_name, params, body) => quote {
    [SyntaxMacro($kw_name)]
    comptime fn __syntax_rule($params) { $body }
};

// =========================================================================
// STEP 3: REGISTER MODIFIERS, MODULE KEYWORDS, RECEIVER & PRATT PRECEDENCES
// =========================================================================
comptime {
    // 1. Canonical Axis-1 Spatial Visibility Lattice (0..9)
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_priv,    0);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_file,    1);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_prot,    3);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_pkg,     4);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_int,     6);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_pub,     7);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_open,    8);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.vis_export,  9);

    // 2. Semantic Declaration & Mutability Modifiers (`var` replaces `mut`)
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_pure,    Cfg.Tokens.act_pure);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_static,  Cfg.Tokens.act_static);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_const,   Cfg.Tokens.act_const);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_var,     Cfg.Tokens.act_var);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_iso,     Cfg.Tokens.act_iso);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_partial, Cfg.Tokens.act_partial);
    __engine(Cfg.Hooks.modifier, Cfg.Tokens.mod_ext,     Cfg.Tokens.act_ext);

    // 3. Clearance Ring (`lvl`), Package (`pkg`), Import (`use`), Receptors & Implicit `self`
    __engine(Cfg.Hooks.param_mod,   Cfg.Tokens.kw_lvl,  Cfg.Tokens.act_ring);
    __engine(Cfg.Hooks.module_kw,   Cfg.Tokens.kw_pkg,  Cfg.Tokens.act_pkg);
    __engine(Cfg.Hooks.module_kw,   Cfg.Tokens.kw_use,  Cfg.Tokens.act_use);
    __engine(Cfg.Hooks.receiver_id, Cfg.Tokens.kw_self, Cfg.Tokens.kw_field, Cfg.Tokens.kw_value);
    __engine(Cfg.Hooks.receptor, Cfg.Tokens.kw_nameof, 33, 25);
    __engine(Cfg.Hooks.receptor, nameof(true),  1, 1);
    __engine(Cfg.Hooks.receptor, nameof(false), 1, 0);
    __engine(Cfg.Hooks.receptor, nameof(none),  2, 0);
    __engine(Cfg.Hooks.receptor, nameof(else),  3, 0);
    __engine(Cfg.Hooks.receptor, Cfg.Tokens.kw_syntax, 4, 0);
    __engine(Cfg.Hooks.receptor, "type_construct",      5, 0);
    __engine(Cfg.Hooks.receptor, "attribute_construct", 6, 0);
    __engine(Cfg.Hooks.receptor, nameof(extern),   7,  0);
    __engine(Cfg.Hooks.receptor, "lib",      8,  0);
    __engine(Cfg.Hooks.receptor, nameof(break),    13, 0);
    __engine(Cfg.Hooks.receptor, nameof(continue), 13, 1);
    __engine(Cfg.Hooks.receptor, nameof(get),      23, 0);
    __engine(Cfg.Hooks.receptor, nameof(set),      24, 0);
    __engine(Cfg.Hooks.receptor, nameof(op),       25, 0);
    __engine(Cfg.Hooks.receptor, nameof(as),       29, 0);
    __engine(Cfg.Hooks.receptor, "view",     29, 1);

    // 4. Register Global Pratt Operator Precedences ONCE for the Entire Language
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_coal,   Cfg.Ops.fix_infix,   Cfg.Ops.prec_coal,   Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, "||",               Cfg.Ops.fix_infix,   Cfg.Ops.prec_or,     Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, "&&",               Cfg.Ops.fix_infix,   Cfg.Ops.prec_and,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_bitor,  Cfg.Ops.fix_infix,   Cfg.Ops.prec_bitor,  Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_xor,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_xor,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_bitand, Cfg.Ops.fix_infix,   Cfg.Ops.prec_bitand, Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_range,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_range,  Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_range_lt, Cfg.Ops.fix_infix,   Cfg.Ops.prec_range,  Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_span,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_range,  Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_eq,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_eq,     Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_ne,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_eq,     Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_lt,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_gt,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_le,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_ge,     Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_shl,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_shift,  Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_shr,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_shift,  Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_add,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_sub,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_mul,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_mul,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_div,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_mul,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_rem,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_mul,    Cfg.Ops.assoc_left);

    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_not,    Cfg.Ops.fix_prefix,  Cfg.Ops.prec_unary,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_sub,    Cfg.Ops.fix_prefix,  Cfg.Ops.prec_unary,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_bitnot, Cfg.Ops.fix_prefix,  Cfg.Ops.prec_unary,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_mul,    Cfg.Ops.fix_prefix,  Cfg.Ops.prec_splat,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_pairs,  Cfg.Ops.fix_prefix,  Cfg.Ops.prec_splat,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_expand, Cfg.Ops.fix_prefix,  Cfg.Ops.prec_splat,  Cfg.Ops.assoc_right);

    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_not,    Cfg.Ops.fix_postfix, Cfg.Ops.prec_post,   Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_try,    Cfg.Ops.fix_postfix, Cfg.Ops.prec_post,   Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_open_rng,Cfg.Ops.fix_infix,   Cfg.Ops.prec_range,  Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_after_rng,Cfg.Ops.fix_prefix, Cfg.Ops.prec_range,  Cfg.Ops.assoc_right);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_cmp3,    Cfg.Ops.fix_infix,   Cfg.Ops.prec_cmp,    Cfg.Ops.assoc_none);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_sat_add, Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_sat_sub, Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
    __engine(Cfg.Hooks.pratt_op, Cfg.Ops.sym_wrap_add,Cfg.Ops.fix_infix,   Cfg.Ops.prec_add,    Cfg.Ops.assoc_left);
