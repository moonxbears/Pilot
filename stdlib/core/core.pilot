            bitcast: "bitcast",
            sitofp:  "sitofp",
            uitofp:  "uitofp",
            fptosi:  "fptosi",
            fptoui:  "fptoui",
            sadd_sat:"sadd_sat",
            uadd_sat:"uadd_sat",
            ssub_sat:"ssub_sat",
            usub_sat:"usub_sat",
            smul_sat:"smul_sat",
            umul_sat:"umul_sat",
            add_wrap:"add_wrap",
            sub_wrap:"sub_wrap",
