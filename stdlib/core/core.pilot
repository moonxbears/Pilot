            act_pure:     "effect_pure",
            act_static:   "storage_static",
            act_const:    "binding_const",
            act_var:      "binding_mutable",
            act_iso:      "perceus_isolated",
            act_partial:  "merge_type_members",
            act_ext:      "extension_member",
            act_ring:     "set_clearance_ring",
            act_pkg:      "declare_package_scope",
            act_use:      "import_symbol_path",

            kw_syntax:    "syntax",
            kw_lvl:       "lvl",
            kw_pkg:       "pkg",
            kw_use:       "use",
            kw_self:      "self",
            kw_field:     "field",
            kw_value:     "value",
            kw_nameof:    "nameof",

            ring_public:  0,
            ring_simd:    80,
            ring_kernel:  90,
            ring_genesis: 100,
        },

        // 7. Operators are declared by attributes on their `op` or `syntax`
        //    rule, at named levels (stdlib/core/operators/, PROP-008).
    };
}
// =========================================================================
// STEP 1: DEFINE & BIND CORE `[...]` BRACKET ATTRIBUTES
// =========================================================================
comptime fn Lang(target_decl, item_name) =>
    bind_lang_item(target_decl, item_name);

comptime fn Bits(target_type, width, reg_class) =>
    set_register_layout(target_type, width, reg_class);

comptime fn Layout(target_type, mode) =>
    set_memory_layout(target_type, mode);

comptime fn Inline(target_fn, mode) =>
    set_inline_hint(target_fn, mode);

comptime fn Lattice(target_iface, mask) =>
    bind_lattice_kind(target_iface, mask);

comptime fn EnforceCoreNaming(target_pkg) =>
    enforce_core_naming_lint(target_pkg);

comptime fn SyntaxMacro(transformer_fn, kw_token) =>
    register_syntax_keyword(kw_token, transformer_fn);

comptime {
    register_bracket_attribute(Cfg.Tokens.attr_lang,    Lang);
    register_bracket_attribute(Cfg.Tokens.attr_bits,    Bits);
    register_bracket_attribute(Cfg.Tokens.attr_layout,  Layout);
    register_bracket_attribute(Cfg.Tokens.attr_inline,  Inline);
    register_bracket_attribute(Cfg.Tokens.attr_lattice, Lattice);
    register_bracket_attribute(Cfg.Tokens.attr_naming,  EnforceCoreNaming);
    register_bracket_attribute(Cfg.Tokens.attr_syntax,  SyntaxMacro);
}

// =========================================================================
// STEP 2: THE `syntax` KEYWORD
// =========================================================================
// `syntax` rules are read by the seed parser (parse_syntax_decl in
// crates/pilot-parser/src/lib.rs). Defining `syntax` here through
// `[SyntaxMacro]` is not built: the declaration that tried it spliced
// `$params` into a parameter list, which does not parse, so it never took
// effect; it was deleted on 2026-11-13 (the bootstrap sources must parse
// cleanly, crates/pilot-parser/tests/bootstrap_sources.rs).

// =========================================================================
// STEP 3: REGISTER MODIFIERS, MODULE KEYWORDS & RECEIVER
// =========================================================================
comptime {
    // 1. Canonical Axis-1 Spatial Visibility Lattice (0..9)
    register_modifier(Cfg.Tokens.vis_priv,    0);
    register_modifier(Cfg.Tokens.vis_file,    1);
    register_modifier(Cfg.Tokens.vis_prot,    3);
    register_modifier(Cfg.Tokens.vis_pkg,     4);
    register_modifier(Cfg.Tokens.vis_int,     6);
    register_modifier(Cfg.Tokens.vis_pub,     7);
    register_modifier(Cfg.Tokens.vis_open,    8);
    register_modifier(Cfg.Tokens.vis_export,  9);

    // 2. Semantic Declaration & Mutability Modifiers (`var` replaces `mut`)
    register_modifier(Cfg.Tokens.mod_pure,    Cfg.Tokens.act_pure);
    register_modifier(Cfg.Tokens.mod_static,  Cfg.Tokens.act_static);
    register_modifier(Cfg.Tokens.mod_const,   Cfg.Tokens.act_const);
    register_modifier(Cfg.Tokens.mod_var,     Cfg.Tokens.act_var);
    register_modifier(Cfg.Tokens.mod_iso,     Cfg.Tokens.act_iso);
    register_modifier(Cfg.Tokens.mod_partial, Cfg.Tokens.act_partial);
    register_modifier(Cfg.Tokens.mod_ext,     Cfg.Tokens.act_ext);

    // 3. Clearance Ring (`lvl`), Package (`pkg`), Import (`use`), Receptors & Implicit `self`
    register_parametric_modifier(Cfg.Tokens.kw_lvl,  Cfg.Tokens.act_ring);
    register_module_kw(Cfg.Tokens.kw_pkg,  Cfg.Tokens.act_pkg);
    register_module_kw(Cfg.Tokens.kw_use,  Cfg.Tokens.act_use);
    bind_receiver_ident(Cfg.Tokens.kw_self, Cfg.Tokens.kw_field, Cfg.Tokens.kw_value);
    bind_receptor(Cfg.Tokens.kw_nameof, 33, 25);
    bind_receptor(nameof(true),  1, 1);
    bind_receptor(nameof(false), 1, 0);
    bind_receptor(nameof(none),  2, 0);
    bind_receptor(nameof(else),  3, 0);
    bind_receptor(Cfg.Tokens.kw_syntax, 4, 0);
    // `macro` is not built yet (docs/keyword_roadmap.md K4; `syntax` rules
    // are the macros that work): where a declaration starts it stops at the
    // seam `keyword.unbuilt` (receptor 40, place 1).
    bind_receptor(nameof(macro), 40, 1);
    // `stringify($p)` in a `syntax` rule's template: the source text of the
    // argument bound to `p` (crates/pilot-parser/src/rule_arms.rs).
    bind_receptor(nameof(stringify), 36, 4);
    bind_receptor("type_construct",      5, 0);
    bind_receptor("attribute_construct", 6, 0);
    bind_receptor(nameof(extern),   7,  0);
    bind_receptor("lib",      8,  0);
    bind_receptor(nameof(break),    13, 0);
    bind_receptor(nameof(continue), 13, 1);
    bind_receptor(nameof(get),      23, 0);
    bind_receptor(nameof(set),      24, 0);
    bind_receptor(nameof(op),       25, 0);
    bind_receptor(nameof(as),       29, 0);
    bind_receptor("view",     29, 1);

    // 4. Operators and their precedence are declared by attributes on their
    //    `op` declarations and `syntax` rules (stdlib/core/operators/, PROP-008).
}

[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Genesis;

// =========================================================================
// STEP 4: PAIRED CFG KEYWORDS (`break`, `continue`, `op`) & SSA/REFLECTION HOOKS
// =========================================================================
pub syntax {
    break()           => cfg_jump_loop_exit();
    continue()        => cfg_jump_loop_head();
    op(sig, body)     => decl_operator_fn(sig, body);
    while(cond, body) => quote { loop { if !($cond) { break; } $body } };
}

pub syntax type_construct {
    ((A) => R) => quote { fn<$A, $R> };
}

// Ring 80 (`lvl(80)`): Restricted to `Pilot.Core` SIMD/Primitive Implementations
pub lvl(Cfg.Tokens.ring_simd) comptime fn {
    __ssa(opcode, lhs, rhs)       => emit_ssa_binop(opcode, lhs, rhs);
    __ssa_unary(opcode, val)      => emit_ssa_unop(opcode, val);
    __ssa_cast(opcode, val, T)    => emit_ssa_cast(opcode, val, T);
    __ssa_load(ptr_val)           => emit_ssa_load(ptr_val);
    __ssa_store(ptr_val, val)     => emit_ssa_store(ptr_val, val);
    __ssa_gep(base_ptr, elem_idx) => emit_ssa_gep(base_ptr, elem_idx);
}

// Ring 0 (`lvl(0)`): Public Compile-Time Reflection & Introspection Intrinsics
pub lvl(Cfg.Tokens.ring_public) comptime fn {
    nameof(sym)                   => sym;
    __is_comptime()               => query_is_comptime_vm();
    sizeof(T)                     => type_sizeof(T);
    alignof(T)                    => type_alignof(T);
    offsetof(T, field_sym)        => type_offsetof(T, field_sym);
    fields_of(T)                  => type_fields_of(T);
    compile_error(msg)            => emit_diagnostic_error(msg);
    lattice_bits_of(T)            => get_lattice_bits(T);
    __ast_lines(target_fn, part_kind) => ast_source_lines(target_fn, part_kind);
    __parse_ast(source_str)           => parse_ast_fragment(source_str);
    __replace_ast(root, pat, rep)     => replace_ast_pattern(root, pat, rep);
    __bind_weaver(iface_decl, fn_ref) => register_attr_weaver(iface_decl, fn_ref);
    // Categories: 0 = seed_keywords, 1 = syntax_macros, 2 = modifiers, 3 = lang_primitives, 4 = operators, 5 = interfaces, 6 = attributes
    __registered_symbols(category_id) => query_registered_symbols(category_id);
}

// =========================================================================
// STEP 5: SEED PRIMITIVES (`bool` & `usize`) FOR STAGE 2/3 BOOTSTRAPPING
// =========================================================================
pub partial struct {
    [Lang(Cfg.Lang.bool_t), Bits(Cfg.Reg.b1, Cfg.Reg.gpr_u)]
    bool {
        pub pure:
            op !  ()          -> bool => __ssa(Cfg.Ssa.xor_b, self, true);
            op &  (rhs: bool) -> bool => __ssa(Cfg.Ssa.and_b, self, rhs);
            op |  (rhs: bool) -> bool => __ssa(Cfg.Ssa.or_b,  self, rhs);
            op ^  (rhs: bool) -> bool => __ssa(Cfg.Ssa.xor_b, self, rhs);
            op == (rhs: bool) -> bool => __ssa(Cfg.Ssa.eq,    self, rhs);
            op != (rhs: bool) -> bool => __ssa(Cfg.Ssa.ne,    self, rhs);
    }

    [Lang(Cfg.Lang.usize_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)]
    usize {
        pub pure:
            op +  (rhs: usize) -> usize => __ssa(Cfg.Ssa.add,  self, rhs);
            op -  (rhs: usize) -> usize => __ssa(Cfg.Ssa.sub,  self, rhs);
            op *  (rhs: usize) -> usize => __ssa(Cfg.Ssa.mul,  self, rhs);
            op /  (rhs: usize) -> usize => __ssa(Cfg.Ssa.udiv, self, rhs);
            op %  (rhs: usize) -> usize => __ssa(Cfg.Ssa.urem, self, rhs);
            op &  (rhs: usize) -> usize => __ssa(Cfg.Ssa.and_b,self, rhs);
            op |  (rhs: usize) -> usize => __ssa(Cfg.Ssa.or_b, self, rhs);
            op ^  (rhs: usize) -> usize => __ssa(Cfg.Ssa.xor_b,self, rhs);
            op << (rhs: usize) -> usize => __ssa(Cfg.Ssa.shl,  self, rhs);
            op >> (rhs: usize) -> usize => __ssa(Cfg.Ssa.lshr, self, rhs);
            op == (rhs: usize) -> bool  => __ssa(Cfg.Ssa.eq,   self, rhs);
            op != (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ne,   self, rhs);
            op <  (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ult,  self, rhs);
            op <= (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ule,  self, rhs);
            op >  (rhs: usize) -> bool  => __ssa(Cfg.Ssa.ugt,  self, rhs);
            op >= (rhs: usize) -> bool  => __ssa(Cfg.Ssa.uge,  self, rhs);
    }
}

// =========================================================================
// STEP 6: PERMANENTLY SEAL THE RAW `__engine` BRIDGE
// No file loaded after `stdlib/core/core.pilot` may invoke `__engine(...)`!
// =========================================================================
comptime {
    seal_bootstrap_bridge();
}
