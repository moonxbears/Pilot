// =========================================================================
// FILE: stdlib/core/operators/comparison.pilot
// RELATIONAL ORDERING OPERATOR PROTOCOLS (`op <`, `op <=`, `op >`, `op >=`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Operators.Comparison;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

pub interface {
    IComparable<TSelf: IAnyValue> : IEquatable<TSelf> {
        pub pure:
            op <  (rhs: TSelf) -> bool;
            op <= (rhs: TSelf) -> bool => !(rhs < self);
            op >  (rhs: TSelf) -> bool => (rhs < self);
            op >= (rhs: TSelf) -> bool => !(self < rhs);
    }
}
