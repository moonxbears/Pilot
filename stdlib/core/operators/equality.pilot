// =========================================================================
// FILE: stdlib/core/operators/equality.pilot
// EQUALITY & INEQUALITY OPERATOR PROTOCOLS (`op ==`, `op !=`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Operators.Equality;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

pub interface {
    IEquatable<TSelf: IAnyValue> : IAnyValue {
        pub pure:
            op == (rhs: TSelf) -> bool;
            op != (rhs: TSelf) -> bool => !(self == rhs);
    }
}
