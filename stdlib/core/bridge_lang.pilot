    // 6. Keyword Taxonomy & Symbol Registry Queries
    register_keyword(category_id, word, doc) =>
        __engine("register_keyword", category_id, word, doc);
    register_keyword_category(category_id, tm_scope, badge, lsp_kind) =>
        __engine("register_keyword_category", category_id, tm_scope, badge, lsp_kind);
    query_registered_symbols(category_id, mode = 0, target = "") =>
        __engine("query_registered_symbols", category_id, mode, target);

    // 7. Generic Protocol Extension Hook (keys gated by GATE021 allowlist)
    bind_lang_protocol(protocol_key, slot_key, target_sym) =>
        __engine("bind_lang_protocol", protocol_key, slot_key, target_sym);

    // 8. Operator Grammar (PROP-008; appended under B+, approved with PROP-008 §9)
    // The enums whose variant order gives the operator levels (loosest
    // first), associativities and parse shapes; the seed reads positions only.
    register_grammar(level_enum, assoc_enum, shape_enum) =>
        __engine("register_grammar", level_enum, assoc_enum, shape_enum);
    // One operator: `symbol` (empty: `target`'s own name) and its readable
    // `word` (or empty), read by `shape` at `level` with `assoc`.
    grammar_entry(target, symbol, shape, level, assoc, word) =>
        __engine("grammar_entry", target, symbol, shape, level, assoc, word);

    // 9. Machine Operations (PROP-009 step 1b; appended under B+)
    // The enum whose variant order names the operations of `asm(op, ..)`;
    // the seed reads positions only.
    register_machine_ops(op_enum) =>
        __engine("register_machine_ops", op_enum);

    // 10. Sequence Rule Heads (PROP-009 step 1a; appended under B+)
    // The enum whose variant order names the hole kinds of a `syntax`
