    // 4. Compile-Time Type Queries (sizeof answers today; alignof/offsetof/fields_of/is_copy stop at SEED001)
    type_sizeof(target_type) =>
        __engine("type_sizeof", target_type);
    type_alignof(target_type) =>
        __engine("type_alignof", target_type);
    type_offsetof(target_type, field_sym) =>
