// =========================================================================
// FILE: stdlib/core/bridge_lang.pilot
// FROZEN COMPILE-TIME GENESIS AIRLOCK (PROP-002a §1–§2, Freeze Model B+)
// =========================================================================
// Strictly 1 of 2 Pilot files allowed to utter `__engine` (ENGINE001 / GATE021).
// Contains ONLY compile-time genesis, grammar, protocol, and type-query hooks.
// Zero runtime functions live here. Frozen forever under Model B+: existing
// hook names and parameter signatures may never be deleted, reordered, or
// re-typed; append-only additions require an owner-approved `proposals.md`
// entry and matching `selfhost/gate/airlock_abi.pilot` snapshot update.
// =========================================================================

// Minimal 14-seed-token bootstrap for this file's own package header:
comptime fn EnforceCoreNaming(target_pkg) =>
    __engine("enforce_core_naming_lint", target_pkg);

comptime {
    __engine("register_modifier", "pub", 7);
    __engine("register_parametric_modifier", "lvl", "set_clearance_ring");
    __engine("register_module_kw", "pkg", "declare_package_scope");
    __engine("register_module_kw", "use", "import_symbol_path");
    __engine("register_bracket_attribute", "EnforceCoreNaming", EnforceCoreNaming);
}

[EnforceCoreNaming]
pub lvl(100) pkg Pilot.Core.Bridge.Lang;

pub comptime fn {
    // 1. Attribute, Layout & Lattice Genesis Hooks
    register_bracket_attribute(attr_name, handler_fn) =>
        __engine("register_bracket_attribute", attr_name, handler_fn);
    bind_lang_item(target_decl, item_name) =>
        __engine("bind_lang_item", target_decl, item_name);
