        __engine("get_lattice_bits", target_type);
    enforce_core_naming_lint(target_pkg) =>
        __engine("enforce_core_naming_lint", target_pkg);
    seal_bootstrap_bridge() =>
        __engine("seal_bootstrap_bridge");

    // 2. Grammar, Modifier, Operator & CFG Registration Hooks
    register_modifier(word, action) =>
        __engine("register_modifier", word, action);
    register_parametric_modifier(word, action) =>
        __engine("register_parametric_modifier", word, action);
    register_module_kw(word, action) =>
        __engine("register_module_kw", word, action);
    bind_receiver_ident(self_sym, field_sym, value_sym) =>
        __engine("bind_receiver_ident", self_sym, field_sym, value_sym);
    bind_receptor(word, category_id, slot_id) =>
        __engine("bind_receptor", word, category_id, slot_id);
    decl_operator_fn(sig, body) =>
        __engine("decl_operator_fn", sig, body);
    cfg_jump_loop_exit() =>
        __engine("cfg_jump_loop_exit");
    cfg_jump_loop_head() =>
        __engine("cfg_jump_loop_head");

    // 3. Backend SSA & Compile-Time Introspection Hooks
    emit_ssa_binop(opcode, lhs, rhs) =>
        __engine("emit_ssa_binop", opcode, lhs, rhs);
    emit_ssa_unop(opcode, val) =>
        __engine("emit_ssa_unop", opcode, val);
    emit_ssa_cast(opcode, val, target_type) =>
        __engine("emit_ssa_cast", opcode, val, target_type);
    emit_ssa_load(ptr_val) =>
        __engine("emit_ssa_load", ptr_val);
    emit_ssa_store(ptr_val, val) =>
        __engine("emit_ssa_store", ptr_val, val);
    emit_ssa_gep(base_ptr, elem_idx) =>
