// =========================================================================
// FILE: stdlib/core/bridge_os.pilot
// FROZEN RUNTIME OS & MEMORY AIRLOCK (PROP-002a §1 & §3, Freeze Model B+)
// =========================================================================
// Strictly 1 of 2 Pilot files allowed to utter `__engine` (ENGINE001 / GATE021).
// Maps the 51 scalar/pointer `HostOp` IDs (`0..=50`, `HOST_OP_COUNT = 51`)
// 1:1 to `crates/pilot-vm/src/bridge.rs`. Every argument and return value is
// an `i64` or `f64` scalar or raw memory address.
//
// Frozen forever under Model B+: existing `HostOp` IDs, function names,
// parameter lists, return conventions, and sub-codes may never be deleted,
// renumbered, or given a new meaning. Append-only additions (`ID >= 51`)
// require an owner-approved `proposals.md` entry and `airlock_abi.pilot` update.
// =========================================================================
[EnforceCoreNaming]
pub lvl(100) pkg Pilot.Core.Bridge.Os;

