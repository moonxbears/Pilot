// =========================================================================
// FILE: stdlib/core/hint.pilot
// FACTS THE PROGRAMMER STATES: `assume(cond)` AND `unreachable()`
// =========================================================================
// `assume(cond)` states that `cond` holds where it is written, and
// `unreachable()` states that control never gets there. An optimizing
// backend may build on these facts (Phase 2: C `__builtin_unreachable`, a
// trap followed by an assumption); the reference run checks them instead:
//   HINT001  an assumed condition was false;
//   HINT002  control reached `unreachable()`.
// Each stops the program like a failed `assert`, with the code in its
// message. `unreachable()` returns `never`, so it stands in any branch
// whatever type the other branches have.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Hint;

/// States that `cond` holds here. A false `cond` stops the program (HINT001).
pub fn assume(cond: bool) {
    assert(cond, "HINT001: an assumed condition is false");
}

/// States that control never reaches this call. Reaching it stops the
/// program (HINT002).
pub fn unreachable() -> never {
    assert(false, "HINT002: control reached `unreachable()`");
}
