// =========================================================================
// FILE: stdlib/core/task.pilot
// STAGE 3D CALLABLES, ABI FRAMES, REFLECTION & 6 CALL-QUOTING CARRIERS
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Callables;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;

pub partial struct {
    // 1. First-Class Callable Closure / Function Pointer (`(A) => R` / `fn<TArgs, TRet>`)
    [Lang(Cfg.Lang.fn_t), Layout(c_abi)]
    fn<TArgs: IAnyValue, TRet: IAnyValue> : IValue {
        pub code_ptr: ptr<u8>;
        pub env_ptr:  ptr<u8>;
    }

    // 2. Zero-Marshalling C-ABI Argument Frame (`fn!&(a, b)` -> `frame<FnSig>`) — `0b00` `IValue`
    [Lang(Cfg.Lang.frame_t), Layout(c_abi)]
    frame<TSig: IAnyValue> : IValue {
        pub fn_ptr:     ptr<u8>;
        pub frame_size: usize;
    }

    // 3. First-Class Compile-Time Type Descriptor (`type`) & Homoiconic AST Handle (`ast`, `fn!!(...)`)
    [Lang(Cfg.Lang.type_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)] type : IValue {}
    [Lang(Cfg.Lang.ast_t),  Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)] ast  : IValue {}

    // 4. Reactive Signal Cell Type Construct (`T^` -> `signal<T>`) — `0b10` `IObject`
    [Lang(Cfg.Lang.signal_t), Layout(c_abi)]
    signal<TVal: IAnyValue> : IObject {
        pub current_val: TVal;
        pub epoch:       u64;
        ~self() {}
        pub pure fn sample() -> TVal => .current_val;
    }
}

pub struct {
    // 1. Shallow Call Quote (`fn!(args...)` -> `CallExpr<TReturn>`) — `0b00` `IValue`
    [Lang(Cfg.Lang.call_expr_slot), Layout(c_abi)]
    CallExpr<TReturn: IAnyValue> : IValue {
        pub callee_sym: u64;
        pub arg_count:  usize;
    }

    // 4. Reactive Signal Node (`fn!^(args...)` -> `Signal<TReturn>`) — `0b10` `IObject`
    [Lang(Cfg.Lang.signal_slot), Layout(c_abi)]
    Signal<TVal: IAnyValue> : IObject {
        pub current_val: TVal;
        pub epoch:       u64;

        ~self() {}

        pub pure fn sample() -> TVal => .current_val;
    }

    // 5. Symbolic Adjoint Dual Number (`fn!@(args...)` -> `Dual<TVal, TGrad>`) — `0b00` `IValue`
    [Lang(Cfg.Lang.dual_slot), Layout(c_abi)]
    Dual<TVal: IValue, TGrad: IValue> : IValue {
        pub primal:  TVal;
        pub tangent: TGrad;
    }

    // 6. CoW Transactional Effect Sandbox (`fn!?(args...)` -> `EffectPlan<TReturn>`) — `0b10` `IObject`
    [Lang(Cfg.Lang.effect_plan_slot), Layout(c_abi)]
    EffectPlan<TReturn: IAnyValue> : IObject {
        pub preview_val:  TReturn;
        pub dirty_pages:  usize;
        pub is_committed: bool;

        ~self() {}
    }
}
