// =========================================================================
// FILE: stdlib/core/task.pilot
// STAGE 3D FUNCTION VIEWS & HOMOICONIC CALL-QUOTING PROJECTION TYPES
// Backs `(A) => R` (`fn<A, R>`) and Call-Quoting Modes 1–6 (`!`, `!!`, `!&`, `!^`, `!@`, `!?`).
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Task;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;

pub partial struct {
    // Canonical backing type for `(TArgs) => TOut` closures (`0b01` `IReference`)
    [Lang(Cfg.Lang.fn_t), Layout(c_abi)]
    fn<TArgs: IAnyValue, TOut: IAnyValue> : IReference {
        pub env_ptr: ptr<void>;
        pub code_fn: ptr<void>;
    }

    // Mode 3 (`fn!&(a, b)`): Zero-Marshalling C-ABI Call-Frame Struct (`0b00` `IValue`)
    [Lang(Cfg.Lang.frame_t), Layout(c_abi)]
    frame<TSig: IValue> : IValue {
        pub fn_id:     u32;
        pub args_pack: TSig;
    }
}

pub struct {
    // Mode 1 (`fn!(a, b)`): Shallow-Quoted Call Descriptor (`0b00` `IValue`)
    [Layout(c_abi)]
    CallExpr<TRet: IAnyValue> : IValue {
        pub fn_ptr:  ptr<void>;
        pub meta_id: u32;
    }

    // Mode 4 (`fn!^(a, b)`): Glitch-Free Push-Pull Reactive Signal (`0b10` `IObject`)
    [Layout(c_abi)]
    Signal<TVal: IAnyValue> : IObject {
        pub current_val: TVal;
        pub node_handle: ptr<void>;
        ~self() {}
        pub value: TVal { get => .current_val; }
    }

    // Mode 5 (`fn!@(a, b)`): Unboxed Symbolic Adjoint & Gradient Tuple (`0b00` `IValue`)
    [Layout(c_abi)]
    Dual<TPrimal: IValue, TGrad: IValue> : IValue {
        pub value:      TPrimal;
        pub derivative: TGrad;
    }

    // Mode 6 (`fn!?(a, b)`): Copy-on-Write Shadow Dry-Run Diff Entry & Plan (`0b10` `IObject`)
    [Layout(c_abi)]
    EffectDiff : IValue {
        pub target_addr: usize;
        pub byte_len:    usize;
    }

    [Layout(c_abi)]
    EffectPlan<TRet: IAnyValue> : IObject {
        pub result_val: TRet;
        pub diffs:      SliceBuffer<EffectDiff>;
        ~self() {}
        pub diff_count: usize { get => .diffs.len; }
    }
}
