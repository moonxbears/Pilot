// ============================================================================
// FILE: stdlib/core/effects.pilot
// Milestone 58.3: Transactional Copy-on-Write Effect Dry-Run Sandbox (`!?`)
// Implements a multi-key CoW key-value store & transactional overlay sandbox
// with tombstones, isolated reads, rollback, and atomic commit in pure Pilot.
// ============================================================================

pub struct ShadowEffectFrame {
    pub base_val: i64;
    pub staged_val: i64;
    pub has_staged_write: bool;
    pub is_committed: bool;
}

pub fn begin_effect_dry_run(base_val: i64) -> ShadowEffectFrame {
    return ShadowEffectFrame {
        base_val: base_val,
        staged_val: base_val,
        has_staged_write: false,
        is_committed: false,
    };
}

pub fn stage_effect_write(frame: ShadowEffectFrame, new_val: i64) -> ShadowEffectFrame {
    return ShadowEffectFrame {
        base_val: frame.base_val,
        staged_val: new_val,
        has_staged_write: true,
        is_committed: false,
    };
}

pub pure fn read_effect_value(frame: ShadowEffectFrame) -> i64 {
    if frame.has_staged_write || frame.is_committed {
        return frame.staged_val;
    }
    return frame.base_val;
}

pub fn rollback_effect_dry_run(frame: ShadowEffectFrame) -> ShadowEffectFrame {
    return ShadowEffectFrame {
        base_val: frame.base_val,
        staged_val: frame.base_val,
        has_staged_write: false,
        is_committed: false,
    };
}

pub fn commit_effect_dry_run(frame: ShadowEffectFrame) -> ShadowEffectFrame {
    let next_base = if frame.has_staged_write { frame.staged_val } else { frame.base_val };
    return ShadowEffectFrame {
        base_val: next_base,
        staged_val: next_base,
        has_staged_write: false,
        is_committed: true,
    };
}

pub fn effect_store_new() -> i64 {
    let store = __engine("map_new");
    __engine("map_set", store, "cnt", 0);
    return store;
}

pub fn effect_store_put(store: i64, key: str, val: str) -> i64 {
    __engine("map_set", store, "has_" + key, 1);
    __engine("map_set", store, "val_" + key, val);
    return store;
}

pub fn effect_store_get(store: i64, key: str) -> str {
    let h = (__engine("map_get", store, "has_" + key) ?? 0);
    if h == 1 {
        return "" + __engine("map_get", store, "val_" + key);
    }
    return "";
}

pub fn effect_sandbox_begin(base_store: i64) -> i64 {
    let sb = __engine("map_new");
    __engine("map_set", sb, "base", base_store);
    __engine("map_set", sb, "log_cnt", 0);
    return sb;
}

pub fn effect_sandbox_put(sb: i64, key: str, val: str) -> i64 {
    if ((__engine("map_get", sb, "seen_" + key) ?? 0)) == 0 {
        let idx = (__engine("map_get", sb, "log_cnt") ?? 0);
        __engine("map_set", sb, "log_" + idx, key);
        __engine("map_set", sb, "log_cnt", idx + 1);
        __engine("map_set", sb, "seen_" + key, 1);
    }
    __engine("map_set", sb, "state_" + key, 1);
    __engine("map_set", sb, "val_" + key, val);
    return sb;
}

pub fn effect_sandbox_delete(sb: i64, key: str) -> i64 {
    if ((__engine("map_get", sb, "seen_" + key) ?? 0)) == 0 {
        let idx = (__engine("map_get", sb, "log_cnt") ?? 0);
        __engine("map_set", sb, "log_" + idx, key);
        __engine("map_set", sb, "log_cnt", idx + 1);
        __engine("map_set", sb, "seen_" + key, 1);
    }
    __engine("map_set", sb, "state_" + key, 2);
    __engine("map_set", sb, "val_" + key, "");
    return sb;
}

pub fn effect_sandbox_get(sb: i64, key: str) -> str {
    let st = (__engine("map_get", sb, "state_" + key) ?? 0);
    if st == 1 {
        return "" + __engine("map_get", sb, "val_" + key);
    }
    if st == 2 {
        return "";
    }
    let base = (__engine("map_get", sb, "base") ?? 0);
    return effect_store_get(base, key);
}

pub fn effect_sandbox_rollback(sb: i64) -> i64 {
    let cnt = (__engine("map_get", sb, "log_cnt") ?? 0);
    var i = 0;
    while i < cnt {
        let k = "" + __engine("map_get", sb, "log_" + i);
        __engine("map_set", sb, "state_" + k, 0);
        __engine("map_set", sb, "val_" + k, "");
        __engine("map_set", sb, "seen_" + k, 0);
        i = i + 1;
    }
    __engine("map_set", sb, "log_cnt", 0);
    return sb;
}

pub fn effect_sandbox_commit(sb: i64, store: i64) -> i64 {
    let base = store ?? (__engine("map_get", sb, "base") ?? 0);
    let cnt = (__engine("map_get", sb, "log_cnt") ?? 0);
    var i = 0;
    while i < cnt {
        let k = "" + __engine("map_get", sb, "log_" + i);
        let st = (__engine("map_get", sb, "state_" + k) ?? 0);
        if st == 1 {
            let v = "" + __engine("map_get", sb, "val_" + k);
            effect_store_put(base, k, v);
        } else if st == 2 {
            __engine("map_set", base, "has_" + k, 2);
            __engine("map_set", base, "val_" + k, "");
        }
        __engine("map_set", sb, "state_" + k, 0);
        __engine("map_set", sb, "val_" + k, "");
        __engine("map_set", sb, "seen_" + k, 0);
        i = i + 1;
    }
    __engine("map_set", sb, "log_cnt", 0);
    return base;
}
