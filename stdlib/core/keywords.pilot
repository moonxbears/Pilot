// =========================================================================
// FILE: stdlib/core/keywords.pilot
// 100% PILOT-HOSTED DECLARATIVE KEYWORD CATALOG & OPEN CATEGORY TAXONOMY
// The Rust compiler has zero prior knowledge of non-seed keyword names
// or descriptions; it reflects them solely through these attributes.
// =========================================================================
pub pkg Pilot.Core.Keywords;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

// =========================================================================
// 1. ATTRIBUTES FOR CATEGORY DEFINITIONS & KEYWORD DECLARATIONS
// =========================================================================

[Layout(c_abi)]
pub struct KeywordCategoryDefAttr : IAttribute, IValue {
    pub id:          i32;
    pub scope:       str;
    pub hover_badge: str;
    pub lsp_kind:    i32;
    pub weight:      i32;

    pub static pure fn create(id: i32, scope: str, hover_badge: str, lsp_kind: i32) -> KeywordCategoryDefAttr => KeywordCategoryDefAttr {
        id:          id,
        scope:       scope,
        hover_badge: hover_badge,
        lsp_kind:    lsp_kind,
        weight:      10,
    };
}

[Layout(c_abi)]
pub struct KeywordDefAttr : IAttribute, IValue {
    pub category: i32;
    pub doc:      str;
    pub suffix:   str;
    pub weight:   i32;

    pub static pure fn create(category: i32, doc: str) -> KeywordDefAttr => KeywordDefAttr {
        category: category,
        doc:      doc,
        suffix:   "",
        weight:   10,
    };

    pub static pure fn with_suffix(category: i32, doc: str, suffix: str) -> KeywordDefAttr => KeywordDefAttr {
        category: category,
        doc:      doc,
        suffix:   suffix,
        weight:   10,
    };
}

