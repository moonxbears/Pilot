    if cat_id == 7  { return "keyword.declaration.polyglot.pilot"; }
    if cat_id == 8  { return "keyword.other.contract.pilot"; }
    if cat_id == 9  { return "keyword.other.effects.pilot"; }
    if cat_id == 10 { return "keyword.other.concurrency.pilot"; }
    if cat_id == 11 { return "keyword.other.realtime.pilot"; }
    if cat_id == 12 { return "storage.modifier.clearance.pilot"; }
