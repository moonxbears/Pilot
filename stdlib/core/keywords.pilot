pub pure fn query_keyword_doc_pure(word: str) -> str {
    if word == "fn"        { return "Function declaration introducing a callable routine."; }
    if word == "let"       { return "Immutable lexical variable binding."; }
    if word == "var"       { return "Mutable lexical variable binding."; }
    if word == "struct"    { return "Zero-cost compound data layout type declaration."; }
    if word == "interface" { return "Compile-time zero-byte behavioral contract."; }
    if word == "ref"       { return "Explicit lexical borrowed memory reference."; }
    if word == "if"        { return "Conditional branching expression."; }
    if word == "loop"      { return "Irreducible unbounded loop construct."; }
    if word == "return"    { return "Early function return statement."; }
    if word == "yield"     { return "Coroutine generator or loop sequence value yield."; }
    if word == "defer"     { return "Lexical scope exit deferred action."; }
    if word == "comptime"  { return "Compile-time stage 1 metaprogramming execution block."; }
    if word == "quote"     { return "Homoiconic AST quasi-quote constructor."; }
    if word == "asm"       { return "Inline hardware assembly instruction block."; }
    if word == "__engine"  { return "Hardware & Structural Physics Engine intrinsic bridge."; }
    if word == "while"     { return "Syntactic while loop desugared into loop { if !cond break; body }."; }
    if word == "for"       { return "Structured 3-tier iteration expression over ranges and collections."; }
    if word == "switch"    { return "Comprehensive pattern branching construct."; }
    if word == "guard"     { return "Early exit guard assertion evaluating else branch on false."; }
    if word == "break"     { return "Break out of current loop structure."; }
    if word == "continue"  { return "Jump to next iteration step of current loop."; }
    if word == "pub"       { return "Public visibility clearance across all modules."; }
    if word == "priv"      { return "Private visibility restricted to enclosing scope."; }
    if word == "pure"      { return "Side-effect-free pure mathematical function."; }
    if word == "static"    { return "Type-associated or compile-time static storage."; }
    if word == "iso"       { return "Perceus-isolated unique reference for zero-copy concurrency."; }
    if word == "partial"   { return "Open type declaration allowing distributive member extension."; }
    if word == "ext"       { return "Scoped method extension for existing types."; }
    if word == "lvl"       { return "Two-axis compile-time clearance ring modifier (0..100)."; }
    return "Pilot language symbol: " + word;
}

pub pure fn query_registered_symbols_pure(cat_id: i64, mode: i64, target: str) -> str {
    if mode == 1 {
        return query_category_scope_pure(cat_id);
    }
    if mode == 2 {
        return query_category_badge_pure(cat_id);
    }
    if mode == 3 {
        return query_keyword_doc_pure(target);
    }
    // mode 0: Pipe-delimited keyword string
    if cat_id == 0 {
        return "__engine|struct|interface|fn|let|ref|if|loop|return|yield|defer|comptime|quote|asm";
    }
    if cat_id == 1 {
        return "while|until|for|switch|guard|break|continue";
    }
    if cat_id == 2 {
        return "pub|priv|file|prot|pkg|int|open|export|pure|static|const|var|iso|partial|ext";
    }
    if cat_id == 3 {
        return "void|never|bool|char|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f16|f32|f64|f128|str";
    }
    if cat_id == 4 {
        return "??|||||&&|||^|&|..|..<|..=|==|!=|<|>|<=|>=|<=>|<<|>>|+|-|*|/|%|!|?|~|~>";
    }
    if cat_id == 5 {
        return "IAnyValue|IValue|IReference|IObject|IGuard|IEquatable|IComparable|IEnumerable";
    }
    if cat_id == 6 {
        return "Lang|Bits|Layout|Operator|Inline|Lattice|EnforceCoreNaming|SyntaxMacro|HardRealtime";
    }
    return "";
}

