// =========================================================================
// 1. DYNAMIC CATEGORY AND KEYWORD REGISTRATION ATTRIBUTES
// =========================================================================

[Layout(c_abi)]
pub struct KeywordCategoryDefAttr : IAttribute, IValue {
    pub category_id: i64;
    pub tm_scope:    str;
    pub badge:       str;
    pub lsp_kind:    i64;
    pub weight:      i32;

    pub static pure fn create(
        category_id: i64,
        tm_scope:    str,
        badge:       str,
        lsp_kind:    i64
    ) -> KeywordCategoryDefAttr => KeywordCategoryDefAttr {
        category_id: category_id,
        tm_scope:    tm_scope,
        badge:       badge,
        lsp_kind:    lsp_kind,
        weight:      10,
    };
}

[Layout(c_abi)]
pub struct KeywordDefAttr : IAttribute, IValue {
    pub category_id: i64;
    pub doc:         str;
    pub suffix:      str;
    pub weight:      i32;

    pub static pure fn create(
        category_id: i64,
        doc:         str,
        suffix:      str
    ) -> KeywordDefAttr => KeywordDefAttr {
        category_id: category_id,
        doc:         doc,
        suffix:      suffix,
        weight:      10,
    };
}

