// =========================================================================
// 4. HIERARCHICAL `:ns/kw` KEYWORD LITERAL RECEPTORS & SPLITTING
// =========================================================================

[Layout(c_abi)]
pub struct KeywordDescriptor : IValue {
    pub namespace: str;
    pub name:      str;
}

pub fn keyword_strip_colon(raw: str) -> str {
    let n = raw.len();
    if n > 0 && raw.byte_at(0) == 58 {
        return raw.slice(1, n);
    }
    return raw;
}

pub fn keyword_slash_index(stripped: str) -> i64 {
    let n = stripped.len();
    var last_idx = -1;
    var i = 0;
    while i < n {
        if stripped.byte_at(i) == 47 {
            last_idx = i;
        }
        i = i + 1;
    }
    return last_idx;
}

pub fn keyword_namespace(raw: str) -> str {
    let stripped = keyword_strip_colon(raw);
    let slash_idx = keyword_slash_index(stripped);
    if slash_idx > 0 {
        return stripped.slice(0, slash_idx);
    }
    return "";
}

pub fn keyword_name(raw: str) -> str {
    let stripped = keyword_strip_colon(raw);
    let slash_idx = keyword_slash_index(stripped);
    if slash_idx >= 0 {
        return stripped.slice(slash_idx + 1, stripped.len());
    }
    return stripped;
}

pub fn keyword_split(raw: str) -> KeywordDescriptor {
    return KeywordDescriptor {
        namespace: keyword_namespace(raw),
        name:      keyword_name(raw),
    };
}

pub fn register_keyword_category_entry(
    category_id: i64,
    tm_scope:    str,
    badge:       str,
    lsp_kind:    i64
) -> i64 {
    return __engine("register_keyword_category", category_id, tm_scope, badge, lsp_kind);
}

pub fn register_keyword_entry(
    category_id: i64,
    word:        str,
    doc:         str
) -> i64 {
    return __engine("register_keyword", category_id, word, doc);
}

// =========================================================================
// 5. PURE PILOT KEYWORD & CATEGORY INTROSPECTION (REPLACES __engine("query_*"))
// =========================================================================

/// Reflects all KeywordDefAttr instances from the active AST arena,
/// returning structured records (or a pipe-delimited list for category `target_cat_id`).
pub fn reflect_category_keywords(target_cat_id: i64) -> str {
    let node_count = __engine("ast_node_count");
    var result = "";
    var i = 0;
    while i < node_count {
        if __engine("ast_node_kind", i) == 1 { // StructDecl
            let ac = __engine("ast_attr_decl_count", i);
            var a = 0;
            while a < ac {
                let attr_name = __engine("sym_str", __engine("ast_attr_name", i, a));
                if attr_name == "KeywordDefAttr" || attr_name == "KeywordDef" {
                    let cat = __engine("ast_attr_decl_arg", i, a, 0);
                    if target_cat_id < 0 || cat == target_cat_id {
                        let name = __engine("sym_str", __engine("ast_node_sym", i));
                        result = if result == "" { name } else { result + "|" + name };
                    }
                }
                a = a + 1;
            }
        }
        i = i + 1;
    }
    return result;
}

pub fn query_category_scope_pure(cat_id: i64) -> str {
    return reflect_category_scope(cat_id);
}

pub fn query_category_badge_pure(cat_id: i64) -> str {
    return reflect_category_badge(cat_id);
}

pub fn query_keyword_doc_pure(word: str) -> str {
    return reflect_keyword_doc(-1, word);
}

pub fn query_registered_symbols_pure(cat_id: i64, mode: i64, target: str) -> str {
    if mode == 1 {
        return reflect_category_scope(cat_id);
    }
    if mode == 2 {
        return reflect_category_badge(cat_id);
    }
    if mode == 3 {
        return reflect_keyword_doc(cat_id, target);
    }
    return reflect_category_words(cat_id);
}

