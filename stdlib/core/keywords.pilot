// =========================================================================
// 3. ALL KEYWORDS & PRIMITIVES WITH ATTACHED METADATA
// Consolidated via distributive `pub partial struct { ... }` header.
// =========================================================================

pub partial struct {
    // Category 0: Hardware Seed Keywords (The strict 14 hardware seed tokens)
    [KeywordDefAttr(0, "Calls directly into the low-level hardware or host runtime engine.")]
    __engine {}

    [KeywordDefAttr(0, "Declares a user-defined record or composite type.")]
    struct {}

    [KeywordDefAttr(0, "Declares a polymorphic contract with zero runtime header overhead.")]
    interface {}

    [KeywordDefAttr(0, "Declares a function or method signature.")]
    fn {}

    [KeywordDefAttr(0, "Declares an immutable variable binding.")]
    let {}

    [KeywordDefAttr(0, "Passes a value by reference; a plain parameter already borrows (`in`), `var ref` lends for changing.")]
    ref {}

    [KeywordDefAttr(0, "Conditional branching construct.")]
    if {}

    [KeywordDefAttr(0, "Unconditional loop construct.")]
    loop {}

    [KeywordDefAttr(0, "Returns a value from a function.")]
    return {}

    [KeywordDefAttr(0, "Yields a value from a generator or collection block.")]
    yield {}

    [KeywordDefAttr(0, "Schedules cleanup expressions at block exit.")]
    defer {}

    [KeywordDefAttr(0, "Evaluates expressions at compile time; `comptime if` picks a branch while compiling and drops the other before it is checked.")]
    comptime {}

    [KeywordDefAttr(0, "Captures Pilot AST expressions.")]
    quote {}

    [KeywordDefAttr(0, "Inline hardware assembly instruction block. Target, not built yet: every use stops at seam keyword.unbuilt; no milestone schedules an assembler (docs/keyword_roadmap.md D5).")]
    asm {}

    // Category 1: Control Flow
    [KeywordDefAttr(1, "Alternative branch for conditional constructs.")]
    else {}

    [KeywordDefAttr(1, "Executes a block while a condition evaluates to true.")]
    while {}

    [KeywordDefAttr(1, "Executes a block until a condition evaluates to true.")]
    until {}

    [KeywordDefAttr(1, "Iterates over a sequence, collection, or range.")]
    for {}

    [KeywordDefAttr(1, "Pattern match or iteration sequence membership test.")]
    in {}

    [KeywordDefAttr(1, "Alternative branch evaluated when a loop terminates without break.")]
    then {}

    [KeywordDefAttr(1, "Terminates execution of the innermost loop or switch.")]
    break {}

    [KeywordDefAttr(1, "Advances execution to the next loop iteration.")]
    continue {}

    [KeywordDefAttr(1, "Schedules cleanup that runs only when a failure leaves the block (a failing `?`, or returning a failed value).")]
    errdefer {}

    [KeywordDefAttr(1, "Guaranteed tail call: the callee takes over the caller's frame, so a chain of any length runs in constant stack.")]
    become {}

    [KeywordDefAttr(1, "Early exit guard assertion evaluating else branch on false.")]
    guard {}

    [KeywordDefAttr(1, "Pattern matching multi-way branch construct.")]
    switch {}

    [KeywordDefAttr(1, "Pattern arm inside a switch construct.")]
    case {}

    [KeywordDefAttr(1, "Fallback arm inside a switch construct.")]
    default {}

    [KeywordDefAttr(1, "Encloses code executing within an error-handled block.")]
    try {}

    [KeywordDefAttr(1, "Catches and handles errors propagated from try blocks.")]
    catch {}

    // Category 2: Declarations
    [KeywordDefAttr(2, "Declares a mutable variable binding; a `var ref` parameter is the only way the call reaches the caller's value (ALIAS001).")]
    var {}

    [KeywordDefAttr(2, "Declares a compile-time constant.")]
    const {}

    [KeywordDefAttr(2, "Declares a closed set of enumerated variants.")]
    enum {}

    [KeywordDefAttr(2, "Declares an actor concurrency entity. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7, decision D6).")]
    actor {}

    [KeywordDefAttr(2, "Declares a finite state automaton typestate variant. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K3).")]
    state {}

    [KeywordDefAttr(2, "Declares a type alias or type construct.")]
    type {}

    // Category 3: Visibility Modifiers
    [KeywordDefAttr(3, "Unrestricted public visibility across packages and projects.")]
    pub {}

    [KeywordDefAttr(3, "Private visibility restricted to enclosing lexical scope.")]
    priv {}

    [KeywordDefAttr(3, "Protected visibility accessible to derived types and extensions.")]
    prot {}

    [KeywordDefAttr(3, "Package visibility accessible anywhere within current package.")]
    pkg {}

    [KeywordDefAttr(3, "Internal visibility accessible within compilation boundary.")]
    int {}

    [KeywordDefAttr(3, "File-scoped visibility accessible only within current source file.")]
    file {}

    [KeywordDefAttr(3, "Open visibility permitting cross-package inheritance and override. The visibility works as `pub`; the override permission waits for `override` (docs/keyword_roadmap.md K2).")]
    open {}

    [KeywordDefAttr(3, "Export visibility exported across dynamic foreign ABI boundaries. Target, not built yet: every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K5).")]
    export {}

    [KeywordDefAttr(3, "Hierarchical security clearance level ring modifier `lvl(N)` (shorthand lvl0..lvl100). Target, not built yet: a use of a function whose level is above the user's stops at seam lvl.clearance; the shorthand stops at keyword.unbuilt; package levels wait for D11 (docs/keyword_roadmap.md K2).", "[0-9]*")]
    lvl {}

    // Category 4: Modifiers
    [KeywordDefAttr(4, "Pure function: same result for the same arguments and no other effect; no IO, no call of a function that is not pure, no global write, no write through a lent parameter (PURE001).")]
    pure {}

    [KeywordDefAttr(4, "Static member bound to type rather than instances.")]
    static {}

    [KeywordDefAttr(4, "Isolated parameter: takes a moved, unaliased owner the caller does not use afterwards (ISO001).")]
    iso {}

    [KeywordDefAttr(4, "Attribute [Align(N)]: places every value of a struct at a multiple of N bytes, N a power of two (LAYOUT001, LAYOUT003).")]
    Align {}

    [KeywordDefAttr(4, "Argument of [Layout(packed)]: lays a struct's fields out with no padding; its fields cannot be lent (LAYOUT002).")]
    packed {}

    [KeywordDefAttr(4, "Attribute [Flags] on an enum: each variant one bit of its type (FLAGS001, FLAGS002); sets in FlagSet<E>.")]
    Flags {}

    [KeywordDefAttr(4, "Attribute [Stack] on a let: the value lives in the function's frame and may not leave it (STACK001).")]
    Stack {}

    [KeywordDefAttr(4, "Partial declaration enabling multi-file struct or interface aggregation.")]
    partial {}

    [KeywordDefAttr(4, "Extension method declaration augmenting existing types.")]
    ext {}

    // Category 5: Property Accessors
    [KeywordDefAttr(5, "Getter accessor clause returning property value.")]
    get {}

    [KeywordDefAttr(5, "Setter accessor clause assigning property value.")]
    set {}

    // Category 6: Language Variables
    [KeywordDefAttr(6, "Current instance reference in methods and properties.")]
    self {}

    [KeywordDefAttr(6, "Implicit backing storage variable in property accessors.")]
    field {}

    [KeywordDefAttr(6, "Incoming setter value parameter in property accessors.")]
    value {}

    // Category 7: Lifecycle
    [KeywordDefAttr(7, "Lexical scope guard block managing enter and exit lifecycle hooks.")]
    scope {}

    [KeywordDefAttr(7, "Entry clause executed when entering a scoped block.")]
    enter {}

    [KeywordDefAttr(7, "Exit clause executed when exiting a scoped block.")]
    exit {}

    // Category 8: Contract & Verification
    [KeywordDefAttr(8, "Precondition after a function's signature, `requires(cond)`: checked on entry, stopping with DBC006 when false; it must not have effects (DBC002).")]
    requires {}

    [KeywordDefAttr(8, "Postcondition after a function's signature, `ensures(cond)` or `ensures(r => cond)` naming the result: checked at every return, stopping with DBC007 when false; a failed result skips it.")]
    ensures {}

    [KeywordDefAttr(8, "Inside `ensures`, `old(e)` is the value `e` had when the function was entered (its operand must not have effects, DBC003).")]
    old {}

    [KeywordDefAttr(8, "Struct invariant, `invariant(cond);` in a struct body: parsed; checking it is not connected yet (seam contracts.invariant).")]
    invariant {}

    [KeywordDefAttr(8, "assume(cond): states a fact an optimizer may build on; checked on the reference run (HINT001).")]
    assume {}

    [KeywordDefAttr(8, "unreachable(): states that control never gets here; returns never; reaching it stops the program (HINT002).")]
    unreachable {}

    // Category 9: Adapter & Dependency Injection
    [KeywordDefAttr(9, "Context ambient dependency injection parameter or block. Target, not built yet: every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K6).")]
    context {}

    [KeywordDefAttr(9, "Type adapter declaring implicit or structural conversion. Target, not built yet: every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K6).")]
    adapter {}

    [KeywordDefAttr(9, "Applies operation across elements of a collection or stream. Target, not built yet: every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K6).")]
    each {}

    // Category 10: Composition & Collision Resolution
    [KeywordDefAttr(10, "Coalesces duplicate bundle fields or methods into a single member.")]
    coalesce {}

    [KeywordDefAttr(10, "Includes bundle members with specific aliasing or transformation; as a statement, `with f name { .. }` runs the block with `name` bound to the scope guard `f()` makes (`with arena a { .. }`), ended when the block is left.")]
    with {}

    [KeywordDefAttr(10, "Excludes specific bundle members from being spliced into struct.")]
    without {}

    [KeywordDefAttr(10, "Type conversion, casting, or bundle member alias operator.")]
    as {}

    // Category 11: Concurrency & Real-Time
    [KeywordDefAttr(11, "Declares an asynchronous function returning a task. Target, not built yet: every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K7).")]
    async {}

    [KeywordDefAttr(11, "Awaits completion of an asynchronous task. Target, not built yet: every use stops at seam concurrency.await (docs/keyword_roadmap.md K7).")]
    await {}

    [KeywordDefAttr(11, "Spawns a concurrent green task in the runtime executor. Target, not built yet: every use stops at seam concurrency.spawn (docs/keyword_roadmap.md K7).")]
    spawn {}

    [KeywordDefAttr(11, "Executes block or updates variable using atomic hardware instructions. Target, not built yet: every use stops at seam concurrency.atomic (docs/keyword_roadmap.md K7).")]
    atomic {}

    [KeywordDefAttr(11, "Synchronizes access across threads using a lock or monitor. Target, not built yet: every use stops at seam concurrency.sync (docs/keyword_roadmap.md K7).")]
    sync {}

    [KeywordDefAttr(11, "Isolates memory region to prevent shared-mutable state data races. Target, not built yet: every use stops at seam concurrency.isolate (docs/keyword_roadmap.md K7).")]
    isolate {}

    [KeywordDefAttr(11, "Selects first available channel operation across multiple cases. Target, not built yet: every use stops at seam concurrency.select (docs/keyword_roadmap.md K7).")]
    select {}

    [KeywordDefAttr(11, "Specifies maximum duration for blocking operations before cancel. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7).")]
    timeout {}

    [KeywordDefAttr(11, "Constrains buffer, channel, or loop execution to bounded bounds. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7, decision D9).")]
    bounded {}

    [KeywordDefAttr(11, "noalloc fn: takes no heap memory: no allocating construct, no call of a function that is not noalloc (NOALLOC001).")]
    noalloc {}

    [KeywordDefAttr(11, "Encloses allocation within an explicit arena region. Target, not built yet: every use stops at seam realtime.region (docs/keyword_roadmap.md K5).")]
    region {}

    [KeywordDefAttr(11, "Real-time execution deadline contract constraint. Target, not built yet: every use stops at seam realtime.deadline (docs/keyword_roadmap.md K8).")]
    deadline {}

    [KeywordDefAttr(11, "Time-bounded execution window constraint. Target, not built yet: every use stops at seam realtime.within (docs/keyword_roadmap.md K8).")]
    within {}

    [KeywordDefAttr(11, "Schedules periodic real-time task execution at fixed frequency. Target, not built yet: every use stops at seam realtime.periodic (docs/keyword_roadmap.md K8).")]
    periodic {}

    [KeywordDefAttr(11, "Assigns real-time scheduling priority. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K8).")]
    priority {}

    [KeywordDefAttr(11, "Specifies maximum allowable scheduling jitter. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K8).")]
    jitter {}

    // Category 12: Database & LINQ
    [KeywordDefAttr(12, "Declares a database connection or schema entity. Target, not built yet: every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K9).")]
    database {}

    [KeywordDefAttr(12, "Executes block within an ACID database transaction. Target, not built yet: every use stops at seam data.transaction (docs/keyword_roadmap.md K9).")]
    transaction {}

    [KeywordDefAttr(12, "Commits pending transaction changes to persistent storage. Target, not built yet: every use stops at seam data.commit (docs/keyword_roadmap.md K9).")]
    commit {}

    [KeywordDefAttr(12, "Rolls back pending transaction changes. Target, not built yet: every use stops at seam data.rollback (docs/keyword_roadmap.md K9).")]
    rollback {}

    [KeywordDefAttr(12, "Creates a rollback savepoint inside an active transaction. Target, not built yet: every use stops at seam data.savepoint (docs/keyword_roadmap.md K9).")]
    savepoint {}

    [KeywordDefAttr(12, "Opens a connection to an external database resource. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    connect {}

    [KeywordDefAttr(12, "Specifies query source table or dataset in LINQ expressions.")]
    from {}

    [KeywordDefAttr(12, "Filters query dataset using predicate boolean expression.")]
    where {}

    [KeywordDefAttr(12, "Orders query results by specified key expressions. Target, not built yet: as a query clause it stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    order {}

    [KeywordDefAttr(12, "Sorts query order ascending. Target, not built yet: as a query clause it stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    ascending {}

    [KeywordDefAttr(12, "Sorts query order descending. Target, not built yet: as a query clause it stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    descending {}

    [KeywordDefAttr(12, "Inserts records into a database table. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    insert {}

    [KeywordDefAttr(12, "Specifies destination table for insert operation. Target, not built yet: as a query clause it stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    into {}

    [KeywordDefAttr(12, "Specifies values to insert into database table. Target, not built yet: as a query clause it stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    values {}

    [KeywordDefAttr(12, "Updates existing records in database table. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    update {}

    [KeywordDefAttr(12, "Deletes records from a database table. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K9).")]
    delete {}

    // Category 13: Foreign Function Interface
    [KeywordDefAttr(13, "Declares an external C-ABI or foreign function symbol. Target, not built yet: the declaration is accepted, and every call stops at seam abi.extern_call (docs/keyword_roadmap.md K5).")]
    extern {}

    [KeywordDefAttr(13, "Declares an external linked assembly binary library. Meaning undecided (docs/keyword_roadmap.md D5): today `assembly { .. }` is read as an inline foreign-language block, which stops with SEED001 on the seed and at a seam on PilIR and C.")]
    assembly {}

    [KeywordDefAttr(13, "Declares a modular unit of code compilation and packaging. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K2, decision D3).")]
    module {}

    [KeywordDefAttr(13, "Links an external native dynamic or static library. Target, not built yet: the library is not linked, and every call of a function it declares stops at seam abi.extern_call (docs/keyword_roadmap.md K5).")]
    lib {}

    // Category 14: Metaprogramming & Queries
    [KeywordDefAttr(14, "Evaluates byte size of a type at compile time.")]
    sizeof {}

    [KeywordDefAttr(14, "Evaluates byte alignment of a type at compile time. Target, not built yet: a type query (`byte_align`) the seed refuses with SEED001 and PilIR stops at ir.lower_construct (docs/keyword_roadmap.md K4).")]
    alignof {}

    [KeywordDefAttr(14, "Evaluates byte offset of a struct field at compile time. Target, not built yet: a type query (`field_offset`) the seed refuses with SEED001 and PilIR stops at ir.lower_construct (docs/keyword_roadmap.md K4).")]
    offsetof {}

    [KeywordDefAttr(14, "Reflects tuple array of field names and types of a struct. Target, not built yet: a type query (`field_list`) the seed refuses with SEED001 and PilIR stops at ir.lower_construct (docs/keyword_roadmap.md K4).")]
    fields_of {}

    [KeywordDefAttr(14, "Evaluates string identifier name of a symbol at compile time.")]
    nameof {}

    [KeywordDefAttr(14, "Asserts boolean invariant, aborting execution on violation: `assert(cond)` or `assert(cond, note)`, a syntax rule (stdlib/core/assert.pilot) that reports the expression text and, for a comparison, both sides; a non-bool condition is TYPE001.")]
    assert {}

    [KeywordDefAttr(14, "Declares a structural blueprint pattern. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7).")]
    blueprint {}

    [KeywordDefAttr(14, "Declares a synchronization cue. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7).")]
    cue {}

    [KeywordDefAttr(14, "Declares an actor or component role. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7).")]
    role {}

    [KeywordDefAttr(14, "Declares a message routing rule. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K7).")]
    route {}

    [KeywordDefAttr(14, "Declares a standalone compilation unit.")]
    unit {}

    [KeywordDefAttr(14, "Declares a syntax macro transformation rule.")]
    syntax {}

    [KeywordDefAttr(14, "Imports symbols or namespaces from another package.")]
    use {}

    [KeywordDefAttr(14, "Declares an overloaded operator function.")]
    op {}

    // Category 15: Algebraic Composition
    [KeywordDefAttr(15, "Explicitly overrides inherited interface or bundle default implementations. Target, not built yet: as a modifier every use stops at seam keyword.unbuilt (docs/keyword_roadmap.md K2).")]
    override {}

    // Category 16: Typestate
    [KeywordDefAttr(16, "Defines a state transition condition in typestate automata. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K3).")]
    transition {}

    // Category 20: Signed Integers
    [KeywordDefAttr(20, "8-bit signed two's-complement integer (-128..127).")]
    i8 {}

