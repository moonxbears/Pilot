    [KeywordDefAttr(35, "Compile-time structural key-value unpack operator (**).")]
    op_pairs {}

    [KeywordDefAttr(35, "Recursive deep-flatten unpack operator (*..).")]
    op_expand {}

    // Category 36: Syntax & Metaprogramming Constructs
    [KeywordDefAttr(36, "Type-position symbolic type rewrite rules.")]
    type_construct {}

    [KeywordDefAttr(36, "AST unquote compile-time evaluation prefix (~).")]
    unquote {}

    [KeywordDefAttr(36, "AST splice compile-time variable insertion prefix ($).")]
    splice {}

    [KeywordDefAttr(36, "Compile-time syntax transformation macro.")]
    macro {}

    // Category 37: Homoiconic Call-Quoting Modes
    [KeywordDefAttr(37, "Shallow quote call expression projection (!).")]
    call_quote_shallow {}

    [KeywordDefAttr(37, "Deep compile-time AST splice projection (!!).")]
    call_quote_deep {}

    [KeywordDefAttr(37, "Zero-marshalling ABI call frame projection (!&).")]
    call_quote_abi {}

    [KeywordDefAttr(37, "Glitch-free push-pull reactive signal projection (!^).")]
    call_quote_signal {}

    [KeywordDefAttr(37, "Symbolic adjoint dual CSE derivative projection (!@).")]
    call_quote_dual {}

    [KeywordDefAttr(37, "CoW transactional dry-run effect plan projection (!?).")]
    call_quote_plan {}
}

// =========================================================================
// 4. HIERARCHICAL `:ns/kw` KEYWORD LITERAL RECEPTORS & SPLITTING
// =========================================================================

[Layout(c_abi)]
pub struct KeywordDescriptor : IValue {
    pub namespace: str;
    pub name:      str;
}

pub fn keyword_strip_colon(raw: str) -> str {
    let n = raw.len();
    if n > 0 && raw.byte_at(0) == 58 {
        return raw.slice(1, n);
    }
    return raw;
}

pub fn keyword_slash_index(stripped: str) -> i64 {
    let n = stripped.len();
    var last_idx = -1;
    var i = 0;
    while i < n {
        if stripped.byte_at(i) == 47 {
            last_idx = i;
        }
        i = i + 1;
    }
    return last_idx;
}

pub fn keyword_namespace(raw: str) -> str {
    let stripped = keyword_strip_colon(raw);
    let slash_idx = keyword_slash_index(stripped);
    if slash_idx > 0 {
        return stripped.slice(0, slash_idx);
    }
    return "";
}

pub fn keyword_name(raw: str) -> str {
    let stripped = keyword_strip_colon(raw);
    let slash_idx = keyword_slash_index(stripped);
    if slash_idx >= 0 {
        return stripped.slice(slash_idx + 1, stripped.len());
    }
    return stripped;
}

pub fn keyword_split(raw: str) -> KeywordDescriptor {
    return KeywordDescriptor {
        namespace: keyword_namespace(raw),
        name:      keyword_name(raw),
    };
}

pub fn register_keyword_category_entry(
    category_id: i64,
    tm_scope:    str,
    badge:       str,
    lsp_kind:    i64
) -> i64 {
    return __engine("register_keyword_category", category_id, tm_scope, badge, lsp_kind);
}

pub fn register_keyword_entry(
    category_id: i64,
    word:        str,
    doc:         str
) -> i64 {
    return __engine("register_keyword", category_id, word, doc);
}

