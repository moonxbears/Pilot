    if cat_id == 17 { return "keyword.other.adapters.pilot"; }
    if cat_id == 18 { return "keyword.other.vectorization.pilot"; }
    if cat_id == 19 { return "keyword.other.switchboard.pilot"; }
    if cat_id == 20 { return "keyword.other.dependency_injection.pilot"; }
