    // Category 36: Syntax & Metaprogramming Constructs
    [KeywordDefAttr(36, "Type-position symbolic type rewrite rules.")]
    type_construct {}

    [KeywordDefAttr(36, "AST unquote compile-time evaluation prefix: `~x` marks an argument of a deep splice (`f!!(~x)`, `splice f(~x)`) to be evaluated at compile time. Target, not built yet: deep splices stop at seam vm.call_quote (docs/keyword_roadmap.md K4). No readable spelling is bound: `unquote` is free as a name.", "~")]
    unquote {}

    [KeywordDefAttr(36, "AST splice compile-time variable insertion prefix ($).")]
    splice {}

    [KeywordDefAttr(36, "Compile-time syntax transformation macro. Target, not built yet: where a declaration or statement starts, every use stops at seam keyword.unbuilt; elsewhere it is an ordinary name (docs/keyword_roadmap.md K4).")]
    macro {}

    // Category 37: Homoiconic Call-Quoting Modes. Each symbol is the Pair
