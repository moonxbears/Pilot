// =========================================================================
// FILE: stdlib/core/env.pilot
// FREESTANDING CORE ENVIRONMENT & HOST RUNTIME STRUCTS (`Env`, `Process`, `TcpSocket`)
// Encapsulates hardware host environment & system operations within core boundary.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Env;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.OsAbi;
use Pilot.Core.Bridge.Os;

fn env_str_buf(s: str) -> i64 {
    let n = s.len();
    let cap = if n > 0 { n } else { 1 };
    let buf = os_slab_alloc(cap, 1);
    if n > 0 { let _ = str_copy_to_ptr(s, buf, n); }
    return buf;
}

fn env_parse_port(s: str) -> i64 {
    var val = 0;
    var i = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48);
        }
        i = i + 1;
    }
    return val;
}

[KeywordDefAttr(30, "Freestanding core host environment interface.")]
pub struct Env : IValue {
    pub static fn get(key: str) -> str {
        if key == "" { return ""; }
        let kbuf = env_str_buf(key);
        let out_len_ptr = os_slab_alloc(8, 8);
        var cap = 1024;
        var vbuf = os_slab_alloc(cap, 1);
        var rc = os_env_ctl(0, kbuf, key.len(), vbuf, cap, out_len_ptr);
        if rc == -44 {
            let need = os_load_int(out_len_ptr, 64, 0);
            if need > cap {
                vbuf = os_slab_realloc(vbuf, cap, need, 1);
                cap = need;
                rc = os_env_ctl(0, kbuf, key.len(), vbuf, cap, out_len_ptr);
            }
        }
        let _ = os_slab_free(kbuf, key.len(), 1);
        let vlen = os_load_int(out_len_ptr, 64, 0);
        let _ = os_slab_free(out_len_ptr, 8, 8);
        let out = if rc >= 0 && vlen > 0 { str_from_ptr(vbuf, vlen) } else { "" };
        let _ = os_slab_free(vbuf, cap, 1);
        return out;
    }
}

[KeywordDefAttr(30, "Freestanding core host process execution interface.")]
pub struct Process : IValue {
    pub static fn spawn_eval(bin: str, code: str) -> str {
        let flag = if bin == "node" || bin == "lua" { "-e" } else { "-c" };
        let pipe_ptr = os_slab_alloc(16, 8);
        if os_fd_pipe_dup(0, pipe_ptr, 0) < 0 {
            let _ = os_slab_free(pipe_ptr, 16, 8);
            return "";
        }
        let rfd = os_load_int(pipe_ptr, 64, 1);
        let wfd = os_load_int(pipe_ptr + 8, 64, 1);
        let _ = os_slab_free(pipe_ptr, 16, 8);

        let bin_buf = env_str_buf(bin);
        let flag_buf = env_str_buf(flag);
        let code_buf = env_str_buf(code);

        // 2 OsSlice entries (32 bytes)
        let argv_buf = os_slab_alloc(32, 8);
        let _ = os_store_int(argv_buf + 0, flag_buf, 64);
        let _ = os_store_int(argv_buf + 8, flag.len(), 64);
        let _ = os_store_int(argv_buf + 16, code_buf, 64);
        let _ = os_store_int(argv_buf + 24, code.len(), 64);

        // OsProcSpec (96 bytes)
        let spec = os_slab_alloc(96, 8);
        let _ = os_mem_set(spec, 0, 96);
        let _ = os_store_int(spec + 0, bin_buf, 64);
        let _ = os_store_int(spec + 8, bin.len(), 64);
        let _ = os_store_int(spec + 16, argv_buf, 64);
        let _ = os_store_int(spec + 24, 2, 64);
        let _ = os_store_int(spec + 64, -1, 64);
        let _ = os_store_int(spec + 72, wfd, 64);
        let _ = os_store_int(spec + 80, wfd, 64);

        let pid_ptr = os_slab_alloc(8, 8);
        let handle = os_proc_spawn(spec, pid_ptr);
        let _ = os_slab_free(pid_ptr, 8, 8);
        let _ = os_slab_free(spec, 96, 8);
        let _ = os_slab_free(argv_buf, 32, 8);
        let _ = os_slab_free(bin_buf, if bin.len() > 0 { bin.len() } else { 1 }, 1);
        let _ = os_slab_free(flag_buf, flag.len(), 1);
        let _ = os_slab_free(code_buf, if code.len() > 0 { code.len() } else { 1 }, 1);
        let _ = os_fd_close(wfd);

        if handle < 0 {
            let _ = os_fd_close(rfd);
            return "";
        }

        var cap = 8192;
        var len = 0;
        var obuf = os_slab_alloc(cap, 8);
        while true {
            if cap - len < 2048 {
                let next_cap = cap * 2;
                obuf = os_slab_realloc(obuf, cap, next_cap, 8);
                cap = next_cap;
            }
            let r = os_fd_read(rfd, obuf + len, cap - len);
            if r <= 0 { break; }
            len = len + r;
        }
        let _ = os_fd_close(rfd);
        let code_ptr = os_slab_alloc(8, 8);
        let _ = os_proc_wait(handle, 0, code_ptr);
        let _ = os_slab_free(code_ptr, 8, 8);
        let out = if len > 0 { str_from_ptr(obuf, len) } else { "" };
        let _ = os_slab_free(obuf, cap, 8);
        return out;
    }
}

[KeywordDefAttr(30, "Freestanding core network socket descriptor interface.")]
pub struct TcpSocket : IValue {
    pub static fn connect(addr: str) -> i64 {
        var colon = -1;
        var i = addr.len() - 1;
        while i >= 0 {
            if addr.byte_at(i) == 58 { colon = i; break; }
            i = i - 1;
        }
        if colon <= 0 { return -12; }
        let host = addr.slice(0, colon);
        let port = env_parse_port(addr.slice(colon + 1, addr.len()));
        let hbuf = env_str_buf(host);
        let abuf = os_slab_alloc(144, 8);
        let out_len_ptr = os_slab_alloc(8, 8);
        let rc = os_net_resolve(hbuf, host.len(), port, abuf, 144, out_len_ptr);
        let _ = os_slab_free(hbuf, host.len(), 1);
        let _ = os_slab_free(out_len_ptr, 8, 8);
        if rc < 0 {
            let _ = os_slab_free(abuf, 144, 8);
            return rc;
        }
        let family = os_load_int(abuf, 32, 0);
        let fd = os_net_socket(family, 1, 0, 0);
        if fd < 0 {
            let _ = os_slab_free(abuf, 144, 8);
            return fd;
        }
        let crc = os_net_connect_bind(0, fd, abuf, 0);
        let _ = os_slab_free(abuf, 144, 8);
        if crc < 0 {
            let _ = os_fd_close(fd);
            return crc;
        }
        return fd;
    }

    pub static fn send(fd: i64, data: str) -> i64 {
        let n = data.len();
        if n == 0 { return 0; }
        let dbuf = env_str_buf(data);
        let sent = os_net_io(0, fd, dbuf, n, 0, 0);
        let _ = os_slab_free(dbuf, n, 1);
        return sent;
    }

    pub static fn recv(fd: i64, max_len: i64) -> str {
        if max_len <= 0 { return ""; }
        let rbuf = os_slab_alloc(max_len, 1);
        let n = os_net_io(1, fd, rbuf, max_len, 0, 0);
        let out = if n > 0 { str_from_ptr(rbuf, n) } else { "" };
        let _ = os_slab_free(rbuf, max_len, 1);
        return out;
    }

    pub static fn close(fd: i64) -> i64 {
        return os_fd_close(fd);
    }
}
