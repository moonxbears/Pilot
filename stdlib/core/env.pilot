// =========================================================================
// FILE: stdlib/core/env.pilot
// FREESTANDING CORE ENVIRONMENT & HOST RUNTIME STRUCTS (`Env`, `Process`, `TcpSocket`)
// Encapsulates hardware host environment & system operations within core boundary.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Env;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

[KeywordDefAttr(30, "Freestanding core host environment interface.")]
pub struct Env : IValue {
    pub static fn get(key: str) -> str {
        return __engine("env_var", key);
    }
}

[KeywordDefAttr(30, "Freestanding core host process execution interface.")]
pub struct Process : IValue {
    pub static fn spawn_eval(bin: str, code: str) -> str {
        return __engine("host_spawn_eval", bin, code);
    }
}

[KeywordDefAttr(30, "Freestanding core network socket descriptor interface.")]
pub struct TcpSocket : IValue {
    pub static fn connect(addr: str) -> i64 {
        return __engine("tcp_connect", addr);
    }

    pub static fn send(fd: i64, data: str) -> i64 {
        return __engine("tcp_send", fd, data);
    }

    pub static fn recv(fd: i64, max_len: i64) -> str {
        return __engine("tcp_recv", fd, max_len);
    }

    pub static fn close(fd: i64) -> i64 {
        return __engine("tcp_close", fd);
    }
}
