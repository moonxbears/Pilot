// =========================================================================
// FILE: stdlib/core/env.pilot
// FREESTANDING CORE ENVIRONMENT & HOST RUNTIME STRUCTS (`Env`, `Process`, `TcpSocket`)
// Encapsulates hardware host environment & system operations within core boundary.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Env;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.OsAbi;
use Pilot.Core.HostRaw;

fn env_str_buf(s: str) -> i64 {
    let n = s.len();
    let cap = if n > 0 { n } else { 1 };
    let buf = RawMem.alloc(cap, 1);
    if n > 0 { let _ = str_copy_to_ptr(s, buf, n); }
    return buf;
}

fn env_parse_port(s: str) -> i64 {
    var val = 0;
    var i = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48);
        }
        i = i + 1;
    }
    return val;
}

[KeywordDefAttr(30, "Freestanding core host environment interface.")]
pub struct Env : IValue {
    [EngineOp]
    priv static fn ctl_internal(op: i64, key_ptr: i64, key_len: i64, buf: i64, cap: i64, out_len_ptr: i64) -> i64 =>
        __engine("host_op", 35, op, key_ptr, key_len, buf, cap, out_len_ptr);
    pub static fn ctl(op: i64, key_ptr: i64, key_len: i64, buf: i64, cap: i64, out_len_ptr: i64) -> i64 => Env.ctl_internal(op, key_ptr, key_len, buf, cap, out_len_ptr);

    pub static fn get(key: str) -> str {
        if key == "" { return ""; }
        let kbuf = env_str_buf(key);
        let out_len_ptr = RawMem.alloc(8, 8);
        var cap = 1024;
        var vbuf = RawMem.alloc(cap, 1);
        var rc = Env.ctl(0, kbuf, key.len(), vbuf, cap, out_len_ptr);
        if rc == -44 {
            let need = RawMem.load_int(out_len_ptr, 64, 0);
            if need > cap {
                vbuf = RawMem.realloc(vbuf, cap, need, 1);
                cap = need;
                rc = Env.ctl(0, kbuf, key.len(), vbuf, cap, out_len_ptr);
            }
        }
        let _ = RawMem.free(kbuf, key.len(), 1);
        let vlen = RawMem.load_int(out_len_ptr, 64, 0);
        let _ = RawMem.free(out_len_ptr, 8, 8);
        let out = if rc >= 0 && vlen > 0 { str_from_ptr(vbuf, vlen) } else { "" };
        let _ = RawMem.free(vbuf, cap, 1);
        return out;
    }
}

[KeywordDefAttr(30, "Freestanding core host process execution interface.")]
pub struct Process : IValue {
    [EngineOp]
    priv static fn spawn_internal(spec_ptr: i64, out_pid_ptr: i64) -> i64 =>
        __engine("host_op", 32, spec_ptr, out_pid_ptr);
    pub static fn spawn(spec_ptr: i64, out_pid_ptr: i64) -> i64 => Process.spawn_internal(spec_ptr, out_pid_ptr);

    [EngineOp]
    priv static fn wait_internal(handle: i64, nonblocking: i64, out_code_ptr: i64) -> i64 =>
        __engine("host_op", 33, handle, nonblocking, out_code_ptr);
    pub static fn wait(handle: i64, nonblocking: i64, out_code_ptr: i64) -> i64 => Process.wait_internal(handle, nonblocking, out_code_ptr);

    [EngineOp]
    priv static fn send_signal_internal(op: i64, handle_or_pid: i64, sig: i64) -> i64 =>
        __engine("host_op", 34, op, handle_or_pid, sig);
    pub static fn send_signal(op: i64, handle_or_pid: i64, sig: i64) -> i64 => Process.send_signal_internal(op, handle_or_pid, sig);

    pub static fn spawn_eval(bin: str, code: str) -> str {
        let flag = if bin == "node" || bin == "lua" { "-e" } else { "-c" };
        let pipe_ptr = RawMem.alloc(16, 8);
        if Fd.pipe_dup(0, pipe_ptr, 0) < 0 {
            let _ = RawMem.free(pipe_ptr, 16, 8);
            return "";
        }
        let rfd = RawMem.load_int(pipe_ptr, 64, 1);
        let wfd = RawMem.load_int(pipe_ptr + 8, 64, 1);
        let _ = RawMem.free(pipe_ptr, 16, 8);

        let bin_buf = env_str_buf(bin);
        let flag_buf = env_str_buf(flag);
        let code_buf = env_str_buf(code);

        // 2 OsSlice entries (32 bytes)
        let argv_buf = RawMem.alloc(32, 8);
        let _ = RawMem.store_int(argv_buf + 0, flag_buf, 64);
        let _ = RawMem.store_int(argv_buf + 8, flag.len(), 64);
        let _ = RawMem.store_int(argv_buf + 16, code_buf, 64);
        let _ = RawMem.store_int(argv_buf + 24, code.len(), 64);

        // OsProcSpec (96 bytes)
        let spec = RawMem.alloc(96, 8);
        let _ = RawMem.fill(spec, 0, 96);
        let _ = RawMem.store_int(spec + 0, bin_buf, 64);
        let _ = RawMem.store_int(spec + 8, bin.len(), 64);
        let _ = RawMem.store_int(spec + 16, argv_buf, 64);
        let _ = RawMem.store_int(spec + 24, 2, 64);
        let _ = RawMem.store_int(spec + 64, -1, 64);
        let _ = RawMem.store_int(spec + 72, wfd, 64);
        let _ = RawMem.store_int(spec + 80, wfd, 64);

        let pid_ptr = RawMem.alloc(8, 8);
        let handle = Process.spawn(spec, pid_ptr);
        let _ = RawMem.free(pid_ptr, 8, 8);
        let _ = RawMem.free(spec, 96, 8);
        let _ = RawMem.free(argv_buf, 32, 8);
        let _ = RawMem.free(bin_buf, if bin.len() > 0 { bin.len() } else { 1 }, 1);
        let _ = RawMem.free(flag_buf, flag.len(), 1);
        let _ = RawMem.free(code_buf, if code.len() > 0 { code.len() } else { 1 }, 1);
        let _ = Fd.close(wfd);

        if handle < 0 {
            let _ = Fd.close(rfd);
            return "";
        }

        var cap = 8192;
        var len = 0;
        var obuf = RawMem.alloc(cap, 8);
        while true {
            if cap - len < 2048 {
                let next_cap = cap * 2;
                obuf = RawMem.realloc(obuf, cap, next_cap, 8);
                cap = next_cap;
            }
            let r = Fd.read(rfd, obuf + len, cap - len);
            if r <= 0 { break; }
            len = len + r;
        }
        let _ = Fd.close(rfd);
        let code_ptr = RawMem.alloc(8, 8);
        let _ = Process.wait(handle, 0, code_ptr);
        let _ = RawMem.free(code_ptr, 8, 8);
        let out = if len > 0 { str_from_ptr(obuf, len) } else { "" };
        let _ = RawMem.free(obuf, cap, 8);
        return out;
    }
}

[KeywordDefAttr(30, "Freestanding core network socket descriptor interface.")]
pub struct TcpSocket : IValue {
    [EngineOp]
    priv static fn socket_internal(domain: i64, sock_type: i64, proto: i64, flags: i64) -> i64 =>
        __engine("host_op", 39, domain, sock_type, proto, flags);
    pub static fn socket(domain: i64, sock_type: i64, proto: i64, flags: i64) -> i64 => TcpSocket.socket_internal(domain, sock_type, proto, flags);

    [EngineOp]
    priv static fn connect_bind_internal(op: i64, fd: i64, addr_ptr: i64, arg: i64) -> i64 =>
        __engine("host_op", 40, op, fd, addr_ptr, arg);
    pub static fn connect_bind(op: i64, fd: i64, addr_ptr: i64, arg: i64) -> i64 => TcpSocket.connect_bind_internal(op, fd, addr_ptr, arg);

    [EngineOp]
    priv static fn io_internal(op: i64, fd: i64, buf: i64, len: i64, flags: i64, addr_ptr: i64) -> i64 =>
        __engine("host_op", 41, op, fd, buf, len, flags, addr_ptr);
    pub static fn io(op: i64, fd: i64, buf: i64, len: i64, flags: i64, addr_ptr: i64) -> i64 => TcpSocket.io_internal(op, fd, buf, len, flags, addr_ptr);

    [EngineOp]
    priv static fn resolve_internal(host_ptr: i64, host_len: i64, port: i64, dst: i64, cap: i64, out_len_ptr: i64) -> i64 =>
        __engine("host_op", 42, host_ptr, host_len, port, dst, cap, out_len_ptr);
    pub static fn resolve(host_ptr: i64, host_len: i64, port: i64, dst: i64, cap: i64, out_len_ptr: i64) -> i64 => TcpSocket.resolve_internal(host_ptr, host_len, port, dst, cap, out_len_ptr);

    pub static fn connect(addr: str) -> i64 {
        var colon = -1;
        var i = addr.len() - 1;
        while i >= 0 {
            if addr.byte_at(i) == 58 { colon = i; break; }
            i = i - 1;
        }
        if colon <= 0 { return -12; }
        let host = addr.slice(0, colon);
        let port = env_parse_port(addr.slice(colon + 1, addr.len()));
        let hbuf = env_str_buf(host);
        let abuf = RawMem.alloc(144, 8);
        let out_len_ptr = RawMem.alloc(8, 8);
        let rc = TcpSocket.resolve(hbuf, host.len(), port, abuf, 144, out_len_ptr);
        let _ = RawMem.free(hbuf, host.len(), 1);
        let _ = RawMem.free(out_len_ptr, 8, 8);
        if rc < 0 {
            let _ = RawMem.free(abuf, 144, 8);
            return rc;
        }
        let family = RawMem.load_int(abuf, 32, 0);
        let fd = TcpSocket.socket(family, 1, 0, 0);
        if fd < 0 {
            let _ = RawMem.free(abuf, 144, 8);
            return fd;
        }
        let crc = TcpSocket.connect_bind(0, fd, abuf, 0);
        let _ = RawMem.free(abuf, 144, 8);
        if crc < 0 {
            let _ = Fd.close(fd);
            return crc;
        }
        return fd;
    }

    pub static fn send(fd: i64, data: str) -> i64 {
        let n = data.len();
        if n == 0 { return 0; }
        let dbuf = env_str_buf(data);
        let sent = TcpSocket.io(0, fd, dbuf, n, 0, 0);
        let _ = RawMem.free(dbuf, n, 1);
        return sent;
    }

    pub static fn recv(fd: i64, max_len: i64) -> str {
        if max_len <= 0 { return ""; }
        let rbuf = RawMem.alloc(max_len, 1);
        let n = TcpSocket.io(1, fd, rbuf, max_len, 0, 0);
        let out = if n > 0 { str_from_ptr(rbuf, n) } else { "" };
        let _ = RawMem.free(rbuf, max_len, 1);
        return out;
    }

    pub static fn close(fd: i64) -> i64 {
        return Fd.close(fd);
    }
}

/// OS threads and futex waits (`HostOp` 12..=15).
pub struct Thread : IValue {
    [EngineOp]
    priv static fn spawn_internal(c_entry_fn_ptr: i64, env_ptr: i64, stack_bytes: i64) -> i64 =>
        __engine("host_op", 12, c_entry_fn_ptr, env_ptr, stack_bytes);
    pub static fn spawn(c_entry_fn_ptr: i64, env_ptr: i64, stack_bytes: i64) -> i64 => Thread.spawn_internal(c_entry_fn_ptr, env_ptr, stack_bytes);

    [EngineOp]
    priv static fn join_internal(handle: i64, out_ret_ptr: i64) -> i64 =>
        __engine("host_op", 13, handle, out_ret_ptr);
    pub static fn join(handle: i64, out_ret_ptr: i64) -> i64 => Thread.join_internal(handle, out_ret_ptr);

    [EngineOp]
    priv static fn ctl_internal(op: i64, arg: i64) -> i64 =>
        __engine("host_op", 14, op, arg);
    pub static fn ctl(op: i64, arg: i64) -> i64 => Thread.ctl_internal(op, arg);

    [EngineOp]
    priv static fn futex_internal(op: i64, u32_ptr: i64, expected: i64, timeout_ns: i64) -> i64 =>
        __engine("host_op", 15, op, u32_ptr, expected, timeout_ns);
    pub static fn futex(op: i64, u32_ptr: i64, expected: i64, timeout_ns: i64) -> i64 => Thread.futex_internal(op, u32_ptr, expected, timeout_ns);
}

/// Wall and monotonic clocks, and sleeping (`HostOp` 36..=37).
pub struct Clock : IValue {
    [EngineOp]
    priv static fn now_ns_internal(clock_id: i64) -> i64 =>
        __engine("host_op", 36, clock_id);
    pub static fn now_ns(clock_id: i64) -> i64 => Clock.now_ns_internal(clock_id);

    [EngineOp]
    priv static fn sleep_ns_internal(ns: i64) -> i64 =>
        __engine("host_op", 37, ns);
    pub static fn sleep_ns(ns: i64) -> i64 => Clock.sleep_ns_internal(ns);
}

/// The OS cryptographic random source (`HostOp` 38).
pub struct Entropy : IValue {
    [EngineOp]
    priv static fn fill_internal(dst: i64, len: i64) -> i64 =>
        __engine("host_op", 38, dst, len);
    pub static fn fill(dst: i64, len: i64) -> i64 => Entropy.fill_internal(dst, len);
}

/// Raw register-level foreign calls and callback trampolines (`HostOp` 46..=48).
pub struct Ffi : IValue {
    [EngineOp]
    priv static fn call_raw_internal(fn_ptr: i64, abi_desc_ptr: i64, gpr_ptr: i64, vec_ptr: i64, stack_ptr: i64, ret_ptr: i64) -> i64 =>
        __engine("host_op", 46, fn_ptr, abi_desc_ptr, gpr_ptr, vec_ptr, stack_ptr, ret_ptr);
    pub static fn call_raw(fn_ptr: i64, abi_desc_ptr: i64, gpr_ptr: i64, vec_ptr: i64, stack_ptr: i64, ret_ptr: i64) -> i64 => Ffi.call_raw_internal(fn_ptr, abi_desc_ptr, gpr_ptr, vec_ptr, stack_ptr, ret_ptr);

    [EngineOp]
    priv static fn callback_alloc_internal(c_dispatch_fn_ptr: i64, env_ptr: i64, abi_desc_ptr: i64, out_fn_ptr: i64) -> i64 =>
        __engine("host_op", 47, c_dispatch_fn_ptr, env_ptr, abi_desc_ptr, out_fn_ptr);
    pub static fn callback_alloc(c_dispatch_fn_ptr: i64, env_ptr: i64, abi_desc_ptr: i64, out_fn_ptr: i64) -> i64 => Ffi.callback_alloc_internal(c_dispatch_fn_ptr, env_ptr, abi_desc_ptr, out_fn_ptr);

    [EngineOp]
    priv static fn callback_free_internal(slot: i64) -> i64 =>
        __engine("host_op", 48, slot);
    pub static fn callback_free(slot: i64) -> i64 => Ffi.callback_free_internal(slot);
}
