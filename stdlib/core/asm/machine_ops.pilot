// =========================================================================
// FILE: stdlib/core/asm/machine_ops.pilot
// THE MACHINE OPERATIONS OF `asm(op, operands..)` (PROP-009 step 1b)
// =========================================================================
// `asm(MachineOp::Add, a, b)` is one machine operation on its operands. The
// primitive types define their operators with it, through the `__ssa` rules
// below. The seed reads only the position of each variant
// (`register_machine_ops`): the order is append-only, and renaming a
// variant changes nothing.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Asm.MachineOps;

use Pilot.Core.Genesis.*;

/// One machine operation. Signed (`S`), unsigned (`U`) and float (`F`)
/// forms are separate operations, as in the hardware.
pub enum MachineOp : u8 {
    Add, Sub, Mul, SDiv, UDiv, SRem, URem,
    FAdd, FSub, FMul, FDiv,
    And, Or, Xor, Shl, LShr, AShr,
    Eq, Ne, ULt, ULe, UGt, UGe, SLt, SLe, SGt, SGe,
    FLt, FLe, FEq,
    Neg, FNeg, Not, BitNot,
    ZExt, SExt, Trunc, Bitcast, SIToFP, UIToFP, FPToSI, FPToUI,
    SAddSat, UAddSat, SSubSat, USubSat, SMulSat, UMulSat,
    AddWrap, SubWrap, MulWrap,
    SRemEuc, URemEuc,
    Cmp3S, Cmp3U,
    Load, Store, ElemAddr,
}

comptime {
    register_machine_ops(nameof(MachineOp));
}

// Ring 80 (`lvl(80)`): Restricted to `Pilot.Core` SIMD/Primitive Implementations.
// Each form is one machine operation (`asm`, PROP-009 step 1b), read as a
// sequence head, so it follows `HoleKind` (stdlib/core/syntax/holes.pilot).
pub lvl(Cfg.Tokens.ring_simd) syntax {
    __ssa ( $op:Expr , $lhs:Expr , $rhs:Expr )  => quote { asm($op, $lhs, $rhs) };
    __ssa_unary ( $op:Expr , $val:Expr )        => quote { asm($op, $val) };
    __ssa_cast ( $op:Expr , $val:Expr , $T:Expr ) => quote { asm($op, $val, $T) };
    __ssa_load ( $p:Expr )                      => quote { asm(MachineOp::Load, $p) };
    __ssa_store ( $p:Expr , $val:Expr )         => quote { asm(MachineOp::Store, $p, $val) };
    __ssa_gep ( $base:Expr , $idx:Expr )        => quote { asm(MachineOp::ElemAddr, $base, $idx) };
}
