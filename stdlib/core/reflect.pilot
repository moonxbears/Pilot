    node_count:      "ast_node_count",
    node_kind:       "ast_node_kind",
    node_sym:        "ast_node_sym",
    attr_count:      "ast_attr_count",
    attr_arg:        "ast_attr_arg",
    sym_str:         "sym_str",
    layout_size:     "layout_metrics",
    lattice_get:     "get_lattice_bits",
    child_count:     "ast_child_count",
    child_at:        "ast_child_at",
    attr_decl_count: "ast_attr_decl_count",
    attr_name:       "ast_attr_name",
    base_count:      "ast_base_count",
    base_at:         "ast_base_at",
];

