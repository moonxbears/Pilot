// =========================================================================
// FILE: stdlib/core/reflect.pilot
// 100% PILOT-HOSTED COMPREHENSIVE COMPILATION & RUNTIME REFLECTION ENGINE
// Provides O(1) structural reflection tables for:
//   1. Keyword & Primitive Category Taxonomy (Scope, Badge, LSP Kind)
//   2. Symbol Documentation & Syntax Suffixes
//   3. Type Layout Physics (Byte Size, Alignment, 2-Bit Lattice Bits)
//   4. Attribute Inspection & Reverse Querying
// =========================================================================
pub pkg Pilot.Core.Reflect;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Option::*;

// =========================================================================
// 1. REFLECTION DATA STRUCTURES (0b00 IValue, Zero Runtime Overhead)
// =========================================================================

[Layout(c_abi)]
pub struct LayoutTarget : IValue {
    pub architecture: str;
    pub pointer_byte: usize;
    pub endianess:    str;
    pub features:     slice<str>;
    pub backend:      str;
    pub cache_line:   usize;
    pub opt_level:    u8;

    pub static pure fn create(
        architecture: str = "x86_64",
        pointer_byte: usize = 8,
        endianess:    str = "little",
        features:     slice<str> = [],
        backend:      str = "native",
        cache_line:   usize = 64,
        opt_level:    u8 = 2
    ) -> LayoutTarget => LayoutTarget {
        architecture: architecture,
        pointer_byte: pointer_byte,
        endianess:    endianess,
        features:     features,
        backend:      backend,
        cache_line:   cache_line,
        opt_level:    opt_level,
    };

    pub pure fn is_64bit() -> bool => .pointer_byte == 8;
    pub pure fn is_little_endian() -> bool => .endianess == "little";
    pub pure fn has_feature(feature_name: str) -> bool {
        var idx: usize = 0;
        loop {
            if !(idx < .features.len) { break; }
            if .features[idx] == feature_name { return true; }
            idx = idx + 1;
        }
        return false;
    }
}

// 2-Bit Lattice & Field Anatomy Descriptor:
// Deduce contiguous views ({ ptr<T>, usize } + 0b01),
// strided lenses ({ ptr<T>, usize, isize } + 0b01),
// owned buffers ({ ptr<T>, usize, usize } + 0b10),
// and bounds pairs ({ T, T } + 0b00)
[Layout(c_abi)]
pub struct AnatomyInfo : IValue {
    pub kind:        u8;    // 0: Unknown, 1: ContiguousView, 2: StridedLens, 3: OwnedBuffer, 4: BoundsPair
    pub ptr_offset:  usize;
    pub len_offset:  usize;
    pub cap_offset:  usize;
    pub stride_step: isize;

    pub static pure fn create(
        kind:        u8 = 0,
        ptr_offset:  usize = 0,
        len_offset:  usize = 0,
        cap_offset:  usize = 0,
        stride_step: isize = 1
    ) -> AnatomyInfo => AnatomyInfo {
        kind:        kind,
        ptr_offset:  ptr_offset,
        len_offset:  len_offset,
        cap_offset:  cap_offset,
        stride_step: stride_step,
    };

    pub pure fn is_contiguous() -> bool => .kind == 1;
    pub pure fn is_strided() -> bool => .kind == 2;
    pub pure fn is_owned_buffer() -> bool => .kind == 3;
    pub pure fn is_bounds_pair() -> bool => .kind == 4;
}

[Layout(c_abi)]
pub struct HardwareType : IValue {
    pub registry:           map<usize, TypeInfo>;
    pub lattice:            map<usize, u8>;
    pub anatomy:            map<usize, AnatomyInfo>;
    pub registered_classes: map<usize, str>;

    pub static pure fn create(
        registry:           map<usize, TypeInfo>,
        lattice:            map<usize, u8>,
        anatomy:            map<usize, AnatomyInfo>,
        registered_classes: map<usize, str>
    ) -> HardwareType => HardwareType {
        registry:           registry,
        lattice:            lattice,
        anatomy:            anatomy,
        registered_classes: registered_classes,
    };

    pub pure fn get_lattice(type_id: usize) -> u8 {
        let lat = .lattice.get(type_id);
        if lat.has_value {
            return lat.val;
        }
        return 0;
    }

    pub pure fn is_value_type(type_id: usize) -> bool => (.get_lattice(type_id) & 0b11) == 0b00;
    pub pure fn is_reference(type_id: usize) -> bool => (.get_lattice(type_id) & 0b01) != 0;
    pub pure fn is_owned(type_id: usize) -> bool => (.get_lattice(type_id) & 0b10) != 0;
    pub pure fn is_guard(type_id: usize) -> bool => (.get_lattice(type_id) & 0b11) == 0b11;
}

[Layout(c_abi)]
pub struct AstContext : IValue {
    pub node_count:  usize;
    pub root_node:   i64;
    pub hygiene_seq: i64;
    pub quotes:      map<usize, str>;
    pub pratt_ops:   map<str, i64>;

    pub static pure fn create(
        node_count:  usize,
        root_node:   i64,
        hygiene_seq: i64,
        quotes:      map<usize, str>,
        pratt_ops:   map<str, i64>
    ) -> AstContext => AstContext {
        node_count:  node_count,
        root_node:   root_node,
        hygiene_seq: hygiene_seq,
        quotes:      quotes,
        pratt_ops:   pratt_ops,
    };

    pub pure fn is_quote_mode_registered(mode_id: usize) -> bool => .quotes.contains_key(mode_id);
    pub pure fn get_pratt_precedence(op_symbol: str) -> i64 {
        let prec = .pratt_ops.get(op_symbol);
        if prec.has_value {
            return prec.val;
        }
        return 0;
    }
}

[Layout(c_abi)]
pub struct SymbolContext : IValue {
    pub scopes:        map<usize, str>;
    pub methods:       map<usize, str>;
    pub extensions:    map<usize, str>;
    pub clearance_lvl: i64;

    pub static pure fn create(
        scopes:        map<usize, str>,
        methods:       map<usize, str>,
        extensions:    map<usize, str>,
        clearance_lvl: i64 = 0
    ) -> SymbolContext => SymbolContext {
        scopes:        scopes,
        methods:       methods,
        extensions:    extensions,
        clearance_lvl: clearance_lvl,
    };

    pub pure fn has_clearance(lvl: i64) -> bool => .clearance_lvl >= lvl;
}

[Layout(c_abi)]
pub struct AttributeContext : IValue {
    pub attributes: map<usize, str>;
    pub weights:    map<str, i32>;
    pub weavers:    map<str, str>;

    pub static pure fn create(
        attributes: map<usize, str>,
        weights:    map<str, i32>,
        weavers:    map<str, str>
    ) -> AttributeContext => AttributeContext {
        attributes: attributes,
        weights:    weights,
        weavers:    weavers,
    };

    pub pure fn get_weight(attr_name: str) -> i32 {
        let w = .weights.get(attr_name);
        if w.has_value {
            return w.val;
        }
        return 0;
    }

    pub pure fn has_weaver(attr_name: str) -> bool => .weavers.contains_key(attr_name);
}

[Layout(c_abi)]
pub struct PackageContext : IValue {
    pub name:         str;
    pub version:      str;
    pub search_paths: slice<str>;
    pub mounted:      map<str, str>;

    pub static pure fn create(
        name:         str,
        version:      str,
        search_paths: slice<str>,
        mounted:      map<str, str>
    ) -> PackageContext => PackageContext {
        name:         name,
        version:      version,
        search_paths: search_paths,
        mounted:      mounted,
    };

    pub pure fn is_mounted(pkg_name: str) -> bool => .mounted.contains_key(pkg_name);
}

[Layout(c_abi)]
pub struct VmContext : IValue {
    pub step_budget:       i64;
    pub memory_used:       usize;
    pub call_depth:        i64;
    pub diagnostics_count: usize;

    pub static pure fn create(
        step_budget:       i64 = 1000000,
        memory_used:       usize = 0,
        call_depth:        i64 = 0,
        diagnostics_count: usize = 0
    ) -> VmContext => VmContext {
        step_budget:       step_budget,
        memory_used:       memory_used,
        call_depth:        call_depth,
        diagnostics_count: diagnostics_count,
    };

    pub pure fn has_budget() -> bool => .step_budget > 0;
}

[Layout(c_abi)]
pub struct Environment : IValue {
    pub layout:   LayoutTarget;
    pub types:    HardwareType;
    pub ast:      AstContext;
    pub symbols:  SymbolContext;
    pub attrs:    AttributeContext;
    pub packages: PackageContext;
    pub vm:       VmContext;

    pub static pure fn create(
        layout:   LayoutTarget,
        types:    HardwareType,
        ast:      AstContext,
        symbols:  SymbolContext,
        attrs:    AttributeContext,
        packages: PackageContext,
        vm:       VmContext
    ) -> Environment => Environment {
        layout:   layout,
        types:    types,
        ast:      ast,
        symbols:  symbols,
        attrs:    attrs,
        packages: packages,
        vm:       vm,
    };
}

[Layout(c_abi)]
pub struct CategoryInfo : IValue {
    pub id:       i64;
    pub scope:    str;
    pub badge:    str;
    pub lsp_kind: i64;

    pub static pure fn create(
        id:       i64,
        scope:    str,
        badge:    str,
        lsp_kind: i64 = 14
    ) -> CategoryInfo => CategoryInfo {
        id:       id,
        scope:    scope,
        badge:    badge,
        lsp_kind: lsp_kind,
    };
}

[Layout(c_abi)]
pub struct KeywordInfo : IValue {
    pub category_id: i64;
    pub word:        str;
    pub doc:         str;
    pub suffix:      str;

    pub static pure fn create(
        category_id: i64,
        word:        str,
        doc:         str,
        suffix:      str = ""
    ) -> KeywordInfo => KeywordInfo {
        category_id: category_id,
        word:        word,
        doc:         doc,
        suffix:      suffix,
    };
}

[Layout(c_abi)]
pub struct FieldInfo : IValue {
    pub name:        str;
    pub offset:      usize;
    pub byte_size:   usize;
    pub layout_id:   usize;

    pub static pure fn create(
        name:      str,
        offset:    usize,
        byte_size: usize,
        layout_id: usize
    ) -> FieldInfo => FieldInfo {
        name:      name,
        offset:    offset,
        byte_size: byte_size,
        layout_id: layout_id,
    };
}

[Layout(c_abi)]
pub struct TypeInfo : IValue {
    pub id:          usize;
    pub name:        str;
    pub byte_size:   usize;
    pub byte_align:  usize;
    pub lattice:     u8;    // 0b00: Value, 0b01: Ref View, 0b10: Owned Object, 0b11: Guard
    pub field_count: usize;

    pub static pure fn create(
        id:          usize,
        name:        str,
        byte_size:   usize,
        byte_align:  usize,
        lattice:     u8,
        field_count: usize = 0
    ) -> TypeInfo => TypeInfo {
        id:          id,
        name:        name,
        byte_size:   byte_size,
        byte_align:  byte_align,
        lattice:     lattice,
        field_count: field_count,
    };
}

