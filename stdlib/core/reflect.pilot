// =========================================================================
// 4. REFLECTION API (O(1) Queries with Dynamic Engine Delegation)
// =========================================================================

pub fn reflect_category_scope(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 1);
    if live != null && live != "" {
        return live;
    }
    // 2. O(1) fallback from the global reflection table:
    if cat_id >= 0 && cat_id < CATEGORY_SCOPES.len {
        return CATEGORY_SCOPES[cat_id];
    }
    return "keyword.other.pilot";
}

pub fn reflect_category_badge(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 2);
    if live != null && live != "" {
        return live;
    }
    // 2. O(1) fallback from the global reflection table:
    if cat_id >= 0 && cat_id < CATEGORY_BADGES.len {
        return CATEGORY_BADGES[cat_id];
    }
    return "Keyword";
}

pub fn reflect_keyword_doc(cat_id: i64, word: str) -> str {
    // 1. Query compiler dynamic registry for exact doc:
    let live = __engine(ReflectEngine.query_sym, cat_id, 3, word);
    if live != null && live != "" {
        return live;
    }
    let any_cat = __engine(ReflectEngine.query_sym, -1, 3, word);
    if any_cat != null && any_cat != "" {
        return any_cat;
    }
    return "Pilot language symbol: " + word;
}

pub fn reflect_category_words(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 0);
    if live != null && live != "" {
        return live;
    }
    // 2. O(1) fallback from global table:
    if cat_id >= 0 && cat_id < CATEGORY_WORDS.len {
        return CATEGORY_WORDS[cat_id];
    }
    return "";
}

pub fn reflect_category(cat_id: i64) -> CategoryInfo {
    let sc = reflect_category_scope(cat_id);
    let bd = reflect_category_badge(cat_id);
    let lk = if cat_id >= 20 && cat_id <= 29 { 7 } else { 14 };
    return CategoryInfo.create(cat_id, sc, bd, lk);
}

// Fast O(1) check if an identifier is registered under a category
pub fn reflect_is_in_category(cat_id: i64, word: str) -> bool {
    let pipe_words = reflect_category_words(cat_id);
    if pipe_words == "" {
        return false;
    }
    let wlen = word.len;
    var pos = 0;
    let plen = pipe_words.len;
    while pos < plen {
        var end_pos = pos;
        while end_pos < plen && pipe_words[end_pos] != "|" {
            end_pos = end_pos + 1;
        }
        let seg_len = end_pos - pos;
        if seg_len == wlen {
            var match = true;
            var i = 0;
            while i < wlen {
                if pipe_words[pos + i] != word[i] {
                    match = false;
                    break;
                }
                i = i + 1;
            }
            if match {
                return true;
            }
        }
        pos = end_pos + 1;
    }
    return false;
}

// Queries type layout metrics from the compiler physics engine
pub fn reflect_type_layout(type_id: usize, type_name: str = "") -> TypeInfo {
    let size = __engine(ReflectEngine.layout_size, type_id);
    let lat = __engine(ReflectEngine.lattice_get, type_id);
    return TypeInfo.create(type_id, type_name, size, 8, lat as u8);
}

// =========================================================================
// 5. COMPILED ENVIRONMENT & CONTEXT REFLECTION FACTORIES
// =========================================================================

pub fn reflect_target() -> LayoutTarget {
    let ptr_size = sizeof(usize);
    let ptr_bytes: usize = if ptr_size > 0 { ptr_size } else { 8 };
    let arch = if ptr_bytes == 8 { "x86_64" } else { "wasm32" };
    return LayoutTarget.create(arch, ptr_bytes, "little", ["simd", "atomics"], "native", 64, 2);
}

pub fn reflect_hardware_type(
    registry:           map<usize, TypeInfo>,
    lattice:            map<usize, u8>,
    anatomy:            map<usize, AnatomyInfo>,
    registered_classes: map<usize, str>
) -> HardwareType {
    return HardwareType.create(registry, lattice, anatomy, registered_classes);
}

pub fn reflect_ast_context(
    node_count:  usize,
    root_node:   i64,
    hygiene_seq: i64,
    quotes:      map<usize, str>,
    pratt_ops:   map<str, i64>
) -> AstContext {
    return AstContext.create(node_count, root_node, hygiene_seq, quotes, pratt_ops);
}

pub fn reflect_symbol_context(
    scopes:        map<usize, str>,
    methods:       map<usize, str>,
    extensions:    map<usize, str>,
    clearance_lvl: i64 = 0
) -> SymbolContext {
    return SymbolContext.create(scopes, methods, extensions, clearance_lvl);
}

pub fn reflect_attribute_context(
    attributes: map<usize, str>,
    weights:    map<str, i32>,
    weavers:    map<str, str>
) -> AttributeContext {
    return AttributeContext.create(attributes, weights, weavers);
}

pub fn reflect_package_context(
    name:         str,
    version:      str,
    search_paths: slice<str>,
    mounted:      map<str, str>
) -> PackageContext {
    return PackageContext.create(name, version, search_paths, mounted);
}

pub fn reflect_vm_context(
    step_budget:       i64 = 1000000,
    memory_used:       usize = 0,
    call_depth:        i64 = 0,
    diagnostics_count: usize = 0
) -> VmContext {
    return VmContext.create(step_budget, memory_used, call_depth, diagnostics_count);
}

pub fn reflect_environment(
    layout:   LayoutTarget,
    types:    HardwareType,
    ast:      AstContext,
    symbols:  SymbolContext,
    attrs:    AttributeContext,
    packages: PackageContext,
    vm:       VmContext
) -> Environment {
    return Environment.create(layout, types, ast, symbols, attrs, packages, vm);
}

// =========================================================================
// 6. COMPILED AST NODE INSPECTION & ENVIRONMENT HYDRATION
// =========================================================================

pub fn reflect_ast_node_kind(node_id: usize) -> i64 {
    return __engine(ReflectEngine.node_kind, node_id);
}

pub fn reflect_ast_node_sym(node_id: usize) -> str {
    let sym_id = __engine(ReflectEngine.node_sym, node_id);
    return __engine(ReflectEngine.sym_str, sym_id);
}

pub fn reflect_ast_child_count(node_id: usize) -> usize {
    return __engine(ReflectEngine.child_count, node_id) as usize;
}

pub fn reflect_ast_child_at(node_id: usize, index: usize) -> usize {
    return __engine(ReflectEngine.child_at, node_id, index) as usize;
}

pub fn reflect_ast_attr_count(node_id: usize) -> usize {
    return __engine(ReflectEngine.attr_decl_count, node_id) as usize;
}

pub comptime fn reflect_hydrate_ast_context() -> AstContext {
    let total_nodes = __engine(ReflectEngine.node_count);
    let root_node: i64 = 0;

    let quotes = map<usize, str> {
        keys: [1, 2, 3, 4, 5, 6],
        vals: ["CallExpr", "ast", "frame", "Signal", "Dual", "EffectPlan"],
    };

    let pratt_ops = map<str, i64> {
        keys: ["?", "??", "catch", "..", "?..", "*", "**", "*.."],
        vals: [90, 85, 80, 70, 70, 60, 60, 60],
    };

    return AstContext.create(
        total_nodes as usize,
        root_node,
        0,
        quotes,
        pratt_ops
    );
}

pub comptime fn reflect_hydrate_hardware_type() -> HardwareType {
    return HardwareType.create(
        map<usize, TypeInfo> { keys: [], vals: [] },
        map<usize, u8>       { keys: [], vals: [] },
        map<usize, AnatomyInfo> { keys: [], vals: [] },
        map<usize, str>      { keys: [], vals: [] }
    );
}

pub comptime fn reflect_hydrate_symbol_context() -> SymbolContext {
    return SymbolContext.create(
        map<usize, str> { keys: [], vals: [] },
        map<usize, str> { keys: [], vals: [] },
        map<usize, str> { keys: [], vals: [] },
        0
    );
}

pub comptime fn reflect_hydrate_attribute_context() -> AttributeContext {
    return AttributeContext.create(
        map<usize, str> { keys: [], vals: [] },
        map<str, i32>   { keys: [], vals: [] },
        map<str, str>   { keys: [], vals: [] }
    );
}

pub comptime fn reflect_hydrate_package_context() -> PackageContext {
    let mounted_map = map<str, str> {
        keys: ["Pilot.Core.Reflect", "Pilot.Core.Genesis", "Pilot.Core.Interfaces", "Pilot.Core.Keywords"],
        vals: ["stdlib/core/reflect.pilot", "stdlib/core/core.pilot", "stdlib/core/operator.pilot", "stdlib/core/keywords.pilot"],
    };
    return PackageContext.create(
        "Pilot.Core",
        "0.1.0",
        ["stdlib/core", "stdlib", "src"],
        mounted_map
    );
}

pub comptime fn reflect_hydrate_vm_context() -> VmContext {
    return VmContext.create(1000000, 0, 0, 0);
}

pub comptime fn reflect_hydrate_environment() -> Environment {
    let target = reflect_target();
    let types_ctx = reflect_hydrate_hardware_type();
    let ast_ctx = reflect_hydrate_ast_context();
    let symbols_ctx = reflect_hydrate_symbol_context();
    let attrs_ctx = reflect_hydrate_attribute_context();
    let packages_ctx = reflect_hydrate_package_context();
    let vm_ctx = reflect_hydrate_vm_context();

    return Environment.create(
        target,
        types_ctx,
        ast_ctx,
        symbols_ctx,
        attrs_ctx,
        packages_ctx,
        vm_ctx
    );
}

// Global runtime/comptime reflection entry point
pub fn reflect_current_environment() -> Environment {
    return reflect_hydrate_environment();
}


