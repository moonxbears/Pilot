// =========================================================================
// FILE: stdlib/core/reflect.pilot
// 100% PILOT-HOSTED COMPREHENSIVE COMPILATION & RUNTIME REFLECTION ENGINE
// Provides O(1) structural reflection tables for:
//   1. Keyword & Primitive Category Taxonomy (Scope, Badge, LSP Kind)
//   2. Symbol Documentation & Syntax Suffixes
//   3. Type Layout Physics (Byte Size, Alignment, 2-Bit Lattice Bits)
//   4. Attribute Inspection & Reverse Querying
// =========================================================================
pub pkg Pilot.Core.Reflect;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

// =========================================================================
// 1. REFLECTION DATA STRUCTURES (0b00 IValue, Zero Runtime Overhead)
// =========================================================================

[Layout(c_abi)]
pub struct CategoryInfo : IValue {
    pub id:       i64;
    pub scope:    str;
    pub badge:    str;
    pub lsp_kind: i64;

    pub static pure fn create(
        id:       i64,
        scope:    str,
        badge:    str,
        lsp_kind: i64 = 14
    ) -> CategoryInfo => CategoryInfo {
        id:       id,
        scope:    scope,
        badge:    badge,
        lsp_kind: lsp_kind,
    };
}

[Layout(c_abi)]
pub struct KeywordInfo : IValue {
    pub category_id: i64;
    pub word:        str;
    pub doc:         str;
    pub suffix:      str;

    pub static pure fn create(
        category_id: i64,
        word:        str,
        doc:         str,
        suffix:      str = ""
    ) -> KeywordInfo => KeywordInfo {
        category_id: category_id,
        word:        word,
        doc:         doc,
        suffix:      suffix,
    };
}

[Layout(c_abi)]
pub struct FieldInfo : IValue {
    pub name:        str;
    pub offset:      usize;
    pub byte_size:   usize;
    pub layout_id:   usize;

    pub static pure fn create(
        name:      str,
        offset:    usize,
        byte_size: usize,
        layout_id: usize
    ) -> FieldInfo => FieldInfo {
        name:      name,
        offset:    offset,
        byte_size: byte_size,
        layout_id: layout_id,
    };
}

[Layout(c_abi)]
pub struct TypeInfo : IValue {
    pub id:          usize;
    pub name:        str;
    pub byte_size:   usize;
    pub byte_align:  usize;
    pub lattice:     u8;    // 0b00: Value, 0b01: Ref View, 0b10: Owned Object, 0b11: Guard
    pub field_count: usize;

    pub static pure fn create(
        id:          usize,
        name:        str,
        byte_size:   usize,
        byte_align:  usize,
        lattice:     u8,
        field_count: usize = 0
    ) -> TypeInfo => TypeInfo {
        id:          id,
        name:        name,
        byte_size:   byte_size,
        byte_align:  byte_align,
        lattice:     lattice,
        field_count: field_count,
    };
}

// =========================================================================
// 2. ENGINE INTRINSIC HOOK WRAPPERS (Dynamic Compiler Physics)
// =========================================================================

let ReflectEngine = [
    query_sym:   "query_registered_symbols",
    node_count:  "ast_node_count",
    node_kind:   "ast_node_kind",
    node_sym:    "ast_node_sym",
    attr_count:  "ast_attr_count",
    attr_arg:    "ast_attr_arg",
    sym_str:     "sym_str",
    layout_size: "layout_metrics",
    lattice_get: "get_lattice_bits",
];

