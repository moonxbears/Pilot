// =========================================================================
// 4. REFLECTION API (O(1) Queries with Dynamic Engine Delegation)
// =========================================================================

pub fn reflect_category_scope(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 1);
    if live != null && live != "" {
        return live;
    }
    
    return "keyword.other.pilot";
}

pub fn reflect_category_badge(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 2);
    if live != null && live != "" {
        return live;
    }
    
    return "Keyword";
}

pub fn reflect_keyword_doc(cat_id: i64, word: str) -> str {
    // 1. Query compiler dynamic registry for exact doc:
    let live = __engine(ReflectEngine.query_sym, cat_id, 3, word);
    if live != null && live != "" {
        return live;
    }
    let any_cat = __engine(ReflectEngine.query_sym, -1, 3, word);
    if any_cat != null && any_cat != "" {
        return any_cat;
    }
    return "Pilot language symbol: " + word;
}

pub fn reflect_category_words(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 0);
    if live != null && live != "" {
        return live;
    }
    
    return "";
}

pub fn reflect_category(cat_id: i64) -> CategoryInfo {
    let sc = reflect_category_scope(cat_id);
    let bd = reflect_category_badge(cat_id);
    let lk = if cat_id >= 20 && cat_id <= 29 { 7 } else { 14 };
    return CategoryInfo.create(cat_id, sc, bd, lk);
}

// Fast O(1) check if an identifier is registered under a category
pub fn reflect_is_in_category(cat_id: i64, word: str) -> bool {
    let pipe_words = reflect_category_words(cat_id);
    if pipe_words == "" {
        return false;
    }
    let wlen = word.len;
    var pos = 0;
    let plen = pipe_words.len;
    while pos < plen {
        var end_pos = pos;
        while end_pos < plen && pipe_words[end_pos] != "|" {
            end_pos = end_pos + 1;
        }
        let seg_len = end_pos - pos;
        if seg_len == wlen {
            var match = true;
            var i = 0;
            while i < wlen {
                if pipe_words[pos + i] != word[i] {
                    match = false;
                    break;
                }
                i = i + 1;
            }
            if match {
                return true;
            }
        }
        pos = end_pos + 1;
    }
    return false;
}

// Queries type layout metrics from the compiler physics engine
pub fn reflect_type_layout(type_id: usize, type_name: str = "") -> ReflectTypeInfo {
    let size = __engine(ReflectEngine.layout_size, type_id);
    let lat = __engine(ReflectEngine.lattice_get, type_id);
    return ReflectTypeInfo.create(type_id, type_name, size, 8, lat as u8);
}

// =========================================================================
// 5. COMPILED ENVIRONMENT & CONTEXT REFLECTION FACTORIES
// =========================================================================

pub fn reflect_target() -> LayoutTarget {
    let ptr_bytes = sizeof(usize);
    let target_sym = __engine(ReflectEngine.ast_get_bound_target, 0);
    var target_name = "";
    if target_sym >= 0 && target_sym < 4294967295 {
        target_name = __engine(ReflectEngine.sym_str, target_sym);
    }
    return LayoutTarget.create(
        target_name,
        ptr_bytes,
        "",
        [],
        target_name,
        0,
        0
    );
}

pub fn reflect_hardware_type(
    registry:           map<usize, ReflectTypeInfo>,
    lattice:            map<usize, u8>,
    anatomy:            map<usize, AnatomyInfo>,
    registered_classes: map<usize, str>
) -> HardwareType {
    return HardwareType.create(registry, lattice, anatomy, registered_classes);
}

pub fn reflect_ast_context(
    node_count:  usize,
    root_node:   i64,
    hygiene_seq: i64,
    quotes:      map<usize, str>,
    pratt_ops:   map<str, i64>
) -> AstReflectionContext {
    return AstReflectionContext.create(node_count, root_node, hygiene_seq, quotes, pratt_ops);
}

pub fn reflect_symbol_context(
    scopes:        map<usize, str>,
    methods:       map<usize, str>,
    extensions:    map<usize, str>,
    clearance_lvl: i64
) -> SymbolContext {
    return SymbolContext.create(scopes, methods, extensions, clearance_lvl);
}

pub fn reflect_attribute_context(
    attributes: map<usize, str>,
    weights:    map<str, i32>,
    weavers:    map<str, str>
) -> AttributeContext {
    return AttributeContext.create(attributes, weights, weavers);
}

pub fn reflect_package_context(
    name:         str,
    version:      str,
    search_paths: slice<str>,
    mounted:      map<str, str>
) -> PackageContext {
    return PackageContext.create(name, version, search_paths, mounted);
}

pub fn reflect_vm_context(
    step_budget:       i64,
    memory_used:       usize,
    call_depth:        i64,
    diagnostics_count: usize
) -> VmContext {
    return VmContext.create(step_budget, memory_used, call_depth, diagnostics_count);
}

pub fn reflect_environment(
    layout:   LayoutTarget,
    types:    HardwareType,
    ast:      AstReflectionContext,
    symbols:  SymbolContext,
    attrs:    AttributeContext,
    packages: PackageContext,
    vm:       VmContext
) -> Environment {
    return Environment.create(layout, types, ast, symbols, attrs, packages, vm);
}

// =========================================================================
// 6. COMPILED AST NODE INSPECTION & ENVIRONMENT HYDRATION
// =========================================================================

pub fn reflect_ast_node_kind(node_id: usize) -> i64 {
    return __engine(ReflectEngine.node_kind, node_id);
}

pub fn reflect_ast_node_sym(node_id: usize) -> str {
    let sym_id = __engine(ReflectEngine.node_sym, node_id);
    return __engine(ReflectEngine.sym_str, sym_id);
}

pub fn reflect_ast_child_count(node_id: usize) -> usize {
    return __engine(ReflectEngine.child_count, node_id) as usize;
}

pub fn reflect_ast_child_at(node_id: usize, index: usize) -> usize {
    return __engine(ReflectEngine.child_at, node_id, index) as usize;
}

pub fn reflect_ast_attr_count(node_id: usize) -> usize {
    return __engine(ReflectEngine.attr_decl_count, node_id) as usize;
}

pub comptime fn reflect_hydrate_ast_context() -> AstReflectionContext {
    let total_nodes = __engine(ReflectEngine.node_count) as usize;
    var root_node: i64 = 0;
    var quotes: map<usize, str> = map<usize, str> { keys: [], vals: [] };
    var pratt_ops: map<str, i64> = map<str, i64> { keys: [], vals: [] };

    var nid: usize = 0;
    loop {
        if !(nid < total_nodes) { break; }
        let orig = __engine(ReflectEngine.orig_kind, nid);
        let sym_id = __engine(ReflectEngine.node_sym, nid);
        let fl = __engine(ReflectEngine.node_flags, nid);

        if orig == 0 {
            root_node = nid as i64;
        }

        if orig == 18 && sym_id > 0 {
            let op_str = __engine(ReflectEngine.sym_str, sym_id);
            if op_str != "" {
                pratt_ops[op_str] = fl;
            }
        }

        let decl_fl = __engine(ReflectEngine.decl_flags, nid);
        if decl_fl > 0 && decl_fl <= 6 {
            let q_str = if sym_id > 0 { __engine(ReflectEngine.sym_str, sym_id) } else { "" };
            quotes[decl_fl as usize] = q_str;
        }

        nid = nid + 1;
    }

    return AstReflectionContext.create(
        total_nodes,
        root_node,
        0,
        quotes,
        pratt_ops
    );
}

pub comptime fn reflect_hydrate_hardware_type() -> HardwareType {
    let total_nodes = __engine(ReflectEngine.node_count) as usize;
    var registry: map<usize, ReflectTypeInfo> = map<usize, ReflectTypeInfo> { keys: [], vals: [] };
    var lattice: map<usize, u8> = map<usize, u8> { keys: [], vals: [] };
    var anatomy: map<usize, AnatomyInfo> = map<usize, AnatomyInfo> { keys: [], vals: [] };
    var registered_classes: map<usize, str> = map<usize, str> { keys: [], vals: [] };

    var nid: usize = 0;
    loop {
        if !(nid < total_nodes) { break; }
        let bound_lid = __engine(ReflectEngine.ast_get_bound_layout, nid);
        if bound_lid >= 0 && bound_lid < 4294967295 {
            let lid = bound_lid as usize;
            if !registry.contains_key(lid) {
                let sz = __engine(ReflectEngine.layout_size, lid) as usize;
                let lat = __engine(ReflectEngine.lattice_get, lid) as u8;
                let s_id = __engine(ReflectEngine.node_sym, nid);
                let name = __engine(ReflectEngine.sym_str, s_id);

                registry[lid] = ReflectTypeInfo.create(lid, name, sz, 8, lat, 0);
                lattice[lid] = lat;

                var kind_code: u8 = 0;
                if (lat & 0b11) == 0b01 {
                    kind_code = 1;
                } else if (lat & 0b11) == 0b10 {
                    kind_code = 3;
                } else if (lat & 0b11) == 0b00 {
                    kind_code = 4;
                }
                anatomy[lid] = AnatomyInfo.create(kind_code, 0, 0, 0, 1);
            }
        }
        nid = nid + 1;
    }

    return HardwareType.create(
        registry,
        lattice,
        anatomy,
        registered_classes
    );
}

pub comptime fn reflect_hydrate_symbol_context() -> SymbolContext {
    let total_nodes = __engine(ReflectEngine.node_count) as usize;
    var scopes: map<usize, str> = map<usize, str> { keys: [], vals: [] };
    var methods: map<usize, str> = map<usize, str> { keys: [], vals: [] };
    var extensions: map<usize, str> = map<usize, str> { keys: [], vals: [] };

    var nid: usize = 0;
    loop {
        if !(nid < total_nodes) { break; }
        let orig = __engine(ReflectEngine.orig_kind, nid);
        let sym_id = __engine(ReflectEngine.node_sym, nid);
        if sym_id > 0 {
            let sym_name = __engine(ReflectEngine.sym_str, sym_id);
            if sym_name != "" {
                if orig == 0 || orig == 8 || orig == 10 {
                    scopes[nid] = sym_name;
                } else if orig == 3 || orig == 13 || orig == 14 || orig == 18 {
                    methods[nid] = sym_name;
                } else if orig == 11 {
                    extensions[nid] = sym_name;
                }
            }
        }
        nid = nid + 1;
    }

    return SymbolContext.create(
        scopes,
        methods,
        extensions,
        0
    );
}

pub comptime fn reflect_hydrate_attribute_context() -> AttributeContext {
    let total_nodes = __engine(ReflectEngine.node_count) as usize;
    var attributes: map<usize, str> = map<usize, str> { keys: [], vals: [] };
    var weights: map<str, i32> = map<str, i32> { keys: [], vals: [] };
    var weavers: map<str, str> = map<str, str> { keys: [], vals: [] };

    var nid: usize = 0;
    loop {
        if !(nid < total_nodes) { break; }
        let attr_cnt = __engine(ReflectEngine.attr_decl_count, nid) as usize;
        var ai: usize = 0;
        loop {
            if !(ai < attr_cnt) { break; }
            let a_sym = __engine(ReflectEngine.attr_name, nid, ai);
            if a_sym > 0 {
                let a_name = __engine(ReflectEngine.sym_str, a_sym);
                if a_name != "" {
                    attributes[nid] = a_name;
                    let w_arg = __engine(ReflectEngine.attr_decl_arg, nid, ai, 0);
                    if w_arg != 0 {
                        weights[a_name] = w_arg as i32;
                    }
                }
            }
            ai = ai + 1;
        }
        nid = nid + 1;
    }

    return AttributeContext.create(
        attributes,
        weights,
        weavers
    );
}

pub comptime fn reflect_hydrate_package_context() -> PackageContext {
    let total_nodes = __engine(ReflectEngine.node_count) as usize;
    var pkg_name = "";
    var mounted: map<str, str> = map<str, str> { keys: [], vals: [] };
    var search_paths: slice<str> = [];

    var nid: usize = 0;
    loop {
        if !(nid < total_nodes) { break; }
        let orig = __engine(ReflectEngine.orig_kind, nid);
        let sym_id = __engine(ReflectEngine.node_sym, nid);
        if sym_id > 0 {
            let sym_name = __engine(ReflectEngine.sym_str, sym_id);
            if orig == 0 && pkg_name == "" && sym_name != "" {
                pkg_name = sym_name;
            } else if orig == 1 && sym_name != "" {
                mounted[sym_name] = sym_name;
            }
        }
        nid = nid + 1;
    }

    return PackageContext.create(
        pkg_name,
        "",
        search_paths,
        mounted
    );
}

pub comptime fn reflect_hydrate_vm_context() -> VmContext {
    return VmContext.create(0, 0, 0, 0);
}

pub comptime fn reflect_hydrate_environment() -> Environment {
    let target = reflect_target();
    let types_ctx = reflect_hydrate_hardware_type();
    let ast_ctx = reflect_hydrate_ast_context();
    let symbols_ctx = reflect_hydrate_symbol_context();
    let attrs_ctx = reflect_hydrate_attribute_context();
    let packages_ctx = reflect_hydrate_package_context();
    let vm_ctx = reflect_hydrate_vm_context();

    return Environment.create(
        target,
        types_ctx,
        ast_ctx,
        symbols_ctx,
        attrs_ctx,
        packages_ctx,
        vm_ctx
    );
}

// Global runtime/comptime reflection entry point
pub fn reflect_current_environment() -> Environment {
    return reflect_hydrate_environment();
}

// =========================================================================
// 8. TYPED LAYOUT & GRAMMAR REGISTRY ABSTRACTIONS (Replaces __engine)
// =========================================================================

[Layout(c_abi)]
pub struct FieldLayout : IValue {
    pub name:   str;
    pub offset: usize;
    pub size:   usize;
}

[Layout(c_abi)]
pub struct TypeLayout : IValue {
    pub size_in_bytes: usize;
    pub alignment:     usize;
    pub lattice_bits:  u8;

    pub static pure fn for_type_id(type_sym: i64) -> TypeLayout {
        let sz = __engine("layout_metrics", type_sym) as usize;
        return TypeLayout {
            size_in_bytes: sz,
            alignment: 8,
            lattice_bits: 0,
        };
    }

    pub pure fn field_offset(type_sym: i64, field_idx: i64) -> usize {
        return __engine("layout_field_offset", type_sym, field_idx) as usize;
    }
}

pub struct PrattOperator : IValue {
    pub op_str:        str;
    pub binding_power: i32;
    pub is_right_assoc: bool;
}

pub struct GrammarRegistry {
    pub static fn bind_receptor(name: str, receptor_id: i64, sub_id: i64) -> i64 {
        return __engine("bind_receptor", name, receptor_id, sub_id);
    }

    pub static fn register_modifier(mod_name: str, target: str) -> i64 {
        return __engine("register_modifier", mod_name, target);
    }

    pub static fn register_pratt_op(op_str: str, bp: i64) -> i64 {
        return __engine("register_pratt_op", op_str, bp);
    }

    pub static fn register_module_keyword(kw: str, category: str) -> i64 {
        return __engine("register_module_kw", kw, category);
    }
}

// =========================================================================
// 8. COMPILE ENVIRONMENT & TARGET DESCRIPTOR REFLECTION (Milestone 2)
// =========================================================================

[Layout(c_abi)]
pub struct TargetDescriptor : IValue {
    pub arch:             str;
    pub os:               str;
    pub pointer_bytes:    usize;
    pub endian:           str;
    pub backend:          str;
    pub simd_width_bits:  usize;
    pub cache_line_bytes: usize;
    pub opt_level:        u8;

    pub pure fn is_64bit() -> bool => .pointer_bytes == 8;
    pub pure fn is_little_endian() -> bool => .endian == "little";
    pub pure fn is_windows() -> bool => .os == "windows";
    pub pure fn is_darwin() -> bool => .os == "darwin" || .os == "macos";
    pub pure fn is_linux() -> bool => .os == "linux";
    pub pure fn is_unix() -> bool => .os == "linux" || .os == "darwin" || .os == "macos" || .os == "freebsd" || .os == "openbsd" || .os == "netbsd";
    pub pure fn is_wasm() -> bool => .os == "wasi" || .os == "wasm32" || .arch == "wasm32" || .arch == "wasm64";
    pub pure fn is_arm64() -> bool => .arch == "aarch64" || .arch == "arm64";
    pub pure fn is_x86_64() -> bool => .arch == "x86_64" || .arch == "amd64";
    pub pure fn is_riscv() -> bool => .arch == "riscv64" || .arch == "riscv32";
}

pub struct CompileEnvView : IReference {
    pub target:       TargetDescriptor;
    pub is_comptime:  bool;
    pub unit_count:   usize;
    pub symbol_count: usize;

    pub pure fn lookup_type(name: str) -> opt<TypeLayout> {
        let sym_id = __engine("sym_lookup", name) as i64;
        if sym_id >= 0 {
            let sz = __engine("layout_metrics", sym_id) as usize;
            if sz > 0 {
                return opt<TypeLayout>.some(TypeLayout {
                    size_in_bytes: sz,
                    alignment: 8,
                    lattice_bits: 0,
                });
            }
        }
        return opt<TypeLayout>.none();
    }

    pub pure fn symbols_in_pkg(pkg_name: str) -> slice<str> {
        return slice<str> { data: null, len: 0 };
    }

    pub pure fn ast_root(unit: u32) -> usize {
        return 0;
    }
}

pub fn env() -> CompileEnvView {
    var arch = __engine("map_get", 1, "arch");
    if arch.len() == 0 { arch = __engine("map_get", 1, "architecture"); }
    let arch_str = if arch.len() > 0 { arch } else { "x86_64" };

    let os = __engine("map_get", 1, "os");
    let os_str = if os.len() > 0 { os } else { "linux" };

    var ptr_b = __engine("map_get", 1, "pointer_bytes") as usize;
    if ptr_b == 0 { ptr_b = __engine("map_get", 1, "pointer_byte") as usize; }
    let ptr_bytes = if ptr_b > 0 { ptr_b } else { 8 };

    var end = __engine("map_get", 1, "endian");
    if end.len() == 0 { end = __engine("map_get", 1, "endianess"); }
    let endian_str = if end.len() > 0 { end } else { "little" };

    let be = __engine("map_get", 1, "backend");
    let be_str = if be.len() > 0 { be } else { "vm" };

    let simd = __engine("map_get", 1, "simd_width_bits") as usize;
    let simd_bits = if simd > 0 { simd } else { 128 };

    var cl = __engine("map_get", 1, "cache_line_bytes") as usize;
    if cl == 0 { cl = __engine("map_get", 1, "cache_line") as usize; }
    let cache_bytes = if cl > 0 { cl } else { 64 };

    let opt = __engine("map_get", 1, "opt_level") as u8;
    let opt_lvl = if opt > 0 { opt } else { 2 };

    let is_comp = __engine("map_get", 0, "is_comptime") as i64 == 1;
    let u_cnt = __engine("map_get", 0, "unit_count") as usize;
    let s_cnt = __engine("map_get", 0, "symbol_count") as usize;

    let tgt = TargetDescriptor {
        arch: arch_str,
        os: os_str,
        pointer_bytes: ptr_bytes,
        endian: endian_str,
        backend: be_str,
        simd_width_bits: simd_bits,
        cache_line_bytes: cache_bytes,
        opt_level: opt_lvl,
    };

    return CompileEnvView {
        target: tgt,
        is_comptime: is_comp,
        unit_count: if u_cnt > 0 { u_cnt } else { 1 },
        symbol_count: s_cnt,
    };
}



