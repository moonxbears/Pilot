// =========================================================================
// 4. REFLECTION API (O(1) Queries with Dynamic Engine Delegation)
// =========================================================================

pub fn reflect_category_scope(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 1);
    if live != null && live != "" {
        return live;
    }
    // 2. O(1) fallback from the global reflection table:
    if cat_id >= 0 && cat_id < CATEGORY_SCOPES.len {
        return CATEGORY_SCOPES[cat_id];
    }
    return "keyword.other.pilot";
}

pub fn reflect_category_badge(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 2);
    if live != null && live != "" {
        return live;
    }
    // 2. O(1) fallback from the global reflection table:
    if cat_id >= 0 && cat_id < CATEGORY_BADGES.len {
        return CATEGORY_BADGES[cat_id];
    }
    return "Keyword";
}

pub fn reflect_keyword_doc(cat_id: i64, word: str) -> str {
    // 1. Query compiler dynamic registry for exact doc:
    let live = __engine(ReflectEngine.query_sym, cat_id, 3, word);
    if live != null && live != "" {
        return live;
    }
    let any_cat = __engine(ReflectEngine.query_sym, -1, 3, word);
    if any_cat != null && any_cat != "" {
        return any_cat;
    }
    return "Pilot language symbol: " + word;
}

pub fn reflect_category_words(cat_id: i64) -> str {
    // 1. Try dynamic compiler PhysicsRegistry query first:
    let live = __engine(ReflectEngine.query_sym, cat_id, 0);
    if live != null && live != "" {
        return live;
    }
    // 2. O(1) fallback from global table:
    if cat_id >= 0 && cat_id < CATEGORY_WORDS.len {
        return CATEGORY_WORDS[cat_id];
    }
    return "";
}

pub fn reflect_category(cat_id: i64) -> CategoryInfo {
    let sc = reflect_category_scope(cat_id);
    let bd = reflect_category_badge(cat_id);
    let lk = if cat_id >= 20 && cat_id <= 29 { 7 } else { 14 };
    return CategoryInfo.create(cat_id, sc, bd, lk);
}

// Fast O(1) check if an identifier is registered under a category
pub fn reflect_is_in_category(cat_id: i64, word: str) -> bool {
    let pipe_words = reflect_category_words(cat_id);
    if pipe_words == "" {
        return false;
    }
    let wlen = word.len;
    var pos = 0;
    let plen = pipe_words.len;
    while pos < plen {
        var end_pos = pos;
        while end_pos < plen && pipe_words[end_pos] != "|" {
            end_pos = end_pos + 1;
        }
        let seg_len = end_pos - pos;
        if seg_len == wlen {
            var match = true;
            var i = 0;
            while i < wlen {
                if pipe_words[pos + i] != word[i] {
                    match = false;
                    break;
                }
                i = i + 1;
            }
            if match {
                return true;
            }
        }
        pos = end_pos + 1;
    }
    return false;
}

// Queries type layout metrics from the compiler physics engine
pub fn reflect_type_layout(type_id: usize, type_name: str = "") -> TypeInfo {
    let size = __engine(ReflectEngine.layout_size, type_id);
    let lat = __engine(ReflectEngine.lattice_get, type_id);
    return TypeInfo.create(type_id, type_name, size, 8, lat as u8);
}
