// =========================================================================
// FILE: stdlib/core/bootstrap.pilot
// DECLARATIVE CORE BOOTSTRAP MANIFEST (STAGES 1..4)
// Executed by ComptimeEngine::BootstrapSnapshot on PilVirtualMachine so Rust
// never hardcodes "Pilot.Core.*" package names, stage counts, or ordering tables.
// =========================================================================
[EnforceCoreNaming]
pub pkg Pilot.Core.Bootstrap;

pub struct BootstrapStage : IValue {
    pub stage_id:   i64;
    pub ring_level: i64;
    pub rel_path:   str;
}

let bootstrap_stages = [
    0: "stdlib/core/core.pilot",
    1: "stdlib/core/file.pilot",
    2: "stdlib/core/env.pilot",
    3: "stdlib/core/operator.pilot",
    4: "stdlib/core/mem.pilot",
    5: "stdlib/core/option.pilot",
    6: "stdlib/core/result.pilot",
    7: "stdlib/core/task.pilot",
    8: "stdlib/core/builtins/builtins.pilot",
    9: "stdlib/core/meta.pilot",
];

let bootstrap_stage_rings = [
    0: 100,
    1: 90,
    2: 90,
    3: 90,
    4: 90,
    5: 90,
    6: 90,
    7: 90,
    8: 80,
    9: 100,
];

pub pure fn bootstrap_stage_count() -> i64 {
    return bootstrap_stages.len;
}

pub pure fn bootstrap_stage_path(idx: i64) -> str {
    return bootstrap_stages[idx];
}

pub pure fn bootstrap_stage_ring(idx: i64) -> i64 {
    return bootstrap_stage_rings[idx];
}

pub pure fn bootstrap_stage_at(idx: i64) -> BootstrapStage {
    return BootstrapStage {
        stage_id:   idx + 1,
        ring_level: bootstrap_stage_ring(idx),
        rel_path:   bootstrap_stage_path(idx),
    };
}
