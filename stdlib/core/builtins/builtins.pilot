// =========================================================================
// FILE: stdlib/core/builtins/builtins.pilot
// STAGE 3E SYMBOL CONSTRUCTS (`[]`, `?`, `!`, `=>`), ALL INTEGER/FLOAT WIDTHS,
// `char`, `str`, RANGES (`..`, `..=`), TUPLES, UNIONS & `for`/`match` SYNTAX
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Builtins;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Callables.*;

// =========================================================================
// 1. TYPE-POSITION SYMBOL CONSTRUCTS (`syntax type_construct`)
// Maps concise suffix/infix symbols to canonical lowercase `[Lang]` structs
// =========================================================================
pub syntax type_construct {
    (T[])          => quote { slice<$T> };
    (T[N])         => quote { array<$T, $N> };
    (T[N, M])      => quote { grid<$T, $N, $M> };
    (T[..])        => quote { stride<$T> };
    (T[:])         => quote { ring<$T> };
    (T @ N)        => quote { simd<$T, $N> };
    (T^)           => quote { signal<$T> };
    (@T)           => quote { pin<$T> };
    (T?)           => quote { option<$T> };
    (T ! E)        => quote { result<$T, $E> };
    ((A) => R)     => quote { fn<$A, $R> };
    (T1 | T2)      => quote { union<$T1, $T2> };
}

// =========================================================================
// 2. STATEMENT & EXPRESSION SYNTAX MACROS (`for`, `while`, `until`, `unit`)
// =========================================================================
pub syntax {
    while(cond, body) => quote {
        loop {
            if !($cond) { break; }
            $body
        }
    };

    until(cond, body) => quote {
        loop {
            if $cond { break; }
            $body
        }
    };

    for(binding, iterable, body) => quote {
        {
            var __enum = ($iterable).get_enumerator();
            loop {
                if !__enum.move_next() { break; }
                let $binding = __enum.current;
                $body
            }
        }
    };

    unit(decl) => quote {
        $decl
    };
}

// =========================================================================
// 3. ZERO-FIELD SSA OPERATOR FACETS FOR SIGNED, UNSIGNED & FLOAT REGISTERS
// Spliced into every hardware register width (`i8`..`i128`, `u8`..`u128`, `f16`..`f128`)
// =========================================================================
let SignedIntSsaFacet<TSelf: IValue> = {
    pub pure:
        op +   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.add,      self, rhs);
        op -   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.sub,      self, rhs);
        op *   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.mul,      self, rhs);
        op /   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.sdiv,     self, rhs);
        op %   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.srem,     self, rhs);
        op %%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.srem_euc, self, rhs);
        op +|  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.sadd_sat, self, rhs);
        op -|  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.ssub_sat, self, rhs);
        op *|  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.smul_sat, self, rhs);
        op +%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.add_wrap, self, rhs);
        op -%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.sub_wrap, self, rhs);
        op *%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.mul_wrap, self, rhs);
        op -   ()           -> TSelf => __ssa_unary(Cfg.Ssa.neg, self);
        op &   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.and_b,    self, rhs);
        op |   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.or_b,     self, rhs);
        op ^   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.xor_b,    self, rhs);
        op ~   ()           -> TSelf => __ssa_unary(Cfg.Ssa.bitnot, self);
        op <<  (bits: u32)  -> TSelf => __ssa(Cfg.Ssa.shl,      self, bits);
        op >>  (bits: u32)  -> TSelf => __ssa(Cfg.Ssa.ashr,     self, bits);
        op ==  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.eq,       self, rhs);
        op !=  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.ne,       self, rhs);
        op <   (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.slt,      self, rhs);
        op <=  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.sle,      self, rhs);
        op >   (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.sgt,      self, rhs);
        op >=  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.sge,      self, rhs);
        op <=> (rhs: TSelf) -> order => __ssa(Cfg.Ssa.cmp3_s,   self, rhs);
        op ..< (rhs: TSelf) -> range<TSelf> => range<TSelf> { start: self, end: rhs };
        op ..  (rhs: TSelf) -> range<TSelf> => range<TSelf> { start: self, end: rhs };
        op ..= (rhs: TSelf) -> span<TSelf>  => span<TSelf>  { start: self, end: rhs };
        fn step_by(step: TSelf) -> step<TSelf> => step<TSelf> { bounds: range<TSelf> { start: self, end: self }, step_by: step };
        fn abs() -> TSelf {
            if self < (0 as TSelf) { return -self; }
            return self;
        }
};

let UnsignedIntSsaFacet<TSelf: IValue> = {
    pub pure:
        op +   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.add,      self, rhs);
        op -   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.sub,      self, rhs);
        op *   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.mul,      self, rhs);
        op /   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.udiv,     self, rhs);
        op %   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.urem,     self, rhs);
        op %%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.urem_euc, self, rhs);
        op +|  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.uadd_sat, self, rhs);
        op -|  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.usub_sat, self, rhs);
        op *|  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.umul_sat, self, rhs);
        op +%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.add_wrap, self, rhs);
        op -%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.sub_wrap, self, rhs);
        op *%  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.mul_wrap, self, rhs);
        op &   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.and_b,    self, rhs);
        op |   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.or_b,     self, rhs);
        op ^   (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.xor_b,    self, rhs);
        op ~   ()           -> TSelf => __ssa_unary(Cfg.Ssa.bitnot, self);
        op <<  (bits: u32)  -> TSelf => __ssa(Cfg.Ssa.shl,      self, bits);
        op >>  (bits: u32)  -> TSelf => __ssa(Cfg.Ssa.lshr,     self, bits);
        op ==  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.eq,       self, rhs);
        op !=  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.ne,       self, rhs);
        op <   (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.ult,      self, rhs);
        op <=  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.ule,      self, rhs);
        op >   (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.ugt,      self, rhs);
        op >=  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.uge,      self, rhs);
        op <=> (rhs: TSelf) -> order => __ssa(Cfg.Ssa.cmp3_u,   self, rhs);
        op ..< (rhs: TSelf) -> range<TSelf> => range<TSelf> { start: self, end: rhs };
        op ..  (rhs: TSelf) -> range<TSelf> => range<TSelf> { start: self, end: rhs };
        op ..= (rhs: TSelf) -> span<TSelf>  => span<TSelf>  { start: self, end: rhs };
        fn step_by(step: TSelf) -> step<TSelf> => step<TSelf> { bounds: range<TSelf> { start: self, end: self }, step_by: step };
};

let FloatSsaFacet<TSelf: IValue> = {
    pub pure:
        op +  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.fadd, self, rhs);
        op -  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.fsub, self, rhs);
        op *  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.fmul, self, rhs);
        op /  (rhs: TSelf) -> TSelf => __ssa(Cfg.Ssa.fdiv, self, rhs);
        op -  ()           -> TSelf => __ssa_unary(Cfg.Ssa.fneg, self);
        op == (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.feq,  self, rhs);
        op != (rhs: TSelf) -> bool  => !(__ssa(Cfg.Ssa.feq, self, rhs));
        op <  (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.flt,  self, rhs);
        op <= (rhs: TSelf) -> bool  => __ssa(Cfg.Ssa.fle,  self, rhs);
        op >  (rhs: TSelf) -> bool  => !(__ssa(Cfg.Ssa.fle, self, rhs));
        op >= (rhs: TSelf) -> bool  => !(__ssa(Cfg.Ssa.flt, self, rhs));
};

// =========================================================================
// 4. VALUE-TYPE RANGE ENUMERATORS (`range<T>` & `span<T>`)
// =========================================================================
pub struct {
    [Layout(c_abi)]
    RangeEnumerator<T: INumber<T>> : IEnumerator<T>, IValue {
        pub current_val: T;
        pub end_val:     T;
        pub step_val:    T;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .current_val < .end_val;
            }
            let next_v = .current_val + .step_val;
            if next_v < .end_val {
                .current_val = next_v;
                return true;
            }
            return false;
        }

        pub current: T { get => .current_val; }
    }

    [Layout(c_abi)]
    SpanEnumerator<T: INumber<T>> : IEnumerator<T>, IValue {
        pub current_val: T;
        pub end_val:     T;
        pub step_val:    T;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .current_val <= .end_val;
            }
            let next_v = .current_val + .step_val;
            if next_v <= .end_val {
                .current_val = next_v;
                return true;
            }
            return false;
        }

        pub current: T { get => .current_val; }
    }
}

// =========================================================================
// 5. ALL LOWERCASE HARDWARE SCALARS, `char`, `str`, `order`, RANGES, TUPLES & UNIONS
// =========================================================================
pub partial struct {
    // 5.1 Unit (`void`) and Bottom (`never`) Types
    [Lang(Cfg.Lang.void_t),  Bits(Cfg.Reg.b0, Cfg.Reg.gpr_u)] void  : IValue {}
    [Lang(Cfg.Lang.never_t), Bits(Cfg.Reg.b0, Cfg.Reg.gpr_u)] never : IValue {}

    // 5.2 Three-Way Comparison Ordering Result (`order`: -1 Less, 0 Equal, +1 Greater)
    [Lang(Cfg.Lang.order_t), Bits(Cfg.Reg.b8, Cfg.Reg.gpr_s)]
    order : IEquatable<order>, IComparable<order>, IValue {
        *SignedIntSsaFacet<order>;
        pub pure:
            fn is_lt() -> bool => (self as i8) < 0;
            fn is_eq() -> bool => (self as i8) == 0;
            fn is_gt() -> bool => (self as i8) > 0;
    }

    // 5.3 Complete Signed Integer Widths (`i8`, `i16`, `i32`, `i64`, `i128`, `isize`)
    [Lang(Cfg.Lang.i8_t),    Bits(Cfg.Reg.b8,   Cfg.Reg.gpr_s)] i8    : INumber<i8>,    IBitwiseOperator<i8>,    INegOperator<i8>    { *SignedIntSsaFacet<i8>; }
    [Lang(Cfg.Lang.i16_t),   Bits(Cfg.Reg.b16,  Cfg.Reg.gpr_s)] i16   : INumber<i16>,   IBitwiseOperator<i16>,   INegOperator<i16>   { *SignedIntSsaFacet<i16>; }
    [Lang(Cfg.Lang.i32_t),   Bits(Cfg.Reg.b32,  Cfg.Reg.gpr_s)] i32   : INumber<i32>,   IBitwiseOperator<i32>,   INegOperator<i32>   { *SignedIntSsaFacet<i32>; }
    [Lang(Cfg.Lang.i64_t),   Bits(Cfg.Reg.b64,  Cfg.Reg.gpr_s)] i64   : INumber<i64>,   IBitwiseOperator<i64>,   INegOperator<i64>   { *SignedIntSsaFacet<i64>; }
    [Lang(Cfg.Lang.i128_t),  Bits(Cfg.Reg.b128, Cfg.Reg.gpr_s)] i128  : INumber<i128>,  IBitwiseOperator<i128>,  INegOperator<i128>  { *SignedIntSsaFacet<i128>; }
    [Lang(Cfg.Lang.isize_t), Bits(Cfg.Reg.b64,  Cfg.Reg.gpr_s)] isize : INumber<isize>, IBitwiseOperator<isize>, INegOperator<isize> { *SignedIntSsaFacet<isize>; }

    // 5.4 Complete Unsigned Integer Widths (`u8`, `u16`, `u32`, `u64`, `u128`, plus `usize` extension)
    [Lang(Cfg.Lang.u8_t),    Bits(Cfg.Reg.b8,   Cfg.Reg.gpr_u)] u8    : INumber<u8>,    IBitwiseOperator<u8>    { *UnsignedIntSsaFacet<u8>; }
    [Lang(Cfg.Lang.u16_t),   Bits(Cfg.Reg.b16,  Cfg.Reg.gpr_u)] u16   : INumber<u16>,   IBitwiseOperator<u16>   { *UnsignedIntSsaFacet<u16>; }
    [Lang(Cfg.Lang.u32_t),   Bits(Cfg.Reg.b32,  Cfg.Reg.gpr_u)] u32   : INumber<u32>,   IBitwiseOperator<u32>   { *UnsignedIntSsaFacet<u32>; }
    [Lang(Cfg.Lang.u64_t),   Bits(Cfg.Reg.b64,  Cfg.Reg.gpr_u)] u64   : INumber<u64>,   IBitwiseOperator<u64>   { *UnsignedIntSsaFacet<u64>; }
    [Lang(Cfg.Lang.u128_t),  Bits(Cfg.Reg.b128, Cfg.Reg.gpr_u)] u128  : INumber<u128>,  IBitwiseOperator<u128>  { *UnsignedIntSsaFacet<u128>; }
    usize : INumber<usize>, IBitwiseOperator<usize> { *UnsignedIntSsaFacet<usize>; }
    bool  : IEquatable<bool>, IValue {}

    // 5.5 Complete IEEE-754 Floating-Point Widths (`f16`, `f32`, `f64`, `f128`)
    [Lang(Cfg.Lang.f16_t),   Bits(Cfg.Reg.b16,  Cfg.Reg.simd_f)] f16  : INumber<f16>,  INegOperator<f16>  { *FloatSsaFacet<f16>; }
    [Lang(Cfg.Lang.f32_t),   Bits(Cfg.Reg.b32,  Cfg.Reg.simd_f)] f32  : INumber<f32>,  INegOperator<f32>  { *FloatSsaFacet<f32>; }
    [Lang(Cfg.Lang.f64_t),   Bits(Cfg.Reg.b64,  Cfg.Reg.simd_f)] f64  : INumber<f64>,  INegOperator<f64>  { *FloatSsaFacet<f64>; }
    [Lang(Cfg.Lang.f128_t),  Bits(Cfg.Reg.b128, Cfg.Reg.simd_f)] f128 : INumber<f128>, INegOperator<f128> { *FloatSsaFacet<f128>; }

    // 5.6 32-Bit Unicode Scalar Value (`char`) — `0b00` `IValue`
    [Lang(Cfg.Lang.char_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_u)]
    char : IComparable<char>, IValue {
        pub pure:
            fn to_u32()         -> u32  => __ssa_cast(Cfg.Ssa.bitcast, self, u32);
            op == (rhs: char)   -> bool => .to_u32() == rhs.to_u32();
            op != (rhs: char)   -> bool => .to_u32() != rhs.to_u32();
            op <  (rhs: char)   -> bool => .to_u32() <  rhs.to_u32();
            op <= (rhs: char)   -> bool => .to_u32() <= rhs.to_u32();
            op >  (rhs: char)   -> bool => .to_u32() >  rhs.to_u32();
            op >= (rhs: char)   -> bool => .to_u32() >= rhs.to_u32();
            fn is_ascii()       -> bool => .to_u32() <= 0x7F;
            fn is_ascii_digit() -> bool => (.to_u32() >= 0x30) && (.to_u32() <= 0x39);
            fn is_ascii_alpha() -> bool =>
                ((.to_u32() >= 0x41) && (.to_u32() <= 0x5A)) ||
                ((.to_u32() >= 0x61) && (.to_u32() <= 0x7A));
    }

    // 5.7 Borrowed UTF-8 String View (`str`) — 16-Byte `{ ptr<u8>, usize }`, `0b01` `IReference`
    [Lang(Cfg.Lang.str_t), Layout(c_abi)]
    str : IEquatable<str>, IIndexGet<usize, u8>, IReference {
        *RawStorageBundle<u8>;
        *ContiguousViewFacet<u8>;

        pub pure:
            fn as_bytes() -> slice<u8> => slice<u8> { data: .data, len: .len };

            op [] (idx: usize) -> u8 => .data[idx];

            op [] (r: range<usize>) -> str => str {
                data: .data + r.start,
                len:  r.end - r.start,
            };

            op == (rhs: str) -> bool {
                if .len != rhs.len { return false; }
                var idx: usize = 0;
                loop {
                    if !(idx < .len) { break; }
                    if .data[idx] != rhs.data[idx] { return false; }
                    idx = idx + 1;
                }
                return true;
            }

            fn get_enumerator() -> SliceEnumerator<u8> => .as_bytes().get_enumerator();
    }

    // 5.8 Range, Span, Step, Open & Unbounded Slicing Descriptors (`range<T>`, `span<T>`, `step<T>`, `open<T>`, `after<T>`, `from<T>`, `until<T>`, `full`)
    [Lang(Cfg.Lang.range_t), Layout(c_abi)]
    range<T: INumber<T>> : IValue {
        pub start: T;
        pub end:   T;

        pub pure:
            fn contains(v: T) -> bool => (v >= .start) && (v < .end);
            fn step_by(step: T) -> step<T> => step<T> { bounds: self, step_by: step };
            fn get_enumerator() -> RangeEnumerator<T> => RangeEnumerator<T> {
                current_val: .start,
                end_val:     .end,
                step_val:    1 as T,
                has_started: false,
            };
    }

    [Lang(Cfg.Lang.span_t), Layout(c_abi)]
    span<T: INumber<T>> : IValue {
        pub start: T;
        pub end:   T;

        pub pure:
            fn contains(v: T) -> bool => (v >= .start) && (v <= .end);
            fn get_enumerator() -> SpanEnumerator<T> => SpanEnumerator<T> {
                current_val: .start,
                end_val:     .end,
                step_val:    1 as T,
                has_started: false,
            };
    }

    [Lang(Cfg.Lang.step_t), Layout(c_abi)]
    step<T: INumber<T>> : IValue {
        pub bounds:  range<T>;
        pub step_by: T;

        pub pure fn get_enumerator() -> RangeEnumerator<T> => RangeEnumerator<T> {
            current_val: .bounds.start,
            end_val:     .bounds.end,
            step_val:    .step_by,
            has_started: false,
        };
    }

    [Lang(Cfg.Lang.open_t),  Layout(c_abi)] open<T: IValue>  : IValue { pub start: T; pub end: T; }
    [Lang(Cfg.Lang.after_t), Layout(c_abi)] after<T: IValue> : IValue { pub start: T; }
    [Lang(Cfg.Lang.from_t),  Layout(c_abi)] from<T: IValue>  : IValue { pub start: T; }
    [Lang(Cfg.Lang.until_t), Layout(c_abi)] until<T: IValue> : IValue { pub end: T; }
    [Lang(Cfg.Lang.full_t),  Layout(c_abi)] full             : IValue {}

    // 5.9 Structural Heterogeneous Tuple (`tuple<T0, T1>`) & Tagged Union (`union<T1, T2>` / `T1 | T2`)
    [Lang(Cfg.Lang.tuple_t), Layout(c_abi)]
    tuple<T0: IAnyValue, T1: IAnyValue> : IValue {
        pub item0: T0;
        pub item1: T1;
    }

    [Lang(Cfg.Lang.union_t), Layout(c_abi)]
    union<T1: IAnyValue, T2: IAnyValue> : IValue {
        pub tag: u8;
        pub v1:  T1;
        pub v2:  T2;
    }

    // 5.10 Compile-Time Dimensional Quantity (`Quantity<TVal, M, S, K>`) — `0b00` `IValue`
    [Layout(transparent)]
    Quantity<TVal: INumber<TVal>, const M: i8, const S: i8, const K: i8 = 0> : IValue {
        pub value: TVal;

        pub pure:
            op + (rhs: Quantity<TVal, M, S, K>) -> Quantity<TVal, M, S, K> =>
                Quantity<TVal, M, S, K> { value: .value + rhs.value };

            op - (rhs: Quantity<TVal, M, S, K>) -> Quantity<TVal, M, S, K> =>
                Quantity<TVal, M, S, K> { value: .value - rhs.value };

            op - () -> Quantity<TVal, M, S, K> =>
                Quantity<TVal, M, S, K> { value: -.value };

            op == (rhs: Quantity<TVal, M, S, K>) -> bool => .value == rhs.value;
            op != (rhs: Quantity<TVal, M, S, K>) -> bool => .value != rhs.value;
            op <  (rhs: Quantity<TVal, M, S, K>) -> bool => .value <  rhs.value;
            op <= (rhs: Quantity<TVal, M, S, K>) -> bool => .value <= rhs.value;
            op >  (rhs: Quantity<TVal, M, S, K>) -> bool => .value >  rhs.value;
            op >= (rhs: Quantity<TVal, M, S, K>) -> bool => .value >= rhs.value;
    }
}
