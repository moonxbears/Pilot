// =========================================================================
// FILE: stdlib/core/builtins/builtins.pilot
// STAGE 3E SYMBOLIC TYPE CONSTRUCTS, COMPLETE LOWERCASE SCALAR PRIMITIVES,
// RANGES (`range`, `span`, `step`) & PURE PILOT CONTROL FLOW
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Genesis;

use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Task.*;

// -------------------------------------------------------------------------
// 1. SYMBOLIC TYPE-POSITION SHORTHAND LOWERING
// -------------------------------------------------------------------------
pub syntax type_construct {
    (T: type) []                    => quote { slice<$T> };
    (T: type) [ (N: usize) ]        => quote { array<$T, $N> };
    (T: type) [ .. ]                => quote { stride<$T> };
    (T: type) *                     => quote { ptr<$T> };
    & (T: type)                     => quote { ref<$T> };
    & var (T: type)                 => quote { var ref<$T> };
    ~ (T: type)                     => quote { iso<$T> };
    (T: type) ?                     => quote { option<$T> };
    (T: type) ! (E: type)           => quote { result<$T, $E> };
    (T1: type) | (T2: type)         => quote { union<$T1, $T2> };
    (TArgs: type) => (TOut: type)   => quote { fn<$TArgs, $TOut> };
}

// -------------------------------------------------------------------------
// 2. REUSABLE TIER-2 SSA OPERATOR FACETS (0 Stored Fields -> `partial` Safe)
// -------------------------------------------------------------------------
// Shared by all signed integers: `i8`, `i16`, `i32`, `i64`, `i128`, `isize`
let SignedIntSsaFacet = {
    pub pure:
        op +   (rhs: Self) -> Self => __ssa(Cfg.Ssa.add,    self, rhs);
        op -   (rhs: Self) -> Self => __ssa(Cfg.Ssa.sub,    self, rhs);
        op *   (rhs: Self) -> Self => __ssa(Cfg.Ssa.mul,    self, rhs);
        op /   (rhs: Self) -> Self => __ssa(Cfg.Ssa.sdiv,   self, rhs);
        op %   (rhs: Self) -> Self => __ssa(Cfg.Ssa.srem,   self, rhs);
        op -   ()          -> Self => __ssa_unary(Cfg.Ssa.neg, self);
        op &   (rhs: Self) -> Self => __ssa(Cfg.Ssa.and_b,  self, rhs);
        op |   (rhs: Self) -> Self => __ssa(Cfg.Ssa.or_b,   self, rhs);
        op ^   (rhs: Self) -> Self => __ssa(Cfg.Ssa.xor_b,  self, rhs);
        op ~   ()          -> Self => __ssa_unary(Cfg.Ssa.bitnot, self);
        op <<  (rhs: usize)-> Self => __ssa(Cfg.Ssa.shl,    self, __ssa_cast(Cfg.Ssa.trunc, rhs, Self));
        op >>  (rhs: usize)-> Self => __ssa(Cfg.Ssa.ashr,   self, __ssa_cast(Cfg.Ssa.trunc, rhs, Self));
        op ==  (rhs: Self) -> bool => __ssa(Cfg.Ssa.eq,     self, rhs);
        op !=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.ne,     self, rhs);
        op <   (rhs: Self) -> bool => __ssa(Cfg.Ssa.slt,    self, rhs);
        op <=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.sle,    self, rhs);
        op >   (rhs: Self) -> bool => __ssa(Cfg.Ssa.sgt,    self, rhs);
        op >=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.sge,    self, rhs);
        op ..< (end: Self) -> range<Self> => range<Self> { start: self, end: end };
        op ..  (end: Self) -> span<Self>  => span<Self>  { start: self, end: end };
        op ..= (end: Self) -> span<Self>  => span<Self>  { start: self, end: end };
        fn step_by(end: Self, stride: Self) -> step<Self> => step<Self> { start: self, end: end, stride: stride };
};

// Shared by all unsigned integers: `u8`, `u16`, `u32`, `u64`, `u128`, `usize`
let UnsignedIntSsaFacet = {
    pub pure:
        op +   (rhs: Self) -> Self => __ssa(Cfg.Ssa.add,    self, rhs);
        op -   (rhs: Self) -> Self => __ssa(Cfg.Ssa.sub,    self, rhs);
        op *   (rhs: Self) -> Self => __ssa(Cfg.Ssa.mul,    self, rhs);
        op /   (rhs: Self) -> Self => __ssa(Cfg.Ssa.udiv,   self, rhs);
        op %   (rhs: Self) -> Self => __ssa(Cfg.Ssa.urem,   self, rhs);
        op &   (rhs: Self) -> Self => __ssa(Cfg.Ssa.and_b,  self, rhs);
        op |   (rhs: Self) -> Self => __ssa(Cfg.Ssa.or_b,   self, rhs);
        op ^   (rhs: Self) -> Self => __ssa(Cfg.Ssa.xor_b,  self, rhs);
        op ~   ()          -> Self => __ssa_unary(Cfg.Ssa.bitnot, self);
        op <<  (rhs: usize)-> Self => __ssa(Cfg.Ssa.shl,    self, __ssa_cast(Cfg.Ssa.trunc, rhs, Self));
        op >>  (rhs: usize)-> Self => __ssa(Cfg.Ssa.lshr,   self, __ssa_cast(Cfg.Ssa.trunc, rhs, Self));
        op ==  (rhs: Self) -> bool => __ssa(Cfg.Ssa.eq,     self, rhs);
        op !=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.ne,     self, rhs);
        op <   (rhs: Self) -> bool => __ssa(Cfg.Ssa.ult,    self, rhs);
        op <=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.ule,    self, rhs);
        op >   (rhs: Self) -> bool => __ssa(Cfg.Ssa.ugt,    self, rhs);
        op >=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.uge,    self, rhs);
        op ..< (end: Self) -> range<Self> => range<Self> { start: self, end: end };
        op ..  (end: Self) -> span<Self>  => span<Self>  { start: self, end: end };
        op ..= (end: Self) -> span<Self>  => span<Self>  { start: self, end: end };
        fn step_by(end: Self, stride: Self) -> step<Self> => step<Self> { start: self, end: end, stride: stride };
};

// Shared by all IEEE-754 floats: `f16`, `f32`, `f64`, `f128`
let FloatSsaFacet = {
    pub pure:
        op +   (rhs: Self) -> Self => __ssa(Cfg.Ssa.fadd,   self, rhs);
        op -   (rhs: Self) -> Self => __ssa(Cfg.Ssa.fsub,   self, rhs);
        op *   (rhs: Self) -> Self => __ssa(Cfg.Ssa.fmul,   self, rhs);
        op /   (rhs: Self) -> Self => __ssa(Cfg.Ssa.fdiv,   self, rhs);
        op -   ()          -> Self => __ssa_unary(Cfg.Ssa.fneg, self);
        op ==  (rhs: Self) -> bool => __ssa(Cfg.Ssa.feq,    self, rhs);
        op !=  (rhs: Self) -> bool => !(__ssa(Cfg.Ssa.feq,  self, rhs));
        op <   (rhs: Self) -> bool => __ssa(Cfg.Ssa.flt,    self, rhs);
        op <=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.fle,    self, rhs);
        op >   (rhs: Self) -> bool => __ssa(Cfg.Ssa.flt,    rhs,  self);
        op >=  (rhs: Self) -> bool => __ssa(Cfg.Ssa.fle,    rhs,  self);
};

// -------------------------------------------------------------------------
// 3. RANGE, SPAN & STEP VALUE ENUMERATORS
// -------------------------------------------------------------------------
pub struct {
    [Layout(c_abi)]
    RangeEnumerator<TBound: IComparable<TBound>, IAddOperator<TBound>> : IEnumerator<TBound>, IValue {
        pub current_val: TBound;
        pub end_val:     TBound;
        pub step_one:    TBound;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .current_val < .end_val;
            }
            let next_val = .current_val + .step_one;
            if next_val < .end_val {
                .current_val = next_val;
                return true;
            }
            return false;
        }

        pub current: TBound { get => .current_val; }
    }

    [Layout(c_abi)]
    SpanEnumerator<TBound: IComparable<TBound>, IAddOperator<TBound>> : IEnumerator<TBound>, IValue {
        pub current_val: TBound;
        pub end_val:     TBound;
        pub step_one:    TBound;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .current_val <= .end_val;
            }
            if .current_val == .end_val {
                return false;
            }
            let next_val = .current_val + .step_one;
            if next_val <= .end_val {
                .current_val = next_val;
                return true;
            }
            return false;
        }

        pub current: TBound { get => .current_val; }
    }

    [Layout(c_abi)]
    StepEnumerator<TBound: IComparable<TBound>, IAddOperator<TBound>> : IEnumerator<TBound>, IValue {
        pub current_val: TBound;
        pub end_val:     TBound;
        pub stride_val:  TBound;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .current_val <= .end_val;
            }
            let next_val = .current_val + .stride_val;
            if next_val <= .end_val {
                .current_val = next_val;
                return true;
            }
            return false;
        }

        pub current: TBound { get => .current_val; }
    }
}

// -------------------------------------------------------------------------
// 4. COMPLETE LOWERCASE PRIMITIVE DECLARATIONS
// -------------------------------------------------------------------------
pub partial struct {
    [Lang(Cfg.Lang.void_t),  Bits(Cfg.Reg.b0,  Cfg.Reg.gpr_u)] void  : IValue {}
    [Lang(Cfg.Lang.never_t), Bits(Cfg.Reg.b0,  Cfg.Reg.gpr_u)] never : IValue {}

    // Upgrade seed `bool` and `usize` with their full Stage 2 Interface conformances:
    bool  : IEquatable<bool>, IBitAndOperator<bool>, IBitOrOperator<bool>, IBitXorOperator<bool>, IValue {}
    usize : IComparable<usize>, IAddOperator<usize>, ISubOperator<usize>, IMulOperator<usize>, IDivOperator<usize>, IRemOperator<usize>, IBitAndOperator<usize>, IBitOrOperator<usize>, IBitXorOperator<usize>, IBitNotOperator<usize>, IShlOperator<usize>, IShrOperator<usize>, IRangeOperator<usize>, ISpanOperator<usize>, IStepOperator<usize>, IValue {
        *UnsignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.char_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_u)]
    char : IComparable<char>, IValue {
        pub pure:
            op == (rhs: char) -> bool => __ssa(Cfg.Ssa.eq,  self, rhs);
            op != (rhs: char) -> bool => __ssa(Cfg.Ssa.ne,  self, rhs);
            op <  (rhs: char) -> bool => __ssa(Cfg.Ssa.ult, self, rhs);
            op <= (rhs: char) -> bool => __ssa(Cfg.Ssa.ule, self, rhs);
            op >  (rhs: char) -> bool => __ssa(Cfg.Ssa.ugt, self, rhs);
            op >= (rhs: char) -> bool => __ssa(Cfg.Ssa.uge, self, rhs);
            fn code_point()   -> u32  => __ssa_cast(Cfg.Ssa.bitcast, self, u32);
    }

    // Signed Integer Primitives (`i8`, `i16`, `i32`, `i64`, `i128`, `isize`)
    [Lang(Cfg.Lang.i8_t), Bits(Cfg.Reg.b8, Cfg.Reg.gpr_s)]
    i8 : IComparable<i8>, IAddOperator<i8>, ISubOperator<i8>, IMulOperator<i8>, IDivOperator<i8>, IRemOperator<i8>, INegOperator<i8>, IBitAndOperator<i8>, IBitOrOperator<i8>, IBitXorOperator<i8>, IBitNotOperator<i8>, IShlOperator<usize, i8>, IShrOperator<usize, i8>, IRangeOperator<i8>, ISpanOperator<i8>, IStepOperator<i8>, IValue {
        *SignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.i16_t), Bits(Cfg.Reg.b16, Cfg.Reg.gpr_s)]
    i16 : IComparable<i16>, IAddOperator<i16>, ISubOperator<i16>, IMulOperator<i16>, IDivOperator<i16>, IRemOperator<i16>, INegOperator<i16>, IBitAndOperator<i16>, IBitOrOperator<i16>, IBitXorOperator<i16>, IBitNotOperator<i16>, IShlOperator<usize, i16>, IShrOperator<usize, i16>, IRangeOperator<i16>, ISpanOperator<i16>, IStepOperator<i16>, IValue {
        *SignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.i32_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_s)]
    i32 : IComparable<i32>, IAddOperator<i32>, ISubOperator<i32>, IMulOperator<i32>, IDivOperator<i32>, IRemOperator<i32>, INegOperator<i32>, IBitAndOperator<i32>, IBitOrOperator<i32>, IBitXorOperator<i32>, IBitNotOperator<i32>, IShlOperator<usize, i32>, IShrOperator<usize, i32>, IRangeOperator<i32>, ISpanOperator<i32>, IStepOperator<i32>, IValue {
        *SignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.i64_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_s)]
    i64 : IComparable<i64>, IAddOperator<i64>, ISubOperator<i64>, IMulOperator<i64>, IDivOperator<i64>, IRemOperator<i64>, INegOperator<i64>, IBitAndOperator<i64>, IBitOrOperator<i64>, IBitXorOperator<i64>, IBitNotOperator<i64>, IShlOperator<usize, i64>, IShrOperator<usize, i64>, IRangeOperator<i64>, ISpanOperator<i64>, IStepOperator<i64>, IValue {
        *SignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.i128_t), Bits(Cfg.Reg.b128, Cfg.Reg.gpr_s)]
    i128 : IComparable<i128>, IAddOperator<i128>, ISubOperator<i128>, IMulOperator<i128>, IDivOperator<i128>, IRemOperator<i128>, INegOperator<i128>, IBitAndOperator<i128>, IBitOrOperator<i128>, IBitXorOperator<i128>, IBitNotOperator<i128>, IShlOperator<usize, i128>, IShrOperator<usize, i128>, IRangeOperator<i128>, ISpanOperator<i128>, IStepOperator<i128>, IValue {
        *SignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.isize_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_s)]
    isize : IComparable<isize>, IAddOperator<isize>, ISubOperator<isize>, IMulOperator<isize>, IDivOperator<isize>, IRemOperator<isize>, INegOperator<isize>, IBitAndOperator<isize>, IBitOrOperator<isize>, IBitXorOperator<isize>, IBitNotOperator<isize>, IShlOperator<usize, isize>, IShrOperator<usize, isize>, IRangeOperator<isize>, ISpanOperator<isize>, IStepOperator<isize>, IValue {
        *SignedIntSsaFacet;
    }

    // Unsigned Integer Primitives (`u8`, `u16`, `u32`, `u64`, `u128`)
    [Lang(Cfg.Lang.u8_t), Bits(Cfg.Reg.b8, Cfg.Reg.gpr_u)]
    u8 : IComparable<u8>, IAddOperator<u8>, ISubOperator<u8>, IMulOperator<u8>, IDivOperator<u8>, IRemOperator<u8>, IBitAndOperator<u8>, IBitOrOperator<u8>, IBitXorOperator<u8>, IBitNotOperator<u8>, IShlOperator<usize, u8>, IShrOperator<usize, u8>, IRangeOperator<u8>, ISpanOperator<u8>, IStepOperator<u8>, IValue {
        *UnsignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.u16_t), Bits(Cfg.Reg.b16, Cfg.Reg.gpr_u)]
    u16 : IComparable<u16>, IAddOperator<u16>, ISubOperator<u16>, IMulOperator<u16>, IDivOperator<u16>, IRemOperator<u16>, IBitAndOperator<u16>, IBitOrOperator<u16>, IBitXorOperator<u16>, IBitNotOperator<u16>, IShlOperator<usize, u16>, IShrOperator<usize, u16>, IRangeOperator<u16>, ISpanOperator<u16>, IStepOperator<u16>, IValue {
        *UnsignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.u32_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_u)]
    u32 : IComparable<u32>, IAddOperator<u32>, ISubOperator<u32>, IMulOperator<u32>, IDivOperator<u32>, IRemOperator<u32>, IBitAndOperator<u32>, IBitOrOperator<u32>, IBitXorOperator<u32>, IBitNotOperator<u32>, IShlOperator<usize, u32>, IShrOperator<usize, u32>, IRangeOperator<u32>, ISpanOperator<u32>, IStepOperator<u32>, IValue {
        *UnsignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.u64_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)]
    u64 : IComparable<u64>, IAddOperator<u64>, ISubOperator<u64>, IMulOperator<u64>, IDivOperator<u64>, IRemOperator<u64>, IBitAndOperator<u64>, IBitOrOperator<u64>, IBitXorOperator<u64>, IBitNotOperator<u64>, IShlOperator<usize, u64>, IShrOperator<usize, u64>, IRangeOperator<u64>, ISpanOperator<u64>, IStepOperator<u64>, IValue {
        *UnsignedIntSsaFacet;
    }

    [Lang(Cfg.Lang.u128_t), Bits(Cfg.Reg.b128, Cfg.Reg.gpr_u)]
    u128 : IComparable<u128>, IAddOperator<u128>, ISubOperator<u128>, IMulOperator<u128>, IDivOperator<u128>, IRemOperator<u128>, IBitAndOperator<u128>, IBitOrOperator<u128>, IBitXorOperator<u128>, IBitNotOperator<u128>, IShlOperator<usize, u128>, IShrOperator<usize, u128>, IRangeOperator<u128>, ISpanOperator<u128>, IStepOperator<u128>, IValue {
        *UnsignedIntSsaFacet;
    }

    // IEEE-754 Floating-Point Primitives (`f16`, `f32`, `f64`, `f128`)
    [Lang(Cfg.Lang.f16_t), Bits(Cfg.Reg.b16, Cfg.Reg.simd_f)]
    f16 : IComparable<f16>, IAddOperator<f16>, ISubOperator<f16>, IMulOperator<f16>, IDivOperator<f16>, INegOperator<f16>, IValue {
        *FloatSsaFacet;
    }

    [Lang(Cfg.Lang.f32_t), Bits(Cfg.Reg.b32, Cfg.Reg.simd_f)]
    f32 : IComparable<f32>, IAddOperator<f32>, ISubOperator<f32>, IMulOperator<f32>, IDivOperator<f32>, INegOperator<f32>, IValue {
        *FloatSsaFacet;
    }

    [Lang(Cfg.Lang.f64_t), Bits(Cfg.Reg.b64, Cfg.Reg.simd_f)]
    f64 : IComparable<f64>, IAddOperator<f64>, ISubOperator<f64>, IMulOperator<f64>, IDivOperator<f64>, INegOperator<f64>, IValue {
        *FloatSsaFacet;
    }

    [Lang(Cfg.Lang.f128_t), Bits(Cfg.Reg.b128, Cfg.Reg.simd_f)]
    f128 : IComparable<f128>, IAddOperator<f128>, ISubOperator<f128>, IMulOperator<f128>, IDivOperator<f128>, INegOperator<f128>, IValue {
        *FloatSsaFacet;
    }

    // UTF-8 String View (`str` — 14-byte inline SSO in `PilotVal` or `{ ptr<u8>, usize }`, `0b01` `IReference`)
    [Lang(Cfg.Lang.str_t), Layout(c_abi)]
    str : IReadOnlyList<u8>, IEquatable<str>, IReference {
        *RawStorageBundle<u8>;
        *ContiguousViewFacet<u8>;

        pub pure:
            op [] (idx: usize) -> u8 => .data[idx];

            op == (rhs: str) -> bool {
                if .len != rhs.len { return false; }
                var idx: usize = 0;
                loop {
                    if !(idx < .len) { break; }
                    if .data[idx] != rhs.data[idx] { return false; }
                    idx = idx + 1;
                }
                return true;
            }

            fn as_bytes() -> slice<u8> => slice<u8> { data: .data, len: .len };
            fn get_enumerator() -> SliceEnumerator<u8> => .as_bytes().get_enumerator();
    }

    // Algebraic Product & Sum Canonical Backing Primitives (`tuple`, `union`)
    [Lang(Cfg.Lang.tuple_t), Layout(c_abi)] tuple<T0: IAnyValue, T1: IAnyValue> : IValue { pub item0: T0; pub item1: T1; }
    [Lang(Cfg.Lang.union_t), Layout(c_abi)] union<T0: IAnyValue, T1: IAnyValue> : IValue { pub tag: u8; }

    // Single-Word Lowercase Range & Slice Bound Primitives (`range`, `span`, `step`, `from`, `until`, `full`)
    [Lang(Cfg.Lang.range_t), Layout(c_abi)]
    range<T: IComparable<T>, IAddOperator<T>> : IEnumerable<T>, IValue {
        pub start: T;
        pub end:   T;

        pub pure:
            fn contains(val: T) -> bool => (val >= .start) & (val < .end);
            fn get_enumerator() -> RangeEnumerator<T> => RangeEnumerator<T> {
                current_val: .start,
                end_val:     .end,
                step_one:    __ssa_cast(Cfg.Ssa.zext, 1, T),
                has_started: false,
            };
    }

    [Lang(Cfg.Lang.span_t), Layout(c_abi)]
    span<T: IComparable<T>, IAddOperator<T>> : IEnumerable<T>, IValue {
        pub start: T;
        pub end:   T;

        pub pure:
            fn contains(val: T) -> bool => (val >= .start) & (val <= .end);
            fn get_enumerator() -> SpanEnumerator<T> => SpanEnumerator<T> {
                current_val: .start,
                end_val:     .end,
                step_one:    __ssa_cast(Cfg.Ssa.zext, 1, T),
                has_started: false,
            };
    }

    [Lang(Cfg.Lang.step_t), Layout(c_abi)]
    step<T: IComparable<T>, IAddOperator<T>> : IEnumerable<T>, IValue {
        pub start:  T;
        pub end:    T;
        pub stride: T;

        pub pure fn get_enumerator() -> StepEnumerator<T> => StepEnumerator<T> {
            current_val: .start,
            end_val:     .end,
            stride_val:  .stride,
            has_started: false,
        };
    }

    [Lang(Cfg.Lang.from_t),  Layout(c_abi)] from<T: IComparable<T>>  : IValue { pub start: T; }
    [Lang(Cfg.Lang.until_t), Layout(c_abi)] until<T: IComparable<T>> : IValue { pub end:   T; }
    [Lang(Cfg.Lang.full_t),  Layout(c_abi)] full                     : IValue {}
}

// -------------------------------------------------------------------------
// 5. PURE PILOT CONTROL-FLOW MACROS (`while`, `with`, & `IEnumerable` `for`)
// -------------------------------------------------------------------------
pub syntax {
    while(cond, body) => quote {
        loop {
            if !($cond) { break; }
            $body
        }
    };

    with(res_binding, body) => quote {
        {
            var __res = $res_binding;
            defer ~__res;
            $body
        }
    };
}
