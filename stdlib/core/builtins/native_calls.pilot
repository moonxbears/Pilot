// =========================================================================
// FILE: stdlib/core/builtins/native_calls.pilot
// NAMES THE SEED ANSWERS WITH ENGINE INTRINSICS
// =========================================================================
// The seed runs these calls, methods, properties and values directly with
// the engine intrinsic each one is bound to here. A user-declared function or
// method of the same name takes precedence over a native method.
//
// `List<T>` (stdlib/core/primitives/list.pilot) and `Map<K, V>`
// (stdlib/core/primitives/map.pilot) state their surface in Pilot; their
// layout over raw memory runs once the seed runs native code (F6). Until
// then their constructors build the engine's own list and map, and the
// methods below act on those.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Builtins.NativeCalls;

use Pilot.Core.Genesis.*;

comptime {
    // Functions: `name(args)`.
    bind_native_fn(nameof(print),   "rt_print");
    bind_native_fn(nameof(println), "rt_print");
    bind_native_fn(nameof(eprint),  "rt_eprint");
    bind_native_fn(nameof(List),    "list_new");
    bind_native_fn(nameof(Map),     "map_new");
    // `seam("id", "note")`: an intentionally unconnected entry or exit point.
    // It always fails; every call is listed in `selfhost/gate/ledger/seams.pilot`.
    bind_native_fn(nameof(seam),    "seam_open");
    // `fault("CODE: message")`: stops the program with the message as
    // written (stdlib/core/hint.pilot); never returns.
    bind_native_fn(nameof(fault),   "rt_fault");
    // `from_utf8(bytes)`: the str whose UTF-8 bytes are `bytes` (each 0 to
    // 255), or none when they are not valid UTF-8 (RFC 3629).
    bind_native_fn(nameof(from_utf8), "str_from_bytes");
    // Stage-A generator & marshalling helpers bound for pure-Pilot callers:
    bind_native_fn(nameof(__gen_resume),             "gen_resume");
    bind_native_fn(nameof(__gen_done),               "gen_done");
    bind_native_fn(nameof(__gen_close),              "gen_close");
    bind_native_fn(nameof(__gen_current),            "gen_current");
    bind_native_fn(nameof(str_copy_to_ptr),          "str_copy_to_ptr");
    bind_native_fn(nameof(str_from_ptr),             "str_from_ptr");
    bind_native_fn(nameof(vm_thread_entry_ptr),      "vm_thread_entry_ptr");
    bind_native_fn(nameof(vm_callback_dispatch_ptr), "vm_callback_dispatch_ptr");

    // Methods on strings, lists and records: `value.name(args)`.
    bind_native_method(nameof(len),         "str_len");
    // A `Map` receiver of known type calls its owner methods
    // (stdlib/core/primitives/map.pilot, PROP-002b). These name-wide bindings
    // remain for receivers the seed cannot type (a field of a struct, a
    // call's result), until the seed types them or the tools that hold such
    // receivers (the loader's file list in crates/pilot-cli/src/run.rs) link
    // map.pilot.
    bind_native_method(nameof(get),         "map_get");
    bind_native_method(nameof(set),         "map_set");
    bind_native_method(nameof(has),         "map_has");
    bind_native_method(nameof(keys),        "map_keys");
    bind_native_method(nameof(remove),      "map_remove");
    bind_native_method(nameof(push),        "list_push");
    bind_native_method(nameof(pop),         "list_pop");
    bind_native_method(nameof(remove_at),   "list_remove_at");
    bind_native_method(nameof(trim),        "str_trim");
    bind_native_method(nameof(to_str),      "to_str");
    bind_native_method(nameof(byte_at),     "str_byte_at");
    bind_native_method(nameof(slice),       "str_slice");
    bind_native_method(nameof(substring),   "str_slice");
    bind_native_method(nameof(find),        "str_find");
    bind_native_method(nameof(index_of),    "str_find");
    bind_native_method(nameof(replace),     "str_replace");
    bind_native_method(nameof(contains),    "str_contains");
    bind_native_method(nameof(starts_with), "str_starts_with");
    bind_native_method(nameof(ends_with),   "str_ends_with");
    bind_native_method(nameof(is_null),     "is_null");

    // Properties: `value.name`, when the value has no field of that name.
    bind_native_property(nameof(len), "str_len");

    // Values: the program environment record.
    bind_native_value(nameof(ENV), "get_env");

    // Compile-time questions about a type argument.
    bind_type_query(nameof(sizeof), "byte_size");
    // Asked but not answered yet (docs/keyword_roadmap.md K4): the seed
    // stops each with SEED001 and PilIR at its lowering seam.
    bind_type_query(nameof(alignof),   "byte_align");
    bind_type_query(nameof(offsetof),  "field_offset");
    bind_type_query(nameof(fields_of), "field_list");

    // Members of a type the engine holds by itself, named per type: the
    // seed indexes its own lists directly; the PilIR lowering
    // (selfhost/ir/lower.pilot) reads these to name the engine operation.
    bind_native_member(nameof(List), "[]",  "list_get");
    bind_native_member(nameof(List), "[]=", "list_set");
    // `Map`'s `op []` and `op []=` call its owner methods on the seed, but
    // the PilIR lowering does not lower a type's indexer to its method yet,
    // so it still names the engine operation from these (PROP-002b).
    bind_native_member(nameof(Map),  "[]",  "map_get");
    bind_native_member(nameof(Map),  "[]=", "map_set");
    // The seed holds a slice as its own list; the PilIR lowering indexes it
    // the same way (stand-in `ir.engine_sequence_for`).
    bind_native_member(nameof(slice), "[]",  "list_get");
    // The seed holds a `map<K, V>` as its own map, read and written by key.
    bind_native_member(nameof(map), "[]",  "map_get");
    bind_native_member(nameof(map), "[]=", "map_set");
    // Membership (`x in y`) and native iteration (`for x in y`) per type.
    bind_native_member(nameof(str), "in",      "str_contains");
    bind_native_member(nameof(Map), "in",      "map_has");
    bind_native_member(nameof(map), "in",      "map_has");
    bind_native_member(nameof(Map), "for_seq", "map_keys");
    bind_native_member(nameof(Map), "for_len", "str_len");
    bind_native_member(nameof(Map), "for_get", "list_get");
    bind_native_member(nameof(map), "for_seq", "map_keys");
    bind_native_member(nameof(map), "for_len", "str_len");
    bind_native_member(nameof(map), "for_get", "list_get");
    bind_native_member(nameof(str), "for_len", "str_len");
    bind_native_member(nameof(str), "for_get", "str_byte_at");
    bind_native_member(nameof(List), "for_len", "str_len");
    bind_native_member(nameof(List), "for_get", "list_get");
    bind_native_member(nameof(slice), "for_len", "str_len");
    bind_native_member(nameof(slice), "for_get", "list_get");
    // An operator with no PilIR instruction of its own runs as an engine
    // operation: `a ** b` (an integer power wraps; a float power is `powf`).
    bind_operator_intrinsic("**", "num_pow");
    // The test for an absent value (`a ?? b`): the seed holds none as its
    // null (stand-in `ir.absent_as_null`).
    bind_absent_test("is_null");
    // `x[a..b]` (and `x[a..=b]`, one further): the seed slices a string or a
    // list with one engine operation, from `a` up to `b`.
    bind_range_index("str_slice");
    // Slice patterns (`[a, ..rest, z]`): a list's length, its element at an
    // index, and its part between two indices. Record patterns on a value
    // that is no struct (`{ "key": p }`): whether a key is there, and its value.
    bind_slice_pattern("str_len", "list_get", "str_slice");
    bind_record_pattern("map_has", "map_get");
    // A list literal `[a, b]` is `List()` followed by `push(a)`, `push(b)`.
    bind_list_literal(nameof(List), nameof(push));
    // Inside a list literal, `*xs` appends xs's elements and `*..xs` its
    // leaves at any depth: the engine's `list_extend(list, xs, deep)`.
    bind_list_splat(nameof(List), "list_extend");
    // A map literal `["k": v]` (or `{k: v}`) is `Map()` followed by `set(k, v)`.
    bind_map_literal(nameof(Map), nameof(set));
}

// The member each prefix operator calls on a struct that declares it
// (PROP-018, PROP-022 slice 22A): `-x`, `~x`, `!x`, and the unpack sigils
// `*x`, `**x`, `*..x`. A primitive's prefix operator stays its machine op.
// The keys are the Rust parser's unary flags (`prefix_flag`,
// crates/pilot-parser/src/expr.rs), so this table only translates Rust's
// numbering into Pilot's member names; it goes when the Pilot parser
// (PROP-025) builds a prefix use from the `op` declaration itself
// (PROP-022 §3). The checker (selfhost/check/infer.pilot `PREFIX_OP_TABLE`),
// PilIR and the seed all read it.
[StandIn("parse.prefix_flag_table", "a prefix operator use names the `op` member it calls, found from the operator's own declaration", "the Rust parser records only a unary flag number, and this table maps each flag to a member name", "PROP-025")]
comptime {
    bind_native_member("prefix_op", "0", "-_");
    bind_native_member("prefix_op", "4", "~_");
    bind_native_member("prefix_op", "5", "!_");
    bind_native_member("prefix_op", "6", "*_");
    bind_native_member("prefix_op", "7", "**_");
    bind_native_member("prefix_op", "8", "*.._");
}
