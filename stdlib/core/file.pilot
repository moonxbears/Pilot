// =========================================================================
// FILE: stdlib/core/file.pilot
// FREESTANDING CORE FILE SYSTEM STRUCT (`File`, 0b00 IValue)
// Encapsulates hardware host filesystem operations within core boundary.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.File;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.OsAbi;
use Pilot.Core.Bridge.Os;

fn file_path_buf(path: str) -> i64 {
    let n = path.len();
    let cap = if n > 0 { n } else { 1 };
    let buf = os_slab_alloc(cap, 1);
    if n > 0 { let _ = str_copy_to_ptr(path, buf); }
    return buf;
}

fn file_sort_strs(ref items: List<str>) {
    var i = 1;
    while i < items.len() {
        let key = items[i];
        var j = i;
        while j > 0 && items[j - 1] > key {
            items[j] = items[j - 1];
            j = j - 1;
        }
        items[j] = key;
        i = i + 1;
    }
}

fn file_join_lines(items: List<str>) -> str {
    var out = "";
    var i = 0;
    while i < items.len() {
        if i > 0 { out = out + "\n"; }
        out = out + items[i];
        i = i + 1;
    }
    return out;
}

fn file_join_path(dir: str, name: str) -> str {
    if dir == "" || dir == "." { return name; }
    if dir.ends_with("/") { return dir + name; }
    return dir + "/" + name;
}

fn file_read_dir_entries(path: str, ref dirs: List<str>, ref files: List<str>) -> bool {
    if path == "" { return false; }
    let pbuf = file_path_buf(path);
    let out_len_ptr = os_slab_alloc(8, 8);
    var cap = 16384;
    var obuf = os_slab_alloc(cap, 8);
    var rc = os_fs_read_dir(pbuf, path.len(), obuf, cap, out_len_ptr);
    while rc == -44 {
        let next_cap = cap * 2;
        obuf = os_slab_realloc(obuf, cap, next_cap, 8);
        cap = next_cap;
        rc = os_fs_read_dir(pbuf, path.len(), obuf, cap, out_len_ptr);
    }
    let _ = os_slab_free(pbuf, path.len(), 1);
    let n = os_load_int(out_len_ptr, 64, 0);
    let _ = os_slab_free(out_len_ptr, 8, 8);
    if rc < 0 {
        let _ = os_slab_free(obuf, cap, 8);
        return false;
    }
    var off = 0;
    while off + 3 <= n {
        let kind = os_load_int(obuf + off, 8, 0);
        let lo = os_load_int(obuf + off + 1, 8, 0);
        let hi = os_load_int(obuf + off + 2, 8, 0);
        let nlen = lo + hi * 256;
        off = off + 3;
        if off + nlen > n { break; }
        let name = str_from_ptr(obuf + off, nlen);
        off = off + nlen;
        if name != "." && name != ".." {
            if kind == 2 { dirs.push(name); }
            else { files.push(name); }
        }
    }
    let _ = os_slab_free(obuf, cap, 8);
    return true;
}

fn file_walk_rec(dir: str, ref out: List<str>) {
    var dirs: List<str> = [];
    var files: List<str> = [];
    if !file_read_dir_entries(dir, dirs, files) { return; }
    for f in files { out.push(file_join_path(dir, f)); }
    for d in dirs { file_walk_rec(file_join_path(dir, d), out); }
}

fn file_ensure_parent_dirs(path: str) {
    var last_slash = -1;
    var i = path.len() - 1;
    while i >= 0 {
        if path.byte_at(i) == 47 { last_slash = i; break; }
        i = i - 1;
    }
    if last_slash <= 0 { return; }
    let pbuf = file_path_buf(path);
    let _ = os_fs_mkdir(pbuf, last_slash, 1, 493);
    let _ = os_slab_free(pbuf, path.len(), 1);
}

[KeywordDefAttr(30, "Freestanding core filesystem interface for file I/O operations.")]
pub struct File : IValue {
    pub static fn exists(path: str) -> bool {
        if path == "" { return false; }
        let pbuf = file_path_buf(path);
        let sbuf = os_slab_alloc(72, 8);
        let rc = os_fs_stat(1, pbuf, path.len(), sbuf);
        let _ = os_slab_free(sbuf, 72, 8);
        let _ = os_slab_free(pbuf, path.len(), 1);
        return rc >= 0;
    }

    pub static fn read_text(path: str) -> str {
        if path == "" { return ""; }
        let pbuf = file_path_buf(path);
        let fd = os_fd_open(pbuf, path.len(), 1, 0);
        let _ = os_slab_free(pbuf, path.len(), 1);
        if fd < 0 { return ""; }
        var cap = 16384;
        var len = 0;
        var buf = os_slab_alloc(cap, 8);
        while true {
            if cap - len < 4096 {
                let next_cap = cap * 2;
                buf = os_slab_realloc(buf, cap, next_cap, 8);
                cap = next_cap;
            }
            let r = os_fd_read(fd, buf + len, cap - len);
            if r <= 0 { break; }
            len = len + r;
        }
        let _ = os_fd_close(fd);
        let out = if len > 0 { str_from_ptr(buf, len) } else { "" };
        let _ = os_slab_free(buf, cap, 8);
        return out;
    }

    /// Whether the host wrote the file.
    pub static fn write_text(path: str, content: str) -> bool {
        if path == "" { return false; }
        file_ensure_parent_dirs(path);
        let pbuf = file_path_buf(path);
        // READ(1) | WRITE(2) | CREAT(4) | TRUNC(8) = 15, mode 0o644 = 420
        let fd = os_fd_open(pbuf, path.len(), 14, 420);
        let _ = os_slab_free(pbuf, path.len(), 1);
        if fd < 0 { return false; }
        let n = content.len();
        if n == 0 {
            let _ = os_fd_close(fd);
            return true;
        }
        let cbuf = os_slab_alloc(n, 1);
        let _ = str_copy_to_ptr(content, cbuf);
        var off = 0;
        var ok = true;
        while off < n {
            let w = os_fd_write(fd, cbuf + off, n - off);
            if w <= 0 { ok = false; break; }
            off = off + w;
        }
        let _ = os_slab_free(cbuf, n, 1);
        let _ = os_fd_close(fd);
        return ok;
    }

    pub static fn list_dirs(path: str) -> str {
        var dirs: List<str> = [];
        var files: List<str> = [];
        if !file_read_dir_entries(path, dirs, files) { return ""; }
        file_sort_strs(dirs);
        return file_join_lines(dirs);
    }

    pub static fn walk_files(path: str) -> str {
        var out: List<str> = [];
        file_walk_rec(path, out);
        file_sort_strs(out);
        return file_join_lines(out);
    }
}
