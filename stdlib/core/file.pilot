// =========================================================================
// FILE: stdlib/core/file.pilot
// FREESTANDING CORE FILE SYSTEM STRUCT (`File`, 0b00 IValue)
// Encapsulates hardware host filesystem operations within core boundary.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.File;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.OsAbi;
use Pilot.Core.HostRaw;

fn file_path_buf(path: str) -> i64 {
    let n = path.len();
    let cap = if n > 0 { n } else { 1 };
    let buf = RawMem.alloc(cap, 1);
    if n > 0 { let _ = str_copy_to_ptr(path, buf, n); }
    return buf;
}

fn file_sort_strs(ref items: List<str>) {
    var i = 1;
    while i < items.len() {
        let key = items[i];
        var j = i;
        while j > 0 && items[j - 1] > key {
            items[j] = items[j - 1];
            j = j - 1;
        }
        items[j] = key;
        i = i + 1;
    }
}

fn file_join_path(dir: str, name: str) -> str {
    if dir == "" || dir == "." { return name; }
    if dir.ends_with("/") { return dir + name; }
    return dir + "/" + name;
}

/// Whether `path`, following symbolic links, is a directory
/// (`OsStat.kind` at offset 0 is `stat_kind_dir`).
fn file_points_to_dir(path: str) -> bool {
    let pbuf = file_path_buf(path);
    let sbuf = RawMem.alloc(72, 8);
    let rc = File.stat(1, pbuf, path.len(), sbuf);
    let kind = if rc >= 0 { RawMem.load_int(sbuf, 64, 0) } else { -1 };
    let _ = RawMem.free(sbuf, 72, 8);
    let _ = RawMem.free(pbuf, path.len(), 1);
    return kind == 2;
}

fn file_read_dir_entries(path: str, ref dirs: List<str>, ref files: List<str>) -> bool {
    if path == "" { return false; }
    let pbuf = file_path_buf(path);
    let out_len_ptr = RawMem.alloc(8, 8);
    var cap = 16384;
    var obuf = RawMem.alloc(cap, 8);
    var rc = File.read_dir(pbuf, path.len(), obuf, cap, out_len_ptr);
    while rc == -44 {
        let next_cap = cap * 2;
        obuf = RawMem.realloc(obuf, cap, next_cap, 8);
        cap = next_cap;
        rc = File.read_dir(pbuf, path.len(), obuf, cap, out_len_ptr);
    }
    let _ = RawMem.free(pbuf, path.len(), 1);
    let n = RawMem.load_int(out_len_ptr, 64, 0);
    let _ = RawMem.free(out_len_ptr, 8, 8);
    if rc < 0 {
        let _ = RawMem.free(obuf, cap, 8);
        return false;
    }
    var off = 0;
    while off + 3 <= n {
        let kind = RawMem.load_int(obuf + off, 8, 0);
        let lo = RawMem.load_int(obuf + off + 1, 8, 0);
        let hi = RawMem.load_int(obuf + off + 2, 8, 0);
        let nlen = lo + hi * 256;
        off = off + 3;
        if off + nlen > n { break; }
        let name = str_from_ptr(obuf + off, nlen);
        off = off + nlen;
        if name != "." && name != ".." {
            // A symbolic link (`stat_kind_symlink`) counts as what it points
            // to, so a linked directory is listed and walked like a real one.
            let is_dir = kind == 2 || (kind == 3 && file_points_to_dir(file_join_path(path, name)));
            if is_dir { dirs.push(name); }
            else { files.push(name); }
        }
    }
    let _ = RawMem.free(obuf, cap, 8);
    return true;
}

fn file_walk_rec(dir: str, ref out: List<str>) {
    var dirs: List<str> = [];
    var files: List<str> = [];
    if !file_read_dir_entries(dir, dirs, files) { return; }
    for f in files { out.push(file_join_path(dir, f)); }
    for d in dirs { file_walk_rec(file_join_path(dir, d), out); }
}

fn file_ensure_parent_dirs(path: str) {
    var last_slash = -1;
    var i = path.len() - 1;
    while i >= 0 {
        if path.byte_at(i) == 47 { last_slash = i; break; }
        i = i - 1;
    }
    if last_slash <= 0 { return; }
    let pbuf = file_path_buf(path);
    let _ = File.mkdir(pbuf, last_slash, 1, 493);
    let _ = RawMem.free(pbuf, path.len(), 1);
}

/// Writes all of `content` to the open `fd`, then closes it. Whether every
/// byte was written.
fn file_write_all(fd: i64, content: str) -> bool {
    let n = content.len();
    if n == 0 {
        let _ = Fd.close(fd);
        return true;
    }
    let cbuf = RawMem.alloc(n, 1);
    let _ = str_copy_to_ptr(content, cbuf, n);
    var off = 0;
    var ok = true;
    while off < n {
        let w = Fd.write(fd, cbuf + off, n - off);
        if w <= 0 { ok = false; break; }
        off = off + w;
    }
    let _ = RawMem.free(cbuf, n, 1);
    let _ = Fd.close(fd);
    return ok;
}

[KeywordDefAttr(30, "Freestanding core filesystem interface for file I/O operations.")]
pub struct File : IValue {
    [EngineOp]
    priv static fn stat_internal(follow: i64, path_ptr: i64, path_len: i64, out_stat_ptr: i64) -> i64 =>
        __engine("host_op", 26, follow, path_ptr, path_len, out_stat_ptr);
    pub static fn stat(follow: i64, path_ptr: i64, path_len: i64, out_stat_ptr: i64) -> i64 => File.stat_internal(follow, path_ptr, path_len, out_stat_ptr);

    [EngineOp]
    priv static fn read_dir_internal(path_ptr: i64, path_len: i64, dst: i64, cap: i64, out_len_ptr: i64) -> i64 =>
        __engine("host_op", 27, path_ptr, path_len, dst, cap, out_len_ptr);
    pub static fn read_dir(path_ptr: i64, path_len: i64, dst: i64, cap: i64, out_len_ptr: i64) -> i64 => File.read_dir_internal(path_ptr, path_len, dst, cap, out_len_ptr);

    [EngineOp]
    priv static fn mkdir_internal(path_ptr: i64, path_len: i64, parents: i64, mode: i64) -> i64 =>
        __engine("host_op", 28, path_ptr, path_len, parents, mode);
    pub static fn mkdir(path_ptr: i64, path_len: i64, parents: i64, mode: i64) -> i64 => File.mkdir_internal(path_ptr, path_len, parents, mode);

    [EngineOp]
    priv static fn remove_internal(path_ptr: i64, path_len: i64, recursive: i64) -> i64 =>
        __engine("host_op", 29, path_ptr, path_len, recursive);
    pub static fn remove(path_ptr: i64, path_len: i64, recursive: i64) -> i64 => File.remove_internal(path_ptr, path_len, recursive);

    [EngineOp]
    priv static fn rename_link_internal(op: i64, src_ptr: i64, src_len: i64, dst_ptr: i64, dst_len: i64, out_len_ptr: i64) -> i64 =>
        __engine("host_op", 30, op, src_ptr, src_len, dst_ptr, dst_len, out_len_ptr);
    pub static fn rename_link(op: i64, src_ptr: i64, src_len: i64, dst_ptr: i64, dst_len: i64, out_len_ptr: i64) -> i64 => File.rename_link_internal(op, src_ptr, src_len, dst_ptr, dst_len, out_len_ptr);

    pub static fn exists(path: str) -> bool {
        if path == "" { return false; }
        let pbuf = file_path_buf(path);
        let sbuf = RawMem.alloc(72, 8);
        let rc = File.stat(1, pbuf, path.len(), sbuf);
        let _ = RawMem.free(sbuf, 72, 8);
        let _ = RawMem.free(pbuf, path.len(), 1);
        return rc >= 0;
    }

    pub static fn read_text(path: str) -> str {
        if path == "" { return ""; }
        let pbuf = file_path_buf(path);
        let fd = Fd.open_path(pbuf, path.len(), 1, 0);
        let _ = RawMem.free(pbuf, path.len(), 1);
        if fd < 0 { return ""; }
        var cap = 16384;
        var len = 0;
        var buf = RawMem.alloc(cap, 8);
        while true {
            if cap - len < 4096 {
                let next_cap = cap * 2;
                buf = RawMem.realloc(buf, cap, next_cap, 8);
                cap = next_cap;
            }
            let r = Fd.read(fd, buf + len, cap - len);
            if r <= 0 { break; }
            len = len + r;
        }
        let _ = Fd.close(fd);
        let out = if len > 0 { str_from_ptr(buf, len) } else { "" };
        let _ = RawMem.free(buf, cap, 8);
        return out;
    }

    /// Whether the host wrote the file.
    pub static fn write_text(path: str, content: str) -> bool {
        if path == "" { return false; }
        file_ensure_parent_dirs(path);
        let pbuf = file_path_buf(path);
        let fd = Fd.open_path(pbuf, path.len(), fd_open_write() | fd_open_creat() | fd_open_trunc(), 420);
        let _ = RawMem.free(pbuf, path.len(), 1);
        if fd < 0 { return false; }
        return file_write_all(fd, content);
    }

    /// Creates `path` holding `content` only when nothing is there yet, in
    /// one step on the host: of several programs creating the same path at
    /// once, exactly one does. Whether this call created it.
    pub static fn create_new(path: str, content: str) -> bool {
        if path == "" { return false; }
        file_ensure_parent_dirs(path);
        let pbuf = file_path_buf(path);
        let fd = Fd.open_path(pbuf, path.len(), fd_open_write() | fd_open_creat() | fd_open_excl(), 420);
        let _ = RawMem.free(pbuf, path.len(), 1);
        if fd < 0 { return false; }
        return file_write_all(fd, content);
    }

    /// Removes the file `path`. Whether it was removed.
    pub static fn delete(path: str) -> bool {
        if path == "" { return false; }
        let pbuf = file_path_buf(path);
        let rc = File.remove(pbuf, path.len(), 0);
        let _ = RawMem.free(pbuf, path.len(), 1);
        return rc >= 0;
    }

    /// Moves `from` to `to`, replacing `to`, in one step on the host, so a
    /// reader of `to` never sees half a file. Whether it moved.
    pub static fn rename(from: str, to: str) -> bool {
        if from == "" || to == "" { return false; }
        let a = file_path_buf(from);
        let b = file_path_buf(to);
        let rc = File.rename_link(0, a, from.len(), b, to.len(), 0);
        RawMem.free(a, from.len(), 1);
        RawMem.free(b, to.len(), 1);
        return rc >= 0;
    }

    /// The names of the directories in `path`, sorted; none when it
    /// cannot be read.
    pub static fn list_dirs(path: str) -> List<str> {
        var dirs: List<str> = [];
        var files: List<str> = [];
        if !file_read_dir_entries(path, dirs, files) { return []; }
        file_sort_strs(dirs);
        return dirs;
    }

    /// The names of the files directly in `path` (not in its directories),
    /// sorted.
    pub static fn list_files(path: str) -> List<str> {
        var dirs: List<str> = [];
        var files: List<str> = [];
        if !file_read_dir_entries(path, dirs, files) { return []; }
        file_sort_strs(files);
        return files;
    }

    /// The paths of every file under `path`, sorted.
    pub static fn walk_files(path: str) -> List<str> {
        var out: List<str> = [];
        file_walk_rec(path, out);
        file_sort_strs(out);
        return out;
    }
}
