// =========================================================================
// FILE: stdlib/core/file.pilot
// FREESTANDING CORE FILE SYSTEM STRUCT (`File`, 0b00 IValue)
// Encapsulates hardware host filesystem operations within core boundary.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.File;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

[KeywordDefAttr(30, "Freestanding core filesystem interface for file I/O operations.")]
pub struct File : IValue {
    pub static fn exists(path: str) -> bool {
        return __engine("fs_exists", path);
    }

    pub static fn read_text(path: str) -> str {
        return __engine("fs_read_text", path);
    }

    /// Whether the host wrote the file.
    pub static fn write_text(path: str, content: str) -> bool {
        return __engine("fs_write_text", path, content);
    }

    pub static fn list_dirs(path: str) -> str {
        return __engine("fs_list_dirs", path);
    }

    pub static fn walk_files(path: str) -> str {
        return __engine("fs_walk_files", path);
    }
}
