// =========================================================================
// FILE: stdlib/core/result.pilot
// STAGE 3C VALUES-FIRST MUST-USE ERROR SYSTEM (`result<TOk, TErr>` / `T ! E`)
// Preserves Milestone 13 register-returned `{ ok_val, err_val, is_ok }`,
// universal postfix `?`, and localized `catch` recovery.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Result;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Option.*;

[Lang(Cfg.Lang.res_t), Layout(c_abi)]
pub partial struct result<TOk: IAnyValue, TErr: IAnyValue> : IEquatable<result<TOk, TErr>>, ITryOperator<TOk, TErr> {
    pub ok_val:  TOk;
    pub err_val: TErr;
    pub is_ok:   bool;

    pub is_err: bool { get => !self.is_ok; }

    // The payload a result does not hold is left out, which zero-fills it.
    pub static pure:
        fn ok(v: TOk) -> result<TOk, TErr> => result<TOk, TErr> {
            ok_val:  v,
            is_ok:   true,
        };

        fn err(e: TErr) -> result<TOk, TErr> => result<TOk, TErr> {
            err_val: e,
            is_ok:   false,
        };

        fn fail(e: TErr) -> result<TOk, TErr> => result<TOk, TErr>.err(e);

    pub pure:
        // Universal postfix `expr?` unwraps `TOk`, or early-returns the
        // failed result itself when `is_success()` is `false`.
        fn is_success() -> bool => .is_ok;
        fn failure() -> TErr => .err_val;
        op ? () -> TOk => .ok_val;

        op == (rhs: result<TOk, TErr>) -> bool =>
            if .is_ok != rhs.is_ok {
                false
            } else {
                if .is_ok { .ok_val == rhs.ok_val } else { .err_val == rhs.err_val }
            };

        fn unwrap_or(fallback: TOk) -> TOk => if .is_ok { .ok_val } else { fallback };

        fn ok_option() -> option<TOk> =>
            if .is_ok { option<TOk>.some(.ok_val) } else { option<TOk>.none() };

        fn err_option() -> option<TErr> =>
            if !self.is_ok { option<TErr>.some(.err_val) } else { option<TErr>.none() };

        fn map<U: IAnyValue>(f: (TOk) => U) -> result<U, TErr> =>
            if .is_ok {
                result<U, TErr>.ok(f(.ok_val))
            } else {
                result<U, TErr>.err(.err_val)
            };

        fn map_err<F: IAnyValue>(f: (TErr) => F) -> result<TOk, F> =>
            if .is_ok {
                result<TOk, F>.ok(.ok_val)
            } else {
                result<TOk, F>.err(f(.err_val))
            };
}
