// =========================================================================
// FILE: stdlib/core/syntax/visibility.pilot
// TWO-AXIS VISIBILITY (`priv`..`export`) & CLEARANCE RINGS (`lvl(N)` / `lvlN`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Visibility;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    // Axis 1: Canonical 10-Tier Spatial Visibility Lattice (`0..9`)
    register_modifier(nameof(priv),        0);
    register_modifier(nameof(private),     0);
    register_modifier(nameof(file),        1);
    register_modifier(nameof(fileprivate), 1);
    register_modifier(nameof(prot),        3);
    register_modifier(nameof(protected),   3);
    register_modifier(nameof(pkg),         4);
    register_modifier(nameof(package),     4);
    register_modifier(nameof(int),         6);
    register_modifier(nameof(internal),    6);
    register_modifier(nameof(pub),         7);
    register_modifier(nameof(public),      7);
    register_modifier(nameof(open),        8);
    // `export` (a symbol exported across the foreign ABI) is not built yet
    // (docs/keyword_roadmap.md K5): every use stops at the seam
    // `keyword.unbuilt` instead of behaving as `pub`.
    register_modifier(nameof(export),      "keyword_unbuilt");
    register_modifier(nameof(override),    "override_member");

    // Axis 2: Compile-Time Clearance Rings (`lvl(N)` & shorthand `lvl0`..`lvl100`)
    // `lvl(N)` is kept on its declaration (selfhost/check/clearance.pilot
    // reads it). The shorthand `lvl0`..`lvl100` is not built yet
    // (docs/keyword_roadmap.md K2): every use stops at the seam
    // `keyword.unbuilt` instead of being ignored.
    register_parametric_modifier(nameof(lvl), "set_clearance_ring");
    register_modifier(nameof(lvl0),   "keyword_unbuilt");
    register_modifier(nameof(lvl1),   "keyword_unbuilt");
    register_modifier(nameof(lvl2),   "keyword_unbuilt");
    register_modifier(nameof(lvl3),   "keyword_unbuilt");
    register_modifier(nameof(lvl80),  "keyword_unbuilt");
    register_modifier(nameof(lvl90),  "keyword_unbuilt");
    register_modifier(nameof(lvl100), "keyword_unbuilt");
}

// `module` (K2, decision D3) and `macro` (K4; `syntax` rules are the macros
// that work) are not built yet.
// Each rule reads the construct past (`Rest`: up to a `;`, or through the
// block it opens) and stops the build at the seam `keyword.unbuilt`
// (PROP-009 section 13). The word starts the construct only when a name, a
// literal or `{` follows it; elsewhere it is an ordinary name
// (tests/conformance/types/unbuilt_words_as_names, _2).
pub syntax {
    module $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `module` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    macro $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `macro` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
}

pub pure fn visibility_tier_of(word: str) -> i32 {
    if word == nameof(priv) || word == nameof(private) { return 0; }
    if word == nameof(file) || word == nameof(fileprivate) { return 1; }
    if word == nameof(prot) || word == nameof(protected) { return 3; }
    if word == nameof(pkg) || word == nameof(package) { return 4; }
    if word == nameof(int) || word == nameof(internal) { return 6; }
    if word == nameof(pub) || word == nameof(public) { return 7; }
    if word == nameof(open) { return 8; }
    if word == nameof(export) { return 9; }
    return 15;
}

pub pure fn can_access_ring(caller_lvl: i32, required_lvl: i32) -> bool {
    return caller_lvl >= required_lvl;
}

/// The tier of a declaration written without a visibility word: it is
/// private to its package.
pub pure fn default_visibility_tier() -> i64 => visibility_tier_of(nameof(pkg));

/// How far a declaration reaches from where it is declared.
pub enum VisReach : u8 {
    /// The declaring scope: a member's own type body, a top-level item's file.
    Scope,
    /// The declaring type, types derived from it, and extensions (`ext`) on it.
    Protected,
    /// The file it is declared in.
    File,
    /// Every file of its package.
    Package,
    /// The whole program.
    Program,
}

/// How far a declaration of visibility `tier` reaches.
pub pure fn visibility_reach(tier: i64) -> VisReach {
    if tier < visibility_tier_of(nameof(file)) { return ::Scope; }
    if tier < visibility_tier_of(nameof(prot)) { return ::File; }
    if tier < visibility_tier_of(nameof(pkg)) { return ::Protected; }
    if tier < visibility_tier_of(nameof(int)) { return ::Package; }
    return ::Program;
}
