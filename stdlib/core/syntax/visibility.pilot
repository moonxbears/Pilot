// =========================================================================
// FILE: stdlib/core/syntax/visibility.pilot
// TWO-AXIS VISIBILITY (`priv`..`export`) & CLEARANCE RINGS (`lvl(N)` / `lvlN`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Visibility;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    // Axis 1: Canonical 10-Tier Spatial Visibility Lattice (`0..9`)
    __engine("register_modifier", nameof(priv),        0);
    __engine("register_modifier", nameof(private),     0);
    __engine("register_modifier", nameof(file),        1);
    __engine("register_modifier", nameof(fileprivate), 1);
    __engine("register_modifier", nameof(prot),        3);
    __engine("register_modifier", nameof(protected),   3);
    __engine("register_modifier", nameof(pkg),         4);
    __engine("register_modifier", nameof(package),     4);
    __engine("register_modifier", nameof(int),         6);
    __engine("register_modifier", nameof(internal),    6);
    __engine("register_modifier", nameof(pub),         7);
    __engine("register_modifier", nameof(public),      7);
    __engine("register_modifier", nameof(open),        8);
    // `export` (a symbol exported across the foreign ABI) is not built yet
    // (docs/keyword_roadmap.md K5): every use stops at the seam
    // `keyword.unbuilt` instead of behaving as `pub`.
    __engine("register_modifier", nameof(export),      "keyword_unbuilt");
    // `override` (docs/keyword_roadmap.md K2) and `module` (K2, decision
    // D3) are not built yet: each stops at the seam `keyword.unbuilt`.
    __engine("register_modifier", nameof(override),    "keyword_unbuilt");
    __engine("bind_receptor", nameof(module),          40, 1);

    // Axis 2: Compile-Time Clearance Rings (`lvl(N)` & shorthand `lvl0`..`lvl100`)
    // `lvl(N)` is kept on its declaration (selfhost/check/clearance.pilot
    // reads it). The shorthand `lvl0`..`lvl100` is not built yet
    // (docs/keyword_roadmap.md K2): every use stops at the seam
    // `keyword.unbuilt` instead of being ignored.
    __engine("register_parametric_modifier", nameof(lvl), "set_clearance_ring");
    __engine("register_modifier", nameof(lvl0),   "keyword_unbuilt");
    __engine("register_modifier", nameof(lvl1),   "keyword_unbuilt");
    __engine("register_modifier", nameof(lvl2),   "keyword_unbuilt");
    __engine("register_modifier", nameof(lvl3),   "keyword_unbuilt");
    __engine("register_modifier", nameof(lvl80),  "keyword_unbuilt");
    __engine("register_modifier", nameof(lvl90),  "keyword_unbuilt");
    __engine("register_modifier", nameof(lvl100), "keyword_unbuilt");
}

pub pure fn visibility_tier_of(word: str) -> i32 {
    if word == nameof(priv) || word == nameof(private) { return 0; }
    if word == nameof(file) || word == nameof(fileprivate) { return 1; }
    if word == nameof(prot) || word == nameof(protected) { return 3; }
    if word == nameof(pkg) || word == nameof(package) { return 4; }
    if word == nameof(int) || word == nameof(internal) { return 6; }
    if word == nameof(pub) || word == nameof(public) { return 7; }
    if word == nameof(open) { return 8; }
    if word == nameof(export) { return 9; }
    return 15;
}

pub pure fn can_access_ring(caller_lvl: i32, required_lvl: i32) -> bool {
    return caller_lvl >= required_lvl;
}

/// The tier of a declaration written without a visibility word: it is
/// private to its package.
pub pure fn default_visibility_tier() -> i64 => visibility_tier_of(nameof(pkg));

/// How far a declaration reaches from where it is declared.
pub enum VisReach : u8 {
    /// The declaring scope: a member's own type body, a top-level item's file.
    Scope,
    /// The file it is declared in.
    File,
    /// Every file of its package.
    Package,
    /// The whole program.
    Program,
}

/// How far a declaration of visibility `tier` reaches. `prot` reaches the
/// package: derived types and extensions in other packages are not told
/// apart yet.
pub pure fn visibility_reach(tier: i64) -> VisReach {
    if tier < visibility_tier_of(nameof(file)) { return ::Scope; }
    if tier < visibility_tier_of(nameof(prot)) { return ::File; }
    if tier < visibility_tier_of(nameof(int)) { return ::Package; }
    return ::Program;
}
