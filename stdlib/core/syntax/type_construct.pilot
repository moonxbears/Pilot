// =========================================================================
// FILE: stdlib/core/syntax/type_construct.pilot
// TYPE-POSITION SYMBOL CONSTRUCT MACROS (`syntax type_construct`)
// Maps concise suffix/infix symbols to canonical lowercase `[Lang]` structs
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.TypeConstruct;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

pub syntax type_construct {
    (T[])          => quote { slice<$T> };
    (T[N])         => quote { array<$T, $N> };
    (T[N, M])      => quote { grid<$T, $N, $M> };
    (T[..])        => quote { stride<$T> };
    (T[:])         => quote { ring<$T> };
    (T @ N)        => quote { simd<$T, $N> };
    (T^)           => quote { signal<$T> };
    (@T)           => quote { pin<$T> };
    (T?)           => quote { option<$T> };
    (T ! E)        => quote { result<$T, $E> };
    ((A) => R)     => quote { fn<$A, $R> };
    (T1 | T2)      => quote { union<$T1, $T2> };
}
