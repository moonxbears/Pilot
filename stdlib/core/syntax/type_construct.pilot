// =========================================================================
// FILE: stdlib/core/syntax/type_construct.pilot
// TYPE-POSITION SYMBOL CONSTRUCT MACROS (`syntax type_construct`)
// Maps symbolic suffix/prefix/infix constructs to canonical `[Lang]` types
// obeying Pratt Type-Spec Binding-Power Invariant #6:
//   Postfix (`?`, `[]`, `[N]`, `[..]`, `[:]`, `@`, `^`) = 30
//   > Intersection (`&`) = 20
//   > Union (`|`) = 15
//   > Function Arrow (`=>`, `->`) = 10
//   > Fallible (`!`) = 5
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.TypeConstruct;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

pub syntax type_construct {
    (T[])          => quote { slice<$T> };
    (T[N])         => quote { array<$T, $N> };
    (T[N, M])      => quote { grid<$T, $N, $M> };
    (T[..])        => quote { stride<$T> };
    (T[:])         => quote { ring<$T> };
    (T @ N)        => quote { simd<$T, $N> };
    (T^)           => quote { signal<$T> };
    (@T)           => quote { pin<$T> };
    (*T)           => quote { ptr<$T> };
    (T?)           => quote { option<$T> };
    (T1 & T2)      => quote { intersect<$T1, $T2> };
    (T1 | T2)      => quote { union<$T1, $T2> };
    ((A) => R)     => quote { fn<$A, $R> };
    (A -> R)       => quote { fn<$A, $R> };
    (T ! E)        => quote { result<$T, $E> };
    (opt<T>)       => quote { option<$T> };
    (res<T, E>)    => quote { result<$T, $E> };
    (sig<T>)       => quote { signal<$T> };
    (grad<T, G>)   => quote { dual<$T, $G> };
    (plan<T>)      => quote { effect_plan<$T> };
}
