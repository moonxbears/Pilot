// =========================================================================
// FILE: stdlib/core/syntax/guard.pilot
// DIVERGING EARLY-EXIT `guard ... else` SYNTAX (`NULL002`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Guard;

use Pilot.Core.Genesis.*;

comptime {
    __engine("bind_receptor", "guard", 17, 0);
}

pub syntax {
    guard(cond, else_body) => quote {
        if !($cond) {
            $else_body
        }
    };
}
