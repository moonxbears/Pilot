// =========================================================================
// FILE: stdlib/core/syntax/guard.pilot
// DIVERGING EARLY-EXIT `guard ... else` SYNTAX (`NULL002`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Guard;

use Pilot.Core.Genesis.*;

// `guard cond else { .. }` leaves by its `else` block unless `cond` holds;
// `guard some x = v else { .. }` (or `guard let ..`) binds `x` to the value
// inside `v` for the rest of the block.
pub syntax {
    guard some $c:Expr $( = $v:Expr )? else $otherwise:Block
        => quote { form(CoreForm::Guard, true, $c, $v, $otherwise) };
    guard let $c:Expr $( = $v:Expr )? else $otherwise:Block
        => quote { form(CoreForm::Guard, true, $c, $v, $otherwise) };
    guard $c:Expr $( = $v:Expr )? else $otherwise:Block
        => quote { form(CoreForm::Guard, false, $c, $v, $otherwise) };
    // Without `else` a guard has no way to leave.
    guard $( some )? $( let )? $c:Expr $( = $v:Expr )?
        => quote { form(CoreForm::Reject, "NULL002: 'guard' statement requires an 'else' block with early exit", $c) };
}

// An `else` that no `if` or `guard` took (they read their own `else`) is
// refused at the word, not read as a name. `else` stays bound to receptor 3
// for the seed's `if` (PROP-009 section 14).
pub syntax {
    else if $r:Rest => quote { form(CoreForm::RejectWord, "`else` must follow the block of an `if` (or a `guard` condition)", $r) };
    else $r:Rest => quote { form(CoreForm::RejectWord, "`else` must follow the block of an `if` (or a `guard` condition)", $r) };
}
