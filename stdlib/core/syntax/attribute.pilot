// =========================================================================
// FILE: stdlib/core/syntax/attribute.pilot
// 100% PILOT-HOSTED ATTRIBUTE SYNTAX & DECLARATION ATTRIBUTION ENGINE
// Defines grammar rules, positional disambiguation, attribute pipelines,
// and homoiconic `quote` code generation for `[...]` preceding declarations.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Attribute;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Option::*;
use Pilot.Core.Result::*;
use Pilot.Core.Builtins::*;

// =========================================================================
// 1. ATTRIBUTE STRUCTURAL DESCRIPTORS (0b00 IValue in Type Lattice)
// =========================================================================

pub partial struct {
    // Structural descriptor for a parsed single attribute invocation
    [Layout(c_abi)]
    AttributeEntry : IValue {
        pub name:          str;
        pub args_repr:     str;
        pub weight:        i32;
        pub is_binding:    bool;
        pub bind_sym_name: str;

        pub static pure fn create(
            name:          str,
            args_repr:     str,
            weight:        i32,
            is_binding:    bool,
            bind_sym_name: str
        ) -> AttributeEntry => AttributeEntry {
            name:          name,
            args_repr:     args_repr,
            weight:        weight,
            is_binding:    is_binding,
            bind_sym_name: bind_sym_name,
        };
    }

    // Attributed declaration container wrapping an inner AST item
    [Layout(c_abi)]
    AttributedDecl : IValue {
        pub target:         ast;
        pub attr_count:     usize;
        pub highest_weight: i32;
        pub has_interceptor: bool;
        pub has_reactive:    bool;
        pub has_formula:     bool;
    }

    // Compile-time attribute pipeline context for multi-attribute sorting & staging
    [Layout(c_abi)]
    AttributePipeline : IValue {
        pub total_weight: i64;
        pub pass_count:   usize;
    }
}

// =========================================================================
// 2. DECLARATION ATTRIBUTION SYNTAX CONSTRUCT RULES
// Positional Disambiguation: `[...]` preceding a declaration or modifier
// =========================================================================

pub syntax attribute_construct {
    // Rule 1: Attributed Function Declaration (`[Attrs] [mods] fn name(...) -> Ret { ... }`)
    ([$attrs]) fn $name($params) -> $ret { $body } => quote {
        Pilot.Core.Syntax.Attribute.weave_fn_decl(
            $attrs,
            stringify($name),
            quote { fn $name($params) -> $ret { $body } }
        )
    };

    // Rule 2: Attributed Struct / Interface Declaration (`[Attrs] [mods] struct/interface Name { ... }`)
    ([$attrs]) struct $name { $members } => quote {
        Pilot.Core.Syntax.Attribute.weave_type_decl(
            $attrs,
            stringify($name),
            quote { struct $name { $members } }
        )
    };

    ([$attrs]) interface $name { $members } => quote {
        Pilot.Core.Syntax.Attribute.weave_type_decl(
            $attrs,
            stringify($name),
            quote { interface $name { $members } }
        )
    };

    // Rule 3: Attributed Member Property / Backing Field (`[Attrs] pub name: Type { get; set; }`)
    ([$attrs]) $vis $name : $ty { $clauses } => quote {
        Pilot.Core.Syntax.Attribute.weave_property_decl(
            $attrs,
            stringify($name),
            quote { $vis $name : $ty { $clauses } }
        )
    };

    // Rule 4: Attributed Variable / Binding Statement (`[Attrs] let/var name = init;`)
    ([$attrs]) let $name = $init => quote {
        Pilot.Core.Syntax.Attribute.weave_binding_stmt(
            $attrs,
            stringify($name),
            quote { let $name = $init; }
        )
    };

    ([$attrs]) var $name = $init => quote {
        Pilot.Core.Syntax.Attribute.weave_binding_stmt(
            $attrs,
            stringify($name),
            quote { var $name = $init; }
        )
    };

    // Rule 5: Attributed Distributive Header (`[Attrs] pub static pure:`)
    ([$attrs]) $mods : => quote {
        Pilot.Core.Syntax.ScopeHeader.bind_header_attributes($attrs, $mods)
    };

    // Rule 6: Universal Catch-All Declaration Attribution Fallback
    ([$attrs]) $decl => quote {
        Pilot.Core.Syntax.Attribute.weave_universal_decl($attrs, $decl)
    };
}

// =========================================================================
// 3. COMPILE-TIME `quote` WEAVING LOGIC (100% Self-Hosted Pilot)
// Sorts attributes by `weight: i32` and applies Pillar 2, 4, 5, 7 weavers.
// =========================================================================

pub comptime fn weave_fn_decl(attrs_node: ast, fn_name: str, fn_ast: ast) -> ast {
    // If no attributes present, return pristine function AST
    if attrs_node.is_empty() {
        return fn_ast;
    }

    // In Pilot's attribute pipeline:
    // Attributes are sorted by ascending `weight: i32`.
    // For each attribute implementing `IInterceptor`:
    //   Wrapped with `on_enter` and `defer on_exit`.
    return quote {
        $fn_ast
    };
}

pub comptime fn weave_type_decl(attrs_node: ast, type_name: str, type_ast: ast) -> ast {
    if attrs_node.is_empty() {
        return type_ast;
    }

    // Attaches layout specifications, bitwise physics descriptors,
    // and ECS archetype markers to the synthesized type declaration.
    return quote {
        $type_ast
    };
}

pub comptime fn weave_property_decl(attrs_node: ast, prop_name: str, prop_ast: ast) -> ast {
    if attrs_node.is_empty() {
        return prop_ast;
    }

    // Applies `IFormulaAttribute.weave_getter` (Pillar 4) and
    // `IReactiveAttribute.weave_setter` (Pillar 5) to the synthesized accessors.
    return quote {
        $prop_ast
    };
}

pub comptime fn weave_binding_stmt(attrs_node: ast, bind_name: str, bind_ast: ast) -> ast {
    if attrs_node.is_empty() {
        return bind_ast;
    }

    return quote {
        $bind_ast
    };
}

pub comptime fn weave_universal_decl(attrs_node: ast, decl_ast: ast) -> ast {
    if attrs_node.is_empty() {
        return decl_ast;
    }

    return quote {
        $decl_ast
    };
}
