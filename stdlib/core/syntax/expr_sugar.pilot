// =========================================================================
// FILE: stdlib/core/syntax/expr_sugar.pilot
// FLUID CASCADES (`..`/`?..`), PIPES (`|>`/`<|`), DTO PROJECTIONS (`->`/`->>`),
// C# CLOSURES (`(x) => expr`) & LOGICAL/PREDICATE RECEPTORS (`and`/`or`/`not`/`is`/`some`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.ExprSugar;

use Pilot.Core.Genesis.*;

comptime {
    __engine("register_pratt_op", "|>",  infix,  8,  left);
    __engine("register_pratt_op", "<|",  infix,  8,  right);
    __engine("register_pratt_op", "||",  infix,  12, left);
    __engine("register_pratt_op", "&&",  infix,  14, left);
    __engine("register_pratt_op", "**",  infix,  88, right);
    __engine("register_pratt_op", "//",  infix,  70, left);
    __engine("register_pratt_op", ":=",  infix,  5,  right);
    __engine("register_pratt_op", "->",  infix,  20, left);
    __engine("register_pratt_op", "->>", infix,  20, left);

    __engine("bind_receptor", nameof(and),  31, 14);
    __engine("bind_receptor", nameof(or),   31, 15);
    __engine("bind_receptor", nameof(not),  31, 1);
    __engine("bind_receptor", nameof(is),     31, 25);
    __engine("bind_receptor", nameof(some),   31, 2);
    __engine("bind_receptor", nameof(nameof), 33, 25);

    __engine("bind_receptor", nameof(splat), 35, 1);
    __engine("bind_receptor", nameof(pairs), 35, 2);
    __engine("bind_receptor", nameof(flat),  35, 3);
}

// -------------------------------------------------------------------------
// UNPACK & FLATTEN SYNTAX MACROS
// Lowers readable prefix forms `splat(x)`, `pairs(x)`, `flat(x)` to the exact
// same receptor AST nodes as prefix unpack sigils `*x`, `**x`, `*..x`.
// -------------------------------------------------------------------------

pub syntax {
    splat(x) => quote { *$x };
    pairs(x) => quote { **$x };
    flat(x)  => quote { *..$x };
}
