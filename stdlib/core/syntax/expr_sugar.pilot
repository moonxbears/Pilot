// =========================================================================
// FILE: stdlib/core/syntax/expr_sugar.pilot
// FLUID CASCADES (`..`/`?..`), PIPES (`|>`/`<|`), DTO PROJECTIONS (`->`/`->>`),
// C# CLOSURES (`(x) => expr`) & LOGICAL/PREDICATE RECEPTORS (`and`/`or`/`not`/`is`/`some`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.ExprSugar;

use Pilot.Core.Genesis.*;
use Pilot.Core.Bridge.Lang;

comptime {
    register_pratt_op("|>",  infix,  8,  left,  0);
    register_pratt_op("<|",  infix,  8,  right, 0);
    register_pratt_op("||",  infix,  12, left,  0);
    register_pratt_op("&&",  infix,  14, left,  0);
    register_pratt_op("**",  infix,  88, right, 0);
    register_pratt_op("//",  infix,  70, left,  0);
    register_pratt_op(":=",  infix,  5,  right, 0);
    register_pratt_op("->",  infix,  20, left,  0);
    register_pratt_op("->>", infix,  20, left,  0);

    bind_receptor(nameof(and),    31, 14);
    bind_receptor(nameof(or),     31, 15);
    bind_receptor(nameof(not),    31, 1);
    bind_receptor(nameof(is),     31, 25);
    bind_receptor(nameof(some),   31, 2);
    bind_receptor(nameof(nameof), 33, 25);

    bind_receptor(nameof(splat), 35, 1);
    bind_receptor(nameof(pairs), 35, 2);
    bind_receptor(nameof(flat),  35, 3);
}

// -------------------------------------------------------------------------
// UNPACK & FLATTEN SYNTAX MACROS
// Lowers readable prefix forms `splat(x)`, `pairs(x)`, `flat(x)` to the exact
// same receptor AST nodes as prefix unpack sigils `*x`, `**x`, `*..x`.
// -------------------------------------------------------------------------

pub syntax {
    splat(x) => quote { *$x };
    pairs(x) => quote { **$x };
    flat(x)  => quote { *..$x };
}
