// =========================================================================
// FILE: stdlib/core/syntax/scope_header.pilot
// CONSOLIDATED DISTRIBUTIVE SCOPE HEADER ENGINE (`Pilot.Core.Syntax.ScopeHeader`)
// Implements multi-modifier identification, multi-attribute propagation,
// clearance rings, visibility inheritance, and default return type coercion
// across distributive blocks (`Header { ... }`) and section labels (`Header:`).
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.ScopeHeader;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

pub pure fn is_visibility_modifier(word: str) -> bool {
    return word == nameof(pub) || word == nameof(public)
        || word == nameof(priv) || word == nameof(private)
        || word == nameof(prot) || word == nameof(protected)
        || word == nameof(pkg) || word == nameof(package)
        || word == nameof(int) || word == nameof(internal)
        || word == nameof(file) || word == nameof(fileprivate)
        || word == nameof(open) || word == nameof(export);
}

pub pure fn is_declaration_modifier(word: str) -> bool {
    return word == nameof(static) || word == nameof(pure)
        || word == nameof(partial) || word == nameof(var)
        || word == nameof(comptime) || word == nameof(ext)
        || word == nameof(extension) || word == nameof(async);
}

pub pure fn is_clearance_modifier(word: str) -> bool {
    if word.starts_with("lvl(") && word.ends_with(")") {
        return true;
    }
    if word.starts_with(nameof(lvl)) && word.len() <= 6 {
        return true;
    }
    return false;
}

pub pure fn is_target_construct(word: str) -> bool {
    return word == nameof(fn) || word == nameof(struct)
        || word == nameof(interface) || word == nameof(enum)
        || word == nameof(type) || word == nameof(let) || word == nameof(var);
}

pub pure fn is_header_keyword(word: str) -> bool {
    return is_visibility_modifier(word)
        || is_declaration_modifier(word)
        || is_clearance_modifier(word)
        || is_target_construct(word);
}

[Layout(c_abi)]
pub struct ScopeHeaderDescriptor : IValue {
    pub modifiers:   str;
    pub attributes:  str;
    pub return_type: str;
    pub is_fn:       bool;
}

[Layout(c_abi)]
pub struct ScopeHeader : IValue {
    pub modifiers:   str;
    pub attributes:  str;
    pub return_type: any;
    pub target_kind: str;
    pub is_fn:       bool;
    pub is_block:    bool;
    pub is_active:   bool;

    pub static pure fn create() -> ScopeHeader => ScopeHeader {
        modifiers:   "",
        attributes:  "",
        return_type: "",
        target_kind: "",
        is_fn:       false,
        is_block:    false,
        is_active:   false,
    };

    pub static pure fn with_all(
        mods: str,
        attrs: str,
        ret_type: str,
        target: str,
        is_fn_scope: bool,
        block_mode: bool
    ) -> ScopeHeader => ScopeHeader {
        modifiers:   mods,
        attributes:  attrs,
        return_type: ret_type,
        target_kind: target,
        is_fn:       is_fn_scope,
        is_block:    block_mode,
        is_active:   true,
    };
}

[Layout(c_abi)]
pub struct ScopeHeaderStack : IObject {
    pub current_header: ScopeHeader;
    pub depth:          i64;

    ~self() {}

    pub static fn create() -> ScopeHeaderStack => ScopeHeaderStack {
        current_header: ScopeHeader.create(),
        depth:          0,
    };

    pub fn push(header: ScopeHeader) -> void {
        self.current_header = header;
        self.depth = self.depth + 1;
    }

    pub fn pop() -> ScopeHeader {
        let prev = self.current_header;
        if self.depth > 0 {
            self.depth = self.depth - 1;
        }
        if self.depth == 0 {
            self.current_header = ScopeHeader.create();
        }
        return prev;
    }

    pub fn current() -> ScopeHeader => self.current_header;
    pub fn is_active() -> bool => self.current_header.is_active;
}

pub pure fn extract_attr_name(attr_str: str) -> str {
    var s = attr_str.trim();
    if s.starts_with("[") { s = s.substring(1, s.len()); }
    if s.ends_with("]") { s = s.substring(0, s.len() - 1); }
    let p_paren = s.find("(");
    if p_paren >= 0 { s = s.substring(0, p_paren); }
    return s.trim();
}

pub pure fn extract_attributes_prefix(line: str) -> str {
    var s = line.trim();
    var collected = "";
    while s.starts_with("[") {
        var depth_bracket = 0;
        var depth_paren = 0;
        var end_idx = -1;
        var j = 0;
        let s_len = s.len();
        while j < s_len {
            let c = s.substring(j, j + 1);
            if c == "[" {
                depth_bracket = depth_bracket + 1;
            } else if c == "]" {
                depth_bracket = depth_bracket - 1;
                if depth_bracket == 0 && depth_paren == 0 {
                    end_idx = j;
                    break;
                }
            } else if c == "(" {
                depth_paren = depth_paren + 1;
            } else if c == ")" && depth_paren > 0 {
                depth_paren = depth_paren - 1;
            }
            j = j + 1;
        }
        if end_idx >= 0 {
            let one_bracket = s.substring(0, end_idx + 1);
            if collected == "" {
                collected = one_bracket;
            } else {
                var inner_c = collected.substring(1, collected.len() - 1);
                var inner_n = one_bracket.substring(1, one_bracket.len() - 1);
                collected = f"[{inner_c}, {inner_n}]";
            }
            s = s.substring(end_idx + 1, s.len()).trim();
        } else {
            break;
        }
    }
    return collected;
}

pub pure fn strip_attributes_prefix(line: str) -> str {
    var s = line.trim();
    while s.starts_with("[") {
        var depth_bracket = 0;
        var depth_paren = 0;
        var end_idx = -1;
        var j = 0;
        let s_len = s.len();
        while j < s_len {
            let c = s.substring(j, j + 1);
            if c == "[" {
                depth_bracket = depth_bracket + 1;
            } else if c == "]" {
                depth_bracket = depth_bracket - 1;
                if depth_bracket == 0 && depth_paren == 0 {
                    end_idx = j;
                    break;
                }
            } else if c == "(" {
                depth_paren = depth_paren + 1;
            } else if c == ")" && depth_paren > 0 {
                depth_paren = depth_paren - 1;
            }
            j = j + 1;
        }
        if end_idx >= 0 {
            s = s.substring(end_idx + 1, s.len()).trim();
        } else {
            break;
        }
    }
    return s;
}

pub pure fn merge_attributes(parent_attrs: str, local_attrs: str) -> str {
    if parent_attrs == "" { return local_attrs; }
    if local_attrs == "" { return parent_attrs; }
    var p_clean = parent_attrs;
    if p_clean.starts_with("[") && p_clean.ends_with("]") {
        p_clean = p_clean.substring(1, p_clean.len() - 1);
    }
    var l_clean = local_attrs;
    if l_clean.starts_with("[") && l_clean.ends_with("]") {
        l_clean = l_clean.substring(1, l_clean.len() - 1);
    }
    if extract_attr_name(p_clean) == extract_attr_name(l_clean) {
        return f"[{l_clean}]";
    }
    return f"[{p_clean}, {l_clean}]";
}

pub fn is_scope_header(line: str) -> bool {
    let trimmed = line.trim();
    if trimmed.contains("case ") || trimmed.contains("default:") {
        return false;
    }
    let rest = strip_attributes_prefix(trimmed);
    if rest == "" { return false; }
    let is_colon_label = rest.ends_with(":");
    let is_block_header = rest.ends_with("{");
    if !is_colon_label && !is_block_header { return false; }

    var body = rest.substring(0, rest.len() - 1).trim();
    if body.contains("->") {
        body = body.substring(0, body.find("->")).trim();
    }
    let words = body.split(" ");
    var has_mod = false;
    var i = 0;
    let w_len = words.len();
    while i < w_len {
        if is_header_keyword(words[i].trim()) {
            has_mod = true;
            break;
        }
        i = i + 1;
    }
    return has_mod || (extract_attributes_prefix(trimmed) != "");
}

pub fn parse_scope_header(line: str) -> ScopeHeader {
    let trimmed = line.trim();
    let attrs = extract_attributes_prefix(trimmed);
    var rest = strip_attributes_prefix(trimmed);
    let is_block = rest.ends_with("{");
    if is_block || rest.ends_with(":") {
        rest = rest.substring(0, rest.len() - 1).trim();
    }
    var ret_type = "";
    if rest.contains("->") {
        let arrow_idx = rest.find("->");
        ret_type = rest.substring(arrow_idx + 2, rest.len()).trim();
        rest = rest.substring(0, arrow_idx).trim();
    }
    let words = rest.split(" ");
    var mods = "";
    var target = "";
    var is_fn = false;
    var i = 0;
    let w_count = words.len();
    while i < w_count {
        let w = words[i].trim();
        if w != "" {
            if w == nameof(fn) {
                is_fn = true;
                target = nameof(fn);
            } else if is_target_construct(w) {
                target = w;
            } else if is_header_keyword(w) {
                if mods == "" { mods = w; } else { mods = f"{mods} {w}"; }
            }
        }
        i = i + 1;
    }
    return ScopeHeader.with_all(mods, attrs, ret_type, target, is_fn, is_block);
}

pub fn is_header_label(line: str) -> bool {
    let trimmed = line.trim();
    if !trimmed.ends_with(":") { return false; }
    return is_scope_header(trimmed);
}

pub fn parse_header_label(line: str) -> ScopeHeader => parse_scope_header(line);

pub comptime fn bind_header_attributes(attrs_node: ast, mods_node: ast) -> ast {
    return quote { $mods_node };
}

pub fn desugar_scope_headers(src: str) -> str {
    var stack = ScopeHeaderStack.create();
    var result = "";
    let lines = src.split("\n");
    let count = lines.len();
    var i = 0;
    while i < count {
        let raw_line = lines[i];
        let trimmed = raw_line.trim();
        if is_scope_header(trimmed) {
            stack.push(parse_scope_header(trimmed));
            i = i + 1;
            continue;
        }
        if stack.is_active() {
            let cur = stack.current();
            if cur.is_block && (trimmed == "}" || trimmed.starts_with("};")) {
                stack.pop();
                i = i + 1;
                continue;
            }
            if !trimmed.starts_with("//") && trimmed != "" {
                var decl = trimmed;
                if decl.ends_with(",") {
                    decl = decl.substring(0, decl.len() - 1).trim();
                }
                if cur.is_fn {
                    if cur.modifiers != "" && !decl.starts_with(cur.modifiers) {
                        decl = f"{cur.modifiers} {decl}";
                    }
                    if cur.attributes != "" && !decl.starts_with("[") {
                        decl = f"{cur.attributes} {decl}";
                    }
                    if !decl.contains("fn ") && decl.contains("(") {
                        decl = f"fn {decl}";
                    }
                    if cur.return_type != "" && !decl.contains("->") && decl.contains("=>") {
                        let arrow_pos = decl.find("=>");
                        let lhs = decl.substring(0, arrow_pos).trim();
                        let rhs = decl.substring(arrow_pos, decl.len()).trim();
                        decl = f"{lhs} -> {cur.return_type} {rhs}";
                    }
                } else if cur.target_kind == nameof(struct) || cur.target_kind == nameof(interface) {
                    if cur.modifiers != "" && !decl.starts_with(cur.modifiers) {
                        decl = f"{cur.modifiers} {decl}";
                    }
                    if cur.attributes != "" && !decl.starts_with("[") {
                        decl = f"{cur.attributes} {decl}";
                    }
                    if !decl.contains(cur.target_kind) {
                        decl = f"{cur.target_kind} {decl}";
                    }
                } else if cur.modifiers != "" || cur.attributes != "" {
                    if cur.attributes != "" && !decl.starts_with("[") {
                        decl = f"{cur.attributes} {decl}";
                    }
                    if cur.modifiers != "" && !decl.contains(cur.modifiers) {
                        decl = f"{cur.modifiers} {decl}";
                    }
                }
                result = result + decl + "\n";
                i = i + 1;
                continue;
            }
        }
        result = result + raw_line + "\n";
        i = i + 1;
    }
    return result;
}
