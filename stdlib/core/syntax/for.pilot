// =========================================================================
// FILE: stdlib/core/syntax/for.pilot
// 3-TIER DYNAMIC `for` EXPRESSION & STATEMENT (`FixedScalar`, `MutableBounds`,
// `WorklistStack` LIFO `continue a..b, ...;`, `CollectionYield` & `then`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.For;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    bind_receptor(nameof(for),      9,  0);
    bind_receptor(nameof(in),       10, 0);
    bind_receptor(nameof(then),     11, 0);
    bind_receptor(nameof(break),    13, 0);
    bind_receptor(nameof(continue), 13, 1);
    // The protocol a `for` loop calls, for compilers that lower `for`
    // directly: `get_enumerator()` once, then `move_next()` and `current`;
    // leaving the loop calls `close()` on an enumerator whose type has it.
    bind_enumerator(nameof(get_enumerator), nameof(move_next), nameof(current), nameof(close));
}
