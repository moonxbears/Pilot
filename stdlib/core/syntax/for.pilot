// =========================================================================
// FILE: stdlib/core/syntax/for.pilot
// 3-TIER DYNAMIC `for` EXPRESSION & STATEMENT (`FixedScalar`, `MutableBounds`,
// `WorklistStack` LIFO `continue a..b, ...;`, `CollectionYield` & `then`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.For;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    __engine("bind_receptor", nameof(for),      9,  0);
    __engine("bind_receptor", nameof(in),       10, 0);
    __engine("bind_receptor", nameof(then),     11, 0);
    __engine("bind_receptor", nameof(break),    13, 0);
    __engine("bind_receptor", nameof(continue), 13, 1);
}

pub syntax {
    for(binding, iterable, body) => quote {
        {
            var __enum = ($iterable).get_enumerator();
            loop {
                if !__enum.move_next() { break; }
                let $binding = __enum.current;
                $body
            }
        }
    };
}
