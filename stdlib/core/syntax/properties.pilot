// =========================================================================
// FILE: stdlib/core/syntax/properties.pilot
// VARIATION B IMPLICIT PROPERTIES (`field`/`value`), INDEXERS (`self[...]`)
// & OPERATOR (`op`) PROTOCOL DECLARATIONS
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Properties;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    __engine("bind_receptor", nameof(get), 23, 0);
    __engine("bind_receptor", nameof(set), 24, 0);
    __engine("bind_receptor", nameof(op),  25, 0);
}

pub syntax {
    get(body) => quote { $body };
    set(body) => quote { $body };
    op(sig, body) => __engine("decl_operator_fn", sig, body);
}
