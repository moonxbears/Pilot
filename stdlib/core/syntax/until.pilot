// =========================================================================
// FILE: stdlib/core/syntax/until.pilot
// INVERTED UNTIL LOOP SYNTAX MACRO (`until(cond, body)`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Until;

use Pilot.Core.Genesis.*;

pub syntax {
    until ( $cond:Expr , $body:Expr ) => quote {
        loop {
            if $cond { break; }
            $body
        }
    };
    until $cond:Expr $body:Block => quote {
        loop {
            if $cond { break; }
            $body
        }
    };
}
