// =========================================================================
// FILE: stdlib/core/syntax/fstring.pilot
// 100% PILOT-HOSTED `f"..."` INTERPOLATED STRING DESUGARING & SPLICING
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.FString;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

[Layout(c_abi)]
pub struct FStringSegment : IValue {
    pub is_expr: bool;
    pub text: str;
}

// Returns true if `raw` is a `f"..."` or `F"..."` interpolated string literal.
pub pure fn is_fstring_literal(raw: str) -> bool {
    if raw.len() < 3 {
        return false;
    }
    let b0 = raw.byte_at(0);
    let b1 = raw.byte_at(1);
    return (b0 == 102 || b0 == 70) && b1 == 34;
}

// Strips the outer `f"` and `"` (or `"` and `"`) from an interpolated string literal.
pub fn unwrap_fstring_body(raw: str) -> str {
    let n = raw.len();
    if is_fstring_literal(raw) && raw.byte_at(n - 1) == 34 {
        return raw.slice(2, n - 1);
    }
    if n >= 2 && raw.byte_at(0) == 34 && raw.byte_at(n - 1) == 34 {
        return raw.slice(1, n - 1);
    }
    return raw;
}

// Counts `{expr}` interpolation holes in `f"..."` (ignoring `{{` and `}}` escaped braces).
pub fn count_fstring_holes(raw: str) -> i64 {
    let body = unwrap_fstring_body(raw);
    let n = body.len();
    var count = 0;
    var i = 0;
    while i < n {
        let b = body.byte_at(i);
        if b == 123 {
            if i + 1 < n && body.byte_at(i + 1) == 123 {
                i = i + 2;
            } else {
                count = count + 1;
                var depth = 1;
                i = i + 1;
                while i < n && depth > 0 {
                    let nb = body.byte_at(i);
                    if nb == 123 {
                        depth = depth + 1;
                    } else if nb == 125 {
                        depth = depth - 1;
                    }
                    i = i + 1;
                }
            }
        } else {
            i = i + 1;
        }
    }
    return count;
}

// Extracts the `target_idx`-th `{expr}` expression from `f"..."` (0-indexed).
pub fn extract_fstring_hole_expr(raw: str, target_idx: i64) -> str {
    let body = unwrap_fstring_body(raw);
    let n = body.len();
    var hole_idx = 0;
    var i = 0;
    while i < n {
        let b = body.byte_at(i);
        if b == 123 {
            if i + 1 < n && body.byte_at(i + 1) == 123 {
                i = i + 2;
            } else {
                let expr_start = i + 1;
                var depth = 1;
                i = i + 1;
                while i < n && depth > 0 {
                    let nb = body.byte_at(i);
                    if nb == 123 {
                        depth = depth + 1;
                    } else if nb == 125 {
                        depth = depth - 1;
                    }
                    i = i + 1;
                }
                let expr_end = i - 1;
                if hole_idx == target_idx && expr_end >= expr_start {
                    return body.slice(expr_start, expr_end);
                }
                hole_idx = hole_idx + 1;
            }
        } else {
            i = i + 1;
        }
    }
    return "";
}

// Desugars an `f"..."` string into a `+`-concatenated Pilot expression string.
pub fn desugar_fstring_to_concat(raw: str) -> str {
    let body = unwrap_fstring_body(raw);
    let n = body.len();
    var out = "";
    var lit_start = 0;
    var i = 0;
    while i < n {
        let b = body.byte_at(i);
        if b == 123 && !(i + 1 < n && body.byte_at(i + 1) == 123) {
            if i > lit_start {
                let seg = "\"" + body.slice(lit_start, i) + "\"";
                if out.len() == 0 {
                    out = seg;
                } else {
                    out = out + " + " + seg;
                }
            }
            let expr_start = i + 1;
            var depth = 1;
            i = i + 1;
            while i < n && depth > 0 {
                let nb = body.byte_at(i);
                if nb == 123 {
                    depth = depth + 1;
                } else if nb == 125 {
                    depth = depth - 1;
                }
                i = i + 1;
            }
            let expr_end = i - 1;
            let expr_seg = "(" + body.slice(expr_start, expr_end) + ")";
            if out.len() == 0 {
                out = expr_seg;
            } else {
                out = out + " + " + expr_seg;
            }
            lit_start = i;
        } else {
            i = i + 1;
        }
    }
    if lit_start < n {
        let tail = "\"" + body.slice(lit_start, n) + "\"";
        if out.len() == 0 {
            out = tail;
        } else {
            out = out + " + " + tail;
        }
    }
    if out.len() == 0 {
        return "\"\"";
    }
    return out;
}
