// =========================================================================
// FILE: stdlib/core/syntax/switch.pilot
// EXHAUSTIVE PATTERN-BRANCHING `switch` EXPRESSION & STATEMENT (`case`, `default`)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Switch;

use Pilot.Core.Genesis.*;

comptime {
    __engine("bind_receptor", nameof(switch),  14, 0);
    __engine("bind_receptor", nameof(case),    15, 0);
    __engine("bind_receptor", nameof(default), 16, 0);
}

pub syntax {
    switch(target, arms) => quote {
        {
            let __sw_target = $target;
            $arms
        }
    };

    case(pat, body) => quote {
        if __sw_target == $pat {
            $body
        }
    };

    default(body) => quote {
        $body
    };
}
