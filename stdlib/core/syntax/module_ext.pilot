// =========================================================================
// FILE: stdlib/core/syntax/module_ext.pilot
// PACKAGES (`pkg`), IMPORTS (`use` / `use ext`), EXTENSIONS (`ext`),
// `*Bundle` COLLISION MODIFIERS (`coalesce`/`with`/`without`), `type` & `enum`
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.ModuleExt;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    __engine("register_module_kw", nameof(pkg), "declare_package_scope");
    __engine("register_module_kw", nameof(namespace), "declare_package_scope");
    __engine("register_module_kw", nameof(use), "import_symbol_path");
    __engine("register_modifier",  nameof(ext),       "extension_member");
    __engine("register_modifier",  nameof(extension), "extension_member");
    __engine("register_modifier",  nameof(const),     "binding_const");
    __engine("bind_receptor", nameof(type),     26, 0);
    __engine("bind_receptor", nameof(enum),     27, 0);
    __engine("bind_receptor", nameof(where),    28, 0);
    __engine("bind_receptor", nameof(as),       29, 0);
    __engine("bind_receptor", nameof(view),     29, 1);
    __engine("bind_receptor", nameof(coalesce), 30, 0);
    __engine("bind_receptor", nameof(with),     30, 1);
    __engine("bind_receptor", nameof(without),  30, 2);
    __engine("bind_receptor", nameof(on),       30, 3);
}

pub syntax {
    coalesce(fields) => quote { $fields };
    without(methods) => quote { $methods };
}
