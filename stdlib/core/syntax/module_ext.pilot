// =========================================================================
// FILE: stdlib/core/syntax/module_ext.pilot
// PACKAGES (`pkg`), IMPORTS (`use` / `use ext`), EXTENSIONS (`ext`),
// `*Bundle` COLLISION MODIFIERS (`coalesce`/`with`/`without`), `type` & `enum`
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.ModuleExt;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

comptime {
    register_module_kw(nameof(pkg), "declare_package_scope");
    register_module_kw(nameof(namespace), "declare_package_scope");
    register_module_kw(nameof(use), "import_symbol_path");
    register_modifier(nameof(ext),       "extension_member");
    register_modifier(nameof(extension), "extension_member");
    register_modifier(nameof(const),     "binding_const");
    bind_receptor(nameof(type),     26, 0);
    bind_receptor(nameof(enum),     27, 0);
    bind_receptor(nameof(where),    28, 0);
    bind_receptor(nameof(as),       29, 0);
    bind_receptor(nameof(view),     29, 1);
    bind_receptor(nameof(coalesce), 30, 0);
    bind_receptor(nameof(with),     30, 1);
    bind_receptor(nameof(without),  30, 2);
    bind_receptor(nameof(on),       30, 3);
}

pub syntax {
    coalesce(fields) => quote { $fields };
    without(methods) => quote { $methods };
}
