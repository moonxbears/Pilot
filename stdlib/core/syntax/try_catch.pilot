// =========================================================================
// FILE: stdlib/core/syntax/try_catch.pilot
// VALUES-FIRST `try`/`catch`, INLINE `expr catch`, POSTFIX `?` (`ITryOperator`)
// & PROHIBITED UNCHECKED POSTFIX `x!` (`NULL001`) LINT RECEPTOR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.TryCatch;

use Pilot.Core.Genesis.*;

// The handler of a `catch` clause: a block, or `=> value`. A typed
// `catch e: T` would catch only failures of type T; nothing checks the type
// yet, so it is refused rather than catching every failure.
pub syntax CatchBody {
    $handler:Block;
    => $handler:Expr;
    : $typed:Type $handler:Block;
}

// `catch e { .. }` binds the failure to `e`; `catch { .. }` does not.
pub syntax CatchClause {
    catch $( $err:Ident )? $h:CatchBody;
}

pub syntax {
    try $body:Block $( $c:CatchClause )*
        => quote { form(CoreForm::Try, $body,
                        form(CoreForm::Catch, $err, $handler),
                        form(CoreForm::Reject, "a typed `catch e: T` is not checked yet; write `catch e`", $typed)) };
    try $e:Expr => quote { form(CoreForm::Try, $e) };
}

comptime {
    // `expr catch e => fallback` after an expression.
    bind_receptor(nameof(catch), 19, 0);
    bind_receptor("!",     34, 1);
    // Postfix `x?` on a record asks `ITryOperator.is_success`; on success the
    // value is its `op ?`, otherwise `x` itself leaves as the failure. A
    // `catch e` clause binds `e` to the failed record's `failure()`.
    bind_try_protocol(nameof(is_success), "?", nameof(failure));
    // Lifting: a plain value where a failure-capable type is expected is
    // wrapped by that type's static `some` or `ok`; `none` there is its
    // static `none`. Read by the PilIR lowerer (selfhost/ir/lower_try.pilot).
    bind_lift("some");
    bind_lift("ok");
    bind_absent("none");
}
