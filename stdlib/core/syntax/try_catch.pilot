// =========================================================================
// FILE: stdlib/core/syntax/try_catch.pilot
// VALUES-FIRST `try`/`catch`, INLINE `expr catch`, POSTFIX `?` (`ITryOperator`)
// & PROHIBITED UNCHECKED POSTFIX `x!` (`NULL001`) LINT RECEPTOR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.TryCatch;

use Pilot.Core.Genesis.*;

comptime {
    __engine("bind_receptor", nameof(try),   18, 0);
    __engine("bind_receptor", nameof(catch), 19, 0);
    __engine("bind_receptor", "!",     34, 1);
    // Postfix `x?` on a record asks `ITryOperator.is_success`; on success the
    // value is its `op ?`, otherwise `x` itself leaves as the failure. A
    // `catch e` clause binds `e` to the failed record's `failure()`.
    __engine("bind_try_protocol", nameof(is_success), "?", nameof(failure));
    // Lifting: a plain value where a failure-capable type is expected is
    // wrapped by that type's static `some` or `ok`; `none` there is its
    // static `none`. Read by the PilIR lowerer (selfhost/ir/lower_try.pilot).
    __engine("bind_lift", "some");
    __engine("bind_lift", "ok");
    __engine("bind_absent", "none");
}

pub syntax {
    try(body, handler) => quote {
        {
            $body
            $handler
        }
    };

    catch(err_pat, body) => quote {
        $body
    };
}
