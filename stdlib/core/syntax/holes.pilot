// =========================================================================
// FILE: stdlib/core/syntax/holes.pilot
// THE HOLE KINDS OF A `syntax` RULE'S SEQUENCE HEAD (PROP-009 step 1a)
// =========================================================================
// A rule may spell its use as a sequence of words and holes:
//
//     with $open:Ident $name:Ident $body:Block => quote { .. };
//
// `$name:Kind` is a piece of code of that kind; `$( .. )?` is an optional
// group and `$( .. ) sep *` a repeated one. The seed reads only the position
// of each kind (`register_hole_kinds`): the order is append-only, and
// renaming a kind changes nothing.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Syntax.Holes;

use Pilot.Core.Genesis.*;

/// What a hole of a sequence head reads.
pub enum HoleKind : u8 {
    Expr,     // an expression
    Block,    // a block `{ .. }`
    Pattern,  // a `switch` pattern
    Ident,    // one name
    Type,     // a type
    Stmt,     // one statement
    Stmts,    // statements up to `}`, `,` or a word that starts the next
              // repetition of the group around it (one statement stands
              // as it is; several make a block)
    Rest,     // the rest of a construct a rule only reports: from a name, a
              // literal or `{` (not the `{` after a condition) up to a `;`
              // or a closer it did not open, or through the `}` that closes
              // the block it opened
}

comptime {
    register_hole_kinds(nameof(HoleKind));
}
