    return sizeof_type(type_name);
}

// Half-open [start, end_idx) range window for work-stealing & zero-allocation index partitioning
class RangeWindow {
    def __init__(self, start: i64, end_idx: i64) {
        self.start = start;
        if end_idx < start {
            self.end_idx = start;
        } else {
            self.end_idx = end_idx;
        }
    }

    def len(self) -> i64 {
        return self.end_idx - self.start;
    }

    def is_empty(self) -> bool {
        return self.end_idx <= self.start;
    }

    def contains(self, idx: i64) -> bool {
        return idx >= self.start and idx < self.end_idx;
    }

    def at(self, offset: i64) {
        let actual: i64 = self.start + offset;
        if offset < 0 or actual >= self.end_idx {
            return none;
        }
        return some(actual);
    }

    def split_mid(self) {
        let mid: i64 = self.start + ((self.end_idx - self.start) >> 1);
        return (RangeWindow(self.start, mid), RangeWindow(mid, self.end_idx));
    }

    def split_chunks(self, chunk_size: i64) {
        if chunk_size <= 0 {
            panic("RangeWindow.split_chunks requires chunk_size > 0");
        }
        var out = [];
        var cur: i64 = self.start;
        while cur < self.end_idx {
            var next_end: i64 = cur + chunk_size;
            if next_end > self.end_idx {
                next_end = self.end_idx;
            }
            out.append(RangeWindow(cur, next_end));
            cur = next_end;
        }
        return out;
    }

    def to_list(self) {
        var items = [];
        var i: i64 = self.start;
        while i < self.end_idx {
            items.append(i);
            i += 1;
        }
        return items;
    }
}
