// =========================================================================
// FILE: stdlib/core/mem.pilot
// STAGE 3A MEMORY, VIEWS, ENUMERATORS & ZERO-MARSHALLING C-ABI PRIMITIVES
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Memory;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

// Field-bearing bundle for contiguous pointer+length types (`slice<T>`, `str`, `SliceBuffer<T>`)
let RawStorageBundle<TItem: IAnyValue> = {
    pub data: ptr<TItem>;
    pub len:  usize;
};

// Method-only facet for contiguous views (`0` stored fields -> safe in `partial struct`)
let ContiguousViewFacet<TItem: IAnyValue> = {
    pub count:    usize { get => .len; }
    pub is_empty: bool  { get => .len == 0; }
    pub byte_len: usize { get => .len * sizeof(TItem); }
};

// Zero-allocation value enumerators for `slice<T>` and `stride<T>`
pub struct {
    [Layout(c_abi)]
    SliceEnumerator<TItem: IAnyValue> : ICursor<TItem> {
        pub data:  ptr<TItem>;
        pub len:   usize;
        pub index: usize;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !self.has_started {
                .has_started = true;
                return .len > 0;
            }
            let next_idx = .index + 1;
            if next_idx < .len {
                .index = next_idx;
                return true;
            }
            return false;
        }

        pub current: TItem {
            get => .data[.index];
        }
    }

    [Layout(c_abi)]
    StrideEnumerator<TItem: IAnyValue> : ICursor<TItem> {
        pub source: stride<TItem>;
        pub index:  usize;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !self.has_started {
                .has_started = true;
                return .source.len > 0;
            }
            let next_idx = .index + 1;
            if next_idx < .source.len {
                .index = next_idx;
                return true;
            }
            return false;
        }

        pub current: TItem {
            get => .source[.index];
        }
    }
}

// `ptr`, `slice`, `stride`, `array`, `simd`, `grid`, `ring`, `map`, `splat`,
// `pairs` and `expand` are declared once each in stdlib/core/primitives/.
pub partial struct {
    // Scoped Memory Pin Guard (`pin<T>` / `@T`) — `0b11` `IGuard`
    [Lang(Cfg.Lang.pin_t), Layout(c_abi)]
    pin<T: IAnyValue> : IGuard {
        pub target: ptr<T>;
        ~self() {}
    }
}

pub struct {
    // 11. Milestone 15.3.1 C-ABI Worklist Frame (`sizeof(RangeWindow<T>) == 2 * sizeof(T)`) — `0b00` `IValue`
    [Layout(c_abi)]
    RangeWindow<TIter: IValue> : IValue {
        pub current: TIter;
        pub max:     TIter;
    }

    // 12. Milestone 15.3.3 24-Byte Universal C-ABI Owned Buffer (`SliceBuffer<T>`) — `0b10` `IObject`
    [Layout(c_abi)]
    SliceBuffer<TItem: IAnyValue> : IBuffer<TItem>, IEnumerable<TItem, SliceEnumerator<TItem>> {
        *RawStorageBundle<TItem>;
        *ContiguousViewFacet<TItem>;
        pub cap: usize;

        ~self() {
            // Paired with `libpilot_rt` Perceus `pilot_rt_drop_reuse` / region deallocation
        }

        pub pure:
            op []  (idx: usize) -> TItem  => .data[idx];
            fn as_slice() -> slice<TItem> => slice<TItem> { data: .data, len: .len };
            fn contains(item: TItem) -> bool => .as_slice().contains(item);
            fn get_enumerator() -> SliceEnumerator<TItem> => .as_slice().get_enumerator();

            fn lens_column<TField: IAnyValue>(comptime field_sym: str) -> stride<TField> =>
                .as_slice().lens_column<TField>(field_sym);

            fn lens_map<TKey: IEquatable<TKey>, TVal: IAnyValue>(
                comptime key_sym: str,
                comptime val_sym: str
            ) -> map<TKey, TVal> =>
                .as_slice().lens_map<TKey, TVal>(key_sym, val_sym);

            fn as_structural_view<TDst: IValue>() -> stride<TDst> =>
                .as_slice().as_structural_view<TDst>();

        pub var:
            op []= (idx: usize, val: TItem) => { .data[idx] = val; }
            fn add(item: TItem) {
                if .len >= .cap {
                    seam("mem.slice_buffer_grow", "growing past the capacity needs the heap allocator behind libpilot_rt (F6)");
                }
                .data[.len] = item;
                .len = .len + 1;
            }
            fn clear() => { .len = 0; }
            fn remove_at(index: usize) -> TItem {
                assert(index < .len, "SliceBuffer.remove_at: index out of range");
                let item = .data[index];
                var i = index;
                let last = .len - 1;
                loop {
                    if !(i < last) { break; }
                    .data[i] = .data[i + 1];
                    i = i + 1;
                }
                .len = last;
                return item;
            }
    }

    // 13. The arena scope guard (`ArenaScope`, `0b11` `IGuard`) lives in
    // stdlib/core/arena.pilot beside `arena()`, which every program links.
}
