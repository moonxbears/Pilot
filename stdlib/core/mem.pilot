// =========================================================================
// FILE: stdlib/core/mem.pilot
// STAGE 3A MEMORY, VIEWS, ENUMERATORS & ZERO-MARSHALLING C-ABI PRIMITIVES
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Memory;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

// Field-bearing bundle for contiguous pointer+length types (`slice<T>`, `str`, `SliceBuffer<T>`)
let RawStorageBundle<TItem: IAnyValue> = {
    pub data: ptr<TItem>;
    pub len:  usize;
};

// Method-only facet for contiguous views (`0` stored fields -> safe in `partial struct`)
let ContiguousViewFacet<TItem: IAnyValue> = {
    pub count:    usize { get => .len; }
    pub is_empty: bool  { get => .len == 0; }
    pub byte_len: usize { get => .len * sizeof(TItem); }
};

// Zero-allocation value enumerators for `slice<T>` and `stride<T>`
pub struct {
    [Layout(c_abi)]
    SliceEnumerator<TItem: IAnyValue> : IEnumerator<TItem>, IReference {
        pub data:  ptr<TItem>;
        pub len:   usize;
        pub index: usize;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .len > 0;
            }
            let next_idx = .index + 1;
            if next_idx < .len {
                .index = next_idx;
                return true;
            }
            return false;
        }

        pub current: TItem {
            get => .data[.index];
        }
    }

    [Layout(c_abi)]
    StrideEnumerator<TItem: IAnyValue> : IEnumerator<TItem>, IReference {
        pub source: stride<TItem>;
        pub index:  usize;
        pub has_started: bool;

        pub var fn move_next() -> bool {
            if !.has_started {
                .has_started = true;
                return .source.len > 0;
            }
            let next_idx = .index + 1;
            if next_idx < .source.len {
                .index = next_idx;
                return true;
            }
            return false;
        }

        pub current: TItem {
            get => .source[.index];
        }
    }
}

pub partial struct {
    // 1. Raw 64-Bit Address Register (`ptr<T>` / `T*`) — `0b01` `IReference`
    [Lang(Cfg.Lang.ptr_t), Bits(Cfg.Reg.b64, Cfg.Reg.raw_ptr)]
    ptr<T: IAnyValue> : IIndexGet<usize, T>, IIndexSet<usize, T>, IEquatable<ptr<T>>, IReference {
        pub pure:
            op []  (idx: usize)    -> T      => __ssa_load(__ssa_gep(self, idx));
            op +   (offset: usize) -> ptr<T> => __ssa_gep(self, offset);
            op -   (offset: usize) -> ptr<T> => __ssa_gep(self, 0 - offset);
            op ==  (rhs: ptr<T>)   -> bool   => __ssa(Cfg.Ssa.eq, self, rhs);
            fn is_null()           -> bool   => (__ssa_cast(Cfg.Ssa.bitcast, self, usize)) == 0;
        pub var:
            op []= (idx: usize, v: T)        => __ssa_store(__ssa_gep(self, idx), v);
    }

    // 2. Borrowed Contiguous Slice (`slice<T>` / `T[]`) — 16-Byte `{ ptr<T>, usize }`, `0b01` `IReference`
    [Lang(Cfg.Lang.slice_t), Layout(c_abi)]
    slice<T: IAnyValue> : IReadOnlyList<T>, IReference {
        *RawStorageBundle<T>;
        *ContiguousViewFacet<T>;

        pub pure:
            op [] (idx: usize) -> T => .data[idx];

            op [] (r: range<usize>) -> slice<T> => slice<T> {
                data: .data + r.start,
                len:  r.end - r.start,
            };

            op [] (s: span<usize>) -> slice<T> => slice<T> {
                data: .data + s.start,
                len:  (s.end - s.start) + 1,
            };

            fn subslice(start: usize, sub_len: usize) -> slice<T> => slice<T> {
                data: .data + start,
                len:  sub_len,
            };

            fn get_enumerator() -> SliceEnumerator<T> => SliceEnumerator<T> {
                data:        .data,
                len:         .len,
                index:       0,
                has_started: false,
            };
    }

    // 3. Strided OffsetLens View (`stride<T>` / `T[..]`) — 24-Byte `{ ptr<T>, usize, isize }`, `0b01` `IReference`
    [Lang(Cfg.Lang.stride_t), Layout(c_abi)]
    stride<T: IAnyValue> : IReadOnlyList<T>, IReference {
        *RawStorageBundle<T>;
        *ContiguousViewFacet<T>;
        pub byte_step: isize;

        pub pure:
            op [] (idx: usize) -> T {
                let base_addr = __ssa_cast(Cfg.Ssa.bitcast, .data, usize);
                let step_off  = (idx as isize) * .byte_step;
                let elem_addr = (base_addr as isize + step_off) as usize;
                let elem_ptr  = __ssa_cast(Cfg.Ssa.bitcast, elem_addr, ptr<T>);
                return __ssa_load(elem_ptr);
            }

            fn get_enumerator() -> StrideEnumerator<T> => StrideEnumerator<T> {
                source:      self,
                index:       0,
                has_started: false,
            };
    }

    // 4. Inline Fixed-Size C-ABI Array (`array<T, N>` / `T[N]`) — `N * sizeof(T)` Bytes, `0b00` `IValue`
    [Lang(Cfg.Lang.array_t), Layout("inline_array")]
    array<T: IAnyValue, N: const usize> : IList<T>, IValue {
        pub count:    usize { get => N; }
        pub is_empty: bool  { get => N == 0; }

        pub pure:
            fn as_ptr() -> ptr<T> => __ssa_cast(Cfg.Ssa.bitcast, ref self, ptr<T>);

            fn as_slice() -> slice<T> => slice<T> {
                data: .as_ptr(),
                len:  N,
            };

            op [] (idx: usize) -> T => .as_ptr()[idx];

            fn contains(item: T) -> bool {
                var idx: usize = 0;
                loop {
                    if !(idx < N) { break; }
                    if .as_ptr()[idx] == item { return true; }
                    idx = idx + 1;
                }
                return false;
            }

            fn get_enumerator() -> SliceEnumerator<T> => .as_slice().get_enumerator();

        pub var:
            op []= (idx: usize, val: T) => { .as_ptr()[idx] = val; }
            fn add(item: T) {}
            fn clear() {}
            fn remove_at(index: usize) {}
    }

    // 5. Hardware SIMD Vector (`simd<T, N>` / `T@N`) — `N * sizeof(T)` Bytes, `0b00` `IValue`
    [Lang(Cfg.Lang.simd_t), Bits(Cfg.Reg.b0, Cfg.Reg.simd_v), Layout("inline_array")]
    simd<T: IValue, N: const usize> : IValue {
        pub lanes: usize { get => N; }
        pub pure:
            op [] (idx: usize) -> T => (__ssa_cast(Cfg.Ssa.bitcast, ref self, ptr<T>))[idx];
            op +  (rhs: simd<T, N>) -> simd<T, N> => __ssa(Cfg.Ssa.add, self, rhs);
            op -  (rhs: simd<T, N>) -> simd<T, N> => __ssa(Cfg.Ssa.sub, self, rhs);
            op *  (rhs: simd<T, N>) -> simd<T, N> => __ssa(Cfg.Ssa.mul, self, rhs);
    }

    // 6. 2D Inline Matrix / Grid (`grid<T, N, M>` / `T[N, M]`) — `N * M * sizeof(T)` Bytes, `0b00` `IValue`
    [Lang(Cfg.Lang.grid_t), Layout("inline_array")]
    grid<T: IAnyValue, N: const usize, M: const usize> : IValue {
        pub rows: usize { get => N; }
        pub cols: usize { get => M; }
        pub pure:
            fn as_ptr() -> ptr<T> => __ssa_cast(Cfg.Ssa.bitcast, ref self, ptr<T>);
            op [] (row: usize) -> ptr<T> => .as_ptr() + (row * M);
    }

    // 7. Power-of-Two Circular Ring Buffer View (`ring<T>` / `T[:]`) — 24-Byte `{ ptr<T>, usize, usize }`, `0b01` `IReference`
    [Lang(Cfg.Lang.ring_t), Layout(c_abi)]
    ring<T: IAnyValue> : IIndexGet<usize, T>, IReference {
        pub data: ptr<T>;
        pub mask: usize;
        pub head: usize;

        pub pure:
            op [] (idx: usize) -> T => .data[(.head + idx) & .mask];
    }

    // 8. Scoped Memory Pin Guard (`pin<T>` / `@T`) — `0b11` `IGuard`
    [Lang(Cfg.Lang.pin_t), Layout(c_abi)]
    pin<T: IAnyValue> : IGuard {
        pub target: ptr<T>;
        ~self() {}
    }

    // 9. Zero-Copy Key-Value Strided Projection (`map<K, V>`) — `0b01` `IReference`
    [Lang(Cfg.Lang.map_t), Layout(c_abi)]
    map<TKey: IEquatable<TKey>, TVal: IAnyValue> : IReference {
        pub keys: stride<TKey>;
        pub vals: stride<TVal>;
        pub count: usize { get => .keys.len; }

        pub pure fn contains_key(key: TKey) -> bool {
            var idx: usize = 0;
            loop {
                if !(idx < .keys.len) { break; }
                if .keys[idx] == key { return true; }
                idx = idx + 1;
            }
            return false;
        }
    }

    // 10. Splat & Flatten Carrier Primitives (`splat<T>`, `pairs<K, V>`, `expand<T>`)
    [Lang(Cfg.Lang.splat_t),  Layout(c_abi)] splat<T: IAnyValue>                     : IReference { pub items: slice<T>; }
    [Lang(Cfg.Lang.pairs_t),  Layout(c_abi)] pairs<K: IEquatable<K>, V: IAnyValue>   : IReference { pub entries: map<K, V>; }
    [Lang(Cfg.Lang.expand_t), Layout(c_abi)] expand<T: IAnyValue>                    : IReference { pub items: slice<T>; }
}

pub struct {
    // 11. Milestone 15.3.1 C-ABI Worklist Frame (`sizeof(RangeWindow<T>) == 2 * sizeof(T)`) — `0b00` `IValue`
    [Layout(c_abi)]
    RangeWindow<TIter: IValue> : IValue {
        pub current: TIter;
        pub max:     TIter;
    }

    // 12. Milestone 15.3.3 24-Byte Universal C-ABI Owned Buffer (`SliceBuffer<T>`) — `0b10` `IObject`
    [Layout(c_abi)]
    SliceBuffer<TItem: IAnyValue> : IList<TItem>, IObject {
        *RawStorageBundle<TItem>;
        *ContiguousViewFacet<TItem>;
        pub cap: usize;

        ~self() {
            // Paired with `libpilot_rt` Perceus `pilot_rt_drop_reuse` / region deallocation
        }

        pub pure:
            op []  (idx: usize) -> TItem  => .data[idx];
            fn as_slice() -> slice<TItem> => slice<TItem> { data: .data, len: .len };
            fn contains(item: TItem) -> bool => .as_slice().contains(item);
            fn get_enumerator() -> SliceEnumerator<TItem> => .as_slice().get_enumerator();

        pub var:
            op []= (idx: usize, val: TItem) => { .data[idx] = val; }
            fn add(item: TItem) {
                if .len < .cap {
                    .data[.len] = item;
                    .len = .len + 1;
                }
            }
            fn clear() => { .len = 0; }
            fn remove_at(index: usize) {
                if index < .len {
                    var i = index;
                    let last = .len - 1;
                    loop {
                        if !(i < last) { break; }
                        .data[i] = .data[i + 1];
                        i = i + 1;
                    }
                    .len = last;
                }
            }
    }

    // 13. Tier-1 64KB Lexical Bump Region Guard (`ArenaScope`) — `0b11` `IGuard`
    [Layout(c_abi)]
    ArenaScope : IGuard {
        pub region_view: slice<u8>;
        ~self() {}
    }
}
