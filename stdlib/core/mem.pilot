// std.mem — Contiguous Zero-Copy SliceBuffer<T>, RangeWindow & .rodata Frozen Memory Primitives

def alloc_slice(capacity: i64, elem_type: str = "f64", initial_length: i64 = 0) {
    return slice_buffer(capacity, elem_type, initial_length);
}

def shared_slice(name_or_path: str, capacity: i64, elem_type: str = "f64", initial_length: i64 = 0) {
    return shared_buffer(name_or_path, capacity, elem_type, initial_length);
}

def slice_len(buf) -> i64 {
    return __slice_len(buf);
}

def slice_cap(buf) -> i64 {
    return __slice_cap(buf);
}

def slice_stride(buf) -> i64 {
    return __slice_stride(buf);
}

def slice_ptr(buf) -> i64 {
    return __slice_ptr(buf);
}

def slice_is_readonly(buf) -> bool {
    return __slice_is_readonly(buf);
}

def slice_get(buf, idx: i64) {
    return __slice_get(buf, idx);
}

def slice_set(buf, idx: i64, val) {
    return __slice_set(buf, idx, val);
}

def slice_push(buf, val) {
    return __slice_push(buf, val);
}

def slice_clear(buf) {
    return __slice_clear(buf);
}

def slice_subview(buf, start: i64, length: i64) {
    return __slice_subview(buf, start, length);
}

def slice_to_list(buf) {
    return __slice_to_list(buf);
}

def cpp_backend_available() -> bool {
    return __cpp_backend_available();
}

def cpp_simd_bits() -> i64 {
    return __cpp_simd_bits();
}

def slice_sum(buf) {
    return __slice_sum(buf);
}

def slice_dot(a, b) -> f64 {
    return __slice_dot(a, b);
}

def slice_saxpy(alpha: f64, x, y) {
    return __slice_saxpy(alpha, x, y);
}

def slice_scale(alpha: f64, buf) {
    return __slice_scale(alpha, buf);
}

def slice_sort(buf) {
    return __slice_sort(buf);
}

def slice_welford(buf) {
    return __slice_welford(buf);
