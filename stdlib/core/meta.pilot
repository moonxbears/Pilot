    pub weight: i32;

    pub static pure fn create(doc: str) -> KeywordDocAttr => KeywordDocAttr {
        doc:    doc,
        weight: 10,
    };
}

[Layout(c_abi)]
pub struct KeywordInfoAttr : IAttribute, IValue {
    pub category: i32;
    pub doc:      str;
    pub weight:   i32;

    pub static pure fn create(category: i32, doc: str) -> KeywordInfoAttr => KeywordInfoAttr {
        category: category,
        doc:      doc,
        weight:   10,
    };
}

// Attach `[IdeToken]` to the 4 Lattice Origin Interfaces & `IAttribute` using symbolic constants:
[IdeToken(kind: LspKind.interface_k(), mods: LspMod.default_lib(), weight: 10)]
pub partial interface IAnyValue {}

[IdeToken(kind: LspKind.struct_k(),    mods: LspMod.readonly(),    weight: 20)]
pub partial interface IValue {}

[IdeToken(kind: LspKind.struct_k(),    mods: LspMod.none(),        weight: 20)]
pub partial interface IReference {}

[IdeToken(kind: LspKind.class_k(),     mods: LspMod.none(),        weight: 20)]
pub partial interface IObject {}

[IdeToken(kind: LspKind.class_k(),     mods: LspMod.modification(),weight: 30)]
pub partial interface IGuard {}

[IdeToken(kind: LspKind.decorator_k(), mods: LspMod.static_m(),    weight: 40)]
pub partial interface IAttribute {}

// Pure-Pilot Context-Sensitive Semantic Token Solver
[Lang(Cfg.Lang.ide_policy_slot), Layout(c_abi)]
pub partial struct IdeContextPolicy : IValue {
    pub static pure fn classify(
        inherited_kind: u32,
        inherited_mods: u32,
        ctx:            u32,
        lattice_bits:   u8
    ) -> tuple<u32, u32> {
        var mods: u32 = inherited_mods;
        if (ctx & AstContext.is_declaration()) != 0 {
            mods = mods | LspMod.declaration();
        }
        if (ctx & AstContext.is_mutating_target()) != 0 {
            mods = (mods & (~LspMod.readonly())) | LspMod.modification();
        }
        if (ctx & AstContext.is_local_capture()) != 0 {
            mods = mods | LspMod.static_m();
        }

        // Rule 1: Type-Position Symbolic Operators (`T@N`, `T[:]`, `T^`, `@T`, `T?`, `T!E`, `(A)=>R`)
        if (ctx & AstContext.is_type_operator()) != 0 {
            return (LspKind.operator_k(), mods | LspMod.definition());
        }

        // Rule 2: Homoiconic `quote { ... }` Splices (`$T` vs `$x`) & `~unquote` Escapes
        if (ctx & AstContext.is_quote_splice()) != 0 {
            if (ctx & AstContext.is_quote_type_param()) != 0 {
                return (LspKind.type_param_k(), mods | LspMod.static_m());
            }
            return (LspKind.param_k(), mods | LspMod.static_m());
        }
        if (ctx & AstContext.is_unquote_escape()) != 0 {
            return (LspKind.macro_k(), mods | LspMod.static_m());
        }

        // Rule 3: Variation B Contextual `field` and `value` Inside Property Accessors
        if ((ctx & AstContext.is_prop_accessor()) != 0) & ((ctx & AstContext.is_member_access()) == 0) {
            if (ctx & AstContext.is_contextual_field()) != 0 {
                return (LspKind.property_k(), mods | LspMod.default_lib() | LspMod.modification());
            }
            if (ctx & AstContext.is_contextual_value()) != 0 {
                return (LspKind.param_k(), mods | LspMod.default_lib() | LspMod.readonly());
            }
        }

        // Rule 4: `[...]` Attribute Prefix (`[Clamp]`, `[var c = Patch(orig, ...)]`)
        if (ctx & AstContext.is_attr_prefix()) != 0 {
            if (ctx & AstContext.is_type_symbol()) != 0 {
                return (LspKind.decorator_k(), mods);
            }
        }

        // Rule 5: `*Bundle`, `*Facet`, & `*myBlock` Splices
        if (ctx & AstContext.is_bundle_splice()) != 0 {
            return (inherited_kind, mods | LspMod.static_m());
        }

        // Rule 6: Dimensional Unit Suffixes (`100[m/s]`)
        if (ctx & AstContext.is_unit_dimension()) != 0 {
            return (LspKind.type_param_k(), mods | LspMod.default_lib());
        }

        // Rule 7: Variant Constructors (`::ok(v)`, `::some(x)`, `Shape.Circle(r)`)
        if (ctx & AstContext.is_variant_ctor()) != 0 {
            return (LspKind.enum_mem_k(), mods | LspMod.readonly());
        }

        // Rule 8: Call Target Disambiguation (`Point(1, 2)` vs `closure_var(1)` vs `syntax_macro(1)` vs `fn(1)`)
        if (ctx & AstContext.is_call_callee()) != 0 {
            if ((ctx & AstContext.is_syntax_macro()) != 0) & ((ctx & AstContext.is_raw_backtick()) == 0) {
                return (LspKind.macro_k(), mods);
            }
            if (ctx & AstContext.is_type_symbol()) != 0 {
                if (ctx & AstContext.is_lang_primitive()) != 0 {
                    return (LspKind.type_k(), mods | LspMod.default_lib());
                }
                let ctor_kind = if (lattice_bits & 0b10) != 0 {
                    LspKind.class_k()
                } else {
                    LspKind.struct_k()
                };
                return (ctor_kind, mods | LspMod.constructor());
            }
            if (ctx & AstContext.is_callable_object()) != 0 {
                let var_kind = if (ctx & AstContext.is_field_or_prop()) != 0 {
                    LspKind.property_k()
                } else {
                    inherited_kind
                };
                return (var_kind, mods | LspMod.callable());
            }
            if (ctx & AstContext.is_method_symbol()) != 0 {
                return (LspKind.method_k(), mods);
            }
            return (LspKind.function_k(), mods);
        }

        // Rule 9: Member Access (`obj.m`, `.m` PrefixDot, `node..m` Cascade, `xs ~> .m` Lens)
        // Colors method references like `items.map(.process)` as `Method` even without `()`!
        if (ctx & AstContext.is_member_access()) != 0 {
            if (ctx & AstContext.is_method_symbol()) != 0 {
                return (LspKind.method_k(), mods);
            }
            if (ctx & AstContext.is_field_or_prop()) != 0 {
                return (LspKind.property_k(), mods);
            }
        }

        // Rule 10: Type Annotations & Distributive `let Type<T> { ... }` Headers
        if ((ctx & AstContext.is_type_annotation()) != 0) | ((ctx & AstContext.is_type_symbol()) != 0) {
            if (ctx & AstContext.is_lang_primitive()) != 0 {
                return (LspKind.type_k(), mods | LspMod.default_lib());
            }
            if inherited_kind != 0 {
                return (inherited_kind, mods);
            }
            let ty_kind = if (lattice_bits & 0b10) != 0 {
                LspKind.class_k()
            } else {
                LspKind.struct_k()
            };
            return (ty_kind, mods);
        }

        // Rule 11: Declaration Modifiers (`pub`..`export`, `var`, `pure`, `lvl30`) vs Expression `lvl`
        if (ctx & AstContext.is_modifier_pos()) != 0 {
            if (ctx & AstContext.is_raw_backtick()) == 0 {
                return (LspKind.modifier_k(), mods | LspMod.static_m());
            }
        }

        // Rule 12: User or Core `syntax` Macro Invocations Without `()` (`break;`, `continue;`)
        if ((ctx & AstContext.is_syntax_macro()) != 0) & ((ctx & AstContext.is_raw_backtick()) == 0) {
            return (LspKind.macro_k(), mods);
        }

        return (inherited_kind, mods);
    }
}

// Pure-Pilot Hover & Inlay Hint Formatter (Replaces hardcoded strings in `pilot-lsp` & `pilot-ast`)
pub struct IdePresentationPolicy : IValue {
    pub static pure:
        fn lattice_badge(bits: u8) -> str =>
            if bits == 0b00 { "0b00 IValue (Trivial Copy)" }
            else if bits == 0b01 { "0b01 IReference (Lexical Borrow)" }
            else if bits == 0b10 { "0b10 IObject (Perceus Move + ~self)" }
            else { "0b11 IGuard (Scoped RAII + Borrow)" };

        fn format_type_hover(name: str, byte_size: usize, byte_align: usize, bits: u8) -> str =>
            f"**{name}** — `{byte_size} bytes` (`align {byte_align}`) | `{IdePresentationPolicy.lattice_badge(bits)}`";

        fn format_param_hover(param_name: str, param_type: str, target_offset: i64) -> str =>
            if target_offset >= 0 { f"- `{param_name}`: [`{param_type}`](#decl-{param_type}-{target_offset}) *(offset {target_offset})*" }
            else { f"- `{param_name}`: [`{param_type}`](#{param_type})" };

        fn format_return_hover(ret_type: str, target_offset: i64) -> str =>
            if target_offset >= 0 { f"**Returns:**\n- [`{ret_type}`](#decl-{ret_type}-{target_offset}) *(offset {target_offset})*" }
            else { f"**Returns:**\n- [`{ret_type}`](#{ret_type})" };

        fn format_overload_hover(index: usize, sig: str, decl_offset: i64) -> str =>
            f"{index}. `{sig}` *(decl offset {decl_offset})*";

        fn format_type_ref_hover(symbol_name: str, context_sig: str, ref_offset: i64) -> str =>
            f"- [`{symbol_name}`](#ref-{symbol_name}-{ref_offset}): `{context_sig}` *(offset {ref_offset})*";

        fn format_capture_inlay_hint(captures_csv: str) -> str =>
            f"/* captures: {captures_csv} */";
}

pub pure fn ide_classify_packed(inherited_kind: i64, inherited_mods: i64, ctx: i64, lattice_bits: i64) -> i64 {
    var mods: i64 = inherited_mods;
    if (ctx & 1) != 0 {
        mods = mods | 1;
    }
    if (ctx & 4096) != 0 {
        mods = (mods & 4294967291) | 128;
    }
    if (ctx & 16777216) != 0 {
        mods = mods | 8;
    }
    if (ctx & 8388608) != 0 {
        return (21 << 32) | (mods | 2);
    }
    if (ctx & 256) != 0 {
        if (ctx & 512) != 0 {
            return (6 << 32) | (mods | 8);
        }
        return (7 << 32) | (mods | 8);
    }
    if (ctx & 1024) != 0 {
        return (14 << 32) | (mods | 8);
    }
    if ((ctx & 16) != 0) && ((ctx & 8) == 0) {
        if (ctx & 1048576) != 0 {
            return (9 << 32) | (mods | 512 | 128);
        }
        if (ctx & 2097152) != 0 {
            return (7 << 32) | (mods | 512 | 4);
        }
    }
    if (ctx & 32) != 0 {
        if (ctx & 65536) != 0 {
            return (22 << 32) | mods;
        }
    }
    if (ctx & 64) != 0 {
        return (inherited_kind << 32) | (mods | 8);
    }
    if (ctx & 524288) != 0 {
        return (6 << 32) | (mods | 512);
    }
    if (ctx & 128) != 0 {
        return (10 << 32) | (mods | 4);
    }
    if (ctx & 2) != 0 {
        if ((ctx & 262144) != 0) && ((ctx & 4194304) == 0) {
            return (14 << 32) | mods;
        }
        if (ctx & 65536) != 0 {
            if (ctx & 131072) != 0 {
                return (1 << 32) | (mods | 512);
            }
            let ctor_k = if (lattice_bits & 2) != 0 { 2 } else { 5 };
            return (ctor_k << 32) | (mods | 1024);
        }
        if (ctx & 8192) != 0 {
            let var_k = if (ctx & 32768) != 0 { 9 } else { inherited_kind };
            return (var_k << 32) | (mods | 2048);
        }
        if (ctx & 16384) != 0 {
            return (13 << 32) | mods;
        }
        return (12 << 32) | mods;
    }
    if (ctx & 8) != 0 {
        if (ctx & 16384) != 0 {
            return (13 << 32) | mods;
        }
        if (ctx & 32768) != 0 {
            return (9 << 32) | mods;
        }
    }
    if ((ctx & 4) != 0) || ((ctx & 65536) != 0) {
        if (ctx & 131072) != 0 {
            return (1 << 32) | (mods | 512);
        }
        if inherited_kind != 0 {
            return (inherited_kind << 32) | mods;
        }
        let ty_k = if (lattice_bits & 2) != 0 { 2 } else { 5 };
        return (ty_k << 32) | mods;
    }
    if (ctx & 2048) != 0 {
        if (ctx & 4194304) == 0 {
            return (16 << 32) | (mods | 8);
        }
    }
    if ((ctx & 262144) != 0) && ((ctx & 4194304) == 0) {
        return (14 << 32) | mods;
    }
    return (inherited_kind << 32) | mods;
}

pub pure fn ide_format_type_hover(name: str, byte_size: i64, byte_align: i64, bits: i64) -> str {
    let badge = if bits == 0 {
        "0b00 IValue (Trivial Copy)"
    } else if bits == 1 {
        "0b01 IReference (Lexical Borrow)"
    } else if bits == 2 {
        "0b10 IObject (Perceus Move + ~self)"
    } else {
        "0b11 IGuard (Scoped RAII + Borrow)"
    };
    return "**" + name + "** — `" + byte_size + " bytes` (`align " + byte_align + "`) | `" + badge + "`";
}

pub pure fn ide_format_capture_inlay_hint(captures_csv: str) -> str {
    return "/* captures: " + captures_csv + " */";
}

