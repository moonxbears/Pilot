// =========================================================================
// 1. THE 7-PILLAR `[...]` ATTRIBUTE INTERFACES & PILOT-HOSTED `quote` WEAVERS
// =========================================================================
pub struct InheritPolicy : IValue {
    pub code: u8;
    pub static pure:
        fn override_policy() -> InheritPolicy => InheritPolicy { code: 0 };
        fn append_policy()   -> InheritPolicy => InheritPolicy { code: 1 };
        fn coalesce_policy() -> InheritPolicy => InheritPolicy { code: 2 };
}

pub interface {
    // Pillar 2: Compile-Time AOP Function Entry/Exit Interceptor
    IInterceptor<TContext: IAnyValue> : IAttribute {
        pub fn on_enter(fn_name: str) -> TContext;
        pub fn on_exit(ctx: TContext);

        // Pilot-Hosted AST Weaver for Pillar 2:
        pub comptime fn weave_fn(fn_name: str, orig_body: ast) -> ast => quote {
            {
                let __attr_ctx = self.on_enter($fn_name);
                defer self.on_exit(__attr_ctx);
                $orig_body
            }
        };
    }

    // Pillar 4: Zero-Storage Computed Property Formula Evaluator
    IFormulaAttribute<TOwner: IAnyValue, TOut: IAnyValue> : IAttribute {
        pub pure fn evaluate(owner: ref<TOwner>) -> TOut;

        // Pilot-Hosted AST Weaver for Pillar 4 (`0` backing storage bytes!):
        pub comptime fn weave_getter(owner_expr: ast) -> ast => quote {
            self.evaluate($owner_expr)
        };
    }

    // Pillar 5: Reactive Property Setter Validator & Change Notifier
    IReactiveAttribute<TVal: IAnyValue> : IAttribute {
        pub pure fn on_validating(old_val: TVal, new_val: TVal) -> TVal => new_val;
        pub fn on_changed(old_val: TVal, new_val: TVal) {}

        // Pilot-Hosted AST Weaver for Pillar 5 + Variation B `field` / `value`:
        pub comptime fn weave_setter(backing_field: ast, incoming_val: ast) -> ast => quote {
            {
                let __old_val = $backing_field;
                let __valid_val = self.on_validating(__old_val, $incoming_val);
                $backing_field = __valid_val;
                self.on_changed(__old_val, $backing_field);
            }
        };
    }

    // Pillar 6: Hierarchical Interface-to-Struct Attribute Propagation
    IInheritedAttribute : IAttribute {
        pub policy: InheritPolicy { get => InheritPolicy.override_policy(); }
    }

    // Pillar 7: Declarative ECS & `.pchor` Archetype Rule Scheduler
    IEcsRule<TEntity: IAnyValue> : IAttribute {
        pub pure fn matches(entity: ref<TEntity>) -> bool;
        pub var  fn apply(entity: var ref<TEntity>);

        pub comptime fn weave_ecs_step(entity_ref: ast) -> ast => quote {
            if self.matches($entity_ref) {
                self.apply(var ref $entity_ref);
            }
        };
    }
}

// =========================================================================
// 2. STANDARD BUILT-IN `[...]` ATTRIBUTES (`...Attr` -> `[ShortName]`)
// =========================================================================
pub struct {
    // Pillar 5 Reactive Clamping Attribute: `[Clamp(min: 0.0, max: 100.0, weight: 100)]`
    [Layout(c_abi)]
    ClampAttr<TVal: IComparable<TVal>> : IReactiveAttribute<TVal>, IValue {
        pub min:    TVal;
        pub max:    TVal;
        pub weight: i32;

        pub pure fn on_validating(old_val: TVal, new_val: TVal) -> TVal {
            if new_val < .min { return .min; }
            if new_val > .max { return .max; }
            return new_val;
        }
    }

    // Pillar 5 Reactive Change Listener: `[OnChange(callback, weight: 50)]`
    [Layout(c_abi)]
    OnChangeAttr<TVal: IAnyValue> : IReactiveAttribute<TVal>, IValue {
        pub callback: fn<(TVal, TVal), void>;
        pub weight:   i32;

        pub pure fn on_validating(old_val: TVal, new_val: TVal) -> TVal => new_val;
        pub fn on_changed(old_val: TVal, new_val: TVal) {}
    }

    // Pillar 4 Computed Property Formula: `[Formula((u) => u.base_atk * u.crit_mult)]`
    [Layout(c_abi)]
    FormulaAttr<TOwner: IAnyValue, TOut: IAnyValue> : IFormulaAttribute<TOwner, TOut>, IValue {
        pub expr_fn: fn<ref<TOwner>, TOut>;
        pub weight:  i32;

        pub pure fn evaluate(owner: ref<TOwner>) -> TOut => owner as TOut;
    }

    // Pillar 2 AOP Trace Span Interceptor: `[TraceSpan(name: "step_physics", weight: 50)]`
    [Layout(c_abi)]
    TraceSpanAttr : IInterceptor<u64>, IInheritedAttribute, IValue {
        pub name:   str;
        pub weight: i32;

        pub fn on_enter(fn_name: str) -> u64 => 0;
        pub fn on_exit(start_tick: u64) {}
    }

    // Pillar 7 Declarative ECS Archetype Rule: `[Rule(when_fn, then_fn, weight: 10)]`
    [Layout(c_abi)]
    RuleAttr<TEntity: IAnyValue> : IEcsRule<TEntity>, IValue {
        pub when_fn: fn<ref<TEntity>, bool>;
        pub then_fn: fn<var ref<TEntity>, void>;
        pub weight:  i32;

        pub pure fn matches(entity: ref<TEntity>) -> bool => true;
        pub var  fn apply(entity: var ref<TEntity>) {}
    }

    // Real-Time & Zero-Allocation Verification Attributes (`[HardRealtime]`, `[Wcet]`, `[ZeroRuntime]`, `[Kernel]`)
    [Layout(c_abi)] HardRealtimeAttr : IInheritedAttribute, IValue { pub weight: i32; }
    [Layout(c_abi)] WcetAttr         : IInheritedAttribute, IValue { pub budget_ns: u64; pub weight: i32; }
    [Layout(c_abi)] ZeroRuntimeAttr  : IInheritedAttribute, IValue { pub weight: i32; }
    [Layout(c_abi)] KernelAttr       : IAttribute,          IValue { pub workgroup_size: u32; pub weight: i32; }
}

// =========================================================================
// 3. PILOT-HOSTED `.pchor` CUE VERIFIER & `state` TYPESTATE MACROS
// =========================================================================
// Enforces the 2-Bit Lattice Cue Boundary Law 100% in Pilot:
// Only `0b00` (`IValue`) or `iso`-qualified `0b10` (`IObject`) may cross a cue!
pub comptime fn verify_cue_payload<TPayload: IAnyValue>(is_iso_qualified: bool) {
    let bits = lattice_bits_of(TPayload);
    if (bits & Cfg.Lattice.reference) != 0 {
        compile_error("LatticeContractMismatch: Borrowed 0b01 IReference or 0b11 IGuard cannot cross a .pchor cue boundary");
    }
    if ((bits & Cfg.Lattice.object) != 0) && (!is_iso_qualified) {
        compile_error("LatticeContractMismatch: Owned 0b10 IObject crossing a .pchor cue boundary must be 'iso' qualified");
    }
}

pub syntax {
    state(state_decl)         => quote { $state_decl };
    blueprint(blueprint_decl) => quote { $blueprint_decl };
    role(role_decl)           => quote { $role_decl };
    cue(cue_decl)             => quote { $cue_decl };
    route(route_expr)         => quote { $route_expr };
}

// =========================================================================
// 4. DEFERRED STAGE 4 MATH & BITWISE FACETS (`0` Fields -> `partial` Safe!)
// =========================================================================
let SignedMathFacet<TSelf: INumber<TSelf>> = {
    pub pure:
        fn min(other: TSelf) -> TSelf => if self < other { self } else { other };
        fn max(other: TSelf) -> TSelf => if self > other { self } else { other };

        fn clamp(lo: TSelf, hi: TSelf) -> TSelf {
            if self < lo { return lo; }
            if self > hi { return hi; }
            return self;
        }

        fn signum() -> TSelf {
            let zero = 0 as TSelf;
            if self < zero { return -(1 as TSelf); }
            if self > zero { return 1 as TSelf; }
            return zero;
        }

        fn pow(exp: u32) -> TSelf {
            var base: TSelf = self;
            var res:  TSelf = 1 as TSelf;
            var e:    u32   = exp;
            while e > 0 {
                if (e & 1) == 1 {
                    res = res * base;
                }
                base = base * base;
                e = e >> 1;
            }
            return res;
        }
};

let UnsignedBitFacet<TSelf: INumber<TSelf>> = {
    pub pure:
        fn min(other: TSelf) -> TSelf => if self < other { self } else { other };
        fn max(other: TSelf) -> TSelf => if self > other { self } else { other };

        fn clamp(lo: TSelf, hi: TSelf) -> TSelf {
            if self < lo { return lo; }
            if self > hi { return hi; }
            return self;
        }

        fn is_power_of_two() -> bool {
            let zero = 0 as TSelf;
            if self == zero { return false; }
            return (self & (self - (1 as TSelf))) == zero;
        }

        fn count_ones() -> u32 {
            var v: TSelf = self;
            var c: u32   = 0;
            let zero     = 0 as TSelf;
            while v != zero {
                v = v & (v - (1 as TSelf));
                c = c + 1;
            }
            return c;
        }
};

let FloatIeeeFacet<TSelf: INumber<TSelf>> = {
    pub pure:
        fn abs() -> TSelf => if self < (0.0 as TSelf) { -self } else { self };
        fn min(other: TSelf) -> TSelf => if self < other { self } else { other };
        fn max(other: TSelf) -> TSelf => if self > other { self } else { other };

        fn clamp(lo: TSelf, hi: TSelf) -> TSelf {
            if self < lo { return lo; }
            if self > hi { return hi; }
            return self;
        }

        fn lerp(target: TSelf, t: TSelf) -> TSelf => self + ((target - self) * t);
        fn is_nan() -> bool => self != self;
};

pub partial struct {
    i8    { *SignedMathFacet<i8>; }
    i16   { *SignedMathFacet<i16>; }
    i32   { *SignedMathFacet<i32>; }
    i64   { *SignedMathFacet<i64>; }
    i128  { *SignedMathFacet<i128>; }
    isize { *SignedMathFacet<isize>; }

    u8    { *UnsignedBitFacet<u8>; }
    u16   { *UnsignedBitFacet<u16>; }
    u32   { *UnsignedBitFacet<u32>; }
    u64   { *UnsignedBitFacet<u64>; }
    u128  { *UnsignedBitFacet<u128>; }
    usize { *UnsignedBitFacet<usize>; }

    f16   { *FloatIeeeFacet<f16>; }
    f32   { *FloatIeeeFacet<f32>; }
    f64   { *FloatIeeeFacet<f64>; }
    f128  { *FloatIeeeFacet<f128>; }
}

// =========================================================================
// 5. PILLAR 8 (100% PILOT-HOSTED): NON-DESTRUCTIVE FUNCTION CLONING & PATCHING
// Uses `__ast_lines`, `__replace_ast`, and `__parse_ast` from `core.pilot`!
// =========================================================================
pub struct PatchPart : IValue {
    pub kind: u8;
    pub static pure:
        fn all()       -> PatchPart => PatchPart { kind: 0 };
        fn signature() -> PatchPart => PatchPart { kind: 1 };
        fn params()    -> PatchPart => PatchPart { kind: 2 };
        fn body()      -> PatchPart => PatchPart { kind: 3 };
}

[Lang(Cfg.Lang.patch_attr_slot)]
pub interface IPatchAttribute : IAttribute {
    pub pure fn clone_ast() -> ast;
    pub var  fn patch()     -> ast;
}

pub struct {
    // Interactive CST/AST Clone & Patch Builder:
    // `[var contents = Patch(myorigfunc, PatchPart.body(), 3 .. 5)]`
    [Layout(c_abi)]
    PatchAttr<TTargetFn: IAnyValue> : IPatchAttribute, IValue {
        pub target_fn:   TTargetFn;
        pub part:        PatchPart;
        pub window:      span<usize>;
        pub source_buf:  SliceBuffer<str>;
        pub cloned_root: ast;
        pub weight:      i32;

        // Line-Window Indexer (`contents.line[5]` / `contents.line[5] = ...` and `contents.line5`)
        pub self[line_idx: usize] -> str {
            get => .source_buf[line_idx];
            set {
                comptime {
                    if !.window.contains(line_idx) {
                        compile_error("PatchLineOutOfWindow: Attempted to mutate a line outside the declared Patch window");
                    }
                }
                .source_buf[line_idx] = value;
            }
        }

        pub pure fn clone_ast() -> ast => .cloned_root;

        pub var:
            fn replace_ast(pattern: ast, replacement: ast) {
                .cloned_root = __replace_ast(.cloned_root, pattern, replacement);
            }

            fn patch() -> ast => __parse_ast(.source_buf, .cloned_root);
    }

    // Declarative 1-Line Whole-Function Patch & Clone:
    [Layout(c_abi)]
    PatchReplaceAttr<TTargetFn: IAnyValue> : IPatchAttribute, IValue {
        pub target_fn: TTargetFn;
        pub part:      PatchPart;
        pub window:    span<usize>;
        pub rewrite:   fn<str, str>;
        pub weight:    i32;

        pub pure fn clone_ast() -> ast => __ssa_cast(Cfg.Ssa.bitcast, 0, ast);
        pub var  fn patch()     -> ast => .clone_ast();
    }
}
