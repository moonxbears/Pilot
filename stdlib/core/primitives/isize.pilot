// =========================================================================
// FILE: stdlib/core/primitives/isize.pilot
// POINTER-WIDTH SIGNED TWO'S-COMPLEMENT INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.ISize;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(20, "Pointer-width signed two's-complement integer.")]
[Lang(Cfg.Lang.isize_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_s)]
pub partial struct isize : INumber<isize>, IBitwiseOperator<isize>, INegOperator<isize> {
    pub pure:
        op +   (rhs: isize) -> isize => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: isize) -> isize => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: isize) -> isize => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: isize) -> isize => __ssa(MachineOp::SDiv,     self, rhs);
        op %   (rhs: isize) -> isize => __ssa(MachineOp::SRem,     self, rhs);
        op %%  (rhs: isize) -> isize => __ssa(MachineOp::SRemEuc, self, rhs);
        op +|  (rhs: isize) -> isize => __ssa(MachineOp::SAddSat, self, rhs);
        op -|  (rhs: isize) -> isize => __ssa(MachineOp::SSubSat, self, rhs);
        op *|  (rhs: isize) -> isize => __ssa(MachineOp::SMulSat, self, rhs);
        op +%  (rhs: isize) -> isize => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: isize) -> isize => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: isize) -> isize => __ssa(MachineOp::MulWrap, self, rhs);
        op -   ()           -> isize => __ssa_unary(MachineOp::Neg, self);
        op &   (rhs: isize) -> isize => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: isize) -> isize => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: isize) -> isize => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()           -> isize => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32)  -> isize => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32)  -> isize => __ssa(MachineOp::AShr,     self, bits);
        op ==  (rhs: isize) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: isize) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: isize) -> bool  => __ssa(MachineOp::SLt,      self, rhs);
        op <=  (rhs: isize) -> bool  => __ssa(MachineOp::SLe,      self, rhs);
        op >   (rhs: isize) -> bool  => __ssa(MachineOp::SGt,      self, rhs);
        op >=  (rhs: isize) -> bool  => __ssa(MachineOp::SGe,      self, rhs);
        op <=> (rhs: isize) -> order => __ssa(MachineOp::Cmp3S,   self, rhs);
        op ..< (rhs: isize) -> range<isize> => range<isize> { start: self, end: rhs };
        op ..  (rhs: isize) -> range<isize> => range<isize> { start: self, end: rhs };
        op ..= (rhs: isize) -> span<isize>  => span<isize>  { start: self, end: rhs };
        fn step_by(step: isize) -> step<isize> => step<isize> { bounds: range<isize> { start: self, end: self }, step_by: step };
        fn abs() -> isize {
            if self < 0 { return -self; }
            return self;
        }
}
