// =========================================================================
// FILE: stdlib/core/primitives/map.pilot
// ZERO-COPY KEY-VALUE STRIDED PROJECTION (`map<K, V>`, 0b01 IReference)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.Map;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(29, "Zero-copy key-value strided column projection map.")]
[Lang(Cfg.Lang.map_t), Layout(c_abi)]
pub partial struct map<TKey: IEquatable<TKey>, TVal: IAnyValue> : IDictionaryView<TKey, TVal> {
    pub keys: stride<TKey>;
    pub vals: stride<TVal>;
    pub count: usize { get => .keys.len; }

    pub pure fn contains_key(key: TKey) -> bool {
        var idx: usize = 0;
        loop {
            if !(idx < .keys.len) { break; }
            if .keys[idx] == key { return true; }
            idx = idx + 1;
        }
        return false;
    }

    pub pure fn has(key: TKey) -> bool => .contains_key(key);

    pub pure fn find_index(key: TKey) -> isize {
        var idx: usize = 0;
        loop {
            if !(idx < .keys.len) { break; }
            if .keys[idx] == key { return idx as isize; }
            idx = idx + 1;
        }
        return -1;
    }

    pub pure fn get(key: TKey) -> option<TVal> {
        let idx = .find_index(key);
        if idx >= 0 {
            return some .vals[idx as usize];
        }
        return none;
    }

    pub pure op [] (key: TKey) -> TVal {
        let idx = .find_index(key);
        if idx >= 0 {
            return .vals[idx as usize];
        }
        panic("Key not found in map projection");
    }
}

// Pure Pilot dynamic key-value dictionary (replaces __engine("map_new"), __engine("map_set"), __engine("map_get"))
[KeywordDefAttr(29, "Owned dynamic heap map buffer backed by linear key/value vectors.")]
pub partial struct MapBuffer<TKey: IEquatable<TKey>, TVal: IAnyValue> : IDictionaryBuffer<TKey, TVal> {
    pub keys: SliceBuffer<TKey>;
    pub vals: SliceBuffer<TVal>;

    pub self() {
        .keys = SliceBuffer<TKey>();
        .vals = SliceBuffer<TVal>();
    }

    pub count: usize { get => .keys.len; }

    pub pure fn find_index(key: TKey) -> isize {
        var i: usize = 0;
        loop {
            if !(i < .keys.len) { break; }
            if .keys[i] == key { return i as isize; }
            i = i + 1;
        }
        return -1;
    }

    pub pure fn has(key: TKey) -> bool => .find_index(key) >= 0;
    pub pure fn contains_key(key: TKey) -> bool => .find_index(key) >= 0;

    pub pure fn get(key: TKey) -> option<TVal> {
        let idx = .find_index(key);
        if idx >= 0 { return some .vals[idx as usize]; }
        return none;
    }

    pub fn set(key: TKey, val: TVal) {
        let idx = .find_index(key);
        if idx >= 0 {
            .vals[idx as usize] = val;
        } else {
            .keys.add(key);
            .vals.add(val);
        }
    }

    pub fn remove(key: TKey) -> bool {
        let idx = .find_index(key);
        if idx >= 0 {
            .keys.remove_at(idx as usize);
            .vals.remove_at(idx as usize);
            return true;
        }
        return false;
    }

    pub fn clear() {
        .keys.clear();
        .vals.clear();
    }

    pub pure op [] (key: TKey) -> TVal {
        let idx = .find_index(key);
        if idx >= 0 { return .vals[idx as usize]; }
        panic("Key not found in map buffer");
    }

    pub op []= (key: TKey, val: TVal) {
        .set(key, val);
    }
}

// Canonical type alias & high-level dynamic dictionary
pub partial struct Map<TKey: IEquatable<TKey>, TVal: IAnyValue> : IDictionaryBuffer<TKey, TVal> {
    pub inner: MapBuffer<TKey, TVal>;

    pub self() {
        .inner = MapBuffer<TKey, TVal>();
    }

    pub count: usize { get => .inner.count; }
    pub pure fn has(key: TKey) -> bool => .inner.has(key);
    pub pure fn get(key: TKey) -> option<TVal> => .inner.get(key);
    pub fn set(key: TKey, val: TVal) { .inner.set(key, val); }
    pub fn remove(key: TKey) -> bool => .inner.remove(key);
    pub fn clear() { .inner.clear(); }
    pub pure op [] (key: TKey) -> TVal => .inner[key];
    pub op []= (key: TKey, val: TVal) { .inner[key] = val; }

    pub static fn new_handle() -> i64 => __engine("map_new");
    pub static fn set_handle(m: i64, key: any, val: any) -> i64 => __engine("map_set", m, key, val);
    pub static fn get_handle(m: i64, key: any) -> any => __engine("map_get", m, key);
    pub static fn has_handle(m: i64, key: any) -> bool => __engine("map_has", m, key) as bool;
}

// Pure Pilot stand-alone functional map primitives (replaces direct __engine calls)
pub pure fn map_new_pure() -> i64 => __engine("map_new");
pub fn map_set_pure(m: i64, k: str, v: any) -> i64 => __engine("map_set", m, k, v);
pub pure fn map_get_pure(m: i64, k: str) -> any => __engine("map_get", m, k);
pub fn map_has_pure(m: i64, k: str) -> bool => __engine("map_has", m, k) as bool;
