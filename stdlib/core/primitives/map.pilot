// =========================================================================
// FILE: stdlib/core/primitives/map.pilot
// OWNED DICTIONARY (`Map<K, V>`, 0b10 IObject) AND ITS ENGINE-OP OWNERS
// =========================================================================
// Every run links this file (selfhost/cli/host.pilot `cli_run_links`), so it
// imports only what the seed can compile. The borrowed `map<K, V>` view is in
// map_view.pilot.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.Map;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

// A map owns its values: dropping a map drops each value in the order of
// their keys (selfhost/check/drops.pilot). The engine holds a map by itself
// (stdlib/core/builtins/native_calls.pilot), so `map_values` lists its
// values for `str_len` and `list_get` to walk, and `map_get` reads the value
// an assignment replaces (none when the key is new). Reading a value by key,
// or with `for`, borrows it.
comptime {
    bind_owned_elements(nameof(Map), "str_len", "list_get", "map_values", "map_get");
}

/// An owned dictionary of values by key. Each public method calls the one
/// `[EngineOp]` method that holds its engine op (PROP-002a Amendment A1,
/// PROP-002b). `Map<K, V>()` is still the engine's `map_new` through a
/// constructor binding (stdlib/core/builtins/native_calls.pilot): a
/// constructor that sets `self` to an engine handle does not lower to PilIR
/// yet (`ir.lower_construct`, PROP-002a C1).
[StandIn("map.storage", "a pure-Pilot hash map holding its keys and values", "the engine's map holds the entries and a Map value is its handle; the type declares no fields", "F6")]
pub partial struct Map<TKey: IEquatable<TKey>, TVal: IAnyValue> : IDictionaryBuffer<TKey, TVal> {
    [EngineOp]
    priv static fn get_internal(m: Map<TKey, TVal>, key: TKey) -> option<TVal> => __engine("map_get", m, key);
    [EngineOp]
    priv static fn set_internal(m: Map<TKey, TVal>, key: TKey, val: TVal) => __engine("map_set", m, key, val);
    [EngineOp]
    priv static fn has_internal(m: Map<TKey, TVal>, key: TKey) -> bool => __engine("map_has", m, key);
    [EngineOp]
    priv static fn keys_internal(m: Map<TKey, TVal>) -> List<TKey> => __engine("map_keys", m);
    [EngineOp]
    priv static fn remove_internal(m: Map<TKey, TVal>, key: TKey) -> bool => __engine("map_remove", m, key);

    /// The value at `key`, or none (the engine's null; stand-in
    /// `ir.absent_as_null`).
    pub pure fn get(key: TKey) -> option<TVal> => Map.get_internal(self, key);
    /// Sets the value at `key`, replacing any value there.
    pub fn set(key: TKey, val: TVal) { Map.set_internal(self, key, val); }
    /// Whether `key` has a value.
    pub pure fn has(key: TKey) -> bool => Map.has_internal(self, key);
    /// The keys, in key order.
    pub pure fn keys() -> List<TKey> => Map.keys_internal(self);
    /// Removes `key`; false when it was not there.
    pub fn remove(key: TKey) -> bool => Map.remove_internal(self, key);

    /// How many keys have a value. The engine keeps no count it hands out,
    /// so this lists the keys (linear in their number).
    pub count: i64 { get => .keys().len(); }
    /// Removes every key, one at a time (the engine has no op that empties
    /// a map).
    pub fn clear() {
        for k in .keys() {
            let _ = .remove(k);
        }
    }

    pub fn get_enumerator() -> ListEnumerator<TKey> => .keys().get_enumerator();
    pub pure op [] (key: TKey) -> TVal => .get(key) ?? fault("Map: key not found");
    pub op []= (key: TKey, val: TVal) { .set(key, val); }
}
