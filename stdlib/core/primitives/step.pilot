// =========================================================================
// FILE: stdlib/core/primitives/step.pilot
// STEPPED INTERVAL PROGRESSION DESCRIPTOR (`step<T>`, 0b00 IValue)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.Step;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(28, "Stepped interval progression advancing by a fixed non-zero step.")]
[Lang(Cfg.Lang.step_t), Layout(c_abi)]
pub partial struct step<T: INumber<T>> : IEnumerable<T, RangeEnumerator<T>>, IValue {
    pub bounds:  range<T>;
    pub step_by: T;

    pub pure fn get_enumerator() -> RangeEnumerator<T> => RangeEnumerator<T> {
        current_val: .bounds.start,
        end_val:     .bounds.end,
        step_val:    .step_by,
        has_started: false,
    };
}
