// =========================================================================
// FILE: stdlib/core/primitives/u128.pilot
// 128-BIT UNSIGNED INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.U128;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(21, "128-bit unsigned integer.")]
[Lang(Cfg.Lang.u128_t), Bits(Cfg.Reg.b128, Cfg.Reg.gpr_u)]
[StandIn("prim.wide_scalar_64", "a 128-bit integer value", "held in the engine's 64-bit integer: a value or result outside 64 bits wraps, and a literal outside 64 bits stops at convert.wide_scalar", "F6")]
pub partial struct u128 : INumber<u128>, IBitwiseOperator<u128> {
    pub pure:
        op +   (rhs: u128) -> u128  => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: u128) -> u128  => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: u128) -> u128  => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: u128) -> u128  => __ssa(MachineOp::UDiv,     self, rhs);
        op %   (rhs: u128) -> u128  => __ssa(MachineOp::URem,     self, rhs);
        op %%  (rhs: u128) -> u128  => __ssa(MachineOp::URemEuc, self, rhs);
        op +|  (rhs: u128) -> u128  => __ssa(MachineOp::UAddSat, self, rhs);
        op -|  (rhs: u128) -> u128  => __ssa(MachineOp::USubSat, self, rhs);
        op *|  (rhs: u128) -> u128  => __ssa(MachineOp::UMulSat, self, rhs);
        op +%  (rhs: u128) -> u128  => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: u128) -> u128  => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: u128) -> u128  => __ssa(MachineOp::MulWrap, self, rhs);
        op &   (rhs: u128) -> u128  => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: u128) -> u128  => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: u128) -> u128  => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()          -> u128  => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> u128  => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> u128  => __ssa(MachineOp::LShr,     self, bits);
        op ==  (rhs: u128) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: u128) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: u128) -> bool  => __ssa(MachineOp::ULt,      self, rhs);
        op <=  (rhs: u128) -> bool  => __ssa(MachineOp::ULe,      self, rhs);
        op >   (rhs: u128) -> bool  => __ssa(MachineOp::UGt,      self, rhs);
        op >=  (rhs: u128) -> bool  => __ssa(MachineOp::UGe,      self, rhs);
        op <=> (rhs: u128) -> order => __ssa(MachineOp::Cmp3U,   self, rhs);
        op ..< (rhs: u128) -> range<u128> => range<u128> { start: self, end: rhs };
        op ..  (rhs: u128) -> range<u128> => range<u128> { start: self, end: rhs };
        op ..= (rhs: u128) -> span<u128>  => span<u128>  { start: self, end: rhs };
        fn step_by(step: u128) -> step<u128> => step<u128> { bounds: range<u128> { start: self, end: self }, step_by: step };
}
