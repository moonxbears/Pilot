// =========================================================================
// FILE: stdlib/core/primitives/i128.pilot
// 128-BIT SIGNED TWO'S-COMPLEMENT INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.I128;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(20, "128-bit signed two's-complement integer.")]
[Lang(Cfg.Lang.i128_t), Bits(Cfg.Reg.b128, Cfg.Reg.gpr_s)]
[StandIn("prim.wide_scalar_64", "a 128-bit integer value", "held in the engine's 64-bit integer: a value or result outside 64 bits wraps, and a literal outside 64 bits stops at convert.wide_scalar", "F6")]
pub partial struct i128 : INumber<i128>, IBitwiseOperator<i128>, INegOperator<i128> {
    pub pure:
        op +   (rhs: i128) -> i128  => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: i128) -> i128  => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: i128) -> i128  => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: i128) -> i128  => __ssa(MachineOp::SDiv,     self, rhs);
        op %   (rhs: i128) -> i128  => __ssa(MachineOp::SRem,     self, rhs);
        op %%  (rhs: i128) -> i128  => __ssa(MachineOp::SRemEuc, self, rhs);
        op +|  (rhs: i128) -> i128  => __ssa(MachineOp::SAddSat, self, rhs);
        op -|  (rhs: i128) -> i128  => __ssa(MachineOp::SSubSat, self, rhs);
        op *|  (rhs: i128) -> i128  => __ssa(MachineOp::SMulSat, self, rhs);
        op +%  (rhs: i128) -> i128  => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: i128) -> i128  => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: i128) -> i128  => __ssa(MachineOp::MulWrap, self, rhs);
        op -   ()          -> i128  => __ssa_unary(MachineOp::Neg, self);
        op &   (rhs: i128) -> i128  => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: i128) -> i128  => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: i128) -> i128  => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()          -> i128  => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> i128  => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> i128  => __ssa(MachineOp::AShr,     self, bits);
        op ==  (rhs: i128) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: i128) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: i128) -> bool  => __ssa(MachineOp::SLt,      self, rhs);
        op <=  (rhs: i128) -> bool  => __ssa(MachineOp::SLe,      self, rhs);
        op >   (rhs: i128) -> bool  => __ssa(MachineOp::SGt,      self, rhs);
        op >=  (rhs: i128) -> bool  => __ssa(MachineOp::SGe,      self, rhs);
        op <=> (rhs: i128) -> order => __ssa(MachineOp::Cmp3S,   self, rhs);
        op ..< (rhs: i128) -> range<i128> => range<i128> { start: self, end: rhs };
        op ..  (rhs: i128) -> range<i128> => range<i128> { start: self, end: rhs };
        op ..= (rhs: i128) -> span<i128>  => span<i128>  { start: self, end: rhs };
        fn step_by(step: i128) -> step<i128> => step<i128> { bounds: range<i128> { start: self, end: self }, step_by: step };
        fn abs() -> i128 {
            if self < 0 { return -self; }
            return self;
        }
}
