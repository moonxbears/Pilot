// =========================================================================
// FILE: stdlib/core/primitives/u64.pilot
// 64-BIT UNSIGNED INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.U64;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(21, "64-bit unsigned integer (0..18446744073709551615).")]
[Lang(Cfg.Lang.u64_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)]
pub partial struct u64 : INumber<u64>, IBitwiseOperator<u64> {
    pub pure:
        op +   (rhs: u64) -> u64   => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: u64) -> u64   => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: u64) -> u64   => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: u64) -> u64   => __ssa(MachineOp::UDiv,     self, rhs);
        op %   (rhs: u64) -> u64   => __ssa(MachineOp::URem,     self, rhs);
        op %%  (rhs: u64) -> u64   => __ssa(MachineOp::URemEuc, self, rhs);
        op +|  (rhs: u64) -> u64   => __ssa(MachineOp::UAddSat, self, rhs);
        op -|  (rhs: u64) -> u64   => __ssa(MachineOp::USubSat, self, rhs);
        op *|  (rhs: u64) -> u64   => __ssa(MachineOp::UMulSat, self, rhs);
        op +%  (rhs: u64) -> u64   => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: u64) -> u64   => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: u64) -> u64   => __ssa(MachineOp::MulWrap, self, rhs);
        op &   (rhs: u64) -> u64   => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: u64) -> u64   => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: u64) -> u64   => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()         -> u64   => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> u64 => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> u64 => __ssa(MachineOp::LShr,     self, bits);
        op ==  (rhs: u64) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: u64) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: u64) -> bool  => __ssa(MachineOp::ULt,      self, rhs);
        op <=  (rhs: u64) -> bool  => __ssa(MachineOp::ULe,      self, rhs);
        op >   (rhs: u64) -> bool  => __ssa(MachineOp::UGt,      self, rhs);
        op >=  (rhs: u64) -> bool  => __ssa(MachineOp::UGe,      self, rhs);
        op <=> (rhs: u64) -> order => __ssa(MachineOp::Cmp3U,   self, rhs);
        op ..< (rhs: u64) -> range<u64> => range<u64> { start: self, end: rhs };
        op ..  (rhs: u64) -> range<u64> => range<u64> { start: self, end: rhs };
        op ..= (rhs: u64) -> span<u64>  => span<u64>  { start: self, end: rhs };
        fn step_by(step: u64) -> step<u64> => step<u64> { bounds: range<u64> { start: self, end: self }, step_by: step };
}
