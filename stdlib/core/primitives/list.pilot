// =========================================================================
// FILE: stdlib/core/primitives/list.pilot
// GROWABLE OWNED LIST (`List<T>`, 0b10 through IBuffer)
// =========================================================================
// The seed runs `List<T>` as its own engine list (see the `list_*` bindings
// in stdlib/core/builtins/native_calls.pilot): `List()` and `[a, b]` build
// one, and the bodiless methods below are answered by the engine. The
// members with bodies are written over those. The prelude links this file
// into every program.
// The layout over raw memory comes with `std.col` once the seed runs native
// code (F6).
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.List;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;

[Lang(Cfg.Lang.list_t)]
pub partial struct List<T: IAnyValue> : IBuffer<T>, IEnumerable<T, ListEnumerator<T>> {
    /// The number of items.
    pub fn len() -> usize;
    /// Appends `item` and returns the list.
    pub fn push(item: T) -> List<T>;
    /// Removes and returns the last item; an empty list stops the program.
    pub fn pop() -> T;
    /// Removes and returns the item at `index`; an index out of range stops
    /// the program.
    pub fn remove_at(index: usize) -> T;
    /// The item at `index`; an index out of range stops the program.
    pub op [] (index: usize) -> T;
    /// Replaces the item at `index`.
    pub op []= (index: usize, item: T);

    /// The number of items.
    pub count: usize { get => .len(); }

    /// Whether some item equals `item`.
    pub fn contains(item: T) -> bool {
        var i: usize = 0;
        while i < .len() {
            if self[i] == item { return true; }
            i = i + 1;
        }
        return false;
    }

    /// Appends `item`.
    pub fn add(item: T) { .push(item); }

    /// Removes every item.
    pub fn clear() {
        while .len() > 0 { .pop(); }
    }

    pub fn get_enumerator() -> ListEnumerator<T> => ListEnumerator<T> {
        items:       self,
        index:       0,
        has_started: false,
    };
}

// A list owns its elements: dropping a list drops each element, front to
// back (selfhost/check/drops.pilot), walked by the engine operations giving
// its length and its element at a position. Reading an element by index, or
// with `for`, borrows it.
comptime {
    __engine("bind_owned_elements", nameof(List), "str_len", "list_get");
}

/// Walks a `List<T>` front to back, borrowing it.
pub struct ListEnumerator<T: IAnyValue> : ICursor<T> {
    pub ref items:   List<T>;
    pub index:       usize;
    pub has_started: bool;

    pub var fn move_next() -> bool {
        if !self.has_started {
            .has_started = true;
            return .items.len() > 0;
        }
        if .index + 1 < .items.len() {
            .index = .index + 1;
            return true;
        }
        return false;
    }

    pub current: T { get => .items[.index]; }
}
