// =========================================================================
// FILE: stdlib/core/primitives/i8.pilot
// 8-BIT SIGNED TWO'S-COMPLEMENT INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.I8;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(20, "8-bit signed two's-complement integer (-128..127).")]
[Lang(Cfg.Lang.i8_t), Bits(Cfg.Reg.b8, Cfg.Reg.gpr_s)]
pub partial struct i8 : INumber<i8>, IBitwiseOperator<i8>, INegOperator<i8> {
    pub pure:
        op +   (rhs: i8) -> i8   => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: i8) -> i8   => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: i8) -> i8   => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: i8) -> i8   => __ssa(MachineOp::SDiv,     self, rhs);
        op %   (rhs: i8) -> i8   => __ssa(MachineOp::SRem,     self, rhs);
        op %%  (rhs: i8) -> i8   => __ssa(MachineOp::SRemEuc, self, rhs);
        op +|  (rhs: i8) -> i8   => __ssa(MachineOp::SAddSat, self, rhs);
        op -|  (rhs: i8) -> i8   => __ssa(MachineOp::SSubSat, self, rhs);
        op *|  (rhs: i8) -> i8   => __ssa(MachineOp::SMulSat, self, rhs);
        op +%  (rhs: i8) -> i8   => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: i8) -> i8   => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: i8) -> i8   => __ssa(MachineOp::MulWrap, self, rhs);
        op -   ()        -> i8   => __ssa_unary(MachineOp::Neg, self);
        op &   (rhs: i8) -> i8   => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: i8) -> i8   => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: i8) -> i8   => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()        -> i8   => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> i8 => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> i8 => __ssa(MachineOp::AShr,     self, bits);
        op ==  (rhs: i8) -> bool => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: i8) -> bool => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: i8) -> bool => __ssa(MachineOp::SLt,      self, rhs);
        op <=  (rhs: i8) -> bool => __ssa(MachineOp::SLe,      self, rhs);
        op >   (rhs: i8) -> bool => __ssa(MachineOp::SGt,      self, rhs);
        op >=  (rhs: i8) -> bool => __ssa(MachineOp::SGe,      self, rhs);
        op <=> (rhs: i8) -> order => __ssa(MachineOp::Cmp3S,  self, rhs);
        op ..< (rhs: i8) -> range<i8> => range<i8> { start: self, end: rhs };
        op ..  (rhs: i8) -> range<i8> => range<i8> { start: self, end: rhs };
        op ..= (rhs: i8) -> span<i8>  => span<i8>  { start: self, end: rhs };
        fn step_by(step: i8) -> step<i8> => step<i8> { bounds: range<i8> { start: self, end: self }, step_by: step };
        fn abs() -> i8 {
            if self < 0 { return -self; }
            return self;
        }
}
