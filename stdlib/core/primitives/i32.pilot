// =========================================================================
// FILE: stdlib/core/primitives/i32.pilot
// 32-BIT SIGNED TWO'S-COMPLEMENT INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.I32;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(20, "32-bit signed two's-complement integer (-2147483648..2147483647).")]
[Lang(Cfg.Lang.i32_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_s)]
pub partial struct i32 : INumber<i32>, IBitwiseOperator<i32>, INegOperator<i32> {
    pub pure:
        op +   (rhs: i32) -> i32   => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: i32) -> i32   => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: i32) -> i32   => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: i32) -> i32   => __ssa(MachineOp::SDiv,     self, rhs);
        op %   (rhs: i32) -> i32   => __ssa(MachineOp::SRem,     self, rhs);
        op %%  (rhs: i32) -> i32   => __ssa(MachineOp::SRemEuc, self, rhs);
        op +|  (rhs: i32) -> i32   => __ssa(MachineOp::SAddSat, self, rhs);
        op -|  (rhs: i32) -> i32   => __ssa(MachineOp::SSubSat, self, rhs);
        op *|  (rhs: i32) -> i32   => __ssa(MachineOp::SMulSat, self, rhs);
        op +%  (rhs: i32) -> i32   => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: i32) -> i32   => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: i32) -> i32   => __ssa(MachineOp::MulWrap, self, rhs);
        op -   ()         -> i32   => __ssa_unary(MachineOp::Neg, self);
        op &   (rhs: i32) -> i32   => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: i32) -> i32   => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: i32) -> i32   => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()         -> i32   => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> i32 => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> i32 => __ssa(MachineOp::AShr,     self, bits);
        op ==  (rhs: i32) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: i32) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: i32) -> bool  => __ssa(MachineOp::SLt,      self, rhs);
        op <=  (rhs: i32) -> bool  => __ssa(MachineOp::SLe,      self, rhs);
        op >   (rhs: i32) -> bool  => __ssa(MachineOp::SGt,      self, rhs);
        op >=  (rhs: i32) -> bool  => __ssa(MachineOp::SGe,      self, rhs);
        op <=> (rhs: i32) -> order => __ssa(MachineOp::Cmp3S,   self, rhs);
        op ..< (rhs: i32) -> range<i32> => range<i32> { start: self, end: rhs };
        op ..  (rhs: i32) -> range<i32> => range<i32> { start: self, end: rhs };
        op ..= (rhs: i32) -> span<i32>  => span<i32>  { start: self, end: rhs };
        fn step_by(step: i32) -> step<i32> => step<i32> { bounds: range<i32> { start: self, end: self }, step_by: step };
        fn abs() -> i32 {
            if self < 0 { return -self; }
            return self;
        }
}
