// =========================================================================
// FILE: stdlib/core/primitives/i32.pilot
// 32-BIT SIGNED TWO'S-COMPLEMENT INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.I32;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(20, "32-bit signed two's-complement integer (-2147483648..2147483647).")]
[Lang(Cfg.Lang.i32_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_s)]
pub partial struct i32 : INumber<i32>, IBitwiseOperator<i32>, INegOperator<i32> {
    pub pure:
        op +   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.add,      self, rhs);
        op -   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.sub,      self, rhs);
        op *   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.mul,      self, rhs);
        op /   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.sdiv,     self, rhs);
        op %   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.srem,     self, rhs);
        op %%  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.srem_euc, self, rhs);
        op +|  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.sadd_sat, self, rhs);
        op -|  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.ssub_sat, self, rhs);
        op *|  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.smul_sat, self, rhs);
        op +%  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.add_wrap, self, rhs);
        op -%  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.sub_wrap, self, rhs);
        op *%  (rhs: i32) -> i32   => __ssa(Cfg.Ssa.mul_wrap, self, rhs);
        op -   ()         -> i32   => __ssa_unary(Cfg.Ssa.neg, self);
        op &   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.and_b,    self, rhs);
        op |   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.or_b,     self, rhs);
        op ^   (rhs: i32) -> i32   => __ssa(Cfg.Ssa.xor_b,    self, rhs);
        op ~   ()         -> i32   => __ssa_unary(Cfg.Ssa.bitnot, self);
        op <<  (bits: u32) -> i32 => __ssa(Cfg.Ssa.shl,      self, bits);
        op >>  (bits: u32) -> i32 => __ssa(Cfg.Ssa.ashr,     self, bits);
        op ==  (rhs: i32) -> bool  => __ssa(Cfg.Ssa.eq,       self, rhs);
        op !=  (rhs: i32) -> bool  => __ssa(Cfg.Ssa.ne,       self, rhs);
        op <   (rhs: i32) -> bool  => __ssa(Cfg.Ssa.slt,      self, rhs);
        op <=  (rhs: i32) -> bool  => __ssa(Cfg.Ssa.sle,      self, rhs);
        op >   (rhs: i32) -> bool  => __ssa(Cfg.Ssa.sgt,      self, rhs);
        op >=  (rhs: i32) -> bool  => __ssa(Cfg.Ssa.sge,      self, rhs);
        op <=> (rhs: i32) -> order => __ssa(Cfg.Ssa.cmp3_s,   self, rhs);
        op ..< (rhs: i32) -> range<i32> => range<i32> { start: self, end: rhs };
        op ..  (rhs: i32) -> range<i32> => range<i32> { start: self, end: rhs };
        op ..= (rhs: i32) -> span<i32>  => span<i32>  { start: self, end: rhs };
        fn step_by(step: i32) -> step<i32> => step<i32> { bounds: range<i32> { start: self, end: self }, step_by: step };
        fn abs() -> i32 {
            if self < 0 { return -self; }
            return self;
        }
}
