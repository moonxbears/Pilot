// =========================================================================
// FILE: stdlib/core/primitives/u32.pilot
// 32-BIT UNSIGNED INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.U32;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(21, "32-bit unsigned integer (0..4294967295).")]
[Lang(Cfg.Lang.u32_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_u)]
pub partial struct u32 : INumber<u32>, IBitwiseOperator<u32> {
    pub pure:
        op +   (rhs: u32) -> u32   => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: u32) -> u32   => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: u32) -> u32   => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: u32) -> u32   => __ssa(MachineOp::UDiv,     self, rhs);
        op %   (rhs: u32) -> u32   => __ssa(MachineOp::URem,     self, rhs);
        op %%  (rhs: u32) -> u32   => __ssa(MachineOp::URemEuc, self, rhs);
        op +|  (rhs: u32) -> u32   => __ssa(MachineOp::UAddSat, self, rhs);
        op -|  (rhs: u32) -> u32   => __ssa(MachineOp::USubSat, self, rhs);
        op *|  (rhs: u32) -> u32   => __ssa(MachineOp::UMulSat, self, rhs);
        op +%  (rhs: u32) -> u32   => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: u32) -> u32   => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: u32) -> u32   => __ssa(MachineOp::MulWrap, self, rhs);
        op &   (rhs: u32) -> u32   => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: u32) -> u32   => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: u32) -> u32   => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()         -> u32   => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> u32 => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> u32 => __ssa(MachineOp::LShr,     self, bits);
        op ==  (rhs: u32) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: u32) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: u32) -> bool  => __ssa(MachineOp::ULt,      self, rhs);
        op <=  (rhs: u32) -> bool  => __ssa(MachineOp::ULe,      self, rhs);
        op >   (rhs: u32) -> bool  => __ssa(MachineOp::UGt,      self, rhs);
        op >=  (rhs: u32) -> bool  => __ssa(MachineOp::UGe,      self, rhs);
        op <=> (rhs: u32) -> order => __ssa(MachineOp::Cmp3U,   self, rhs);
        op ..< (rhs: u32) -> range<u32> => range<u32> { start: self, end: rhs };
        op ..  (rhs: u32) -> range<u32> => range<u32> { start: self, end: rhs };
        op ..= (rhs: u32) -> span<u32>  => span<u32>  { start: self, end: rhs };
        fn step_by(step: u32) -> step<u32> => step<u32> { bounds: range<u32> { start: self, end: self }, step_by: step };
}
