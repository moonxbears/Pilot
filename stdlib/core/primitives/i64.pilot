// =========================================================================
// FILE: stdlib/core/primitives/i64.pilot
// 64-BIT SIGNED TWO'S-COMPLEMENT INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.I64;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(20, "64-bit signed two's-complement integer (-9223372036854775808..9223372036854775807).")]
[Lang(Cfg.Lang.i64_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_s)]
pub partial struct i64 : INumber<i64>, IBitwiseOperator<i64>, INegOperator<i64> {
    pub pure:
        op +   (rhs: i64) -> i64   => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: i64) -> i64   => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: i64) -> i64   => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: i64) -> i64   => __ssa(MachineOp::SDiv,     self, rhs);
        op %   (rhs: i64) -> i64   => __ssa(MachineOp::SRem,     self, rhs);
        op %%  (rhs: i64) -> i64   => __ssa(MachineOp::SRemEuc, self, rhs);
        op +|  (rhs: i64) -> i64   => __ssa(MachineOp::SAddSat, self, rhs);
        op -|  (rhs: i64) -> i64   => __ssa(MachineOp::SSubSat, self, rhs);
        op *|  (rhs: i64) -> i64   => __ssa(MachineOp::SMulSat, self, rhs);
        op +%  (rhs: i64) -> i64   => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: i64) -> i64   => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: i64) -> i64   => __ssa(MachineOp::MulWrap, self, rhs);
        op -   ()         -> i64   => __ssa_unary(MachineOp::Neg, self);
        op &   (rhs: i64) -> i64   => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: i64) -> i64   => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: i64) -> i64   => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()         -> i64   => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> i64 => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> i64 => __ssa(MachineOp::AShr,     self, bits);
        op ==  (rhs: i64) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: i64) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: i64) -> bool  => __ssa(MachineOp::SLt,      self, rhs);
        op <=  (rhs: i64) -> bool  => __ssa(MachineOp::SLe,      self, rhs);
        op >   (rhs: i64) -> bool  => __ssa(MachineOp::SGt,      self, rhs);
        op >=  (rhs: i64) -> bool  => __ssa(MachineOp::SGe,      self, rhs);
        op <=> (rhs: i64) -> order => __ssa(MachineOp::Cmp3S,   self, rhs);
        op ..< (rhs: i64) -> range<i64> => range<i64> { start: self, end: rhs };
        op ..  (rhs: i64) -> range<i64> => range<i64> { start: self, end: rhs };
        op ..= (rhs: i64) -> span<i64>  => span<i64>  { start: self, end: rhs };
        fn step_by(step: i64) -> step<i64> => step<i64> { bounds: range<i64> { start: self, end: self }, step_by: step };
        fn abs() -> i64 {
            if self < 0 { return -self; }
            return self;
        }
}
