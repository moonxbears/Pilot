// =========================================================================
// FILE: stdlib/core/primitives/char.pilot
// 32-BIT UNICODE SCALAR VALUE HARDWARE PRIMITIVE
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.Char;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(23, "32-bit Unicode scalar character value (`0x0000`..`0x10FFFF`).")]
[Lang(Cfg.Lang.char_t), Bits(Cfg.Reg.b32, Cfg.Reg.gpr_u)]
pub partial struct char : IComparable<char>, IValue {
    pub pure:
        fn to_u32()         -> u32  => __ssa_cast(Cfg.Ssa.bitcast, self, u32);
        op == (rhs: char)   -> bool => .to_u32() == rhs.to_u32();
        op != (rhs: char)   -> bool => .to_u32() != rhs.to_u32();
        op <  (rhs: char)   -> bool => .to_u32() <  rhs.to_u32();
        op <= (rhs: char)   -> bool => .to_u32() <= rhs.to_u32();
        op >  (rhs: char)   -> bool => .to_u32() >  rhs.to_u32();
        op >= (rhs: char)   -> bool => .to_u32() >= rhs.to_u32();
        fn is_ascii()       -> bool => .to_u32() <= 0x7F;
        fn is_ascii_digit() -> bool => (.to_u32() >= 0x30) && (.to_u32() <= 0x39);
        fn is_ascii_alpha() -> bool =>
            ((.to_u32() >= 0x41) && (.to_u32() <= 0x5A)) ||
            ((.to_u32() >= 0x61) && (.to_u32() <= 0x7A));
}
