// =========================================================================
// FILE: stdlib/core/primitives/str.pilot
// BORROWED UTF-8 STRING VIEW (16-BYTE `{ ptr<u8>, usize }`, 0b01 IReference)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.Str;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(25, "Borrowed UTF-8 string view backed by contiguous byte pointer and length (16 bytes).")]
[Lang(Cfg.Lang.str_t), Layout(c_abi)]
// Text is not a collection of bytes: `contains` searches for text, not for
// one byte, so `str` takes no collection role. It is a borrowed (0b01) view
// whose bytes can be read by position and enumerated.
pub partial struct str : IEquatable<str>, IIndexGet<i64, u8>, IEnumerable<u8, SliceEnumerator<u8>>, IReference {
    *RawStorageBundle<u8>;
    *ContiguousViewFacet<u8>;

    pub pure:
        fn as_bytes() -> slice<u8> => slice<u8> { data: .data, len: .len };

        op _[_] (idx: i64) -> u8 => .data[idx as usize];

        op _[_] (r: range<usize>) -> str => str {
            data: .data + r.start,
            len:  r.end - r.start,
        };

        // Positions are `i64` (PROP-005 D2 (a)): what `len()` and position
        // arithmetic give, so callers never cast. They are clamped to the
        // text: below 0 reads as 0, past the end as the length.

        /// The byte at `idx`, or 0 when `idx` is outside the text.
        fn byte_at(idx: i64) -> u8 {
            if idx < 0 || idx >= .len as i64 { return 0; }
            return .data[idx as usize];
        }

        /// The bytes from `start` up to `end`, both clamped to the text;
        /// empty when `start` is not before `end`.
        fn slice(start: i64, end: i64) -> str {
            let n = .len as i64;
            let s = if start < 0 { 0 } else if start > n { n } else { start };
            let e = if end < 0 { 0 } else if end > n { n } else { end };
            if s >= e { return str { data: .data, len: 0 }; }
            return str {
                data: .data + (s as usize),
                len:  (e - s) as usize,
            };
        }

        fn is_empty() -> bool => .len == 0;

        fn starts_with(prefix: str) -> bool {
            if prefix.len > .len { return false; }
            var i: usize = 0;
            loop {
                if !(i < prefix.len) { break; }
                if .data[i] != prefix.data[i] { return false; }
                i = i + 1;
            }
            return true;
        }

        fn ends_with(suffix: str) -> bool {
            if suffix.len > .len { return false; }
            let offset = .len - suffix.len;
            var i: usize = 0;
            loop {
                if !(i < suffix.len) { break; }
                if .data[offset + i] != suffix.data[i] { return false; }
                i = i + 1;
            }
            return true;
        }

        /// Where `needle` first starts, or -1 when it does not occur.
        fn index_of(needle: str) -> i64 {
            if needle.len == 0 { return 0; }
            if needle.len > .len { return -1; }
            let max_start = .len - needle.len;
            var i: usize = 0;
            loop {
                if i > max_start { break; }
                var match_found = true;
                var j: usize = 0;
                loop {
                    if !(j < needle.len) { break; }
                    if .data[i + j] != needle.data[j] {
                        match_found = false;
                        break;
                    }
                    j = j + 1;
                }
                if match_found { return i as i64; }
                i = i + 1;
            }
            return -1;
        }

        fn contains(needle: str) -> bool => .index_of(needle) >= 0;

        op == (rhs: str) -> bool {
            if .len != rhs.len { return false; }
            var idx: usize = 0;
            loop {
                if !(idx < .len) { break; }
                if .data[idx] != rhs.data[idx] { return false; }
                idx = idx + 1;
            }
            return true;
        }

        fn get_enumerator() -> SliceEnumerator<u8> => .as_bytes().get_enumerator();
}
