// =========================================================================
// FILE: stdlib/core/primitives/f128.pilot
// 128-BIT IEEE 754 QUADRUPLE-PRECISION FLOATING-POINT HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.F128;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(22, "128-bit IEEE 754 quadruple-precision floating-point number.")]
[Lang(Cfg.Lang.f128_t), Bits(Cfg.Reg.b128, Cfg.Reg.simd_f)]
[StandIn("prim.wide_scalar_64", "a float of this type's own format", "held as an f64: results are not rounded to the type's precision or range", "F6")]
pub partial struct f128 : INumber<f128>, INegOperator<f128> {
    pub pure:
        op +  (rhs: f128) -> f128 => __ssa(Cfg.Ssa.fadd, self, rhs);
        op -  (rhs: f128) -> f128 => __ssa(Cfg.Ssa.fsub, self, rhs);
        op *  (rhs: f128) -> f128 => __ssa(Cfg.Ssa.fmul, self, rhs);
        op /  (rhs: f128) -> f128 => __ssa(Cfg.Ssa.fdiv, self, rhs);
        op -  ()          -> f128 => __ssa_unary(Cfg.Ssa.fneg, self);
        op == (rhs: f128) -> bool => __ssa(Cfg.Ssa.feq,  self, rhs);
        op != (rhs: f128) -> bool => !(__ssa(Cfg.Ssa.feq, self, rhs));
        op <  (rhs: f128) -> bool => __ssa(Cfg.Ssa.flt,  self, rhs);
        op <= (rhs: f128) -> bool => __ssa(Cfg.Ssa.fle,  self, rhs);
        op >  (rhs: f128) -> bool => !(__ssa(Cfg.Ssa.fle, self, rhs));
        op >= (rhs: f128) -> bool => !(__ssa(Cfg.Ssa.flt, self, rhs));
}
