// =========================================================================
// FILE: stdlib/core/primitives/usize.pilot
// POINTER-WIDTH UNSIGNED INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.USize;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(21, "Pointer-width unsigned integer representing memory offsets and buffer lengths.")]
[Lang(Cfg.Lang.usize_t), Bits(Cfg.Reg.b64, Cfg.Reg.gpr_u)]
pub partial struct usize : INumber<usize>, IBitwiseOperator<usize> {
    pub pure:
        op +   (rhs: usize) -> usize => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: usize) -> usize => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: usize) -> usize => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: usize) -> usize => __ssa(MachineOp::UDiv,     self, rhs);
        op %   (rhs: usize) -> usize => __ssa(MachineOp::URem,     self, rhs);
        op %%  (rhs: usize) -> usize => __ssa(MachineOp::URemEuc, self, rhs);
        op +|  (rhs: usize) -> usize => __ssa(MachineOp::UAddSat, self, rhs);
        op -|  (rhs: usize) -> usize => __ssa(MachineOp::USubSat, self, rhs);
        op *|  (rhs: usize) -> usize => __ssa(MachineOp::UMulSat, self, rhs);
        op +%  (rhs: usize) -> usize => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: usize) -> usize => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: usize) -> usize => __ssa(MachineOp::MulWrap, self, rhs);
        op &   (rhs: usize) -> usize => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: usize) -> usize => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: usize) -> usize => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()           -> usize => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32)  -> usize => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32)  -> usize => __ssa(MachineOp::LShr,     self, bits);
        op ==  (rhs: usize) -> bool  => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: usize) -> bool  => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: usize) -> bool  => __ssa(MachineOp::ULt,      self, rhs);
        op <=  (rhs: usize) -> bool  => __ssa(MachineOp::ULe,      self, rhs);
        op >   (rhs: usize) -> bool  => __ssa(MachineOp::UGt,      self, rhs);
        op >=  (rhs: usize) -> bool  => __ssa(MachineOp::UGe,      self, rhs);
        op <=> (rhs: usize) -> order => __ssa(MachineOp::Cmp3U,   self, rhs);
        op ..< (rhs: usize) -> range<usize> => range<usize> { start: self, end: rhs };
        op ..  (rhs: usize) -> range<usize> => range<usize> { start: self, end: rhs };
        op ..= (rhs: usize) -> span<usize>  => span<usize>  { start: self, end: rhs };
        fn step_by(step: usize) -> step<usize> => step<usize> { bounds: range<usize> { start: self, end: self }, step_by: step };
}
