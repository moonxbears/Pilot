// =========================================================================
// FILE: stdlib/core/primitives/slice.pilot
// BORROWED CONTIGUOUS SLICE VIEW (`slice<T>`, 16-BYTE `{ ptr<T>, usize }`, 0b01 IReference)
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.Slice;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(26, "Borrowed contiguous memory slice view backed by pointer and length (16 bytes).")]
[Lang(Cfg.Lang.slice_t), Layout(c_abi)]
pub partial struct slice<T: IAnyValue> : IReadOnlyList<T>, IReference {
    *RawStorageBundle<T>;
    *ContiguousViewFacet<T>;

    pub pure:
        op [] (idx: usize) -> T => .data[idx];

        op [] (r: range<usize>) -> slice<T> => slice<T> {
            data: .data + r.start,
            len:  r.end - r.start,
        };

        op [] (s: span<usize>) -> slice<T> => slice<T> {
            data: .data + s.start,
            len:  (s.end - s.start) + 1,
        };

        fn subslice(start: usize, sub_len: usize) -> slice<T> => slice<T> {
            data: .data + start,
            len:  sub_len,
        };

        fn get_enumerator() -> SliceEnumerator<T> => SliceEnumerator<T> {
            data:        .data,
            len:         .len,
            index:       0,
            has_started: false,
        };

        fn lens_column<TField: IAnyValue>(comptime field_sym: str) -> stride<TField> {
            comptime {
                if lattice_bits_of(T) != Cfg.Lattice.value {
                    compile_error("OffsetLens '~>' requires a 0b00 IValue element struct");
                }
            }
            let base_addr = (__ssa_cast(Cfg.Ssa.bitcast, .data, usize)) + offsetof(T, field_sym);
            return stride<TField> {
                data:      __ssa_cast(Cfg.Ssa.bitcast, base_addr, ptr<TField>),
                len:       .len,
                byte_step: sizeof(T) as isize,
            };
        }

        fn lens_map<TKey: IEquatable<TKey>, TVal: IAnyValue>(
            comptime key_sym: str,
            comptime val_sym: str
        ) -> map<TKey, TVal> => map<TKey, TVal> {
            keys: .lens_column<TKey>(key_sym),
            vals: .lens_column<TVal>(val_sym),
        };

        fn as_structural_view<TDst: IValue>() -> stride<TDst> {
            comptime {
                if (lattice_bits_of(T) != Cfg.Lattice.value) || (lattice_bits_of(TDst) != Cfg.Lattice.value) {
                    compile_error("'as view' requires both source and target structs to be 0b00 IValue");
                }
                if sizeof(TDst) > sizeof(T) {
                    compile_error("'as view' target struct cannot be larger than source struct");
                }
            }
            return stride<TDst> {
                data:      __ssa_cast(Cfg.Ssa.bitcast, .data, ptr<TDst>),
                len:       .len,
                byte_step: sizeof(T) as isize,
            };
        }
}
