// =========================================================================
// FILE: stdlib/core/primitives/u8.pilot
// 8-BIT UNSIGNED INTEGER HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.U8;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(21, "8-bit unsigned integer (0..255).")]
[Lang(Cfg.Lang.u8_t), Bits(Cfg.Reg.b8, Cfg.Reg.gpr_u)]
pub partial struct u8 : INumber<u8>, IBitwiseOperator<u8> {
    pub pure:
        op +   (rhs: u8) -> u8   => __ssa(MachineOp::Add,      self, rhs);
        op -   (rhs: u8) -> u8   => __ssa(MachineOp::Sub,      self, rhs);
        op *   (rhs: u8) -> u8   => __ssa(MachineOp::Mul,      self, rhs);
        op /   (rhs: u8) -> u8   => __ssa(MachineOp::UDiv,     self, rhs);
        op %   (rhs: u8) -> u8   => __ssa(MachineOp::URem,     self, rhs);
        op %%  (rhs: u8) -> u8   => __ssa(MachineOp::URemEuc, self, rhs);
        op +|  (rhs: u8) -> u8   => __ssa(MachineOp::UAddSat, self, rhs);
        op -|  (rhs: u8) -> u8   => __ssa(MachineOp::USubSat, self, rhs);
        op *|  (rhs: u8) -> u8   => __ssa(MachineOp::UMulSat, self, rhs);
        op +%  (rhs: u8) -> u8   => __ssa(MachineOp::AddWrap, self, rhs);
        op -%  (rhs: u8) -> u8   => __ssa(MachineOp::SubWrap, self, rhs);
        op *%  (rhs: u8) -> u8   => __ssa(MachineOp::MulWrap, self, rhs);
        op &   (rhs: u8) -> u8   => __ssa(MachineOp::And,    self, rhs);
        op |   (rhs: u8) -> u8   => __ssa(MachineOp::Or,     self, rhs);
        op ^   (rhs: u8) -> u8   => __ssa(MachineOp::Xor,    self, rhs);
        op ~   ()        -> u8   => __ssa_unary(MachineOp::BitNot, self);
        op <<  (bits: u32) -> u8 => __ssa(MachineOp::Shl,      self, bits);
        op >>  (bits: u32) -> u8 => __ssa(MachineOp::LShr,     self, bits);
        op ==  (rhs: u8) -> bool => __ssa(MachineOp::Eq,       self, rhs);
        op !=  (rhs: u8) -> bool => __ssa(MachineOp::Ne,       self, rhs);
        op <   (rhs: u8) -> bool => __ssa(MachineOp::ULt,      self, rhs);
        op <=  (rhs: u8) -> bool => __ssa(MachineOp::ULe,      self, rhs);
        op >   (rhs: u8) -> bool => __ssa(MachineOp::UGt,      self, rhs);
        op >=  (rhs: u8) -> bool => __ssa(MachineOp::UGe,      self, rhs);
        op <=> (rhs: u8) -> order => __ssa(MachineOp::Cmp3U,  self, rhs);
        op ..< (rhs: u8) -> range<u8> => range<u8> { start: self, end: rhs };
        op ..  (rhs: u8) -> range<u8> => range<u8> { start: self, end: rhs };
        op ..= (rhs: u8) -> span<u8>  => span<u8>  { start: self, end: rhs };
        fn step_by(step: u8) -> step<u8> => step<u8> { bounds: range<u8> { start: self, end: self }, step_by: step };
}
