// =========================================================================
// FILE: stdlib/core/primitives/f32.pilot
// 32-BIT IEEE 754 SINGLE-PRECISION FLOATING-POINT HARDWARE SCALAR
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Primitives.F32;

use Pilot.Core.Genesis::*;
use Pilot.Core.Interfaces::*;
use Pilot.Core.Keywords::*;

[KeywordDefAttr(22, "32-bit IEEE 754 single-precision floating-point number.")]
[Lang(Cfg.Lang.f32_t), Bits(Cfg.Reg.b32, Cfg.Reg.simd_f)]
pub partial struct f32 : INumber<f32>, INegOperator<f32> {
    pub pure:
        op +  (rhs: f32) -> f32  => __ssa(Cfg.Ssa.fadd, self, rhs);
        op -  (rhs: f32) -> f32  => __ssa(Cfg.Ssa.fsub, self, rhs);
        op *  (rhs: f32) -> f32  => __ssa(Cfg.Ssa.fmul, self, rhs);
        op /  (rhs: f32) -> f32  => __ssa(Cfg.Ssa.fdiv, self, rhs);
        op -  ()         -> f32  => __ssa_unary(Cfg.Ssa.fneg, self);
        op == (rhs: f32) -> bool => __ssa(Cfg.Ssa.feq,  self, rhs);
        op != (rhs: f32) -> bool => !(__ssa(Cfg.Ssa.feq, self, rhs));
        op <  (rhs: f32) -> bool => __ssa(Cfg.Ssa.flt,  self, rhs);
        op <= (rhs: f32) -> bool => __ssa(Cfg.Ssa.fle,  self, rhs);
        op >  (rhs: f32) -> bool => !(__ssa(Cfg.Ssa.fle, self, rhs));
        op >= (rhs: f32) -> bool => !(__ssa(Cfg.Ssa.flt, self, rhs));
}
