// =========================================================================
// FILE: stdlib/core/lex/literal_value.pilot
// WHAT A NUMBER LITERAL IS WORTH (PROP-021 slices 21D and 21F)
// =========================================================================
// The lexer decides a literal's shape (numbers.pilot); this file decides
// its value, from the same declared data: the radix prefixes (`RADIXES`),
// the digit values (`DIGIT_RANGES`) and the separator (`DIGIT_SEPARATOR`).
// The value is kept as a magnitude of any size, so whether it fits is
// decided by the type it lands in (its [Bits] width), never by this file
// (PROP-021 §2.9). The checker uses it for LIT002 (selfhost/check/
// literals.pilot).
//
// A magnitude is a little-endian list of 16-bit limbs with no high zero
// limb (0 is the empty list).
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.LiteralValue;

use Pilot.Core.Lex.Numbers;
use Pilot.Core.Lex.Patterns;
use Pilot.Core.Lex.Strings;
use Pilot.Core.Convert.Limbs;
use Pilot.Core.Convert.DecimalRound;

/// An integer literal's value: its magnitude, at any size.
pub struct IntLiteral : IObject {
    pub limbs: List<i64>;

    /// The bits needed to write the magnitude (0 for 0).
    pub fn bit_length(ref self) -> i64 => limbs_bit_length(self.limbs);

    /// Whether the magnitude is a power of two (one bit set).
    pub fn is_power_of_two(ref self) -> bool {
        let n = self.limbs.len() as i64;
        if n == 0 { return false; }
        var i = 0;
        while i < n - 1 {
            if self.limbs[i] != 0 { return false; }
            i = i + 1;
        }
        let top = self.limbs[n - 1];
        return (top & (top - 1)) == 0;
    }

    /// The low 64 bits of the magnitude, as an i64 (two's complement: 2^64 - 1
    /// is -1).
    pub fn low64(ref self) -> i64 => limbs_low64(self.limbs);

    /// Whether the value (the magnitude, made negative when `negated`) fits
    /// a `bits`-bit integer, `signed` or not: unsigned holds 0 ..= 2^bits - 1,
    /// signed -2^(bits-1) ..= 2^(bits-1) - 1.
    pub fn fits(ref self, bits: i64, signed: bool, negated: bool) -> bool {
        let len = self.bit_length();
        if !signed {
            return if negated { len == 0 } else { len <= bits };
        }
        if len <= bits - 1 { return true; }
        return negated && len == bits && self.is_power_of_two();
    }
}

/// The value of integer token `text` (one integer as the number patterns
/// declare it, no suffix), or `none` when it is not one: a byte that is
/// neither a digit of its radix nor the separator, or no digit at all.
pub fn int_from_text(text: str) -> IntLiteral? {
    var info = RADIXES[0];
    // No prefix starts another, so the first match is the only one.
    for r in RADIXES {
        if r.prefix != "" && text.starts_with(r.prefix) {
            info = r;
            break;
        }
    }
    let sep = DIGIT_SEPARATOR.byte_at(0) as i64;
    var limbs: List<i64> = [];
    var digits = 0;
    var i = info.prefix.len() as i64;
    while i < text.len() as i64 {
        let b = text.byte_at(i) as i64;
        if b != sep {
            let d = digit_value(b);
            if d < 0 || d >= info.base { return none; }
            limbs_mul_add(limbs, info.base, d);
            digits = digits + 1;
        }
        i = i + 1;
    }
    if digits == 0 { return none; }
    return IntLiteral { limbs: limbs };
}

/// The values a `bits`-bit integer holds, as `least ..= greatest`.
pub fn range_text(bits: i64, signed: bool) -> str {
    if !signed {
        var top = limbs_power_of_two(bits);
        limbs_sub_one(top);
        return "0 ..= " + limbs_decimal(top);
    }
    let least = limbs_power_of_two(bits - 1);
    var top = limbs_power_of_two(bits - 1);
    limbs_sub_one(top);
    return "-" + limbs_decimal(least) + " ..= " + limbs_decimal(top);
}

/// The value of float token `text` (one float as the number patterns
/// declare it, no suffix): every digit kept, exactly, for
/// `DecimalDigits.encoding(fmt)` to round to a format (correctly, in
/// stdlib/core/convert/decimal_round.pilot). None when it is not one.
pub fn float_from_text(text: str) -> DecimalDigits? {
    let point = text.find(DECIMAL_POINT, 0) >= 0;
    // A point already makes it a float; the marks are looked for only
    // without one, and only until one is found.
    var mark = false;
    if !point {
        for i in 0 .. EXPONENT_MARKS.len() {
            if text.find(EXPONENT_MARKS.slice(i, i + 1), 0) >= 0 {
                mark = true;
                break;
            }
        }
    }
    if !point && !mark { return none; }
    return read_decimal_digits(text, 0, DIGIT_SEPARATOR.byte_at(0) as i64, false);
}

// ---- Strings ----

/// An escape a string may hold: the byte after the `\`, and the byte it
/// stands for.
pub struct EscapeInfo : IValue {
    pub after: i64;
    pub value: i64;
}

/// The escapes, the seed's set: n (newline 10), t (tab 9), r (return 13),
/// and the backslash and both quotes standing for themselves. Any other is
/// LIT003 (owner decision 2026-11-16: reject, as Rust, Go and C# do).
pub const ESCAPES: List<EscapeInfo> = [
    EscapeInfo { after: byte_of("n"), value: NEWLINE },
    EscapeInfo { after: byte_of("t"), value: 9 },
    EscapeInfo { after: byte_of("r"), value: 13 },
    EscapeInfo { after: BACKSLASH, value: BACKSLASH },
    EscapeInfo { after: DOUBLE_QUOTE, value: DOUBLE_QUOTE },
    EscapeInfo { after: SINGLE_QUOTE, value: SINGLE_QUOTE },
];

/// An escape no `ESCAPES` entry declares: its byte offset in the token
/// text, and its text (the backslash and the character after it).
pub struct BadEscape : IValue {
    pub at: i64;
    pub text: str;
}

/// Where a string token's body lies (after its prefix letters and opening
/// quotes, before its closing ones), and what its prefix makes it.
struct StringShape : IValue {
    pub start: i64;
    pub end: i64;
    pub raw: bool;
    pub fstring: bool;
}

fn has_byte(set: str, b: i64) -> bool {
    var i = 0;
    while i < set.len() as i64 {
        if set.byte_at(i) as i64 == b { return true; }
        i = i + 1;
    }
    return false;
}

/// The shape of string token `text`, or none when it is not one.
fn string_shape(text: str) -> StringShape? {
    let n = text.len() as i64;
    var i = 0;
    var raw = false;
    var fstring = false;
    while i < n && text.byte_at(i) as i64 != DOUBLE_QUOTE && text.byte_at(i) as i64 != SINGLE_QUOTE {
        let b = text.byte_at(i) as i64;
        if has_byte(RAW_MARKS, b) { raw = true; }
        else if has_byte(FSTRING_MARKS, b) { fstring = true; }
        else if !has_byte(BYTE_MARKS, b) { return none; }
        i = i + 1;
    }
    if i >= n { return none; }
    let q = text.byte_at(i);
    let three = n - i >= 6 && text.byte_at(i + 1) == q && text.byte_at(i + 2) == q;
    let quotes = if three { 3 } else { 1 };
    if n - i < 2 * quotes { return none; }
    return StringShape { start: i + quotes, end: n - quotes, raw: raw, fstring: fstring };
}

/// The bytes of the UTF-8 character starting at `at`.
fn char_length(text: str, at: i64) -> i64 {
    if at >= text.len() as i64 { return 0; }
    let b = text.byte_at(at) as i64;
    if b >= 240 { return 4; }
    if b >= 224 { return 3; }
    if b >= 192 { return 2; }
    return 1;
}

/// What the escape at `at` (a backslash before `end`) stands for, or none.
fn escape_value(text: str, at: i64, end: i64) -> i64? {
    if at + 1 >= end { return none; }
    let after = text.byte_at(at + 1) as i64;
    for e in ESCAPES {
        if e.after == after { return e.value; }
    }
    return none;
}

fn bad_escape(text: str, at: i64) -> BadEscape =>
    BadEscape { at: at, text: text.slice(at, at + 1 + char_length(text, at + 1)) };

/// The value of string token `text` (plain, raw, byte or triple-quoted;
/// not an f-string, which has no single value): its body with each escape
/// replaced by the byte `ESCAPES` gives, or the first unknown escape. A raw
/// string keeps every byte.
pub fn string_from_text(text: str) -> str ! BadEscape {
    guard some sh = string_shape(text) else { return fault(f"LIT003: `{text}` is not a string token"); };
    if sh.fstring { return fault(f"LIT003: `{text}` is an f-string, which has no single value"); }
    if sh.raw { return text.slice(sh.start, sh.end); }
    var out = "";
    var from = sh.start;
    var i = sh.start;
    while i < sh.end {
        if text.byte_at(i) as i64 == BACKSLASH {
            guard some v = escape_value(text, i, sh.end) else {
                return res<str, BadEscape>.err(bad_escape(text, i));
            };
            out = out + text.slice(from, i) + (from_utf8([v]) ?? fault("LIT003: an escape stands for a byte that is not UTF-8"));
            i = i + 2;
            from = i;
        } else {
            i = i + 1;
        }
    }
    return out + text.slice(from, sh.end);
}

/// Where the f-string hole whose code starts at `from` ends: at its `}`,
/// braces counted and quoted strings in it skipped; or at `end`.
fn hole_end(text: str, from: i64, end: i64) -> i64 {
    var depth = 0;
    var i = from;
    while i < end {
        let b = text.byte_at(i) as i64;
        if b == DOUBLE_QUOTE || b == SINGLE_QUOTE {
            i = i + 1;
            while i < end && text.byte_at(i) as i64 != b {
                if text.byte_at(i) as i64 == BACKSLASH { i = i + 1; }
                i = i + 1;
            }
        } else if b == byte_of("{") {
            depth = depth + 1;
        } else if b == byte_of("}") {
            if depth == 0 { return i; }
            depth = depth - 1;
        }
        i = i + 1;
    }
    return end;
}

/// Every unknown escape in string token `text`, in order: in its body, or
/// in an f-string's text outside its holes (a hole is code; a string in it
/// is a token of its own). A raw string has none.
pub fn string_escape_problems(text: str) -> List<BadEscape> {
    var found: List<BadEscape> = [];
    guard some sh = string_shape(text) else { return found; };
    if sh.raw { return found; }
    var i = sh.start;
    while i < sh.end {
        let b = text.byte_at(i) as i64;
        if b == BACKSLASH {
            if escape_value(text, i, sh.end) == none { found.push(bad_escape(text, i)); }
            i = i + 2;
        } else if sh.fstring && b == byte_of("{") && i + 1 < sh.end && text.byte_at(i + 1) as i64 == b {
            i = i + 2;
        } else if sh.fstring && b == byte_of("{") {
            i = hole_end(text, i + 1, sh.end) + 1;
        } else {
            i = i + 1;
        }
    }
    return found;
}

/// The escapes as a reader would write them, for messages:
/// "`\n`, `\t`, ... and `\'`".
pub fn escapes_text() -> str {
    var out = "";
    var i = 0;
    while i < ESCAPES.len() as i64 {
        if i > 0 { out = out + (if i == ESCAPES.len() as i64 - 1 { " and " } else { ", " }); }
        out = out + "`" + (from_utf8([BACKSLASH, ESCAPES[i].after]) ?? fault("LIT003: an escape is not UTF-8")) + "`";
        i = i + 1;
    }
    return out;
}
