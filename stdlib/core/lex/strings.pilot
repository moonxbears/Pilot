// =========================================================================
// FILE: stdlib/core/lex/strings.pilot
// STRING TOKENS (PROP-021 slice 21B)
// =========================================================================
// As today's seed lexer reads them:
//   - a quoted string (`"..."` or `'...'`) ends at its own quote and may
//     not hold a newline; `\` takes the next byte with it, so `\"` does
//     not close it;
//   - a triple-quoted string ends at the first three quotes and may hold
//     newlines; `\` is an ordinary byte in it;
//   - prefix `r` / `R` makes a raw string and `b` / `B` a byte string. The
//     seed reads their text the same way (a raw string's `\"` still does
//     not close it), so only the family differs.
// An f-string (`f"..{x}.."`, any quoting, `rf`/`fr` raw) is lexed in
// modes: its opening enters the f-string's mode, whose tokens are its text,
// a `{` that enters the hole mode, and its closing quote, which leaves.
// Inside a hole the ordinary tokens apply, so the expression in it is real
// tokens, not text read again later. `{{` is text; a lone `}` is text too,
// as in today's seed lexer.
// What an escape means is the job of the string's value function
// (`string_from_text` in literal_value.pilot, with its `ESCAPES` table),
// not of this file.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.Strings;

use Pilot.Core.Lex.Patterns;

/// The prefix letters of a raw, a byte and an f-string, in either case.
/// The patterns below and the value code (literal_value.pilot) read them.
pub const RAW_MARKS: str = "rR";
pub const BYTE_MARKS: str = "bB";
pub const FSTRING_MARKS: str = "fF";

/// A string quoted by byte `q`.
[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
fn quoted(q: i64) -> Pattern {
    let escaped: Pattern = byte(BACKSLASH) + any_byte();
    return byte(q) + (any_but([q, BACKSLASH, NEWLINE]) | escaped).many() + byte(q);
}

/// A string quoted by three of byte `q`.
[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
fn triple(q: i64) -> Pattern {
    let other: Pattern = any_but([q]);
    let three: Pattern = byte(q) * 3;
    return three + (other | byte(q) + other | byte(q) * 2 + other).many() + three;
}

/// A string quoted by `q` whose closing quote does not come before the end
/// of the line or of the source.
[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
fn open_quoted(q: i64) -> Pattern {
    let escaped: Pattern = byte(BACKSLASH) + any_byte();
    return byte(q) + (any_but([q, BACKSLASH, NEWLINE]) | escaped).many();
}

/// A string never closed (`print("caf`): one token to the end of the line,
/// so it is reported once, as an unclosed string, and not as a stray quote
/// followed by code. A closed string is always longer, so this family wins
/// only when the closing quote is missing. The lexicon rejects it
/// (`REJECTED_FORMS`, LEX001); the seed reads it as a string, whose missing
/// close its parser reports.
pub const UNCLOSED_STRING: str = "unclosed_string";

pub fn unclosed_string_tokens() -> List<TokenDecl> =>
    [acting(TokenRole::Operand, token(UNCLOSED_STRING, class(RAW_MARKS + BYTE_MARKS).opt() + (open_quoted(DOUBLE_QUOTE) | open_quoted(SINGLE_QUOTE)))),];

/// A string in either quote, once or three times (`three`).
pub fn string_body(three: bool) -> Pattern =>
    if three { triple(DOUBLE_QUOTE) | triple(SINGLE_QUOTE) } else { quoted(DOUBLE_QUOTE) | quoted(SINGLE_QUOTE) };

/// What a triple-quoted string's family adds to the family's name: the
/// seed reads the two quotings as different kinds, so they are different
/// families.
pub const TRIPLE_SUFFIX: str = "_triple";
/// What a raw f-string's opener adds to the family's name.
pub const RAW_SUFFIX: str = "_raw";

/// The family `base` of a string quoted three times when `triple`.
pub fn string_family(base: str, triple: bool) -> str => if triple { base + TRIPLE_SUFFIX } else { base };

/// The family of an f-string's opening, by quoting.
pub fn fstring_open_family(triple: bool, raw: bool) -> str {
    let name = string_family("fstring_open", triple);
    return if raw { name + RAW_SUFFIX } else { name };
}

/// The name of the mode of an f-string quoted by `q` (three times when
/// `triple`), raw or not.
pub fn fstring_mode_name(q: i64, triple: bool, raw: bool) -> str {
    var name = "fstring";
    name = name + (if q == DOUBLE_QUOTE { "_double" } else { "_single" });
    if triple { name = name + TRIPLE_SUFFIX; }
    if raw { name = name + RAW_SUFFIX; }
    return name;
}

/// The mode the expression in an f-string's `{ .. }` is lexed in.
pub const HOLE_MODE: str = "fstring_hole";

/// The family of the `{` that opens an f-string hole.
pub const HOLE_OPEN: str = "hole_open";

/// The families inside an f-string's quoting mode: a run of text, a lone
/// quote inside a triple-quoted one, and the closing quote.
pub const FSTRING_TEXT: str = "fstring_text";
pub const FSTRING_QUOTE: str = "fstring_quote";
pub const FSTRING_CLOSE: str = "fstring_close";

/// A hole's format spec (`{n:#_###}`, `{x:0.00}`): a `:`, then a run with
/// no space, quote, bracket, brace or `:`, spaces around it, and the hole's
/// `}` right after, which it leaves for the next token. Being longer than
/// `:`, it wins there, and a `#` in it is no directive line. Whether the
/// run is a pattern format.pilot's `format_by_pattern` reads (`#`, `0`, `,`,
/// `_`, `.`) is the parser's check, so `{n:#x#}` is one f-string whose
/// hole is reported (SYN001). Known limit: a struct literal that ends a
/// hole (`{P { x: y }}`) lexes its last field as a spec here.
pub const FORMAT_SPEC: str = "format_spec";
pub const FORMAT_SPACES: str = " \t";

[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
pub fn format_spec_token() -> TokenDecl {
    let spaces: Pattern = class(FORMAT_SPACES).many();
    let run: Pattern = any_but([byte_of(" "), TAB, NEWLINE, DOUBLE_QUOTE, SINGLE_QUOTE, byte_of(":"), byte_of("{"), byte_of("}"), byte_of("("), byte_of(")"), byte_of("["), byte_of("]")]).some();
    return trailed_by("}", token(FORMAT_SPEC, lit(":") + spaces + run + spaces));
}

/// `\"` or `\'` inside a hole. A hole is code, so a quote in it is a plain
/// quote (`f"{m["k"]}"`; owner decision 2026-11-17). The escaped form is its
/// own family only so the lexicon can reject it with a fix-it (LEX009,
/// `REJECTED_FORMS` in lexicon.pilot); the seed reads it as an error token.
pub const HOLE_ESCAPED_QUOTE: str = "hole_escaped_quote";

pub fn hole_escaped_quote_token() -> TokenDecl => token(HOLE_ESCAPED_QUOTE, byte(BACKSLASH) + (byte(DOUBLE_QUOTE) | byte(SINGLE_QUOTE)));

fn quotes(q: i64, triple: bool) -> Pattern => if triple { byte(q) * 3 } else { byte(q) };

fn fprefix(raw: bool) -> Pattern => if raw { class(RAW_MARKS) + class(FSTRING_MARKS) | class(FSTRING_MARKS) + class(RAW_MARKS) } else { class(FSTRING_MARKS) };

/// The quotings of an f-string: quote byte, triple, raw.
fn each_fstring(var ref out: List<TokenDecl>, var ref modes: List<LexMode>) {
    for q in [DOUBLE_QUOTE, SINGLE_QUOTE] {
        for triple in [false, true] {
            for raw in [false, true] {
                let name = fstring_mode_name(q, triple, raw);
                out.push(entering(name, token(fstring_open_family(triple, raw), fprefix(raw) + quotes(q, triple))));
                modes.push(fstring_mode(q, triple, raw));
            }
        }
    }
}

/// The tokens that open an f-string, each entering its mode.
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn fstring_openers() -> List<TokenDecl> {
    var out: List<TokenDecl> = [];
    var modes: List<LexMode> = [];
    each_fstring(out, modes);
    return out;
}

/// The mode of each f-string quoting.
pub fn fstring_modes() -> List<LexMode> {
    var out: List<TokenDecl> = [];
    var modes: List<LexMode> = [];
    each_fstring(out, modes);
    return modes;
}

/// Inside an f-string quoted by `q`: text (no quote, no `{` but `{{`, and
/// unless raw an escape; a newline only when triple), the hole's `{`, and
/// the closing quote. A triple-quoted one also takes one or two quotes as
/// text; three close it.
[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
fn fstring_mode(q: i64, triple: bool, raw: bool) -> LexMode {
    var stop: List<i64> = [q, byte_of("{")];
    if !raw { stop.push(BACKSLASH); }
    if !triple { stop.push(NEWLINE); }
    var piece: Pattern = any_but(stop) | lit("{{");
    if !raw { piece = piece | byte(BACKSLASH) + any_byte(); }
    var tokens: List<TokenDecl> = [token(FSTRING_TEXT, piece.some())];
    if triple { tokens.push(token(FSTRING_QUOTE, byte(q) | byte(q) * 2)); }
    tokens.push(entering(HOLE_MODE, token(HOLE_OPEN, lit("{"))));
    tokens.push(acting(TokenRole::Operand, leaving(token(FSTRING_CLOSE, quotes(q, triple)))));
    return lex_mode(fstring_mode_name(q, triple, raw), tokens);
}

/// The string tokens, in declaration order: plain, raw and byte strings,
/// each quoted once and three times.
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn string_tokens() -> List<TokenDecl> {
    var out: List<TokenDecl> = [];
    for triple in [false, true] {
        out.push(acting(TokenRole::Operand, token(string_family("string", triple), string_body(triple))));
        out.push(acting(TokenRole::Operand, token(string_family("raw_string", triple), class(RAW_MARKS) + string_body(triple))));
        out.push(acting(TokenRole::Operand, token(string_family("byte_string", triple), class(BYTE_MARKS) + string_body(triple))));
    }
    return out;
}
