// =========================================================================
// FILE: stdlib/core/lex/names.pilot
// NAME TOKENS AND THE SEED WORDS (PROP-021 slice 21B)
// =========================================================================
// A name starts with a letter or `_` and goes on with letters, digits and
// `_`, where the letters beyond ASCII are Unicode's identifier letters
// (UAX #31: XID_Start, then XID_Continue; owner decision 2026-11-16), as
// UTF-8 bytes (PROP-021 §2.8). A seed word is declared over the name
// pattern with a higher priority, so `fn` is the word and `fnord` a name
// (the longest match).
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.Names;

use Pilot.Core.Lex.Patterns;
use Pilot.Core.Lex.Words;
use Pilot.Core.Lex.Utf8;
use Pilot.Core.Lex.UnicodeXid;

/// An ASCII character that may start a name.
pub fn ascii_name_start() -> Pattern => "a" ..= "z" | "A" ..= "Z" | lit("_");

/// A character that may start a name: an ASCII letter, `_`, or an XID_Start
/// letter beyond ASCII.
pub fn name_start() -> Pattern => ascii_name_start() | utf8_ranges(XID_START_RANGES);

/// A character that may continue a name: one that may start it, an ASCII
/// digit, or an XID_Continue character beyond ASCII (combining marks,
/// other scripts' digits, ...). The two non-ASCII sets are joined first, so
/// they form one trie.
pub fn name_continue() -> Pattern => ascii_name_start() | "0" ..= "9" | utf8_ranges(ranges_union(XID_START_RANGES, XID_CONTINUE_ONLY_RANGES));

/// A name: a start character, then continue characters.
pub fn name_pattern() -> Pattern => name_start() + name_continue().many();

/// `:red`, `:ns/kw`: a keyword literal. Only after a space, so `x:y` and
/// `case 1:` keep their `:`.
pub fn keyword_literal() -> Pattern => lit(":") + name_pattern() + (lit("/") + name_pattern()).opt();

/// The name token, one token per seed word, and the keyword literal, in
/// declaration order.
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn name_tokens() -> List<TokenDecl> {
    var out: List<TokenDecl> = [acting(TokenRole::Operand, token("name", name_pattern()))];
    for w in SEED_WORDS {
        out.push(token_over(w, 1, lit(w)));
    }
    out.push(starting(TokenWhen::Spaced, acting(TokenRole::Operand, token("keyword_literal", keyword_literal()))));
    return out;
}
