// =========================================================================
// FILE: stdlib/core/lex/numbers.pilot
// NUMBER TOKENS: what a number is, declared once (PROP-021 slice 21A)
// =========================================================================
// The digit separator is legal only where `digits` puts it: between two
// digits. So `1_000_000` is one number, while `1000_`, `1__000` and `0x_FF`
// are not (their longest number is `1000`, `1` and `0`; the checker reports
// them as LIT001). The separator, the radixes and the digits are declared
// once, as data (`DIGIT_SEPARATOR`, `RADIXES`, `DIGIT_RANGES`); the value
// function reads the same data (`Pilot.Core.Lex.LiteralValue`), so changing
// the separator is an edit to `DIGIT_SEPARATOR` alone.
//
// This file says what a number looks like. What it is worth, and whether
// that fits the type it lands in (LIT002), is the value function's job.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.Numbers;

use Pilot.Core.Lex.Patterns;
use Pilot.Core.Lex.Words;
use Pilot.Core.Convert.DecimalRound;

/// The bases a number may be written in.
pub enum Radix : u8 {
    Dec,
    Hex,
    Bin,
    Oct,
}

/// A radix: the prefix that selects it, the base it counts in, and the
/// family its integers are lexed as (the parser reads the base from it).
pub struct RadixInfo : IValue {
    pub radix: Radix;
    pub prefix: str;
    pub base: i64;
    pub family: str;
}

/// Every radix, declared once: the integer pattern and the value function
/// (`Pilot.Core.Lex.LiteralValue`) both read this table.
pub const RADIXES: List<RadixInfo> = [
    RadixInfo { radix: Radix::Dec, prefix: "", base: 10, family: "integer" },
    RadixInfo { radix: Radix::Hex, prefix: "0x", base: 16, family: "hex_integer" },
    RadixInfo { radix: Radix::Bin, prefix: "0b", base: 2, family: "bin_integer" },
    RadixInfo { radix: Radix::Oct, prefix: "0o", base: 8, family: "oct_integer" },
];

/// Bytes `lo ..= hi` are the digits `value`, `value + 1`, ..
pub struct DigitRange : IValue {
    pub lo: i64;
    pub hi: i64;
    pub value: i64;
}

/// The digit bytes and their values, declared once: `0`-`9` (48-57) are
/// 0-9, `a`-`f` (97-102) and `A`-`F` (65-70) are 10-15. A radix takes the
/// digits whose value is below its base.
pub const DIGIT_RANGES: List<DigitRange> = [
    DigitRange { lo: 48, hi: 57, value: 0 },
    DigitRange { lo: 97, hi: 102, value: 10 },
    DigitRange { lo: 65, hi: 70, value: 10 },
];

/// The digit separator: it may stand only between two digits.
pub const DIGIT_SEPARATOR: str = "_";

/// The base `radix` counts in.
pub fn base_of(radix: Radix) -> i64 {
    for r in RADIXES {
        if r.radix == radix { return r.base; }
    }
    return 10;
}

/// The value of digit byte `b`, or -1 for a byte that is no digit. Whether
/// it is a digit of a given radix is whether the value is below its base.
pub fn digit_value(b: i64) -> i64 {
    for r in DIGIT_RANGES {
        if b >= r.lo && b <= r.hi { return r.value + b - r.lo; }
    }
    return -1;
}

/// One digit of `radix`: the bytes of `DIGIT_RANGES` whose value is below
/// its base.
[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
pub fn digit(radix: Radix) -> Pattern {
    let base = base_of(radix);
    var out: List<Pattern> = [];
    for r in DIGIT_RANGES {
        if r.value < base {
            let top = if r.hi - r.lo + r.value < base { r.hi } else { r.lo + base - 1 - r.value };
            out.push(byte_range(r.lo, top));
        }
    }
    var p: Pattern = out[0];
    var i = 1;
    while i < out.len() {
        p = p | out[i];
        i = i + 1;
    }
    return p;
}

/// Digits of `radix`, optionally grouped by the separator, which may only
/// stand between two digits.
pub fn digits(radix: Radix) -> Pattern => digit(radix) + (lit(DIGIT_SEPARATOR).opt() + digit(radix)).many();

/// `e10`, `E-3`, `e+1_0`. The marks, signs and point are the decimal
/// notation text conversion reads too (stdlib/core/convert/decimal_round.pilot).
pub fn exponent() -> Pattern => class(EXPONENT_MARKS) + class(EXPONENT_SIGNS).opt() + digits(Radix::Dec);

/// `1_000`, `0xFF_FF`, `0b1010`, `0o17`: each radix of `RADIXES`, after its
/// prefix.
[Workaround("seed.unannotated_local_operator", "the locals holding a Pattern are annotated")]
pub fn integer() -> Pattern {
    var p: Pattern = in_radix(RADIXES[0]);
    var i = 1;
    while i < RADIXES.len() {
        p = p | in_radix(RADIXES[i]);
        i = i + 1;
    }
    return p;
}

fn in_radix(r: RadixInfo) -> Pattern => if r.prefix == "" { digits(r.radix) } else { lit(r.prefix) + digits(r.radix) };

/// `2.5`, `2.5e10`, `1e9`. A float has digits on both sides of its `.`, so
/// `1..5` is `1`, `..`, `5`.
pub fn float() -> Pattern =>
    digits(Radix::Dec) + lit(DECIMAL_POINT) + digits(Radix::Dec) + exponent().opt()
    | digits(Radix::Dec) + exponent();

/// The float family's name.
pub const FLOAT_FAMILY: str = "float";

/// What a suffixed number's family adds to its number's family.
pub const SUFFIXED: str = "_suffixed";

/// A number's suffix: a unit (`250ms`, `2.4GHz`) or a type (`200u8`,
/// `0xFFu8`), told apart by the parser. An ASCII letter, then ASCII
/// letters, digits and `_`.
pub fn suffix() -> Pattern {
    let letter: Pattern = "a" ..= "z" | "A" ..= "Z";
    return letter + (letter | "0" ..= "9" | lit(DIGIT_SEPARATOR)).many();
}

/// The number tokens, in declaration order: one integer family per radix,
/// then the float. A prefixed radix and the float outrank the decimal
/// integer, so `0xFF` and `1e9` are not the decimal `0` or `1` with a
/// suffix (`xFF`, `e9`) once suffixed numbers are tokens too (priorities
/// 2 and 1; `suffixed_number_tokens` ranks each one lower).
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn number_tokens() -> List<TokenDecl> {
    var out: List<TokenDecl> = [];
    for r in RADIXES {
        out.push(acting(TokenRole::Operand, token_over(r.family, if r.prefix == "" { 1 } else { 2 }, in_radix(r))));
    }
    out.push(acting(TokenRole::Operand, token_over(FLOAT_FAMILY, 2, float())));
    return out;
}

/// Each number token followed by a suffix, as one token of its own family
/// (`integer_suffixed`, ..), ranked one below its number: the digits are
/// taken first, so `0xFFe` is a hex number and `1.5e3` a float, not a
/// number with the suffix `e` or `e3`. A suffix that is a seed word is not one: `1if`
/// is `1` and `if`. For that, each number followed by a seed word is
/// declared once more (priority 3, over every number), with the word left for the
/// next token (one declaration per word length, as `trails` is a length).
/// A seed word starting with no letter (`__engine`) is never a suffix.
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn suffixed_number_tokens() -> List<TokenDecl> {
    var lengths: List<i64> = [];
    for w in SEED_WORDS {
        let b = w.byte_at(0) as i64;
        let letter = (b >= 97 && b <= 122) || (b >= 65 && b <= 90);
        let n = w.len() as i64;
        var known = !letter;
        for l in lengths {
            if l == n { known = true; }
        }
        if !known { lengths.push(n); }
    }
    var out: List<TokenDecl> = [];
    for d in number_tokens() {
        out.push(acting(TokenRole::Operand, token_over(d.name + SUFFIXED, d.priority - 1, seq([d.pattern, suffix()]))));
    }
    for d in number_tokens() {
        for n in lengths {
            var words: List<str> = [];
            for w in SEED_WORDS {
                if w.len() as i64 == n && w.byte_at(0) as i64 != byte_of("_") { words.push(w); }
            }
            out.push(trailed_by_any(words, token_over(d.name, 3, d.pattern)));
        }
    }
    return out;
}
