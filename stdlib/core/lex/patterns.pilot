// =========================================================================
// FILE: stdlib/core/lex/patterns.pilot
// TOKEN PATTERNS (PROP-021 slice 21A)
// =========================================================================
// A token is declared as a pattern over bytes, built from the functions
// below. `pilot.lex.build` compiles a list of declarations into the state
// table the lexer runs; nothing about a token's spelling lives anywhere
// else.
//
// A `Pattern` is a postfix program: its leaves are byte ranges and every
// combinator appends one op that consumes the patterns before it. So
// patterns compose by value (`float` reuses `digits`), a pattern can never
// refer to itself, and the builder reads it with one stack pass.
//
// Bootstrap subset: these files use plain decimal numbers and plain strings
// only, so a byte that needs an escape is named by a constant below
// (`byte(DOUBLE_QUOTE)`).
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.Patterns;

use Pilot.Core.Primitives.Span;

/// One step of a pattern's postfix program.
pub enum PatKind : u8 {
    /// Matches one byte in `lo ..= hi`.
    Bytes,
    /// The last `n` patterns one after another (`n` = 0 matches nothing).
    Seq,
    /// Any one of the last `n` patterns.
    Alt,
    /// The last pattern or nothing.
    Opt,
    /// The last pattern zero or more times.
    Many,
    /// The last pattern one or more times.
    AtLeastOne,
}

[Layout(c_abi)]
pub struct PatOp : IValue {
    pub kind: PatKind;
    pub lo: i64;
    pub hi: i64;
    pub n: i64;
}

/// A token pattern: a postfix program of `PatOp`s. Patterns combine with
/// Pilot's own operators: `a + b` is `a` then `b`, `a | b` is either, and
/// `+` binds tighter than `|`, so `lit("0x") + hex | dec` is
/// `(lit("0x") + hex) | dec`.
pub struct Pattern : IObject {
    pub ops: List<PatOp>;

    /// `a + b`: `a`, then `b`.
    pub op + (rhs: Pattern) -> Pattern => joined_pattern(self, rhs, PatKind::Seq);
    /// `a | b`: `a` or `b`.
    pub op | (rhs: Pattern) -> Pattern => joined_pattern(self, rhs, PatKind::Alt);
    /// `p * n`: this pattern exactly `n` times.
    pub op * (count: i64) -> Pattern => repeated(self, count, count);
    /// `p[1 ..= 6]`: this pattern at least `start` and at most `end` times.
    /// Each count costs about one state, so keep the bounds small.
    pub op _[_] (counts: span<i64>) -> Pattern => repeated(self, counts.start, counts.end);

    /// This pattern or nothing.
    pub fn opt(ref self) -> Pattern => wrapped_pattern(self, PatKind::Opt);
    /// This pattern zero or more times.
    pub fn many(ref self) -> Pattern => wrapped_pattern(self, PatKind::Many);
    /// This pattern one or more times.
    pub fn some(ref self) -> Pattern => wrapped_pattern(self, PatKind::AtLeastOne);
}

/// `"0" ..= "9"`: one byte from the first byte of the left text to the first
/// byte of the right text, both included.
ext str {
    pub op ..= (hi: str) -> Pattern => byte_range(self.byte_at(0) as i64, hi.byte_at(0) as i64);
}

/// Where a token may start, from what came before it (flex's start
/// conditions). The lexer starts each token in one context: the start of the
/// text, after a space or newline, glued to an operand (no space, and the
/// token before ends an operand), or none of these.
pub enum TokenWhen : u8 {
    /// Anywhere.
    Always,
    /// After a space or newline, or at the start of the text (`:name`).
    Spaced,
    /// Right after an operand, with no space between (`a.b`'s `.`).
    Glued,
    /// At the very start of the text (`#!`).
    AtStart,
}

/// What a token does to the context of the token after it.
pub enum TokenRole : u8 {
    /// Ends the context: the next token is neither spaced nor glued.
    Plain,
    /// Ends an operand: a token right after it is glued (a name, a
    /// literal, `)`).
    Operand,
    /// A space or newline: the next token is spaced.
    Space,
    /// Leaves the context as it was (a comment).
    Trivia,
}

/// A declared token: its name, the pattern its text must match, and its
/// priority, which decides between two tokens that match exactly the same
/// text in the same context (the higher wins; equal priorities are an error,
/// LEX002). `when` and `role` are its context rules; `enters` names the
/// mode a lexer switches to after it (`""` for none), and `leaves` returns
/// to the mode before. `trails` counts the bytes at the end of `pattern`
/// that must follow the token but are not part of it (`f!(`'s `(`).
pub struct TokenDecl : IObject {
    pub name: str;
    pub priority: i64;
    pub pattern: Pattern;
    pub when: TokenWhen;
    pub role: TokenRole;
    pub enters: str;
    pub leaves: bool;
    pub trails: i64;
}

pub fn token(name: str, pattern: Pattern) -> TokenDecl => token_over(name, 0, pattern);

pub fn token_over(name: str, priority: i64, pattern: Pattern) -> TokenDecl =>
    TokenDecl { name: name, priority: priority, pattern: pattern, when: TokenWhen::Always, role: TokenRole::Plain, enters: "", leaves: false, trails: 0 };

/// `d`, which may only start in context `w`.
pub fn starting(w: TokenWhen, d: TokenDecl) -> TokenDecl {
    var out = d;
    out.when = w;
    return out;
}

/// `d`, with role `r`.
pub fn acting(r: TokenRole, d: TokenDecl) -> TokenDecl {
    var out = d;
    out.role = r;
    return out;
}

/// `d`, after which the lexer is in mode `m`.
pub fn entering(m: str, d: TokenDecl) -> TokenDecl {
    var out = d;
    out.enters = m;
    return out;
}

/// `d`, matched only when `text` follows it; `text` is left for the next
/// token (fixed trailing context, as in lex's `r/s`).
pub fn trailed_by(text: str, d: TokenDecl) -> TokenDecl {
    var out = d;
    out.pattern = seq([d.pattern, lit(text)]);
    out.trails = d.trails + text.len() as i64;
    return out;
}

/// `d` matched only before one of `texts` (all of one length), which it
/// leaves for the next token.
pub fn trailed_by_any(texts: List<str>, d: TokenDecl) -> TokenDecl {
    var alts: List<Pattern> = [];
    for t in texts { alts.push(lit(t)); }
    var out = d;
    out.pattern = seq([d.pattern, alt(alts)]);
    out.trails = d.trails + texts[0].len() as i64;
    return out;
}

/// `d`, after which the lexer returns to the mode it was in before.
pub fn leaving(d: TokenDecl) -> TokenDecl {
    var out = d;
    out.leaves = true;
    return out;
}

/// A lexer mode: a name and the tokens that may start in it. The first mode
/// of a lexicon is where lexing starts.
pub struct LexMode : IObject {
    pub name: str;
    pub tokens: List<TokenDecl>;
}

pub fn lex_mode(name: str, tokens: List<TokenDecl>) -> LexMode => LexMode { name: name, tokens: tokens };

fn pat_op(kind: PatKind, lo: i64, hi: i64, n: i64) -> PatOp => PatOp { kind: kind, lo: lo, hi: hi, n: n };

fn append_ops(var ref out: List<PatOp>, ref p: Pattern) {
    for o in p.ops {
        out.push(o);
    }
}

fn joined_pattern(ref a: Pattern, ref b: Pattern, kind: PatKind) -> Pattern {
    var ops: List<PatOp> = [];
    append_ops(ops, a);
    append_ops(ops, b);
    ops.push(pat_op(kind, 0, 0, 2));
    return Pattern { ops: ops };
}

// -------------------------------------------------------------------------
// Leaves
// -------------------------------------------------------------------------

/// One byte in `lo ..= hi`, both given by value.
pub fn byte_range(lo: i64, hi: i64) -> Pattern {
    var ops: List<PatOp> = [];
    ops.push(pat_op(PatKind::Bytes, lo, hi, 0));
    return Pattern { ops: ops };
}

// The bytes the bootstrap subset cannot write in a plain string (or that
// read better by name), declared once.
pub const TAB: i64 = 9;
pub const NEWLINE: i64 = 10;
pub const CARRIAGE_RETURN: i64 = 13;
pub const DOUBLE_QUOTE: i64 = 34;
pub const SINGLE_QUOTE: i64 = 39;
pub const BACKSLASH: i64 = 92;

/// The one byte with value `b`.
pub fn byte(b: i64) -> Pattern => byte_range(b, b);

/// The value of the first byte of `text` (`byte_of("*")` is 42).
pub fn byte_of(text: str) -> i64 => text.byte_at(0) as i64;

/// Any one byte.
pub fn any_byte() -> Pattern => byte_range(0, 255);

/// Any one byte whose value is not in `bytes`.
pub fn any_but(bytes: List<i64>) -> Pattern {
    var ops: List<PatOp> = [];
    var lo = 0;
    while lo < 256 {
        if byte_listed(bytes, lo) {
            lo = lo + 1;
        } else {
            var hi = lo;
            while hi < 255 && !byte_listed(bytes, hi + 1) {
                hi = hi + 1;
            }
            ops.push(pat_op(PatKind::Bytes, lo, hi, 0));
            lo = hi + 1;
        }
    }
    if ops.len() != 1 {
        ops.push(pat_op(PatKind::Alt, 0, 0, ops.len() as i64));
    }
    return Pattern { ops: ops };
}

fn byte_listed(ref bytes: List<i64>, b: i64) -> bool {
    for x in bytes {
        if x == b {
            return true;
        }
    }
    return false;
}

/// Exactly the bytes of `text`, in order.
pub fn lit(text: str) -> Pattern {
    var ops: List<PatOp> = [];
    var i = 0;
    while i < text.len() {
        let b = text.byte_at(i) as i64;
        ops.push(pat_op(PatKind::Bytes, b, b, 0));
        i = i + 1;
    }
    if text.len() != 1 {
        ops.push(pat_op(PatKind::Seq, 0, 0, text.len() as i64));
    }
    return Pattern { ops: ops };
}

/// Any one of the bytes of `chars` (`class("eE")`).
pub fn class(chars: str) -> Pattern {
    var ops: List<PatOp> = [];
    var i = 0;
    while i < chars.len() {
        let b = chars.byte_at(i) as i64;
        ops.push(pat_op(PatKind::Bytes, b, b, 0));
        i = i + 1;
    }
    if chars.len() != 1 {
        ops.push(pat_op(PatKind::Alt, 0, 0, chars.len() as i64));
    }
    return Pattern { ops: ops };
}

// -------------------------------------------------------------------------
// Combinators
// -------------------------------------------------------------------------

/// The parts one after another.
pub fn seq(parts: List<Pattern>) -> Pattern {
    var ops: List<PatOp> = [];
    for p in parts {
        append_ops(ops, p);
    }
    ops.push(pat_op(PatKind::Seq, 0, 0, parts.len() as i64));
    return Pattern { ops: ops };
}

/// Any one of the parts.
pub fn alt(parts: List<Pattern>) -> Pattern {
    var ops: List<PatOp> = [];
    for p in parts {
        append_ops(ops, p);
    }
    ops.push(pat_op(PatKind::Alt, 0, 0, parts.len() as i64));
    return Pattern { ops: ops };
}

fn wrapped_pattern(ref p: Pattern, kind: PatKind) -> Pattern {
    var ops: List<PatOp> = [];
    append_ops(ops, p);
    ops.push(pat_op(kind, 0, 0, 1));
    return Pattern { ops: ops };
}

fn repeated(ref p: Pattern, min: i64, max: i64) -> Pattern {
    var ops: List<PatOp> = [];
    var count = 0;
    while count < min {
        append_ops(ops, p);
        count = count + 1;
    }
    // The optional tail nests (`p (p (p)?)?`), so a later copy is only
    // tried after an earlier one matched.
    var tail = 0;
    while count < max {
        append_ops(ops, p);
        count = count + 1;
        tail = tail + 1;
    }
    var closed = 0;
    while closed < tail {
        if closed > 0 {
            ops.push(pat_op(PatKind::Seq, 0, 0, 2));
        }
        ops.push(pat_op(PatKind::Opt, 0, 0, 1));
        closed = closed + 1;
    }
    var parts = min;
    if tail > 0 {
        parts = parts + 1;
    }
    if parts != 1 {
        ops.push(pat_op(PatKind::Seq, 0, 0, parts));
    }
    return Pattern { ops: ops };
}
