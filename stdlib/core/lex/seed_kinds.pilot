    // Compound assignments.
    FamilyKind { family: "+=", kind: 300 },
    FamilyKind { family: "-=", kind: 301 },
    FamilyKind { family: "*=", kind: 302 },
    FamilyKind { family: "/=", kind: 303 },
    FamilyKind { family: "%=", kind: 304 },
    FamilyKind { family: "**=", kind: 305 },
