// =========================================================================
// FILE: stdlib/core/lex/seed_kinds.pilot
// THE KIND THE SEED PARSER READS FOR EACH TOKEN FAMILY (PROP-021 slice 21G)
// =========================================================================
// The seed parser (crates/pilot-parser) reads a token's kind as a number
// of crates/pilot-lexer/src/token.rs's `#[repr(u16)] enum TokenKind`, and
// a few flag bits (`TokenFlags`). When the seed runs the table written from
// the token declarations (`pilot lex --write-table`, toolchain.lex), each
// family's number and flags come from this file, so the Rust side receives
// numbers only, never a Pilot name. A family no entry here names is LEX008
// when the table is written.
//
// The numbers are the seed's (token.rs), copied by hand; they change only
// with token.rs, which is frozen until PROP-022 replaces `TokenKind`.
//   - `SEED_FAMILY_KINDS`: a family whose token the seed reads with no flag;
//   - `SEED_FLAGGED_KINDS`: a family read with flags (a raw, interpolated or
//     triple-quoted string; a suffixed number);
//   - `SEED_SKIPPED`: a family the seed never sees (a space that is not a
//     newline);
//   - `SEED_INNER`: a family that is only a piece of an f-string. The seed
//     reads a whole f-string, from its opening to its closing quote, holes
//     and all, as one token: the opening's.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.SeedKinds;

/// The seed's `TokenFlags` bits that a family decides.
pub const SEED_IS_RAW_STRING: u8 = 8;
pub const SEED_IS_INTERPOLATED: u8 = 16;
pub const SEED_IS_DIMENSIONAL: u8 = 32;

/// The seed's kind for a byte no token starts (`ErrorToken`) and for the
/// end of the source (`Eof`), which no family is.
pub const SEED_ERROR_KIND: u16 = 5;
pub const SEED_EOF_KIND: u16 = 0;

/// What the seed does with a family's token.
pub enum SeedEmit : u8 {
    /// One token of the family's kind and flags.
    Token,
    /// Nothing: the seed never sees it.
    Skip,
    /// Part of the f-string token around it.
    Inner,
}

/// A family the seed reads with flags.
pub struct SeedKind : IValue {
    pub family: str;
    pub kind: u16;
    pub flags: u8;
}

/// A family the seed reads with no flag.
pub struct FamilyKind : IValue {
    pub family: str;
    pub kind: u16;
}

pub const SEED_FLAGGED_KINDS: List<SeedKind> = [
    SeedKind { family: "integer_suffixed", kind: 22, flags: SEED_IS_DIMENSIONAL },
    SeedKind { family: "hex_integer_suffixed", kind: 23, flags: SEED_IS_DIMENSIONAL },
    SeedKind { family: "bin_integer_suffixed", kind: 24, flags: SEED_IS_DIMENSIONAL },
    SeedKind { family: "oct_integer_suffixed", kind: 25, flags: SEED_IS_DIMENSIONAL },
    SeedKind { family: "float_suffixed", kind: 26, flags: SEED_IS_DIMENSIONAL },
    SeedKind { family: "raw_string", kind: 27, flags: SEED_IS_RAW_STRING },
    SeedKind { family: "raw_string_triple", kind: 28, flags: SEED_IS_RAW_STRING },
    SeedKind { family: "fstring_open", kind: 27, flags: SEED_IS_INTERPOLATED },
    SeedKind { family: "fstring_open_triple", kind: 28, flags: SEED_IS_INTERPOLATED },
    SeedKind { family: "fstring_open_raw", kind: 27, flags: SEED_IS_INTERPOLATED | SEED_IS_RAW_STRING },
    SeedKind { family: "fstring_open_triple_raw", kind: 28, flags: SEED_IS_INTERPOLATED | SEED_IS_RAW_STRING },
];

