pub const SEED_SKIPPED: List<str> = ["space",];

pub const SEED_INNER: List<str> = ["fstring_text", "fstring_quote", "hole_open", "fstring_close",];

/// What the seed reads for one family.
pub struct SeedEntry : IValue {
    pub kind: u16;
    pub flags: u8;
    pub emit: SeedEmit;
}

/// The seed's entry for `family`, or none when this file does not name it
/// (LEX008).
pub fn seed_kind_of(family: str) -> SeedEntry? {
    for k in SEED_FLAGGED_KINDS {
        if k.family == family { return SeedEntry { kind: k.kind, flags: k.flags, emit: SeedEmit::Token }; }
    }
    for k in SEED_FAMILY_KINDS {
        if k.family == family { return SeedEntry { kind: k.kind, flags: 0, emit: SeedEmit::Token }; }
    }
    for f in SEED_SKIPPED {
        if f == family { return SeedEntry { kind: 0, flags: 0, emit: SeedEmit::Skip }; }
    }
    for f in SEED_INNER {
        if f == family { return SeedEntry { kind: 0, flags: 0, emit: SeedEmit::Inner }; }
    }
    return none;
}
