// =========================================================================
// FILE: stdlib/core/lex/lexicon.pilot
// EVERY TOKEN FAMILY DECLARED SO FAR (PROP-021 slice 21B)
// =========================================================================
// The declarations `pilot.lex.build` compiles into one table: numbers,
// names and seed words, trivia, strings and the structural tokens.
// Operators, dots, the `:name` literal and f-strings come in later slices.
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Lex.Lexicon;

use Pilot.Core.Lex.Patterns;
use Pilot.Core.Lex.Numbers;
use Pilot.Core.Lex.Names;
use Pilot.Core.Lex.Trivia;
use Pilot.Core.Lex.Strings;
use Pilot.Core.Lex.Delimiters;
use Pilot.Core.Lex.SeedForms;

/// Two families that open and close a bracket, by name.
pub struct BracketPair : IValue {
    pub open: str;
    pub close: str;
}

/// The brackets: the structural ones, and an f-string hole, whose `{` is
/// its own family and whose `}` is the structural one (PROP-021 slice 21E).
pub const BRACKET_PAIRS: List<BracketPair> = [
    BracketPair { open: "(", close: ")" },
    BracketPair { open: "[", close: "]" },
    BracketPair { open: "{", close: "}" },
    BracketPair { open: HOLE_OPEN, close: "}" },
];

/// A family the lexicon declares only to reject it: the tape reports `code`
/// with `message`, which says what to write instead.
pub struct RejectedForm : IValue {
    pub family: str;
    pub code: str;
    pub message: str;
}

pub const REJECTED_FORMS: List<RejectedForm> = [
    RejectedForm { family: UNCLOSED_STRING, code: "LEX001", message: "the string is not closed before the end of the line" },
    RejectedForm { family: HOLE_ESCAPED_QUOTE, code: "LEX009", message: "a quote inside an f-string hole is not escaped, because a hole is code: write `f\"{m[\"k\"]}\"`, not `f\"{m[\\\"k\\\"]}\"`" },
];

/// Every token declared so far that lexes in one table, in declaration
/// order (no operators: those come from the program's declarations).
pub fn core_tokens() -> List<TokenDecl> => core_tokens_with([]);

/// `core_tokens()` and `operators` after them.
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn core_tokens_with(operators: List<TokenDecl>) -> List<TokenDecl> {
    var out: List<TokenDecl> = [];
    for group in [number_tokens(), suffixed_number_tokens(), misplaced_separator_tokens(), name_tokens(), trivia_tokens(), unclosed_string_tokens(), string_tokens(), delimiter_tokens(), operators, seed_forms_after(operators)] {
        for d in group {
            out.push(d);
        }
    }
    return out;
}

/// The mode a source starts in.
pub const MAIN_MODE: str = "main";

/// The whole lexicon with its modes, given the operator tokens: the main
/// mode (every token, the operators and the f-string openers), one mode per
/// f-string quoting, and the hole mode (the main mode's tokens but the
/// `#` lines, with braces that enter and leave it, a format spec before the
/// closing `}`, and the escaped quote it rejects).
[StandIn("lex.token_attribute", "each token is a declaration marked [Token(..)] that the builder collects", "the token declarations are returned by this function, listed by hand", "PROP-021")]
pub fn core_modes(operators: List<TokenDecl>) -> List<LexMode> {
    let groups = modal_groups(operators);
    var modes: List<LexMode> = [lex_mode(MAIN_MODE, modal_tokens(groups, false))];
    for m in fstring_modes() {
        modes.push(m);
    }
    modes.push(lex_mode(HOLE_MODE, modal_tokens(groups, true)));
    return modes;
}

/// The seed-form tokens (seed_forms.pilot) that `operators` does not
/// declare already.
fn seed_forms_after(ref operators: List<TokenDecl>) -> List<TokenDecl> {
    var names: List<str> = [];
    for d in operators { names.push(d.name); }
    return seed_form_tokens(names);
}

/// The token groups the main and hole modes share, in declaration order
/// (each mode adds its braces after them). Built once for both modes.
fn modal_groups(operators: List<TokenDecl>) -> List<List<TokenDecl>> => [number_tokens(), suffixed_number_tokens(), misplaced_separator_tokens(), name_tokens(), trivia_tokens(), unclosed_string_tokens(), string_tokens(), fstring_openers(), operators, seed_forms_after(operators),];

/// The tokens of the main mode, or of the hole mode when `in_hole`, from
/// the shared `groups` (`modal_groups`).
fn modal_tokens(ref groups: List<List<TokenDecl>>, in_hole: bool) -> List<TokenDecl> {
    let braces = if in_hole { delimiters_in(true, HOLE_MODE) } else { delimiters_in(false, "") };
    var out: List<TokenDecl> = [];
    for group in [*groups, braces] {
        for d in group {
            if !in_hole || !is_line_start_trivia(d.name) {
                out.push(d);
            }
        }
    }
    if in_hole {
        out.push(format_spec_token());
        out.push(hole_escaped_quote_token());
    }
    return out;
}
