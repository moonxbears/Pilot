// =========================================================================
// FILE: stdlib/core/option.pilot
// STAGE 3B CONCISE NULL-SAFETY (`option<T>` / `T?`)
// Preserves Milestone 12 implicit lifting, niche optimization & `some`/`none`.
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Option;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;

[Lang(Cfg.Lang.opt_t), Layout(c_abi)]
pub partial struct option<T: IAnyValue> : IEquatable<option<T>>, ITryOperator<T, option<never>>, ICoalesceOperator<T> {
    pub val:       T;
    pub has_value: bool;

    pub is_some: bool { get => .has_value; }
    pub is_none: bool { get => !self.has_value; }

    pub static pure:
        fn some(v: T) -> option<T> => option<T> {
            val:       v,
            has_value: true,
        };

        // An empty option leaves its value out, which zero-fills it.
        fn none() -> option<T> => option<T> {
            has_value: false,
        };

    pub pure:
        // Universal postfix `expr?` unwraps `T`, or propagates the empty
        // option early when `is_success()` is `false`.
        fn is_success() -> bool => .has_value;
        // An empty option's failure is the empty option.
        fn failure() -> option<never> => option<never>.none();
        op ?  ()            -> T => .val;
        op ?? (fallback: T) -> T => if .has_value { .val } else { fallback };

        op == (rhs: option<T>) -> bool =>
            if .has_value != rhs.has_value {
                false
            } else {
                if !self.has_value { true } else { .val == rhs.val }
            };

        fn unwrap_or(default_val: T) -> T => if .has_value { .val } else { default_val };

        fn map<U: IAnyValue>(f: (T) => U) -> option<U> =>
            if .has_value {
                option<U>.some(f(.val))
            } else {
                option<U>.none()
            };

        fn and_then<U: IAnyValue>(f: (T) => option<U>) -> option<U> =>
            if .has_value {
                f(.val)
            } else {
                option<U>.none()
            };
}
