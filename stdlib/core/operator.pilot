// =========================================================================
// FILE: stdlib/core/operator.pilot
// STAGE 2 ROOT INTERFACES, 2-BIT LATTICE ORIGINS & OPERATOR PROTOCOLS
// =========================================================================
[EnforceCoreNaming]
pub lvl(Cfg.Tokens.ring_genesis) pkg Pilot.Core.Interfaces;

use Pilot.Core.Genesis.*;

pub interface {
    // 1. Universal 0-Byte Root Contract & 2-Bit Hardware Type Lattice Origins
    [Lang(Cfg.Lang.any_t)]
    IAnyValue {}

    [Lang(Cfg.Lang.val_t), Lattice(Cfg.Lattice.value)]
    IValue : IAnyValue {}

    [Lang(Cfg.Lang.ref_t), Lattice(Cfg.Lattice.reference)]
    IReference : IAnyValue {}

    [Lang(Cfg.Lang.obj_t), Lattice(Cfg.Lattice.object)]
    IObject : IAnyValue {}

    [Lang(Cfg.Lang.guard_t), Lattice(Cfg.Lattice.guard)]
    IGuard : IObject, IReference {}

    // 2. Compile-Time Attribute Marker Contract
    IAttribute : IValue {
        pub weight: i32 { get => 0; }
    }

    // 3. Equality, Ordering & Hashing Contracts
    IEquatable<TSelf: IAnyValue> : IAnyValue {
        pub pure:
            op == (rhs: TSelf) -> bool;
            op != (rhs: TSelf) -> bool => !(self == rhs);
    }

    IComparable<TSelf: IAnyValue> : IEquatable<TSelf> {
        pub pure:
            op <  (rhs: TSelf) -> bool;
            op <= (rhs: TSelf) -> bool => !(rhs < self);
            op >  (rhs: TSelf) -> bool => (rhs < self);
            op >= (rhs: TSelf) -> bool => !(self < rhs);
    }

    ICompareOperator<TRhs: IAnyValue, TOrder: IAnyValue> : IAnyValue {
        pub pure op <=> (rhs: TRhs) -> TOrder;
    }

    IHashable : IAnyValue {
        pub pure fn hash_code() -> u64;
    }

    // 4. Arithmetic, Bitwise & Checked/Saturating/Wrapping ALU Operator Contracts
    IAddOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op + (rhs: TRhs) -> TOut;
    }

    ISubOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op - (rhs: TRhs) -> TOut;
    }

    IMulOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op * (rhs: TRhs) -> TOut;
    }

    IDivOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op / (rhs: TRhs) -> TOut;
    }

    IRemOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op % (rhs: TRhs) -> TOut;
    }

    IModOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op %% (rhs: TRhs) -> TOut;
    }

    ISatAddOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op +| (rhs: TRhs) -> TOut;
    }

    ISatSubOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op -| (rhs: TRhs) -> TOut;
    }

    ISatMulOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op *| (rhs: TRhs) -> TOut;
    }

    IWrapAddOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op +% (rhs: TRhs) -> TOut;
    }

    IWrapSubOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op -% (rhs: TRhs) -> TOut;
    }

    IWrapMulOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op *% (rhs: TRhs) -> TOut;
    }

    ICheckedAddOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op +? (rhs: TRhs) -> TOut;
    }

    ICheckedSubOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op -? (rhs: TRhs) -> TOut;
    }

    ICheckedMulOperator<TRhs: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op *? (rhs: TRhs) -> TOut;
    }

    INegOperator<TOut: IAnyValue> : IAnyValue {
        pub pure op - () -> TOut;
    }

    IBitwiseOperator<TSelf: IAnyValue> : IAnyValue {
        pub pure:
            op &  (rhs: TSelf) -> TSelf;
            op |  (rhs: TSelf) -> TSelf;
            op ^  (rhs: TSelf) -> TSelf;
            op ~  ()           -> TSelf;
            op << (bits: u32)  -> TSelf;
            op >> (bits: u32)  -> TSelf;
    }

    INumber<TSelf: IValue> :
        IValue,
        IComparable<TSelf>,
        IAddOperator<TSelf, TSelf>,
        ISubOperator<TSelf, TSelf>,
        IMulOperator<TSelf, TSelf>,
        IDivOperator<TSelf, TSelf>,
        IRemOperator<TSelf, TSelf>
    {}

    // 5. Indexing, Slicing, Lens, Swap & Unpacking Operator Contracts
    IIndexGet<TIdx: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op [] (idx: TIdx) -> TOut;
    }

    IIndexSet<TIdx: IAnyValue, TVal: IAnyValue> : IAnyValue {
        pub op []= (idx: TIdx, val: TVal);
    }

    ISwapOperator<TRhs: IAnyValue> : IAnyValue {
        pub op :=: (rhs: var ref<TRhs>);
    }

    ILensOperator<TLens: IAnyValue, TOut: IAnyValue> : IAnyValue {
        pub pure op ~> (lens: TLens) -> TOut;
    }

    IOpenRangeOperator<TRhs: IValue, TOut: IValue> : IValue {
        pub pure op >..< (rhs: TRhs) -> TOut;
    }

    IAfterRangeOperator<TOut: IValue> : IValue {
        pub pure op >.. () -> TOut;
    }

    IRangeOperator<TRhs: IValue, TOut: IValue> : IValue {
        pub pure:
            op ..< (rhs: TRhs) -> TOut;
            op ..  (rhs: TRhs) -> TOut;
    }

    ISpanOperator<TRhs: IValue, TOut: IValue> : IValue {
        pub pure op ..= (rhs: TRhs) -> TOut;
    }

    IStepOperator<TStep: IValue, TOut: IValue> : IValue {
        pub pure op : (step_by: TStep) -> TOut;
    }

    // Postfix `x?`: when `x.is_success()`, the value is `x?`'s `op ?` result;
    // otherwise the enclosing function returns `x` itself, so a failure flows
    // out unchanged (`stdlib/core/syntax/try_catch.pilot` binds this protocol).
    ITryOperator<TOk: IAnyValue, TErr: IAnyValue = void> : IAnyValue {
        pub pure fn is_success() -> bool;
        pub pure op ? () -> TOk;
    }

    ICoalesceOperator<TOut: IAnyValue> : IAnyValue {
        pub pure op ?? (fallback: TOut) -> TOut;
    }

    ISplatOperator<TSeq: IAnyValue> : IAnyValue {
        pub pure fn unpack() -> TSeq;
    }

    IPairsOperator<TPairs: IAnyValue> : IAnyValue {
        pub pure fn unpack_pairs() -> TPairs;
    }

    IFlattenOperator<TLeaf: IAnyValue> : IAnyValue {
        pub pure fn flat() -> slice<TLeaf>;
    }

    // 6. Zero-Allocation Value-Type Iteration & Collection Capabilities
    // These contracts say what a type can do, not how it holds memory, so
    // they are lattice-neutral (`: IAnyValue`): an inline `array` (0b00), a
    // borrowed `slice` (0b01) and an owned `List` (0b10) are all lists.
    // Section 7 binds them to one lattice root each.
    IEnumerator<TItem: IAnyValue> : IAnyValue {
        pub var fn move_next() -> bool;
        pub current: TItem { get; }
    }

    IEnumerable<TItem: IAnyValue, TEnum: IEnumerator<TItem>> : IAnyValue {
        pub pure fn get_enumerator() -> TEnum;
    }

    /// A finite group of items that can be counted and searched.
    IReadOnlyCollection<TItem: IAnyValue> : IAnyValue {
        pub count:    usize { get; }
        pub is_empty: bool  { get => .count == 0; }
        pub pure fn contains(item: TItem) -> bool;
    }

    /// A collection items can be added to and cleared from.
    ICollection<TItem: IAnyValue> : IReadOnlyCollection<TItem> {
        pub var:
            fn add(item: TItem);
            fn clear();
    }

    /// Items in order, read by position.
    IReadOnlyList<TItem: IAnyValue> : IReadOnlyCollection<TItem>, IIndexGet<usize, TItem> {}

    /// A fixed number of items in order, each of which can be replaced.
    IWritableList<TItem: IAnyValue> : IReadOnlyList<TItem>, IIndexSet<usize, TItem> {}

    /// Items in order that can grow and shrink.
    IList<TItem: IAnyValue> : ICollection<TItem>, IWritableList<TItem> {
        /// Removes and returns the item at `index`.
        pub var fn remove_at(index: usize) -> TItem;
    }

    /// Items taken out in the order they were put in.
    IQueue<TItem: IAnyValue> : IReadOnlyCollection<TItem> {
        pub var:
            /// Puts `item` at the back; false when the queue is full.
            fn enqueue(item: TItem) -> bool;
            /// Takes the front item; none when the queue is empty.
            fn dequeue() -> option<TItem>;
    }

    /// Values looked up by key.
    IReadOnlyDictionary<TKey: IEquatable<TKey>, TVal: IAnyValue> : IIndexGet<TKey, TVal> {
        pub count:    usize { get; }
        pub is_empty: bool  { get => .count == 0; }
        pub pure fn has(key: TKey) -> bool;
        pub pure fn get(key: TKey) -> option<TVal>;
    }

    /// Values looked up by key that can be set and removed.
    IDictionary<TKey: IEquatable<TKey>, TVal: IAnyValue> : IReadOnlyDictionary<TKey, TVal>, IIndexSet<TKey, TVal> {
        pub var:
            fn set(key: TKey, val: TVal);
            /// Removes `key`; false when it was not there.
            fn remove(key: TKey) -> bool;
            fn clear();
    }

    // 7. Lattice Roles: one capability contract bound to one lattice root.
    // A concrete collection names its role and gets its lattice through it;
    // it names `IValue`, `IReference` or `IObject` itself only when no role
    // fits (a bounds pair such as `range` is just a value).
    /// A fixed-length list stored inline (0b00): `array`.
    IInlineList<TItem: IAnyValue> : IWritableList<TItem>, IValue {}

    /// A borrowed window over items someone else owns (0b01): `slice`,
    /// `stride`, `str`.
    IView<TItem: IAnyValue> : IReadOnlyList<TItem>, IReference {}

    /// A borrowed position moving over a sequence (0b01): the enumerators
    /// and streams.
    ICursor<TItem: IAnyValue> : IEnumerator<TItem>, IReference {}

    /// An owned list that can grow (0b10): `List`, `SliceBuffer`, `ListBuffer`.
    IBuffer<TItem: IAnyValue> : IList<TItem>, IObject {}

    /// A borrowed key-value projection (0b01): `map`.
    IDictionaryView<TKey: IEquatable<TKey>, TVal: IAnyValue> : IReadOnlyDictionary<TKey, TVal>, IReference {}

    /// An owned dictionary (0b10): `Map`, `MapBuffer`.
    IDictionaryBuffer<TKey: IEquatable<TKey>, TVal: IAnyValue> : IDictionary<TKey, TVal>, IObject {}
}
