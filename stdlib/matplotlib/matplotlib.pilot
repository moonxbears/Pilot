pub pkg Pilot.Matplotlib;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// ============================================================================
// 1. Plot Data Object
// ============================================================================

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __fs_write_text(path: str, content: str) -> any;
}

fn _repeat_str(ch: str, count: i64) -> str {
    if count <= 0 {
        return "";
    }
    var out: str = "";
    for _i in 0..<count {
        out = out + ch;
    }
    return out;
}

pub struct PlotData : IValue {
    pub:
        x:      f64[];
        y:      f64[];
        label:  str;
        marker: str;
        color:  str;
        kind:   str;

        self(x: f64[], y: f64[], label: str = "", marker: str = "*", color: str = "blue", kind: str = "line") {
            self.x = x;
            self.y = y;
            self.label = label;
            self.marker = marker;
            self.color = color;
            self.kind = kind;
        }
}

// ============================================================================
// 2. Figure (Canvas & Rendering Engine)
// ============================================================================

pub struct Figure : IValue {
    pub:
        width:       i64;
        height:      i64;
        title_str:   str;
        xlabel_str:  str;
        ylabel_str:  str;
        show_grid:   bool;
        show_legend: bool;
        plots:       PlotData[];

        self(width: i64 = 60, height: i64 = 15) {
            self.width = width;
            self.height = height;
            self.title_str = "";
            self.xlabel_str = "";
            self.ylabel_str = "";
            self.show_grid = false;
            self.show_legend = false;
            self.plots = [];
        }

        var fn add_plot(p: PlotData) {
            self.plots.append(p);
        }

        var fn clear() {
            self.title_str = "";
            self.xlabel_str = "";
            self.ylabel_str = "";
            self.show_grid = false;
            self.show_legend = false;
            self.plots = [];
        }

        fn get_bounds() -> f64[] {
            var min_x: f64 = 0.0;
            var max_x: f64 = 1.0;
            var min_y: f64 = 0.0;
            var max_y: f64 = 1.0;
            var first: bool = true;

            for p in self.plots {
                for vx in p.x {
                    if first || vx < min_x { min_x = vx; }
                    if first || vx > max_x { max_x = vx; }
                }
                for vy in p.y {
                    if first || vy < min_y { min_y = vy; }
                    if first || vy > max_y { max_y = vy; }
                    first = false;
                }
            }

            if min_x == max_x { max_x = min_x + 1.0; }
            if min_y == max_y { max_y = min_y + 1.0; }

            return [min_x, max_x, min_y, max_y];
        }

        /// Renders the figure as an ASCII chart for headless/terminal environments.
        fn render_ascii() -> str {
            let bounds = self.get_bounds();
            let min_x: f64 = bounds[0];
            let max_x: f64 = bounds[1];
            let min_y: f64 = bounds[2];
            let max_y: f64 = bounds[3];

            let w: i64 = self.width;
            let h: i64 = self.height;

            // Initialize 2D grid
            var grid_rows: str[][] = [];
            for r in 0..<h {
                var row_chars: str[] = [];
                for c in 0..<w {
                    if self.show_grid && (r % 4 == 0 || c % 10 == 0) {
                        row_chars.append(".");
                    } else {
                        row_chars.append(" ");
                    }
                }
                grid_rows.append(row_chars);
            }

            // Plot points
            for p in self.plots {
                let n: i64 = min(len(p.x), len(p.y));
                let m_char: str = if len(p.marker) > 0 { p.marker[0..1] } else { "*" };
                for i in 0..<n {
                    let px: f64 = p.x[i];
                    let py: f64 = p.y[i];

                    let col: i64 = i64(((px - min_x) / (max_x - min_x)) * f64(w - 1));
                    let row: i64 = i64(((max_y - py) / (max_y - min_y)) * f64(h - 1));

                    if row >= 0 && row < h && col >= 0 && col < w {
                        grid_rows[row][col] = m_char;
                    }
                }
            }

            // Format output
            var out: str = "";
            if len(self.title_str) > 0 {
                out = out + "        " + self.title_str + "\n";
            }

            for r in 0..<h {
                let y_val: f64 = max_y - (f64(r) / f64(h - 1)) * (max_y - min_y);
                var row_s: str = "";
                for c in 0..<w {
                    row_s = row_s + grid_rows[r][c];
                }
                out = out + f"{y_val} | " + row_s + "\n";
            }

            // X-axis border
            out = out + "       +" + _repeat_str("-", w) + "\n";
            out = out + f"        {min_x}" + _repeat_str(" ", w - 15) + f"{max_x}\n";

            if len(self.xlabel_str) > 0 {
                out = out + "        " + self.xlabel_str + "\n";
            }

            if self.show_legend && len(self.plots) > 0 {
                out = out + "\nLegend:\n";
                for p in self.plots {
                    if len(p.label) > 0 {
                        out = out + f"  [{p.marker}] {p.label} ({p.color})\n";
                    }
                }
            }

            return out;
        }

        /// Renders the figure as vector SVG markup.
        fn render_svg() -> str {
            let bounds = self.get_bounds();
            let min_x: f64 = bounds[0];
            let max_x: f64 = bounds[1];
            let min_y: f64 = bounds[2];
            let max_y: f64 = bounds[3];

            let svg_w: i64 = 600;
            let svg_h: i64 = 400;
            let pad: i64 = 50;
            let plot_w: i64 = svg_w - 2 * pad;
            let plot_h: i64 = svg_h - 2 * pad;

            var svg: str = f"<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{svg_w}\" height=\"{svg_h}\">\n";
            svg = svg + f"  <rect width=\"100%\" height=\"100%\" fill=\"#ffffff\" />\n";

            // Title
            if len(self.title_str) > 0 {
                svg = svg + f"  <text x=\"{svg_w / 2}\" y=\"30\" text-anchor=\"middle\" font-family=\"sans-serif\" font-size=\"16\" font-weight=\"bold\">{self.title_str}</text>\n";
            }

            // Axes
            svg = svg + f"  <line x1=\"{pad}\" y1=\"{pad + plot_h}\" x2=\"{pad + plot_w}\" y2=\"{pad + plot_h}\" stroke=\"#333333\" stroke-width=\"2\" />\n";
            svg = svg + f"  <line x1=\"{pad}\" y1=\"{pad}\" x2=\"{pad}\" y2=\"{pad + plot_h}\" stroke=\"#333333\" stroke-width=\"2\" />\n";

            // Plots
            for p in self.plots {
                let n: i64 = min(len(p.x), len(p.y));
                if p.kind == "line" && n > 1 {
                    var pts: str = "";
                    for i in 0..<n {
                        let cx: f64 = f64(pad) + ((p.x[i] - min_x) / (max_x - min_x)) * f64(plot_w);
                        let cy: f64 = f64(pad + plot_h) - ((p.y[i] - min_y) / (max_y - min_y)) * f64(plot_h);
                        pts = pts + f"{cx},{cy} ";
                    }
                    svg = svg + f"  <polyline fill=\"none\" stroke=\"{p.color}\" stroke-width=\"2\" points=\"{pts}\" />\n";
                }
                // Scatter dots
                for i in 0..<n {
                    let cx: f64 = f64(pad) + ((p.x[i] - min_x) / (max_x - min_x)) * f64(plot_w);
                    let cy: f64 = f64(pad + plot_h) - ((p.y[i] - min_y) / (max_y - min_y)) * f64(plot_h);
                    svg = svg + f"  <circle cx=\"{cx}\" cy=\"{cy}\" r=\"3\" fill=\"{p.color}\" />\n";
                }
            }

            svg = svg + "</svg>\n";
            return svg;
        }

        fn savefig(filename: str) {
            if filename.ends_with(".svg") {
                let content: str = self.render_svg();
                __fs_write_text(filename, content);
            } else {
                let content: str = self.render_ascii();
                __fs_write_text(filename, content);
            }
        }
}

// ============================================================================
// 3. Functional Pyplot Interface (Python: matplotlib.pyplot)
// ============================================================================

var _CURRENT_FIG: Figure = Figure(60, 15);

pub fn figure(figsize: i64[] = [60, 15]) -> Figure {
    _CURRENT_FIG = Figure(figsize[0], figsize[1]);
    return _CURRENT_FIG;
}

pub fn plot(x: any, y: any = none, label: str = "", marker: str = "*", color: str = "blue") {
    var xs: f64[] = [];
    var ys: f64[] = [];

    if y == none {
        // x represents y values, x values are 0..n
        let t_x: str = type_of(x);
        let items = if t_x == "object" { x.data } else { x };
        for i in 0..<len(items) {
            xs.append(f64(i));
            ys.append(f64(items[i]));
        }
    } else {
        let t_x: str = type_of(x);
        let items_x = if t_x == "object" { x.data } else { x };
        let t_y: str = type_of(y);
        let items_y = if t_y == "object" { y.data } else { y };
        let count: i64 = min(len(items_x), len(items_y));
        for i in 0..<count {
            xs.append(f64(items_x[i]));
            ys.append(f64(items_y[i]));
        }
    }

    _CURRENT_FIG.add_plot(PlotData(xs, ys, label, marker, color, "line"));
}

pub fn scatter(x: any, y: any, label: str = "", marker: str = "o", color: str = "red") {
    var xs: f64[] = [];
    var ys: f64[] = [];
    let items_x = if type_of(x) == "object" { x.data } else { x };
    let items_y = if type_of(y) == "object" { y.data } else { y };
    let count: i64 = min(len(items_x), len(items_y));
    for i in 0..<count {
        xs.append(f64(items_x[i]));
        ys.append(f64(items_y[i]));
    }
    _CURRENT_FIG.add_plot(PlotData(xs, ys, label, marker, color, "scatter"));
}

pub fn bar(categories: any[], values: any[], label: str = "", color: str = "green") {
    var xs: f64[] = [];
    var ys: f64[] = [];
    for i in 0..<len(categories) {
        xs.append(f64(i));
        ys.append(f64(values[i]));
    }
    _CURRENT_FIG.add_plot(PlotData(xs, ys, label, "|", color, "bar"));
}

pub fn hist(data: any, bins: i64 = 10, label: str = "", color: str = "purple") {
    let items = if type_of(data) == "object" { data.data } else { data };
    if len(items) == 0 {
        return;
    }
    var min_v: f64 = f64(items[0]);
    var max_v: f64 = f64(items[0]);
    for v in items {
        let fv: f64 = f64(v);
        if fv < min_v { min_v = fv; }
        if fv > max_v { max_v = fv; }
    }
    if min_v == max_v { max_v = min_v + 1.0; }

    var bin_counts: f64[] = [];
    for _i in 0..<bins { bin_counts.append(0.0); }

    let bin_w: f64 = (max_v - min_v) / f64(bins);
    for v in items {
        let fv: f64 = f64(v);
        var b_idx: i64 = i64((fv - min_v) / bin_w);
        if b_idx >= bins { b_idx = bins - 1; }
        if b_idx < 0 { b_idx = 0; }
        bin_counts[b_idx] = bin_counts[b_idx] + 1.0;
    }

    var xs: f64[] = [];
    for i in 0..<bins {
        xs.append(min_v + f64(i) * bin_w);
    }
    _CURRENT_FIG.add_plot(PlotData(xs, bin_counts, label, "#", color, "hist"));
}

pub fn title(label: str) {
    _CURRENT_FIG.title_str = label;
}

pub fn xlabel(label: str) {
    _CURRENT_FIG.xlabel_str = label;
}

pub fn ylabel(label: str) {
    _CURRENT_FIG.ylabel_str = label;
}

pub fn grid(enable: bool = true) {
    _CURRENT_FIG.show_grid = enable;
}

pub fn legend() {
    _CURRENT_FIG.show_legend = true;
}

pub fn show() {
    let output: str = _CURRENT_FIG.render_ascii();
    print(output);
}

pub fn savefig(filename: str) {
    _CURRENT_FIG.savefig(filename);
}

pub fn clf() {
    _CURRENT_FIG.clear();
}
