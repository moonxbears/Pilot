// High-performance JSON serialization and deserialization implementing RFC-8259.
//
// Target OS Platforms:
//   - Linux (x86_64, aarch64, riscv64)
//   - Windows (x86_64, aarch64)
//   - macOS (Apple Silicon arm64, Intel x86_64)
//   - Android (aarch64, armv7, x86_64)
//   - iOS (arm64)
//   - WebAssembly (wasm32-wasi, wasm32-unknown)

pub pkg Pilot.Json;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Core.Meta.*;
use Pilot.Formats.*;
use Pilot.Io.Fs as std_fs;

// Native runtime FFI fallbacks
extern "c" lib "pilot_rt" {
    fn __fs_read_text(path: str) -> any;
    fn __fs_write_text(path: str, content: str) -> any;
}

// =========================================================================
// 1. JSON ATTRIBUTES & SERIALIZATION INTERFACES
// =========================================================================

pub struct {
    /// Marker attribute for structs eligible for hierarchical JSON serialization.
    /// Usage: `[JsonObject]` or `[JsonObject(naming_policy: "camelCase")]`
    [Layout(c_abi)]
    JsonObjectAttr : IAttribute, IValue {
        pub:
            naming_policy: str;
            ignore_null:   bool;
            weight:        i32;

            static pure fn create() -> JsonObjectAttr => JsonObjectAttr {
                naming_policy: "camelCase",
                ignore_null:   false,
                weight:        10,
            };
    }

    /// Generic attribute indicating a type is serializable to/from JSON.
    /// Usage: `[JsonSerializable]`
    [Layout(c_abi)]
    JsonSerializableAttr : IAttribute, IValue {
        pub:
            weight: i32;

            static pure fn create() -> JsonSerializableAttr => JsonSerializableAttr {
                weight: 10,
            };
    }

    /// Attribute designating a property or field to be serialized into JSON.
    /// Usage: `[JsonProperty("fieldName")]` or `[JsonProperty]`
    [Layout(c_abi)]
    JsonPropertyAttr : IAttribute, IValue {
        pub:
            name:     str;
            ignore:   bool;
            required: bool;
            weight:   i32;

            static pure fn named(name: str) -> JsonPropertyAttr => JsonPropertyAttr {
                name:     name,
                ignore:   false,
                required: false,
                weight:   10,
            };
    }

    /// Attribute for excluding a property or field from JSON serialization.
    /// Usage: `[JsonIgnore]`
    [Layout(c_abi)]
    JsonIgnoreAttr : IAttribute, IValue {
        pub:
            weight: i32;

            static pure fn create() -> JsonIgnoreAttr => JsonIgnoreAttr {
                weight: 10,
            };
    }

    // =========================================================================
    // 2. ERROR TYPES
    // =========================================================================

    /// Error value raised when JSON decoding fails.
    /// Python reference: json.JSONDecodeError(msg, doc, pos)
    JSONDecodeError : IValue {
        pub:
            msg:    str;
            doc:    str;
            pos:    i64;
            lineno: i64;
            colno:  i64;

            self(msg: str, doc: str = "", pos: i64 = 0, lineno: i64 = 1, colno: i64 = 1) {
                .msg = msg;
                .doc = doc;
                .pos = pos;
                .lineno = lineno;
                .colno = colno;
            }

            fn to_string() -> str {
                return f"JSONDecodeError: {self.msg} (line {self.lineno} column {self.colno} char {self.pos})";
            }
    }

    // =========================================================================
    // 3. EXTENSIBLE ENCODER & DECODER SUITES
    // =========================================================================

    /// Extensible JSON decoder struct.
    /// Python reference: json.JSONDecoder(*, object_hook=None, parse_float=None, parse_int=None, parse_constant=None, strict=True, object_pairs_hook=None)
    JSONDecoder : IValue {
        pub:
            strict_unique_keys: bool;

            self(strict_unique_keys: bool = false) {
                .strict_unique_keys = strict_unique_keys;
            }

            fn decode(s: str) -> any ! JSONDecodeError {
                return loads(s, self.strict_unique_keys);
            }
    }

    /// Extensible JSON encoder struct.
    /// Python reference: json.JSONEncoder(*, skipkeys=False, ensure_ascii=True, check_circular=True, sort_keys=False, indent=None, separators=None, default=None)
    JSONEncoder : IValue {
        pub:
            indent:    i64;
            sort_keys: bool;

            self(indent: i64 = -1, sort_keys: bool = false) {
                .indent = indent;
                .sort_keys = sort_keys;
            }

            fn encode(obj: any) -> str {
                return dumps(obj, self.indent, self.sort_keys);
            }
    }
}

/// Contract for types that emit their own formatted JSON representation.
pub interface IJsonSerializable : IValue {
    pub fn emit_json(indent: i64) -> str;
}

// =========================================================================
// 4. CORE SERIALIZATION & DESERIALIZATION APIS
// =========================================================================

/// Deserializes a JSON string into native Pilot data types (map, list, str, i64, f64, bool, none).
/// Python reference: json.loads(s, *, cls=None, object_hook=None, parse_float=None, parse_int=None, parse_constant=None, object_pairs_hook=None, **kw)
pub fn loads(s: str, strict_unique_keys: bool = false) -> any ! JSONDecodeError {
    let parse_res = json_parse(s, strict_unique_keys);
    switch parse_res {
        case ok(val):
            return ok(val);
        case fail(err): {
            switch err {
                case ParseError.Syntax(_, msg, ln, cl):
                    return fail(JSONDecodeError(msg, s, 0, ln, cl));
                case ParseError.PrematureEof(_, ln, cl):
                    return fail(JSONDecodeError("Unexpected end of JSON input", s, 0, ln, cl));
                case ParseError.BadEscape(_, seq, ln, cl):
                    return fail(JSONDecodeError(f"Invalid escape sequence: {seq}", s, 0, ln, cl));
                case ParseError.BadNumber(_, raw, ln, cl):
                    return fail(JSONDecodeError(f"Invalid JSON number: {raw}", s, 0, ln, cl));
                case ParseError.DuplicateKey(_, key, ln, cl):
                    return fail(JSONDecodeError(f"Duplicate object key: {key}", s, 0, ln, cl));
            }
        }
    }
}

/// Serializes an object hierarchy or IJsonSerializable value to a JSON formatted string.
/// Python reference: json.dumps(obj, *, skipkeys=False, ensure_ascii=True, check_circular=True, allow_nan=True, cls=None, indent=None, separators=None, default=None, sort_keys=False, **kw)
pub fn dumps(obj: any, indent: i64 = -1, sort_keys: bool = false) -> str {
    let pretty: bool = indent >= 0;
    let spaces: i64 = if indent >= 0 { indent } else { 2 };
    return json_stringify(obj, pretty, spaces);
}

/// Deserializes JSON from a filesystem path or file reader.
/// Python reference: json.load(fp, *, cls=None, object_hook=None, parse_float=None, parse_int=None, parse_constant=None, object_pairs_hook=None, **kw)
pub fn load(file_path: str, strict_unique_keys: bool = false) -> any ! JSONDecodeError {
    let text_res = std_fs.read_text(file_path);
    if __result_is_err(text_res) {
        return fail(JSONDecodeError(f"Failed to read file: {file_path}", "", 0, 1, 1));
    }
    let content: str = __result_unwrap_ok(text_res);
    return loads(content, strict_unique_keys);
}

/// Serializes an object as a JSON formatted stream and writes it to a file.
/// Python reference: json.dump(obj, fp, *, skipkeys=False, ensure_ascii=True, check_circular=True, allow_nan=True, cls=None, indent=None, separators=None, default=None, sort_keys=False, **kw)
pub fn dump(obj: any, file_path: str, indent: i64 = -1, sort_keys: bool = false) -> bool {
    let content = dumps(obj, indent, sort_keys);
    let write_res = std_fs.write_text(file_path, content);
    return !__result_is_err(write_res);
}

/// Queries a nested JSON document using a dotted path syntax (e.g. "data.users.0.name").
pub fn get_path(doc: any, dotted_path: str) -> any {
    return json_get_path(doc, dotted_path);
}
