// SPDX-License-Identifier: MIT AND PSF-2.0
// std.sys — System-specific parameters and functions across Linux, Windows, macOS, Android, iOS
// Modeled after Python's `sys` module (CPython Lib/sys scaffold)

// ============================================================================
// 1. Command-Line Arguments (Python: sys.argv)
// ============================================================================

def argv() -> [str] {
    return __sys_argv();
}

def get_args() -> [str] {
    return argv();
}

def argc() -> i64 {
    return len(argv());
}

// ============================================================================
// 2. Platform & Target Architecture (Python: sys.platform, sys.byteorder)
// ============================================================================

def platform() -> str {
    if __os_is_windows() {
        return "win32";
    } elif __os_is_macos() {
        return "darwin";
    } elif __os_is_android() {
        return "android";
    } elif __os_is_ios() {
        return "ios";
    } elif __os_is_linux() {
        return "linux";
    }
    return __os_platform();
}

def arch() -> str {
    let a = __os_arch();
    if len(a) > 0 {
        return a;
    }
    return "x86_64";
}

def byteorder() -> str {
    let bo = __sys_byteorder();
    if len(bo) > 0 {
        return bo;
    }
    return "little";
}

def pointer_size() -> i64 {
    let ps = __sys_pointer_size();
    if ps > 0 {
        return ps;
    }
    return 8;
}

def is_64bit() -> bool {
    return pointer_size() == 8;
}

def is_32bit() -> bool {
    return pointer_size() == 4;
}

def is_little_endian() -> bool {
    return byteorder() == "little";
}

def is_big_endian() -> bool {
    return byteorder() == "big";
}

// ============================================================================
// 3. Process Execution & Control (Python: sys.exit)
// ============================================================================

def exit(code: i64 = 0) -> void {
    __sys_exit(code);
}

def abort() -> void {
    __os_abort();
}

// ============================================================================
// 4. Pilot Version & Implementation (Python: sys.version, sys.version_info)
// ============================================================================

def version() -> str {
    return "1.1.51";
}

def version_info() -> [i64] {
    return [1, 1, 51];
}

def compiler() -> str {
    return "Pilot Native AOT (C11/LLVM/PilVM v3)";
}

def executable() -> str {
    let exe = __sys_executable();
    if len(exe) > 0 {
        return exe;
    }
    return "pilot";
}

// ============================================================================
// 5. Standard Streams & File Descriptors (Python: sys.stdin, sys.stdout, sys.stderr)
// ============================================================================

def stdin_fileno() -> i64 {
    return 0;
}

def stdout_fileno() -> i64 {
    return 1;
}

def stderr_fileno() -> i64 {
    return 2;
}

def write_stdout(text: str) -> void {
    print(text);
}

def write_stderr(text: str) -> void {
    print(text);
}

// ============================================================================
// 6. Integer & Float Numerical Limits (Python: sys.maxsize)
// ============================================================================

def maxsize() -> i64 {
    return 9223372036854775807; // i64::MAX
}

def minsize() -> i64 {
    return -9223372036854775807 - 1; // i64::MIN
}

def float_max() -> float {
    return 1.7976931348623157e+308;
}

def float_min() -> float {
    return 2.2250738585072014e-308;
}

def float_eps() -> float {
    return 2.220446049250313e-16;
}
