// SPDX-License-Identifier: MIT AND PSF-2.0
// std.sys — System-specific parameters and functions across Linux, Windows, macOS, Android, iOS
// Modeled after Python's `sys` module (CPython Lib/sys scaffold)

pub pkg Pilot.Sys;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// ============================================================================
// 1. Command-Line Arguments (Python: sys.argv)
// ============================================================================

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __sys_argv() -> str[];
    fn __sys_exit(code: i64);
    fn __sys_executable() -> str;
    fn __sys_pointer_size() -> i64;
    fn __sys_byteorder() -> str;
    fn __os_platform() -> str;
    fn __os_arch() -> str;
    fn __os_is_windows() -> bool;
    fn __os_is_linux() -> bool;
    fn __os_is_macos() -> bool;
    fn __os_is_android() -> bool;
    fn __os_is_ios() -> bool;
    fn __os_abort();
}

pub fn argv() -> str[] {
    return __sys_argv();
}

pub fn get_args() -> str[] {
    return argv();
}

pub fn argc() -> i64 {
    return len(argv());
}

// ============================================================================
// 2. Platform & Target Architecture (Python: sys.platform, sys.byteorder)
// ============================================================================

pub fn platform() -> str {
    if __os_is_windows() {
        return "win32";
    } else if __os_is_macos() {
        return "darwin";
    } else if __os_is_android() {
        return "android";
    } else if __os_is_ios() {
        return "ios";
    } else if __os_is_linux() {
        return "linux";
    }
    return __os_platform();
}

pub fn arch() -> str {
    let a = __os_arch();
    if len(a) > 0 {
        return a;
    }
    return "x86_64";
}

pub fn byteorder() -> str {
    let bo = __sys_byteorder();
    if len(bo) > 0 {
        return bo;
    }
    return "little";
}

pub fn pointer_size() -> i64 {
    let ps = __sys_pointer_size();
    if ps > 0 {
        return ps;
    }
    return 8;
}

pub fn is_64bit() -> bool {
    return pointer_size() == 8;
}

pub fn is_32bit() -> bool {
    return pointer_size() == 4;
}

pub fn is_little_endian() -> bool {
    return byteorder() == "little";
}

pub fn is_big_endian() -> bool {
    return byteorder() == "big";
}

// ============================================================================
// 3. Process Execution & Control (Python: sys.exit)
// ============================================================================

pub fn exit(code: i64 = 0) -> void {
    __sys_exit(code);
}

pub fn abort() -> void {
    __os_abort();
}

// ============================================================================
// 4. Pilot Version & Implementation (Python: sys.version, sys.version_info)
// ============================================================================

pub fn version() -> str {
    return "1.1.51";
}

pub fn version_info() -> i64[] {
    return [1, 1, 51];
}

pub fn compiler() -> str {
    return "Pilot Native AOT (C11/LLVM/PilVM v3)";
}

pub fn executable() -> str {
    let exe = __sys_executable();
    if len(exe) > 0 {
        return exe;
    }
    return "pilot";
}

// ============================================================================
// 5. Standard Streams & File Descriptors (Python: sys.stdin, sys.stdout, sys.stderr)
// ============================================================================

pub fn stdin_fileno() -> i64 {
    return 0;
}

pub fn stdout_fileno() -> i64 {
    return 1;
}

pub fn stderr_fileno() -> i64 {
    return 2;
}

pub fn write_stdout(text: str) -> void {
    print(text);
}

pub fn write_stderr(text: str) -> void {
    print(text);
}

// ============================================================================
// 6. Integer & Float Numerical Limits (Python: sys.maxsize)
// ============================================================================

pub fn maxsize() -> i64 {
    return 9223372036854775807; // i64::MAX
}

pub fn minsize() -> i64 {
    return -9223372036854775807 - 1; // i64::MIN
}

pub fn float_max() -> f64 {
    return 1.7976931348623157e+308;
}

pub fn float_min() -> f64 {
    return 2.2250738585072014e-308;
}

pub fn float_eps() -> f64 {
    return 2.220446049250313e-16;
}
