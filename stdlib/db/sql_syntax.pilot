// =========================================================================
// FILE: stdlib/db/sql_syntax.pilot
// OPT-IN NATIVE DATABASE, TRANSACTION & LINQ/SQL QUERY SYNTAX PACKAGE
// =========================================================================
pub pkg Pilot.Db.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    __engine("bind_receptor", nameof(database), 33, 1);
    __engine("bind_receptor", nameof(from),     33, 6);
    __engine("bind_receptor", nameof(select),   33, 7);

    __engine("register_pratt_op", nameof(union),     infix, 12, left);
    __engine("register_pratt_op", nameof(intersect), infix, 14, left);
    __engine("register_pratt_op", nameof(except),    infix, 12, left);
}

pub struct TransactionState : IValue {
    pub is_active: bool;
    pub savepoints: i64;
}

pub var global_tx_state: TransactionState = TransactionState { is_active: false, savepoints: 0 };

pub fn tx_begin() -> bool {
    global_tx_state.is_active = true;
    return true;
}

pub fn tx_commit() -> bool {
    let was = global_tx_state.is_active;
    global_tx_state.is_active = false;
    global_tx_state.savepoints = 0;
    return was;
}

pub fn tx_rollback() -> bool {
    let was = global_tx_state.is_active;
    global_tx_state.is_active = false;
    global_tx_state.savepoints = 0;
    return was;
}

pub fn tx_savepoint(name: str) -> i64 {
    global_tx_state.savepoints = global_tx_state.savepoints + 1;
    return global_tx_state.savepoints;
}

pub syntax {
    transaction(body) => quote {
        {
            tx_begin();
            $body;
            tx_commit();
        }
    };

    savepoint(name) => quote { tx_savepoint($name) };
    commit()        => quote { tx_commit() };
    rollback()      => quote { tx_rollback() };
}
