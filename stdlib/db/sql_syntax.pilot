// =========================================================================
// FILE: stdlib/db/sql_syntax.pilot
// OPT-IN NATIVE DATABASE, TRANSACTION & LINQ/SQL QUERY SYNTAX PACKAGE
// =========================================================================
pub pkg Pilot.Db.Syntax;

use Pilot.Core.Genesis.*;
use Pilot.Core.Bridge.Lang;
use Pilot.Core.Operators.Shapes;

// `database` and the statement words `connect`, `insert`, `update` and
// `delete` are not built yet (docs/keyword_roadmap.md K9).
// Each rule reads the construct past (`Rest`: up to a `;`, or through the
// block it opens) and stops the build at the seam `keyword.unbuilt`
// (PROP-009 section 13). The word starts the construct only when a name, a
// literal or `{` (for `database`, or `[`) follows it; elsewhere it is an
// ordinary name (tests/conformance/types/unbuilt_words_as_names, _2).
pub syntax {
    database $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `database` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    database [ $r:Rest ] => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `database` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    connect $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `connect` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    insert $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `insert` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    update $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `update` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    delete $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `delete` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
}

// A query over a sequence (PROP-009; was crates/pilot-parser/src/query.rs):
// `from x in xs where cond order by key [ascending|descending], .. select e`
// is the list of `e` for each `x` of `xs`, in order, that every `where`
// holds for. With `order`, the kept elements are sorted first by a stable
// insertion sort on the keys, the first key that differs deciding; `order`,
// `ascending` and `descending` stay ordinary names outside a query.
// `if $order` and an empty `where` list are decided when the rule expands.
// `x in xs` and `where` are the shared clauses `Iteration` and `Filter`
// (stdlib/core/syntax/clauses.pilot): `$x`, `$src` and each `$c` come from them.
pub syntax {
    from $it:Iteration $( $f:Filter )*
        $( order $( by )? $( $k:Expr $( ascending )? $( descending )? ),* )?
        select $e:Expr
    => quote {
        if $order {
            var items = for $x in $src {
                if $c && true { yield $x; }
            };
            var i = 1;
            while i < items.len() {
                var j = i;
                while j > 0 {
                    // One block per key, chained by `&&`: while the keys
                    // tie the next one is compared; the first that differs
                    // sets `c` to 1 (after) or -1 (before).
                    var c = 0;
                    let tied = {
                        let ka = { let $x = items[j - 1]; $k };
                        let kb = { let $x = items[j]; $k };
                        if ka != kb {
                            if (ka > kb) != $descending { c = 1; } else { c = -1; }
                        }
                        c == 0
                    } && true;
                    if tied || c < 0 { break; }
                    let t = items[j - 1];
                    items[j - 1] = items[j];
                    items[j] = t;
                    j = j - 1;
                }
                i = i + 1;
            }
            let out = for $x in items { yield $e; };
            out
        } else {
            for $x in $src {
                if $c && true { yield $e; }
            }
        }
    };
}

// The query clauses `into` and `values` (K9) are not built yet: a query
// that writes one stops at the same seam; outside a query each is an
// ordinary name.
pub syntax {
    from $it:Iteration $( $f:Filter )* into $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `into` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    from $it:Iteration $( $f:Filter )* values $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `values` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
}

// The set operators over sequences (stdlib/db/set_ops.pilot). `intersect`
// binds tighter than `union` and `except`, as in SQL.
pub syntax {
    [Infix(::Or, ::Left, nameof(union))]
    seq_union_of(lhs, rhs) => quote { seq_union($lhs, $rhs) };
    [Infix(::And, ::Left, nameof(intersect))]
    seq_intersect_of(lhs, rhs) => quote { seq_intersect($lhs, $rhs) };
    [Infix(::Or, ::Left, nameof(except))]
    seq_except_of(lhs, rhs) => quote { seq_except($lhs, $rhs) };
}

// `transaction`, `commit`, `rollback` and `savepoint` are not built yet
// (docs/keyword_roadmap.md phase K9). Each rule stops at its seam instead of
// flipping a flag that undid nothing (audit 2.3).
pub syntax {
    transaction $body:Block => quote {
        seam("data.transaction", "running a block as one transaction needs storage whose writes can be undone (an in-memory `Table<T>` first)")
    };
    savepoint ( $name:Expr ) => quote {
        seam("data.savepoint", "a savepoint needs a transaction log to roll back to")
    };
    savepoint $name:Expr => quote {
        seam("data.savepoint", "a savepoint needs a transaction log to roll back to")
    };
    commit ( ) => quote {
        seam("data.commit", "committing needs a transaction whose writes are held until commit")
    };
    rollback ( ) => quote {
        seam("data.rollback", "rolling back needs a transaction log that restores what the transaction wrote")
    };
}
