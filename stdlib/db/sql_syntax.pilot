// =========================================================================
// FILE: stdlib/db/sql_syntax.pilot
// OPT-IN NATIVE DATABASE, TRANSACTION & LINQ/SQL QUERY SYNTAX PACKAGE
// =========================================================================
pub pkg Pilot.Db.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    // `database` is registered but not built yet (docs/keyword_roadmap.md
    // K9): receptor 40 stops every use at the seam `keyword.unbuilt`.
    __engine("bind_receptor", nameof(database), 40, 0);
    // Not built yet (docs/keyword_roadmap.md K9): statements stop at the
    // seam `keyword.unbuilt` where a statement starts (place 1), and clause
    // words where a query clause stands (place 2); elsewhere each is an
    // ordinary name (`values`, `order`, `update(x)`).
    __engine("bind_receptor", nameof(connect),    40, 1);
    __engine("bind_receptor", nameof(insert),     40, 1);
    __engine("bind_receptor", nameof(update),     40, 1);
    __engine("bind_receptor", nameof(delete),     40, 1);
    __engine("bind_receptor", nameof(into),       40, 2);
    __engine("bind_receptor", nameof(values),     40, 2);
    __engine("bind_receptor", nameof(order),      40, 2);
    __engine("bind_receptor", nameof(ascending),  40, 2);
    __engine("bind_receptor", nameof(descending), 40, 2);
    __engine("bind_receptor", nameof(from),     33, 6);
    __engine("bind_receptor", nameof(select),   33, 7);

    __engine("register_pratt_op", nameof(union),     infix, 12, left);
    __engine("register_pratt_op", nameof(intersect), infix, 14, left);
    __engine("register_pratt_op", nameof(except),    infix, 12, left);
}

// `transaction`, `commit`, `rollback` and `savepoint` are not built yet
// (docs/keyword_roadmap.md phase K9). Each rule stops at its seam instead of
// flipping a flag that undid nothing (audit 2.3).
pub syntax {
    transaction(body) => quote {
        seam("data.transaction", "running a block as one transaction needs storage whose writes can be undone (an in-memory `Table<T>` first)")
    };
    savepoint(name) => quote {
        seam("data.savepoint", "a savepoint needs a transaction log to roll back to")
    };
    commit() => quote {
        seam("data.commit", "committing needs a transaction whose writes are held until commit")
    };
    rollback() => quote {
        seam("data.rollback", "rolling back needs a transaction log that restores what the transaction wrote")
    };
}
