// ============================================================================
// FILE: stdlib/db/sql_engine.pilot
// Milestone 58.4: Embedded Relational SQL Query Planner & Executor
// Implements `CREATE TABLE`, `INSERT INTO`, `SELECT` (`WHERE`, `JOIN ... ON`,
// `ORDER BY ASC/DESC`), `UPDATE`, and `DELETE` in pure Pilot.
// ============================================================================

pub struct SqlQueryPlan {
    pub table_name: str;
    pub projection_cols: str;
    pub where_predicate: str;
    pub sql_statement: str;
}

pub fn build_sql_select_plan(
    table_name: str,
    projection_cols: str,
    where_predicate: str
) -> SqlQueryPlan {
    let base = "SELECT " + projection_cols + " FROM " + table_name;
    let stmt = if __engine("str_len", where_predicate) > 0 {
        base + " WHERE " + where_predicate + ";"
    } else {
        base + ";"
    };
    return SqlQueryPlan {
        table_name: table_name,
        projection_cols: projection_cols,
        where_predicate: where_predicate,
        sql_statement: stmt,
    };
}

pub pure fn sql_trim(s: str) -> str {
    let n = __engine("str_len", s);
    var a = 0;
    while a < n {
        let b = __engine("str_byte_at", s, a);
        if b == 32 || b == 9 || b == 10 || b == 13 || b == 59 {
            a = a + 1;
        } else {
            break;
        }
    }
    var e = n;
    while e > a {
        let b = __engine("str_byte_at", s, e - 1);
        if b == 32 || b == 9 || b == 10 || b == 13 || b == 59 {
            e = e - 1;
        } else {
            break;
        }
    }
    return __engine("str_slice", s, a, e);
}

pub pure fn sql_unquote(s: str) -> str {
    let t = sql_trim(s);
    let n = __engine("str_len", t);
    if n >= 2 {
        let b0 = __engine("str_byte_at", t, 0);
        let b1 = __engine("str_byte_at", t, n - 1);
        if (b0 == 39 && b1 == 39) || (b0 == 34 && b1 == 34) {
            return __engine("str_slice", t, 1, n - 1);
        }
    }
    return t;
}

pub pure fn sql_first_word(s: str) -> str {
    let t = sql_trim(s);
    let n = __engine("str_len", t);
    var i = 0;
    while i < n {
        let b = __engine("str_byte_at", t, i);
        if b == 32 || b == 9 || b == 40 {
            break;
        }
        i = i + 1;
    }
    return __engine("str_slice", t, 0, i);
}

pub pure fn sql_find_sub(hay: str, needle: str, from_idx: i64) -> i64 {
    let nh = __engine("str_len", hay);
    let nn = __engine("str_len", needle);
    if nn <= 0 || nn > nh {
        return -1;
    }
    let limit = nh - nn;
    var i = from_idx;
    while i <= limit {
        if __engine("str_slice", hay, i, i + nn) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub pure fn sql_is_int_str(s: str) -> bool {
    let t = sql_trim(s);
    let n = __engine("str_len", t);
    if n == 0 { return false; }
    var i = 0;
    if __engine("str_byte_at", t, 0) == 45 {
        if n == 1 { return false; }
        i = 1;
    }
    while i < n {
        let b = __engine("str_byte_at", t, i);
        if b < 48 || b > 57 {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub pure fn sql_parse_int(s: str) -> i64 {
    let t = sql_trim(s);
    let n = __engine("str_len", t);
    if n == 0 { return 0; }
    var sign = 1;
    var i = 0;
    if __engine("str_byte_at", t, 0) == 45 {
        sign = -1;
        i = 1;
    }
    var v = 0;
    while i < n {
        let b = __engine("str_byte_at", t, i);
        if b >= 48 && b <= 57 {
            v = (v * 10) + (b - 48);
        }
        i = i + 1;
    }
    return v * sign;
}

pub fn sql_split_csv(s: str) -> i64 {
    let m = __engine("map_new");
    let n = __engine("str_len", s);
    var cnt = 0;
    var start = 0;
    var in_q = 0;
    var i = 0;
    while i <= n {
        let b = if i < n { __engine("str_byte_at", s, i) } else { 44 };
        if b == 39 && in_q == 0 {
            in_q = 1;
        } else if b == 39 && in_q == 1 {
            in_q = 0;
        } else if b == 44 && in_q == 0 {
            let item = sql_trim(__engine("str_slice", s, start, i));
            __engine("map_set", m, cnt, item);
            cnt = cnt + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    __engine("map_set", m, "cnt", cnt);
    return m;
}

pub fn sql_db_new() -> i64 {
    let db = __engine("map_new");
    __engine("map_set", db, "ok", 1);
    return db;
}

pub fn sql_exec_create_table(db: i64, q_str: str) -> str {
    let p_open = sql_find_sub(q_str, "(", 0);
    let p_close = sql_find_sub(q_str, ")", p_open + 1);
    let tname = sql_trim(__engine("str_slice", q_str, 12, p_open));
    let cols_csv = __engine("str_slice", q_str, p_open + 1, p_close);
    let parts = sql_split_csv(cols_csv);
    let n = __engine("map_get", parts, "cnt") + 0;
    __engine("map_set", db, "t_" + tname + "_ncols", n);
    __engine("map_set", db, "t_" + tname + "_nrows", 0);
    var i = 0;
    while i < n {
        let col_def = "" + __engine("map_get", parts, i);
        let col_name = sql_first_word(col_def);
        __engine("map_set", db, "t_" + tname + "_col_" + i, col_name);
        i = i + 1;
    }
    return "OK";
}

pub fn sql_exec_insert(db: i64, q_str: str) -> str {
    let v_idx = sql_find_sub(q_str, "VALUES", 0);
    let tname = sql_trim(__engine("str_slice", q_str, 11, v_idx));
    let p_open = sql_find_sub(q_str, "(", v_idx);
    let p_close = sql_find_sub(q_str, ")", p_open + 1);
    let vals_csv = __engine("str_slice", q_str, p_open + 1, p_close);
    let vals = sql_split_csv(vals_csv);
    let ncols = __engine("map_get", db, "t_" + tname + "_ncols") + 0;
    let r_idx = __engine("map_get", db, "t_" + tname + "_nrows") + 0;
    __engine("map_set", db, "t_" + tname + "_nrows", r_idx + 1);
    __engine("map_set", db, "t_" + tname + "_r_" + r_idx + "_alive", 1);

    var ci = 0;
    while ci < ncols {
        let cname = "" + __engine("map_get", db, "t_" + tname + "_col_" + ci);
        let v_str = sql_unquote("" + __engine("map_get", vals, ci));
        __engine("map_set", db, "t_" + tname + "_r_" + r_idx + "_" + cname, v_str);
        ci = ci + 1;
    }
    return "OK";
}

pub fn sql_build_row_map(db: i64, tname: str, r_idx: i64, target_map: i64) -> i64 {
    let ncols = __engine("map_get", db, "t_" + tname + "_ncols") + 0;
    var ci = 0;
    while ci < ncols {
        let cname = "" + __engine("map_get", db, "t_" + tname + "_col_" + ci);
        let v = "" + __engine("map_get", db, "t_" + tname + "_r_" + r_idx + "_" + cname);
        __engine("map_set", target_map, cname, v);
        __engine("map_set", target_map, tname + "." + cname, v);
        ci = ci + 1;
    }
    return target_map;
}

pub pure fn sql_eval_single_pred(row_m: i64, pred_raw: str) -> bool {
    let pred = sql_trim(pred_raw);
    if __engine("str_len", pred) == 0 {
        return true;
    }
    var cmp_op = "=";
    var op_pos = sql_find_sub(pred, ">=", 0);
    var op_len = 2;
    if op_pos >= 0 {
        cmp_op = ">=";
    } else {
        op_pos = sql_find_sub(pred, "<=", 0);
        if op_pos >= 0 {
            cmp_op = "<=";
        } else {
            op_pos = sql_find_sub(pred, "!=", 0);
            if op_pos >= 0 {
                cmp_op = "!=";
            } else {
                op_len = 1;
                op_pos = sql_find_sub(pred, ">", 0);
                if op_pos >= 0 {
                    cmp_op = ">";
                } else {
                    op_pos = sql_find_sub(pred, "<", 0);
                    if op_pos >= 0 {
                        cmp_op = "<";
                    } else {
                        op_pos = sql_find_sub(pred, "=", 0);
                        cmp_op = "=";
                    }
                }
            }
        }
    }
    if op_pos < 0 {
        return true;
    }
    let lhs_col = sql_trim(__engine("str_slice", pred, 0, op_pos));
    let rhs_raw = sql_trim(__engine("str_slice", pred, op_pos + op_len, __engine("str_len", pred)));
    let lhs_val = "" + __engine("map_get", row_m, lhs_col);
    let rhs_val = sql_unquote(rhs_raw);

    if sql_is_int_str(lhs_val) && sql_is_int_str(rhs_val) {
        let li = sql_parse_int(lhs_val);
        let ri = sql_parse_int(rhs_val);
        if cmp_op == "=" { return li == ri; }
        if cmp_op == "!=" { return li != ri; }
        if cmp_op == ">=" { return li >= ri; }
        if cmp_op == "<=" { return li <= ri; }
        if cmp_op == ">" { return li > ri; }
        if cmp_op == "<" { return li < ri; }
    }
    if cmp_op == "=" { return lhs_val == rhs_val; }
    if cmp_op == "!=" { return lhs_val != rhs_val; }
    if cmp_op == ">=" { return lhs_val >= rhs_val; }
    if cmp_op == "<=" { return lhs_val <= rhs_val; }
    if cmp_op == ">" { return lhs_val > rhs_val; }
    if cmp_op == "<" { return lhs_val < rhs_val; }
    return false;
}

pub pure fn sql_eval_where(row_m: i64, where_clause: str) -> bool {
    let w = sql_trim(where_clause);
    let n = __engine("str_len", w);
    if n == 0 {
        return true;
    }
    var pos = 0;
    while pos < n {
        let and_idx = sql_find_sub(w, " AND ", pos);
        let seg_end = if and_idx >= 0 { and_idx } else { n };
        let seg = __engine("str_slice", w, pos, seg_end);
        if !sql_eval_single_pred(row_m, seg) {
            return false;
        }
        if and_idx < 0 {
            break;
        }
        pos = and_idx + 5;
    }
    return true;
}

pub fn sql_exec_update(db: i64, q_str: str) -> str {
    let set_idx = sql_find_sub(q_str, " SET ", 0);
    let w_idx = sql_find_sub(q_str, " WHERE ", set_idx);
    let tname = sql_trim(__engine("str_slice", q_str, 6, set_idx));
    let set_end = if w_idx >= 0 { w_idx } else { __engine("str_len", q_str) };
    let assign_s = sql_trim(__engine("str_slice", q_str, set_idx + 5, set_end));
    let eq_idx = sql_find_sub(assign_s, "=", 0);
    let set_col = sql_trim(__engine("str_slice", assign_s, 0, eq_idx));
    let set_val = sql_unquote(__engine("str_slice", assign_s, eq_idx + 1, __engine("str_len", assign_s)));
    let where_s = if w_idx >= 0 { sql_trim(__engine("str_slice", q_str, w_idx + 7, __engine("str_len", q_str))) } else { "" };

    let nrows = __engine("map_get", db, "t_" + tname + "_nrows") + 0;
    var r = 0;
    while r < nrows {
        if (__engine("map_get", db, "t_" + tname + "_r_" + r + "_alive") + 0) == 1 {
            let rm = __engine("map_new");
            sql_build_row_map(db, tname, r, rm);
            if sql_eval_where(rm, where_s) {
                __engine("map_set", db, "t_" + tname + "_r_" + r + "_" + set_col, set_val);
            }
        }
        r = r + 1;
    }
    return "OK";
}

pub fn sql_exec_delete(db: i64, q_str: str) -> str {
    let w_idx = sql_find_sub(q_str, " WHERE ", 0);
    let t_end = if w_idx >= 0 { w_idx } else { __engine("str_len", q_str) };
    let tname = sql_trim(__engine("str_slice", q_str, 11, t_end));
    let where_s = if w_idx >= 0 { sql_trim(__engine("str_slice", q_str, w_idx + 7, __engine("str_len", q_str))) } else { "" };

    let nrows = __engine("map_get", db, "t_" + tname + "_nrows") + 0;
    var r = 0;
    while r < nrows {
        if (__engine("map_get", db, "t_" + tname + "_r_" + r + "_alive") + 0) == 1 {
            let rm = __engine("map_new");
            sql_build_row_map(db, tname, r, rm);
            if sql_eval_where(rm, where_s) {
                __engine("map_set", db, "t_" + tname + "_r_" + r + "_alive", 0);
            }
        }
        r = r + 1;
    }
    return "OK";
}

pub fn sql_exec_select(db: i64, q_str: str) -> str {
    let from_idx = sql_find_sub(q_str, " FROM ", 0);
    let proj_s = sql_trim(__engine("str_slice", q_str, 6, from_idx));
    let proj_cols = sql_split_csv(proj_s);
    let nproj = __engine("map_get", proj_cols, "cnt") + 0;

    let join_idx = sql_find_sub(q_str, " JOIN ", from_idx);
    let where_idx = sql_find_sub(q_str, " WHERE ", from_idx);
    let order_idx = sql_find_sub(q_str, " ORDER BY ", from_idx);
    let qlen = __engine("str_len", q_str);

    let from_end = if join_idx >= 0 {
        join_idx
    } else if where_idx >= 0 {
        where_idx
    } else if order_idx >= 0 {
        order_idx
    } else {
        qlen
    };
    let t1 = sql_trim(__engine("str_slice", q_str, from_idx + 6, from_end));

    var t2 = "";
    var join_lhs = "";
    var join_rhs = "";
    if join_idx >= 0 {
        let on_idx = sql_find_sub(q_str, " ON ", join_idx);
        let join_end = if where_idx >= 0 { where_idx } else if order_idx >= 0 { order_idx } else { qlen };
        t2 = sql_trim(__engine("str_slice", q_str, join_idx + 6, on_idx));
        let on_cond = sql_trim(__engine("str_slice", q_str, on_idx + 4, join_end));
        let eq_p = sql_find_sub(on_cond, "=", 0);
        join_lhs = sql_trim(__engine("str_slice", on_cond, 0, eq_p));
        join_rhs = sql_trim(__engine("str_slice", on_cond, eq_p + 1, __engine("str_len", on_cond)));
    }

    var where_s = "";
    if where_idx >= 0 {
        let w_end = if order_idx >= 0 { order_idx } else { qlen };
        where_s = sql_trim(__engine("str_slice", q_str, where_idx + 7, w_end));
    }

    var order_col = "";
    var order_desc = 0;
    if order_idx >= 0 {
        let ord_raw = sql_trim(__engine("str_slice", q_str, order_idx + 10, qlen));
        let desc_p = sql_find_sub(ord_raw, " DESC", 0);
        let asc_p = sql_find_sub(ord_raw, " ASC", 0);
        if desc_p >= 0 {
            order_col = sql_trim(__engine("str_slice", ord_raw, 0, desc_p));
            order_desc = 1;
        } else if asc_p >= 0 {
            order_col = sql_trim(__engine("str_slice", ord_raw, 0, asc_p));
            order_desc = 0;
        } else {
            order_col = ord_raw;
        }
    }

    // Collect candidate rows into `cand_list`
    let cand_list = __engine("map_new");
    var cand_cnt = 0;
    let nrows1 = __engine("map_get", db, "t_" + t1 + "_nrows") + 0;
    var r1 = 0;
    while r1 < nrows1 {
        if (__engine("map_get", db, "t_" + t1 + "_r_" + r1 + "_alive") + 0) == 1 {
            if __engine("str_len", t2) > 0 {
                let nrows2 = __engine("map_get", db, "t_" + t2 + "_nrows") + 0;
                var r2 = 0;
                while r2 < nrows2 {
                    if (__engine("map_get", db, "t_" + t2 + "_r_" + r2 + "_alive") + 0) == 1 {
                        let rm = __engine("map_new");
                        sql_build_row_map(db, t1, r1, rm);
                        sql_build_row_map(db, t2, r2, rm);
                        let lv = "" + __engine("map_get", rm, join_lhs);
                        let rv = "" + __engine("map_get", rm, join_rhs);
                        if lv == rv {
                            if sql_eval_where(rm, where_s) {
                                __engine("map_set", cand_list, cand_cnt, rm);
                                cand_cnt = cand_cnt + 1;
                            }
                        }
                    }
                    r2 = r2 + 1;
                }
            } else {
                let rm = __engine("map_new");
                sql_build_row_map(db, t1, r1, rm);
                if sql_eval_where(rm, where_s) {
                    __engine("map_set", cand_list, cand_cnt, rm);
                    cand_cnt = cand_cnt + 1;
                }
            }
        }
        r1 = r1 + 1;
    }

    // Optional ORDER BY sorting
    if __engine("str_len", order_col) > 0 && cand_cnt > 1 {
        var i = 0;
        while i < cand_cnt {
            var j = i + 1;
            while j < cand_cnt {
                let ri_m = __engine("map_get", cand_list, i) + 0;
                let rj_m = __engine("map_get", cand_list, j) + 0;
                let vi = "" + __engine("map_get", ri_m, order_col);
                let vj = "" + __engine("map_get", rj_m, order_col);
                var swap = false;
                if sql_is_int_str(vi) && sql_is_int_str(vj) {
                    let ni = sql_parse_int(vi);
                    let nj = sql_parse_int(vj);
                    swap = if order_desc == 1 { nj > ni } else { nj < ni };
                } else {
                    swap = if order_desc == 1 { vj > vi } else { vj < vi };
                }
                if swap {
                    __engine("map_set", cand_list, i, rj_m);
                    __engine("map_set", cand_list, j, ri_m);
                }
                j = j + 1;
            }
            i = i + 1;
        }
    }

    // Format projected rows
    var out = "";
    var ri = 0;
    while ri < cand_cnt {
        let rm = __engine("map_get", cand_list, ri) + 0;
        if ri > 0 {
            out = out + "\n";
        }
        var pi = 0;
        while pi < nproj {
            let pcol = "" + __engine("map_get", proj_cols, pi);
            if pi > 0 {
                out = out + "|";
            }
            out = out + __engine("map_get", rm, pcol);
            pi = pi + 1;
        }
        ri = ri + 1;
    }
    return out;
}

pub fn sql_exec(db: i64, sql: str) -> str {
    let q_str = sql_trim(sql);
    let kw = sql_first_word(q_str);
    if kw == "CREATE" {
        return sql_exec_create_table(db, q_str);
    }
    if kw == "INSERT" {
        return sql_exec_insert(db, q_str);
    }
    if kw == "UPDATE" {
        return sql_exec_update(db, q_str);
    }
    if kw == "DELETE" {
        return sql_exec_delete(db, q_str);
    }
    if kw == "SELECT" {
        return sql_exec_select(db, q_str);
    }
    return "OK";
}
