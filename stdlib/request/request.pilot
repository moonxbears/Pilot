// std.request — High-Level Multi-OS HTTP Client Library
// Modeled after Python's `requests` package & `urllib.request`
// Compatible with Linux, Windows, macOS, Android, iOS, and WebAssembly targets.

pub pkg Pilot.Request;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Urllib as urllib;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __net_http_get(url: str) -> any;
    fn __net_http_post(url: str, body: str, content_type: str) -> any;
}

fn _parse_i64_or(val: any, fallback: i64) -> i64 {
    let opt = __parse_int_strict(str(val), 10);
    if __opt_is_some(opt) {
        return __opt_unwrap(opt);
    }
    return fallback;
}

// ============================================================================
// 1. Exceptions & Errors (Python: requests.exceptions)
// ============================================================================

pub struct RequestException : IValue {
    pub:
        message: str;
        args:    str[];

        self(message: str = "") {
            .message = message;
            .args = [message];
        }

        fn to_str() -> str {
            return f"<RequestException: {self.message}>";
        }
}

pub struct HTTPError : IValue {
    pub:
        message:  str;
        response: any;
        args:     str[];

        self(message: str = "", response: any = none) {
            .message = message;
            .response = response;
            .args = [message];
        }

        fn to_str() -> str {
            return f"<HTTPError: {self.message}>";
        }
}

pub struct ConnectionError : IValue {
    pub:
        message: str;
        args:    str[];

        self(message: str = "") {
            .message = message;
            .args = [message];
        }

        fn to_str() -> str {
            return f"<ConnectionError: {self.message}>";
        }
}

pub struct Timeout : IValue {
    pub:
        message: str;
        args:    str[];

        self(message: str = "") {
            .message = message;
            .args = [message];
        }

        fn to_str() -> str {
            return f"<Timeout: {self.message}>";
        }
}

pub struct TooManyRedirects : IValue {
    pub:
        message: str;

        self(message: str = "") {
            .message = message;
        }
}

pub struct URLRequired : IValue {
    pub:
        message: str;

        self(message: str = "A valid URL is required") {
            .message = message;
        }
}

// ============================================================================
// 2. HTTP Response Object (Python: requests.Response)
// ============================================================================

pub struct Response : IValue {
    pub:
        url:         str;
        status_code: i64;
        reason:      str;
        headers:     map;
        content:     str;
        text:        str;
        encoding:    str;
        ok:          bool;
        is_ok:       bool;
        cookies:     map;

        self(url: str, status_code: i64, reason: str, headers: map, content: str) {
            let ok_flag: bool = (status_code >= 200 && status_code < 400);
            .url = url;
            .status_code = status_code;
            .reason = reason;
            .headers = headers;
            .content = content;
            .text = content;
            .encoding = "utf-8";
            .ok = ok_flag;
            .is_ok = ok_flag;
            .cookies = {};
            ._parse_cookies();
        }

        var fn _parse_cookies() {
            for k in self.headers.keys() {
                if k.to_lower() == "set-cookie" {
                    let cookie_str = str(self.headers[k]);
                    let parts: str[] = cookie_str.split(";");
                    if len(parts) > 0 {
                        let eq = parts[0].index_of("=");
                        if eq >= 0 {
                            let ck = parts[0][0..eq].trim();
                            let cv = parts[0][(eq + 1)..len(parts[0])].trim();
                            self.cookies[ck] = cv;
                        }
                    }
                }
            }
        }

        fn get_header(name: str, default_val: str = "") -> str {
            let lower = name.to_lower();
            for k in self.headers.keys() {
                if k.to_lower() == lower {
                    return str(self.headers[k]);
                }
            }
            return default_val;
        }

        fn raise_for_status() -> bool ! HTTPError {
            if self.status_code >= 400 && self.status_code < 500 {
                return fail(HTTPError(f"Client Error: {self.status_code} {self.reason} for url: {self.url}", self));
            } else if self.status_code >= 500 && self.status_code < 600 {
                return fail(HTTPError(f"Server Error: {self.status_code} {self.reason} for url: {self.url}", self));
            }
            return ok(true);
        }

        fn to_str() -> str {
            return f"<Response [{self.status_code}]>";
        }
}

// ============================================================================
// 3. HTTP Client Session (Python: requests.Session)
// ============================================================================

pub struct Session : IObject {
    pub:
        headers: map;
        cookies: map;
        auth:    any;
        timeout: f64;

        self() {
            var default_hdrs: map = {};
            default_hdrs["User-Agent"] = "Pilot-Requests/1.1.0";
            default_hdrs["Accept-Encoding"] = "identity";
            default_hdrs["Accept"] = "*/*";
            default_hdrs["Connection"] = "keep-alive";
            .headers = default_hdrs;
            .cookies = {};
            .auth = none;
            .timeout = 30.0;
        }

        ~self() {
            .close();
        }

        var fn request(
            method: str,
            url: str,
            params: any = none,
            data: any = none,
            json: any = none,
            headers: map = {},
            timeout: f64 = -1.0
        ) -> Response {
            var req_url = url;
            if params != none {
                let qs = urllib.urlencode(params);
                if len(qs) > 0 {
                    if req_url.contains("?") {
                        req_url = req_url + "&" + qs;
                    } else {
                        req_url = req_url + "?" + qs;
                    }
                }
            }

            var req_headers: map = {};
            for k in self.headers.keys() {
                req_headers[k] = self.headers[k];
            }
            for k in headers.keys() {
                req_headers[k] = headers[k];
            }

            // Add cookies
            if len(self.cookies) > 0 {
                var cookie_str = "";
                var first = true;
                for ck in self.cookies.keys() {
                    if !first { cookie_str = cookie_str + "; "; }
                    cookie_str = cookie_str + ck + "=" + str(self.cookies[ck]);
                    first = false;
                }
                req_headers["Cookie"] = cookie_str;
            }

            var body_str = "";
            var content_type = "application/x-www-form-urlencoded";

            if json != none {
                content_type = "application/json";
                body_str = str(json);
                req_headers["Content-Type"] = content_type;
            } else if data != none {
                if type_of(data) == "map" {
                    body_str = urllib.urlencode(data);
                    req_headers["Content-Type"] = "application/x-www-form-urlencoded";
                } else {
                    body_str = str(data);
                }
            }

            let m = method.to_upper();
            var resp_map: any = 0;

            if m == "POST" || m == "PUT" || m == "PATCH" {
                resp_map = __net_http_post(req_url, body_str, content_type);
            } else {
                resp_map = __net_http_get(req_url);
            }

            var status: i64 = 200;
            var reason: str = "OK";
            var r_headers: map = {};
            var body: str = "";

            if type_of(resp_map) == "map" {
                if resp_map.contains_key("status") { status = _parse_i64_or(resp_map["status"], 200); }
                if resp_map.contains_key("reason") { reason = str(resp_map["reason"]); }
                if resp_map.contains_key("headers") { r_headers = resp_map["headers"]; }
                if resp_map.contains_key("body") { body = str(resp_map["body"]); }
            }

            let response = Response(req_url, status, reason, r_headers, body);

            // Update session cookies from response
            for ck in response.cookies.keys() {
                self.cookies[ck] = response.cookies[ck];
            }

            return response;
        }

        var fn get_req(url: str, params: any = none, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("GET", url, params, none, none, headers, timeout);
        }

        var fn post(url: str, data: any = none, json: any = none, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("POST", url, none, data, json, headers, timeout);
        }

        var fn put(url: str, data: any = none, json: any = none, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("PUT", url, none, data, json, headers, timeout);
        }

        var fn patch(url: str, data: any = none, json: any = none, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("PATCH", url, none, data, json, headers, timeout);
        }

        var fn delete(url: str, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("DELETE", url, none, none, none, headers, timeout);
        }

        var fn head(url: str, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("HEAD", url, none, none, none, headers, timeout);
        }

        var fn options(url: str, headers: map = {}, timeout: f64 = -1.0) -> Response {
            return self.request("OPTIONS", url, none, none, none, headers, timeout);
        }

        var fn close() {
            // Clear session state
            self.cookies = {};
        }
}

// ============================================================================
// 4. Functional Request API (Python: requests.get, requests.post, etc.)
// ============================================================================

pub fn session() -> Session {
    return Session();
}

pub fn request(
    method: str,
    url: str,
    params: any = none,
    data: any = none,
    json: any = none,
    headers: map = {},
    timeout: f64 = 30.0
) -> Response {
    var s = Session();
    return s.request(method, url, params, data, json, headers, timeout);
}

pub fn get_req(url: str, params: any = none, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.get_req(url, params, headers, timeout);
}

pub fn post(url: str, data: any = none, json: any = none, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.post(url, data, json, headers, timeout);
}

pub fn put(url: str, data: any = none, json: any = none, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.put(url, data, json, headers, timeout);
}

pub fn patch(url: str, data: any = none, json: any = none, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.patch(url, data, json, headers, timeout);
}

pub fn delete(url: str, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.delete(url, headers, timeout);
}

pub fn head(url: str, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.head(url, headers, timeout);
}

pub fn options(url: str, headers: map = {}, timeout: f64 = 30.0) -> Response {
    var s = Session();
    return s.options(url, headers, timeout);
}
