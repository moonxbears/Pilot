// Ring 3: Compiler-as-a-Library Formatter (pub pkg pilot.fmt;)
// Dual compact/readable syntax pairing transformations
// ==============================================================================
pub pkg pilot.fmt;

use std.text;

pub enum FmtStyle : u8 {
    ::Compact = 0,
    ::Readable = 1,
    ::Preserve = 2,
}

pub pure fn fmt_style_compact()  -> u8 => 0;
pub pure fn fmt_style_readable() -> u8 => 1;
pub pure fn fmt_style_preserve() -> u8 => 2;

pub fn str_replace(src: str, target: str, replacement: str) -> str {
    var out: List<str> = [];
    var p: usize = 0;
    let n = src.len();
    let m = target.len();
    if m == 0 { return src; }
    while p < n {
        let idx = src.find(target, p);
        if idx < 0 {
            out.push(src.slice(p, n));
            break;
        }
        out.push(src.slice(p, idx as usize) + replacement);
        p = (idx as usize) + m;
    }
    return join_text(out, "");
}

/// Rewrites `src` into `style`, swapping every compact/readable pairing
/// (`f!^(x)` <-> `sig f(x)`, `T?` <-> `opt<T>`, ..) while keeping trivia.
pub fn format_str(src: str, style: u8) -> str {
    return seam("pilot_fmt.format_str", "style rewriting needs the lossless CST and the M4 pairing table");
}
