// ==============================================================================
// FILE: stdlib/pilot/diag.pilot
// Ring 3: Compiler-as-a-Library Diagnostics Facade (pub pkg pilot.diag;)
// Human ANSI formatting, machine-readable JSON, and SARIF 2.1.0 report generation
// ==============================================================================
pub pkg pilot.diag;

use std.text;

[Layout(c_abi)]
pub struct Span : IValue {
    pub file_id: u32;
    pub start:   u32;
    pub end:     u32;
}

pub pure fn span_new(fid: u32, st: u32, ed: u32) -> Span => Span { file_id: fid, start: st, end: ed };

[Layout(c_abi)]
pub struct TextEdit : IValue {
    pub span:        Span;
    pub replacement: str;
}

pub pure fn text_edit_new(span: Span, repl: str) -> TextEdit => TextEdit { span: span, replacement: repl };

/// How sure a fix is: applied by `--fix`, offered with holes to fill, or
/// a guess the user confirms.
pub enum FixApplicability : u8 {
    MachineApplicable,
    HasPlaceholders,
    MaybeIncorrect,
}

/// How serious a diagnostic is (the JSON and SARIF reports write the value).
pub enum DiagSeverity : u8 {
    Error = 1,
    Warning = 2,
    Info = 3,
    Hint = 4,
}

pub struct FixSuggestion : IObject {
    pub title:         str;
    pub applicability: FixApplicability;
    pub edits:         List<TextEdit>;

    ~self() {}
}

pub fn fix_suggestion_new(title: str, app: FixApplicability) -> FixSuggestion {
    return FixSuggestion {
        title:         title,
        applicability: app,
        edits:         [],
    };
}

pub struct Diagnostic : IObject {
    pub code:     str;
    pub severity: DiagSeverity;
    pub message:  str;
    pub span:     Span;
    pub notes:    List<str>;
    pub fixes:    List<FixSuggestion>;

    ~self() {}
}

pub fn diagnostic_new(code: str, sev: DiagSeverity, msg: str, sp: Span) -> Diagnostic {
    return Diagnostic {
        code:     code,
        severity: sev,
        message:  msg,
        span:     sp,
        notes:    [],
        fixes:    [],
    };
}

pub pure fn diagnostic_is_error(diag: Diagnostic) -> bool => diag.severity == DiagSeverity::Error;

pub fn render_ansi(diag: Diagnostic, source: str) -> str {
    let sev_str = if diag.severity == DiagSeverity::Error { "\x1b[1;31merror\x1b[0m" }
                  else if diag.severity == DiagSeverity::Warning { "\x1b[1;33mwarning\x1b[0m" }
                  else { "\x1b[1;34minfo\x1b[0m" };
    var preview = "";
    if source.len() > 0 && (diag.span.end as usize) <= source.len() {
        preview = " --> " + source.slice(diag.span.start, diag.span.end);
    }
    return sev_str + " [" + diag.code + "]: " + diag.message + preview;
}

pub fn render_json(diag: Diagnostic) -> str {
    return "{\"code\":\"" + diag.code + "\",\"severity\":" + (diag.severity as u8) + ",\"message\":\"" + diag.message + "\"}";
}

pub fn render_sarif(diags: List<Diagnostic>) -> str {
    var out: List<str> = ["{\"version\":\"2.1.0\",\"runs\":[{\"results\":["];
    var i = 0;
    while i < diags.len {
        let d = diags[i];
        out.push("{\"ruleId\":\"" + d.code + "\",\"message\":{\"text\":\"" + d.message + "\"}}");
        if i + 1 < diags.len {
            out.push(",");
        }
        i = i + 1;
    }
    out.push("]}]}");
    return join_text(out, "");
}
