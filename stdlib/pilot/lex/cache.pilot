// ==============================================================================
// FILE: stdlib/pilot/lex/cache.pilot
// Ring 3: built lexers kept on disk (pub pkg pilot.lex.cache;)
// ==============================================================================
// Building a lexer (patterns -> NFA -> DFA -> minimized tables, `build_modes`)
// takes seconds on the seed (6.5 s for the Unicode name table alone,
// 2026-11-16) and minutes on the PilIR interpreter, and gives the same tables every time for the same token
// declarations. `build_modes_cached` keeps what it built in a directory
// (`target/cache/lex` by convention) and reads it back the next time:
//   - the key is the declarations themselves, written out as text (each
//     mode's name, and per token its name, priority, start condition, role,
//     mode change and pattern ops), plus the hash of the builder's own
//     sources (`BUILDER_SOURCES`), so a change to any declaration or to the
//     builder is a different key and a stale lexer is never read. When the
//     builder's sources are not found from the working directory (a program
//     run outside the toolchain's tree), nothing is cached;
//   - the file is named after the key's 64-bit FNV-1a hash
//     (`core.derive.string_hash`) and holds the whole key, so two keys with
//     the same hash never share a file's tables;
//   - a file is written under a name of its own and then renamed into
//     place (`File.rename`), so a reader never sees half of one, even when
//     several programs build the same lexer at once;
//   - a lexer whose build reported errors is not kept, and a file that does
//     not read back is built again;
//   - a mode whose automaton is an earlier mode's (the f-string hole mode
//     has the main mode's tokens; only its braces' mode changes differ) is
//     written as `shares <that mode>` with only its actions after it, which
//     halves the file (the main table's transitions alone are 784 kB).
pub pkg pilot.lex.cache;

use Pilot.Core.File;
use Pilot.Core.Lex.Patterns;
use core.derive;
use std.text;
use pilot.lex.build;
use pilot.lex.modes;

/// The first line of a cache file; a file with another is built again.
pub const CACHE_FORMAT: str = "pilot-lex-cache 4";
/// Where programs of this toolchain keep built lexers.
pub const LEX_CACHE_DIR: str = "target/cache/lex";

/// The files whose code decides what a built lexer holds.
const BUILDER_SOURCES: List<str> = ["stdlib/pilot/lex/build.pilot", "stdlib/pilot/lex/modes.pilot", "stdlib/pilot/lex/cache.pilot",];

/// The line of a key that names the builder: the hash of its sources, or ""
/// when one of them is not found.
fn builder_line() -> str {
    var b = StrBuilder();
    for f in BUILDER_SOURCES {
        if !File.exists(f) { return ""; }
        b += File.read_text(f);
    }
    return f"builder {hex64(string_hash(b.to_string()))}\n";
}

/// The token roles and start conditions in a fixed order, read and written
/// by position.
const ROLES: List<TokenRole> = [TokenRole::Plain, TokenRole::Operand, TokenRole::Space, TokenRole::Trivia,];
const WHENS: List<TokenWhen> = [TokenWhen::Always, TokenWhen::Spaced, TokenWhen::Glued, TokenWhen::AtStart,];
const PAT_KINDS: List<PatKind> = [PatKind::Bytes, PatKind::Seq, PatKind::Alt, PatKind::Opt, PatKind::Many,];

fn role_index(r: TokenRole) -> i64 {
    for i in 0 .. ROLES.len() {
        if ROLES[i] == r { return i; }
    }
    return -1;
}

fn when_index(w: TokenWhen) -> i64 {
    for i in 0 .. WHENS.len() {
        if WHENS[i] == w { return i; }
    }
    return -1;
}

fn kind_index(k: PatKind) -> i64 {
    for i in 0 .. PAT_KINDS.len() {
        if PAT_KINDS[i] == k { return i; }
    }
    return -1;
}

/// A name written as one word: `=` then the name, so an empty one is `=`.
fn word(name: str) -> str => "=" + name;

/// Whether `name` can be written as one word (no space or line break).
fn plain(name: str) -> bool {
    for i in 0 .. name.len() {
        let b = name.byte_at(i) as i64;
        if b == 32 || b == 10 || b == 13 || b == 9 { return false; }
    }
    return true;
}

/// The declarations of `modes` and the builder as text, or "" when a name
/// cannot be written as one word or the builder's sources are not found
/// (such a lexer is not kept).
pub fn modes_key(ref modes: List<LexMode>) -> str {
    let builder = builder_line();
    if builder == "" { return ""; }
    var b = StrBuilder();
    b += builder;
    for m in modes {
        if !plain(m.name) { return ""; }
        b += f"mode {word(m.name)}\n";
        for t in m.tokens {
            if !plain(t.name) || !plain(t.enters) { return ""; }
            b += f"tok {word(t.name)} {t.priority} {when_index(t.when)} {role_index(t.role)} {word(t.enters)} {if t.leaves { 1 } else { 0 }} {t.trails}";
            for o in t.pattern.ops {
                b += f" {kind_index(o.kind)} {o.lo} {o.hi} {o.n}";
            }
            b += "\n";
        }
    }
    return b.to_string();
}

/// The labelled lines of a cache file after its key text, in the order
/// `lexer_text` writes them and `read_lexer` reads them. Each field's text
/// (`field as str`) is the word that starts its line, so the writer and the
/// reader cannot disagree (a text enum, PROP-032).
pub enum CacheField : u8 {
    Key = "key",
    Modes = "modes",
    Bases = "bases",
    ModeOf = "mode_of",
    Enters = "enters",
    Shares = "shares",
    Names = "names",
    ClassOf = "class_of",
    Size = "size",
    Starts = "starts",
    Next = "next",
    Accept = "accept",
    Actions = "actions",
    EntersMode = "enters_mode",
}

/// `h` as 16 lowercase hex digits.
pub fn hex64(h: u64) -> str {
    let digits = "0123456789abcdef";
    var out = "";
    var v = h;
    for i in 0 .. 16 {
        out = digits.slice((v % 16) as i64, (v % 16) as i64 + 1) + out;
        v = v / 16;
    }
    return out;
}

/// The cache file in `dir` for the declarations `key`.
pub fn cache_file(dir: str, key: str) -> str => f"{dir}/{hex64(string_hash(key))}.lex";

/// `label`, the count of `xs`, then `xs`, as one line; a run of one value
/// is written once, as `value*times` (a table's transitions are mostly runs
/// of -1: 247,118 numbers in 13,399 runs for the core tokens).
pub fn ints_line(label: str, ref xs: List<i64>) -> str {
    var b = StrBuilder();
    b += f"{label} {xs.len()}";
    let n = xs.len() as i64;
    var i = 0;
    while i < n {
        var j = i + 1;
        while j < n && xs[j] == xs[i] { j = j + 1; }
        if j - i > 1 { b += f" {xs[i]}*{j - i}"; } else { b += f" {xs[i]}"; }
        i = j;
    }
    b += "\n";
    return b.to_string();
}

/// `times` copies of `v`, doubled up rather than pushed one by one: on the
/// PilIR interpreter each push is a step, a doubling one step for the run.
fn run_of(v: i64, times: i64) -> List<i64> {
    var run: List<i64> = [v];
    while run.len() as i64 * 2 <= times { run = [*run, *run]; }
    if (run.len() as i64) < times {
        let rest = run_of(v, times - run.len() as i64);
        run = [*run, *rest];
    }
    return run;
}

/// The lists of `parts`, one after another: one engine step
/// (`list_extend`, deep) for them all, where pushing each number would be a
/// step per number on the PilIR interpreter.
fn joined(ref parts: List<List<i64>>) -> List<i64> => [*..parts];

fn words_line(label: str, ref xs: List<str>) -> str {
    var b = StrBuilder();
    b += f"{label} {xs.len()}";
    for x in xs { b += " " + word(x); }
    b += "\n";
    return b.to_string();
}

/// Whether tables `a` and `b` are one automaton over the same families
/// (their actions may differ).
fn same_automaton(ref a: LexTable, ref b: LexTable) -> bool =>
    a.classes == b.classes && a.states == b.states && a.names == b.names && a.class_of == b.class_of
    && a.starts == b.starts && a.accept == b.accept && a.next == b.next;

/// The first mode before `i` whose table is mode `i`'s automaton, or -1.
fn shared_with(ref m: ModalLexer, i: i64) -> i64 {
    var j = 0;
    while j < i {
        if same_automaton(m.tables[j], m.tables[i]) { return j; }
        j = j + 1;
    }
    return -1;
}

/// `m`, built from the declarations `key`, as the text of a cache file.
pub fn lexer_text(ref m: ModalLexer, key: str) -> str {
    var b = StrBuilder();
    b += CACHE_FORMAT + "\n";
    b += f"{CacheField::Key} {key.len()}\n";
    b += key;
    b += words_line(CacheField::Modes as str, m.modes);
    b += ints_line(CacheField::Bases as str, m.bases);
    b += ints_line(CacheField::ModeOf as str, m.mode_of);
    for i in 0 .. m.tables.len() {
        b += ints_line(CacheField::Enters as str, m.enters[i]);
        let t = m.tables[i];
        let shares = shared_with(m, i as i64);
        b += f"{CacheField::Shares} {shares}\n";
        if shares < 0 {
            b += words_line(CacheField::Names as str, t.names);
            b += ints_line(CacheField::ClassOf as str, t.class_of);
            b += f"{CacheField::Size} {t.classes} {t.states}\n";
            b += ints_line(CacheField::Starts as str, t.starts);
            b += ints_line(CacheField::Next as str, t.next);
            b += ints_line(CacheField::Accept as str, t.accept);
        }
        var acts: List<i64> = [];
        var goes: List<str> = [];
        for a in t.actions {
            acts.push(role_index(a.role));
            acts.push(if a.leaves { 1 } else { 0 });
            acts.push(a.trails);
            goes.push(a.enters);
        }
        b += ints_line(CacheField::Actions as str, acts);
        b += words_line(CacheField::EntersMode as str, goes);
    }
    return b.to_string();
}

/// Reads the words and numbers of a cache file in order. A read past the
/// end or of the wrong kind marks the reader `bad`.
struct Reader : IObject {
    src: str;
    at: i64;
    bad: bool;

    fn skip_space(var ref self) {
        while .at < .src.len() && (.src.byte_at(.at) as i64 == 32 || .src.byte_at(.at) as i64 == 10) { .at = .at + 1; }
    }

    fn next_word(var ref self) -> str {
        .skip_space();
        let from = .at;
        while .at < .src.len() && .src.byte_at(.at) as i64 != 32 && .src.byte_at(.at) as i64 != 10 { .at = .at + 1; }
        if .at == from { .bad = true; }
        return .src.slice(from, .at);
    }

    fn int(var ref self) -> i64 {
        .skip_space();
        var neg = false;
        if .at < .src.len() && .src.byte_at(.at) as i64 == 45 {
            neg = true;
            .at = .at + 1;
        }
        let from = .at;
        var v = 0;
        while .at < .src.len() {
            let d = .src.byte_at(.at) as i64 - 48;
            if d < 0 || d > 9 { break; }
            v = v * 10 + d;
            .at = .at + 1;
        }
        if .at == from { .bad = true; }
        return if neg { 0 - v } else { v };
    }

    /// A name written by `word`.
    fn name(var ref self) -> str {
        let w = .next_word();
        if w.len() == 0 || w.byte_at(0) as i64 != 61 {
            .bad = true;
            return "";
        }
        return w.slice(1, w.len());
    }

    fn expect(var ref self, field: CacheField) {
        if .next_word() != field as str { .bad = true; }
    }

    /// A line written by `ints_line`; a run `value*times` is read as
    /// `times` copies of the value.
    fn ints(var ref self, field: CacheField) -> List<i64> {
        .expect(field);
        let n = .int();
        var parts: List<List<i64>> = [];
        var single: List<i64> = [];
        var count = 0;
        while count < n && !self.bad {
            let v = .int();
            if .at < .src.len() && .src.byte_at(.at) as i64 == 42 {
                .at = .at + 1;
                let times = .int();
                if times < 2 || count + times > n {
                    .bad = true;
                } else {
                    if single.len() > 0 {
                        parts.push(single);
                        single = [];
                    }
                    parts.push(run_of(v, times));
                    count = count + times;
                }
            } else {
                single.push(v);
                count = count + 1;
            }
        }
        if single.len() > 0 { parts.push(single); }
        return joined(parts);
    }

    fn names(var ref self, field: CacheField) -> List<str> {
        .expect(field);
        let n = .int();
        var out: List<str> = [];
        var i = 0;
        while i < n && !self.bad {
            out.push(.name());
            i = i + 1;
        }
        return out;
    }
}

/// A table's automaton as `lexer_text` writes it (its actions empty).
fn read_automaton(var ref r: Reader) -> LexTable {
    let names = r.names(CacheField::Names);
    let class_of = r.ints(CacheField::ClassOf);
    r.expect(CacheField::Size);
    let classes = r.int();
    let states = r.int();
    let starts = r.ints(CacheField::Starts);
    let next = r.ints(CacheField::Next);
    let accept = r.ints(CacheField::Accept);
    return LexTable { names: names, class_of: class_of, classes: classes, states: states, starts: starts, next: next, accept: accept, actions: [] };
}

/// The lexer in the cache file text `src`, when it holds one built from
/// exactly the declarations `key`.
pub fn read_lexer(src: str, key: str) -> ModalLexer? {
    let first = CACHE_FORMAT + "\n";
    if !src.starts_with(first) { return none; }
    var r = Reader { src: src, at: first.len(), bad: false };
    r.expect(CacheField::Key);
    let n = r.int();
    let from = r.at + 1;
    if r.bad || from + n > src.len() || src.slice(from, from + n) != key { return none; }
    r.at = from + n;
    let modes = r.names(CacheField::Modes);
    let bases = r.ints(CacheField::Bases);
    let mode_of = r.ints(CacheField::ModeOf);
    var tables: List<LexTable> = [];
    var enters: List<List<i64>> = [];
    var i = 0;
    while i < modes.len() && !r.bad {
        enters.push(r.ints(CacheField::Enters));
        r.expect(CacheField::Shares);
        let shares = r.int();
        if shares >= i { return none; }
        let auto = if shares >= 0 { tables[shares] } else { read_automaton(r) };
        let acts = r.ints(CacheField::Actions);
        let goes = r.names(CacheField::EntersMode);
        var actions: List<TokenAction> = [];
        var k = 0;
        while k < goes.len() && 3 * k + 2 < acts.len() {
            let role = acts[3 * k];
            if role < 0 || role >= ROLES.len() || acts[3 * k + 2] < 0 { return none; }
            actions.push(TokenAction { role: ROLES[role], enters: goes[k], leaves: acts[3 * k + 1] == 1, trails: acts[3 * k + 2] });
            k = k + 1;
        }
        if actions.len() != auto.names.len() { return none; }
        tables.push(LexTable { names: auto.names, class_of: auto.class_of, classes: auto.classes, states: auto.states, starts: auto.starts, next: auto.next, accept: auto.accept, actions: actions });
        i = i + 1;
    }
    if r.bad { return none; }
    return ModalLexer { modes: modes, tables: tables, enters: enters, bases: bases, mode_of: mode_of };
}

/// Writes `m`, built from `key`, to `path`: under a name of its own first,
/// then moved into place, so a reader never sees half a file.
fn keep(path: str, ref m: ModalLexer, key: str) {
    let mine = f"{path}.{Process.send_signal(2, 0, 0)}.tmp";
    if File.write_text(mine, lexer_text(m, key)) {
        if !File.rename(mine, path) { File.write_text(mine, ""); }
    }
}

/// `build_modes(modes)`, read from `dir` when it was built there before
/// from the same declarations, and kept there when it is built now without
/// errors. The same lexer either way.
pub fn build_modes_cached(ref modes: List<LexMode>, dir: str) -> ModalBuild {
    let key = modes_key(modes);
    if key == "" { return build_modes(modes); }
    let path = cache_file(dir, key);
    if File.exists(path) {
        if some m = read_lexer(File.read_text(path), key) {
            return ModalBuild { lexer: m, errors: [] };
        }
    }
    let built = build_modes(modes);
    if built.ok() { keep(path, built.lexer, key); }
    return built;
}

/// The mode name a single table is kept under; `*` starts no declared
/// mode's name, so its key never meets a lexer's.
const TABLE_MODE: str = "*table";

/// `build_table(decls)`, read from and kept in `dir` like
/// `build_modes_cached`: one table, kept as a lexer of one mode.
pub fn build_table_cached(ref decls: List<TokenDecl>, dir: str) -> LexBuild {
    var one: List<LexMode> = [lex_mode(TABLE_MODE, decls)];
    let key = modes_key(one);
    if key == "" { return build_table(decls); }
    let path = cache_file(dir, key);
    if File.exists(path) {
        if some m = read_lexer(File.read_text(path), key) {
            return LexBuild { table: m.tables[0], errors: [] };
        }
    }
    let built = build_table(decls);
    if built.ok() {
        var entered: List<i64> = [];
        var owner: List<i64> = [];
        for d in decls {
            entered.push(-1);
            owner.push(0);
        }
        let m = ModalLexer { modes: [TABLE_MODE], tables: [built.table], enters: [entered], bases: [0], mode_of: owner };
        keep(path, m, key);
    }
    return built;
}
