// ==============================================================================
// FILE: stdlib/pilot/lex/modes.pilot
// Ring 3: lexing with modes (pub pkg pilot.lex.modes;) — PROP-021 slice 21C
// ==============================================================================
// A lexicon with modes is a list of `LexMode`s, each built into its own
// table. A token that `enters` a mode pushes it; a token that `leaves` pops
// back to the mode before. So an f-string's `{` enters the hole mode, where
// the ordinary tokens apply, and the `}` that closes the hole leaves it;
// nesting (a `{ .. }` or another f-string inside a hole) is the stack. The
// context (`LexContext`) carries across modes.
pub pkg pilot.lex.modes;

use Pilot.Core.Lex.Patterns;
use pilot.lex.build;

/// A built lexer with modes: one table per mode, and per mode and
/// declaration the index of the mode it enters (-1 for none). Every family
/// of every mode also has one number across the whole lexer: the
/// declarations of mode `k` are numbered from `bases[k]`, and `mode_of`
/// gives a family's mode back. The token tape (`pilot.lex`) keeps that
/// number.
pub struct ModalLexer : IObject {
    pub modes: List<str>;
    pub tables: List<LexTable>;
    pub enters: List<List<i64>>;
    pub bases: List<i64>;
    pub mode_of: List<i64>;

    /// The number of families across every mode.
    pub fn families(ref self) -> i64 => self.mode_of.len() as i64;

    /// The number across the lexer of declaration `decl` of mode `mode`.
    pub fn family_of(ref self, mode: i64, decl: i64) -> i64 => self.bases[mode] + decl;

    /// The declaration, within its mode, of family `fam`.
    pub fn decl_of(ref self, fam: i64) -> i64 => fam - self.bases[self.mode_of[fam]];

    /// The name of family `fam`.
    pub fn family_name(ref self, fam: i64) -> str {
        let mode = self.mode_of[fam];
        return self.tables[mode].names[fam - self.bases[mode]];
    }
}

/// The most families a lexer may have: a token kind on the tape is a `u16`
/// holding a family and one of the start contexts (LEX007).
pub const MAX_KIND: i64 = 65535;

/// The result of `build_modes`: the lexer, or the errors that stop it.
pub struct ModalBuild : IObject {
    pub lexer: ModalLexer;
    pub errors: List<LexBuildError>;

    pub fn ok(ref self) -> bool => self.errors.len() == 0;
}

/// Builds every mode of `modes`. A token that enters a mode no entry of
/// `modes` names is LEX005; each mode's own errors are reported with its
/// name.
pub fn build_modes(ref modes: List<LexMode>) -> ModalBuild {
    var names: List<str> = [];
    var index = Map<str, i64>();
    for m in modes {
        index.set(m.name, names.len() as i64);
        names.push(m.name);
    }
    var errors: List<LexBuildError> = [];
    var tables: List<LexTable> = [];
    var enters: List<List<i64>> = [];
    var bases: List<i64> = [];
    var mode_of: List<i64> = [];
    for m in modes {
        bases.push(mode_of.len() as i64);
        var j = 0;
        while j < m.tokens.len() {
            mode_of.push(bases.len() as i64 - 1);
            j = j + 1;
        }
        // A mode with an earlier mode's automaton (the f-string hole mode
        // has the main mode's tokens; only its braces change mode) reuses
        // that table with its own actions instead of building it again.
        var same = -1;
        var k = 0;
        while same < 0 && k < tables.len() as i64 {
            if same_automaton_decls(modes[k].tokens, m.tokens) { same = k; }
            k = k + 1;
        }
        if same >= 0 {
            tables.push(with_actions(tables[same], m.tokens));
        } else {
            let built = build_table(m.tokens);
            for e in built.errors {
                errors.push(LexBuildError { code: e.code, message: f"in mode `{m.name}`: {e.message}" });
            }
            tables.push(built.table);
        }
        var to: List<i64> = [];
        for d in m.tokens {
            if d.enters == "" {
                to.push(-1);
            } else if index.has(d.enters) {
                to.push(index[d.enters]);
            } else {
                to.push(-1);
                errors.push(LexBuildError { code: "LEX005", message: f"in mode `{m.name}`: `{d.name}` enters mode `{d.enters}`, which is not declared" });
            }
        }
        enters.push(to);
    }
    let kinds = mode_of.len() as i64 * LEX_CONTEXT_KINDS.len() as i64;
    if kinds > MAX_KIND + 1 {
        errors.push(LexBuildError { code: "LEX007", message: f"{mode_of.len()} families in {LEX_CONTEXT_KINDS.len()} contexts make {kinds} token kinds; a u16 kind numbers at most {MAX_KIND + 1}" });
    }
    return ModalBuild { lexer: ModalLexer { modes: names, tables: tables, enters: enters, bases: bases, mode_of: mode_of }, errors: errors };
}

/// The tokens of `src`, starting in the first mode. A generator, like
/// `lex_all`: each token is matched when the caller asks for it.
pub fn lex_modal(ref m: ModalLexer, src: str) -> Generator<Lexeme> {
    let len = src.len() as i64;
    var stack: List<i64> = [0];
    var pos = 0;
    var c = LEX_CONTEXT_START;
    while pos < len {
        let mode = stack[stack.len() - 1];
        let found = match_at(m.tables[mode], src, pos, context_at(c, pos));
        let l = Lexeme { decl: found.decl, start: found.start, end: found.end, mode: mode };
        c = context_after(c, role_of(m.tables[mode], l));
        if l.decl >= 0 {
            if m.tables[mode].actions[l.decl].leaves && stack.len() > 1 {
                let _ = stack.pop();
            }
            let to = m.enters[mode][l.decl];
            if to >= 0 {
                stack.push(to);
            }
        }
        pos = l.end;
        yield l;
    }
}

/// Whether `l` is a space (a token whose role is `Space`).
pub fn is_space_lexeme(ref m: ModalLexer, l: Lexeme) -> bool => l.decl >= 0 && m.tables[l.mode].actions[l.decl].role == TokenRole::Space;

/// The family name of `l` (`?` for a byte that starts no token).
pub fn modal_family(ref m: ModalLexer, l: Lexeme) -> str => if l.decl < 0 { "?" } else { m.tables[l.mode].names[l.decl] };

/// `name:text` for a lexeme (`?:text` for a byte that starts no token).
pub fn modal_lexeme_text(ref m: ModalLexer, src: str, l: Lexeme) -> str {
    let text = src.slice(l.start, l.end);
    return f"{modal_family(m, l)}:{text}";
}
