// ==============================================================================
// FILE: stdlib/pilot/lex/build.pilot
// Ring 3: The lexer builder (pub pkg pilot.lex.build;) — PROP-021 slice 21A
// ==============================================================================
// `build_table(decls)` compiles token declarations (Pilot.Core.Lex.Patterns)
// into the state table a lexer runs:
//   1. byte classes: the 256 byte values split at every edge of every byte
//      range in the patterns;
//   2. a Thompson NFA, one fragment per declaration, read from each
//      pattern's postfix program with one stack;
//   3. subset construction to a DFA over the byte classes; a DFA state
//      accepts the declaration with the highest priority among its NFA
//      states, and two declarations tied there are LEX002;
//   4. minimization by partition refinement (Moore);
//   5. byte classes whose columns are equal are merged.
// `lex_all` runs a table over text: the longest match from each position,
// falling back to the last accepting state (so `1..5` is `1`, `.`, `.`, `5`
// when `1.` alone is not a token), and a lexeme of family -1 for a byte that
// starts no token (LEX001).
//
// Context rules (`TokenWhen`) are start conditions: the DFA has one start
// state per context, reaching only the tokens that may start there, so ties
// (LEX002) are only ever between tokens that can meet. The runner picks the
// start state from what came before (`TokenRole`).
//
// The table is the whole of what the lexer knows. Nothing here names a
// character, a word or a symbol.
pub pkg pilot.lex.build;

use Pilot.Core.Lex.Patterns;
use Pilot.Core.Lex.Utf8;

/// A built lexer: `next[state * classes + class]` is the next state or -1,
/// `accept[state]` the declaration index a state accepts or -1, and
/// `starts[context]` the start state of each context (`LexContextKind` as a number).
/// Per declaration: what lexing it does to the lexer (`TokenAction`).
pub struct LexTable : IObject {
    pub names: List<str>;
    pub class_of: List<i64>;
    pub classes: i64;
    pub states: i64;
    pub starts: List<i64>;
    pub next: List<i64>;
    pub accept: List<i64>;
    pub actions: List<TokenAction>;
}

/// What a token does to the lexer: the context it leaves (`role`), the
/// mode it enters (`""` for none) and whether it leaves its mode.
pub struct TokenAction : IValue {
    pub role: TokenRole;
    pub enters: str;
    pub leaves: bool;
    pub trails: i64;
}

/// The contexts a token can start in: after a token that is neither a
/// space nor an operand's end (`Other`), after a space (`Spaced`), touching
/// the end of an operand (`Glued`), at the start of the text (`Start`).
pub enum LexContextKind : u8 { Other, Spaced, Glued, Start, }

/// Every context, in order; the table has one start state for each.
pub const LEX_CONTEXT_KINDS: List<LexContextKind> = [LexContextKind::Other, LexContextKind::Spaced, LexContextKind::Glued, LexContextKind::Start,];

/// Whether a token declared with `w` may start in context `ctx`.
pub fn starts_in(w: TokenWhen, ctx: LexContextKind) -> bool {
    if w == TokenWhen::Always { return true; }
    if w == TokenWhen::Spaced { return ctx == LexContextKind::Spaced || ctx == LexContextKind::Start; }
    if w == TokenWhen::Glued { return ctx == LexContextKind::Glued; }
    return ctx == LexContextKind::Start;
}

/// Why a set of declarations is not a lexer.
pub struct LexBuildError : IValue {
    pub code: str;
    pub message: str;
}

/// One token found in text: the declaration index (-1 for a byte that
/// starts no token), its byte span, and the mode it was found in (0 for a
/// one-mode lexer).
[Layout(c_abi)]
pub struct Lexeme : IValue {
    pub decl: i64;
    pub start: i64;
    pub end: i64;
    pub mode: i64;
}

/// The result of `build_table`: the table, or the errors that stop it.
pub struct LexBuild : IObject {
    pub table: LexTable;
    pub errors: List<LexBuildError>;

    pub fn ok(ref self) -> bool => self.errors.len() == 0;
}

// ------------------------------------------------------------------------------
// The NFA: parallel lists indexed by state
// ------------------------------------------------------------------------------

struct Nfa : IObject {
    pub lo: List<i64>;
    pub hi: List<i64>;
    pub to: List<i64>;
    pub accept: List<i64>;
    pub eps_from: List<i64>;
    pub eps_to: List<i64>;
}

fn nfa_state(var ref n: Nfa) -> i64 {
    n.lo.push(-1);
    n.hi.push(-1);
    n.to.push(-1);
    n.accept.push(-1);
    return n.lo.len() - 1;
}

fn nfa_eps(var ref n: Nfa, from: i64, to: i64) {
    n.eps_from.push(from);
    n.eps_to.push(to);
}

/// Builds the fragment of one pattern; returns its start state and sets
/// `end_out[0]` to its end state.
fn nfa_fragment(var ref n: Nfa, ref p: Pattern, var ref end_out: List<i64>) -> i64 {
    var fs: List<i64> = [];
    var fe: List<i64> = [];
    for o in p.ops {
        if o.kind == PatKind::Bytes {
            let s = nfa_state(n);
            let e = nfa_state(n);
            n.lo[s] = o.lo;
            n.hi[s] = o.hi;
            n.to[s] = e;
            fs.push(s);
            fe.push(e);
        } else if o.kind == PatKind::Seq {
            if o.n == 0 {
                let s = nfa_state(n);
                fs.push(s);
                fe.push(s);
            } else {
                let base = fs.len() - o.n;
                var i = base;
                while i + 1 < fs.len() {
                    nfa_eps(n, fe[i], fs[i + 1]);
                    i = i + 1;
                }
                let start = fs[base];
                let end = fe[fe.len() - 1];
                var k = 0;
                while k < o.n {
                    fs.pop();
                    fe.pop();
                    k = k + 1;
                }
                fs.push(start);
                fe.push(end);
            }
        } else if o.kind == PatKind::Alt {
            let s = nfa_state(n);
            let e = nfa_state(n);
            let base = fs.len() - o.n;
            var i = base;
            while i < fs.len() {
                nfa_eps(n, s, fs[i]);
                nfa_eps(n, fe[i], e);
                i = i + 1;
            }
            var k = 0;
            while k < o.n {
                fs.pop();
                fe.pop();
                k = k + 1;
            }
            fs.push(s);
            fe.push(e);
        } else {
            let a = fs.pop();
            let b = fe.pop();
            if o.kind == PatKind::AtLeastOne {
                let e = nfa_state(n);
                nfa_eps(n, b, a);
                nfa_eps(n, b, e);
                fs.push(a);
                fe.push(e);
            } else {
                let s = nfa_state(n);
                let e = nfa_state(n);
                nfa_eps(n, s, a);
                nfa_eps(n, s, e);
                nfa_eps(n, b, e);
                if o.kind == PatKind::Many {
                    nfa_eps(n, b, a);
                }
                fs.push(s);
                fe.push(e);
            }
        }
    }
    end_out[0] = fe[0];
    return fs[0];
}

// ------------------------------------------------------------------------------
// Building the table
// ------------------------------------------------------------------------------

/// `xs` sorted ascending, in place (insertion sort: the lists sorted here
/// are a DFA state's accepting NFA states, a handful at most).
fn sort_ints(var ref xs: List<i64>) {
    var i = 1;
    while i < xs.len() as i64 {
        let v = xs[i];
        var j = i - 1;
        while j >= 0 && xs[j] > v {
            xs[j + 1] = xs[j];
            j = j - 1;
        }
        xs[j + 1] = v;
        i = i + 1;
    }
}

/// The modulus the builder's hashes are kept under, so no product of a hash
/// and a 20-bit factor leaves an `i64`.
const HASH_MOD: i64 = 1000000007;

/// A hash of NFA state `s` for `closure`'s order-independent set hash.
fn state_hash(s: i64) -> i64 => ((s + 1) * 2654435761) % 4294967291;

/// The eps-closure of `seeds` into `out` (unordered, each state once), every
/// state of it marked `stamp` in `mark`; returns the set's hash, the sum of
/// its states' `state_hash`, which does not depend on their order.
fn closure(ref seeds: List<i64>, ref eps_off: List<i64>, ref eps_dst: List<i64>, var ref mark: List<i64>, stamp: i64, var ref out: List<i64>) -> i64 {
    var stack: List<i64> = [];
    var h = 0;
    for s in seeds {
        if mark[s] != stamp {
            mark[s] = stamp;
            stack.push(s);
            out.push(s);
            h = h + state_hash(s);
        }
    }
    while stack.len() > 0 {
        let s = stack.pop();
        var k = eps_off[s];
        let stop = eps_off[s + 1];
        while k < stop {
            let t = eps_dst[k];
            if mark[t] != stamp {
                mark[t] = stamp;
                stack.push(t);
                out.push(t);
                h = h + state_hash(t);
            }
            k = k + 1;
        }
    }
    return h;
}

/// `n` slots of -1: an empty open-addressing table of ids.
fn empty_slots(n: i64) -> List<i64> {
    var xs: List<i64> = [];
    var i = 0;
    while i < n {
        xs.push(-1);
        i = i + 1;
    }
    return xs;
}

/// The DFA state whose NFA states are exactly the set just closed under
/// `stamp` (`size` states, hash `h`), or -1. A candidate of the same hash
/// and size is that set when every state of it carries the stamp.
fn find_set(ref slots: List<i64>, ref dhash: List<i64>, ref members: List<List<i64>>, ref mark: List<i64>, stamp: i64, h: i64, size: i64) -> i64 {
    let cap = slots.len() as i64;
    var at = h % cap;
    while slots[at] >= 0 {
        let id = slots[at];
        if dhash[id] == h && members[id].len() as i64 == size {
            var same = true;
            for s in members[id] {
                if mark[s] != stamp {
                    same = false;
                    break;
                }
            }
            if same { return id; }
        }
        at = at + 1;
        if at == cap { at = 0; }
    }
    return -1;
}

/// The entry of `lists` that is the list `xs` (hash `h`), or -1.
fn find_ints(ref slots: List<i64>, ref hashes: List<i64>, ref lists: List<List<i64>>, ref xs: List<i64>, h: i64) -> i64 {
    let cap = slots.len() as i64;
    var at = h % cap;
    while slots[at] >= 0 {
        let id = slots[at];
        if hashes[id] == h && same_ints(lists[id], xs) { return id; }
        at = at + 1;
        if at == cap { at = 0; }
    }
    return -1;
}

/// Puts `id` (hash `h`) in the first free slot of its probe.
fn put_slot(var ref slots: List<i64>, h: i64, id: i64) {
    let cap = slots.len() as i64;
    var at = h % cap;
    while slots[at] >= 0 {
        at = at + 1;
        if at == cap { at = 0; }
    }
    slots[at] = id;
}

/// Adds `set` (hash `h`) as entry `members.len()` of a table: a new DFA
/// state, or a new list of targets. Returns its id. The table grows to keep
/// at most half its slots full.
fn add_set(var ref slots: List<i64>, var ref dhash: List<i64>, var ref members: List<List<i64>>, set: List<i64>, h: i64) -> i64 {
    let id = members.len() as i64;
    members.push(set);
    dhash.push(h);
    if (id + 1) * 2 > slots.len() as i64 {
        slots = empty_slots(slots.len() as i64 * 2 + 1);
        var k = 0;
        while k <= id {
            put_slot(slots, dhash[k], k);
            k = k + 1;
        }
    } else {
        put_slot(slots, h, id);
    }
    return id;
}

/// Whether the signature runs from `x` equal those at `from .. to`, the
/// last signature written: the same last intervals and target groups. The
/// runs of `x` end where the next state's begin, at or before `from`.
fn same_runs(ref last: List<i64>, ref group: List<i64>, x: i64, from: i64, to: i64) -> bool {
    if x + (to - from) > from { return false; }
    var k = 0;
    while from + k < to {
        if last[x + k] != last[from + k] || group[x + k] != group[from + k] { return false; }
        k = k + 1;
    }
    // Both signatures end at the last interval, so equal runs up to `to`
    // cover the whole row of `x` as well.
    return true;
}

/// Whether `a` and `b` are the same list.
fn same_ints(ref a: List<i64>, ref b: List<i64>) -> bool {
    if a.len() != b.len() { return false; }
    var i = 0;
    while i < a.len() as i64 {
        if a[i] != b[i] { return false; }
        i = i + 1;
    }
    return true;
}

/// Whether intervals `x` and `y` take every one of `groups` states to the
/// same state in the `intervals`-wide table `gnext`.
fn same_column(ref gnext: List<i64>, groups: i64, intervals: i64, x: i64, y: i64) -> bool {
    var g = 0;
    while g < groups {
        if gnext[g * intervals + x] != gnext[g * intervals + y] { return false; }
        g = g + 1;
    }
    return true;
}

fn build_error(code: str, message: str) -> LexBuildError => LexBuildError { code: code, message: message };

/// Whether `a` and `b` give one automaton: the same tokens in the same
/// order, each with the same name, priority, start condition and pattern.
/// The role, mode change and trailing length are the table's actions, not
/// its automaton.
pub fn same_automaton_decls(ref a: List<TokenDecl>, ref b: List<TokenDecl>) -> bool {
    if a.len() != b.len() { return false; }
    var i = 0;
    while i < a.len() {
        let x = a[i];
        let y = b[i];
        if x.name != y.name || x.priority != y.priority || x.when != y.when || x.pattern.ops.len() != y.pattern.ops.len() { return false; }
        var k = 0;
        while k < x.pattern.ops.len() {
            let p = x.pattern.ops[k];
            let q = y.pattern.ops[k];
            if p.kind != q.kind || p.lo != q.lo || p.hi != q.hi || p.n != q.n { return false; }
            k = k + 1;
        }
        i = i + 1;
    }
    return true;
}

/// Table `t` with the actions of `decls`, which give its automaton
/// (`same_automaton_decls`).
pub fn with_actions(ref t: LexTable, ref decls: List<TokenDecl>) -> LexTable {
    var actions: List<TokenAction> = [];
    for d in decls {
        actions.push(TokenAction { role: d.role, enters: d.enters, leaves: d.leaves, trails: d.trails });
    }
    return LexTable { names: t.names, class_of: t.class_of, classes: t.classes, states: t.states, starts: t.starts, next: t.next, accept: t.accept, actions: actions };
}

/// Compiles `decls` into a minimized lexer table. A declaration whose
/// pattern matches the empty text is LEX004; two declarations of equal
/// priority that match the same text are LEX002.
pub fn build_table(ref decls: List<TokenDecl>) -> LexBuild {
    var errors: List<LexBuildError> = [];
    var names: List<str> = [];
    var prio: List<i64> = [];
    var actions: List<TokenAction> = [];
    for d in decls {
        names.push(d.name);
        prio.push(d.priority);
        actions.push(TokenAction { role: d.role, enters: d.enters, leaves: d.leaves, trails: d.trails });
    }

    // 1. Byte classes: a boundary before every range start and after every
    //    range end.
    var cut: List<i64> = [];
    var b = 0;
    while b < 257 {
        cut.push(0);
        b = b + 1;
    }
    cut[0] = 1;
    for d in decls {
        for o in d.pattern.ops {
            if o.kind == PatKind::Bytes {
                cut[o.lo] = 1;
                cut[o.hi + 1] = 1;
            }
        }
    }
    var interval_of: List<i64> = [];
    var intervals = 0;
    b = 0;
    while b < 256 {
        if cut[b] == 1 {
            intervals = intervals + 1;
        }
        interval_of.push(intervals - 1);
        b = b + 1;
    }

    // 2. The NFA: one root per context, reaching the fragment of every
    //    declaration that may start there.
    var n = Nfa { lo: [], hi: [], to: [], accept: [], eps_from: [], eps_to: [] };
    var roots: List<i64> = [];
    for k in LEX_CONTEXT_KINDS {
        roots.push(nfa_state(n));
    }
    var end_out: List<i64> = [0];
    var di = 0;
    for d in decls {
        let s = nfa_fragment(n, d.pattern, end_out);
        for k in LEX_CONTEXT_KINDS {
            if starts_in(d.when, k) {
                nfa_eps(n, roots[k as i64], s);
            }
        }
        n.accept[end_out[0]] = di;
        di = di + 1;
    }
    let ns = n.lo.len();
    var eps_off: List<i64> = [];
    var i = 0;
    while i <= ns {
        eps_off.push(0);
        i = i + 1;
    }
    i = 0;
    while i < n.eps_from.len() {
        eps_off[n.eps_from[i] + 1] = eps_off[n.eps_from[i] + 1] + 1;
        i = i + 1;
    }
    i = 0;
    while i < ns {
        eps_off[i + 1] = eps_off[i + 1] + eps_off[i];
        i = i + 1;
    }
    var fill: List<i64> = [];
    var eps_dst: List<i64> = [];
    i = 0;
    while i < ns {
        fill.push(eps_off[i]);
        i = i + 1;
    }
    i = 0;
    while i < n.eps_from.len() {
        eps_dst.push(0);
        i = i + 1;
    }
    i = 0;
    while i < n.eps_from.len() {
        let f = n.eps_from[i];
        eps_dst[fill[f]] = n.eps_to[i];
        fill[f] = fill[f] + 1;
        i = i + 1;
    }

    // 3. Subset construction over the byte intervals. A DFA state is found
    //    again by its set's hash (`closure`), checked against the stamp
    //    marks, so no set is sorted or written out; states are numbered in
    //    the order they are first reached, as before.
    var mark: List<i64> = [];
    i = 0;
    while i < ns {
        mark.push(-1);
        i = i + 1;
    }
    var stamp = 0;
    var members: List<List<i64>> = [];
    var dhash: List<i64> = [];
    var slots = empty_slots(1021);
    var dnext: List<i64> = [];
    var daccept: List<i64> = [];
    var dstarts: List<i64> = [];
    for r in roots {
        var seeds: List<i64> = [r];
        var first: List<i64> = [];
        let h = closure(seeds, eps_off, eps_dst, mark, stamp, first);
        var id = find_set(slots, dhash, members, mark, stamp, h, first.len() as i64);
        if id < 0 {
            id = add_set(slots, dhash, members, first, h);
        }
        stamp = stamp + 1;
        dstarts.push(id);
    }
    let start_states = members.len();
    var reported: Map<str, i64> = Map<str, i64>();
    // The targets of the current DFA state's byte transitions, by interval:
    // each NFA transition adds its target to the intervals its range spans.
    // `bhash` is each bucket's order-dependent hash. A bucket's targets
    // decide the state it leads to, so each list of targets is closed once
    // for the whole build (`memo_*`, found by that hash): most buckets of
    // most states are a target already met.
    var buckets: List<List<i64>> = [];
    var bhash: List<i64> = [];
    i = 0;
    while i < intervals {
        buckets.push([]);
        bhash.push(0);
        i = i + 1;
    }
    var memo_slots = empty_slots(1021);
    var memo_seeds: List<List<i64>> = [];
    var memo_hash: List<i64> = [];
    var memo_id: List<i64> = [];
    var acc: List<i64> = [];
    var cur = 0;
    while cur < members.len() {
        // What this DFA state accepts: its accepting NFA states, in
        // ascending order, so ties are reported in a fixed order.
        acc = [];
        for s in members[cur] {
            if n.accept[s] >= 0 {
                acc.push(s);
            }
        }
        sort_ints(acc);
        var best = -1;
        for s in acc {
            let a = n.accept[s];
            if best < 0 || prio[a] > prio[best] {
                best = a;
            } else if prio[a] == prio[best] && a != best {
                var lo_d = best;
                var hi_d = a;
                if a < best {
                    lo_d = a;
                    hi_d = best;
                }
                let key = f"{lo_d},{hi_d}";
                if !reported.has(key) {
                    reported.set(key, 1);
                    errors.push(build_error("LEX002", f"`{names[lo_d]}` and `{names[hi_d]}` both match the same text with priority {prio[a]}; give one of them a higher priority"));
                }
                if a < best {
                    best = a;
                }
            }
        }
        if cur < start_states && best >= 0 && !reported.has(f"empty {best}") {
            reported.set(f"empty {best}", 1);
            errors.push(build_error("LEX004", f"`{names[best]}` matches the empty text; a token must take at least one byte"));
        }
        daccept.push(best);
        for s in members[cur] {
            let lo = n.lo[s];
            if lo >= 0 {
                let t = n.to[s];
                var k = interval_of[lo];
                let last = interval_of[n.hi[s]];
                while k <= last {
                    buckets[k].push(t);
                    bhash[k] = (bhash[k] * 31 + t + 1) % HASH_MOD;
                    k = k + 1;
                }
            }
        }
        var c = 0;
        while c < intervals {
            if buckets[c].len() == 0 {
                dnext.push(-1);
            } else {
                let bh = bhash[c];
                let known = find_ints(memo_slots, memo_hash, memo_seeds, buckets[c], bh);
                if known >= 0 {
                    dnext.push(memo_id[known]);
                } else {
                    var set: List<i64> = [];
                    let h = closure(buckets[c], eps_off, eps_dst, mark, stamp, set);
                    var id = find_set(slots, dhash, members, mark, stamp, h, set.len() as i64);
                    if id < 0 {
                        id = add_set(slots, dhash, members, set, h);
                    }
                    stamp = stamp + 1;
                    var kept: List<i64> = [];
                    for t in buckets[c] {
                        kept.push(t);
                    }
                    let _ = add_set(memo_slots, memo_hash, memo_seeds, kept, bh);
                    memo_id.push(id);
                    dnext.push(id);
                }
            }
            c = c + 1;
        }
        c = 0;
        while c < intervals {
            if buckets[c].len() > 0 {
                buckets[c] = [];
                bhash[c] = 0;
            }
            c = c + 1;
        }
        cur = cur + 1;
    }
    let dstates = members.len();

    // 4. Minimize: split states until each group's members agree on what
    //    they accept and where every interval takes them.
    var part: List<i64> = [];
    var groups = 0;
    var first_split: Map<str, i64> = Map<str, i64>();
    i = 0;
    while i < dstates {
        let key = f"{daccept[i]}";
        if !first_split.has(key) {
            first_split.set(key, groups);
            groups = groups + 1;
        }
        part.push(first_split[key]);
        i = i + 1;
    }
    // Each round numbers the groups in order of their first state, as a
    // state's signature (its group and its intervals' target groups) is
    // first met. A row is kept as its runs of equal targets (a third of a
    // million runs for the toolchain's 1.5 million cells), and a signature
    // as its runs of equal target groups, found by hash and compared run
    // by run.
    var run_start: List<i64> = [];
    var run_last: List<i64> = [];
    var run_to: List<i64> = [];
    i = 0;
    while i < dstates {
        run_start.push(run_last.len() as i64);
        let base = i * intervals;
        var c = 0;
        while c < intervals {
            let t = dnext[base + c];
            if c > 0 && t == dnext[base + c - 1] {
                run_last[run_last.len() - 1] = c;
            } else {
                run_last.push(c);
                run_to.push(t);
            }
            c = c + 1;
        }
        i = i + 1;
    }
    run_start.push(run_last.len() as i64);
    let sig_cap = dstates * 2 + 1;
    var changed = true;
    while changed {
        var sig_start: List<i64> = [];
        var sig_last: List<i64> = [];
        var sig_group: List<i64> = [];
        var sig_slots = empty_slots(sig_cap);
        var reps: List<i64> = [];
        var next_part: List<i64> = [];
        i = 0;
        while i < dstates {
            let from = sig_last.len() as i64;
            sig_start.push(from);
            var r = run_start[i];
            let stop = run_start[i + 1];
            while r < stop {
                let t = run_to[r];
                let g = if t < 0 { -1 } else { part[t] };
                if sig_last.len() as i64 > from && sig_group[sig_group.len() - 1] == g {
                    sig_last[sig_last.len() - 1] = run_last[r];
                } else {
                    sig_last.push(run_last[r]);
                    sig_group.push(g);
                }
                r = r + 1;
            }
            var h = part[i] + 1;
            var k = from;
            while k < sig_last.len() as i64 {
                h = (h * 1000003 + sig_last[k] * 65599 + sig_group[k] + 1) % HASH_MOD;
                k = k + 1;
            }
            let to = sig_last.len() as i64;
            var at = h % sig_cap;
            var g = -1;
            while g < 0 && sig_slots[at] >= 0 {
                let cand = sig_slots[at];
                let rep = reps[cand];
                if part[rep] == part[i] && same_runs(sig_last, sig_group, sig_start[rep], from, to) {
                    g = cand;
                } else {
                    at = at + 1;
                    if at == sig_cap { at = 0; }
                }
            }
            if g < 0 {
                g = reps.len() as i64;
                reps.push(i);
                sig_slots[at] = g;
            }
            next_part.push(g);
            i = i + 1;
        }
        let next_groups = reps.len() as i64;
        changed = next_groups != groups;
        groups = next_groups;
        part = next_part;
    }
    var gnext: List<i64> = [];
    var gaccept: List<i64> = [];
    var seen: List<i64> = [];
    i = 0;
    while i < groups * intervals {
        gnext.push(-1);
        i = i + 1;
    }
    i = 0;
    while i < groups {
        gaccept.push(-1);
        seen.push(0);
        i = i + 1;
    }
    i = 0;
    while i < dstates {
        let g = part[i];
        if seen[g] == 0 {
            seen[g] = 1;
            gaccept[g] = daccept[i];
            var c = 0;
            while c < intervals {
                let t = dnext[i * intervals + c];
                if t >= 0 {
                    gnext[g * intervals + c] = part[t];
                }
                c = c + 1;
            }
        }
        i = i + 1;
    }

    // 5. Merge intervals whose columns are equal into one byte class,
    //    numbered in order of first interval; columns are found by hash.
    var class_rep: List<i64> = [];
    var class_of_interval: List<i64> = [];
    let col_cap = intervals * 2 + 1;
    var col_slots = empty_slots(col_cap);
    var classes = 0;
    var c = 0;
    while c < intervals {
        var h = 1;
        var g = 0;
        while g < groups {
            h = (h * 1000003 + gnext[g * intervals + c] + 2) % HASH_MOD;
            g = g + 1;
        }
        var at = h % col_cap;
        var found = -1;
        while found < 0 && col_slots[at] >= 0 {
            let cand = col_slots[at];
            if same_column(gnext, groups, intervals, class_rep[cand], c) {
                found = cand;
            } else {
                at = at + 1;
                if at == col_cap { at = 0; }
            }
        }
        if found < 0 {
            found = classes;
            classes = classes + 1;
            class_rep.push(c);
            col_slots[at] = found;
        }
        class_of_interval.push(found);
        c = c + 1;
    }
    var next: List<i64> = [];
    i = 0;
    while i < groups * classes {
        next.push(-1);
        i = i + 1;
    }
    var g = 0;
    while g < groups {
        c = 0;
        while c < intervals {
            next[g * classes + class_of_interval[c]] = gnext[g * intervals + c];
            c = c + 1;
        }
        g = g + 1;
    }
    var class_of: List<i64> = [];
    b = 0;
    while b < 256 {
        class_of.push(class_of_interval[interval_of[b]]);
        b = b + 1;
    }

    var starts: List<i64> = [];
    for st in dstarts {
        starts.push(part[st]);
    }
    let table = LexTable {
        names: names,
        class_of: class_of,
        classes: classes,
        states: groups,
        starts: starts,
        next: next,
        accept: gaccept,
        actions: actions,
    };
    return LexBuild { table: table, errors: errors };
}

// ------------------------------------------------------------------------------
// Running a table
// ------------------------------------------------------------------------------

/// The longest token of `t` starting at `pos` of `src` in context `ctx`,
/// falling back to the last accepting state; family -1 when none starts
/// there, over one whole UTF-8 character (one byte when the bytes there are
/// not well-formed UTF-8), so it is reported once.
pub fn match_at(ref t: LexTable, src: str, pos: i64, ctx: LexContextKind) -> Lexeme {
    let len = src.len() as i64;
    var state = t.starts[ctx as i64];
    var i = pos;
    var last = -1;
    var last_end = pos;
    while i < len {
        let cls = t.class_of[src.byte_at(i) as i64];
        let nx = t.next[state * t.classes + cls];
        if nx < 0 {
            break;
        }
        state = nx;
        i = i + 1;
        if t.accept[state] >= 0 {
            last = t.accept[state];
            last_end = i;
        }
    }
    if last < 0 {
        return Lexeme { decl: -1, start: pos, end: pos + utf8_char_length(src, pos), mode: 0 };
    }
    return Lexeme { decl: last, start: pos, end: last_end - t.actions[last].trails, mode: 0 };
}

/// Where the lexer stands between two tokens: whether a space came last
/// and whether the token before ends an operand. It starts spaced.
pub struct LexContext : IValue {
    pub spaced: bool;
    pub operand: bool;
}

/// The context before the first token: spaced, after no operand.
pub const LEX_CONTEXT_START: LexContext = LexContext { spaced: true, operand: false };

/// The context a token at `pos` starts in.
pub fn context_at(c: LexContext, pos: i64) -> LexContextKind {
    if pos == 0 { return LexContextKind::Start; }
    if c.spaced { return LexContextKind::Spaced; }
    if c.operand { return LexContextKind::Glued; }
    return LexContextKind::Other;
}

/// The role of lexeme `l` of `t`; a byte that starts no token is `Plain`.
pub fn role_of(ref t: LexTable, l: Lexeme) -> TokenRole => if l.decl < 0 { TokenRole::Plain } else { t.actions[l.decl].role };

/// The context after a token of role `role`.
pub fn context_after(c: LexContext, role: TokenRole) -> LexContext {
    if role == TokenRole::Space { return LexContext { spaced: true, operand: c.operand }; }
    if role == TokenRole::Trivia { return c; }
    return LexContext { spaced: false, operand: role == TokenRole::Operand };
}

/// The tokens of `src`, longest match first from each position, each
/// started in the context the tokens before it leave. A generator: each
/// token is matched only when the caller asks for it, so a caller that
/// stops early lexes no further (imp_type.md Rule 14).
pub fn lex_all(ref t: LexTable, src: str) -> Generator<Lexeme> {
    let len = src.len() as i64;
    var pos = 0;
    var c = LEX_CONTEXT_START;
    while pos < len {
        let l = match_at(t, src, pos, context_at(c, pos));
        c = context_after(c, role_of(t, l));
        pos = l.end;
        yield l;
    }
}

/// `name:text` for a lexeme (`?:text` for a byte that starts no token).
pub fn lexeme_text(ref t: LexTable, src: str, l: Lexeme) -> str {
    let text = src.slice(l.start, l.end);
    if l.decl < 0 {
        return f"?:{text}";
    }
    return f"{t.names[l.decl]}:{text}";
}

/// `N states, M classes, K tokens`, not counting the dead state.
pub fn table_summary(ref t: LexTable) -> str => f"{t.states} states, {t.classes} classes, {t.names.len()} tokens";
