// ==============================================================================
// FILE: stdlib/pilot/abi/win64.pilot
// Milestone 13: Microsoft Windows x64 Calling Convention Classifier
// Package: pub pkg pilot.abi.win64;
// ==============================================================================
pub pkg Pilot.Abi.Win64;

use Pilot.Core.Interfaces::*;
use Pilot.Core.Option::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Reflect.TypeLayout;
use Pilot.Abi.Descriptor.*;

pub struct Win64ConvClassifier : IValue, ICallingConvClassifier {
    pub static pure fn name() -> str => "win64";

    pub static pure fn spec() -> CallingConvSpec => CallingConvSpec::create(
        "win64",
        4,    // RCX, RDX, R8, R9
        4,    // XMM0..XMM3
        32,   // 32-byte home shadow space mandatory on Windows
        16,   // 16-byte stack alignment
        false,// Sret shares RCX (slot 0)
        0     // RCX
    );

    pub static pure fn classify(
        params: slice<TypeLayout>,
        ret: ref<TypeLayout>,
        variadic_fixed_count: opt<usize>
    ) -> AbiFramePlan {
        var param_locs: List<ArgLocation> = [];
        var next_slot: u8 = 0;
        var stack_offset: u32 = 32;
        var sret_used = false;
        var ret_location = ArgLocation::void_loc();

        // 1. Classify return value
        let ret_sz = ret.size_in_bytes;
        let ret_is_agg = ret.reg_class == 5;
        let ret_is_flt = ret.reg_class == 2;
        if ret_sz == 0 {
            ret_location = ArgLocation::void_loc();
        } else if ret_is_agg && (ret_sz > 8 || (ret_sz != 1 && ret_sz != 2 && ret_sz != 4 && ret_sz != 8)) {
            sret_used = true;
            next_slot = 1; // Explicit arg 0 shifts to RDX (slot 1)
            ret_location = ArgLocation::indirect(0, ret_sz as u32);
        } else if ret_is_flt {
            ret_location = ArgLocation::direct_simd(0, ret_sz as u32);
        } else {
            ret_location = ArgLocation::direct_gpr(0, ret_sz as u32);
        }

        // 2. Classify parameters
        var p_idx: usize = 0;
        loop {
            if !(p_idx < params.len()) { break; }
            let p = params[p_idx];
            let sz = p.size_in_bytes as u32;

            if next_slot < 4 {
                if p.reg_class == 2 {
                    param_locs.push(ArgLocation::direct_simd(next_slot, sz));
                } else if p.reg_class == 5 {
                    if sz == 1 || sz == 2 || sz == 4 || sz == 8 {
                        param_locs.push(ArgLocation::direct_gpr(next_slot, sz));
                    } else {
                        param_locs.push(ArgLocation::indirect(next_slot, sz));
                    }
                } else {
                    param_locs.push(ArgLocation::direct_gpr(next_slot, sz));
                }
                next_slot = next_slot + 1;
            } else {
                if p.reg_class == 5 && (sz > 8 || (sz != 1 && sz != 2 && sz != 4 && sz != 8)) {
                    param_locs.push(ArgLocation::stack(stack_offset, 8));
                    stack_offset = stack_offset + 8;
                } else {
                    param_locs.push(ArgLocation::stack(stack_offset, sz));
                    stack_offset = stack_offset + ((sz + 7) & 0xFFFFFFF8);
                }
            }

            p_idx = p_idx + 1;
        }

        // Align stack to 16 bytes
        let aligned_stack = (stack_offset + 15) & 0xFFFFFFF0;

        return AbiFramePlan {
            conv_id:             "win64",
            sret_uses_gpr0:      sret_used,
            ret_loc:             ret_location,
            param_locs:          param_locs,
            aligned_stack_bytes: aligned_stack,
        };
    }
}
