// ==============================================================================
// FILE: stdlib/pilot/abi/aapcs64.pilot
// Milestone 13: ARM64 AAPCS64 & Apple Darwin ARM64 Calling Convention Classifier
// Package: pub pkg pilot.abi.aapcs64;
// ==============================================================================
pub pkg Pilot.Abi.Aapcs64;

use Pilot.Core.Interfaces::*;
use Pilot.Core.Option::*;
use Pilot.Core.Memory::*;
use Pilot.Core.Reflect.TypeLayout;
use Pilot.Abi.Descriptor::*;

/// Members of a Homogeneous Floating-point Aggregate (AAPCS64 5.9.5.1):
/// 1 to 4 floating-point members of one size that fill the aggregate.
/// `0` when the aggregate is not an HFA.
pub fn aapcs64_hfa_count(fields: List<AbiFieldClass>, size: u32) -> u8 {
    let n = fields.len();
    if n == 0 || n > 4 { return 0; }
    let member = fields[0].size;
    var i: usize = 0;
    while i < n {
        let f = fields[i];
        if !f.is_float() || f.size != member || f.offset != member * (i as u32) { return 0; }
        i = i + 1;
    }
    if member * (n as u32) != size { return 0; }
    return n as u8;
}

/// An HFA of `count` members starting at vector register `v0`.
pub pure fn aapcs64_hfa_location(v0: u8, count: u8, size: u32) -> ArgLocation {
    if count == 1 { return ArgLocation::direct_simd(v0, size); }
    if count == 2 { return ArgLocation::pair_simd_simd(v0, v0 + 1, size); }
    return ArgLocation::hfa(v0, count, size);
}

pub struct Aapcs64ConvClassifier : IValue, ICallingConvClassifier {
    pub is_darwin: bool;

    pub static pure fn standard() -> Aapcs64ConvClassifier => Aapcs64ConvClassifier { is_darwin: false };
    pub static pure fn darwin() -> Aapcs64ConvClassifier => Aapcs64ConvClassifier { is_darwin: true };

    pub static pure fn name() -> str => "aapcs64";

    pub static pure fn spec() -> CallingConvSpec => CallingConvSpec::create(
        "aapcs64",
        8,    // X0..X7
        8,    // V0..V7
        0,    // No shadow space
        16,   // 16-byte stack alignment
        true, // Dedicated X8 sret register (does NOT consume X0!)
        8     // X8
    );

    pub static pure fn darwin_spec() -> CallingConvSpec => CallingConvSpec::create(
        "darwin_arm64",
        8, 8, 0, 16, true, 8
    );

    // Standard (non-Darwin) AAPCS64 classification.
    pub static pure fn classify(
        params: slice<TypeLayout>,
        ret: ref<TypeLayout>,
        variadic_fixed_count: opt<usize>
    ) -> AbiFramePlan => Aapcs64ConvClassifier::standard().plan(params, ret, variadic_fixed_count);

    // Classification for this variant; `is_darwin` selects the Darwin ABI id.
    pub pure fn plan(
        params: slice<TypeLayout>,
        ret: ref<TypeLayout>,
        variadic_fixed_count: opt<usize>
    ) -> AbiFramePlan {
        var param_locs: List<ArgLocation> = [];
        var next_gpr: u8 = 0;
        var next_vec: u8 = 0;
        var stack_offset: u32 = 0;
        var sret_used = false;
        var ret_location = ArgLocation::void_loc();

        // 1. Classify return value
        let ret_sz = ret.size_in_bytes;
        let ret_is_agg = ret.reg_class == 5;
        let ret_is_flt = ret.reg_class == 2;
        if ret_sz == 0 {
            ret_location = ArgLocation::void_loc();
        } else if ret_is_agg {
            // Aggregates up to 32 bytes may be HFAs (returned in V0..V3);
            // that depends on their members, not their size.
            var hfa: u8 = 0;
            if ret_sz <= 32 {
                hfa = aapcs64_hfa_count(abi_aggregate_fields(ret), ret_sz as u32);
            }
            if hfa > 0 {
                ret_location = aapcs64_hfa_location(0, hfa, ret_sz as u32);
            } else if ret_sz > 16 {
                // Dedicated X8 holds the destination; explicit argument 0
                // stays in X0.
                sret_used = true;
                ret_location = ArgLocation::indirect(8, ret_sz as u32);
            } else if ret_sz > 8 {
                ret_location = ArgLocation::pair_gpr_gpr(0, 1, ret_sz as u32);
            } else {
                ret_location = ArgLocation::direct_gpr(0, ret_sz as u32);
            }
        } else if ret_is_flt {
            ret_location = ArgLocation::direct_simd(0, ret_sz as u32);
        } else {
            ret_location = ArgLocation::direct_gpr(0, ret_sz as u32);
        }

        // 2. Classify parameters
        var p_idx: usize = 0;
        loop {
            if !(p_idx < params.len()) { break; }
            let p = params[p_idx];
            let sz = p.size_in_bytes as u32;

            if p.reg_class == 2 {
                if next_vec < 8 {
                    param_locs.push(ArgLocation::direct_simd(next_vec, sz));
                    next_vec = next_vec + 1;
                } else {
                    param_locs.push(ArgLocation::stack(stack_offset, sz));
                    stack_offset = stack_offset + ((sz + 7) & 0xFFFFFFF8);
                }
            } else if p.reg_class == 5 {
                var hfa: u8 = 0;
                if sz <= 32 {
                    hfa = aapcs64_hfa_count(abi_aggregate_fields(ref p), sz);
                }
                if hfa > 0 {
                    if next_vec + hfa <= 8 {
                        param_locs.push(aapcs64_hfa_location(next_vec, hfa, sz));
                        next_vec = next_vec + hfa;
                    } else {
                        // No partial HFAs: the rest of V0..V7 is closed.
                        next_vec = 8;
                        param_locs.push(ArgLocation::stack(stack_offset, sz));
                        stack_offset = stack_offset + ((sz + 7) & 0xFFFFFFF8);
                    }
                } else if sz <= 8 {
                    if next_gpr < 8 {
                        param_locs.push(ArgLocation::direct_gpr(next_gpr, sz));
                        next_gpr = next_gpr + 1;
                    } else {
                        param_locs.push(ArgLocation::stack(stack_offset, sz));
                        stack_offset = stack_offset + ((sz + 7) & 0xFFFFFFF8);
                    }
                } else if sz <= 16 {
                    if next_gpr + 1 < 8 {
                        param_locs.push(ArgLocation::pair_gpr_gpr(next_gpr, next_gpr + 1, sz));
                        next_gpr = next_gpr + 2;
                    } else {
                        param_locs.push(ArgLocation::stack(stack_offset, sz));
                        stack_offset = stack_offset + ((sz + 7) & 0xFFFFFFF8);
                    }
                } else {
                    // Struct > 16B passed by reference via pointer in GPR or stack
                    if next_gpr < 8 {
                        param_locs.push(ArgLocation::indirect(next_gpr, sz));
                        next_gpr = next_gpr + 1;
                    } else {
                        param_locs.push(ArgLocation::stack(stack_offset, 8));
                        stack_offset = stack_offset + 8;
                    }
                }
            } else {
                // Scalar integer or pointer
                if next_gpr < 8 {
                    param_locs.push(ArgLocation::direct_gpr(next_gpr, sz));
                    next_gpr = next_gpr + 1;
                } else {
                    param_locs.push(ArgLocation::stack(stack_offset, sz));
                    stack_offset = stack_offset + ((sz + 7) & 0xFFFFFFF8);
                }
            }

            p_idx = p_idx + 1;
        }

        // Align stack to 16 bytes
        let aligned_stack = if stack_offset > 0 { (stack_offset + 15) & 0xFFFFFFF0 } else { 0 };

        return AbiFramePlan {
            conv_id:             if .is_darwin { "darwin_arm64" } else { "aapcs64" },
            sret_uses_gpr0:      false, // Dedicated X8 sret register!
            ret_loc:             ret_location,
            param_locs:          param_locs,
            aligned_stack_bytes: aligned_stack,
        };
    }
}
