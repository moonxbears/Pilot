// ==============================================================================
// FILE: stdlib/pilot/vm.pilot
// Ring 3: Compiler-as-a-Library Deterministic VmSandbox (pub pkg pilot.vm;)
// Sandbox bookkeeping only: a config (fuel limit, heap and call-depth caps,
// capability mask) and helpers a caller invokes by hand to count fuel, test
// a capability and capture stdout. Nothing runs code under these limits:
// vm_sandbox_run is seam `pilot_vm.sandbox_run`, and the heap and
// call-depth caps are never checked.
// ==============================================================================
pub pkg pilot.vm;

use Pilot.Core.Flags;

[Flags]
pub enum VmCapability : u32 {
    ::None          = 0,
    ::Clock         = 1,
    ::RandomSeeded  = 2,
    ::StdoutCapture = 4,
    ::VirtualFs     = 8,
    ::HostFsRead    = 16,
    ::HostFsWrite   = 32,
    ::HostNet       = 64,
    ::HostFfi       = 128,
}

[Layout(c_abi)]
pub struct VmConfig : IValue {
    pub fuel_limit:     u64;
    pub max_heap_bytes: usize;
    pub max_call_depth: u32;
    pub capabilities:   FlagSet<VmCapability>;
}

pub pure fn vm_config_default() -> VmConfig {
    return VmConfig {
        fuel_limit:     100000,
        max_heap_bytes: 65536,
        max_call_depth: 64,
        capabilities:   flag_set(VmCapability::StdoutCapture),
    };
}

// The VMnnn codes noted below clash with the registry in
// selfhost/diagnostics/errors.pilot, where VM001 is "Bytecode Execution
// Trap" and VM002 is "Call Stack Depth Exceeded"; VM003-VM006 are not
// registered. Only the trap_msg strings here use them.
pub enum VmTrap : u8 {
    ::None                 = 0,
    ::FuelExhausted        = 1, // VM001
    ::HeapLimitExceeded    = 2, // VM002
    ::StackDepthExceeded   = 3, // VM003
    ::CapabilityDenied     = 4, // VM004
    ::DivisionByZero       = 5, // VM005
    ::AssertionFailed      = 6, // VM006
}

pub struct VmSandbox : IObject {
    pub config:     VmConfig;
    pub fuel_used:  u64;
    pub peak_heap:  usize;
    pub stdout_buf: str;
    pub is_trapped: bool;
    pub trap_code:  VmTrap;
    pub trap_msg:   str;

    ~self() {}
}

pub fn vm_sandbox_new(cfg: VmConfig) -> VmSandbox {
    return VmSandbox {
        config:     cfg,
        fuel_used:  0,
        peak_heap:  0,
        stdout_buf: "",
        is_trapped: false,
        trap_code:  VmTrap::None,
        trap_msg:   "",
    };
}

pub fn vm_sandbox_consume_fuel(var ref s: VmSandbox, amount: u64) -> bool {
    s.fuel_used = s.fuel_used + amount;
    if s.fuel_used > s.config.fuel_limit {
        s.is_trapped = true;
        s.trap_code = ::FuelExhausted;
        s.trap_msg = "VM001: Execution fuel exhausted";
        return false;
    }
    return true;
}

pub fn vm_sandbox_check_capability(var ref s: VmSandbox, cap: VmCapability, cap_name: str) -> bool {
    if !s.config.capabilities.has(cap) {
        s.is_trapped = true;
        s.trap_code = ::CapabilityDenied;
        s.trap_msg = "VM004: Capability denied: " + cap_name;
        return false;
    }
    return true;
}

pub fn vm_sandbox_write_stdout(var ref s: VmSandbox, piece: str) {
    if s.config.capabilities.has(VmCapability::StdoutCapture) {
        s.stdout_buf = s.stdout_buf + piece;
    }
}

/// Planned: run `source` inside the sandbox, charging fuel per instruction
/// and checking each host call against the capability mask, returning the
/// captured stdout. Not built; stops at seam `pilot_vm.sandbox_run`.
pub fn vm_sandbox_run(var ref s: VmSandbox, source: str) -> str {
    return seam("pilot_vm.sandbox_run", "the VM does not meter fuel, heap or capabilities through a sandbox");
}
