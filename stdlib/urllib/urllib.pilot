// ============================================================================
// 1. Errors & Exceptions (Python: urllib.error)
// ============================================================================

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __net_http_get(url: str) -> any;
    fn __net_http_post(url: str, body: str, content_type: str) -> any;
    fn __fs_write_text(path: str, content: str) -> any;
}

fn _parse_i64_or(val: any, fallback: i64) -> i64 {
    let opt = __parse_int_strict(str(val), 10);
    if __opt_is_some(opt) {
        return __opt_unwrap(opt);
    }
    return fallback;
}

pub struct URLError : IValue {
    pub:
        reason: str;
        args:   str[];

        self(reason: str) {
            .reason = reason;
            .args = [reason];
        }

        fn to_str() -> str {
            return f"<URLError: {self.reason}>";
        }
}

pub struct HTTPError : IValue {
    pub:
        url:     str;
        code:    i64;
        msg:     str;
        reason:  str;
        hdrs:    map;
        headers: map;
        fp:      any;
        args:    any[];

        self(url: str, code: i64, msg: str, hdrs: map, fp: any) {
            .url = url;
            .code = code;
            .msg = msg;
            .reason = msg;
            .hdrs = hdrs;
            .headers = hdrs;
            .fp = fp;
            .args = [code, msg];
        }

        fn to_str() -> str {
            return f"<HTTPError {self.code}: {self.msg}>";
        }
}

// ============================================================================
// 2. URL Parsing & Splitting (Python: urllib.parse)
// ============================================================================

const _HEX_CHARS: str = "0123456789ABCDEF";

fn _hex_to_int(ch: str) -> i64 {
    let c = ch.char_code_at(0);
    // 0-9
    if c >= 48 && c <= 57 {
        return c - 48;
    }
    // a-f
    if c >= 97 && c <= 102 {
        return c - 97 + 10;
    }
    // A-F
    if c >= 65 && c <= 70 {
        return c - 65 + 10;
    }
    return -1;
}

fn _int_to_hex(b: i64) -> str {
    let hi = (b >> 4) & 15;
    let lo = b & 15;
    return _HEX_CHARS[hi..(hi + 1)] + _HEX_CHARS[lo..(lo + 1)];
}

fn _is_unreserved(b: i64) -> bool {
    // A-Z
    if b >= 65 && b <= 90 { return true; }
    // a-z
    if b >= 97 && b <= 122 { return true; }
    // 0-9
    if b >= 48 && b <= 57 { return true; }
    // - _ . ~
    if b == 45 || b == 95 || b == 46 || b == 126 { return true; }
    return false;
}

/// Quotes characters in a string according to RFC 3986 percent-encoding.
pub fn quote(text: str, safe: str = "/") -> str {
    return url_quote(text, safe);
}

/// Quotes characters in a string according to RFC 3986 percent-encoding (alias avoiding `quote` keyword ambiguity).
pub fn url_quote(text: str, safe: str = "/") -> str {
    var out: str = "";
    let n = len(text);
    for i in 0..<n {
        let ch = text[i..(i + 1)];
        let b = ch.char_code_at(0);
        if _is_unreserved(b) || safe.contains(ch) {
            out = out + ch;
        } else {
            out = out + "%" + _int_to_hex(b);
        }
    }
    return out;
}

/// Quotes characters in a string, turning spaces into '+' (Python: quote_plus).
pub fn quote_plus(text: str, safe: str = "") -> str {
    var out: str = "";
    let n = len(text);
    for i in 0..<n {
        let ch = text[i..(i + 1)];
        if ch == " " {
            out = out + "+";
        } else {
            let b = ch.char_code_at(0);
            if _is_unreserved(b) || safe.contains(ch) {
                out = out + ch;
            } else {
                out = out + "%" + _int_to_hex(b);
            }
        }
    }
    return out;
}

/// Unquotes percent-encoded characters in a string (Python: unquote).
pub fn unquote(text: str) -> str {
    var out: str = "";
    let n = len(text);
    var i: i64 = 0;
    while i < n {
        let ch = text[i..(i + 1)];
        if ch == "%" && i + 2 < n {
            let h1 = _hex_to_int(text[(i + 1)..(i + 2)]);
            let h2 = _hex_to_int(text[(i + 2)..(i + 3)]);
            if h1 >= 0 && h2 >= 0 {
                let code = (h1 << 4) | h2;
                out = out + __char_from_code(code);
                i = i + 3;
                continue;
            }
        }
        out = out + ch;
        i = i + 1;
    }
    return out;
}

/// Unquotes percent-encoded characters in a string, replacing '+' with space (Python: unquote_plus).
pub fn unquote_plus(text: str) -> str {
    var unplussed: str = "";
    let n = len(text);
    for i in 0..<n {
        let ch = text[i..(i + 1)];
        if ch == "+" {
            unplussed = unplussed + " ";
        } else {
            unplussed = unplussed + ch;
        }
    }
    return unquote(unplussed);
}

/// URL encodes a map or list of pairs into a query string (Python: urllib.parse.urlencode).
pub fn urlencode(query: any, doseq: bool = false) -> str {
    var out: str = "";
    var first: bool = true;

    if type_of(query) == "map" {
        for k in query.keys() {
            let v = query[k];
            if doseq && type_of(v) == "list" {
                for item in v {
                    if !first { out = out + "&"; }
                    out = out + quote_plus(str(k)) + "=" + quote_plus(str(item));
                    first = false;
                }
            } else {
                if !first { out = out + "&"; }
                out = out + quote_plus(str(k)) + "=" + quote_plus(str(v));
                first = false;
            }
        }
    } else if type_of(query) == "list" {
        for pair in query {
            let k = pair[0];
            let v = pair[1];
            if doseq && type_of(v) == "list" {
                for item in v {
                    if !first { out = out + "&"; }
                    out = out + quote_plus(str(k)) + "=" + quote_plus(str(item));
                    first = false;
                }
            } else {
                if !first { out = out + "&"; }
                out = out + quote_plus(str(k)) + "=" + quote_plus(str(v));
                first = false;
            }
        }
    }
    return out;
}

/// Parses a query string into a map where values are lists of strings (Python: parse_qs).
pub fn parse_qs(qs: str, keep_blank_values: bool = false) -> map {
    var out = {};
    var clean: str = qs;
    if len(clean) > 0 && clean[0..1] == "?" {
        clean = clean[1..len(clean)];
    }
    if len(clean) == 0 {
        return out;
    }
    let pairs: str[] = clean.split("&");
    for pair in pairs {
        if len(pair) == 0 { continue; }
        let eq_idx: i64 = pair.index_of("=");
        var k: str = "";
        var v: str = "";
        if eq_idx < 0 {
            if keep_blank_values {
                k = unquote_plus(pair);
                v = "";
            } else {
                continue;
            }
        } else {
            k = unquote_plus(pair[0..eq_idx]);
            v = unquote_plus(pair[(eq_idx + 1)..len(pair)]);
        }
        if out.contains_key(k) {
            out[k].append(v);
        } else {
            out[k] = [v];
        }
    }
    return out;
}

/// Parses a query string into a list of [key, value] pairs (Python: parse_qsl).
pub fn parse_qsl(qs: str, keep_blank_values: bool = false) -> str[][] {
    var out = [];
    var clean: str = qs;
    if len(clean) > 0 && clean[0..1] == "?" {
        clean = clean[1..len(clean)];
    }
    if len(clean) == 0 {
        return out;
    }
    let pairs: str[] = clean.split("&");
    for pair in pairs {
        if len(pair) == 0 { continue; }
        let eq_idx: i64 = pair.index_of("=");
        var k: str = "";
        var v: str = "";
        if eq_idx < 0 {
            if keep_blank_values {
                k = unquote_plus(pair);
                v = "";
                out.append([k, v]);
            }
        } else {
            k = unquote_plus(pair[0..eq_idx]);
            v = unquote_plus(pair[(eq_idx + 1)..len(pair)]);
            out.append([k, v]);
        }
    }
    return out;
}

pub struct ParseResult : IValue {
    pub:
        scheme:   str;
        netloc:   str;
        path:     str;
        params:   str;
        query:    str;
        fragment: str;

        self(scheme: str, netloc: str, path: str, params: str, query: str, fragment: str) {
            .scheme = scheme;
            .netloc = netloc;
            .path = path;
            .params = params;
            .query = query;
            .fragment = fragment;
        }

        fn hostname() -> str {
            var h = self.netloc;
            if h.contains("@") {
                let at_idx = h.index_of("@");
                h = h[(at_idx + 1)..len(h)];
            }
            if h.contains(":") {
                let c_idx = h.index_of(":");
                h = h[0..c_idx];
            }
            return h;
        }

        fn port() -> i64 {
            var h = self.netloc;
            if h.contains("@") {
                let at_idx = h.index_of("@");
                h = h[(at_idx + 1)..len(h)];
            }
            if h.contains(":") {
                let c_idx = h.index_of(":");
                let p_str = h[(c_idx + 1)..len(h)];
                return _parse_i64_or(p_str, 0);
            }
            if self.scheme == "https" { return 443; }
            if self.scheme == "http" { return 80; }
            return 0;
        }

        fn username() -> str {
            if self.netloc.contains("@") {
                let at_idx = self.netloc.index_of("@");
                let userinfo = self.netloc[0..at_idx];
                if userinfo.contains(":") {
                    let c_idx = userinfo.index_of(":");
                    return userinfo[0..c_idx];
                }
                return userinfo;
            }
            return "";
        }

        fn password() -> str {
            if self.netloc.contains("@") {
                let at_idx = self.netloc.index_of("@");
                let userinfo = self.netloc[0..at_idx];
                if userinfo.contains(":") {
                    let c_idx = userinfo.index_of(":");
                    return userinfo[(c_idx + 1)..len(userinfo)];
                }
            }
            return "";
        }

        fn geturl() -> str {
            return urlunparse(self);
        }

        fn to_str() -> str {
            return f"ParseResult(scheme='{self.scheme}', netloc='{self.netloc}', path='{self.path}', params='{self.params}', query='{self.query}', fragment='{self.fragment}')";
        }
}

pub struct SplitResult : IValue {
    pub:
        scheme:   str;
        netloc:   str;
        path:     str;
        query:    str;
        fragment: str;

        self(scheme: str, netloc: str, path: str, query: str, fragment: str) {
            .scheme = scheme;
            .netloc = netloc;
            .path = path;
            .query = query;
            .fragment = fragment;
        }

        fn hostname() -> str {
            var h = self.netloc;
            if h.contains("@") {
                let at_idx = h.index_of("@");
                h = h[(at_idx + 1)..len(h)];
            }
            if h.contains(":") {
                let c_idx = h.index_of(":");
                h = h[0..c_idx];
            }
            return h;
        }

        fn port() -> i64 {
            var h = self.netloc;
            if h.contains("@") {
                let at_idx = h.index_of("@");
                h = h[(at_idx + 1)..len(h)];
            }
            if h.contains(":") {
                let c_idx = h.index_of(":");
                let p_str = h[(c_idx + 1)..len(h)];
                return _parse_i64_or(p_str, 0);
            }
            if self.scheme == "https" { return 443; }
            if self.scheme == "http" { return 80; }
            return 0;
        }

        fn geturl() -> str {
            return urlunsplit(self);
        }

        fn to_str() -> str {
            return f"SplitResult(scheme='{self.scheme}', netloc='{self.netloc}', path='{self.path}', query='{self.query}', fragment='{self.fragment}')";
        }
}

/// Parses a URL into 6 components: (scheme, netloc, path, params, query, fragment).
pub fn urlparse(urlstring: str, default_scheme: str = "", allow_fragments: bool = true) -> ParseResult {
    var rem: str = urlstring;
    var scheme: str = default_scheme;
    var netloc: str = "";
    var path: str = "";
    var params: str = "";
    var query: str = "";
    var fragment: str = "";

    // Fragment
    if allow_fragments {
        let hash_idx: i64 = rem.index_of("#");
        if hash_idx >= 0 {
            fragment = rem[(hash_idx + 1)..len(rem)];
            rem = rem[0..hash_idx];
        }
    }

    // Scheme
    let colon_idx: i64 = rem.index_of(":");
    let slash_idx: i64 = rem.index_of("/");
    if colon_idx >= 0 && (slash_idx < 0 || colon_idx < slash_idx) {
        scheme = rem[0..colon_idx];
        rem = rem[(colon_idx + 1)..len(rem)];
    }

    // Netloc
    if len(rem) >= 2 && rem[0..2] == "//" {
        rem = rem[2..len(rem)];
        let next_slash = rem.index_of("/");
        let next_q = rem.index_of("?");
        var end_netloc = len(rem);
        if next_slash >= 0 && next_slash < end_netloc {
            end_netloc = next_slash;
        }
        if next_q >= 0 && next_q < end_netloc {
            end_netloc = next_q;
        }
        netloc = rem[0..end_netloc];
        rem = rem[end_netloc..len(rem)];
    }

    // Query
    let q_idx = rem.index_of("?");
    if q_idx >= 0 {
        query = rem[(q_idx + 1)..len(rem)];
        rem = rem[0..q_idx];
    }

    // Params (e.g. path;params)
    let semi_idx = rem.index_of(";");
    if semi_idx >= 0 {
        params = rem[(semi_idx + 1)..len(rem)];
        path = rem[0..semi_idx];
    } else {
        path = rem;
    }

    return ParseResult(scheme, netloc, path, params, query, fragment);
}

/// Assembles a 6-tuple/ParseResult back into a complete URL string.
pub fn urlunparse(parts: ParseResult) -> str {
    var out: str = "";
    if len(parts.scheme) > 0 {
        out = out + parts.scheme + ":";
    }
    if len(parts.netloc) > 0 || (len(parts.scheme) > 0 && (parts.scheme == "http" || parts.scheme == "https")) {
        out = out + "//" + parts.netloc;
    }
    out = out + parts.path;
    if len(parts.params) > 0 {
        out = out + ";" + parts.params;
    }
    if len(parts.query) > 0 {
        out = out + "?" + parts.query;
    }
    if len(parts.fragment) > 0 {
        out = out + "#" + parts.fragment;
    }
    return out;
}

/// Parses a URL into 5 components: (scheme, netloc, path, query, fragment).
pub fn urlsplit(urlstring: str, default_scheme: str = "", allow_fragments: bool = true) -> SplitResult {
    let p = urlparse(urlstring, default_scheme, allow_fragments);
    let full_path = if len(p.params) > 0 { p.path + ";" + p.params } else { p.path };
    return SplitResult(p.scheme, p.netloc, full_path, p.query, p.fragment);
}

/// Assembles a SplitResult back into a complete URL string.
pub fn urlunsplit(parts: SplitResult) -> str {
    var out: str = "";
    if len(parts.scheme) > 0 {
        out = out + parts.scheme + ":";
    }
    if len(parts.netloc) > 0 || (len(parts.scheme) > 0 && (parts.scheme == "http" || parts.scheme == "https")) {
        out = out + "//" + parts.netloc;
    }
    out = out + parts.path;
    if len(parts.query) > 0 {
        out = out + "?" + parts.query;
    }
    if len(parts.fragment) > 0 {
        out = out + "#" + parts.fragment;
    }
    return out;
}

/// Joins a base URL and a possibly relative URL according to RFC 3986.
pub fn urljoin(base: str, url: str, allow_fragments: bool = true) -> str {
    if len(base) == 0 {
        return url;
    }
    if len(url) == 0 {
        return base;
    }
    let b = urlparse(base, "", allow_fragments);
    let u = urlparse(url, "", allow_fragments);

    if len(u.scheme) > 0 && u.scheme != b.scheme {
        return url;
    }
    let scheme = if len(u.scheme) > 0 { u.scheme } else { b.scheme };
    if len(u.netloc) > 0 {
        return urlunparse(ParseResult(scheme, u.netloc, u.path, u.params, u.query, u.fragment));
    }
    let netloc = b.netloc;
    var path = u.path;
    if len(path) == 0 {
        path = b.path;
        let query = if len(u.query) > 0 { u.query } else { b.query };
        return urlunparse(ParseResult(scheme, netloc, path, u.params, query, u.fragment));
    }

    if path[0..1] != "/" {
        let last_slash = b.path.last_index_of("/");
        if last_slash >= 0 {
            path = b.path[0..(last_slash + 1)] + path;
        } else {
            path = "/" + path;
        }
    }
    return urlunparse(ParseResult(scheme, netloc, path, u.params, u.query, u.fragment));
}

// ============================================================================
// 3. HTTP Request & Response (Python: urllib.request)
// ============================================================================

pub struct Request : IValue {
    pub:
        url:             str;
        data:            any;
        headers:         map;
        origin_req_host: str;
        unverifiable:    bool;
        _method:         str;

        self(
            url: str,
            data: any = none,
            headers: map = {},
            origin_req_host: str = "",
            unverifiable: bool = false,
            method: str = ""
        ) {
            var copied_headers: map = {};
            for k in headers.keys() {
                copied_headers[k] = headers[k];
            }
            .url = url;
            .data = data;
            .headers = copied_headers;
            .origin_req_host = origin_req_host;
            .unverifiable = unverifiable;
            ._method = method;
        }

        var fn add_header(key: str, val: str) {
            self.headers[key] = val;
        }

        fn get_header(key: str, default_val: str = "") -> str {
            if self.headers.contains_key(key) {
                return str(self.headers[key]);
            }
            return default_val;
        }

        fn has_header(key: str) -> bool {
            return self.headers.contains_key(key);
        }

        fn get_full_url() -> str {
            return self.url;
        }

        fn get_method() -> str {
            if len(self._method) > 0 {
                return self._method;
            }
            if self.data != none {
                return "POST";
            }
            return "GET";
        }
}

pub struct HTTPResponse : IValue {
    pub:
        url:     str;
        status:  i64;
        code:    i64;
        reason:  str;
        headers: map;
        body:    str;

        self(url: str, status: i64, reason: str, headers: map, body: str) {
            .url = url;
            .status = status;
            .code = status;
            .reason = reason;
            .headers = headers;
            .body = body;
        }

        fn read() -> str {
            return self.body;
        }

        fn getcode() -> i64 {
            return self.status;
        }

        fn geturl() -> str {
            return self.url;
        }

        fn info() -> map {
            return self.headers;
        }

        fn get_header(name: str, default_val: str = "") -> str {
            if self.headers.contains_key(name) {
                return str(self.headers[name]);
            }
            return default_val;
        }

        fn close() {
            // No-op for synchronous read response
        }
}

/// Synchronously opens a URL or Request object (Python: urllib.request.urlopen).
pub fn urlopen(url: any, data: any = none, timeout: f64 = 30.0) -> HTTPResponse {
    var target_url: str = "";
    var method: str = "GET";
    var content_type: str = "application/x-www-form-urlencoded";
    var body_str: str = "";

    if type_of(url) == "string" {
        target_url = url;
        if data != none {
            method = "POST";
            body_str = str(data);
        }
    } else if type_of(url) == "object" {
        target_url = url.get_full_url();
        method = url.get_method();
        if url.has_header("Content-Type") {
            content_type = url.get_header("Content-Type");
        }
        if url.data != none {
            body_str = str(url.data);
        }
    } else {
        target_url = str(url);
    }

    var resp_map: any = 0;
    if method == "POST" {
        resp_map = __net_http_post(target_url, body_str, content_type);
    } else {
        resp_map = __net_http_get(target_url);
    }

    var status: i64 = 200;
    var reason: str = "OK";
    var r_headers: map = {};
    var body: str = "";

    if type_of(resp_map) == "map" {
        if resp_map.contains_key("status") { status = _parse_i64_or(resp_map["status"], 200); }
        if resp_map.contains_key("reason") { reason = str(resp_map["reason"]); }
        if resp_map.contains_key("headers") { r_headers = resp_map["headers"]; }
        if resp_map.contains_key("body") { body = str(resp_map["body"]); }
    }

    return HTTPResponse(target_url, status, reason, r_headers, body);
}

/// Retrieves a resource at `url` and saves it to a local file (Python: urllib.request.urlretrieve).
pub fn urlretrieve(url: str, filename: str = "") -> any[] {
    let resp = urlopen(url);
    var dest: str = filename;
    if len(dest) == 0 {
        let p = urlparse(url);
        let last_slash = p.path.last_index_of("/");
        if last_slash >= 0 {
            dest = p.path[(last_slash + 1)..len(p.path)];
        }
        if len(dest) == 0 {
            dest = "downloaded_file";
        }
    }

    let body = resp.read();
    __fs_write_text(dest, body);

    return [dest, resp.headers];
}
