// SPDX-License-Identifier: MIT AND PSF-2.0
// std.pickle — Python-Compatible Binary Object Serialization Protocol
//
// Donor Origin: CPython Lib/pickle.py (Python Software Foundation License 2.0)
// Universal cross-architecture, multi-OS binary serializer and deserializer
// supporting primitive scalars, lists, maps, tuples, booleans, and null/none.
//
// Target OS Platforms:
//   - Linux (x86_64, aarch64, riscv64)
//   - Windows (x86_64, aarch64)
//   - macOS (Apple Silicon arm64, Intel x86_64)
//   - Android (aarch64, armv7, x86_64)
//   - iOS (arm64)
//   - WebAssembly (wasm32-wasi, wasm32-unknown)

pub pkg Pilot.Pickle;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Io.Fs as std_fs;

// Protocol version constants
pub const HIGHEST_PROTOCOL: i64 = 5;
pub const DEFAULT_PROTOCOL: i64 = 4;

// Magic 4-byte header: "PILP" (Pilot Pickle)
pub const MAGIC_0: i64 = 80;  // 'P'
pub const MAGIC_1: i64 = 73;  // 'I'
pub const MAGIC_2: i64 = 76;  // 'L'
pub const MAGIC_3: i64 = 80;  // 'P'

// Wire protocol opcodes
pub const OP_NONE: i64       = 78;  // 'N'
pub const OP_BOOL_TRUE: i64  = 84;  // 'T'
pub const OP_BOOL_FALSE: i64 = 70;  // 'F'
pub const OP_INT_POS: i64    = 43;  // '+'
pub const OP_INT_NEG: i64    = 45;  // '-'
pub const OP_FLOAT: i64      = 71;  // 'G'
pub const OP_STRING: i64     = 83;  // 'S'
pub const OP_LIST: i64       = 91;  // ']'
pub const OP_MAP: i64        = 125; // '}'
pub const OP_TUPLE: i64      = 41;  // ')'
pub const OP_STOP: i64       = 46;  // '.'

/// Error returned when an error occurs during pickling or unpickling.
/// Python reference: pickle.PickleError
pub struct PickleError : IValue {
    pub:
        msg: str;

        self(msg: str) {
            .msg = msg;
        }

        fn to_string() -> str {
            return f"PickleError: {self.msg}";
        }
}

/// Error returned when an object cannot be pickled.
/// Python reference: pickle.PicklingError
pub struct PicklingError : IValue {
    pub:
        msg: str;

        self(msg: str) {
            .msg = msg;
        }

        fn to_string() -> str {
            return f"PicklingError: {self.msg}";
        }
}

/// Error returned when an object cannot be unpickled.
/// Python reference: pickle.UnpicklingError
pub struct UnpicklingError : IValue {
    pub:
        msg: str;

        self(msg: str) {
            .msg = msg;
        }

        fn to_string() -> str {
            return f"UnpicklingError: {self.msg}";
        }
}

fn _write_u32_be(out: any, val: i64) {
    out.append((val >> 24) & 255);
    out.append((val >> 16) & 255);
    out.append((val >> 8) & 255);
    out.append(val & 255);
}

fn _write_u64_be(out: any, val: i64) {
    out.append((val >> 56) & 255);
    out.append((val >> 48) & 255);
    out.append((val >> 40) & 255);
    out.append((val >> 32) & 255);
    out.append((val >> 24) & 255);
    out.append((val >> 16) & 255);
    out.append((val >> 8) & 255);
    out.append(val & 255);
}

fn _read_u32_be(bytes_data: any, pos: i64) -> tuple<i64, i64> {
    let b0: i64 = bytes_data[pos];
    let b1: i64 = bytes_data[pos + 1];
    let b2: i64 = bytes_data[pos + 2];
    let b3: i64 = bytes_data[pos + 3];
    let res: i64 = (b0 << 24) | (b1 << 16) | (b2 << 8) | b3;
    return (res, pos + 4);
}

fn _read_u64_be(bytes_data: any, pos: i64) -> tuple<i64, i64> {
    let b0: i64 = bytes_data[pos];
    let b1: i64 = bytes_data[pos + 1];
    let b2: i64 = bytes_data[pos + 2];
    let b3: i64 = bytes_data[pos + 3];
    let b4: i64 = bytes_data[pos + 4];
    let b5: i64 = bytes_data[pos + 5];
    let b6: i64 = bytes_data[pos + 6];
    let b7: i64 = bytes_data[pos + 7];
    let res: i64 = (b0 << 56) | (b1 << 48) | (b2 << 40) | (b3 << 32)
                 | (b4 << 24) | (b5 << 16) | (b6 << 8) | b7;
    return (res, pos + 8);
}

fn _serialize_value(out: any, val: any) {
    if __opt_is_none(val) {
        out.append(OP_NONE);
        return;
    }

    let kind: str = type_of(val);

    if kind == "bool" {
        if val {
            out.append(OP_BOOL_TRUE);
        } else {
            out.append(OP_BOOL_FALSE);
        }
        return;
    }

    if kind == "i64" || kind == "int" || kind == "u64" || kind == "uint" {
        let n: i64 = val;
        if n >= 0 {
            out.append(OP_INT_POS);
            _write_u64_be(out, n);
        } else {
            out.append(OP_INT_NEG);
            _write_u64_be(out, 0 - n);
        }
        return;
    }

    if kind == "f64" || kind == "float" {
        out.append(OP_FLOAT);
        let s = str(val);
        let s_len: i64 = len(s);
        _write_u32_be(out, s_len);
        for i in 0..<s_len {
            out.append(s.char_code_at(i));
        }
        return;
    }

    if kind == "str" || kind == "string" {
        out.append(OP_STRING);
        let s: str = val;
        let s_len: i64 = len(s);
        _write_u32_be(out, s_len);
        for i in 0..<s_len {
            out.append(s.char_code_at(i));
        }
        return;
    }

    if kind == "list" {
        out.append(OP_LIST);
        let count: i64 = len(val);
        _write_u32_be(out, count);
        for elem in val {
            _serialize_value(out, elem);
        }
        return;
    }

    if kind == "map" {
        out.append(OP_MAP);
        let keys_list = val.keys();
        let count: i64 = len(keys_list);
        _write_u32_be(out, count);
        for k in keys_list {
            _serialize_value(out, k);
            _serialize_value(out, val[k]);
        }
        return;
    }

    if kind == "tuple" {
        out.append(OP_TUPLE);
        let count: i64 = len(val);
        _write_u32_be(out, count);
        for i in 0..<count {
            _serialize_value(out, val[i]);
        }
        return;
    }

    // Fallback representation for unknown or user objects
    out.append(OP_STRING);
    let fallback_str = str(val);
    let fb_len: i64 = len(fallback_str);
    _write_u32_be(out, fb_len);
    for i in 0..<fb_len {
        out.append(fallback_str.char_code_at(i));
    }
}

fn _deserialize_value(bytes_data: any, pos: i64) -> tuple<any, i64> {
    if pos >= len(bytes_data) {
        panic("Unexpected end of pickle byte stream");
    }

    let op: i64 = bytes_data[pos];
    var cur_pos: i64 = pos + 1;

    if op == OP_NONE {
        return (none, cur_pos);
    }
    if op == OP_BOOL_TRUE {
        return (true, cur_pos);
    }
    if op == OP_BOOL_FALSE {
        return (false, cur_pos);
    }

    if op == OP_INT_POS {
        let pair = _read_u64_be(bytes_data, cur_pos);
        return (pair[0], pair[1]);
    }
    if op == OP_INT_NEG {
        let pair = _read_u64_be(bytes_data, cur_pos);
        let mag: i64 = pair[0];
        return (0 - mag, pair[1]);
    }

    if op == OP_FLOAT {
        let len_pair = _read_u32_be(bytes_data, cur_pos);
        let s_len: i64 = len_pair[0];
        cur_pos = len_pair[1];
        var s = "";
        for _i in 0..<s_len {
            s = s + __char_from_code(bytes_data[cur_pos]);
            cur_pos = cur_pos + 1;
        }
        let flt_opt = __parse_float_strict(s);
        let flt_val: f64 = if __opt_is_some(flt_opt) { __opt_unwrap(flt_opt) } else { 0.0 };
        return (flt_val, cur_pos);
    }

    if op == OP_STRING {
        let len_pair = _read_u32_be(bytes_data, cur_pos);
        let s_len: i64 = len_pair[0];
        cur_pos = len_pair[1];
        var s = "";
        for _i in 0..<s_len {
            s = s + __char_from_code(bytes_data[cur_pos]);
            cur_pos = cur_pos + 1;
        }
        return (s, cur_pos);
    }

    if op == OP_LIST {
        let count_pair = _read_u32_be(bytes_data, cur_pos);
        let count: i64 = count_pair[0];
        cur_pos = count_pair[1];
        var list_out = [];
        for _i in 0..<count {
            let elem_pair = _deserialize_value(bytes_data, cur_pos);
            list_out.append(elem_pair[0]);
            cur_pos = elem_pair[1];
        }
        return (list_out, cur_pos);
    }

    if op == OP_MAP {
        let count_pair = _read_u32_be(bytes_data, cur_pos);
        let count: i64 = count_pair[0];
        cur_pos = count_pair[1];
        var map_out = {};
        for _i in 0..<count {
            let key_pair = _deserialize_value(bytes_data, cur_pos);
            cur_pos = key_pair[1];
            let val_pair = _deserialize_value(bytes_data, cur_pos);
            cur_pos = val_pair[1];
            map_out[key_pair[0]] = val_pair[0];
        }
        return (map_out, cur_pos);
    }

    if op == OP_TUPLE {
        let count_pair = _read_u32_be(bytes_data, cur_pos);
        let count: i64 = count_pair[0];
        cur_pos = count_pair[1];
        var tuple_items = [];
        for _i in 0..<count {
            let elem_pair = _deserialize_value(bytes_data, cur_pos);
            tuple_items.append(elem_pair[0]);
            cur_pos = elem_pair[1];
        }
        return (tuple_items, cur_pos);
    }

    panic(f"Unknown pickle opcode: {op}");
}

/// Pickler object encapsulating the state of a binary serialization.
/// Python reference: pickle.Pickler(file, protocol=None, *, fix_imports=True, buffer_callback=None)
pub struct Pickler : IValue {
    pub:
        protocol: i64;

        self(protocol: i64 = 4) {
            .protocol = protocol;
        }

        fn dump(obj: any) -> i64[] {
            var out = [MAGIC_0, MAGIC_1, MAGIC_2, MAGIC_3, self.protocol];
            _serialize_value(out, obj);
            out.append(OP_STOP);
            return out;
        }
}

/// Unpickler object reading from a serialized byte stream.
/// Python reference: pickle.Unpickler(file, *, fix_imports=True, encoding="ASCII", errors="strict", buffers=None)
pub struct Unpickler : IValue {
    pub:
        data: i64[];

        self(data: i64[]) {
            .data = data;
        }

        fn load() -> any {
            let n: i64 = len(self.data);
            if n < 5 {
                panic("Data is too short to be a valid Pilot pickle stream");
            }
            if self.data[0] != MAGIC_0 || self.data[1] != MAGIC_1 || self.data[2] != MAGIC_2 || self.data[3] != MAGIC_3 {
                panic("Invalid magic header in pickle stream");
            }
            let pair = _deserialize_value(self.data, 5);
            return pair[0];
        }
}

/// Serializes an object hierarchy to a byte array.
/// Python reference: pickle.dumps(obj, protocol=None, *, fix_imports=True, buffer_callback=None)
pub fn dumps(obj: any, protocol: i64 = 4) -> i64[] {
    let p = Pickler(protocol);
    return p.dump(obj);
}

/// Deserializes an object hierarchy from a byte array.
/// Python reference: pickle.loads(data, /, *, fix_imports=True, encoding="ASCII", errors="strict", buffers=None)
pub fn loads(bytes_data: i64[]) -> any {
    let u = Unpickler(bytes_data);
    return u.load();
}

/// Writes serialized binary bytes of obj to a file path.
/// Python reference: pickle.dump(obj, file, protocol=None, *, fix_imports=True, buffer_callback=None)
pub fn dump(obj: any, file_path: str, protocol: i64 = 4) -> bool {
    let bytes_out = dumps(obj, protocol);
    var s = "";
    for b in bytes_out {
        s = s + __char_from_code(b);
    }
    let res = std_fs.write_text(file_path, s);
    return !__result_is_err(res);
}

/// Reads serialized binary bytes from a file path and reconstructs the object.
/// Python reference: pickle.load(file, *, fix_imports=True, encoding="ASCII", errors="strict", buffers=None)
pub fn load(file_path: str) -> any {
    let text_res = std_fs.read_text(file_path);
    if __result_is_err(text_res) {
        panic(f"Failed to read pickle file: {file_path}");
    }
    let content: str = __result_unwrap_ok(text_res);
    var bytes_in = [];
    let n: i64 = len(content);
    for i in 0..<n {
        bytes_in.append(content.char_code_at(i));
    }
    return loads(bytes_in);
}
