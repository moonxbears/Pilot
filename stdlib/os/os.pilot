// std.os — Operating System Interfaces across Linux, Windows, macOS, Android, iOS
// Modeled after Python's `os` module (CPython Lib/os.py scaffold)

pub pkg Pilot.Os;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Io.Path as std_path;
use Pilot.Io.Fs as std_fs;

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __os_platform() -> str;
    fn __os_arch() -> str;
    fn __os_family() -> str;
    fn __os_is_windows() -> bool;
    fn __os_is_linux() -> bool;
    fn __os_is_macos() -> bool;
    fn __os_is_android() -> bool;
    fn __os_is_ios() -> bool;
    fn __os_getenv(name: str) -> str;
    fn __os_setenv(name: str, val: str) -> bool;
    fn __os_unsetenv(name: str) -> bool;
    fn __os_environ() -> str[];
    fn __os_getpid() -> i64;
    fn __os_getppid() -> i64;
    fn __os_getuid() -> i64;
    fn __os_getgid() -> i64;
    fn __os_cpu_count() -> i64;
    fn __os_system(cmd: str) -> i64;
    fn __os_cwd() -> str;
    fn __os_homedir() -> str;
    fn __os_chdir(path: str) -> bool;
    fn __os_temp_dir() -> str;
    fn __os_abort();
}

// ============================================================================
// 1. OS Constants & Path Separators (Python: os.sep, os.pathsep, etc.)
// ============================================================================

pub fn name() -> str {
    if is_windows() {
        return "nt";
    }
    return "posix";
}

pub fn sep() -> str {
    if is_windows() {
        return "\\";
    }
    return "/";
}

pub fn altsep() -> str {
    if is_windows() {
        return "/";
    }
    return "";
}

pub fn pathsep() -> str {
    if is_windows() {
        return ";";
    }
    return ":";
}

pub fn linesep() -> str {
    if is_windows() {
        return "\r\n";
    }
    return "\n";
}

pub fn devnull() -> str {
    if is_windows() {
        return "nul";
    }
    return "/dev/null";
}

pub fn curdir() -> str {
    return ".";
}

pub fn pardir() -> str {
    return "..";
}

pub fn extsep() -> str {
    return ".";
}

pub fn defpath() -> str {
    if is_windows() {
        return ".;C:\\bin";
    }
    return "/bin:/usr/bin";
}

// ============================================================================
// 2. Multi-OS Target Detection (Linux, Windows, macOS, Android, iOS)
// ============================================================================

pub fn is_windows() -> bool {
    return __os_is_windows();
}

pub fn is_linux() -> bool {
    return __os_is_linux();
}

pub fn is_macos() -> bool {
    return __os_is_macos();
}

pub fn is_android() -> bool {
    return __os_is_android();
}

pub fn is_ios() -> bool {
    return __os_is_ios();
}

pub fn is_posix() -> bool {
    return !is_windows();
}

pub fn platform() -> str {
    if is_windows() {
        return "windows";
    } else if is_android() {
        return "android";
    } else if is_ios() {
        return "ios";
    } else if is_macos() {
        return "macos";
    } else if is_linux() {
        return "linux";
    }
    return __os_platform();
}

pub fn family() -> str {
    if is_windows() {
        return "windows";
    }
    return "posix";
}

// ============================================================================
// 3. Environment Variables (Python: os.getenv, os.environ, os.putenv, os.unsetenv)
// ============================================================================

pub fn getenv(key: str, default_val: str = "") -> str {
    let val = __os_getenv(key);
    if len(val) == 0 {
        return default_val;
    }
    return val;
}

pub fn hasenv(key: str) -> bool {
    let val = __os_getenv(key);
    return len(val) > 0;
}

pub fn setenv(key: str, val: str) -> bool {
    return __os_setenv(key, val);
}

pub fn putenv(key: str, val: str) -> bool {
    return __os_setenv(key, val);
}

pub fn unsetenv(key: str) -> bool {
    return __os_unsetenv(key);
}

pub fn environ() -> str[] {
    return __os_environ();
}

// ============================================================================
// 4. Working Directory & Navigation (Python: os.getcwd, os.chdir)
// ============================================================================

pub fn getcwd() -> str {
    return std_path.normalize(__os_cwd());
}

pub fn chdir(path: str) -> bool {
    return __os_chdir(path);
}

pub fn homedir() -> str {
    let home_int = __os_homedir();
    if len(home_int) > 0 {
        return std_path.normalize(home_int);
    }
    if is_windows() {
        let userprofile = getenv("USERPROFILE");
        if len(userprofile) > 0 {
            return std_path.normalize(userprofile);
        }
        let drive = getenv("HOMEDRIVE");
        let path = getenv("HOMEPATH");
        if len(drive) > 0 && len(path) > 0 {
            return std_path.normalize(drive + path);
        }
        return "C:\\";
    }
    let unix_home = getenv("HOME");
    if len(unix_home) > 0 {
        return std_path.normalize(unix_home);
    }
    return "/";
}

pub fn tempdir() -> str {
    let tmp_int = __os_temp_dir();
    if len(tmp_int) > 0 {
        return std_path.normalize(tmp_int);
    }
    if is_windows() {
        let t1 = getenv("TEMP");
        if len(t1) > 0 {
            return std_path.normalize(t1);
        }
        let t2 = getenv("TMP");
        if len(t2) > 0 {
            return std_path.normalize(t2);
        }
        return "C:\\Windows\\Temp";
    }
    let t_unix = getenv("TMPDIR");
    if len(t_unix) > 0 {
        return std_path.normalize(t_unix);
    }
    return "/tmp";
}

// ============================================================================
// 5. Process & User Information (Python: os.getpid, os.getuid, os.cpu_count)
// ============================================================================

pub fn getpid() -> i64 {
    return __os_getpid();
}

pub fn getppid() -> i64 {
    return __os_getppid();
}

pub fn getuid() -> i64 {
    if is_windows() {
        return 0;
    }
    return __os_getuid();
}

pub fn getgid() -> i64 {
    if is_windows() {
        return 0;
    }
    return __os_getgid();
}

pub fn cpu_count() -> i64 {
    let count = __os_cpu_count();
    if count <= 0 {
        return 1;
    }
    return count;
}

// ============================================================================
// 6. Filesystem Operations (Python: os.listdir, os.mkdir, os.remove, os.rename)
// ============================================================================

pub fn listdir(path: str = ".") -> str[] {
    let res = std_fs.list_dir(path);
    switch res {
        case ok(entries):
            return entries;
        case fail(_):
            return [];
    }
}

pub fn mkdir(path: str) -> bool {
    let res = std_fs.create_dir(path, false);
    switch res {
        case ok(val):
            return val;
        case fail(_):
            return false;
    }
}

pub fn makedirs(path: str, exist_ok: bool = false) -> bool {
    if exist_ok && std_fs.exists(path) {
        return true;
    }
    let res = std_fs.create_dir(path, true);
    switch res {
        case ok(val):
            return val;
        case fail(_):
            return false;
    }
}

pub fn remove(path: str) -> bool {
    let res = std_fs.remove_file(path);
    switch res {
        case ok(val):
            return val;
        case fail(_):
            return false;
    }
}

pub fn unlink(path: str) -> bool {
    return remove(path);
}

pub fn rmdir(path: str) -> bool {
    let res = std_fs.remove_dir(path, false);
    switch res {
        case ok(val):
            return val;
        case fail(_):
            return false;
    }
}

pub fn removedirs(path: str) -> bool {
    let res = std_fs.remove_dir(path, true);
    switch res {
        case ok(val):
            return val;
        case fail(_):
            return false;
    }
}

pub fn rename(src: str, dst: str) -> bool {
    let res = std_fs.move_file(src, dst, true);
    switch res {
        case ok(val):
            return val;
        case fail(_):
            return false;
    }
}

pub fn replace(src: str, dst: str) -> bool {
    return rename(src, dst);
}

pub fn truncate(path: str, length: i64) -> bool {
    if length == 0 {
        let res = std_fs.write_text(path, "");
        switch res {
            case ok(_):
                return true;
            case fail(_):
                return false;
        }
    } else {
        return std_fs.exists(path);
    }
}

// ============================================================================
// 7. Stat & Metadata (Python: os.stat, os.stat_result)
// ============================================================================

pub struct StatResult : IValue {
    pub:
        size:    i64;
        is_dir:  bool;
        is_file: bool;
        mode:    i64;

        self(size: i64, is_dir: bool, is_file: bool, mode: i64) {
            .size = size;
            .is_dir = is_dir;
            .is_file = is_file;
            .mode = mode;
        }
}

pub fn stat(path: str) -> StatResult {
    var sz: i64 = 0;
    let sz_res = std_fs.file_size(path);
    switch sz_res {
        case ok(s):
            sz = s;
        case fail(_):
            sz = 0;
    }
    let is_d = std_fs.is_dir(path);
    let is_f = std_fs.is_file(path);
    var m: i64 = 0;
    if is_d {
        m = 16877; // 0o040755
    } else if is_f {
        m = 33188; // 0o100644
    }
    return StatResult(sz, is_d, is_f, m);
}

pub fn lstat(path: str) -> StatResult {
    return stat(path);
}

// ============================================================================
// 8. Process Execution & System Commands (Python: os.system, os.abort)
// ============================================================================

pub fn system(command: str) -> i64 {
    return __os_system(command);
}

pub fn abort() -> void {
    __os_abort();
}

pub fn strerror(code: i64) -> str {
    switch code {
        case 0:
            return "Success";
        case 1:
            return "Operation not permitted (EPERM)";
        case 2:
            return "No such file or directory (ENOENT)";
        case 13:
            return "Permission denied (EACCES)";
        case 17:
            return "File exists (EEXIST)";
        case 20:
            return "Not a directory (ENOTDIR)";
        case 21:
            return "Is a directory (EISDIR)";
        case 22:
            return "Invalid argument (EINVAL)";
        case 28:
            return "No space left on device (ENOSPC)";
        default:
            return "Unknown operating system error";
    }
}
