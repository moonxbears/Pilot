use Pilot.Core.Builtins.*;

/// A Future represents an eventual result of an asynchronous operation.
/// Python reference: asyncio.Future(*, loop=None)
pub struct Future : IValue {
    pub:
        _result:    any;
        _exception: any;
        _state:     str;
        _callbacks: any[];

        self() {
            ._result = none;
            ._exception = none;
            ._state = "PENDING"; // PENDING, FINISHED, CANCELLED
            ._callbacks = [];
        }

        /// Return the result of the Future.
        /// Python reference: asyncio.Future.result()
        fn result() -> any {
            if self._state == "CANCELLED" {
                panic("CancelledError: Future was cancelled");
            }
            if self._state != "FINISHED" {
                panic("InvalidStateError: Result is not ready");
            }
            if self._exception != none {
                panic(f"Future completed with exception: {self._exception}");
            }
            return self._result;
        }

        /// Mark the Future as done and set its result.
        /// Python reference: asyncio.Future.set_result(result)
        var fn set_result(val: any) {
            if self._state != "PENDING" {
                panic("InvalidStateError: Future is already resolved");
            }
            self._result = val;
            self._state = "FINISHED";
            self._invoke_callbacks();
        }

        /// Mark the Future as done and set an exception.
        /// Python reference: asyncio.Future.set_exception(exception)
        var fn set_exception(err: any) {
            if self._state != "PENDING" {
                panic("InvalidStateError: Future is already resolved");
            }
            self._exception = err;
            self._state = "FINISHED";
            self._invoke_callbacks();
        }

        /// Return True if the Future is done (cancelled or has result).
        /// Python reference: asyncio.Future.done()
        fn done() -> bool {
            return self._state != "PENDING";
        }

        /// Return True if the Future was cancelled.
        /// Python reference: asyncio.Future.cancelled()
        fn cancelled() -> bool {
            return self._state == "CANCELLED";
        }

        /// Cancel the Future and schedule callbacks.
        /// Python reference: asyncio.Future.cancel()
        var fn cancel() -> bool {
            if self._state != "PENDING" {
                return false;
            }
            self._state = "CANCELLED";
            self._invoke_callbacks();
            return true;
        }

        /// Add a callback to be run when the Future is done.
        /// Python reference: asyncio.Future.add_done_callback(fn, *, context=None)
        var fn add_done_callback(callback: any) {
            if self.done() {
                callback(self);
            } else {
                self._callbacks.append(callback);
            }
        }

        var fn _invoke_callbacks() {
            for cb in self._callbacks {
                cb(self);
            }
            self._callbacks = [];
        }
}

var _TASK_ID_COUNTER: i64 = 0;

/// A Task object executes a coroutine in an event loop.
/// Python reference: asyncio.Task(coro, *, loop=None, name=None, context=None)
pub struct Task : IValue {
    pub:
        _id:     i64;
        _name:   str;
        _coro:   any;
        _future: Future;

        self(coro: any, name: str = "") {
            _TASK_ID_COUNTER = _TASK_ID_COUNTER + 1;
            let next_id: i64 = _TASK_ID_COUNTER;
            ._id = next_id;
            ._name = if len(name) > 0 { name } else { f"Task-{next_id}" };
            ._coro = coro;
            ._future = Future();
        }

        fn get_coro() -> any {
            return self._coro;
        }

        fn get_name() -> str {
            return self._name;
        }

        fn done() -> bool {
            return self._future.done();
        }

        fn result() -> any {
            return self._future.result();
        }

        var fn cancel() -> bool {
            return self._future.cancel();
        }

        var fn add_done_callback(callback: any) {
            self._future.add_done_callback(callback);
        }

        /// Executes one evaluation step of the underlying task.
        var fn step() {
            if self._future.done() {
                return;
            }
            let coro_fn = self._coro;
            let res = coro_fn();
            self._future.set_result(res);
        }
}

/// Cooperative asynchronous Event Loop managing task scheduling and I/O.
/// Python reference: asyncio.AbstractEventLoop
pub struct EventLoop : IValue {
    pub:
        _tasks:        any[];
        _callbacks:    any[];
        _is_running:   bool;
        _is_closed:    bool;
        _current_time: f64;

        self() {
            ._tasks = [];
            ._callbacks = [];
            ._is_running = false;
            ._is_closed = false;
            ._current_time = 0.0;
        }

        /// Run the event loop until the future or coroutine is done.
        /// Python reference: asyncio.AbstractEventLoop.run_until_complete(future)
        var fn run_until_complete(target: any) -> any {
            if self._is_closed {
                panic("Event loop is closed");
            }
            self._is_running = true;

            let kind: str = type_of(target);
            var main_task: Task = if kind == "Task" { target } else { Task(target, "main") };

            self._tasks.append(main_task);

            while !main_task.done() && len(self._tasks) > 0 {
                var t = self._tasks[0];
                self._tasks.remove_at(0);
                t.step();

                // Run pending callbacks
                while len(self._callbacks) > 0 {
                    let cb = self._callbacks[0];
                    self._callbacks.remove_at(0);
                    cb();
                }
            }

            self._is_running = false;
            return main_task.result();
        }

        /// Run the event loop until stop() is called.
        /// Python reference: asyncio.AbstractEventLoop.run_forever()
        var fn run_forever() {
            self._is_running = true;
            while self._is_running && len(self._tasks) > 0 {
                var t = self._tasks[0];
                self._tasks.remove_at(0);
                t.step();
            }
            self._is_running = false;
        }

        /// Stop the event loop.
        /// Python reference: asyncio.AbstractEventLoop.stop()
        var fn stop() {
            self._is_running = false;
        }

        /// Close the event loop.
        /// Python reference: asyncio.AbstractEventLoop.close()
        var fn close() {
            self._is_running = false;
            self._is_closed = true;
            self._tasks = [];
            self._callbacks = [];
        }

        fn is_running() -> bool {
            return self._is_running;
        }

        fn is_closed() -> bool {
            return self._is_closed;
        }

        /// Schedule a callback to be called with arguments as soon as possible.
        /// Python reference: asyncio.AbstractEventLoop.call_soon(callback, *args)
        var fn call_soon(callback: any) {
            self._callbacks.append(callback);
        }

        /// Return the current time as a float value in seconds.
        /// Python reference: asyncio.AbstractEventLoop.time()
        fn time() -> f64 {
            return self._current_time;
        }

        /// Wrap a coroutine into a Task and schedule its execution.
        /// Python reference: asyncio.AbstractEventLoop.create_task(coro, *, name=None, context=None)
        var fn create_task(coro: any, name: str = "") -> Task {
            let t = Task(coro, name);
            self._tasks.append(t);
            return t;
        }

        /// Create an asyncio.Future object attached to the event loop.
        /// Python reference: asyncio.AbstractEventLoop.create_future()
        fn create_future() -> Future {
            return Future();
        }
}

var _GLOBAL_LOOP: EventLoop = EventLoop();

/// Return an event loop.
/// Python reference: asyncio.get_event_loop()
pub fn get_event_loop() -> EventLoop {
    return _GLOBAL_LOOP;
}

/// Set ev_loop as the current event loop.
/// Python reference: asyncio.set_event_loop(loop)
pub fn set_event_loop(ev_loop: EventLoop) {
    _GLOBAL_LOOP = ev_loop;
}

/// Create and return a new event loop.
/// Python reference: asyncio.new_event_loop()
pub fn new_event_loop() -> EventLoop {
    return EventLoop();
}

/// Execute the coroutine coro and return the result.
/// Creates a new event loop, runs the coroutine to completion, and closes the loop.
/// Python reference: asyncio.run(coro, *, debug=None, loop_factory=None)
pub fn run(coro: any) -> any {
    var ev_loop = new_event_loop();
    let res = ev_loop.run_until_complete(coro);
    ev_loop.close();
    return res;
}

/// Wrap the coro coroutine into a Task and schedule its execution. Return the Task object.
/// Python reference: asyncio.create_task(coro, *, name=None, context=None)
pub fn create_task(coro: any, name: str = "") -> Task {
    return _GLOBAL_LOOP.create_task(coro, name);
}

/// Run awaitable objects in the aws sequence concurrently. Returns an aggregated list of results.
/// Python reference: asyncio.gather(*aws, return_exceptions=False)
pub fn gather(tasks_or_coros: any) -> any[] {
    var results = [];
    for item in tasks_or_coros {
        let kind: str = type_of(item);
        if kind == "Task" {
            item.step();
            results.append(item.result());
        } else {
            var t = Task(item);
            t.step();
            results.append(t.result());
        }
    }
    return results;
}

/// Non-blocking sleep for delay seconds, yielding control to the event loop.
/// Python reference: asyncio.sleep(delay, result=None)
pub fn sleep(delay: f64 = 0.0, result: any = none) -> any {
    return result;
}

/// Wait for the single awaitable to complete with a timeout limit.
/// Python reference: asyncio.wait_for(fut, timeout)
pub fn wait_for(fut: any, timeout: f64) -> any {
    let kind: str = type_of(fut);
    if kind == "Task" {
        fut.step();
        return fut.result();
    } else {
        var t = Task(fut);
        t.step();
        return t.result();
    }
}

/// Asynchronous mutual exclusion lock.
/// Python reference: asyncio.Lock()
pub struct AsyncLock : IValue {
    pub:
        _locked: bool;

        self() {
            ._locked = false;
        }

        var fn acquire() -> bool {
            if !self._locked {
                self._locked = true;
                return true;
            }
            return true;
        }

        var fn release() {
            if !self._locked {
                panic("release unlocked lock");
            }
            self._locked = false;
        }

        fn locked() -> bool {
            return self._locked;
        }
}

/// Asynchronous event object.
/// Python reference: asyncio.Event()
pub struct AsyncEvent : IValue {
    pub:
        _set: bool;

        self() {
            ._set = false;
        }

        fn is_set() -> bool {
            return self._set;
        }

        var fn set() {
            self._set = true;
        }

        var fn clear() {
            self._set = false;
        }

        fn wait() -> bool {
            return self._set;
        }
}

/// Asynchronous FIFO queue.
/// Python reference: asyncio.Queue(maxsize=0)
pub struct AsyncQueue : IValue {
    pub:
        _maxsize: i64;
        _items:   any[];

        self(maxsize: i64 = 0) {
            ._maxsize = maxsize;
            ._items = [];
        }

        var fn put(item: any) {
            self._items.append(item);
        }

        var fn gets() -> any {
            if len(self._items) == 0 {
                return none;
            }
            let item = self._items[0];
            self._items.remove_at(0);
            return item;
        }

        fn empty() -> bool {
            return len(self._items) == 0;
        }

        fn qsize() -> i64 {
            return len(self._items);
        }
}

// ==============================================================================
// PilVM-Executable Cooperative Event Loop, Futures, Tasks, Channels & `select`
// ==============================================================================

pub fn async_future_new() -> i64 {
    let fut = __engine("map_new");
    __engine("map_set", fut, "__async_magic", "__async_task_v1");
    __engine("map_set", fut, "kind", "Future");
    __engine("map_set", fut, "state", "PENDING");
    __engine("map_set", fut, "is_completed", false);
    __engine("map_set", fut, "has_result", 0);
    __engine("map_set", fut, "has_error", 0);
    return fut;
}

pub fn async_future_resolve(fut: i64, val: any) -> i64 {
    if __engine("map_get", fut, "state") == "PENDING" {
        __engine("map_set", fut, "result", val);
        __engine("map_set", fut, "has_result", 1);
        __engine("map_set", fut, "is_completed", true);
        __engine("map_set", fut, "state", "FINISHED");
    }
    return fut;
}

pub fn async_future_reject(fut: i64, err_msg: str) -> i64 {
    if __engine("map_get", fut, "state") == "PENDING" {
        __engine("map_set", fut, "error", err_msg);
        __engine("map_set", fut, "has_error", 1);
        __engine("map_set", fut, "is_completed", true);
        __engine("map_set", fut, "state", "FINISHED");
    }
    return fut;
}

pub fn async_future_cancel(fut: i64) -> bool {
    if __engine("map_get", fut, "state") != "PENDING" {
        return false;
    }
    __engine("map_set", fut, "is_completed", true);
    __engine("map_set", fut, "state", "CANCELLED");
    return true;
}

pub fn async_future_status(fut: i64) -> str {
    let nil;
    let st = __engine("map_get", fut, "state");
    if st != nil { return st; }
    return "FINISHED";
}

pub fn async_future_is_done(fut: i64) -> bool {
    return async_future_status(fut) != "PENDING";
}

pub fn async_future_is_cancelled(fut: i64) -> bool {
    return async_future_status(fut) == "CANCELLED";
}

pub fn async_await(fut_or_val: any) -> any {
    let nil;
    let k = __engine("map_get", fut_or_val, "kind");
    if k == "Future" || k == "Task" || __engine("map_get", fut_or_val, "__async_magic") == "__async_task_v1" {
        if __engine("map_get", fut_or_val, "state") == "PENDING" {
            let pending_val = __engine("map_get", fut_or_val, "pending_val");
            if pending_val != nil {
                __engine("map_set", fut_or_val, "result", pending_val);
                __engine("map_set", fut_or_val, "has_result", 1);
            }
            __engine("map_set", fut_or_val, "is_completed", true);
            __engine("map_set", fut_or_val, "state", "FINISHED");
        }
        return __engine("map_get", fut_or_val, "result");
    }
    return fut_or_val;
}

pub fn async_loop_new() -> i64 {
    let ev = __engine("map_new");
    __engine("map_set", ev, "kind", "EventLoop");
    __engine("map_set", ev, "tick", 0);
    __engine("map_set", ev, "task_count", 0);
    __engine("map_set", ev, "completed_count", 0);
    __engine("map_set", ev, "closed", 0);
    return ev;
}

pub fn async_spawn_task(ev_loop: i64, name: str, ready_after_ticks: i64, computed_val: any) -> i64 {
    let idx = __engine("map_get", ev_loop, "task_count");
    let now_tick = __engine("map_get", ev_loop, "tick");
    let task_h = __engine("map_new");
    __engine("map_set", task_h, "__async_magic", "__async_task_v1");
    __engine("map_set", task_h, "kind", "Task");
    __engine("map_set", task_h, "id", idx + 1);
    __engine("map_set", task_h, "name", name);
    __engine("map_set", task_h, "state", "PENDING");
    __engine("map_set", task_h, "is_completed", false);
    __engine("map_set", task_h, "ready_tick", now_tick + ready_after_ticks);
    __engine("map_set", task_h, "pending_val", computed_val);
    __engine("map_set", task_h, "result", computed_val);
    __engine("map_set", ev_loop, "task_" + idx, task_h);
    __engine("map_set", ev_loop, "task_count", idx + 1);
    return task_h;
}

pub fn async_loop_step(ev_loop: i64) -> i64 {
    let next_tick = __engine("map_get", ev_loop, "tick") + 1;
    __engine("map_set", ev_loop, "tick", next_tick);
    let cnt = __engine("map_get", ev_loop, "task_count");
    var newly_done = 0;
    var i = 0;
    while i < cnt {
        let t = __engine("map_get", ev_loop, "task_" + i);
        if __engine("map_get", t, "state") == "PENDING" {
            let rtick = __engine("map_get", t, "ready_tick");
            if next_tick >= rtick {
                let pv = __engine("map_get", t, "pending_val");
                __engine("map_set", t, "result", pv);
                __engine("map_set", t, "has_result", 1);
                __engine("map_set", t, "is_completed", true);
                __engine("map_set", t, "state", "FINISHED");
                newly_done = newly_done + 1;
            }
        }
        i = i + 1;
    }
    let prev_done = __engine("map_get", ev_loop, "completed_count");
    __engine("map_set", ev_loop, "completed_count", prev_done + newly_done);
    return newly_done;
}

pub fn async_loop_run_until_complete(ev_loop: i64, target_task: i64) -> any {
    var safety = 0;
    while !async_future_is_done(target_task) && safety < 256 {
        async_loop_step(ev_loop);
        safety = safety + 1;
    }
    return async_await(target_task);
}

pub fn async_channel_new(capacity: i64) -> i64 {
    let ch = __engine("map_new");
    __engine("map_set", ch, "kind", "Channel");
    __engine("map_set", ch, "cap", capacity);
    __engine("map_set", ch, "head", 0);
    __engine("map_set", ch, "tail", 0);
    __engine("map_set", ch, "closed", 0);
    return ch;
}

pub fn async_channel_len(ch: i64) -> i64 {
    return __engine("map_get", ch, "tail") - __engine("map_get", ch, "head");
}

pub fn async_channel_send(ch: i64, val: any) -> bool {
    if __engine("map_get", ch, "closed") == 1 { return false; }
    let cap = __engine("map_get", ch, "cap");
    if cap > 0 && async_channel_len(ch) >= cap {
        return false;
    }
    let tl = __engine("map_get", ch, "tail");
    __engine("map_set", ch, "slot_" + tl, val);
    __engine("map_set", ch, "tail", tl + 1);
    return true;
}

pub fn async_channel_recv(ch: i64) -> any {
    let nil;
    let hd = __engine("map_get", ch, "head");
    let tl = __engine("map_get", ch, "tail");
    if hd >= tl { return nil; }
    let v = __engine("map_get", ch, "slot_" + hd);
    __engine("map_set", ch, "head", hd + 1);
    return v;
}

pub fn async_channel_close(ch: i64) -> void {
    __engine("map_set", ch, "closed", 1);
}

// Multiplexes readiness across two channels (`select` semantics: returns 1 for `ch1`, 2 for `ch2`, 0 if empty)
pub fn async_select_ready(ch1: i64, ch2: i64) -> i64 {
    if async_channel_len(ch1) > 0 { return 1; }
    if async_channel_len(ch2) > 0 { return 2; }
    return 0;
}

pub fn async_lock_new() -> i64 {
    let lk = __engine("map_new");
    __engine("map_set", lk, "locked", 0);
    return lk;
}

pub fn async_lock_acquire(lk: i64) -> bool {
    if __engine("map_get", lk, "locked") == 1 { return false; }
    __engine("map_set", lk, "locked", 1);
    return true;
}

pub fn async_lock_release(lk: i64) -> void {
    __engine("map_set", lk, "locked", 0);
}

pub fn async_event_new() -> i64 {
    let ev = __engine("map_new");
    __engine("map_set", ev, "set", 0);
    return ev;
}

pub fn async_event_set(ev: i64) -> void {
    __engine("map_set", ev, "set", 1);
}

pub fn async_event_clear(ev: i64) -> void {
    __engine("map_set", ev, "set", 0);
}

pub fn async_event_is_set(ev: i64) -> bool {
    return __engine("map_get", ev, "set") == 1;
}
