// =========================================================================
// FILE: stdlib/asyncio/select_syntax.pilot
// OPT-IN STRUCTURED CONCURRENCY (`async`, `await`, `spawn`, `select`, `<-`)
// =========================================================================
pub pkg Pilot.Asyncio.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    // `async fn` is not built yet (docs/keyword_roadmap.md K7): every use
    // stops at the seam `keyword.unbuilt` instead of being ignored.
    __engine("register_modifier", nameof(async), "keyword_unbuilt");
    // Not built yet (docs/keyword_roadmap.md K7): where a declaration or
    // statement starts (receptor 40, place 1) each stops at the seam
    // `keyword.unbuilt`; elsewhere each is an ordinary name. `bounded` waits
    // for decision D9 and `actor` for D6.
    __engine("bind_receptor", nameof(actor),     40, 1);
    __engine("bind_receptor", nameof(timeout),   40, 1);
    __engine("bind_receptor", nameof(bounded),   40, 1);
    // `.pchor` choreography words written in a `.pilot` file (K7).
    __engine("bind_receptor", nameof(blueprint), 40, 1);
    __engine("bind_receptor", nameof(cue),       40, 1);
    __engine("bind_receptor", nameof(role),      40, 1);
    __engine("bind_receptor", nameof(route),     40, 1);
    __engine("bind_receptor", nameof(select),  33, 7);

    __engine("register_pratt_op", "<-", infix,  5,  right);
    __engine("register_pratt_op", "<-", prefix, 80, right);
}

// None of these is built yet (docs/keyword_roadmap.md phase K7). Each rule
// stops at its seam before its argument runs, instead of running the body at
// once and pretending (audit 2.3: `spawn` ran its body immediately, `sync`,
// `atomic` and `isolate` only set a flag, `select` only ran its arms).
pub syntax {
    spawn(body) => quote {
        seam("concurrency.spawn", "running a task concurrently needs a task scheduler on OS threads (structured concurrency, M83)")
    };
    await(fut) => quote {
        seam("concurrency.await", "waiting for a task needs tasks that run concurrently (`spawn`, M83)")
    };
    sync(body) => quote {
        seam("concurrency.sync", "holding a lock around a block needs OS threads and a lock intrinsic")
    };
    atomic(body) => quote {
        seam("concurrency.atomic", "running a block or update atomically needs atomic hardware instructions as engine intrinsics")
    };
    isolate(body) => quote {
        seam("concurrency.isolate", "isolating a memory region from other threads needs threads and a checked isolation boundary")
    };
    select(arms) => quote {
        seam("concurrency.select", "choosing the first ready channel operation needs channels between concurrent tasks (M83)")
    };
}

pub pure fn is_async_construct(word: str) -> bool {
    return word == nameof(async)
        || word == nameof(await)
        || word == nameof(spawn)
        || word == nameof(select)
        || word == nameof(sync)
        || word == nameof(atomic)
        || word == nameof(isolate);
}
