// =========================================================================
// FILE: stdlib/asyncio/select_syntax.pilot
// OPT-IN STRUCTURED CONCURRENCY (`async`, `await`, `spawn`, `select`, `<-`)
// =========================================================================
pub pkg Pilot.Asyncio.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    __engine("register_modifier", nameof(async), "effect_async");
    __engine("bind_receptor", nameof(select),  33, 7);

    __engine("register_pratt_op", "<-", infix,  5,  right);
    __engine("register_pratt_op", "<-", prefix, 80, right);
}

pub syntax {
    spawn(body) => quote {
        let __spawn_val = $body;
        let __spawn_task = __engine("map_new");
        __engine("map_set", __spawn_task, "__async_magic", "__async_task_v1");
        __engine("map_set", __spawn_task, "kind", "Task");
        __engine("map_set", __spawn_task, "state", "PENDING");
        __engine("map_set", __spawn_task, "is_completed", false);
        __engine("map_set", __spawn_task, "result", __spawn_val)
    };
    await(fut) => quote {
        let __await_in = $fut;
        if __engine("map_get", __await_in, "__async_magic") == "__async_task_v1" {
            __engine("map_set", __await_in, "state", "FINISHED");
            __engine("map_set", __await_in, "is_completed", true);
            __engine("map_get", __await_in, "result")
        } else {
            __await_in
        }
    };
    sync(body) => quote {
        {
            let __sync_prev = __engine("map_get", __engine("get_env"), "__sync_active");
            __engine("map_set", __engine("get_env"), "__sync_active", 1);
            let __sync_res = $body;
            __engine("map_set", __engine("get_env"), "__sync_active", __sync_prev);
            __sync_res
        }
    };
    atomic(body) => quote {
        {
            let __atomic_prev = __engine("map_get", __engine("get_env"), "__atomic_active");
            __engine("map_set", __engine("get_env"), "__atomic_active", 1);
            let __atomic_res = $body;
            __engine("map_set", __engine("get_env"), "__atomic_active", __atomic_prev);
            __atomic_res
        }
    };
    isolate(body) => quote {
        {
            let __iso_prev = __engine("map_get", __engine("get_env"), "__isolated_active");
            __engine("map_set", __engine("get_env"), "__isolated_active", 1);
            let __iso_res = $body;
            __engine("map_set", __engine("get_env"), "__isolated_active", __iso_prev);
            __iso_res
        }
    };
    select(arms) => quote {
        {
            let __sel_ctx = __engine("map_new");
            __engine("map_set", __sel_ctx, "__async_select", 1);
            $arms
        }
    };
}

pub pure fn is_async_construct(word: str) -> bool {
    return word == nameof(async)
        || word == nameof(await)
        || word == nameof(spawn)
        || word == nameof(select)
        || word == nameof(sync)
        || word == nameof(atomic)
        || word == nameof(isolate);
}
