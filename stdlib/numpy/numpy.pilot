// Modeled after Python's `numpy` package (NumPy License: BSD-3-Clause)
// Compatible with Linux, Windows, macOS, Android, iOS, and WebAssembly targets.

pub pkg Pilot.Numpy;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

pub const pi: f64 = 3.14159265358979323846;
pub const e: f64 = 2.71828182845904523536;

// ============================================================================
// 1. Multidimensional Array (Python: numpy.ndarray)
// ============================================================================

pub struct ndarray : IValue {
    pub:
        data:  f64[];
        shape: i64[];
        ndim:  i64;
        dtype: str;
        size:  i64;

        self(data: f64[], shape: i64[], dtype: str = "float64") {
            self.data = data;
            self.shape = shape;
            self.ndim = len(shape);
            self.dtype = dtype;

            var total_size: i64 = 1;
            for dim in shape {
                total_size = total_size * dim;
            }
            self.size = total_size;
        }

        fn item(index: i64) -> f64 {
            if index >= 0 && index < len(self.data) {
                return self.data[index];
            }
            return 0.0;
        }

        fn at2d(r: i64, c: i64) -> f64 {
            if self.ndim == 2 && r >= 0 && r < self.shape[0] && c >= 0 && c < self.shape[1] {
                let idx: i64 = r * self.shape[1] + c;
                return self.data[idx];
            }
            return 0.0;
        }

        var fn set2d(r: i64, c: i64, val: f64) {
            if self.ndim == 2 && r >= 0 && r < self.shape[0] && c >= 0 && c < self.shape[1] {
                let idx: i64 = r * self.shape[1] + c;
                self.data[idx] = val;
            }
        }

        fn reshape(new_shape: i64[]) -> ndarray {
            var new_size: i64 = 1;
            for dim in new_shape {
                new_size = new_size * dim;
            }
            if new_size != self.size {
                // Dimension mismatch, return clone of current
                return ndarray(self.data, self.shape, self.dtype);
            }
            return ndarray(self.data, new_shape, self.dtype);
        }

        fn flatten() -> ndarray {
            return ndarray(self.data, [self.size], self.dtype);
        }

        fn tolist() -> any[] {
            if self.ndim == 1 {
                var out: any[] = [];
                for val in self.data {
                    out.append(val);
                }
                return out;
            }
            if self.ndim == 2 {
                var out_2d: any[] = [];
                let rows: i64 = self.shape[0];
                let cols: i64 = self.shape[1];
                for r in 0..<rows {
                    var row_list: any[] = [];
                    for c in 0..<cols {
                        row_list.append(self.at2d(r, c));
                    }
                    out_2d.append(row_list);
                }
                return out_2d;
            }
            var flat_out: any[] = [];
            for val in self.data {
                flat_out.append(val);
            }
            return flat_out;
        }

        fn transpose() -> ndarray {
            if self.ndim != 2 {
                return ndarray(self.data, self.shape, self.dtype);
            }
            let rows: i64 = self.shape[0];
            let cols: i64 = self.shape[1];
            var transposed_data: f64[] = [];
            for c in 0..<cols {
                for r in 0..<rows {
                    transposed_data.append(self.at2d(r, c));
                }
            }
            return ndarray(transposed_data, [cols, rows], self.dtype);
        }

        fn sum() -> f64 {
            var s: f64 = 0.0;
            for val in self.data {
                s = s + val;
            }
            return s;
        }

        fn mean() -> f64 {
            if self.size == 0 {
                return 0.0;
            }
            return self.sum() / f64(self.size);
        }

        fn variance() -> f64 {
            if self.size == 0 {
                return 0.0;
            }
            let avg: f64 = self.mean();
            var variance_sum: f64 = 0.0;
            for val in self.data {
                let diff: f64 = val - avg;
                variance_sum = variance_sum + diff * diff;
            }
            return variance_sum / f64(self.size);
        }

        fn std() -> f64 {
            return sqrt(self.variance());
        }

        fn min() -> f64 {
            if len(self.data) == 0 {
                return 0.0;
            }
            var m: f64 = self.data[0];
            for val in self.data {
                if val < m {
                    m = val;
                }
            }
            return m;
        }

        fn max() -> f64 {
            if len(self.data) == 0 {
                return 0.0;
            }
            var m: f64 = self.data[0];
            for val in self.data {
                if val > m {
                    m = val;
                }
            }
            return m;
        }

        fn argmin() -> i64 {
            if len(self.data) == 0 {
                return -1;
            }
            var best_idx: i64 = 0;
            var min_val: f64 = self.data[0];
            for i in 1..<len(self.data) {
                if self.data[i] < min_val {
                    min_val = self.data[i];
                    best_idx = i;
                }
            }
            return best_idx;
        }

        fn argmax() -> i64 {
            if len(self.data) == 0 {
                return -1;
            }
            var best_idx: i64 = 0;
            var max_val: f64 = self.data[0];
            for i in 1..<len(self.data) {
                if self.data[i] > max_val {
                    max_val = self.data[i];
                    best_idx = i;
                }
            }
            return best_idx;
        }

        fn add(other: any) -> ndarray {
            let t: str = type_of(other);
            var res_data: f64[] = [];
            if t == "int" || t == "float" {
                let scalar: f64 = f64(other);
                for val in self.data {
                    res_data.append(val + scalar);
                }
            } else if t == "object" {
                for i in 0..<self.size {
                    res_data.append(self.data[i] + other.data[i]);
                }
            }
            return ndarray(res_data, self.shape, self.dtype);
        }

        fn sub(other: any) -> ndarray {
            let t: str = type_of(other);
            var res_data: f64[] = [];
            if t == "int" || t == "float" {
                let scalar: f64 = f64(other);
                for val in self.data {
                    res_data.append(val - scalar);
                }
            } else if t == "object" {
                for i in 0..<self.size {
                    res_data.append(self.data[i] - other.data[i]);
                }
            }
            return ndarray(res_data, self.shape, self.dtype);
        }

        fn mul(other: any) -> ndarray {
            let t: str = type_of(other);
            var res_data: f64[] = [];
            if t == "int" || t == "float" {
                let scalar: f64 = f64(other);
                for val in self.data {
                    res_data.append(val * scalar);
                }
            } else if t == "object" {
                for i in 0..<self.size {
                    res_data.append(self.data[i] * other.data[i]);
                }
            }
            return ndarray(res_data, self.shape, self.dtype);
        }

        fn div(other: any) -> ndarray {
            let t: str = type_of(other);
            var res_data: f64[] = [];
            if t == "int" || t == "float" {
                let scalar: f64 = f64(other);
                for val in self.data {
                    res_data.append(val / scalar);
                }
            } else if t == "object" {
                for i in 0..<self.size {
                    res_data.append(self.data[i] / other.data[i]);
                }
            }
            return ndarray(res_data, self.shape, self.dtype);
        }

        fn dot(other: ndarray) -> ndarray {
            if self.ndim == 2 && other.ndim == 2 {
                let m: i64 = self.shape[0];
                let k: i64 = self.shape[1];
                let n: i64 = other.shape[1];
                var out_data: f64[] = [];
                for r in 0..<m {
                    for c in 0..<n {
                        var dot_sum: f64 = 0.0;
                        for i in 0..<k {
                            dot_sum = dot_sum + self.at2d(r, i) * other.at2d(i, c);
                        }
                        out_data.append(dot_sum);
                    }
                }
                return ndarray(out_data, [m, n]);
            }
            var dot_sum: f64 = 0.0;
            let count: i64 = min(self.size, other.size);
            for i in 0..<count {
                dot_sum = dot_sum + self.data[i] * other.data[i];
            }
            return ndarray([dot_sum], [1]);
        }

        fn to_str() -> str {
            if self.ndim == 1 {
                var s: str = "array([";
                var first: bool = true;
                for val in self.data {
                    if !first { s = s + ", "; }
                    s = s + str(val);
                    first = false;
                }
                s = s + "])";
                return s;
            }
            if self.ndim == 2 {
                var s: str = "array([";
                let rows: i64 = self.shape[0];
                let cols: i64 = self.shape[1];
                for r in 0..<rows {
                    if r > 0 { s = s + ",\n       "; }
                    s = s + "[";
                    for c in 0..<cols {
                        if c > 0 { s = s + ", "; }
                        s = s + str(self.at2d(r, c));
                    }
                    s = s + "]";
                }
                s = s + "])";
                return s;
            }
            return f"array(shape={self.shape}, size={self.size})";
        }
}

// ============================================================================
// 2. Array Creation Routines (Python: numpy.array, zeros, ones, arange, etc.)
// ============================================================================

pub fn array(data: any) -> ndarray {
    let t: str = type_of(data);
    if t == "object" {
        return data;
    }
    if t == "list" {
        if len(data) == 0 {
            return ndarray([], [0]);
        }
        let first_elem_type: str = type_of(data[0]);
        if first_elem_type == "list" {
            // 2D Array
            let rows: i64 = len(data);
            let cols: i64 = len(data[0]);
            var flat_data: f64[] = [];
            for row in data {
                for item in row {
                    flat_data.append(f64(item));
                }
            }
            return ndarray(flat_data, [rows, cols]);
        }
        // 1D Array
        var flat_data: f64[] = [];
        for item in data {
            flat_data.append(f64(item));
        }
        return ndarray(flat_data, [len(data)]);
    }
    return ndarray([f64(data)], [1]);
}

pub fn zeros(shape: any) -> ndarray {
    var dims: i64[] = [];
    if type_of(shape) == "int" {
        dims = [i64(shape)];
    } else if type_of(shape) == "list" {
        for d in shape {
            dims.append(i64(d));
        }
    }
    var total: i64 = 1;
    for d in dims { total = total * d; }
    var data: f64[] = [];
    for _i in 0..<total {
        data.append(0.0);
    }
    return ndarray(data, dims);
}

pub fn ones(shape: any) -> ndarray {
    var dims: i64[] = [];
    if type_of(shape) == "int" {
        dims = [i64(shape)];
    } else if type_of(shape) == "list" {
        for d in shape {
            dims.append(i64(d));
        }
    }
    var total: i64 = 1;
    for d in dims { total = total * d; }
    var data: f64[] = [];
    for _i in 0..<total {
        data.append(1.0);
    }
    return ndarray(data, dims);
}

pub fn full(shape: any, fill_value: f64) -> ndarray {
    var dims: i64[] = [];
    if type_of(shape) == "int" {
        dims = [i64(shape)];
    } else if type_of(shape) == "list" {
        for d in shape {
            dims.append(i64(d));
        }
    }
    var total: i64 = 1;
    for d in dims { total = total * d; }
    var data: f64[] = [];
    for _i in 0..<total {
        data.append(fill_value);
    }
    return ndarray(data, dims);
}

pub fn arange(start: f64, stop: f64 = 0.0, step: f64 = 1.0) -> ndarray {
    var s: f64 = start;
    var end_val: f64 = stop;
    var st: f64 = step;
    if stop == 0.0 && step == 1.0 && start > 0.0 {
        end_val = start;
        s = 0.0;
    }
    var data: f64[] = [];
    var cur: f64 = s;
    if st > 0.0 {
        while cur < end_val {
            data.append(cur);
            cur = cur + st;
        }
    } else if st < 0.0 {
        while cur > end_val {
            data.append(cur);
            cur = cur + st;
        }
    }
    return ndarray(data, [len(data)]);
}

pub fn linspace(start: f64, stop: f64, num: i64 = 50) -> ndarray {
    if num <= 0 {
        return ndarray([], [0]);
    }
    if num == 1 {
        return ndarray([start], [1]);
    }
    let step: f64 = (stop - start) / f64(num - 1);
    var data: f64[] = [];
    for i in 0..<num {
        data.append(start + f64(i) * step);
    }
    return ndarray(data, [num]);
}

pub fn eye(n: i64, m: i64 = -1) -> ndarray {
    let cols: i64 = if m > 0 { m } else { n };
    var data: f64[] = [];
    for r in 0..<n {
        for col in 0..<cols {
            if r == col {
                data.append(1.0);
            } else {
                data.append(0.0);
            }
        }
    }
    return ndarray(data, [n, cols]);
}

pub fn identity(n: i64) -> ndarray {
    return eye(n, n);
}

// ============================================================================
// 3. Mathematical & Linear Algebra Functions (Python: numpy.dot, matmul, etc.)
// ============================================================================

pub fn matmul(a: ndarray, b: ndarray) -> ndarray {
    // 2D x 2D matrix multiplication
    if a.ndim == 2 && b.ndim == 2 {
        let m: i64 = a.shape[0];
        let k: i64 = a.shape[1];
        let n: i64 = b.shape[1];
        var out_data: f64[] = [];
        for r in 0..<m {
            for c in 0..<n {
                var dot_sum: f64 = 0.0;
                for i in 0..<k {
                    dot_sum = dot_sum + a.at2d(r, i) * b.at2d(i, c);
                }
                out_data.append(dot_sum);
            }
        }
        return ndarray(out_data, [m, n]);
    }
    // 1D x 1D vector dot product
    if a.ndim == 1 && b.ndim == 1 {
        var dot_sum: f64 = 0.0;
        let n: i64 = min(a.size, b.size);
        for i in 0..<n {
            dot_sum = dot_sum + a.data[i] * b.data[i];
        }
        return ndarray([dot_sum], [1]);
    }
    return ndarray([], [0]);
}

pub fn dot(a: ndarray, b: ndarray) -> any {
    if a.ndim == 1 && b.ndim == 1 {
        let res = matmul(a, b);
        return res.item(0);
    }
    return matmul(a, b);
}

pub fn sin_arr(a: ndarray) -> ndarray {
    var out: f64[] = [];
    for val in a.data { out.append(sin(val)); }
    return ndarray(out, a.shape, a.dtype);
}

pub fn cos_arr(a: ndarray) -> ndarray {
    var out: f64[] = [];
    for val in a.data { out.append(cos(val)); }
    return ndarray(out, a.shape, a.dtype);
}

pub fn exp_arr(a: ndarray) -> ndarray {
    var out: f64[] = [];
    for val in a.data { out.append(exp(val)); }
    return ndarray(out, a.shape, a.dtype);
}

pub fn sqrt_arr(a: ndarray) -> ndarray {
    var out: f64[] = [];
    for val in a.data { out.append(sqrt(val)); }
    return ndarray(out, a.shape, a.dtype);
}

pub fn sum_arr(a: ndarray) -> f64 {
    return a.sum();
}

pub fn mean_arr(a: ndarray) -> f64 {
    return a.mean();
}

pub fn std_arr(a: ndarray) -> f64 {
    return a.std();
}

pub fn min_arr(a: ndarray) -> f64 {
    return a.min();
}

pub fn max_arr(a: ndarray) -> f64 {
    return a.max();
}

pub fn clip(a: ndarray, a_min: f64, a_max: f64) -> ndarray {
    var out: f64[] = [];
    for val in a.data {
        if val < a_min {
            out.append(a_min);
        } else if val > a_max {
            out.append(a_max);
        } else {
            out.append(val);
        }
    }
    return ndarray(out, a.shape, a.dtype);
}

pub fn concatenate(arrays: ndarray[], axis: i64 = 0) -> ndarray {
    if len(arrays) == 0 {
        return ndarray([], [0]);
    }
    if axis == 0 {
        var merged_data: f64[] = [];
        var total_rows: i64 = 0;
        let cols: i64 = if arrays[0].ndim == 2 { arrays[0].shape[1] } else { 1 };
        for arr in arrays {
            for v in arr.data {
                merged_data.append(v);
            }
            total_rows = total_rows + (if arr.ndim == 2 { arr.shape[0] } else { arr.size });
        }
        if arrays[0].ndim == 2 {
            return ndarray(merged_data, [total_rows, cols]);
        }
        return ndarray(merged_data, [total_rows]);
    }
    return arrays[0];
}
