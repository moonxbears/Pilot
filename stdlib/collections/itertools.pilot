// High-performance, memory-efficient combinatorial & sequence building blocks
// targeting Linux, Windows, macOS, Android, iOS, and WebAssembly.
//
// API Reference Mappings to Python itertools:
//   - Infinite Iterators: count, cycle, repeat
//   - Shortest-Input Combinators: accumulate, batched, chain, compress, dropwhile (drop_while),
//     filterfalse (filter_false), groupby (group_by), islice, pairwise, starmap, takewhile (take_while),
//     tee, zip_longest
//   - Combinatoric Generators: product, permutations, combinations, combinations_with_replacement
//   - Extended Sequence Utilities: chunk, window, frequencies, partition, scan, reduce, unique

pub pkg Pilot.Collections.Itertools;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

fn _collect_list(items: any) -> any[] {
    var out = [];
    for x in items {
        out.append(x);
    }
    return out;
}

pub fn enumerate(items: any, start: i64 = 0) -> any[] {
    var out = [];
    var idx: i64 = start;
    for item in items {
        out.append((idx, item));
        idx = idx + 1;
    }
    return out;
}

pub fn zip(seq_a: any, seq_b: any) -> any[] {
    let list_a = _collect_list(seq_a);
    let list_b = _collect_list(seq_b);
    let n: i64 = min(len(list_a), len(list_b));
    var out = [];
    for i in 0..<n {
        out.append((list_a[i], list_b[i]));
    }
    return out;
}

pub fn zip_longest(seq_a: any, seq_b: any, fill_val: any = none) -> any[] {
    let list_a = _collect_list(seq_a);
    let list_b = _collect_list(seq_b);
    let n: i64 = max(len(list_a), len(list_b));
    var out = [];
    for i in 0..<n {
        let va = if i < len(list_a) { list_a[i] } else { fill_val };
        let vb = if i < len(list_b) { list_b[i] } else { fill_val };
        out.append((va, vb));
    }
    return out;
}

pub fn chain(seq_a: any, seq_b: any) -> any[] {
    var out = [];
    for x in seq_a {
        out.append(x);
    }
    for y in seq_b {
        out.append(y);
    }
    return out;
}

pub fn flatten(nested_seqs: any) -> any[] {
    var out = [];
    for sub in nested_seqs {
        for item in sub {
            out.append(item);
        }
    }
    return out;
}

pub fn chunk(items: any, size: i64) -> any[] {
    if size <= 0 {
        panic("itertools.chunk requires size > 0");
    }
    let src = _collect_list(items);
    let n: i64 = len(src);
    var batches = [];
    var i: i64 = 0;
    while i < n {
        let end_idx: i64 = min(i + size, n);
        var batch = [];
        for j in i..<end_idx {
            batch.append(src[j]);
        }
        batches.append(batch);
        i = end_idx;
    }
    return batches;
}

pub fn window(items: any, width: i64, step: i64 = 1) -> any[] {
    if width <= 0 || step <= 0 {
        panic("itertools.window requires width > 0 and step > 0");
    }
    let src = _collect_list(items);
    let n: i64 = len(src);
    var wins = [];
    var i: i64 = 0;
    while i + width <= n {
        var w = [];
        for j in i..<(i + width) {
            w.append(src[j]);
        }
        wins.append(w);
        i = i + step;
    }
    return wins;
}

pub fn group_by(items: any, key_fn: any) -> map {
    var groups = {};
    for item in items {
        let k = key_fn(item);
        if groups.contains_key(k) {
            groups[k].append(item);
        } else {
            groups[k] = [item];
        }
    }
    return groups;
}

pub fn frequencies(items: any) -> map {
    var counts = {};
    for item in items {
        if counts.contains_key(item) {
            counts[item] = counts[item] + 1;
        } else {
            counts[item] = 1;
        }
    }
    return counts;
}

pub fn take(items: any, count: i64) -> any[] {
    if count <= 0 {
        return [];
    }
    var out = [];
    var seen: i64 = 0;
    for item in items {
        if seen >= count {
            break;
        }
        out.append(item);
        seen = seen + 1;
    }
    return out;
}

pub fn drop(items: any, count: i64) -> any[] {
    var out = [];
    var idx: i64 = 0;
    for item in items {
        if idx >= count {
            out.append(item);
        }
        idx = idx + 1;
    }
    return out;
}

pub fn take_while(items: any, pred_fn: any) -> any[] {
    var out = [];
    for item in items {
        if !pred_fn(item) {
            break;
        }
        out.append(item);
    }
    return out;
}

pub fn drop_while(items: any, pred_fn: any) -> any[] {
    var out = [];
    var dropping: bool = true;
    for item in items {
        if dropping && pred_fn(item) {
            continue;
        }
        dropping = false;
        out.append(item);
    }
    return out;
}

pub fn unique(items: any) -> any[] {
    var seen = {};
    var out = [];
    for item in items {
        if !seen.contains_key(item) {
            seen[item] = true;
            out.append(item);
        }
    }
    return out;
}

pub fn partition(items: any, pred_fn: any) -> any {
    var yes = [];
    var no = [];
    for item in items {
        if pred_fn(item) {
            yes.append(item);
        } else {
            no.append(item);
        }
    }
    return (yes, no);
}

pub fn scan(items: any, initial: any, folder_fn: any) -> any[] {
    var acc = initial;
    var out = [];
    for item in items {
        acc = folder_fn(acc, item);
        out.append(acc);
    }
    return out;
}

pub fn reduce(items: any, initial: any, folder_fn: any) -> any {
    var acc = initial;
    for item in items {
        acc = folder_fn(acc, item);
    }
    return acc;
}

// Lazy coroutine generator combinators (`yield`)
pub fn lazy_map(items: any, fn_map: any) -> any {
    for item in items {
        yield fn_map(item);
    }
}

pub fn lazy_filter(items: any, pred_fn: any) -> any {
    for item in items {
        if pred_fn(item) {
            yield item;
        }
    }
}

pub fn lazy_take(items: any, limit: i64) -> any {
    var count: i64 = 0;
    for item in items {
        if count >= limit {
            break;
        }
        yield item;
        count = count + 1;
    }
}

pub fn lazy_chain(seq_a: any, seq_b: any) -> any {
    for x in seq_a {
        yield x;
    }
    for y in seq_b {
        yield y;
    }
}

// =========================================================================
// Python CPython Lib/itertools.py Combinators & Cross-Platform Utilities
// =========================================================================

/// Returns accumulated sums (or cumulative results of func).
/// Python reference: itertools.accumulate(iterable[, func, *, initial])
pub fn accumulate(items: any, func: any = none, initial: any = none) -> any[] {
    var out = [];
    let pool = _collect_list(items);
    let n: i64 = len(pool);
    if n == 0 {
        if initial != none {
            out.append(initial);
        }
        return out;
    }

    var total = if initial != none { initial } else { pool[0] };
    out.append(total);

    let start: i64 = if initial != none { 0 } else { 1 };
    for i in start..<n {
        let item = pool[i];
        if func != none {
            total = func(total, item);
        } else {
            total = total + item;
        }
        out.append(total);
    }
    return out;
}

/// Batches items into non-overlapping batches of length n.
/// Python reference: itertools.batched(iterable, n) (Python 3.12+)
pub fn batched(items: any, n: i64) -> any[] {
    return chunk(items, n);
}

/// Filters elements from data returning only those that have a corresponding
/// element in selectors evaluating to true.
/// Python reference: itertools.compress(data, selectors)
pub fn compress(data: any, selectors: any) -> any[] {
    var out = [];
    let sel_list = _collect_list(selectors);
    let sel_len: i64 = len(sel_list);
    var idx: i64 = 0;
    for item in data {
        if idx >= sel_len {
            break;
        }
        let s = sel_list[idx];
        if s == true || s == 1 {
            out.append(item);
        }
        idx = idx + 1;
    }
    return out;
}

/// Drops elements while pred_fn returns true; returns remaining elements.
/// Python reference: itertools.dropwhile(predicate, iterable)
pub fn dropwhile(pred_fn: any, items: any) -> any[] {
    return drop_while(items, pred_fn);
}

/// Yields elements while pred_fn returns true; stops on first false.
/// Python reference: itertools.takewhile(predicate, iterable)
pub fn takewhile(pred_fn: any, items: any) -> any[] {
    return take_while(items, pred_fn);
}

/// Yields elements from items where pred_fn evaluates to false.
/// Python reference: itertools.filterfalse(predicate, iterable)
pub fn filter_false(pred_fn: any, items: any) -> any[] {
    var out = [];
    for item in items {
        if !pred_fn(item) {
            out.append(item);
        }
    }
    return out;
}

/// Alias for filter_false matching Python CPython naming convention.
/// Python reference: itertools.filterfalse(predicate, iterable)
pub fn filterfalse(pred_fn: any, items: any) -> any[] {
    return filter_false(pred_fn, items);
}

/// Groups consecutive keys or items matching Python itertools.groupby behavior.
/// Python reference: itertools.groupby(iterable, key=None)
pub fn groupby(items: any, key_fn: any = none) -> map {
    if key_fn == none {
        return group_by(items, (x) => x);
    }
    return group_by(items, key_fn);
}

/// Slices an iterable with start, stop, and step without loading all elements.
/// Python reference: itertools.islice(iterable, [start,] stop [, step])
pub fn islice(items: any, start: i64, stop: i64 = -1, step: i64 = 1) -> any[] {
    if step <= 0 {
        panic("itertools.islice step must be > 0");
    }
    var out = [];
    let pool = _collect_list(items);
    let n: i64 = len(pool);
    let end_idx: i64 = if stop < 0 || stop > n { n } else { stop };
    var i: i64 = start;
    while i < end_idx {
        out.append(pool[i]);
        i = i + step;
    }
    return out;
}

/// Returns successive overlapping pairs: (s0, s1), (s1, s2), (s2, s3)...
/// Python reference: itertools.pairwise(iterable) (Python 3.10+)
pub fn pairwise(items: any) -> any[] {
    let pool = _collect_list(items);
    let n: i64 = len(pool);
    var out = [];
    if n < 2 {
        return out;
    }
    for i in 0..<(n - 1) {
        out.append((pool[i], pool[i + 1]));
    }
    return out;
}

/// Computes func on tuple pairs: func(pair[0], pair[1]).
/// Python reference: itertools.starmap(func, iterable)
pub fn starmap(func: any, pairs: any) -> any[] {
    var out = [];
    for p in pairs {
        out.append(func(p[0], p[1]));
    }
    return out;
}

/// Returns n independent shallow copies of items.
/// Python reference: itertools.tee(iterable, n=2)
pub fn tee(items: any, n: i64 = 2) -> any[] {
    let pool = _collect_list(items);
    var copies = [];
    for _i in 0..<n {
        copies.append(_collect_list(pool));
    }
    return copies;
}

/// Cycles through items count times.
/// Python reference: itertools.cycle(iterable)
pub fn cycle(items: any, count: i64 = 1) -> any[] {
    var out = [];
    let pool = _collect_list(items);
    for _c in 0..<count {
        for x in pool {
            out.append(x);
        }
    }
    return out;
}

/// Repeats item times times.
/// Python reference: itertools.repeat(object[, times])
pub fn repeat(item: any, times: i64 = 1) -> any[] {
    var out = [];
    for _i in 0..<times {
        out.append(item);
    }
    return out;
}

/// Infinite integer counter coroutine.
/// Python reference: itertools.count(start=0, step=1)
pub fn count(start: i64 = 0, step: i64 = 1) -> any {
    var current: i64 = start;
    while true {
        yield current;
        current = current + step;
    }
}

/// Cartesian product of input sequences: (a, b) for all a in seq_a and b in seq_b.
/// Python reference: itertools.product(*iterables)
pub fn product(seq_a: any, seq_b: any) -> any[] {
    var out = [];
    for a in seq_a {
        for b in seq_b {
            out.append((a, b));
        }
    }
    return out;
}

fn _perm_rec(pool: any, r: i64, used: any, current: any, out: any) {
    if len(current) == r {
        out.append(_collect_list(current));
        return;
    }
    let n: i64 = len(pool);
    for i in 0..<n {
        if !used[i] {
            used[i] = true;
            current.append(pool[i]);
            _perm_rec(pool, r, used, current, out);
            current.remove_at(len(current) - 1);
            used[i] = false;
        }
    }
}

/// Generates all successive r-length permutations of elements in items.
/// Python reference: itertools.permutations(iterable, r=None)
pub fn permutations(items: any, r: i64 = -1) -> any[] {
    let pool = _collect_list(items);
    let n: i64 = len(pool);
    let target_r: i64 = if r < 0 { n } else { r };
    if target_r < 0 || target_r > n {
        return [];
    }
    if target_r == 0 {
        return [[]];
    }
    var used = [];
    for _i in 0..<n {
        used.append(false);
    }
    var out = [];
    var current = [];
    _perm_rec(pool, target_r, used, current, out);
    return out;
}

fn _comb_rec(pool: any, r: i64, start_idx: i64, current: any, out: any) {
    if len(current) == r {
        out.append(_collect_list(current));
        return;
    }
    let n: i64 = len(pool);
    for i in start_idx..<n {
        current.append(pool[i]);
        _comb_rec(pool, r, i + 1, current, out);
        current.remove_at(len(current) - 1);
    }
}

/// Generates all successive r-length combinations of elements from items.
/// Python reference: itertools.combinations(iterable, r)
pub fn combinations(items: any, r: i64) -> any[] {
    let pool = _collect_list(items);
    let n: i64 = len(pool);
    if r < 0 || r > n {
        return [];
    }
    if r == 0 {
        return [[]];
    }
    var out = [];
    var current = [];
    _comb_rec(pool, r, 0, current, out);
    return out;
}

fn _comb_rep_rec(pool: any, r: i64, start_idx: i64, current: any, out: any) {
    if len(current) == r {
        out.append(_collect_list(current));
        return;
    }
    let n: i64 = len(pool);
    for i in start_idx..<n {
        current.append(pool[i]);
        _comb_rep_rec(pool, r, i, current, out);
        current.remove_at(len(current) - 1);
    }
}

/// Generates all successive r-length combinations allowing individual elements to be repeated.
/// Python reference: itertools.combinations_with_replacement(iterable, r)
pub fn combinations_with_replacement(items: any, r: i64) -> any[] {
    let pool = _collect_list(items);
    let n: i64 = len(pool);
    if r < 0 || (n == 0 && r > 0) {
        return [];
    }
    if r == 0 {
        return [[]];
    }
    var out = [];
    var current = [];
    _comb_rep_rec(pool, r, 0, current, out);
    return out;
}
