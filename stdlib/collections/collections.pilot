// Binary search leftmost insertion point in sorted list (PSF-2.0 CPython bisect scaffold)
pub fn bisect_left(arr: any, target: any) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = len(arr);
    while lo < hi {
        let mid: i64 = (lo + hi) >> 1;
        if arr[mid] < target {
            lo = mid + 1;
        } else {
            hi = mid;
        }
    }
    return lo;
}

// Binary search rightmost insertion point in sorted list (PSF-2.0 CPython bisect scaffold)
pub fn bisect_right(arr: any, target: any) -> i64 {
    var lo: i64 = 0;
    var hi: i64 = len(arr);
    while lo < hi {
        let mid: i64 = (lo + hi) >> 1;
        if target < arr[mid] {
            hi = mid;
        } else {
            lo = mid + 1;
        }
    }
    return lo;
}

// Amortized O(1) circular-buffer Double-Ended Queue
pub struct Deque : IValue {
    pub:
        _buf:  any;
        _cap:  i64;
        _head: i64;
        _size: i64;

        self(initial_cap: i64 = 8) {
            var cap: i64 = 8;
            while cap < initial_cap {
                cap = cap * 2;
            }
            var buf = [];
            for _idx in 0..<cap {
                buf.append(none);
            }
            self._buf = buf;
            self._cap = cap;
            self._head = 0;
            self._size = 0;
        }

        fn len() -> i64 {
            return self._size;
        }

        fn is_empty() -> bool {
            return self._size == 0;
        }

        var fn _grow() {
            let old_cap: i64 = self._cap;
            let new_cap: i64 = old_cap * 2;
            var next_buf = [];
            for _idx in 0..<new_cap {
                next_buf.append(none);
            }
            for i in 0..<self._size {
                let idx: i64 = (self._head + i) % old_cap;
                next_buf[i] = self._buf[idx];
            }
            self._buf = next_buf;
            self._cap = new_cap;
            self._head = 0;
        }

        var fn push_back(item: any) {
            if self._size == self._cap {
                self._grow();
            }
            let tail: i64 = (self._head + self._size) % self._cap;
            self._buf[tail] = item;
            self._size = self._size + 1;
        }

        var fn push_front(item: any) {
            if self._size == self._cap {
                self._grow();
            }
            self._head = (self._head - 1 + self._cap) % self._cap;
            self._buf[self._head] = item;
            self._size = self._size + 1;
        }

        var fn pop_front() -> any {
            if self._size == 0 {
                return none;
            }
            let item = self._buf[self._head];
            self._buf[self._head] = none;
            self._head = (self._head + 1) % self._cap;
            self._size = self._size - 1;
            return some(item);
        }

        var fn pop_back() -> any {
            if self._size == 0 {
                return none;
            }
            let tail: i64 = (self._head + self._size - 1) % self._cap;
            let item = self._buf[tail];
            self._buf[tail] = none;
            self._size = self._size - 1;
            return some(item);
        }

        fn peek_front() -> any {
            if self._size == 0 {
                return none;
            }
            return some(self._buf[self._head]);
        }

        fn peek_back() -> any {
            if self._size == 0 {
                return none;
            }
            let tail: i64 = (self._head + self._size - 1) % self._cap;
            return some(self._buf[tail]);
        }

        fn at(index: i64) -> any {
            if index < 0 || index >= self._size {
                return none;
            }
            let idx: i64 = (self._head + index) % self._cap;
            return some(self._buf[idx]);
        }

        var fn clear() {
            for i in 0..<self._cap {
                self._buf[i] = none;
            }
            self._head = 0;
            self._size = 0;
        }

        fn to_list() -> any[] {
            var out = [];
            for i in 0..<self._size {
                let idx: i64 = (self._head + i) % self._cap;
                out.append(self._buf[idx]);
            }
            return out;
        }

        /// Appends all elements from the given collection to the right side of the deque.
        /// Python reference: collections.deque.extend
        var fn extend_all(items: any) {
            for item in items {
                self.push_back(item);
            }
        }

        /// Appends elements from the given collection to the left side of the deque.
        /// Python reference: collections.deque.extendleft
        var fn extend_left(items: any) {
            for item in items {
                self.push_front(item);
            }
        }

        /// Rotates the deque n steps to the right. If steps is negative, rotates to the left.
        /// Python reference: collections.deque.rotate
        var fn rotate(steps: i64 = 1) {
            if self._size <= 1 || steps == 0 {
                return;
            }
            let s: i64 = steps;
            if s > 0 {
                let count: i64 = s % self._size;
                for _i in 0..<count {
                    let it = self.pop_back();
                    if it.is_some() {
                        self.push_front(it.unwrap());
                    }
                }
            } else {
                let count: i64 = (0 - s) % self._size;
                for _j in 0..<count {
                    let it = self.pop_front();
                    if it.is_some() {
                        self.push_back(it.unwrap());
                    }
                }
            }
        }
}

// Binary Min-Heap Priority Queue (PSF-2.0 CPython heapq sift scaffold)
pub struct PriorityQueue : IValue {
    pub:
        _heap: any;
        _seq:  i64;

        self() {
            self._heap = [];
            self._seq = 0;
        }

        fn len() -> i64 {
            return len(self._heap);
        }

        fn is_empty() -> bool {
            return len(self._heap) == 0;
        }

        fn _less(entry_a: any, entry_b: any) -> bool {
            if entry_a[0] < entry_b[0] {
                return true;
            }
            if entry_a[0] > entry_b[0] {
                return false;
            }
            return entry_a[1] < entry_b[1];
        }

        var fn push(priority: any, value: any) {
            let entry = (priority, self._seq, value);
            self._seq = self._seq + 1;
            self._heap.append(entry);
            var idx: i64 = len(self._heap) - 1;
            while idx > 0 {
                let parent: i64 = (idx - 1) >> 1;
                if self._less(self._heap[idx], self._heap[parent]) {
                    let tmp = self._heap[parent];
                    self._heap[parent] = self._heap[idx];
                    self._heap[idx] = tmp;
                    idx = parent;
                } else {
                    break;
                }
            }
        }

        fn peek() -> any {
            if len(self._heap) == 0 {
                return none;
            }
            return some(self._heap[0][2]);
        }

        fn peek_with_priority() -> any {
            if len(self._heap) == 0 {
                return none;
            }
            let top = self._heap[0];
            return some((top[0], top[2]));
        }

        var fn pop() -> any {
            let n: i64 = len(self._heap);
            if n == 0 {
                return none;
            }
            let top_val = self._heap[0][2];
            let last_entry = self._heap[n - 1];
            self._heap.remove_at(n - 1);
            let new_len: i64 = len(self._heap);
            if new_len > 0 {
                self._heap[0] = last_entry;
                var idx: i64 = 0;
                while true {
                    let left: i64 = 2 * idx + 1;
                    let right: i64 = left + 1;
                    var smallest: i64 = idx;
                    if left < new_len && self._less(self._heap[left], self._heap[smallest]) {
                        smallest = left;
                    }
                    if right < new_len && self._less(self._heap[right], self._heap[smallest]) {
                        smallest = right;
                    }
                    if smallest == idx {
                        break;
                    }
                    let tmp = self._heap[idx];
                    self._heap[idx] = self._heap[smallest];
                    self._heap[smallest] = tmp;
                    idx = smallest;
                }
            }
            return some(top_val);
        }
}

// Sorted Key-Value Map supporting O(log N) lookup, floor/ceiling keys, and inclusive range queries
pub struct OrderedMap : IValue {
    pub:
        _keys: any;
        _vals: any;

        self() {
            self._keys = [];
            self._vals = [];
        }

        fn len() -> i64 {
            return len(self._keys);
        }

        fn is_empty() -> bool {
            return len(self._keys) == 0;
        }

        var fn put(key: any, val: any) {
            let idx: i64 = bisect_left(self._keys, key);
            if idx < len(self._keys) && self._keys[idx] == key {
                self._vals[idx] = val;
            } else {
                self._keys.insert(idx, key);
                self._vals.insert(idx, val);
            }
        }

        fn gets(key: any) -> any {
            let idx: i64 = bisect_left(self._keys, key);
            if idx < len(self._keys) && self._keys[idx] == key {
                return some(self._vals[idx]);
            }
            return none;
        }

        fn contains_key(key: any) -> bool {
            let idx: i64 = bisect_left(self._keys, key);
            return idx < len(self._keys) && self._keys[idx] == key;
        }

        var fn remove(key: any) -> any {
            let idx: i64 = bisect_left(self._keys, key);
            if idx < len(self._keys) && self._keys[idx] == key {
                let old_val = self._vals[idx];
                self._keys.remove_at(idx);
                self._vals.remove_at(idx);
                return some(old_val);
            }
            return none;
        }

        fn min_entry() -> any {
            if len(self._keys) == 0 {
                return none;
            }
            return some((self._keys[0], self._vals[0]));
        }

        fn max_entry() -> any {
            let n: i64 = len(self._keys);
            if n == 0 {
                return none;
            }
            return some((self._keys[n - 1], self._vals[n - 1]));
        }

        fn range_entries(lo_key: any, hi_key: any) -> any[] {
            let start_idx: i64 = bisect_left(self._keys, lo_key);
            let end_idx: i64 = bisect_right(self._keys, hi_key);
            var out = [];
            for i in start_idx..<end_idx {
                out.append((self._keys[i], self._vals[i]));
            }
            return out;
        }

        fn keys() -> any[] {
            var out = [];
            for k in self._keys {
                out.append(k);
            }
            return out;
        }

        fn values() -> any[] {
            var out = [];
            for v in self._vals {
                out.append(v);
            }
            return out;
        }
}

// One-to-Many Associative MultiMap (key -> list of values)
pub struct MultiMap : IValue {
    pub:
        _data:  any;
        _total: i64;

        self() {
            self._data = {};
            self._total = 0;
        }

        var fn put(key: any, val: any) {
            if self._data.contains_key(key) {
                self._data[key].append(val);
            } else {
                self._data[key] = [val];
            }
            self._total = self._total + 1;
        }

        fn get_all(key: any) -> any[] {
            if self._data.contains_key(key) {
                return self._data[key];
            }
            return [];
        }

        fn contains_key(key: any) -> bool {
            return self._data.contains_key(key) && len(self._data[key]) > 0;
        }

        fn key_count() -> i64 {
            return len(self._data.keys());
        }

        fn total_values() -> i64 {
            return self._total;
        }

        var fn remove_key(key: any) -> any[] {
            if self._data.contains_key(key) {
                let bucket = self._data[key];
                let removed_count: i64 = len(bucket);
                self._data[key] = [];
                self._total = self._total - removed_count;
                return bucket;
            }
            return [];
        }
}

// Fixed-Capacity RingBuffer with non-allocating overwrite and bounded try_push
pub struct RingBuffer : IValue {
    pub:
        _slots: any;
        _cap:   i64;
        _head:  i64;
        _count: i64;

        self(capacity: i64) {
            if capacity <= 0 {
                panic("RingBuffer capacity must be > 0");
            }
            var slots = [];
            for _idx in 0..<capacity {
                slots.append(none);
            }
            self._slots = slots;
            self._cap = capacity;
            self._head = 0;
            self._count = 0;
        }

        fn len() -> i64 {
            return self._count;
        }

        fn capacity() -> i64 {
            return self._cap;
        }

        fn is_empty() -> bool {
            return self._count == 0;
        }

        fn is_full() -> bool {
            return self._count == self._cap;
        }

        var fn try_push(item: any) -> bool {
            if self._count == self._cap {
                return false;
            }
            let write_idx: i64 = (self._head + self._count) % self._cap;
            self._slots[write_idx] = item;
            self._count = self._count + 1;
            return true;
        }

        var fn push_overwrite(item: any) -> any {
            if self._count < self._cap {
                let write_idx: i64 = (self._head + self._count) % self._cap;
                self._slots[write_idx] = item;
                self._count = self._count + 1;
                return none;
            }
            let evicted = self._slots[self._head];
            self._slots[self._head] = item;
            self._head = (self._head + 1) % self._cap;
            return some(evicted);
        }

        var fn pop() -> any {
            if self._count == 0 {
                return none;
            }
            let item = self._slots[self._head];
            self._slots[self._head] = none;
            self._head = (self._head + 1) % self._cap;
            self._count = self._count - 1;
            return some(item);
        }

        fn to_list() -> any[] {
            var out = [];
            for i in 0..<self._count {
                out.append(self._slots[(self._head + i) % self._cap]);
            }
            return out;
        }
}

// 62-bit Word-Packed Dense BitSet with SWAR/Kernighan popcount & bitwise algebra
pub struct BitSet : IValue {
    pub:
        _words: any;

        self(bit_capacity: i64 = 62) {
            var word_count: i64 = (bit_capacity + 61) / 62;
            if word_count < 1 {
                word_count = 1;
            }
            var words = [];
            for _idx in 0..<word_count {
                words.append(0);
            }
            self._words = words;
        }

        var fn _ensure_bit(bit_idx: i64) {
            if bit_idx < 0 {
                panic("BitSet index must be >= 0");
            }
            let word_idx: i64 = bit_idx / 62;
            while len(self._words) <= word_idx {
                self._words.append(0);
            }
        }

        var fn sets(bit_idx: i64) {
            self._ensure_bit(bit_idx);
            let w: i64 = bit_idx / 62;
            let offset: i64 = bit_idx % 62;
            self._words[w] = self._words[w] | (1 << offset);
        }

        var fn clear_bit(bit_idx: i64) {
            if bit_idx < 0 {
                return;
            }
            let w: i64 = bit_idx / 62;
            if w >= len(self._words) {
                return;
            }
            let offset: i64 = bit_idx % 62;
            self._words[w] = self._words[w] & ~(1 << offset);
        }

        fn test(bit_idx: i64) -> bool {
            if bit_idx < 0 {
                return false;
            }
            let w: i64 = bit_idx / 62;
            if w >= len(self._words) {
                return false;
            }
            let offset: i64 = bit_idx % 62;
            return ((self._words[w] >> offset) & 1) == 1;
        }

        fn count_ones() -> i64 {
            var total: i64 = 0;
            for w in self._words {
                var x: i64 = w;
                while x > 0 {
                    x = x & (x - 1);
                    total = total + 1;
                }
            }
            return total;
        }

        fn union_with(other: any) -> BitSet {
            let max_len: i64 = max(len(self._words), len(other._words));
            var res = BitSet(max_len * 62);
            for i in 0..<max_len {
                let a: i64 = if i < len(self._words) { self._words[i] } else { 0 };
                let b: i64 = if i < len(other._words) { other._words[i] } else { 0 };
                res._words[i] = a | b;
            }
            return res;
        }

        fn intersect_with(other: any) -> BitSet {
            let min_len: i64 = min(len(self._words), len(other._words));
            var res = BitSet(max(1, min_len) * 62);
            for i in 0..<min_len {
                res._words[i] = self._words[i] & other._words[i];
            }
            return res;
        }

        fn to_list() -> any[] {
            var bits = [];
            for w_idx in 0..<len(self._words) {
                let word: i64 = self._words[w_idx];
                if word != 0 {
                    for b in 0..<62 {
                        if ((word >> b) & 1) == 1 {
                            bits.append(w_idx * 62 + b);
                        }
                    }
                }
            }
            return bits;
        }
}

// Compile-Time / Runtime Displacement Perfect-Hash FrozenMap (.rodata wrapper)
pub fn freeze_map(entries: any) -> any {
    return __freeze_value(entries);
}

pub struct FrozenMap : IValue {
    pub:
        _table: any;

        self(entries: any) {
            self._table = __freeze_value(entries);
        }

        fn gets(key: any) -> any {
            if self._table.contains_key(key) {
                return some(self._table[key]);
            }
            return none;
        }

        fn get_or(key: any, default_val: any) -> any {
            if self._table.contains_key(key) {
                return self._table[key];
            }
            return default_val;
        }

        fn contains_key(key: any) -> bool {
            return self._table.contains_key(key);
        }

        fn len() -> i64 {
            return len(self._table.keys());
        }

        fn is_perfect_hash() -> bool {
            return __is_perfect_hash_map(self._table);
        }

        fn table_size() -> i64 {
            return __frozen_map_table_size(self._table);
        }

        fn raw_map() -> any {
            return self._table;
        }
}

// =========================================================================
// Python CPython Lib/collections/__init__.py Standard Containers
// =========================================================================

/// Dict subclass for counting hashable items.
/// Python reference: collections.Counter
pub struct Counter : IValue {
    pub:
        _counts: any;

        self(initial: any = none) {
            self._counts = {};
            if initial != none {
                self.update(initial);
            }
        }

        /// Returns the count for the given element, or 0 if absent.
        fn count_for(elem: any) -> i64 {
            if self._counts.contains_key(elem) {
                let c: i64 = self._counts[elem];
                return c;
            }
            return 0;
        }

        /// Returns some(count) if present, or none.
        fn gets(elem: any) -> any {
            if self._counts.contains_key(elem) {
                let c: i64 = self._counts[elem];
                return some(c);
            }
            return none;
        }

        /// Returns count if present, or default_val.
        fn get_or(elem: any, default_val: i64 = 0) -> i64 {
            if self._counts.contains_key(elem) {
                let c: i64 = self._counts[elem];
                return c;
            }
            return default_val;
        }

        /// Sets the count for an element directly.
        var fn sets(elem: any, count: i64) {
            self._counts[elem] = count;
        }

        /// Increments the count for an element by amount (default 1).
        var fn increment(elem: any, amount: i64 = 1) {
            let cur: i64 = self.count_for(elem);
            self._counts[elem] = cur + amount;
        }

        /// Decrements the count for an element by amount (default 1).
        var fn decrement(elem: any, amount: i64 = 1) {
            let cur: i64 = self.count_for(elem);
            self._counts[elem] = cur - amount;
        }

        /// Computes the sum of all counts.
        /// Python reference: collections.Counter.total
        fn total() -> i64 {
            var sum: i64 = 0;
            for k in self._counts.keys() {
                let c: i64 = self._counts[k];
                sum = sum + c;
            }
            return sum;
        }

        /// List the n most common elements and their counts from the most common to the least.
        /// If n is negative or omitted, returns all elements.
        /// Python reference: collections.Counter.most_common
        fn most_common(n: i64 = -1) -> any[] {
            var count_pairs = [];
            for k in self._counts.keys() {
                let c: i64 = self._counts[k];
                count_pairs.append((k, c));
            }
            let total_pairs: i64 = len(count_pairs);
            for i in 0..<total_pairs {
                var max_idx: i64 = i;
                for j in (i + 1)..<total_pairs {
                    let count_j: i64 = count_pairs[j][1];
                    let count_max: i64 = count_pairs[max_idx][1];
                    if count_j > count_max {
                        max_idx = j;
                    }
                }
                if max_idx != i {
                    let tmp = count_pairs[i];
                    count_pairs[i] = count_pairs[max_idx];
                    count_pairs[max_idx] = tmp;
                }
            }
            if n < 0 || n >= total_pairs {
                return count_pairs;
            }
            var out = [];
            for i in 0..<n {
                out.append(count_pairs[i]);
            }
            return out;
        }

        /// Produces a flat list of elements repeating each element as many times as its count.
        /// Elements with count <= 0 are omitted.
        /// Python reference: collections.Counter.elements
        fn elements() -> any[] {
            var out = [];
            for k in self._counts.keys() {
                let c: i64 = self._counts[k];
                if c > 0 {
                    for _rep in 0..<c {
                        out.append(k);
                    }
                }
            }
            return out;
        }

        /// Adds counts from another iterable, mapping, or Counter.
        /// Python reference: collections.Counter.update
        var fn update(other: any) {
            let ty: str = type_of(other);
            if ty == "map" {
                for k in other.keys() {
                    let c: i64 = other[k];
                    self.increment(k, c);
                }
            } else {
                for elem in other {
                    self.increment(elem, 1);
                }
            }
        }

        /// Subtracts counts from another iterable, mapping, or Counter.
        /// Counts can become zero or negative.
        /// Python reference: collections.Counter.subtract
        var fn subtract(other: any) {
            let ty: str = type_of(other);
            if ty == "map" {
                for k in other.keys() {
                    let c: i64 = other[k];
                    self.decrement(k, c);
                }
            } else {
                for elem in other {
                    self.decrement(elem, 1);
                }
            }
        }

        /// Resets all counts.
        var fn clear() {
            self._counts = {};
        }

        /// Returns list of all unique elements recorded in the counter.
        fn keys() -> any[] {
            return self._counts.keys();
        }

        /// Returns list of all counts.
        fn values() -> any[] {
            var vals = [];
            for k in self._counts.keys() {
                vals.append(self._counts[k]);
            }
            return vals;
        }

        /// Returns list of (elem, count) pairs.
        fn items() -> any[] {
            var res = [];
            for k in self._counts.keys() {
                res.append((k, self._counts[k]));
            }
            return res;
        }

        /// Returns number of distinct elements tracked.
        fn len() -> i64 {
            return len(self._counts.keys());
        }

        /// Checks if the element is present in the counter.
        fn contains_key(elem: any) -> bool {
            return self._counts.contains_key(elem);
        }
}

/// Dictionary that calls a factory function to supply missing values.
/// Python reference: collections.defaultdict
pub struct DefaultDict : IValue {
    pub:
        _factory: any;
        _data:    any;

        self(default_factory: any) {
            self._factory = default_factory;
            self._data = {};
        }

        /// Retrieves value for key, or calls factory, stores result, and returns it.
        var fn gets(key: any) -> any {
            if self._data.contains_key(key) {
                return self._data[key];
            }
            let factory = self._factory;
            let val = factory();
            self._data[key] = val;
            return val;
        }

        /// Returns value if key present, else fallback without mutating the map.
        fn get_or(key: any, fallback: any) -> any {
            if self._data.contains_key(key) {
                return self._data[key];
            }
            return fallback;
        }

        /// Stores key-value pair.
        var fn put(key: any, val: any) {
            self._data[key] = val;
        }

        /// Checks if key is present.
        fn contains_key(key: any) -> bool {
            return self._data.contains_key(key);
        }

        /// Removes key and returns some(previous_val) or none.
        var fn remove(key: any) -> any {
            if self._data.contains_key(key) {
                let old_val = self._data[key];
                self._data.remove(key);
                return some(old_val);
            }
            return none;
        }

        /// Returns list of keys.
        fn keys() -> any[] {
            return self._data.keys();
        }

        /// Returns list of values.
        fn values() -> any[] {
            var vals = [];
            for k in self._data.keys() {
                vals.append(self._data[k]);
            }
            return vals;
        }

        /// Returns list of (key, value) pairs.
        fn items() -> any[] {
            var res = [];
            for k in self._data.keys() {
                res.append((k, self._data[k]));
            }
            return res;
        }

        /// Returns number of entries.
        fn len() -> i64 {
            return len(self._data.keys());
        }

        /// Clears all entries.
        var fn clear() {
            self._data = {};
        }
}

/// Dictionary that preserves the order entries were added.
/// Python reference: collections.OrderedDict
pub struct OrderedDict : IValue {
    pub:
        _keys: any;
        _data: any;

        self() {
            self._keys = [];
            self._data = {};
        }

        /// Inserts or updates an entry. If new, appends to keys order.
        var fn put(key: any, val: any) {
            if !self._data.contains_key(key) {
                self._keys.append(key);
            }
            self._data[key] = val;
        }

        /// Retrieves some(val) if key is present, else none.
        fn gets(key: any) -> any {
            if self._data.contains_key(key) {
                return some(self._data[key]);
            }
            return none;
        }

        /// Retrieves val if key is present, else default_val.
        fn get_or(key: any, default_val: any) -> any {
            if self._data.contains_key(key) {
                return self._data[key];
            }
            return default_val;
        }

        /// Checks if key exists.
        fn contains_key(key: any) -> bool {
            return self._data.contains_key(key);
        }

        /// Removes key and its associated value, maintaining remaining order.
        var fn remove(key: any) -> any {
            if self._data.contains_key(key) {
                let val = self._data[key];
                self._data.remove(key);
                let n: i64 = len(self._keys);
                for i in 0..<n {
                    if self._keys[i] == key {
                        self._keys.remove_at(i);
                        break;
                    }
                }
                return some(val);
            }
            return none;
        }

        /// Removes and returns a (key, value) pair.
        /// If last is true, returns in LIFO order (last inserted).
        /// If last is false, returns in FIFO order (first inserted).
        /// Python reference: collections.OrderedDict.popitem
        var fn popitem(last: bool = true) -> any {
            let n: i64 = len(self._keys);
            if n == 0 {
                return none;
            }
            let idx: i64 = if last { n - 1 } else { 0 };
            let k = self._keys[idx];
            let v = self._data[k];
            self._keys.remove_at(idx);
            self._data.remove(k);
            return some((k, v));
        }

        /// Moves an existing key to either end of the ordered dictionary.
        /// If last is true, moves to the right end; if false, moves to the beginning.
        /// Python reference: collections.OrderedDict.move_to_end
        var fn move_to_end(key: any, last: bool = true) {
            if !self._data.contains_key(key) {
                panic("OrderedDict.move_to_end: key not found");
            }
            let n: i64 = len(self._keys);
            for i in 0..<n {
                if self._keys[i] == key {
                    self._keys.remove_at(i);
                    break;
                }
            }
            if last {
                self._keys.append(key);
            } else {
                self._keys.insert(0, key);
            }
        }

        /// Returns keys in insertion order.
        fn keys() -> any[] {
            var out = [];
            for k in self._keys {
                out.append(k);
            }
            return out;
        }

        /// Returns values in insertion order.
        fn values() -> any[] {
            var out = [];
            for k in self._keys {
                out.append(self._data[k]);
            }
            return out;
        }

        /// Returns (key, value) pairs in insertion order.
        fn items() -> any[] {
            var out = [];
            for k in self._keys {
                out.append((k, self._data[k]));
            }
            return out;
        }

        /// Returns number of entries.
        fn len() -> i64 {
            return len(self._keys);
        }

        /// Returns true if empty.
        fn is_empty() -> bool {
            return len(self._keys) == 0;
        }

        /// Clears all entries.
        var fn clear() {
            self._keys = [];
            self._data = {};
        }
}

/// A ChainMap groups multiple dicts or mappings together to create a single, updateable view.
/// Python reference: collections.ChainMap
pub struct ChainMap : IValue {
    pub:
        _maps: any;

        self(maps_list: any = none) {
            if maps_list == none {
                self._maps = [{}];
            } else {
                var copied = [];
                for m in maps_list {
                    copied.append(m);
                }
                self._maps = copied;
            }
        }

        /// Searches maps in chain order and returns some(value) or none.
        fn gets(key: any) -> any {
            for m in self._maps {
                if m.contains_key(key) {
                    return some(m[key]);
                }
            }
            return none;
        }

        /// Searches maps in chain order and returns value or default_val.
        fn get_or(key: any, default_val: any) -> any {
            for m in self._maps {
                if m.contains_key(key) {
                    return m[key];
                }
            }
            return default_val;
        }

        /// Returns true if key is found in any chained mapping.
        fn contains_key(key: any) -> bool {
            for m in self._maps {
                if m.contains_key(key) {
                    return true;
                }
            }
            return false;
        }

        /// Updates or inserts key into the primary (first) mapping.
        var fn put(key: any, val: any) {
            if len(self._maps) == 0 {
                self._maps.append({});
            }
            self._maps[0][key] = val;
        }

        /// Returns a new ChainMap with a new map prepended at the front.
        /// Python reference: collections.ChainMap.new_child
        fn new_child(child_map: any = none) -> ChainMap {
            var new_maps = [];
            if child_map != none {
                new_maps.append(child_map);
            } else {
                new_maps.append({});
            }
            for m in self._maps {
                new_maps.append(m);
            }
            return ChainMap(new_maps);
        }

        /// Returns a new ChainMap containing all of the maps in the current instance except the first.
        /// Python reference: collections.ChainMap.parents
        fn parents() -> ChainMap {
            var new_maps = [];
            let n: i64 = len(self._maps);
            for i in 1..<n {
                new_maps.append(self._maps[i]);
            }
            return ChainMap(new_maps);
        }

        /// Returns list of all underlying mappings.
        fn maps() -> any[] {
            return self._maps;
        }

        /// Returns unique list of all keys across all mappings.
        fn keys() -> any[] {
            var seen = {};
            var out = [];
            for m in self._maps {
                for k in m.keys() {
                    if !seen.contains_key(k) {
                        seen[k] = true;
                        out.append(k);
                    }
                }
            }
            return out;
        }

        /// Returns list of all (key, value) pairs resolved through the chain.
        fn items() -> any[] {
            var out = [];
            let all_keys = self.keys();
            for k in all_keys {
                let v = self.get_or(k, none);
                out.append((k, v));
            }
            return out;
        }

        /// Total number of unique keys.
        fn len() -> i64 {
            return len(self.keys());
        }
}

/// Factory function for creating lightweight tuple-like named records.
/// Python reference: collections.namedtuple(typename, field_names)
pub fn namedtuple(type_name: str, field_names: any) -> any {
    var fields = [];
    for f in field_names {
        fields.append(f);
    }
    return (values) => {
        var record = {};
        let n: i64 = min(len(fields), len(values));
        for i in 0..<n {
            record[fields[i]] = values[i];
        }
        return record;
    };
}
