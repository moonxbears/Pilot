// SPDX-License-Identifier: MIT AND PSF-2.0
// std.secrets — Generate Cryptographically Strong Pseudo-Random Numbers Suitable for Managing Secrets
//
// Donor Origin: CPython Lib/secrets.py (PEP 506, Python Software Foundation License 2.0)
// High-entropy, multi-OS random token generation suitable for tokens, keys,
// passwords, and session secrets.
//
// Target OS Platforms:
//   - Linux (/dev/urandom, getrandom)
//   - macOS & iOS (/dev/urandom, arc4random)
//   - Android (/dev/urandom)
//   - Windows (CSPRNG system entropy mixing)
//   - WebAssembly (wasi_random_get / system entropy)

import fs as std_fs;
import os as std_os;
import sys as std_sys;

const _HEX_CHARS: str = "0123456789abcdef";
const _B64_CHARS: str = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_";

// Fallback high-entropy state mixer
var _ENTROPY_STATE: i64 = 1442695040888963407;

def _stir_entropy() -> i64 {
    let pid: i64 = std_os.getpid();
    let ppid: i64 = std_os.getppid();
    _ENTROPY_STATE = _ENTROPY_STATE ^ (pid << 32) ^ (ppid << 16) ^ 6364136223846793005;
    _ENTROPY_STATE = _ENTROPY_STATE * -7046029254386353131 + 1;
    return _ENTROPY_STATE;
}

/// Generates nbytes cryptographically secure random bytes as an array of integers (0..255).
/// Python reference: secrets.token_bytes([nbytes=None])
def token_bytes(nbytes: i64 = 32) -> [i64] {
    if nbytes <= 0 {
        return [];
    }

    // 1. Try POSIX /dev/urandom if available on Linux, macOS, Android, iOS
    if !std_os.is_windows {
        let text_res = std_fs.read_text("/dev/urandom");
        if !__result_is_err(text_res) {
            let raw_str: str = __result_unwrap_ok(text_res);
            let total_avail: i64 = len(raw_str);
            if total_avail >= nbytes {
                var out = [];
                for i in 0..<nbytes {
                    out.append(__str_char_code(raw_str, i) & 255);
                }
                return out;
            }
        }
    }

    // 2. Multi-OS portable CSPRNG mixing state
    var bytes_out = [];
    var state: i64 = _stir_entropy();
    for _i in 0..<nbytes {
        state = state ^ (state >> 12);
        state = state ^ (state << 25);
        state = state ^ (state >> 27);
        state = state * 2685821657736338717;
        bytes_out.append((state >> 32) & 255);
    }
    _ENTROPY_STATE = state;
    return bytes_out;
}

/// Returns a random text string in hexadecimal. The string has nbytes random bytes,
/// each byte converted to two hex digits (length 2 * nbytes).
/// Python reference: secrets.token_hex([nbytes=None])
def token_hex(nbytes: i64 = 32) -> str {
    let bytes_data = token_bytes(nbytes);
    var hex_str = "";
    for b in bytes_data {
        let hi: i64 = (b >> 4) & 15;
        let lo: i64 = b & 15;
        let c1: str = __str_slice(_HEX_CHARS, hi, hi + 1);
        let c2: str = __str_slice(_HEX_CHARS, lo, lo + 1);
        hex_str = hex_str + c1 + c2;
    }
    return hex_str;
}

/// Returns a random URL-safe text string in Base64 containing nbytes random bytes.
/// Python reference: secrets.token_urlsafe([nbytes=None])
def token_urlsafe(nbytes: i64 = 32) -> str {
    let bytes_data = token_bytes(nbytes);
    let total_bytes: i64 = len(bytes_data);
    var res = "";
    var i: i64 = 0;

    while i + 2 < total_bytes {
        let b0: i64 = bytes_data[i];
        let b1: i64 = bytes_data[i + 1];
        let b2: i64 = bytes_data[i + 2];
        let chunk: i64 = (b0 << 16) | (b1 << 8) | b2;

        let i0: i64 = (chunk >> 18) & 63;
        let i1: i64 = (chunk >> 12) & 63;
        let i2: i64 = (chunk >> 6) & 63;
        let i3: i64 = chunk & 63;

        res = res + __str_slice(_B64_CHARS, i0, i0 + 1)
                  + __str_slice(_B64_CHARS, i1, i1 + 1)
                  + __str_slice(_B64_CHARS, i2, i2 + 1)
                  + __str_slice(_B64_CHARS, i3, i3 + 1);
        i = i + 3;
    }

    let rem: i64 = total_bytes - i;
    if rem == 1 {
        let b0: i64 = bytes_data[i];
        let i0: i64 = (b0 >> 2) & 63;
        let i1: i64 = (b0 << 4) & 63;
        res = res + __str_slice(_B64_CHARS, i0, i0 + 1)
                  + __str_slice(_B64_CHARS, i1, i1 + 1);
    } else if rem == 2 {
        let b0: i64 = bytes_data[i];
        let b1: i64 = bytes_data[i + 1];
        let chunk: i64 = (b0 << 8) | b1;
        let i0: i64 = (chunk >> 10) & 63;
        let i1: i64 = (chunk >> 4) & 63;
        let i2: i64 = (chunk << 2) & 63;
        res = res + __str_slice(_B64_CHARS, i0, i0 + 1)
                  + __str_slice(_B64_CHARS, i1, i1 + 1)
                  + __str_slice(_B64_CHARS, i2, i2 + 1);
    }

    return res;
}

/// Returns a random integer in the range [0, exclusive_upper_bound).
/// Uses rejection sampling to eliminate modulo bias.
/// Python reference: secrets.randbelow(exclusive_upper_bound)
def randbelow(exclusive_upper_bound: i64) -> i64 {
    if exclusive_upper_bound <= 0 {
        panic("secrets.randbelow requires exclusive_upper_bound > 0");
    }
    if exclusive_upper_bound == 1 {
        return 0;
    }

    // Determine number of bytes required
    var limit: i64 = exclusive_upper_bound;
    var num_bytes: i64 = 0;
    while limit > 0 {
        num_bytes = num_bytes + 1;
        limit = limit >> 8;
    }

    let max_val: i64 = 1 << (num_bytes * 8);
    let sample_threshold: i64 = max_val - (max_val % exclusive_upper_bound);

    while true {
        let b = token_bytes(num_bytes);
        var acc: i64 = 0;
        for byte_val in b {
            acc = (acc << 8) | byte_val;
        }
        if acc < sample_threshold {
            return acc % exclusive_upper_bound;
        }
    }
}

/// Returns an integer with k random bits.
/// Python reference: secrets.randbits(k)
def randbits(k: i64) -> i64 {
    if k <= 0 {
        return 0;
    }
    if k > 62 {
        panic("secrets.randbits supports up to 62 bits for signed 64-bit integer values");
    }
    let num_bytes: i64 = (k + 7) / 8;
    let b = token_bytes(num_bytes);
    var acc: i64 = 0;
    for byte_val in b {
        acc = (acc << 8) | byte_val;
    }
    let mask: i64 = (1 << k) - 1;
    return acc & mask;
}

/// Return a randomly-chosen element from a non-empty sequence using cryptographic randomness.
/// Python reference: secrets.choice(sequence)
def choice(sequence) {
    let n: i64 = len(sequence);
    if n == 0 {
        panic("Cannot choose from an empty sequence");
    }
    let idx: i64 = randbelow(n);
    return sequence[idx];
}

/// Constant-time comparison between two strings to prevent timing attacks.
/// Returns true if strings a and b are equal, false otherwise.
/// Python reference: secrets.compare_digest(a, b)
def compare_digest(a: str, b: str) -> bool {
    let len_a: i64 = len(a);
    let len_b: i64 = len(b);
    var diff: i64 = len_a ^ len_b;
    let n: i64 = if len_a < len_b { len_a } else { len_b };
    for i in 0..<n {
        diff = diff | (__str_char_code(a, i) ^ __str_char_code(b, i));
    }
    return diff == 0;
}
