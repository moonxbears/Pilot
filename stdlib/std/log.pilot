// FILE: stdlib/std/log.pilot
// Ring 2: Standard Structured Logging (pub pkg std.log;)
// ==============================================================================
pub pkg std.log;

/// How severe a log record is, least to most.
pub enum LogLevel : u8 {
    Trace,
    Debug,
    Info,
    Warn,
    Error,
}

[Layout(c_abi)]
pub struct LogRecord : IValue {
    pub level:   LogLevel;
    pub target:  str;
    pub message: str;
}

pub pure fn log_record_new(level: LogLevel, target: str, msg: str) -> LogRecord {
    return LogRecord { level: level, target: target, message: msg };
}
