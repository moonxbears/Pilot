// ==============================================================================
// FILE: stdlib/std/task.pilot
// Ring 2: Standard Asynchronous Task Model (pub pkg std.task;)
// ==============================================================================
pub pkg std.task;

pub pure fn nameof(sym: str) -> str => sym;

[Layout(c_abi)]
pub struct TaskId : IValue {
    pub raw: u64;
}

pub struct TaskHandle<T: IAnyValue> : IObject {
    pub id:        TaskId;
    pub is_done:   bool;
    pub has_value: bool;

    ~self() {}
}

/// Starts a task and returns its handle.
pub fn task_handle_new<T>() -> TaskHandle<T> {
    return seam("task.spawn", "spawning a task needs a scheduler or OS thread intrinsic");
}
