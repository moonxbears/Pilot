// ==============================================================================
// FILE: stdlib/std/polyglot/py_capi.pilot
// Milestone 17.2: In-Process Python C-API Adapter & PEP 3118 Zero-Copy Buffers
// PEP 384 Stable ABI, Vectorcall Fast-Path, GIL Guards (0b11), PyObj (0b10)
// ==============================================================================
pub pkg std.polyglot.py;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// 1. Core CPython ABI Structs & Guards
// ------------------------------------------------------------------------------

/// Exact CPython PEP 3118 Py_buffer memory layout (0b00 : IValue)
[Layout(c_abi), StandIn("py.buffer_layout", "CPython Py_buffer C layout with typed pointers", "pointers are usize and format is a str, so the layout does not match", "F6")]
pub struct PyBufferRaw : IValue {
    pub buf:        usize;
    pub obj:        usize;
    pub len:        isize;
    pub itemsize:   isize;
    pub readonly:   i32;
    pub ndim:       i32;
    pub format:     str;
    pub shape:      usize;
    pub strides:    usize;
    pub suboffsets: usize;
    pub internal:   usize;
}

pub pure fn py_buffer_raw_new(
    buf: usize,
    obj: usize,
    len: isize,
    itemsize: isize,
    readonly: i32,
    ndim: i32,
    format: str,
    shape: usize,
    strides: usize
) -> PyBufferRaw {
    return PyBufferRaw {
        buf:        buf,
        obj:        obj,
        len:        len,
        itemsize:   itemsize,
        readonly:   readonly,
        ndim:       ndim,
        format:     format,
        shape:      shape,
        strides:    strides,
        suboffsets: 0,
        internal:   0,
    };
}

/// PyError (0b00 : IValue) capturing Python exception information
[Layout(c_abi)]
pub struct PyError : IValue {
    pub exc_type:  str;
    pub message:   str;
    pub traceback: str;
}

pub pure fn py_error_new(exc_type: str, message: str, tb: str) -> PyError {
    return PyError {
        exc_type:  exc_type,
        message:   message,
        traceback: tb,
    };
}

/// Reentrant Python GIL Acquisition Guard (0b11 : IGuard)
pub struct PyGilGuard : IGuard {
    pub state:     i32; // PyGILState_STATE returned by PyGILState_Ensure
    pub is_active: bool;

    ~self() {
        if self.is_active {
            py_gil_release(var self);
        }
    }
}

/// Multi-threaded Compute Guard releasing the Python GIL (0b11 : IGuard)
pub struct PyAllowThreadsGuard : IGuard {
    pub saved_thread: usize; // PyThreadState* returned by PyEval_SaveThread
    pub is_released:  bool;

    ~self() {
        if self.is_released {
            py_restore_threads(var self);
        }
    }
}

/// Managed Python Object handle (0b10 : IObject). The reference count lives in
/// the `PyObject` itself; dropping the handle gives up this handle's reference.
pub struct PyObj : IObject {
    pub ptr: usize; // PyObject*

    ~self() {
        if self.ptr != 0 {
            py_obj_dec_ref(var self);
        }
    }
}

/// Pinned PEP 3118 Buffer Lease (0b11 : IGuard) projecting zero-copy strided views
pub struct PyBufferLease : IGuard {
    pub raw:       PyBufferRaw;
    pub is_active: bool;

    ~self() {
        if self.is_active {
            py_buffer_release(var self);
        }
    }
}

[Layout(c_abi)]
pub struct PyVectorcallResult : IValue {
    pub is_ok: bool;
    pub val:   PyObj;
    pub err:   PyError;
}

// ------------------------------------------------------------------------------
// 2. In-Process Python Runtime Initialization & GIL Management
// ------------------------------------------------------------------------------
// Every call below goes through a libpython3 loaded into this process. The
// seed has no native-call path yet (F6), so each one stops at a seam.

pub fn py_init_in_process() -> bool {
    return seam("py.init", "libpython3 located and loaded in-process (Py_InitializeEx, PEP 384)");
}

pub fn py_gil_acquire() -> PyGilGuard {
    return seam("py.gil_acquire", "PyGILState_Ensure through the loaded libpython3");
}

pub fn py_gil_release(var ref g: PyGilGuard) {
    seam("py.gil_release", "PyGILState_Release through the loaded libpython3");
}

pub fn py_allow_threads() -> PyAllowThreadsGuard {
    return seam("py.allow_threads", "PyEval_SaveThread through the loaded libpython3");
}

pub fn py_restore_threads(var ref g: PyAllowThreadsGuard) {
    seam("py.restore_threads", "PyEval_RestoreThread through the loaded libpython3");
}

// ------------------------------------------------------------------------------
// 3. Object Lifetime & Reference Counting
// ------------------------------------------------------------------------------

/// Wraps a `PyObject*` this handle already owns one reference to.
pub fn py_obj_new(ptr: usize) -> PyObj {
    return PyObj { ptr: ptr };
}

pub fn py_obj_inc_ref(obj: ref<PyObj>) {
    seam("py.inc_ref", "Py_IncRef through the loaded libpython3");
}

pub fn py_obj_dec_ref(var ref obj: PyObj) {
    seam("py.dec_ref", "Py_DecRef through the loaded libpython3");
}

// ------------------------------------------------------------------------------
// 4. Zero-Copy PEP 3118 Buffer Operations
// ------------------------------------------------------------------------------

pub fn py_buffer_acquire(obj: ref<PyObj>, flags: i32) -> PyBufferLease {
    return seam("py.buffer_acquire", "PyObject_GetBuffer filling a PyBufferRaw from the exporter");
}

pub fn py_buffer_release(var ref lease: PyBufferLease) {
    seam("py.buffer_release", "PyBuffer_Release through the loaded libpython3");
}

// ------------------------------------------------------------------------------
// 5. In-Process Vectorcall Fast-Path & Module Operations
// ------------------------------------------------------------------------------

pub fn py_import_module(mod_name: str) -> PyObj {
    return seam("py.import_module", "PyImport_ImportModule through the loaded libpython3");
}

/// Calls `callable` with positional `args` followed by keyword values named by
/// `kwnames`. A null callable is refused here, before anything reaches Python.
pub fn py_vectorcall_fast(
    callable: ref<PyObj>,
    args: slice<usize>,
    kwnames: slice<str>
) -> PyVectorcallResult {
    if callable.ptr == 0 {
        let err = py_error_new("TypeError", "'NoneType' object is not callable", "");
        return PyVectorcallResult {
            is_ok: false,
            val:   py_obj_new(0),
            err:   err,
        };
    }
    return seam("py.vectorcall", "PyObject_Vectorcall with a kwnames tuple through the loaded libpython3");
}

pub fn py_err_fetch() -> PyError {
    return seam("py.err_fetch", "PyErr_Fetch and the exception's type, message and traceback");
}

// ------------------------------------------------------------------------------
// 6. Scalar Conversions
// ------------------------------------------------------------------------------

pub fn py_str_from_obj(obj: ref<PyObj>) -> str {
    return seam("py.str_from_obj", "PyUnicode_AsUTF8AndSize through the loaded libpython3");
}

pub fn py_int_from_obj(obj: ref<PyObj>) -> i64 {
    return seam("py.int_from_obj", "PyLong_AsLongLong through the loaded libpython3");
}

pub fn py_float_from_obj(obj: ref<PyObj>) -> f64 {
    return seam("py.float_from_obj", "PyFloat_AsDouble through the loaded libpython3");
}

pub fn py_obj_from_int(val: i64) -> PyObj {
    return seam("py.obj_from_int", "PyLong_FromLongLong through the loaded libpython3");
}

pub fn py_obj_from_float(val: f64) -> PyObj {
    return seam("py.obj_from_float", "PyFloat_FromDouble through the loaded libpython3");
}

pub fn py_obj_from_str(val: str) -> PyObj {
    return seam("py.obj_from_str", "PyUnicode_FromStringAndSize through the loaded libpython3");
}
