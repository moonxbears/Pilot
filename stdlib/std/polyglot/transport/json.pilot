// ==============================================================================
// stdlib/std/polyglot/transport/json.pilot
// Ring 2 Standard Library: Full Bidirectional JSON DOM & Serialization
// Package: std.polyglot.transport.json (Transport Languages Subsystem)
// ==============================================================================

pub pkg std.polyglot.transport.json;

// ------------------------------------------------------------------------------
// 1. JSON Value Kinds
// ------------------------------------------------------------------------------

pub enum JsonKind : u8 {
    Null = 0,
    Bool = 1,
    Number = 2,
    String = 3,
    Array = 4,
    Object = 5,
}

// ------------------------------------------------------------------------------
// 2. JSON Data Structures (0b00: IValue & 0b10: IObject)
// ------------------------------------------------------------------------------

pub struct JsonPair : IValue {
    pub key: str,
    pub val: JsonValue,
}

pub struct JsonValue : IObject {
    pub kind:       JsonKind,
    pub str_val:    str,
    pub num_val:    f64,
    pub bool_val:   bool,
    pub array_val:  List<JsonValue>,
    pub object_val: List<JsonPair>,

    // --------------------------------------------------------------------------
    // Object Mutation & Lookup
    // --------------------------------------------------------------------------

    pub fn get(ref self, key: str) -> JsonValue {
        if self.kind != JsonKind::Object {
            return json_null();
        }
        var i: usize = 0;
        let n = self.object_val.len();
        while i < n {
            let pair = self.object_val[i];
            if pair.key == key {
                return pair.val;
            }
            i = i + 1;
        }
        return json_null();
    }

    pub fn set(var ref self, key: str, val: JsonValue) {
        if self.kind != JsonKind::Object {
            self.kind = JsonKind::Object;
        }
        var i: usize = 0;
        let n = self.object_val.len();
        while i < n {
            if self.object_val[i].key == key {
                self.object_val[i].val = val;
                return;
            }
            i = i + 1;
        }
        self.object_val.push(JsonPair { key: key, val: val });
    }

    pub fn has(ref self, key: str) -> bool {
        if self.kind != JsonKind::Object {
            return false;
        }
        var i: usize = 0;
        let n = self.object_val.len();
        while i < n {
            if self.object_val[i].key == key {
                return true;
            }
            i = i + 1;
        }
        return false;
    }

    pub fn remove(var ref self, key: str) -> bool {
        if self.kind != JsonKind::Object {
            return false;
        }
        var new_list: List<JsonPair> = [];
        var found = false;
        var i: usize = 0;
        let n = self.object_val.len();
        while i < n {
            let pair = self.object_val[i];
            if pair.key == key {
                found = true;
            } else {
                new_list.push(pair);
            }
            i = i + 1;
        }
        self.object_val = new_list;
        return found;
    }

    // --------------------------------------------------------------------------
    // Array Mutation & Lookup
    // --------------------------------------------------------------------------

    pub fn push(var ref self, val: JsonValue) {
        if self.kind != JsonKind::Array {
            self.kind = JsonKind::Array;
        }
        self.array_val.push(val);
    }

    pub fn get_at(ref self, idx: usize) -> JsonValue {
        if self.array_val.len() > idx {
            return self.array_val[idx];
        }
        let k = "" + idx;
        if self.has(k) {
            return self.get(k);
        }
        return json_null();
    }

    pub fn set_at(var ref self, idx: usize, val: JsonValue) {
        if self.kind == JsonKind::Array && idx < self.array_val.len() {
            self.array_val[idx] = val;
        }
    }

    pub fn len(ref self) -> usize {
        if self.array_val.len() > 0 {
            return self.array_val.len();
        }
        if self.kind == JsonKind::Array {
            return self.array_val.len();
        }
        if self.kind == JsonKind::Object {
            return self.object_val.len();
        }
        return 0;
    }

    // --------------------------------------------------------------------------
    // Nested Path Query (e.g. "user.profile.name")
    // --------------------------------------------------------------------------

    pub fn query_path(ref self, path: str) -> JsonValue {
        var cur: JsonValue = self;
        var part = "";
        var i: usize = 0;
        let n = path.len();
        while i < n {
            let b = path.byte_at(i);
            if b == 46 {
                if part.len() > 0 {
                    cur = cur.get(part);
                    part = "";
                }
            } else {
                part = part + path.slice(i, i + 1);
            }
            i = i + 1;
        }
        if part.len() > 0 {
            cur = cur.get(part);
        }
        return cur;
    }

    // --------------------------------------------------------------------------
    // Stringify Serializer
    // --------------------------------------------------------------------------

    pub fn stringify(ref self) -> str {
        if self.kind == JsonKind::Null {
            return "null";
        }
        if self.kind == JsonKind::Bool {
            return if self.bool_val { "true" } else { "false" };
        }
        if self.kind == JsonKind::Number {
            return "" + self.num_val;
        }
        if self.kind == JsonKind::String {
            return json_quote(self.str_val);
        }
        if self.kind == JsonKind::Array {
            var out = "[";
            var i: usize = 0;
            let n = self.len();
            while i < n {
                if i > 0 { out = out + ", "; }
                out = out + self.get_at(i).stringify();
                i = i + 1;
            }
            out = out + "]";
            return out;
        }
        if self.kind == JsonKind::Object {
            var out = "{";
            var i: usize = 0;
            let n = self.object_val.len();
            while i < n {
                if i > 0 { out = out + ", "; }
                let p = self.object_val[i];
                out = out + json_quote(p.key) + ": " + p.val.stringify();
                i = i + 1;
            }
            out = out + "}";
            return out;
        }
        return "null";
    }

    ~self() {}
}

// ------------------------------------------------------------------------------
// 3. Constructors
// ------------------------------------------------------------------------------

pub fn json_null() -> JsonValue {
    return JsonValue {
        kind:       JsonKind::Null,
        str_val:    "",
        num_val:    0.0,
        bool_val:   false,
        array_val:  [],
        object_val: [],
    };
}

pub fn json_bool(b: bool) -> JsonValue {
    return JsonValue {
        kind:       JsonKind::Bool,
        str_val:    "",
        num_val:    0.0,
        bool_val:   b,
        array_val:  [],
        object_val: [],
    };
}

pub fn json_num(n: f64) -> JsonValue {
    return JsonValue {
        kind:       JsonKind::Number,
        str_val:    "",
        num_val:    n,
        bool_val:   false,
        array_val:  [],
        object_val: [],
    };
}

pub fn json_str(s: str) -> JsonValue {
    return JsonValue {
        kind:       JsonKind::String,
        str_val:    s,
        num_val:    0.0,
        bool_val:   false,
        array_val:  [],
        object_val: [],
    };
}

pub fn json_array() -> JsonValue {
    return JsonValue {
        kind:       JsonKind::Array,
        str_val:    "",
        num_val:    0.0,
        bool_val:   false,
        array_val:  [],
        object_val: [],
    };
}

pub fn json_object() -> JsonValue {
    return JsonValue {
        kind:       JsonKind::Object,
        str_val:    "",
        num_val:    0.0,
        bool_val:   false,
        array_val:  [],
        object_val: [],
    };
}

// ------------------------------------------------------------------------------
// 4. RFC 8259 Parser
// ------------------------------------------------------------------------------

/// Why a JSON text was rejected, and the byte offset where it was noticed.
pub struct JsonError : IValue {
    pub pos:     usize,
    pub message: str,
}

/// A read position in a JSON text.
pub struct JsonCursor : IReference {
    pub src: str,
    pub pos: usize,

    pub fn at_end(ref self) -> bool => self.pos >= self.src.len();

    pub fn peek(ref self) -> i64 {
        if self.pos >= self.src.len() { return -1; }
        return self.src.byte_at(self.pos);
    }

    pub fn fail(ref self, message: str) -> res<JsonValue, JsonError> {
        return result<JsonValue, JsonError>.err(JsonError { pos: self.pos, message: message });
    }

    /// RFC 8259 §2: insignificant whitespace is space, tab, LF and CR.
    pub fn skip_ws(var ref self) {
        while self.pos < self.src.len() && json_is_space(self.src.byte_at(self.pos)) {
            self.pos = self.pos + 1;
        }
    }

    /// Consumes `word` (`true`, `false`, `null`) when it is next.
    pub fn eat_word(var ref self, word: str) -> bool {
        let end = self.pos + word.len();
        if end > self.src.len() { return false; }
        if self.src.slice(self.pos, end) != word { return false; }
        self.pos = end;
        return true;
    }

    /// RFC 8259 §3: `value = false / null / true / object / array / number / string`.
    pub fn parse_value(var ref self) -> res<JsonValue, JsonError> {
        self.skip_ws();
        let b = self.peek();
        if b == 123 { return self.parse_object(); }
        if b == 91 { return self.parse_array(); }
        if b == 34 {
            let s = self.parse_string()?;
            return result<JsonValue, JsonError>.ok(json_str(s));
        }
        if b == 45 || (b >= 48 && b <= 57) { return self.parse_number(); }
        if self.eat_word("true") { return result<JsonValue, JsonError>.ok(json_bool(true)); }
        if self.eat_word("false") { return result<JsonValue, JsonError>.ok(json_bool(false)); }
        if self.eat_word("null") { return result<JsonValue, JsonError>.ok(json_null()); }
        if b < 0 { return self.fail("unexpected end of input, expected a value"); }
        return self.fail("expected a value");
    }

    /// RFC 8259 §4: `object = { [ member *( , member ) ] }`, `member = string : value`.
    pub fn parse_object(var ref self) -> res<JsonValue, JsonError> {
        var obj = json_object();
        self.pos = self.pos + 1;
        self.skip_ws();
        if self.peek() == 125 {
            self.pos = self.pos + 1;
            return result<JsonValue, JsonError>.ok(obj);
        }
        loop {
            self.skip_ws();
            if self.peek() != 34 { return self.fail("expected a string key"); }
            let key = self.parse_string()?;
            self.skip_ws();
            if self.peek() != 58 { return self.fail("expected ':' after an object key"); }
            self.pos = self.pos + 1;
            let val = self.parse_value()?;
            obj.set(key, val);
            self.skip_ws();
            let b = self.peek();
            if b == 44 {
                self.pos = self.pos + 1;
            } else if b == 125 {
                self.pos = self.pos + 1;
                return result<JsonValue, JsonError>.ok(obj);
            } else {
                return self.fail("expected ',' or '}' in an object");
            }
        }
        return self.fail("unterminated object");
    }

    /// RFC 8259 §5: `array = [ [ value *( , value ) ] ]`.
    pub fn parse_array(var ref self) -> res<JsonValue, JsonError> {
        var arr = json_array();
        self.pos = self.pos + 1;
        self.skip_ws();
        if self.peek() == 93 {
            self.pos = self.pos + 1;
            return result<JsonValue, JsonError>.ok(arr);
        }
        loop {
            let item = self.parse_value()?;
            arr.push(item);
            self.skip_ws();
            let b = self.peek();
            if b == 44 {
                self.pos = self.pos + 1;
            } else if b == 93 {
                self.pos = self.pos + 1;
                return result<JsonValue, JsonError>.ok(arr);
            } else {
                return self.fail("expected ',' or ']' in an array");
            }
        }
        return self.fail("unterminated array");
    }

    /// RFC 8259 §6: `number = [ minus ] int [ frac ] [ exp ]`, where `int` is
    /// `0` or a digit 1-9 followed by digits.
    pub fn parse_number(var ref self) -> res<JsonValue, JsonError> {
        let n = self.src.len();
        var negative = false;
        if self.peek() == 45 {
            negative = true;
            self.pos = self.pos + 1;
        }
        let int_start = self.pos;
        if self.peek() == 48 {
            self.pos = self.pos + 1;
            if json_is_digit(self.peek()) { return self.fail("leading zeros are not allowed in a number"); }
        } else if json_is_digit(self.peek()) {
            while json_is_digit(self.peek()) { self.pos = self.pos + 1; }
        } else {
            return self.fail("expected a digit");
        }
        let int_digits = self.src.slice(int_start, self.pos);
        var frac_digits = "";
        if self.peek() == 46 {
            self.pos = self.pos + 1;
            let frac_start = self.pos;
            while json_is_digit(self.peek()) { self.pos = self.pos + 1; }
            if self.pos == frac_start { return self.fail("expected a digit after '.'"); }
            frac_digits = self.src.slice(frac_start, self.pos);
        }
        var exp10 = 0;
        if self.peek() == 101 || self.peek() == 69 {
            self.pos = self.pos + 1;
            var exp_negative = false;
            if self.peek() == 43 || self.peek() == 45 {
                exp_negative = self.peek() == 45;
                self.pos = self.pos + 1;
            }
            let exp_start = self.pos;
            while json_is_digit(self.peek()) {
                if exp10 < 100000 { exp10 = exp10 * 10 + (self.peek() - 48); }
                self.pos = self.pos + 1;
            }
            if self.pos == exp_start { return self.fail("expected a digit in the exponent"); }
            if exp_negative { exp10 = -exp10; }
        }
        let mag = json_decimal_to_f64(int_digits, frac_digits, exp10);
        if mag - mag != 0.0 {
            return self.fail("number is outside the binary64 range");
        }
        return result<JsonValue, JsonError>.ok(json_num(if negative { -mag } else { mag }));
    }

    /// RFC 8259 §7: a string is quoted; `"`, `\` and the controls U+0000 to
    /// U+001F must be escaped.
    pub fn parse_string(var ref self) -> res<str, JsonError> {
        self.pos = self.pos + 1;
        var out = "";
        var run_start = self.pos;
        while self.pos < self.src.len() {
            let b = self.src.byte_at(self.pos);
            if b == 34 {
                out = out + self.src.slice(run_start, self.pos);
                self.pos = self.pos + 1;
                return result<str, JsonError>.ok(out);
            }
            if b < 32 {
                return result<str, JsonError>.err(JsonError { pos: self.pos, message: "unescaped control character in a string" });
            }
            if b == 92 {
                out = out + self.src.slice(run_start, self.pos);
                self.pos = self.pos + 1;
                let e = self.peek();
                if e == 34 { out = out + "\""; }
                else if e == 92 { out = out + "\\"; }
                else if e == 47 { out = out + "/"; }
                else if e == 110 { out = out + "\n"; }
                else if e == 114 { out = out + "\r"; }
                else if e == 116 { out = out + "\t"; }
                else if e == 98 || e == 102 {
                    out = out + json_code_point_str(if e == 98 { 8 } else { 12 });
                } else if e == 117 {
                    var cp = json_hex4(self.src, self.pos + 1);
                    if cp < 0 {
                        return result<str, JsonError>.err(JsonError { pos: self.pos, message: "expected four hex digits after \\u" });
                    }
                    self.pos = self.pos + 4;
                    if cp >= 55296 && cp <= 56319 {
                        // A high surrogate must be followed by `\u` and a low surrogate.
                        let lo = if self.pos + 2 < self.src.len() && self.src.byte_at(self.pos + 1) == 92 && self.src.byte_at(self.pos + 2) == 117 {
                            json_hex4(self.src, self.pos + 3)
                        } else {
                            -1
                        };
                        if lo >= 56320 && lo <= 57343 {
                            cp = 65536 + (cp - 55296) * 1024 + (lo - 56320);
                            self.pos = self.pos + 6;
                        }
                    }
                    out = out + json_code_point_str(cp);
                } else {
                    return result<str, JsonError>.err(JsonError { pos: self.pos, message: "invalid escape in a string" });
                }
                self.pos = self.pos + 1;
                run_start = self.pos;
            } else {
                self.pos = self.pos + 1;
            }
        }
        return result<str, JsonError>.err(JsonError { pos: self.pos, message: "unterminated string" });
    }
}

/// `s` as an RFC 8259 string: quoted, with `"`, `\\` and controls escaped.
pub pure fn json_quote(s: str) -> str {
    let hex = "0123456789abcdef";
    var out = "\"";
    var run_start = 0;
    var i = 0;
    let n = s.len();
    while i < n {
        let b = s.byte_at(i);
        if b == 34 || b == 92 || b < 32 {
            out = out + s.slice(run_start, i);
            if b == 34 { out = out + "\\\""; }
            else if b == 92 { out = out + "\\\\"; }
            else if b == 10 { out = out + "\\n"; }
            else if b == 13 { out = out + "\\r"; }
            else if b == 9 { out = out + "\\t"; }
            else { out = out + "\\u00" + hex.slice(b / 16, b / 16 + 1) + hex.slice(b % 16, b % 16 + 1); }
            run_start = i + 1;
        }
        i = i + 1;
    }
    return out + s.slice(run_start, n) + "\"";
}

pure fn json_is_space(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pure fn json_is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

/// The value of the four hex digits at `at`, or -1.
pure fn json_hex4(src: str, at: usize) -> i64 {
    if at + 4 > src.len() { return -1; }
    var v = 0;
    var i = 0;
    while i < 4 {
        let b = src.byte_at(at + i);
        var d = -1;
        if b >= 48 && b <= 57 { d = b - 48; }
        else if b >= 97 && b <= 102 { d = b - 87; }
        else if b >= 65 && b <= 70 { d = b - 55; }
        if d < 0 { return -1; }
        v = v * 16 + d;
        i = i + 1;
    }
    return v;
}

/// The str holding the code point `cp`, encoded as UTF-8 (RFC 3629
/// section 3). A lone surrogate (U+D800 to U+DFFF, an escape RFC 8259
/// section 8.2 lets through) is not a Unicode scalar, so its encoding is not
/// valid UTF-8; it becomes U+FFFD, as a WHATWG UTF-8 decoder makes it.
pure fn json_code_point_str(cp: i64) -> str {
    var bytes: List<i64> = [];
    if cp < 128 {
        bytes.push(cp);
    } else if cp < 2048 {
        bytes.push(192 + cp / 64);
        bytes.push(128 + cp % 64);
    } else if cp < 65536 {
        bytes.push(224 + cp / 4096);
        bytes.push(128 + (cp / 64) % 64);
        bytes.push(128 + cp % 64);
    } else {
        bytes.push(240 + cp / 262144);
        bytes.push(128 + (cp / 4096) % 64);
        bytes.push(128 + (cp / 64) % 64);
        bytes.push(128 + cp % 64);
    }
    let replacement: List<i64> = [239, 191, 189];
    return from_utf8(bytes) ?? from_utf8(replacement) ?? "";
}

/// The binary64 value of the decimal `int_digits.frac_digits * 10^exp10`.
[StandIn("json.decimal_to_f64", "correctly rounded decimal to binary64 conversion (IEEE 754 roundTiesToEven)", "exact when the significand has at most 15 digits and the scaled exponent is within 10^22; beyond that, repeated scaling can be off by an ulp or more", "F6")]
pure fn json_decimal_to_f64(int_digits: str, frac_digits: str, exp10: i64) -> f64 {
    let digits = int_digits + frac_digits;
    var sig = 0.0;
    var i = 0;
    let n = digits.len();
    while i < n {
        sig = sig * 10.0 + f64(digits.byte_at(i) - 48);
        i = i + 1;
    }
    if sig == 0.0 { return 0.0; }
    var e = exp10 - frac_digits.len();
    var v = sig;
    while e > 0 {
        let step = if e >= 22 { 22 } else { e };
        v = v * json_pow10(step);
        e = e - step;
    }
    while e < 0 {
        let step = if -e >= 22 { 22 } else { -e };
        v = v / json_pow10(step);
        e = e + step;
    }
    return v;
}

/// 10^k for 0 <= k <= 22, each exactly representable in binary64.
pure fn json_pow10(k: i64) -> f64 {
    var p = 1.0;
    var i = 0;
    while i < k {
        p = p * 10.0;
        i = i + 1;
    }
    return p;
}

/// Parses one RFC 8259 JSON text: a value with optional surrounding
/// whitespace and nothing after it.
pub fn json_parse(src: str) -> res<JsonValue, JsonError> {
    var cur = JsonCursor { src: src, pos: 0 };
    let v = cur.parse_value()?;
    cur.skip_ws();
    if !cur.at_end() {
        return cur.fail("unexpected text after the JSON value");
    }
    return result<JsonValue, JsonError>.ok(v);
}
