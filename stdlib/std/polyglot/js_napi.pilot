// ==============================================================================
// stdlib/std/polyglot/js_napi.pilot
// Milestone 18: In-Process Node-API v9 (napi_*) Host & Addon Adapter
// Package: std.polyglot.js (Ring 2 Standard Library)
// ==============================================================================

pub pkg std.polyglot.js;

// ------------------------------------------------------------------------------
// 1. Status Codes & Constants
// ------------------------------------------------------------------------------

pub const NAPI_OK: i32 = 0;
pub const NAPI_INVALID_ARG: i32 = 1;
pub const NAPI_OBJECT_EXPECTED: i32 = 2;
pub const NAPI_STRING_EXPECTED: i32 = 3;
pub const NAPI_NAME_EXPECTED: i32 = 4;
pub const NAPI_FUNCTION_EXPECTED: i32 = 5;
pub const NAPI_NUMBER_EXPECTED: i32 = 6;
pub const NAPI_BOOLEAN_EXPECTED: i32 = 7;
pub const NAPI_ARRAY_EXPECTED: i32 = 8;
pub const NAPI_GENERIC_FAILURE: i32 = 9;

// ------------------------------------------------------------------------------
// 2. Error Model (0b00: IValue)
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct JsError : IValue {
    pub name:    str,
    pub message: str,
    pub stack:   str,
}

pub fn js_error_new(name: str, message: str, stack: str) -> JsError {
    return JsError {
        name:    name,
        message: message,
        stack:   stack,
    };
}

// Every call below goes through a Node-API host (libnode, or embedded
// QuickJS) loaded into this process. The seed has no native-call path yet
// (F6), so each one stops at a seam.

pub fn js_err_fetch() -> JsError {
    return seam("js.err_fetch", "napi_get_and_clear_last_exception and the error's name, message and stack");
}

// ------------------------------------------------------------------------------
// 3. Handle Scope Guard (0b11: IGuard)
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct NapiScopeGuard : IGuard {
    pub scope_id: usize, // napi_handle_scope
    pub is_open:  bool,

    ~self() {
        if self.is_open {
            napi_close_handle_scope(var self);
        }
    }
}

pub fn napi_open_handle_scope(env: usize) -> NapiScopeGuard {
    return seam("js.open_handle_scope", "napi_open_handle_scope through a loaded Node-API host");
}

pub fn napi_close_handle_scope(var ref g: NapiScopeGuard) {
    seam("js.close_handle_scope", "napi_close_handle_scope through a loaded Node-API host");
}

// ------------------------------------------------------------------------------
// 4. JS Object Reference (0b10: IObject)
// ------------------------------------------------------------------------------

/// A `napi_ref`. Its reference count lives in the JS engine.
pub struct JsRef : IObject {
    pub ref_id:  usize, // napi_ref
    pub env_ptr: usize, // napi_env

    ~self() {
        if self.ref_id != 0 {
            js_ref_dec(var self);
        }
    }
}

pub fn js_ref_new(env: usize, val: usize) -> JsRef {
    return seam("js.ref_new", "napi_create_reference through a loaded Node-API host");
}

pub fn js_ref_inc(ref r: JsRef) {
    seam("js.ref_inc", "napi_reference_ref through a loaded Node-API host");
}

pub fn js_ref_dec(var ref r: JsRef) {
    seam("js.ref_dec", "napi_reference_unref, routed to the owning isolate's thread");
}

// ------------------------------------------------------------------------------
// 5. Zero-Copy TypedArray & ArrayBuffer Lease (0b11: IGuard)
// ------------------------------------------------------------------------------

pub struct JsBufferLease : IGuard {
    pub raw_ptr:      usize,
    pub byte_length:  usize,
    pub byte_offset:  usize,
    pub is_active:    bool,
    pub element_type: str,

    ~self() {
        if self.is_active {
            napi_release_typedarray(var self);
        }
    }
}

/// Borrows the memory behind a JS TypedArray. Its data pointer, length and
/// byte offset come from `napi_get_typedarray_info`, never from the caller.
pub fn napi_acquire_typedarray(env: usize, val: usize) -> JsBufferLease {
    return seam("js.typedarray_info", "napi_get_typedarray_info through a loaded Node-API host");
}

pub fn napi_release_typedarray(var ref lease: JsBufferLease) {
    seam("js.typedarray_release", "releasing the reference that pins the TypedArray's ArrayBuffer");
}

// ------------------------------------------------------------------------------
// 6. Lossless 64-Bit BigInt Fidelity (JS003)
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct JsValue : IValue {
    pub val_id:   usize, // napi_value
    pub type_tag: u8, // napi_valuetype
}

pub fn napi_create_bigint_int64(env: usize, val: i64) -> JsValue {
    return seam("js.bigint_create", "napi_create_bigint_int64 through a loaded Node-API host");
}

pub fn napi_get_value_bigint_int64(env: usize, val: ref<JsValue>) -> i64 {
    return seam("js.bigint_read", "napi_get_value_bigint_int64 (with its lossless flag) through a loaded Node-API host");
}

// ------------------------------------------------------------------------------
// 7. Function Invocation
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct NapiResult : IValue {
    pub status: i32,
    pub val:    usize,
    pub err:    JsError,
}

/// Calls `func` with `args`. A null environment or function is refused here
/// with `napi_invalid_arg`, before anything reaches the JS engine.
pub fn napi_call_function(
    env: usize,
    func: usize,
    args: slice<usize>
) -> NapiResult {
    if env == 0 || func == 0 {
        let err = js_error_new("TypeError", "Invalid function handle or environment", "");
        return NapiResult {
            status: NAPI_INVALID_ARG,
            val:    0,
            err:    err,
        };
    }
    return seam("js.call_function", "napi_call_function through a loaded Node-API host");
}

// ------------------------------------------------------------------------------
// 8. Promise & Task Integration
// ------------------------------------------------------------------------------

pub struct JsPromise : IObject {
    pub promise_id: usize, // napi_value of the promise
    pub deferred:   usize, // napi_deferred that settles it
}

pub fn js_promise_new(env: usize) -> JsPromise {
    return seam("js.promise_new", "napi_create_promise through a loaded Node-API host");
}

pub fn js_promise_resolve(var ref prom: JsPromise, val: usize) {
    seam("js.promise_resolve", "napi_resolve_deferred through a loaded Node-API host");
}

pub fn js_promise_reject(var ref prom: JsPromise, err: usize) {
    seam("js.promise_reject", "napi_reject_deferred through a loaded Node-API host");
}
