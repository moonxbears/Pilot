// ==============================================================================
// FILE: stdlib/std/polyglot/lifetime.pilot
// Milestone 14: Perceus Foreign Resource & Scope Guard Synchronization (0b10 & 0b11)
// `ForeignHandle<T>`, `ForeignGuard<T>`, `PinnedSlice<T>`, `ThreadAffineDropQueue`,
// and `BorrowCallbackScope`.
// ==============================================================================
pub pkg std.polyglot.lifetime;

// ------------------------------------------------------------------------------
// 1. Thread-Affine Drop Item & Global Table
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct QueuedDropItem : IValue {
    pub raw_ptr:    i64;
    pub dtor_fn:    i64;
    pub target_tid: u64;
    pub is_valid:   bool;
}

pub pure fn queued_drop_item_new(raw: i64, dtor: i64, tid: u64) -> QueuedDropItem {
    return QueuedDropItem {
        raw_ptr: raw,
        dtor_fn: dtor,
        target_tid: tid,
        is_valid: true,
    };
}

// ------------------------------------------------------------------------------
// 2. ThreadAffineDropQueue Engine
// Collects drops that happen on a thread other than the owner's; the owner
// thread drains them from its own drain hook.
// ------------------------------------------------------------------------------

pub struct ThreadAffineDropQueue : IObject {
    pub queue: List<QueuedDropItem>;

    pub static fn create() -> ThreadAffineDropQueue {
        return ThreadAffineDropQueue { queue: [] };
    }

    /// The process-wide queue every thread-affine `ForeignHandle` drops into.
    pub static fn global() -> ThreadAffineDropQueue {
        return seam("lifetime.global_drop_queue",
            "a process-wide, lock-protected drop queue needs runtime globals and locks (F7)");
    }

    pub var fn enqueue(p: i64, dtor: i64, target_tid: u64) {
        if p != 0 && dtor != 0 {
            .queue.push(queued_drop_item_new(p, dtor, target_tid));
        }
    }

    pub pure fn pending_drops_for(tid: u64) -> usize {
        var count: usize = 0;
        var i: usize = 0;
        while i < .queue.len() {
            if .queue[i].target_tid == tid { count = count + 1; }
            i = i + 1;
        }
        return count;
    }

    pub pure fn pending_count() -> usize => .queue.len();

    /// Runs, on thread `tid`, every destructor queued for it, and removes
    /// them from the queue.
    pub var fn drain_thread(tid: u64) -> usize {
        var kept: List<QueuedDropItem> = [];
        var drained: usize = 0;
        var i: usize = 0;
        while i < .queue.len() {
            let item = .queue[i];
            if item.target_tid == tid {
                invoke_foreign_destructor(item.dtor_fn, item.raw_ptr);
                drained = drained + 1;
            } else {
                kept.push(item);
            }
            i = i + 1;
        }
        .queue = kept;
        return drained;
    }

    pub var fn drain_current_thread() -> usize {
        return .drain_thread(current_thread_id());
    }

    ~self() {}
}

/// The id of the OS thread running this code.
pub fn current_thread_id() -> u64 {
    return seam("thread.current_id",
        "OS thread ids need the thread intrinsics (gettid / GetCurrentThreadId) of F6");
}

/// Calls the native destructor `dtor_fn` on `raw_ptr`.
pub fn invoke_foreign_destructor(dtor_fn: i64, raw_ptr: i64) {
    if dtor_fn != 0 && raw_ptr != 0 {
        seam("ffi.call_destructor",
            "calling a native destructor needs PilVM native calls through pilot_rt_invoke_abi_frame (F6)");
    }
}

// ------------------------------------------------------------------------------
// 3. ForeignHandle<T: IAnyValue> : IObject (0b10 Owned Object)
// Wraps foreign heap pointer with Perceus move semantics + exact-last-ref dtor
// ------------------------------------------------------------------------------

[Layout(c_abi), StandIn("ffi.int_address", "ptr<T> data pointer and native destructor fn pointer", "addresses held as i64 with no type or provenance", "F6")]
pub struct ForeignHandle<T: IAnyValue> : IObject {
    pub raw_ptr:   i64;
    pub dtor_fn:   i64;
    pub owner_tid: u64;
    pub is_armed:  bool;

    pub static fn wrap(p: i64, dtor: i64) -> ForeignHandle<T> {
        let armed = p != 0;
        return ForeignHandle {
            raw_ptr:   p,
            dtor_fn:   dtor,
            owner_tid: 0,
            is_armed:  armed,
        };
    }

    pub static fn try_wrap(p: i64, dtor: i64) -> opt<ForeignHandle<T>> {
        if p == 0 {
            return opt<ForeignHandle<T>>::none();
        }
        return opt<ForeignHandle<T>>::some(ForeignHandle<T>::wrap(p, dtor));
    }

    pub static fn wrap_thread_affine(p: i64, dtor: i64, owner_tid: u64) -> ForeignHandle<T> {
        let armed = p != 0;
        return ForeignHandle {
            raw_ptr:   p,
            dtor_fn:   dtor,
            owner_tid: owner_tid,
            is_armed:  armed,
        };
    }

    pub pure fn as_ptr() -> i64 => .raw_ptr;

    pub var fn take_raw() -> i64 {
        let p = .raw_ptr;
        .is_armed = false;
        .raw_ptr = 0;
        return p;
    }

    pub var fn try_take_raw() -> opt<i64> {
        if .raw_ptr == 0 || !self.is_armed {
            return opt<i64>::none();
        }
        let p = .take_raw();
        return opt<i64>::some(p);
    }

    pub pure fn is_valid() -> bool => .is_armed && .raw_ptr != 0;

    pub pure fn is_null() -> bool => .raw_ptr == 0;

    pub pure fn owner_thread_id() -> u64 => .owner_tid;

    pub var fn disarm() {
        .is_armed = false;
    }

    ~self() {
        if .is_armed && .raw_ptr != 0 {
            if .dtor_fn != 0 {
                if .owner_tid != 0 && current_thread_id() != .owner_tid {
                    var dq = ThreadAffineDropQueue.global();
                    dq.enqueue(.raw_ptr, .dtor_fn, .owner_tid);
                } else {
                    invoke_foreign_destructor(.dtor_fn, .raw_ptr);
                }
            }
            .is_armed = false;
        }
    }
}

// ------------------------------------------------------------------------------
// 4. ForeignGuard<T: IAnyValue> : IGuard (0b11 Scoped Guard)
// Borrows memory and executes strict reverse LIFO cleanup at scope exit
// Statically forbidden from heap escape (ESCAPE001)
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct ForeignGuard<T: IAnyValue> : IGuard {
    pub state_token: T;
    pub release_fn:  fn<T, void>;
    pub is_active:   bool;

    /// Holds `token` until scope exit, then passes it to `release`
    /// (for example a closure calling `PyGILState_Release`).
    pub static fn acquire(token: T, release: fn<T, void>) -> ForeignGuard<T> {
        return ForeignGuard {
            state_token: token,
            release_fn:  release,
            is_active:   true,
        };
    }

    pub pure fn token() -> T => .state_token;

    pub pure fn active() -> bool => .is_active;

    pub var fn disarm() {
        .is_active = false;
    }

    ~self() {
        if .is_active {
            .is_active = false;
            let release = .release_fn;
            release(.state_token);
        }
    }
}

// ------------------------------------------------------------------------------
// 5. PinnedSlice<T: IValue> : IObject (0b10 Pinned Buffer)
// Perceus refcounted buffer whose address never moves on reallocation;
// safe for [Retained] foreign async I/O
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct PinnedSlice<T: IValue> : IObject {
    pub data_ptr:  i64;
    pub len_bytes: usize;
    pub len:       usize;
    pub is_pinned: bool;

    /// A heap block of `count` elements that never moves and is freed when
    /// the last reference drops.
    pub static fn allocate(count: usize, elem_size: usize) -> PinnedSlice<T> {
        return seam("mem.pinned_alloc",
            "pinned, reference-counted heap blocks need the runtime allocator (F7)");
    }

    pub pure fn byte_len() -> usize => .len_bytes;

    pub pure fn is_empty() -> bool => .len == 0;

    pub pure fn as_ptr() -> i64 => .data_ptr;

    pub pure fn pinned() -> bool => .is_pinned;

    pub var fn unpin() {
        .is_pinned = false;
    }

    ~self() {
        .is_pinned = false;
    }
}

// ------------------------------------------------------------------------------
// 6. BorrowCallbackScope : IGuard (0b11 Scoped Borrow Lease)
// Bounds foreign C callbacks borrowing Pilot memory
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct BorrowCallbackScope : IGuard {
    pub scope_id:  u64;
    pub is_active: bool;

    pub static fn enter(id: u64) -> BorrowCallbackScope {
        return BorrowCallbackScope {
            scope_id:  id,
            is_active: true,
        };
    }

    pub pure fn id() -> u64 => .scope_id;

    pub pure fn active() -> bool => .is_active;

    pub var fn leave() {
        .is_active = false;
    }

    ~self() {
        .is_active = false;
    }
}
