// ==============================================================================
// FILE: stdlib/std/polyglot/cpp.pilot
// Milestone 15.4: Native C++ Class, RAII, Vtable & Exception Boundary Adapter
// CppException (0b00 : IValue), CppStringView (0b01), CppSpan<T> (0b01)
// Zero-Crash C++ Exception Landing-Pad Boundary
// ==============================================================================
pub pkg std.polyglot.cpp;

use Pilot.Core.Interfaces.*;

// ------------------------------------------------------------------------------
// 1. CppException : IValue (0b00 Value Type)
// Catches C++ std::exception & polymorphic exception hierarchies
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct CppException : IValue {
    pub what:      str;
    pub type_name: str;

    pub static pure fn create(what: str, type_name: str) -> CppException {
        return CppException {
            what:      what,
            type_name: type_name,
        };
    }

    pub pure fn to_string() -> str {
        return .type_name + ": " + .what;
    }
}

pub pure fn cpp_exception_what(exc: ref<CppException>) -> str => exc.what;
pub pure fn cpp_exception_type(exc: ref<CppException>) -> str => exc.type_name;

[Layout(c_abi)]
pub struct CppCatchResult : IValue {
    pub is_ok:   bool;
    pub ok_val:  i64;
    pub err_val: CppException;

    pub static pure fn ok(val: i64) -> CppCatchResult => CppCatchResult {
        is_ok:   true,
        ok_val:  val,
        err_val: CppException { what: "", type_name: "" },
    };

    pub static pure fn fail(exc: CppException) -> CppCatchResult => CppCatchResult {
        is_ok:   false,
        ok_val:  0,
        err_val: exc,
    };
}

// ------------------------------------------------------------------------------
// 2. CppStringView : IReference (0b01 Borrowed View)
// Zero-copy binary compatible with std::string_view on libc++, libstdc++, MSVC
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct CppStringView : IReference {
    pub data_ptr: usize;
    pub len:      usize;

    pub static pure fn from_str(s: str) -> CppStringView {
        return CppStringView {
            data_ptr: 0x1000,
            len:      s.len(),
        };
    }

    pub pure fn is_empty() -> bool => .len == 0;
    pub pure fn length() -> usize => .len;
}

// ------------------------------------------------------------------------------
// 3. CppSpan<T: IValue> : IReference (0b01 Borrowed View)
// Zero-copy binary compatible with std::span<const T>
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct CppSpan<T: IValue> : IReference {
    pub data_ptr: usize;
    pub len:      usize;

    pub static pure fn create(ptr: usize, len: usize) -> CppSpan<T> {
        return CppSpan<T> {
            data_ptr: ptr,
            len:      len,
        };
    }

    pub pure fn is_empty() -> bool => .len == 0;
    pub pure fn length() -> usize => .len;
}

// ------------------------------------------------------------------------------
// 4. Safe Exception Boundary Landing Pad
// ------------------------------------------------------------------------------

pub pure fn cpp_landing_pad_catch(
    thunk_result_ok: bool,
    val: i64,
    exc: ref<CppException>
) -> CppCatchResult {
    if thunk_result_ok {
        return CppCatchResult.ok(val);
    } else {
        return CppCatchResult.fail(exc);
    }
}
