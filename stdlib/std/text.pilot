// ==============================================================================
// FILE: stdlib/std/text.pilot
// Ring 2: Standard Unicode Text Formatting & String Builders (pub pkg std.text;)
// ==============================================================================
pub pkg std.text;

pub pure fn nameof(sym: str) -> str => sym;

/// Text built a piece at a time. The pieces are kept and joined once, when
/// the text is read (`join_text`), so building n bytes copies each about
/// log2(pieces) times instead of once per later piece.
pub struct StringBuilder : IObject {
    pub pieces: List<str>;
    pub size: usize;

    pub pure fn len(ref self) -> usize => self.size;

    pub fn append(var ref self, piece: str) {
        self.pieces.push(piece);
        self.size = self.size + piece.len();
    }

    /// The text so far; the pieces become one, so reading again is cheap.
    pub fn to_string(var ref self) -> str {
        if self.pieces.len() == 0 { return ""; }
        if self.pieces.len() > 1 { self.pieces = [join_text(self.pieces, "")]; }
        return self.pieces[0];
    }

    ~self() {}
}

pub fn string_builder_new() -> StringBuilder {
    return StringBuilder { pieces: [], size: 0 };
}

/// `parts` in order, with `sep` between each two, as one string. The parts
/// are concatenated in pairs, then the pairs in pairs, and so on, so each
/// byte is copied about log2(parts) times; appending the parts one at a time
/// to a growing string copies everything before a part once per later part.
pub pure fn join_text(parts: List<str>, sep: str) -> str {
    if parts.len() == 0 { return ""; }
    var level: List<str> = [];
    var i = 0;
    while i < parts.len() {
        level.push(if i + 1 < parts.len() { parts[i] + sep } else { parts[i] });
        i = i + 1;
    }
    while level.len() > 1 {
        var next: List<str> = [];
        var k = 0;
        while k + 1 < level.len() {
            next.push(level[k] + level[k + 1]);
            k = k + 2;
        }
        if k < level.len() { next.push(level[k]); }
        level = next;
    }
    return level[0];
}

/// The pieces of `whole` between occurrences of `sep` (not empty), in
/// order: `n` occurrences give `n + 1` pieces, some of which may be empty.
pub fn split_text(whole: str, sep: str) -> List<str> {
    var out: List<str> = [];
    var at = 0;
    while true {
        let next = whole.find(sep, at);
        if next < 0 { break; }
        out.push(whole.slice(at, next));
        at = next + sep.len();
    }
    out.push(whole.slice(at, whole.len()));
    return out;
}

/// The decimal integer `text` spells (an optional sign, then digits, with no
/// surrounding space), or `none` when it spells something else or does not
/// fit in an `i64`.
pub fn parse_i64(text: str) -> i64? {
    let n = text.len();
    if n == 0 { return none; }
    let negative = text.byte_at(0) == 45;
    var at = if negative || text.byte_at(0) == 43 { 1 } else { 0 };
    if at == n { return none; }
    // Accumulated as a negative number, whose range includes i64's minimum.
    var value = 0;
    while at < n {
        let b = text.byte_at(at);
        if b < 48 || b > 57 { return none; }
        let digit = b - 48;
        if value < (-9223372036854775807 - 1 + digit) / 10 { return none; }
        value = value * 10 - digit;
        at = at + 1;
    }
    if negative { return value; }
    if value == -9223372036854775807 - 1 { return none; }
    return -value;
}

/// `s` followed by spaces up to `width` bytes; `s` itself when it is as wide.
pub fn pad_right(s: str, width: i64) -> str {
    var out = s;
    while out.len() < width { out = out + " "; }
    return out;
}

/// Spaces up to `width` bytes followed by `s`; `s` itself when it is as wide.
pub fn pad_left(s: str, width: i64) -> str {
    var out = s;
    while out.len() < width { out = " " + out; }
    return out;
}
