// ==============================================================================
// FILE: stdlib/std/proc.pilot
// Ring 2: Standard Process Spawning & Control (pub pkg std.proc;)
// ==============================================================================
pub pkg std.proc;

use Pilot.Core.File;
use Pilot.Core.HostRaw;
use Pilot.Core.Env;
use std.text;

fn proc_str_buf(s: str) -> i64 {
    let n = s.len();
    let cap = if n > 0 { n } else { 1 };
    let buf = RawMem.alloc(cap, 1);
    if n > 0 { let _ = str_copy_to_ptr(s, buf, n); }
    return buf;
}

/// One read of what `fd` has (at most 64 KiB); `""` when it has ended.
fn proc_read_some(fd: i64) -> str {
    let cap = 65536;
    let buf = RawMem.alloc(cap, 1);
    let r = Fd.read(fd, buf, cap);
    let out = if r > 0 { str_from_ptr(buf, r) } else { "" };
    let _ = RawMem.free(buf, cap, 1);
    return out;
}

/// Entry `i` of a poll list at `fds` (16 bytes each: fd, events, revents)
/// asks whether `fd` can be read.
fn proc_pollfd_set(fds: i64, i: i64, fd: i64) {
    let _ = RawMem.store_int(fds + i * 16, fd, 64);
    let _ = RawMem.store_int(fds + i * 16 + 8, 1, 32);
    let _ = RawMem.store_int(fds + i * 16 + 12, 0, 32);
}

fn proc_make_pipe(var ref rfd: i64, var ref wfd: i64) -> bool {
    let p = RawMem.alloc(16, 8);
    let rc = Fd.pipe_dup(0, p, 0);
    if rc < 0 {
        let _ = RawMem.free(p, 16, 8);
        return false;
    }
    rfd = RawMem.load_int(p, 64, 1);
    wfd = RawMem.load_int(p + 8, 64, 1);
    let _ = RawMem.free(p, 16, 8);
    return true;
}

/// A block of `{ ptr, len }` slices (OsSlice) over copies of `items`, or 0
/// when there are none; the copies' buffers go in `bufs`.
fn proc_slices(ref items: List<str>, var ref bufs: List<i64>) -> i64 {
    if items.len() == 0 { return 0; }
    let block = RawMem.alloc(items.len() * 16, 8);
    var i = 0;
    while i < items.len() {
        let b = proc_str_buf(items[i]);
        bufs.push(b);
        let _ = RawMem.store_int(block + i * 16, b, 64);
        let _ = RawMem.store_int(block + i * 16 + 8, items[i].len(), 64);
        i = i + 1;
    }
    return block;
}

/// Frees what `proc_slices` made for `items`.
fn proc_slices_free(block: i64, ref items: List<str>, ref bufs: List<i64>) {
    var i = 0;
    while i < bufs.len() {
        let n = items[i].len();
        let _ = RawMem.free(bufs[i], if n > 0 { n } else { 1 }, 1);
        i = i + 1;
    }
    if block != 0 { let _ = RawMem.free(block, items.len() * 16, 8); }
}

/// Starts `program`; `env` holds `KEY=value` entries added to the inherited
/// environment (OsProcSpec env_mode 0).
fn proc_spawn_impl(dir: str, program: str, args: List<str>, input: str, env: List<str>) -> ProcessHandle {
    var in_r = -1;
    var in_w = -1;
    var out_r = -1;
    var out_w = -1;
    var err_r = -1;
    var err_w = -1;
    if !proc_make_pipe(in_r, in_w) || !proc_make_pipe(out_r, out_w) || !proc_make_pipe(err_r, err_w) {
        fault(f"proc_spawn: pipe failed for {program}");
    }

    let pbuf = proc_str_buf(program);
    let dbuf = if dir != "" { proc_str_buf(dir) } else { 0 };
    var arg_bufs: List<i64> = [];
    let argv_buf = proc_slices(args, arg_bufs);
    var env_bufs: List<i64> = [];
    let envp_buf = proc_slices(env, env_bufs);

    let spec = RawMem.alloc(96, 8);
    let _ = RawMem.fill(spec, 0, 96);
    let _ = RawMem.store_int(spec + 0, pbuf, 64);
    let _ = RawMem.store_int(spec + 8, program.len(), 64);
    let _ = RawMem.store_int(spec + 16, argv_buf, 64);
    let _ = RawMem.store_int(spec + 24, args.len(), 64);
    let _ = RawMem.store_int(spec + 32, envp_buf, 64);
    let _ = RawMem.store_int(spec + 40, env.len(), 64);
    let _ = RawMem.store_int(spec + 48, dbuf, 64);
    let _ = RawMem.store_int(spec + 56, dir.len(), 64);
    let _ = RawMem.store_int(spec + 64, in_r, 64);
    let _ = RawMem.store_int(spec + 72, out_w, 64);
    let _ = RawMem.store_int(spec + 80, err_w, 64);

    let pid_ptr = RawMem.alloc(8, 8);
    let handle = Process.spawn(spec, pid_ptr);
    let _ = RawMem.free(pid_ptr, 8, 8);
    let _ = RawMem.free(spec, 96, 8);
    proc_slices_free(argv_buf, args, arg_bufs);
    proc_slices_free(envp_buf, env, env_bufs);
    if dbuf != 0 { let _ = RawMem.free(dbuf, dir.len(), 1); }
    let _ = RawMem.free(pbuf, if program.len() > 0 { program.len() } else { 1 }, 1);

    let _ = Fd.close(in_r);
    let _ = Fd.close(out_w);
    let _ = Fd.close(err_w);

    if handle < 0 {
        let _ = Fd.close(in_w);
        let _ = Fd.close(out_r);
        let _ = Fd.close(err_r);
        fault(f"proc_spawn failed for {program}: {handle}");
    }

    if input.len() > 0 {
        let ibuf = proc_str_buf(input);
        var off = 0;
        while off < input.len() {
            let w = Fd.write(in_w, ibuf + off, input.len() - off);
            if w <= 0 { break; }
            off = off + w;
        }
        let _ = RawMem.free(ibuf, input.len(), 1);
    }
    let _ = Fd.close(in_w);

    return ProcessHandle { id: handle, stdout_fd: out_r, stderr_fd: err_r, exited: false, exit_code: 0, stdout_text: "", stderr_text: "" };
}

[Layout(c_abi)]
pub struct ProcessExit : IValue {
    pub exit_code: i32;
    pub success:   bool;
}

pub pure fn process_exit_new(code: i32) -> ProcessExit {
    return ProcessExit { exit_code: code, success: code == 0 };
}

/// What a finished child process left: its exit code and everything it
/// wrote. A process killed by a signal has exit code `-1`.
pub struct ProcessOutput : IValue {
    pub exit_code: i64;
    pub stdout:    str;
    pub stderr:    str;
}

/// Runs `program` with `args`, writes `input` to its standard input, and
/// waits for it. A program that cannot be started stops the caller with an
/// intrinsic failure.
pub fn run(program: str, args: List<str>, input: str) -> ProcessOutput {
    let h = spawn(program, args, input);
    return h.wait();
}

/// Runs `program` like `run`, with `dir` as its working directory.
pub fn run_in(dir: str, program: str, args: List<str>, input: str) -> ProcessOutput {
    let h = spawn_in(dir, program, args, input);
    return h.wait();
}

/// A child process started with `spawn`, running until `wait` collects it.
/// What it writes is collected while it runs (`drain`), so a child that
/// writes more than a pipe holds is never left waiting for a reader.
pub struct ProcessHandle : IObject {
    pub id:          i64;
    pub stdout_fd:   i64;
    pub stderr_fd:   i64;
    pub exited:      bool;
    pub exit_code:   i64;
    pub stdout_text: str;
    pub stderr_text: str;

    /// Reads what the child has written so far, waiting up to `timeout_ms`
    /// (`-1`: until something comes) for either stream to have something.
    /// A stream that has ended is closed. Returns whether either is open.
    pub fn drain(timeout_ms: i64) -> bool {
        let fds = RawMem.alloc(32, 8);
        var n = 0;
        if .stdout_fd >= 0 { proc_pollfd_set(fds, n, .stdout_fd); n = n + 1; }
        if .stderr_fd >= 0 { proc_pollfd_set(fds, n, .stderr_fd); n = n + 1; }
        if n == 0 {
            let _ = RawMem.free(fds, 32, 8);
            return false;
        }
        let ready = Fd.poll(fds, n, timeout_ms);
        if ready > 0 {
            for i in 0 .. n {
                // revents: 1 readable, 4 error, 8 hung up, 16 not open.
                if RawMem.load_int(fds + i * 16 + 12, 32, 0) == 0 { continue; }
                let fd = RawMem.load_int(fds + i * 16, 64, 1);
                let chunk = proc_read_some(fd);
                if fd == .stdout_fd {
                    if chunk.len() > 0 { .stdout_text = .stdout_text + chunk; } else { let _ = Fd.close(fd); .stdout_fd = -1; }
                } else {
                    if chunk.len() > 0 { .stderr_text = .stderr_text + chunk; } else { let _ = Fd.close(fd); .stderr_fd = -1; }
                }
            }
        }
        let _ = RawMem.free(fds, 32, 8);
        return .stdout_fd >= 0 || .stderr_fd >= 0;
    }

    /// Waits for the process to finish and returns what it left. Each
    /// handle is waited for once.
    pub fn wait() -> ProcessOutput {
        while .drain(-1) {}
        var code = .exit_code;
        if .exited != true {
            let code_ptr = RawMem.alloc(8, 8);
            let rc = Process.wait(.id, 0, code_ptr);
            code = if rc >= 0 { RawMem.load_int(code_ptr, 64, 1) } else { -1 };
            let _ = RawMem.free(code_ptr, 8, 8);
            .exited = true;
            .exit_code = code;
        }
        return ProcessOutput { exit_code: code, stdout: .stdout_text, stderr: .stderr_text };
    }
}

/// Starts `program` with `args`, writing `input` to its standard input, and
/// returns at once; several can run at the same time. A program that cannot
/// be started stops the caller with an intrinsic failure.
pub fn spawn(program: str, args: List<str>, input: str) -> ProcessHandle {
    return proc_spawn_impl("", program, args, input, []);
}

/// Starts `program` like `spawn`, with `dir` as its working directory.
pub fn spawn_in(dir: str, program: str, args: List<str>, input: str) -> ProcessHandle {
    return proc_spawn_impl(dir, program, args, input, []);
}

/// One process to start: the program, its arguments, its standard input and
/// `KEY=value` entries added to the environment it inherits.
pub struct ProcessJob : IObject {
    pub program: str;
    pub args:    List<str>;
    pub input:   str;
    pub env:     List<str>;
}

/// The job that runs `program` with `args` and `input`.
pub fn job(program: str, args: List<str>, input: str) -> ProcessJob => ProcessJob { program: program, args: args, input: input, env: [] };

/// The job that runs `program` like `job`, with `env` (`KEY=value` entries)
/// added to the environment it inherits.
pub fn job_env(program: str, args: List<str>, input: str, env: List<str>) -> ProcessJob =>
    ProcessJob { program: program, args: args, input: input, env: env };

/// Starts the job `start` like `spawn`, with its environment entries.
pub fn spawn_job(ref start: ProcessJob) -> ProcessHandle => proc_spawn_impl("", start.program, start.args, start.input, start.env);

/// Waits until one of `running` has finished and returns its position in
/// `running`; that handle's `wait` then returns at once.
pub fn first_finished(ref running: List<ProcessHandle>) -> i64 {
    let code_ptr = RawMem.alloc(8, 8);
    var k = 0;
    while true {
        k = 0;
        while k < running.len() {
            // Collect its output first: a child blocked writing to a full
            // pipe never finishes.
            let _ = running[k].drain(0);
            if running[k].exited {
                let _ = RawMem.free(code_ptr, 8, 8);
                return k;
            }
            let rc = Process.wait(running[k].id, 1, code_ptr);
            if rc != 0 {
                running[k].exited = true;
                running[k].exit_code = if rc > 0 { RawMem.load_int(code_ptr, 64, 1) } else { -1 };
                let _ = RawMem.free(code_ptr, 8, 8);
                return k;
            }
            k = k + 1;
        }
        let _ = Clock.sleep_ns(1000000);
    }
    let _ = RawMem.free(code_ptr, 8, 8);
    return 0;
}

/// Memory to keep free for each job started since the last one finished:
/// a new job can grow to about this much (bytes) before its share shows in
/// the memory the OS reports as available.
pub fn job_memory_reserve() -> i64 => 2 * 1024 * 1024 * 1024;

/// Whether another job may start now, with `running` jobs running, `fresh`
/// of them started since the last one finished: always when none is running,
/// else when the machine has a CPU and, if the OS reports its available
/// memory, `job_memory_reserve()` for the new job and each fresh one.
fn may_start(running: i64, fresh: i64, cpus: i64) -> bool {
    if running == 0 { return true; }
    if running >= cpus { return false; }
    guard some free = memory_available() else { return true; };
    return free >= job_memory_reserve() * (fresh + 1);
}

/// Runs every job in `jobs`, at most as many at once as the machine has
/// CPUs, starting the next as soon as any one finishes, so one slow job never
/// holds the others back. A job starts only while the machine has memory
/// for it (`may_start`), so jobs that each need a lot of memory are not
/// stacked until the machine runs out; one job always runs. Returns what
/// each left, in the order of `jobs`.
pub fn run_all(ref jobs: List<ProcessJob>) -> List<ProcessOutput> {
    let cpus = if cpu_count() > 1 { cpu_count() } else { 1 };
    var running: List<ProcessHandle> = [];
    var slots: List<i64> = [];
    var started = 0;
    var fresh = 0;
    // What each finished job left, and which job it was.
    var done: List<ProcessOutput> = [];
    var done_slots: List<i64> = [];
    while started < jobs.len() || running.len() > 0 {
        while started < jobs.len() && may_start(running.len() as i64, fresh, cpus) {
            running.push(spawn_job(jobs[started]));
            slots.push(started);
            started = started + 1;
            fresh = fresh + 1;
        }
        let k = first_finished(running);
        done.push(running[k].wait());
        done_slots.push(slots[k]);
        running.remove_at(k);
        slots.remove_at(k);
        fresh = 0;
    }
    var out: List<ProcessOutput> = [];
    for i in 0 .. jobs.len() {
        var j = 0;
        while done_slots[j] != i { j = j + 1; }
        out.push(done[j]);
    }
    return out;
}

/// The memory (bytes) the OS can give new processes without swapping, or
/// `none` when it does not say.
[StandIn("proc.memory_available", "each OS's own report of available memory (Linux /proc/meminfo, macOS host_statistics64, Windows GlobalMemoryStatusEx)", "only Linux's /proc/meminfo is read; on other OSes it is none, and run_all is limited by the CPU count alone", "F6")]
pub fn memory_available() -> i64? {
    let path = "/proc/meminfo";
    if !File.exists(path) { return none; }
    let info = File.read_text(path);
    let key = "MemAvailable:";
    let at = info.find(key, 0);
    if at < 0 { return none; }
    var end = info.find("\n", at);
    if end < 0 { end = info.len() as i64; }
    var field = info.slice((at + key.len() as i64) as usize, end as usize).trim();
    if !field.ends_with(" kB") { return none; }
    field = field.slice(0, field.len() - 3).trim();
    guard some kb = text.parse_i64(field) else { return none; };
    return kb * 1024;
}

/// How many processes the machine runs at once (its logical CPUs).
pub fn cpu_count() -> i64 {
    let n = Thread.ctl(2, 0);
    return if n >= 1 { n } else { 1 };
}

/// The path of the running executable, or `none` when the OS does not say.
pub fn current_exe() -> str? {
    let out_len_ptr = RawMem.alloc(8, 8);
    var cap = 1024;
    var buf = RawMem.alloc(cap, 1);
    var rc = Env.ctl(3, 0, 0, buf, cap, out_len_ptr);
    if rc == -44 {
        let need = RawMem.load_int(out_len_ptr, 64, 0);
        if need > cap {
            buf = RawMem.realloc(buf, cap, need, 1);
            cap = need;
            rc = Env.ctl(3, 0, 0, buf, cap, out_len_ptr);
        }
    }
    let n = RawMem.load_int(out_len_ptr, 64, 0);
    let _ = RawMem.free(out_len_ptr, 8, 8);
    if rc < 0 || n <= 0 {
        let _ = RawMem.free(buf, cap, 1);
        return none;
    }
    // Typed: `str_from_ptr` is an untyped native, and PilIR returns a value of
    // unknown type from a `-> str?` function without making it `some`
    // (stand-in `ir.absent_as_null`, seams.pilot).
    let out: str = str_from_ptr(buf, n);
    let _ = RawMem.free(buf, cap, 1);
    return out;
}

/// The environment variable through which a program started by the `pilot`
/// CLI is told the CLI's path (`pilot test --emit c` sets it).
pub fn pilot_cli_env() -> str => "PILOT_CLI";

/// The path of the `pilot` CLI, for a program that starts it again (`pilot
/// test` cases): `PILOT_CLI` when set, else the running executable when that
/// is the CLI. A program compiled to its own binary and started without
/// `PILOT_CLI` would start itself without end: that stops at a seam.
pub fn pilot_cli_path() -> str {
    let given = Env.get(pilot_cli_env());
    if given != "" { return given; }
    let exe = current_exe() ?? "pilot";
    if exe.ends_with("/pilot") || exe.ends_with("/pilot.exe") || exe == "pilot" { return exe; }
    return seam("proc.pilot_cli_path", f"started as {exe}, which is not the pilot CLI");
}
