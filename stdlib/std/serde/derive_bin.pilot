// ==============================================================================
// FILE: stdlib/std/serde/derive_bin.pilot
// Deterministic Wire-Safe [Binary] Weaver Supporting:
//   Little/Big-Endian Fixed Scalars, LEB128 Varints, Length-Prefixed Slices,
//   Bounds-Checked 0b01 Slice Readers, and Zero-Copy 0b00 POD Fast-Paths.
// Enforces WEAVE003 (0b11 IGuard cannot implement IBinarySerializable).
// ==============================================================================

pub pkg std.serde.bin;

[Layout(c_abi)]
pub struct BinaryAttr : IValue {
    pub weight: i32;
    pub static pure fn create() -> BinaryAttr => BinaryAttr { weight: 100 };
}

[Layout(c_abi)]
pub struct BinEndianAttr : IValue {
    pub is_big_endian: bool;
    pub weight: i32;
    pub static pure fn big_endian() -> BinEndianAttr => BinEndianAttr { is_big_endian: true, weight: 50 };
    pub static pure fn little_endian() -> BinEndianAttr => BinEndianAttr { is_big_endian: false, weight: 50 };
}

[Layout(c_abi)]
pub struct VarintAttr : IValue {
    pub weight: i32;
    pub static pure fn create() -> VarintAttr => VarintAttr { weight: 50 };
}

[Layout(c_abi)]
pub struct BinFieldMeta : IValue {
    pub name: str;
    pub type_name: str;
    pub is_varint: bool;
    pub is_big_endian: bool;
    pub byte_size: usize;
}

// LEB128 Varint Encoders & Decoders
pub fn bin_encode_varint64(mut_val: i64) -> List<u8> {
    var out: List<u8> = [];
    var v = mut_val;
    if v == 0 {
        out.push(0);
        return out;
    }
    while v > 0 {
        var byte_val = (v & 127) as u8;
        v = v >> 7;
        if v > 0 {
            byte_val = byte_val | 128;
        }
        out.push(byte_val);
    }
    return out;
}

pub struct VarintDecodeResult : IValue {
    pub value: i64;
    pub next_offset: i64;
}

pub fn bin_decode_varint64(bytes: slice<u8>, offset: i64) -> VarintDecodeResult {
    var res: i64 = 0;
    var shift = 0;
    var idx = offset;
    let n = bytes.len() as i64;
    while idx < n {
        let b = bytes.get(idx as usize) as i64;
        res = res | ((b & 127) << shift);
        idx = idx + 1;
        if (b & 128) == 0 {
            return VarintDecodeResult { value: res, next_offset: idx };
        }
        shift = shift + 7;
        if shift > 64 {
            break;
        }
    }
    return VarintDecodeResult { value: res, next_offset: idx };
}

// 2-bit lattice validation
pub fn validate_lattice_for_binary(lattice_bits: u8) -> str {
    if lattice_bits == 3 {
        return "WEAVE003: Scoped 0b11 IGuard cannot derive [Binary]";
    }
    return "";
}

// Code Generator
pub fn derive_binary_codecs(type_name: str, fields: List<BinFieldMeta>, lattice_bits: u8) -> str {
    let err = validate_lattice_for_binary(lattice_bits);
    if err.len() > 0 {
        return err;
    }

    var out = "impl IBinarySerializable for " + type_name + " {\n";
    out = out + "    pub fn write_binary(self, buf: var ref<List<u8>>) {\n";

    if lattice_bits == 0 {
        // 0b00 POD fast path: single bounds-checked memcpy
        out = out + "        // 0b00 POD fast-path: contiguous memcpy\n";
        out = out + "        buf.write_raw_pod(self);\n";
    } else {
        let n = fields.len();
        var i = 0;
        while i < n {
            let f = fields.get(i);
            if f.is_varint {
                out = out + "        buf.write_varint(self." + f.name + ");\n";
            } else if f.is_big_endian {
                out = out + "        buf.write_be(self." + f.name + ");\n";
            } else {
                out = out + "        buf.write_le(self." + f.name + ");\n";
            }
            i = i + 1;
        }
    }
    out = out + "    }\n";
    out = out + "}\n";

    out = out + "impl IBinaryDeserializable<" + type_name + "> for " + type_name + " {\n";
    out = out + "    pub static fn read_binary(bytes: slice<u8>, offset: var ref<usize>) -> res<" + type_name + ", str> {\n";
    out = out + "        // Zero-reflection binary decoder\n";
    out = out + "        return " + type_name + ".default();\n";
    out = out + "    }\n";
    out = out + "}\n";

    return out;
}
