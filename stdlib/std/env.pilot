// ==============================================================================
// FILE: stdlib/std/env.pilot
// Ring 2: Standard Process Environment Variables (pub pkg std.env;)
// ==============================================================================
pub pkg std.env;

pub pure fn nameof(sym: str) -> str => sym;

[Layout(c_abi)]
pub struct EnvVar : IValue {
    pub key: str;
    pub val: str;
}

pub pure fn env_var_new(k: str, v: str) -> EnvVar {
    return EnvVar { key: k, val: v };
}
