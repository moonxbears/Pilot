// ==============================================================================
// FILE: stdlib/std/env.pilot
// Ring 2: Standard Process Environment Variables (pub pkg std.env;)
// ==============================================================================
pub pkg std.env;

use Pilot.Core.Bridge.Os;

/// The arguments given after `--` when the program was started, in order.
pub fn args() -> List<str> {
    let out_len_ptr = os_slab_alloc(8, 8);
    var cap = 4096;
    var buf = os_slab_alloc(cap, 4);
    var rc = os_env_ctl(2, 0, 0, buf, cap, out_len_ptr);
    if rc == -44 {
        let need = os_load_int(out_len_ptr, 64, 0);
        if need > cap {
            buf = os_slab_realloc(buf, cap, need, 4);
            cap = need;
            rc = os_env_ctl(2, 0, 0, buf, cap, out_len_ptr);
        }
    }
    let total = os_load_int(out_len_ptr, 64, 0);
    let _ = os_slab_free(out_len_ptr, 8, 8);
    var out: List<str> = [];
    if rc < 0 {
        let _ = os_slab_free(buf, cap, 4);
        return out;
    }
    var off = 0;
    while off + 4 <= total {
        let n = os_load_int(buf + off, 32, 0);
        off = off + 4;
        if off + n > total { break; }
        out.push(str_from_ptr(buf + off, n));
        off = off + n;
    }
    let _ = os_slab_free(buf, cap, 4);
    return out;
}

[Layout(c_abi)]
pub struct EnvVar : IValue {
    pub key: str;
    pub val: str;
}

pub pure fn env_var_new(k: str, v: str) -> EnvVar {
    return EnvVar { key: k, val: v };
}
