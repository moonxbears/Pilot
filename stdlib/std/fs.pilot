pub pkg std.fs;

[Layout(c_abi)]
pub struct DirEntry : IValue {
    pub path:     str;
    pub is_dir:   bool;
    pub file_len: usize;
}

pub pure fn dir_entry_new(path: str, is_dir: bool, len: usize) -> DirEntry {
    return DirEntry { path: path, is_dir: is_dir, file_len: len };
}

/// How a file is opened.
pub enum OpenMode : u8 {
    Read,
    Write,
    Append,
    ReadWrite,
}

pub struct FileHandle : IObject {
    pub path: str;
    pub mode: OpenMode;

    ~self() {}
}

/// Opens `path` with `mode` and returns the owning handle.
pub fn file_handle_open(path: str, mode: OpenMode) -> FileHandle {
    return seam("fs.open", "opening an OS file descriptor needs host file intrinsics");
}
