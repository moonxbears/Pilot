// ==============================================================================
// FILE: stdlib/std/os.pilot
// Ring 2: Standard Operating System Introspection (pub pkg std.os;)
// ==============================================================================
pub pkg std.os;

pub pure fn nameof(sym: str) -> str => sym;

[Layout(c_abi)]
pub struct HostSystemInfo : IValue {
    pub os_name: str;
    pub arch:    str;
}

/// The operating system and CPU architecture this program runs on.
pub fn host_system_info() -> HostSystemInfo {
    return seam("os.host_info", "reading the host OS and architecture needs a host query intrinsic");
}
