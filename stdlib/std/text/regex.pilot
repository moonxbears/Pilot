// ==============================================================================
// FILE: stdlib/std/text/regex.pilot
// Ring 2: Regular expressions (pub pkg std.text.regex;)
// ==============================================================================
// `compile(r"(\w+)@(\w+)")` parses a pattern into a program for a Pike VM
// (Thompson NFA simulation with capture slots): every thread advances in
// lock step over the text, so a search costs O(pattern x text) whatever the
// pattern, with no backtracking. Matches follow leftmost-first priority, the
// same answer a backtracking engine such as Python's `re` gives.
//
// Syntax (Python `re`): literals, `.`, `[...]` / `[^...]` with ranges,
// `\d \w \s \D \W \S` (Unicode, as Python without re.ASCII), `^ $ \A \Z \b
// \B`, groups `(...)`, `(?:...)`, `(?P<name>...)`, alternation `|`,
// quantifiers `* + ? {n} {n,} {,m} {n,m}` and their lazy forms (`*?` ...),
// escapes `\n \t \r \f \v \a \0 \xHH \uHHHH \UHHHHHHHH`. Flags (RegexFlag):
// `i` ignore case, `m` multiline, `s` dot matches newline, `x` verbose, `a`
// ASCII classes, given to `compile_with` or written as `(?imsxa)` at the
// start of the pattern or `(?i:...)` / `(?-i:...)` around a part. `.` and
// classes match whole UTF-8 code points; offsets are byte offsets into the
// text. Backreferences and lookaround are refused (REGEX007): they are not
// regular, and the engine keeps its linear-time guarantee.
//
// The parser and compiler are std.text.regex_syntax; the VM is
// std.text.regex_vm.
pub pkg std.text.regex;

use std.text.regex_syntax;
use std.text.regex_vm;

pub struct Regex : IObject {
    pub pattern: str;
    pub prog: ReProgram;

    /// Capture groups, not counting the whole match (group 0).
    pub fn groups(ref self) -> i64 => self.prog.groups;

    /// The number of the group named `name`, or -1.
    pub fn group_index(ref self, name: str) -> i64 => name_index(self.prog.names, name);

    // --------------------------------------------------------------------------
    // One match
    // --------------------------------------------------------------------------

    /// Whether the pattern matches anywhere in `text`.
    pub fn is_match(ref self, text: str) -> bool {
        var vm = new_vm(self.prog);
        return pike_search(self.prog, vm, text, 0, -1, false, false);
    }

    /// The leftmost match in `text`, or `none`.
    pub fn find(ref self, text: str) -> Match? => self.find_at(text, 0);

    /// The leftmost match starting at or after byte `pos`, or `none`. `^`
    /// and `\b` still look at the text before `pos`.
    pub fn find_at(ref self, text: str, pos: i64) -> Match? {
        var vm = new_vm(self.prog);
        if !pike_search(self.prog, vm, text, pos, -1, false, false) { return none; }
        return make_match(text, vm.found);
    }

    /// The match starting exactly at byte `pos` (Python's `re.match` at 0),
    /// or `none`.
    pub fn match_at(ref self, text: str, pos: i64) -> Match? {
        var vm = new_vm(self.prog);
        if !pike_search(self.prog, vm, text, pos, -1, true, false) { return none; }
        return make_match(text, vm.found);
    }

    /// The match covering all of `text` (Python's `re.fullmatch`), or `none`.
    pub fn full_match(ref self, text: str) -> Match? {
        var vm = new_vm(self.prog);
        if !pike_search(self.prog, vm, text, 0, -1, true, true) { return none; }
        return make_match(text, vm.found);
    }

    /// The leftmost match in `text` with its capture groups, or `none`.
    pub fn captures(ref self, text: str) -> Captures? => self.captures_at(text, 0);

    /// As `captures`, for a match starting at or after byte `pos`.
    pub fn captures_at(ref self, text: str, pos: i64) -> Captures? {
        var vm = new_vm(self.prog);
        if !pike_search(self.prog, vm, text, pos, -1, false, false) { return none; }
        return Captures { text: text, slots: vm.found_slots(), names: self.prog.names };
    }

    // --------------------------------------------------------------------------
    // Every match
    // --------------------------------------------------------------------------

    /// Every match in `text`, left to right, without overlaps. An empty match
    /// is never taken right where the previous match, also empty, was.
    pub fn find_all(ref self, text: str) -> List<Match> {
        var out: List<Match> = [];
        for slots in all_slots(self.prog, text, -1) {
            out.push(make_match(text, slots));
        }
        return out;
    }

    /// Every match in `text` with its capture groups.
    pub fn captures_all(ref self, text: str) -> List<Captures> {
        var out: List<Captures> = [];
        for slots in all_slots(self.prog, text, -1) {
            out.push(Captures { text: text, slots: slots, names: self.prog.names });
        }
        return out;
    }

    /// `text` cut at every match (Python's `re.split` for a pattern without
    /// groups; the text of groups is not inserted between the pieces).
    pub fn split(ref self, text: str) -> List<str> => self.split_n(text, 0);

    /// As `split`, cutting at most `count` times (all when `count` is 0).
    pub fn split_n(ref self, text: str, count: i64) -> List<str> {
        var out: List<str> = [];
        var last = 0;
        let limit = if count > 0 { count } else { -1 };
        for slots in all_slots(self.prog, text, limit) {
            out.push(text.slice(last as usize, slots[0] as usize));
            last = slots[1];
        }
        out.push(text.slice(last as usize, text.len()));
        return out;
    }

    // --------------------------------------------------------------------------
    // Replacing
    // --------------------------------------------------------------------------

    /// `text` with every match replaced by `template`, in which `\1`..`\99`
    /// and `\g<n>` / `\g<name>` insert a group, `\\` a backslash and `\n`,
    /// `\t`, `\r` their control characters.
    pub fn replace(ref self, text: str, template: str) -> res<str, RegexError> => self.replace_n(text, template, 0);

    /// As `replace`, replacing at most `count` matches (all when `count` is 0).
    pub fn replace_n(ref self, text: str, template: str, count: i64) -> res<str, RegexError> {
        let parts = parse_template(self.prog, template)?;
        var out = "";
        var last = 0;
        let limit = if count > 0 { count } else { -1 };
        for slots in all_slots(self.prog, text, limit) {
            out = out + text.slice(last as usize, slots[0] as usize);
            for part in parts {
                if part.group < 0 {
                    out = out + part.text;
                } else if slots[2 * part.group] >= 0 {
                    out = out + text.slice(slots[2 * part.group] as usize, slots[2 * part.group + 1] as usize);
                }
            }
            last = slots[1];
        }
        return ok(out + text.slice(last as usize, text.len()));
    }

    /// `text` with every match replaced by what `f` returns for it.
    pub fn replace_with(ref self, text: str, f: (Captures) => str) -> str {
        var out = "";
        var last = 0;
        for slots in all_slots(self.prog, text, -1) {
            let start = slots[0];
            let end = slots[1];
            out = out + text.slice(last as usize, start as usize);
            out = out + f(Captures { text: text, slots: slots, names: self.prog.names });
            last = end;
        }
        return out + text.slice(last as usize, text.len());
    }

    ~self() {}
}

/// One match: byte offsets into the searched text and the matched text.
pub struct Match : IValue {
    pub start: i64;
    pub end: i64;
    pub text: str;
}

fn make_match(text: str, ref slots: List<i64>) -> Match {
    let start = slots[0];
    let end = slots[1];
    return Match { start: start, end: end, text: text.slice(start as usize, end as usize) };
}

/// The number of the group named `name` in `names` (group number - 1 order),
/// or -1.
fn name_index(ref names: List<str>, name: str) -> i64 {
    var i = 0;
    while i < (names.len() as i64) {
        if names[i] == name { return i + 1; }
        i = i + 1;
    }
    return -1;
}

/// A match with its capture groups (group 0 is the whole match).
pub struct Captures : IObject {
    pub text: str;
    /// `2 * g` and `2 * g + 1` hold group `g`'s byte offsets, -1 if unset.
    pub slots: List<i64>;
    pub names: List<str>;

    /// The number of groups, counting group 0.
    pub fn len(ref self) -> i64 => (self.slots.len() as i64) / 2;

    /// The text group `g` matched, or `none` when it did not take part.
    pub fn get(ref self, g: i64) -> str? {
        if g < 0 || 2 * g >= (self.slots.len() as i64) || self.slots[2 * g] < 0 { return none; }
        return self.text.slice(self.slots[2 * g] as usize, self.slots[2 * g + 1] as usize);
    }

    /// The text the group named `name` matched, or `none`.
    pub fn name(ref self, name: str) -> str? {
        let g = name_index(self.names, name);
        if g < 0 { return none; }
        return self.get(g);
    }

    /// Byte offset where group `g` starts, -1 when it did not take part.
    pub fn start(ref self, g: i64) -> i64 => self.slots[2 * g];

    /// Byte offset where group `g` ends, -1 when it did not take part.
    pub fn end(ref self, g: i64) -> i64 => self.slots[2 * g + 1];

    /// Byte offset where the group named `name` starts, -1 when it did not
    /// take part or there is no such group.
    pub fn name_start(ref self, name: str) -> i64 {
        let g = name_index(self.names, name);
        if g < 0 { return -1; }
        return self.slots[2 * g];
    }

    /// Byte offset where the group named `name` ends, -1 when it did not
    /// take part or there is no such group.
    pub fn name_end(ref self, name: str) -> i64 {
        let g = name_index(self.names, name);
        if g < 0 { return -1; }
        return self.slots[2 * g + 1];
    }

    ~self() {}
}

// ------------------------------------------------------------------------------
// Compiling
// ------------------------------------------------------------------------------

/// Compiles `pattern`, or reports the first syntax error with its byte offset.
pub fn compile(pattern: str) -> res<Regex, RegexError> {
    let prog = compile_program(pattern, 0)?;
    return ok(Regex { pattern: pattern, prog: prog });
}

/// Compiles `pattern` with `flags` on from the start.
pub fn compile_with(pattern: str, flags: List<RegexFlag>) -> res<Regex, RegexError> {
    var bits = 0;
    for f in flags {
        bits = bits | (f as i64);
    }
    let prog = compile_program(pattern, bits)?;
    return ok(Regex { pattern: pattern, prog: prog });
}

/// Compiles `pattern`, which must be valid: an invalid pattern stops the
/// program with its error. For patterns written in the source, such as
/// `const WORD = comptime must_compile(r"\w+");`.
pub fn must_compile(pattern: str) -> Regex {
    let r = compile(pattern);
    if !r.is_ok {
        let e = r.err_val;
        assert(false, f"invalid regular expression {pattern}: {e.code()} at {e.pos}: {e.message}");
    }
    return r.ok_val;
}

/// `text` with every character that has a meaning in a pattern escaped by a
/// backslash (the characters Python 3.7+'s `re.escape` escapes), so the
/// result matches `text` literally.
pub fn escape(text: str) -> str {
    let special = "()[]{}?*+-|^$\\.&~# ";
    var out = "";
    var last = 0;
    let n = text.len() as i64;
    var i = 0;
    while i < n {
        let b = text.byte_at(i as usize) as i64;
        var hit = b >= 9 && b <= 13;
        var k = 0;
        while k < (special.len() as i64) && !hit {
            hit = (special.byte_at(k as usize) as i64) == b;
            k = k + 1;
        }
        if hit {
            out = out + text.slice(last as usize, i as usize) + "\\";
            last = i;
        }
        i = i + 1;
    }
    return out + text.slice(last as usize, text.len());
}

// ------------------------------------------------------------------------------
// Searching many times with one VM
// ------------------------------------------------------------------------------

/// Capture offsets of every non-overlapping match, at most `limit` (-1: all).
/// After an empty match the next one must not be empty at the same place.
fn all_slots(ref prog: ReProgram, text: str, limit: i64) -> List<List<i64>> {
    var out: List<List<i64>> = [];
    var vm = new_vm(prog);
    let n = text.len() as i64;
    var pos = 0;
    var no_empty_at = -1;
    while pos <= n && (limit < 0 || (out.len() as i64) < limit) {
        if !pike_search(prog, vm, text, pos, no_empty_at, false, false) { break; }
        let slots = vm.found_slots();
        no_empty_at = if slots[0] == slots[1] { slots[1] } else { -1 };
        pos = slots[1];
        out.push(slots);
    }
    return out;
}

// ------------------------------------------------------------------------------
// Replacement templates
// ------------------------------------------------------------------------------

/// A piece of a replacement: literal text, or a group number (`group` >= 0).
struct TemplatePart : IValue {
    pub text: str;
    pub group: i64;
}

fn parse_template(ref prog: ReProgram, template: str) -> res<List<TemplatePart>, RegexError> {
    var parts: List<TemplatePart> = [];
    var lit = "";
    let n = template.len() as i64;
    var i = 0;
    while i < n {
        let b = template.byte_at(i as usize) as i64;
        if b != 92 || i + 1 >= n {
            lit = lit + template.slice(i as usize, (i + 1) as usize);
            i = i + 1;
            continue;
        }
        let e = template.byte_at((i + 1) as usize) as i64;
        var group = -1;
        if e >= 48 && e <= 57 {
            group = e - 48;
            var j = i + 2;
            if j < n && (template.byte_at(j as usize) as i64) >= 48 && (template.byte_at(j as usize) as i64) <= 57 {
                group = group * 10 + ((template.byte_at(j as usize) as i64) - 48);
                j = j + 1;
            }
            if group > prog.groups {
                return err(RegexError { kind: RegexErrorKind::BadGroupRef, pos: i + 1, message: "invalid group reference" });
            }
            i = j;
        } else if e == 103 && i + 2 < n && (template.byte_at((i + 2) as usize) as i64) == 60 {
            let name_start = i + 3;
            var j = name_start;
            while j < n && (template.byte_at(j as usize) as i64) != 62 { j = j + 1; }
            if j >= n {
                return err(RegexError { kind: RegexErrorKind::BadGroupRef, pos: name_start, message: "missing >, unterminated name" });
            }
            let name = template.slice(name_start as usize, j as usize);
            group = name_index(prog.names, name);
            if group < 0 {
                var v = 0;
                var k = 0;
                while k < name.len() as i64 {
                    let d = name.byte_at(k as usize) as i64;
                    if d < 48 || d > 57 { v = -1; break; }
                    v = v * 10 + (d - 48);
                    k = k + 1;
                }
                if name.len() == 0 || v < 0 || v > prog.groups {
                    return err(RegexError { kind: RegexErrorKind::BadGroupRef, pos: name_start, message: "invalid group reference" });
                }
                group = v;
            }
            i = j + 1;
        } else {
            if e == 110 { lit = lit + "\n"; }
            else if e == 116 { lit = lit + "\t"; }
            else if e == 114 { lit = lit + "\r"; }
            else if e == 92 { lit = lit + "\\"; }
            else { lit = lit + template.slice(i as usize, (i + 2) as usize); }
            i = i + 2;
            continue;
        }
        if lit.len() > 0 {
            parts.push(TemplatePart { text: lit, group: -1 });
            lit = "";
        }
        parts.push(TemplatePart { text: "", group: group });
    }
    if lit.len() > 0 {
        parts.push(TemplatePart { text: lit, group: -1 });
    }
    return ok(parts);
}
