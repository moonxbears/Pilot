// ==============================================================================
// FILE: stdlib/std/text/unicode.pilot
// Ring 2: Unicode character data for text processing (pub pkg std.text.unicode;)
// ==============================================================================
// GENERATED DATA. Derived from Python 3.12's `re` module (Unicode 15.0) by
// testing every code point: `\w`, `\d` and `\s` are the code points those
// classes match in a `str` pattern without re.ASCII; the case groups are the
// sets of code points that match each other under re.IGNORECASE (candidates
// from str.lower/upper/title/casefold/swapcase and re._casefix, every pair
// confirmed with re.fullmatch). Regenerate the same way; do not edit by hand.
//
// Each table is a raw triple-quoted string in which every number takes three
// characters from `?` (63) to `~` (126), each giving six bits, high bits
// first; line breaks are skipped. `decode_list` turns one back into numbers:
// one constant in the program instead of thousands of list pushes, and three
// byte reads per number.
pub pkg std.text.unicode;

// Each table is decoded the first time it is asked for and kept for the rest
// of the program: callers read the list and must not change it. A module's
// globals are set before any module that imports it runs, its `comptime`
// code included, so a pattern compiled at compile time can use them too.
var decoded: i64 = 0;
var word_table: List<i64> = [];
var digit_table: List<i64> = [];
var space_table: List<i64> = [];
var case_table: List<i64> = [];
var small_case_table: List<i64> = [];
var ascii_case_table: List<i64> = [];

/// Code points `\w` matches, as sorted inclusive pairs `lo, hi, lo, hi, ..`.
pub fn word_ranges() -> List<i64> {
    if (decoded & 1) == 0 {
        word_table = decode_list(word_ranges_data());
        decoded = decoded | 1;
    }
    return word_table;
}

/// Code points `\d` matches (decimal digits), as sorted inclusive pairs.
pub fn digit_ranges() -> List<i64> {
    if (decoded & 2) == 0 {
        digit_table = decode_list(digit_ranges_data());
        decoded = decoded | 2;
    }
    return digit_table;
}

/// Code points `\s` matches (white space), as sorted inclusive pairs.
pub fn space_ranges() -> List<i64> {
    if (decoded & 4) == 0 {
        space_table = decode_list(space_ranges_data());
        decoded = decoded | 4;
    }
    return space_table;
}

/// Case groups: each is a count `n` followed by `n` code points (ascending)
/// that match one another ignoring case; groups are sorted by first member.
pub fn case_groups() -> List<i64> {
    if (decoded & 8) == 0 {
        case_table = decode_list(case_groups_data());
        decoded = decoded | 8;
    }
    return case_table;
}

/// The case groups that hold a code point below U+0600 (Latin, Greek,
/// Cyrillic, Armenian, Hebrew), in the form of `case_groups`: all a class of
/// such code points needs to be closed over case.
pub fn small_case_groups() -> List<i64> {
    if (decoded & 16) == 0 {
        small_case_table = decode_list(small_case_groups_data());
        decoded = decoded | 16;
    }
    return small_case_table;
}

/// The case groups that hold an ASCII code point (the letters, with members
/// such as the Kelvin sign and long s), in the form of `case_groups`.
pub fn ascii_case_groups() -> List<i64> {
    if (decoded & 32) == 0 {
        ascii_case_table = decode_list(ascii_case_groups_data());
        decoded = decoded | 32;
    }
    return ascii_case_table;
}

/// The numbers `data` holds (see the file header).
pub fn decode_list(data: str) -> List<i64> {
    var out: List<i64> = [];
    let n = data.len() as i64;
    var i = 0;
    while i < n {
        let a = data.byte_at(i as usize) as i64;
        if a < 63 {
            i = i + 1;
            continue;
        }
        let b = data.byte_at((i + 1) as usize) as i64;
        let c = data.byte_at((i + 2) as usize) as i64;
        out.push(((a - 63) << 12) | ((b - 63) << 6) | (c - 63));
        i = i + 3;
    }
    return out;
}

