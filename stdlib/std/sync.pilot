pub pkg std.sync;

pub pure fn nameof(sym: str) -> str => sym;

pub struct Mutex<T: IAnyValue> : IObject {
    pub is_locked: bool;

    ~self() {}
}

pub fn mutex_new<T>() -> Mutex<T> {
    return Mutex<T> { is_locked: false };
}

// Scoped Guard (0b11 : IGuard)
pub struct MutexGuard<T: IAnyValue> : IGuard {
    pub lock_id: usize;

    ~self() {}
}

/// Locks `m` and returns the guard that unlocks it at scope exit.
pub fn mutex_guard_new<T>(var ref m: Mutex<T>) -> MutexGuard<T> {
    return seam("sync.mutex_lock", "locking needs an OS mutex or atomic intrinsic");
}

[Layout(c_abi)]
pub struct AtomicInt : IValue {
    pub val: i64;
}

pub pure fn atomic_new(v: i64) -> AtomicInt {
    return AtomicInt { val: v };
}
