// ==============================================================================
// FILE: stdlib/std/db/entity_weaver.pilot
// Milestone 30: Self-Generating Typed Persistence & Schema Diffs ([Entity])
// Synthesizes strongly-typed SQL column lenses, parameterized CRUD & batch
// queries, optimistic locking, and schema-diff DDL migrations.
// Enforces:
//   GEN003: [Entity] Missing [Id] Primary Key Field
//   GEN004: SQL Query Column Type Mismatch in Typed Predicate
//   GEN006: Destructive Schema Column Drop Detected in diff_ddl Without [AllowDropColumn]
// ==============================================================================

pub pkg std.db.entity;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// 1. Diagnostic Formatting Helpers
// ------------------------------------------------------------------------------

pub pure fn format_gen003(entity_name: str) -> str {
    return "GEN003: Entity '" + entity_name + "' missing [Id] primary key field";
}

pub pure fn format_gen004(entity_name: str, col_name: str, col_type: str, val_type: str) -> str {
    return "GEN004: SQL column type mismatch in entity '" + entity_name + "': column '" + col_name + "' of type '" + col_type + "' compared with '" + val_type + "'";
}

pub pure fn format_gen006(entity_name: str, col_name: str) -> str {
    return "GEN006: Destructive schema column drop detected in diff_ddl for entity '" + entity_name + "' on column '" + col_name + "' without [AllowDropColumn]";
}

// ------------------------------------------------------------------------------
// 2. Entity Schema & Column Definitions (0b00 & 0b10)
// ------------------------------------------------------------------------------

[Layout(c_abi)]
pub struct EntityColumnDef : IValue {
    pub name:           str;
    pub col_type:       str; // e.g. "BIGINT", "INTEGER", "VARCHAR", "TEXT", "BOOLEAN"
    pub is_id:          bool;
    pub is_unique:      bool;
    pub is_index:       bool;
    pub is_foreign_key: bool;
    pub is_version:     bool;
    pub allow_drop:     bool;
}

pub pure fn entity_column_def_new(
    name: str,
    col_type: str,
    is_id: bool,
    is_unique: bool,
    is_index: bool,
    is_fk: bool,
    is_ver: bool,
    allow_drop: bool
) -> EntityColumnDef {
    return EntityColumnDef {
        name:           name,
        col_type:       col_type,
        is_id:          is_id,
        is_unique:      is_unique,
        is_index:       is_index,
        is_foreign_key: is_fk,
        is_version:     is_ver,
        allow_drop:     allow_drop,
    };
}

pub struct EntitySchemaDef : IObject {
    pub table_name:  str;
    pub columns:     List<EntityColumnDef>;
}

pub fn entity_schema_def_new(table_name: str) -> EntitySchemaDef {
    return EntitySchemaDef {
        table_name: table_name,
        columns:    [],
    };
}

pub fn entity_add_column(var ref self: EntitySchemaDef, col: EntityColumnDef) {
    self.columns.push(col);
}

// ------------------------------------------------------------------------------
// 3. Validation Rules (GEN003 & GEN004)
// ------------------------------------------------------------------------------

pub fn entity_validate_primary_key(schema: ref<EntitySchemaDef>) -> str {
    var i = 0;
    while i < schema.columns.len() {
        if schema.columns[i].is_id {
            return "";
        }
        i = i + 1;
    }
    return format_gen003(schema.table_name);
}

pub fn entity_validate_predicate(
    schema: ref<EntitySchemaDef>,
    col_name: str,
    val_type: str
) -> str {
    var i = 0;
    while i < schema.columns.len() {
        let col = schema.columns[i];
        if col.name == col_name {
            // Check numeric vs string type compatibility
            let is_col_numeric = col.col_type == "BIGINT" || col.col_type == "INTEGER" || col.col_type == "u64" || col.col_type == "i64" || col.col_type == "u32" || col.col_type == "i32";
            let is_val_numeric = val_type == "BIGINT" || val_type == "INTEGER" || val_type == "u64" || val_type == "i64" || val_type == "u32" || val_type == "i32";
            
            if is_col_numeric && !is_val_numeric {
                return format_gen004(schema.table_name, col_name, col.col_type, val_type);
            }
            if !is_col_numeric && is_val_numeric {
                return format_gen004(schema.table_name, col_name, col.col_type, val_type);
            }
            return "";
        }
        i = i + 1;
    }
    return "";
}

// ------------------------------------------------------------------------------
// 4. SQL Generators (CREATE TABLE, SELECT, INSERT, Optimistic UPDATE)
// ------------------------------------------------------------------------------

pub fn generate_create_table_sql(schema: ref<EntitySchemaDef>) -> str {
    var sql = "CREATE TABLE " + schema.table_name + " (";
    var i = 0;
    while i < schema.columns.len() {
        let col = schema.columns[i];
        sql = sql + col.name + " " + col.col_type;
        if col.is_id {
            sql = sql + " PRIMARY KEY";
        } else if col.is_unique {
            sql = sql + " UNIQUE";
        }
        if i + 1 < schema.columns.len() {
            sql = sql + ", ";
        }
        i = i + 1;
    }
    sql = sql + ");";
    return sql;
}

pub fn generate_select_by_id_sql(schema: ref<EntitySchemaDef>) -> str {
    var sql = "SELECT ";
    var id_col = "id";
    var i = 0;
    while i < schema.columns.len() {
        let col = schema.columns[i];
        if col.is_id {
            id_col = col.name;
        }
        sql = sql + col.name;
        if i + 1 < schema.columns.len() {
            sql = sql + ", ";
        }
        i = i + 1;
    }
    sql = sql + " FROM " + schema.table_name + " WHERE " + id_col + " = $1;";
    return sql;
}

pub fn generate_insert_sql(schema: ref<EntitySchemaDef>) -> str {
    var sql = "INSERT INTO " + schema.table_name + " (";
    var values_clause = " VALUES (";
    var i = 0;
    while i < schema.columns.len() {
        let col = schema.columns[i];
        sql = sql + col.name;
        values_clause = values_clause + "$" + ((i + 1) as str);
        if i + 1 < schema.columns.len() {
            sql = sql + ", ";
            values_clause = values_clause + ", ";
        }
        i = i + 1;
    }
    sql = sql + ")" + values_clause + ");";
    return sql;
}

/// `UPDATE` by primary key. `$1` is the id, then one parameter per other
/// non-version column in order. With a `[Version]` column the update also
/// bumps it and only matches the row version the caller read (last
/// parameter): zero rows affected means a stale version.
pub fn generate_update_with_optimistic_lock_sql(schema: ref<EntitySchemaDef>) -> str {
    var sql = "UPDATE " + schema.table_name + " SET ";
    var id_col = "id";
    var ver_col = "";
    var param_idx: usize = 1;
    var first_set = true;

    var i = 0;
    while i < schema.columns.len() {
        let col = schema.columns[i];
        if col.is_id {
            id_col = col.name;
        } else if col.is_version {
            ver_col = col.name;
        } else {
            if !first_set {
                sql = sql + ", ";
            }
            param_idx = param_idx + 1;
            sql = sql + col.name + " = $" + (param_idx as str);
            first_set = false;
        }
        i = i + 1;
    }

    if ver_col.len() == 0 {
        return sql + " WHERE " + id_col + " = $1;";
    }
    if !first_set {
        sql = sql + ", ";
    }
    param_idx = param_idx + 1;
    sql = sql + ver_col + " = " + ver_col + " + 1 WHERE " + id_col + " = $1 AND " + ver_col + " = $" + (param_idx as str) + ";";
    return sql;
}

// ------------------------------------------------------------------------------
// 5. Schema Diff & Migration DDL (GEN006)
// ------------------------------------------------------------------------------

pub struct DdlDiffResult : IObject {
    pub is_ok:          bool;
    pub error_message:  str;
    pub migration_sql:  str;
}

pub fn entity_diff_ddl(
    cur: ref<EntitySchemaDef>,
    prev: ref<EntitySchemaDef>
) -> DdlDiffResult {
    var res = DdlDiffResult {
        is_ok:         true,
        error_message: "",
        migration_sql: "",
    };

    // 1. Check for dropped columns
    var p = 0;
    while p < prev.columns.len() {
        let prev_col = prev.columns[p];
        var found = false;
        var c = 0;
        while c < cur.columns.len() {
            if cur.columns[c].name == prev_col.name {
                found = true;
                break;
            }
            c = c + 1;
        }

        if !found {
            // Column was removed from schema
            if !prev_col.allow_drop {
                res.is_ok = false;
                res.error_message = format_gen006(cur.table_name, prev_col.name);
                return res;
            }
            res.migration_sql = res.migration_sql + "ALTER TABLE " + cur.table_name + " DROP COLUMN " + prev_col.name + ";\n";
        }
        p = p + 1;
    }

    // 2. Check for added columns
    var c2 = 0;
    while c2 < cur.columns.len() {
        let cur_col = cur.columns[c2];
        var found2 = false;
        var p2 = 0;
        while p2 < prev.columns.len() {
            if prev.columns[p2].name == cur_col.name {
                found2 = true;
                break;
            }
            p2 = p2 + 1;
        }

        if !found2 {
            res.migration_sql = res.migration_sql + "ALTER TABLE " + cur.table_name + " ADD COLUMN " + cur_col.name + " " + cur_col.col_type + ";\n";
        }
        c2 = c2 + 1;
    }

    return res;
}

// ------------------------------------------------------------------------------
// 6. [Entity] Attribute Weaving
// ------------------------------------------------------------------------------

/// The schema `[Entity]` and `[Id]`/`[Unique]`/`[Index]`/`[ForeignKey]`/
/// `[Version]` derive from the struct `type_name` and its fields.
pub fn entity_weave_struct(type_name: str) -> EntitySchemaDef {
    return seam("db.weave_entity", "[Entity] needs struct field reflection from the type checker (F4) and a working attribute weaver (M21)");
}

