// ==============================================================================
// FILE: stdlib/std/json.pilot
// Ring 2: Standard JSON Serialization & Parser (pub pkg std.json;)
// ==============================================================================
pub pkg std.json;

/// The kind of a JSON value (RFC 8259 section 3).
pub enum JsonKind : u8 {
    Null,
    Bool,
    Number,
    String,
    Array,
    Object,
}

[Layout(c_abi)]
pub struct JsonVal : IValue {
    pub kind: JsonKind;
    pub text: str;
}

pub pure fn json_null() -> JsonVal => JsonVal { kind: ::Null, text: "null" };
pub pure fn json_bool(b: bool) -> JsonVal => JsonVal { kind: ::Bool, text: if b { "true" } else { "false" } };
pub pure fn json_str(s: str) -> JsonVal => JsonVal { kind: ::String, text: s };
