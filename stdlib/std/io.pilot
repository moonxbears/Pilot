// ==============================================================================
pub pkg std.io;

use Pilot.Core.Bridge.Os;

pub pure fn nameof(sym: str) -> str => sym;

/// The next line of standard input without its line ending, or `none` once
/// the input has ended.
pub fn read_line() -> str? {
    var cap = 256;
    var len = 0;
    var buf = os_slab_alloc(cap, 1);
    let ch = os_slab_alloc(1, 1);
    var got_any = false;
    while true {
        let r = os_fd_read(0, ch, 1);
        if r <= 0 { break; }
        got_any = true;
        let b = os_load_int(ch, 8, 0);
        if b == 10 { break; }
        if len >= cap {
            let next_cap = cap * 2;
            buf = os_slab_realloc(buf, cap, next_cap, 1);
            cap = next_cap;
        }
        let _ = os_store_int(buf + len, b, 8);
        len = len + 1;
    }
    let _ = os_slab_free(ch, 1, 1);
    if !got_any && len == 0 {
        let _ = os_slab_free(buf, cap, 1);
        return none;
    }
    if len > 0 && os_load_int(buf + len - 1, 8, 0) == 13 {
        len = len - 1;
    }
    let out = if len > 0 { str_from_ptr(buf, len) } else { "" };
    let _ = os_slab_free(buf, cap, 1);
    return out;
}

/// The rest of standard input (empty once it has ended).
pub fn read_all() -> str {
    var cap = 8192;
    var len = 0;
    var buf = os_slab_alloc(cap, 1);
    while true {
        if cap - len < 2048 {
            let next_cap = cap * 2;
            buf = os_slab_realloc(buf, cap, next_cap, 1);
            cap = next_cap;
        }
        let r = os_fd_read(0, buf + len, cap - len);
        if r <= 0 { break; }
        len = len + r;
    }
    let out = if len > 0 { str_from_ptr(buf, len) } else { "" };
    let _ = os_slab_free(buf, cap, 1);
    return out;
}

pub interface IReader {
    fn read(var ref self, buf: var slice<u8>) -> usize;
}

pub interface IWriter {
    fn write(var ref self, buf: slice<u8>) -> usize;
    fn flush(var ref self);
}

pub struct BufReader : IObject {
    pub buffer:   str;
    pub position: usize;

    pub pure fn is_eof(ref self) -> bool => self.position >= self.buffer.len();

    pub fn read_byte(var ref self) -> i64 {
        if self.is_eof() { return -1; }
        let b = self.buffer.byte_at(self.position);
        self.position = self.position + 1;
        return b as i64;
    }

    ~self() {}
}

pub fn buf_reader_new(content: str) -> BufReader {
    return BufReader { buffer: content, position: 0 };
}
