// =========================================================================
// FILE: stdlib/contracts/contracts_syntax.pilot
// OPT-IN DESIGN-BY-CONTRACT (`requires`, `ensures`, `invariant`, `old`),
// CONTEXT DI (`context` / `with`) & ADAPTERS (`adapter`, `each`)
// =========================================================================
pub pkg Pilot.Contracts.Syntax;

use Pilot.Core.Genesis.*;

pub enum ContractCheckMode : u8 {
    ::All      = 0,
    ::Boundary = 1,
    ::Proven   = 2,
    ::Disabled = 3,
}

comptime {
    bind_receptor(nameof(requires),  33, 18);
    bind_receptor(nameof(ensures),   33, 19);
    bind_receptor(nameof(invariant), 33, 20);
    bind_receptor(nameof(old),       33, 24);
}

// `adapter`, `context` and `each` (docs/keyword_roadmap.md K6) and the
// typestate words `state` and `transition` (K3) are not built yet.
// Each rule reads the construct past (`Rest`: up to a `;`, or through the
// block it opens) and stops the build at the seam `keyword.unbuilt`
// (PROP-009 section 13). The word starts the construct only when a name, a
// literal or `{` (for the first three, or `[`) follows it; elsewhere it
// is an ordinary name (tests/conformance/types/unbuilt_words_as_names, _2).
pub syntax {
    adapter $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `adapter` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    adapter [ $r:Rest ] => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `adapter` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    context $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `context` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    context [ $r:Rest ] => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `context` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    each $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `each` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    each [ $r:Rest ] => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `each` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    state $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `state` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
    transition $r:Rest => quote { form(CoreForm::Reject, "SEAM001: unconnected seam `keyword.unbuilt`: `transition` is registered but not built yet (docs/keyword_roadmap.md lists the phase that builds it)", $r) };
}
