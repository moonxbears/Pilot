// ============================================================================
// FILE: stdlib/http/http.pilot
// Milestone 58.3: Pure-Pilot HTTP/1.1 Wire Client over Raw TCP Sockets
// Implements URL parsing, HTTP/1.1 request framing, response header parsing,
// case-insensitive header lookup, and chunked transfer-encoding decoding
// directly over `tcp_connect`, `tcp_send`, `tcp_recv`, and `tcp_close`.
// ============================================================================

pub struct HttpResponse {
    pub status: i64;
    pub body: str;
    pub headers_raw: str;
}

pub pure fn http_lower_byte(b: i64) -> i64 {
    if b >= 65 && b <= 90 {
        return b + 32;
    }
    return b;
}

pub pure fn http_ascii_eq_ignore_case(a: str, b: str) -> bool {
    let na = __engine("str_len", a);
    let nb = __engine("str_len", b);
    if na != nb {
        return false;
    }
    var i = 0;
    while i < na {
        let ba = http_lower_byte(__engine("str_byte_at", a, i));
        let bb = http_lower_byte(__engine("str_byte_at", b, i));
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub pure fn http_trim_spaces(s: str) -> str {
    let n = __engine("str_len", s);
    var start = 0;
    while start < n {
        let b = __engine("str_byte_at", s, start);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            start = start + 1;
        } else {
            break;
        }
    }
    var end = n;
    while end > start {
        let b = __engine("str_byte_at", s, end - 1);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            end = end - 1;
        } else {
            break;
        }
    }
    return __engine("str_slice", s, start, end);
}

pub pure fn http_parse_dec_int(s: str) -> i64 {
    let n = __engine("str_len", s);
    var val = 0;
    var i = 0;
    while i < n {
        let b = __engine("str_byte_at", s, i);
        if b >= 48 && b <= 57 {
            val = (val * 10) + (b - 48);
        }
        i = i + 1;
    }
    return val;
}

pub pure fn http_parse_hex_int(s: str) -> i64 {
    let clean = http_trim_spaces(s);
    let n = __engine("str_len", clean);
    var val = 0;
    var i = 0;
    while i < n {
        let b = __engine("str_byte_at", clean, i);
        if b >= 48 && b <= 57 {
            val = (val * 16) + (b - 48);
        } else if b >= 97 && b <= 102 {
            val = (val * 16) + (b - 87);
        } else if b >= 65 && b <= 70 {
            val = (val * 16) + (b - 55);
        } else {
            break;
        }
        i = i + 1;
    }
    return val;
}

pub fn http_parse_url(url: str) -> i64 {
    let m = __engine("map_new");
    let n = __engine("str_len", url);
    var start = 0;
    if n >= 7 && __engine("str_slice", url, 0, 7) == "http://" {
        start = 7;
    } else if n >= 8 && __engine("str_slice", url, 0, 8) == "https://" {
        start = 8;
    }

    var slash = start;
    while slash < n {
        if __engine("str_byte_at", url, slash) == 47 {
            break;
        }
        slash = slash + 1;
    }

    let auth = __engine("str_slice", url, start, slash);
    let path = if slash < n { __engine("str_slice", url, slash, n) } else { "/" };

    let auth_len = __engine("str_len", auth);
    var colon = -1;
    var i = 0;
    while i < auth_len {
        if __engine("str_byte_at", auth, i) == 58 {
            colon = i;
            break;
        }
        i = i + 1;
    }

    let host = if colon >= 0 { __engine("str_slice", auth, 0, colon) } else { auth };
    let port = if colon >= 0 {
        http_parse_dec_int(__engine("str_slice", auth, colon + 1, auth_len))
    } else {
        80
    };

    __engine("map_set", m, "auth", auth);
    __engine("map_set", m, "host", host);
    __engine("map_set", m, "port", port);
    __engine("map_set", m, "path", path);
    return m;
}

pub pure fn http_find_crlf(s: str, from_idx: i64) -> i64 {
    let n = __engine("str_len", s);
    var i = from_idx;
    while i + 1 < n {
        if __engine("str_byte_at", s, i) == 13 && __engine("str_byte_at", s, i + 1) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub pure fn http_find_header_end(raw: str) -> i64 {
    let n = __engine("str_len", raw);
    var i = 0;
    while i + 3 < n {
        if __engine("str_byte_at", raw, i) == 13
            && __engine("str_byte_at", raw, i + 1) == 10
            && __engine("str_byte_at", raw, i + 2) == 13
            && __engine("str_byte_at", raw, i + 3) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub pure fn http_lookup_header_in_raw(headers_raw: str, header_name: str) -> str {
    let n = __engine("str_len", headers_raw);
    var pos = 0;
    while pos < n {
        let eol = http_find_crlf(headers_raw, pos);
        let line_end = if eol >= 0 { eol } else { n };
        let line = __engine("str_slice", headers_raw, pos, line_end);
        let ln = __engine("str_len", line);
        var colon = -1;
        var i = 0;
        while i < ln {
            if __engine("str_byte_at", line, i) == 58 {
                colon = i;
                break;
            }
            i = i + 1;
        }
        if colon > 0 {
            let k = http_trim_spaces(__engine("str_slice", line, 0, colon));
            if http_ascii_eq_ignore_case(k, header_name) {
                return http_trim_spaces(__engine("str_slice", line, colon + 1, ln));
            }
        }
        if eol < 0 {
            break;
        }
        pos = eol + 2;
    }
    return "";
}

pub pure fn http_decode_chunked_body(raw_body: str) -> str {
    let n = __engine("str_len", raw_body);
    var pos = 0;
    var out = "";
    while pos < n {
        let eol = http_find_crlf(raw_body, pos);
        if eol < 0 {
            break;
        }
        let len_line = __engine("str_slice", raw_body, pos, eol);
        let chunk_len = http_parse_hex_int(len_line);
        if chunk_len <= 0 {
            break;
        }
        let data_start = eol + 2;
        let data_end = data_start + chunk_len;
        if data_end <= n {
            out = out + __engine("str_slice", raw_body, data_start, data_end);
        } else {
            out = out + __engine("str_slice", raw_body, data_start, n);
            break;
        }
        pos = data_end + 2;
    }
    return out;
}

pub fn http_parse_raw_response(raw: str) -> HttpResponse {
    let first_eol = http_find_crlf(raw, 0);
    var status_code = 0;
    if first_eol > 0 {
        let status_line = __engine("str_slice", raw, 0, first_eol);
        let slen = __engine("str_len", status_line);
        var sp = 0;
        while sp < slen && __engine("str_byte_at", status_line, sp) != 32 {
            sp = sp + 1;
        }
        while sp < slen && __engine("str_byte_at", status_line, sp) == 32 {
            sp = sp + 1;
        }
        let code_str = __engine("str_slice", status_line, sp, sp + 3);
        status_code = http_parse_dec_int(code_str);
    }

    let hdr_end = http_find_header_end(raw);
    if hdr_end < 0 {
        return HttpResponse {
            status: status_code,
            body: raw,
            headers_raw: "",
        };
    }

    let hdr_start = if first_eol >= 0 { first_eol + 2 } else { 0 };
    let headers_raw = __engine("str_slice", raw, hdr_start, hdr_end);
    let raw_body = __engine("str_slice", raw, hdr_end + 4, __engine("str_len", raw));
    let te = http_lookup_header_in_raw(headers_raw, "Transfer-Encoding");
    let final_body = if http_ascii_eq_ignore_case(te, "chunked") {
        http_decode_chunked_body(raw_body)
    } else {
        raw_body
    };

    return HttpResponse {
        status: status_code,
        body: final_body,
        headers_raw: headers_raw,
    };
}

pub fn http_header_get(resp: HttpResponse, header_name: str) -> str {
    let hraw = resp.headers_raw;
    return http_lookup_header_in_raw(hraw, header_name);
}

pub fn http_get(url: str) -> HttpResponse {
    let u = http_parse_url(url);
    let auth = "" + __engine("map_get", u, "auth");
    let path = "" + __engine("map_get", u, "path");

    let req = "GET " + path + " HTTP/1.1\r\n"
        + "Host: " + auth + "\r\n"
        + "Connection: close\r\n\r\n";

    let fd = __engine("tcp_connect", auth);
    __engine("tcp_send", fd, req);
    let raw = "" + __engine("tcp_recv", fd, 65536);
    __engine("tcp_close", fd);
    return http_parse_raw_response(raw);
}

pub fn http_post(url: str, content_type: str, body: str) -> HttpResponse {
    let u = http_parse_url(url);
    let auth = "" + __engine("map_get", u, "auth");
    let path = "" + __engine("map_get", u, "path");
    let blen = __engine("str_len", body);

    let req = "POST " + path + " HTTP/1.1\r\n"
        + "Host: " + auth + "\r\n"
        + "Content-Type: " + content_type + "\r\n"
        + "Content-Length: " + blen + "\r\n"
        + "Connection: close\r\n\r\n"
        + body;

    let fd = __engine("tcp_connect", auth);
    __engine("tcp_send", fd, req);
    let raw = "" + __engine("tcp_recv", fd, 65536);
    __engine("tcp_close", fd);
    return http_parse_raw_response(raw);
}
