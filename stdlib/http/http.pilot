// ============================================================================
// FILE: stdlib/http/http.pilot
// Milestone 58.3: Pure-Pilot HTTP/1.1 Wire Client over Raw TCP Sockets
// Implements URL parsing, HTTP/1.1 request framing, response header parsing,
// case-insensitive header lookup, and chunked transfer-encoding decoding
// directly over `tcp_connect`, `tcp_send`, `tcp_recv`, and `tcp_close`.
// ============================================================================

use std.text;

[Layout(c_abi)]
pub struct HttpResponse : IValue {
    pub status: i64;
    pub body: str;
    pub headers_raw: str;
}

pub pure fn http_lower_byte(b: i64) -> i64 {
    if b >= 65 && b <= 90 {
        return b + 32;
    }
    return b;
}

pub pure fn http_ascii_eq_ignore_case(a: str, b: str) -> bool {
    let na = a.len();
    let nb = b.len();
    if na != nb {
        return false;
    }
    var i = 0;
    while i < na {
        let ba = http_lower_byte(a.byte_at(i));
        let bb = http_lower_byte(b.byte_at(i));
        if ba != bb {
            return false;
        }
        i = i + 1;
    }
    return true;
}

pub pure fn http_trim_spaces(s: str) -> str {
    let n = s.len();
    var start = 0;
    while start < n {
        let b = s.byte_at(start);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            start = start + 1;
        } else {
            break;
        }
    }
    var end = n;
    while end > start {
        let b = s.byte_at(end - 1);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            end = end - 1;
        } else {
            break;
        }
    }
    return s.slice(start, end);
}

pub pure fn http_parse_dec_int(s: str) -> i64 {
    let n = s.len();
    var val = 0;
    var i = 0;
    while i < n {
        let b = s.byte_at(i);
        if b >= 48 && b <= 57 {
            val = (val * 10) + (b - 48);
        }
        i = i + 1;
    }
    return val;
}

pub pure fn http_parse_hex_int(s: str) -> i64 {
    let clean = http_trim_spaces(s);
    let n = clean.len();
    var val = 0;
    var i = 0;
    while i < n {
        let b = clean.byte_at(i);
        if b >= 48 && b <= 57 {
            val = (val * 16) + (b - 48);
        } else if b >= 97 && b <= 102 {
            val = (val * 16) + (b - 87);
        } else if b >= 65 && b <= 70 {
            val = (val * 16) + (b - 55);
        } else {
            break;
        }
        i = i + 1;
    }
    return val;
}

pub fn http_parse_url(url: str) -> i64 {
    let m = __engine("map_new");
    let n = url.len();
    var start = 0;
    if n >= 7 && url.slice(0, 7) == "http://" {
        start = 7;
    } else if n >= 8 && url.slice(0, 8) == "https://" {
        start = 8;
    }

    var slash = start;
    while slash < n {
        if url.byte_at(slash) == 47 {
            break;
        }
        slash = slash + 1;
    }

    let auth = url.slice(start, slash);
    let path = if slash < n { url.slice(slash, n) } else { "/" };

    let auth_len = auth.len();
    var colon = -1;
    var i = 0;
    while i < auth_len {
        if auth.byte_at(i) == 58 {
            colon = i;
            break;
        }
        i = i + 1;
    }

    let host = if colon >= 0 { auth.slice(0, colon) } else { auth };
    let port = if colon >= 0 {
        http_parse_dec_int(auth.slice(colon + 1, auth_len))
    } else {
        80
    };

    __engine("map_set", m, "auth", auth);
    __engine("map_set", m, "host", host);
    __engine("map_set", m, "port", port);
    __engine("map_set", m, "path", path);
    return m;
}

pub pure fn http_find_crlf(s: str, from_idx: i64) -> i64 {
    let n = s.len();
    var i = from_idx;
    while i + 1 < n {
        if s.byte_at(i) == 13 && s.byte_at(i + 1) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub pure fn http_find_header_end(raw: str) -> i64 {
    let n = raw.len();
    var i = 0;
    while i + 3 < n {
        if raw.byte_at(i) == 13
            && raw.byte_at(i + 1) == 10
            && raw.byte_at(i + 2) == 13
            && raw.byte_at(i + 3) == 10 {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub pure fn http_lookup_header_in_raw(headers_raw: str, header_name: str) -> str {
    let n = headers_raw.len();
    var pos = 0;
    while pos < n {
        let eol = http_find_crlf(headers_raw, pos);
        let line_end = if eol >= 0 { eol } else { n };
        let line = headers_raw.slice(pos, line_end);
        let ln = line.len();
        var colon = -1;
        var i = 0;
        while i < ln {
            if line.byte_at(i) == 58 {
                colon = i;
                break;
            }
            i = i + 1;
        }
        if colon > 0 {
            let k = http_trim_spaces(line.slice(0, colon));
            if http_ascii_eq_ignore_case(k, header_name) {
                return http_trim_spaces(line.slice(colon + 1, ln));
            }
        }
        if eol < 0 {
            break;
        }
        pos = eol + 2;
    }
    return "";
}

pub pure fn http_decode_chunked_body(raw_body: str) -> str {
    let n = raw_body.len();
    var pos = 0;
    var out: List<str> = [];
    while pos < n {
        let eol = http_find_crlf(raw_body, pos);
        if eol < 0 {
            break;
        }
        let len_line = raw_body.slice(pos, eol);
        let chunk_len = http_parse_hex_int(len_line);
        if chunk_len <= 0 {
            break;
        }
        let data_start = eol + 2;
        let data_end = data_start + chunk_len;
        if data_end <= n {
            out.push(raw_body.slice(data_start, data_end));
        } else {
            out.push(raw_body.slice(data_start, n));
            break;
        }
        pos = data_end + 2;
    }
    return join_text(out, "");
}

pub fn http_parse_raw_response(raw: str) -> HttpResponse {
    let first_eol = http_find_crlf(raw, 0);
    var status_code = 0;
    if first_eol > 0 {
        let status_line = raw.slice(0, first_eol);
        let slen = status_line.len();
        var sp = 0;
        while sp < slen && status_line.byte_at(sp) != 32 {
            sp = sp + 1;
        }
        while sp < slen && status_line.byte_at(sp) == 32 {
            sp = sp + 1;
        }
        let code_str = status_line.slice(sp, sp + 3);
        status_code = http_parse_dec_int(code_str);
    }

    let hdr_end = http_find_header_end(raw);
    if hdr_end < 0 {
        return HttpResponse {
            status: status_code,
            body: raw,
            headers_raw: "",
        };
    }

    let hdr_start = if first_eol >= 0 { first_eol + 2 } else { 0 };
    let headers_raw = raw.slice(hdr_start, hdr_end);
    let raw_body = raw.slice(hdr_end + 4, raw.len());
    let te = http_lookup_header_in_raw(headers_raw, "Transfer-Encoding");
    let final_body = if http_ascii_eq_ignore_case(te, "chunked") {
        http_decode_chunked_body(raw_body)
    } else {
        raw_body
    };

    return HttpResponse {
        status: status_code,
        body: final_body,
        headers_raw: headers_raw,
    };
}

pub fn http_header_get(resp: HttpResponse, header_name: str) -> str {
    let hraw = resp.headers_raw;
    return http_lookup_header_in_raw(hraw, header_name);
}

pub fn http_get(url: str) -> HttpResponse {
    let u = http_parse_url(url);
    let auth = "" + __engine("map_get", u, "auth");
    let path = "" + __engine("map_get", u, "path");

    let req = "GET " + path + " HTTP/1.1\r\n"
        + "Host: " + auth + "\r\n"
        + "Connection: close\r\n\r\n";

    let fd = __engine("tcp_connect", auth);
    __engine("tcp_send", fd, req);
    let raw = "" + __engine("tcp_recv", fd, 65536);
    __engine("tcp_close", fd);
    return http_parse_raw_response(raw);
}

pub fn http_post(url: str, content_type: str, body: str) -> HttpResponse {
    let u = http_parse_url(url);
    let auth = "" + __engine("map_get", u, "auth");
    let path = "" + __engine("map_get", u, "path");
    let blen = body.len();

    let req = "POST " + path + " HTTP/1.1\r\n"
        + "Host: " + auth + "\r\n"
        + "Content-Type: " + content_type + "\r\n"
        + "Content-Length: " + blen + "\r\n"
        + "Connection: close\r\n\r\n"
        + body;

    let fd = __engine("tcp_connect", auth);
    __engine("tcp_send", fd, req);
    let raw = "" + __engine("tcp_recv", fd, 65536);
    __engine("tcp_close", fd);
    return http_parse_raw_response(raw);
}
