// Modeled after Python's `http` package (CPython Lib/http/client.py, server.py, cookies.py)
// Compatible with Linux, Windows, macOS, Android, iOS, and WebAssembly targets.

pub pkg Pilot.Http;

use Pilot.Core.Genesis.*;
