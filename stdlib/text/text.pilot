// std.text — Zero-Copy UTF-8 StrSlice Views (`SliceBuffer<u8>`), Comptime DFA Regex & String Algorithms

// Zero-copy UTF-8 string view backed directly by unmanaged/mmap `SliceBuffer<u8>`
// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    def __dfa_is_match(pattern: any, text: str) -> bool;
    def __dfa_find(pattern: any, text: str, start: i64) -> any;
    def __dfa_find_all(pattern: any, text: str) -> List[str];
    def __dfa_find_spans(pattern: any, text: str) -> any;
    def __dfa_split(pattern: any, text: str) -> List[str];
    def __dfa_replace_all(pattern: any, text: str, replacement: str) -> str;
    def __slice_get(buf: any, idx: i64) -> any;
    def __slice_ptr(buf: any) -> i64;
    def __slice_subview(buf: any, start: i64, length: i64) -> any;
    def __utf8_encode_slice(text: str) -> any;
    def __utf8_decode_slice(buf: any) -> str;
    def __utf8_is_valid_boundary(buf: any, idx: i64) -> bool;
    def __utf8_rune_count(buf: any) -> i64;
}

class StrSlice {
    def __init__(self, utf8_buf) {
        self._buf = utf8_buf;
    }

    def byte_len(self) -> i64 {
        return len(self._buf);
    }

    def data_ptr(self) -> i64 {
        return __slice_ptr(self._buf);
    }

    def is_empty(self) -> bool {
        return len(self._buf) == 0;
    }

    def rune_count(self) -> i64 {
        return __utf8_rune_count(self._buf);
    }

    def is_char_boundary(self, byte_offset: i64) -> bool {
        return __utf8_is_valid_boundary(self._buf, byte_offset);
    }

    def byte_at(self, idx: i64) {
        return __slice_get(self._buf, idx);
    }

    // Zero-copy UTF-8 sub-slice (`DataPtr + start_byte`) returning `StrSlice?` (`none` if invalid UTF-8 boundary)
    def subslice(self, start_byte: i64, byte_length: i64) {
        let total: i64 = len(self._buf);
        if start_byte < 0 or byte_length < 0 or (start_byte + byte_length) > total {
            return none;
        }
        if !__utf8_is_valid_boundary(self._buf, start_byte) or !__utf8_is_valid_boundary(self._buf, start_byte + byte_length) {
            return none;
        }
        let view = __slice_subview(self._buf, start_byte, byte_length);
        return some(StrSlice(view));
    }

    def to_str(self) -> str {
        return __utf8_decode_slice(self._buf);
    }

    def raw_buffer(self) {
        return self._buf;
    }
}

def str_slice(text: str) {
    return StrSlice(__utf8_encode_slice(text));
}

def as_utf8_slice(text: str) {
    return __utf8_encode_slice(text);
}

def str_slice_from_bytes(utf8_buf) {
    return StrSlice(utf8_buf);
}

// Comptime-compatible Thompson NFA -> Powerset DFA Regex Wrapper
class Regex {
    def __init__(self, pattern_or_dfa) {
        if type_of(pattern_or_dfa) == "string" {
            self.dfa = compile_regex(pattern_or_dfa);
        } else {
            self.dfa = pattern_or_dfa;
        }
    }

    def pattern(self) -> str {
        return self.dfa.pattern;
    }

    def state_count(self) -> i64 {
        return self.dfa.state_count;
    }

    def is_match(self, text: str) -> bool {
        return __dfa_is_match(self.dfa, text);
    }

    def find(self, text: str, start_idx: i64 = 0) {
        return __dfa_find(self.dfa, text, start_idx);
    }

    def find_all(self, text: str) {
        return __dfa_find_all(self.dfa, text);
    }

    def find_spans(self, text: str) {
        return __dfa_find_spans(self.dfa, text);
    }

    def replace_all(self, text: str, replacement: str) -> str {
        return __dfa_replace_all(self.dfa, text, replacement);
    }

    def split(self, text: str) {
        return __dfa_split(self.dfa, text);
    }
}

def regex(pattern: str) {
    return compile_regex(pattern);
}

def regex_is_match(re_or_pat, text: str) -> bool {
    return __dfa_is_match(re_or_pat, text);
}

def regex_find(re_or_pat, text: str, start_idx: i64 = 0) {
    return __dfa_find(re_or_pat, text, start_idx);
}

def regex_find_all(re_or_pat, text: str) {
    return __dfa_find_all(re_or_pat, text);
}

def regex_find_spans(re_or_pat, text: str) {
    return __dfa_find_spans(re_or_pat, text);
}

def regex_replace_all(re_or_pat, text: str, replacement: str) -> str {
    return __dfa_replace_all(re_or_pat, text, replacement);
}

def regex_split(re_or_pat, text: str) {
    return __dfa_split(re_or_pat, text);
}

// Pure String Manipulation Utilities
def trim(s: str) -> str {
    return s.trim();
}

def trim_start(s: str) -> str {
    return s.trim_start();
}

def trim_end(s: str) -> str {
    return s.trim_end();
}

def to_upper(s: str) -> str {
    return s.to_upper();
}

def to_lower(s: str) -> str {
    return s.to_lower();
}

def split(s: str, sep: str = " ") {
    return s.split(sep);
}

def lines(s: str) {
    let normalized = s.replace("\r\n", "\n");
    return normalized.split("\n");
}

def join(parts, sep: str = "") -> str {
    var out: str = "";
    var first: bool = true;
    for p in parts {
        if !first {
            out = out + sep;
        }
        out = out + str(p);
        first = false;
    }
    return out;
}

def replace(s: str, old_sub: str, new_sub: str) -> str {
    return s.replace(old_sub, new_sub);
}

def index_of(s: str, sub: str, start: i64 = 0) -> i64 {
    return s.index_of(sub, start);
}

def last_index_of(s: str, sub: str) -> i64 {
    return s.last_index_of(sub);
}

def contains(s: str, sub: str) -> bool {
    return s.contains(sub);
}

def starts_with(s: str, prefix: str) -> bool {
    return s.starts_with(prefix);
}

def ends_with(s: str, suffix: str) -> bool {
    return s.ends_with(suffix);
}

def pad_left(s: str, width: i64, fill_char: str = " ") -> str {
    let cur: i64 = len(s);
    if cur >= width {
        return s;
    }
    let ch = if len(fill_char) > 0 { fill_char[0..1] } else { " " };
    return (ch * (width - cur)) + s;
}

def pad_right(s: str, width: i64, fill_char: str = " ") -> str {
    let cur: i64 = len(s);
    if cur >= width {
        return s;
    }
    let ch = if len(fill_char) > 0 { fill_char[0..1] } else { " " };
    return s + (ch * (width - cur));
}

// Generates a sequence of strings from `start` to `end` using bijective alphabetical enumeration.
// Supports: "a".."z", "z".."a", "a".."zzza", "a".."Z" (52 combos), "A".."z", "Z".."a", "z".."A".
def str_range(start: str, end: str, inclusive: bool = true) {
    if inclusive {
        return start..end;
    } else {
        return start..<end;
    }
}
