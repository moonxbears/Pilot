// std.unittest — Multi-OS Unit Testing Framework
// Modeled after Python's `unittest` module (CPython Lib/unittest/case.py, suite.py, runner.py, result.py)
// Compatible with Linux, Windows, macOS, Android, iOS, and WebAssembly targets.

pub pkg Pilot.Unittest;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// ============================================================================
// 1. Exceptions & Signals (Python: unittest.case.SkipTest, AssertionError)
// ============================================================================

// Native runtime optimizations provided by pilot_rt (C-ABI FFI)
extern "c" lib "pilot_rt" {
    fn __time_perf_counter() -> f64;
}

pub struct AssertionError : IValue {
    pub:
        message: str;
        args:    str[];

        self(message: str = "") {
            .message = message;
            .args = [message];
        }

        fn to_str() -> str {
            return f"AssertionError: {self.message}";
        }
}

pub struct SkipTest : IValue {
    pub:
        reason: str;
        args:   str[];

        self(reason: str = "") {
            .reason = reason;
            .args = [reason];
        }

        fn to_str() -> str {
            return f"SkipTest: {self.reason}";
        }
}

// ============================================================================
// 2. Test Result Collector (Python: unittest.result.TestResult)
// ============================================================================

pub struct TestResult : IValue {
    pub:
        testsRun:   i64;
        failures:   any[];
        errors:     any[];
        skipped:    any[];
        shouldStop: bool;

        self() {
            .testsRun = 0;
            .failures = [];
            .errors = [];
            .skipped = [];
            .shouldStop = false;
        }

        var fn startTest(test: any) {
            self.testsRun = self.testsRun + 1;
        }

        fn stopTest(test: any) {
            // Post-test hook
        }

        fn addSuccess(test: any) {
            // Success hook
        }

        var fn addFailure(test: any, err: str) {
            self.failures.append([test, err]);
        }

        var fn addError(test: any, err: str) {
            self.errors.append([test, err]);
        }

        var fn addSkip(test: any, reason: str) {
            self.skipped.append([test, reason]);
        }

        fn wasSuccessful() -> bool {
            return len(self.failures) == 0 && len(self.errors) == 0;
        }

        var fn stop() {
            self.shouldStop = true;
        }

        fn to_str() -> str {
            return f"<TestResult run={self.testsRun} errors={len(self.errors)} failures={len(self.failures)} skipped={len(self.skipped)}>";
        }
}

// ============================================================================
// 3. Test Case Base Class (Python: unittest.case.TestCase)
// ============================================================================

pub struct TestCase : IValue {
    pub:
        _testMethodName: str;

        self(methodName: str = "runTest") {
            ._testMethodName = methodName;
        }

        fn setUp() {
            // Hook called immediately before calling the test method
        }

        fn tearDown() {
            // Hook called immediately after calling the test method
        }

        fn setUpClass() {
            // Hook called before running tests in a class
        }

        fn tearDownClass() {
            // Hook called after running tests in a class
        }

        fn shortDescription() -> str {
            return self._testMethodName;
        }

        fn id() -> str {
            return self._testMethodName;
        }

        // --- Assertions ---

        fn fail_test(msg: str = "") {
            let err_msg = if len(msg) > 0 { msg } else { "Test failed." };
            panic(f"AssertionError: {err_msg}");
        }

        fn assertTrue(expr: bool, msg: str = "") {
            if !expr {
                let err_msg = if len(msg) > 0 { msg } else { "Expected True, but found False" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertFalse(expr: bool, msg: str = "") {
            if expr {
                let err_msg = if len(msg) > 0 { msg } else { "Expected False, but found True" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertEqual(first: any, second: any, msg: str = "") {
            if first != second {
                let err_msg = if len(msg) > 0 { msg } else { f"{first} != {second}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertNotEqual(first: any, second: any, msg: str = "") {
            if first == second {
                let err_msg = if len(msg) > 0 { msg } else { f"{first} == {second}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertIs(first: any, second: any, msg: str = "") {
            if first != second {
                let err_msg = if len(msg) > 0 { msg } else { f"{first} is not {second}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertIsNot(first: any, second: any, msg: str = "") {
            if first == second {
                let err_msg = if len(msg) > 0 { msg } else { f"unexpectedly identical: {first}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertIsNone(expr: any, msg: str = "") {
            if expr != none {
                let err_msg = if len(msg) > 0 { msg } else { f"Expected None, got {expr}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertIsNotNone(expr: any, msg: str = "") {
            if expr == none {
                let err_msg = if len(msg) > 0 { msg } else { "Expected not None, but got None" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertIn(member: any, container: any, msg: str = "") {
            var found = false;
            let c_type = type_of(container);
            if c_type == "string" {
                found = str(container).contains(str(member));
            } else if c_type == "list" {
                for item in container {
                    if item == member {
                        found = true;
                        break;
                    }
                }
            } else if c_type == "map" {
                found = container.contains_key(member);
            }
            if !found {
                let err_msg = if len(msg) > 0 { msg } else { f"{member} not found in {container}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertNotIn(member: any, container: any, msg: str = "") {
            var found = false;
            let c_type = type_of(container);
            if c_type == "string" {
                found = str(container).contains(str(member));
            } else if c_type == "list" {
                for item in container {
                    if item == member {
                        found = true;
                        break;
                    }
                }
            } else if c_type == "map" {
                found = container.contains_key(member);
            }
            if found {
                let err_msg = if len(msg) > 0 { msg } else { f"{member} unexpectedly found in {container}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertAlmostEqual(first: f64, second: f64, places: i64 = 7, msg: str = "") {
            let diff = if first >= second { first - second } else { second - first };
            var tol = 1.0;
            for _ in 0..<places {
                tol = tol / 10.0;
            }
            if diff >= tol {
                let err_msg = if len(msg) > 0 { msg } else { f"{first} != {second} within {places} places" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertNotAlmostEqual(first: f64, second: f64, places: i64 = 7, msg: str = "") {
            let diff = if first >= second { first - second } else { second - first };
            var tol = 1.0;
            for _ in 0..<places {
                tol = tol / 10.0;
            }
            if diff < tol {
                let err_msg = if len(msg) > 0 { msg } else { f"{first} == {second} within {places} places" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertGreater(a: any, b: any, msg: str = "") {
            if !(a > b) {
                let err_msg = if len(msg) > 0 { msg } else { f"{a} not greater than {b}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertGreaterEqual(a: any, b: any, msg: str = "") {
            if !(a >= b) {
                let err_msg = if len(msg) > 0 { msg } else { f"{a} not greater than or equal to {b}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertLess(a: any, b: any, msg: str = "") {
            if !(a < b) {
                let err_msg = if len(msg) > 0 { msg } else { f"{a} not less than {b}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn assertLessEqual(a: any, b: any, msg: str = "") {
            if !(a <= b) {
                let err_msg = if len(msg) > 0 { msg } else { f"{a} not less than or equal to {b}" };
                panic(f"AssertionError: {err_msg}");
            }
        }

        fn run(result: any = none) -> TestResult {
            var res: TestResult = if result != none { result } else { TestResult() };
            res.startTest(self);
            self.setUp();
            // Subclasses execute their test code here
            self.tearDown();
            res.addSuccess(self);
            res.stopTest(self);
            return res;
        }
}

// ============================================================================
// 4. Test Suite (Python: unittest.suite.TestSuite)
// ============================================================================

pub struct TestSuite : IValue {
    pub:
        _tests: any[];

        self(tests: any[] = []) {
            var copied = [];
            for t in tests {
                copied.append(t);
            }
            ._tests = copied;
        }

        var fn addTest(test: any) {
            self._tests.append(test);
        }

        var fn addTests(tests: any[]) {
            for t in tests {
                self._tests.append(t);
            }
        }

        fn countTestCases() -> i64 {
            return len(self._tests);
        }

        fn run(result: any = none) -> TestResult {
            var res: TestResult = if result != none { result } else { TestResult() };
            for test in self._tests {
                if res.shouldStop {
                    break;
                }
                test.run(res);
            }
            return res;
        }
}

// ============================================================================
// 5. Test Runner (Python: unittest.runner.TextTestRunner)
// ============================================================================

pub struct TextTestRunner : IValue {
    pub:
        verbosity: i64;

        self(verbosity: i64 = 1) {
            .verbosity = verbosity;
        }

        fn run(test: any) -> TestResult {
            let result = TestResult();
            let start_time = __time_perf_counter();

            test.run(result);

            let elapsed = __time_perf_counter() - start_time;

            if self.verbosity > 0 {
                print("----------------------------------------------------------------------");
                print(f"Ran {result.testsRun} tests in {elapsed}s");
                print("");
                if result.wasSuccessful() {
                    print("OK");
                } else {
                    print(f"FAILED (failures={len(result.failures)}, errors={len(result.errors)})");
                }
            }

            return result;
        }
}

/// Convenience function to execute a TestSuite or TestCase directly.
pub fn main(suite: any = none, verbosity: i64 = 1) -> TestResult {
    let runner = TextTestRunner(verbosity);
    let target = if suite != none { suite } else { TestSuite() };
    return runner.run(target);
}
