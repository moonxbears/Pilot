// =========================================================================
// FILE: stdlib/realtime/rt_syntax.pilot
// OPT-IN DETERMINISTIC REAL-TIME (`noalloc`, `region`, `deadline`, `periodic`)
// =========================================================================
pub pkg Pilot.Realtime.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    // `noalloc fn f()`: the function takes no heap memory (NOALLOC001,
    // selfhost/check/noalloc.pilot). It is no `async` effect.
    __engine("register_modifier", nameof(noalloc), "effect_noalloc");
    // Not built yet (docs/keyword_roadmap.md K8): where a declaration or
    // statement starts each stops at the seam `keyword.unbuilt`.
    __engine("bind_receptor", nameof(priority), 40, 1);
    __engine("bind_receptor", nameof(jitter),   40, 1);
}

// The block forms below are not built yet (docs/keyword_roadmap.md phases K5
// and K8). Each rule stops at its seam before its body runs, instead of
// running the body with the budget, pool or period ignored (audit 2.3:
// `on_missed` always ran, `periodic` was a plain `loop`).
pub syntax {
    noalloc(body) => quote {
        seam("realtime.noalloc_block", "checking a block for heap use needs the allocation verifier for blocks (M37); `noalloc fn` is checked today (NOALLOC001)")
    };
    region(pool, body) => quote {
        seam("realtime.region", "allocating a block's values in an arena needs the arena allocator (M37)")
    };
    deadline(b, body) => quote {
        seam("realtime.deadline", "enforcing a deadline needs a monotonic clock and a way to stop or flag the late block (M77)")
    };
    within(b, body) => quote {
        seam("realtime.within", "bounding a block's run time needs a monotonic clock and a way to stop or flag the late block (M77)")
    };
    periodic(p, body) => quote {
        seam("realtime.periodic", "running a block at a fixed period needs a scheduler with timers")
    };
    on_missed(body) => quote {
        seam("realtime.on_missed", "running a handler only when a deadline was missed needs `deadline` to detect a miss")
    };
    fallback(body) => quote {
        seam("realtime.fallback", "running a fallback only when a deadline was missed needs `deadline` to detect a miss")
    };
}

pub pure fn is_realtime_construct(word: str) -> bool {
    return word == nameof(noalloc)
        || word == nameof(region)
        || word == nameof(deadline)
        || word == nameof(within)
        || word == nameof(periodic)
        || word == nameof(on_missed)
        || word == nameof(fallback);
}
