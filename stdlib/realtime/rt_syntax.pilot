// =========================================================================
// FILE: stdlib/realtime/rt_syntax.pilot
// OPT-IN DETERMINISTIC REAL-TIME (`noalloc`, `region`, `deadline`, `periodic`)
// =========================================================================
pub pkg Pilot.Realtime.Syntax;

use Pilot.Core.Genesis.*;

comptime {
    // `noalloc fn f()`: the function takes no heap memory (NOALLOC001,
    // selfhost/check/noalloc.pilot). It is no `async` effect.
    __engine("register_modifier", nameof(noalloc), "effect_noalloc");
}

pub struct RealtimeScopeGuard : IGuard {
    pub is_noalloc: bool;
    pub self(noalloc_mode: bool) {
        .is_noalloc = noalloc_mode;
    }
    ~self() {}
}

pub syntax {
    noalloc(body)        => quote { { let __rt_guard = RealtimeScopeGuard(true); $body } };
    region(pool, body)   => quote { { let __rt_region = $pool; $body } };
    deadline(b, body)    => quote { { let __rt_budget = $b; $body } };
    within(b, body)      => quote { { let __rt_within = $b; $body } };
    periodic(p, body)    => quote { loop { let __rt_period = $p; $body } };
    on_missed(body)      => quote { { $body } };
    fallback(body)       => quote { { $body } };
}

pub pure fn is_realtime_construct(word: str) -> bool {
    return word == nameof(noalloc)
        || word == nameof(region)
        || word == nameof(deadline)
        || word == nameof(within)
        || word == nameof(periodic)
        || word == nameof(on_missed)
        || word == nameof(fallback);
}
