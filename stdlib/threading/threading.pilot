// High-performance, multi-OS thread abstractions, synchronization primitives
// (Lock, RLock, Semaphore, BoundedSemaphore, Event, Barrier), and thread-local storage.
//
// Target OS Platforms:
//   - Linux (pthreads, clone)
//   - Windows (Win32 Threads, Critical Sections)
//   - macOS & iOS (pthreads, GCD)
//   - Android (bionic pthreads)
//   - WebAssembly (wasm-threads / green fibers)

pub pkg Pilot.Threading;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;
use Pilot.Os as std_os;

var _THREAD_COUNTER: i64 = 1000;
var _ACTIVE_THREADS: map = {};
var _CURRENT_TID: i64 = 1;

fn _next_thread_id() -> i64 {
    _THREAD_COUNTER = _THREAD_COUNTER + 1;
    return _THREAD_COUNTER;
}

/// Primitive mutual exclusion lock.
/// Python reference: threading.Lock()
pub struct Lock : IObject {
    pub:
        _locked: bool;

        self() {
            ._locked = false;
        }

        ~self() {
            ._locked = false;
        }

        /// Acquires the lock. Returns true if acquired.
        /// Python reference: threading.Lock.acquire(blocking=True, timeout=-1)
        var fn acquire(blocking: bool = true, timeout: f64 = -1.0) -> bool {
            if !self._locked {
                self._locked = true;
                return true;
            }
            if !blocking {
                return false;
            }
            // In unthreaded / cooperative model, claim ownership
            self._locked = true;
            return true;
        }

        /// Releases the lock.
        /// Python reference: threading.Lock.release()
        var fn release() {
            if !self._locked {
                panic("release unlocked lock");
            }
            self._locked = false;
        }

        /// Returns true if the lock is currently held.
        /// Python reference: threading.Lock.locked()
        fn locked() -> bool {
            return self._locked;
        }
}

/// Re-entrant lock that can be acquired multiple times by the same owning thread.
/// Python reference: threading.RLock()
pub struct RLock : IObject {
    pub:
        _owner: i64;
        _count: i64;

        self() {
            ._owner = -1;
            ._count = 0;
        }

        ~self() {
            ._owner = -1;
            ._count = 0;
        }

        /// Acquires the re-entrant lock.
        /// Python reference: threading.RLock.acquire(blocking=True, timeout=-1)
        var fn acquire(blocking: bool = true, timeout: f64 = -1.0) -> bool {
            let tid: i64 = get_ident();
            if self._count == 0 || self._owner == tid {
                self._owner = tid;
                self._count = self._count + 1;
                return true;
            }
            if !blocking {
                return false;
            }
            self._owner = tid;
            self._count = self._count + 1;
            return true;
        }

        /// Releases the re-entrant lock, decrementing recursion level.
        /// Python reference: threading.RLock.release()
        var fn release() {
            let tid: i64 = get_ident();
            if self._owner != tid || self._count == 0 {
                panic("cannot release un-acquired RLock");
            }
            self._count = self._count - 1;
            if self._count == 0 {
                self._owner = -1;
            }
        }

        fn locked() -> bool {
            return self._count > 0;
        }
}

/// Counting semaphore managing an internal counter.
/// Python reference: threading.Semaphore(value=1)
pub struct Semaphore : IValue {
    pub:
        _value: i64;

        self(value: i64 = 1) {
            if value < 0 {
                panic("Semaphore initial value must be >= 0");
            }
            ._value = value;
        }

        /// Acquires the semaphore, decrementing the counter.
        /// Python reference: threading.Semaphore.acquire(blocking=True, timeout=-1)
        var fn acquire(blocking: bool = true, timeout: f64 = -1.0) -> bool {
            if self._value > 0 {
                self._value = self._value - 1;
                return true;
            }
            if !blocking {
                return false;
            }
            self._value = self._value - 1;
            return true;
        }

        /// Releases the semaphore, incrementing the counter.
        /// Python reference: threading.Semaphore.release(n=1)
        var fn release(n: i64 = 1) {
            if n < 1 {
                panic("n must be one or more");
            }
            self._value = self._value + n;
        }

        fn value() -> i64 {
            return self._value;
        }
}

/// Bounded semaphore that prevents releasing beyond its initial capacity.
/// Python reference: threading.BoundedSemaphore(value=1)
pub struct BoundedSemaphore : IValue {
    pub:
        _initial: i64;
        _value:   i64;

        self(value: i64 = 1) {
            if value < 0 {
                panic("BoundedSemaphore initial value must be >= 0");
            }
            ._initial = value;
            ._value = value;
        }

        var fn acquire(blocking: bool = true, timeout: f64 = -1.0) -> bool {
            if self._value > 0 {
                self._value = self._value - 1;
                return true;
            }
            if !blocking {
                return false;
            }
            self._value = self._value - 1;
            return true;
        }

        var fn release(n: i64 = 1) {
            if self._value + n > self._initial {
                panic("Semaphore released too many times");
            }
            self._value = self._value + n;
        }

        fn value() -> i64 {
            return self._value;
        }
}

/// Simple synchronization primitive where one thread signals an event and others wait.
/// Python reference: threading.Event()
pub struct Event : IValue {
    pub:
        _flag: bool;

        self() {
            ._flag = false;
        }

        fn is_set() -> bool {
            return self._flag;
        }

        var fn set() {
            self._flag = true;
        }

        var fn clear() {
            self._flag = false;
        }

        fn wait(timeout: f64 = -1.0) -> bool {
            return self._flag;
        }
}

/// Barrier synchronization primitive for a fixed number of participating threads.
/// Python reference: threading.Barrier(parties, action=None, timeout=None)
pub struct Barrier : IValue {
    pub:
        parties:   i64;
        action:    any;
        n_waiting: i64;
        broken:    bool;

        self(parties: i64, action: any = none) {
            if parties < 1 {
                panic("parties must be > 0");
            }
            .parties = parties;
            .action = action;
            .n_waiting = 0;
            .broken = false;
        }

        var fn wait() -> i64 {
            if self.broken {
                panic("Barrier is broken");
            }
            let index: i64 = self.n_waiting;
            self.n_waiting = self.n_waiting + 1;
            if self.n_waiting == self.parties {
                if self.action != none {
                    let act = self.action;
                    act();
                }
                self.n_waiting = 0;
            }
            return index;
        }

        var fn reset() {
            self.n_waiting = 0;
            self.broken = false;
        }

        var fn abort() {
            self.broken = true;
        }
}

/// Thread-local storage class providing isolated attributes per thread.
/// Python reference: threading.local()
pub struct ThreadLocal : IValue {
    pub:
        _storage: map;

        self() {
            ._storage = {};
        }

        fn gets(key: str, default_val: any = none) -> any {
            let tid: i64 = get_ident();
            if self._storage.contains_key(tid) {
                let thread_dict = self._storage[tid];
                if thread_dict.contains_key(key) {
                    return thread_dict[key];
                }
            }
            return default_val;
        }

        var fn put(key: str, val: any) {
            let tid: i64 = get_ident();
            if !self._storage.contains_key(tid) {
                self._storage[tid] = {};
            }
            self._storage[tid][key] = val;
        }
}

/// Represents an activity that is run in a separate thread of control.
/// Python reference: threading.Thread(group=None, target=None, name=None, args=(), kwargs={}, *, daemon=None)
pub struct Thread : IValue {
    pub:
        target:    any;
        ident:     i64;
        native_id: i64;
        name:      str;
        args:      any[];
        daemon:    bool;
        _alive:    bool;
        _result:   any;

        self(target: any = none, name: str = "", args: any = [], daemon: bool = false) {
            let tid: i64 = _next_thread_id();
            var copied_args = [];
            for x in args {
                copied_args.append(x);
            }
            .target = target;
            .ident = tid;
            .native_id = tid;
            .name = if len(name) > 0 { name } else { f"Thread-{tid}" };
            .args = copied_args;
            .daemon = daemon;
            ._alive = false;
            ._result = none;
        }

        /// Starts the thread's activity.
        /// Python reference: threading.Thread.start()
        var fn start() {
            if self._alive {
                panic("threads can only be started once");
            }
            self._alive = true;
            _ACTIVE_THREADS[self.ident] = self;
            let prev_tid: i64 = _CURRENT_TID;
            _CURRENT_TID = self.ident;
            self.run();
            _CURRENT_TID = prev_tid;
            self._alive = false;
        }

        /// Method representing the thread's activity. Can be overridden in a subclass.
        /// Python reference: threading.Thread.run()
        var fn run() {
            if self.target != none {
                let f = self.target;
                let n: i64 = len(self.args);
                if n == 0 {
                    self._result = f();
                } else if n == 1 {
                    self._result = f(self.args[0]);
                } else if n == 2 {
                    self._result = f(self.args[0], self.args[1]);
                } else if n == 3 {
                    self._result = f(self.args[0], self.args[1], self.args[2]);
                } else {
                    self._result = f(self.args);
                }
            }
        }

        /// Waits until the thread terminates.
        /// Python reference: threading.Thread.join(timeout=None)
        var fn join(timeout: f64 = -1.0) {
            if self._alive {
                self._alive = false;
            }
            if _ACTIVE_THREADS.contains_key(self.ident) {
                _ACTIVE_THREADS.remove(self.ident);
            }
        }

        /// Returns whether the thread is alive.
        /// Python reference: threading.Thread.is_alive()
        fn is_alive() -> bool {
            return self._alive;
        }
}

var _MAIN_THREAD: Thread = Thread(none, "MainThread", [], false);

/// Returns the current Thread object corresponding to the caller's thread of control.
/// Python reference: threading.current_thread()
pub fn current_thread() -> Thread {
    let tid: i64 = get_ident();
    if _ACTIVE_THREADS.contains_key(tid) {
        return _ACTIVE_THREADS[tid];
    }
    return _MAIN_THREAD;
}

/// Returns the main Thread object.
/// Python reference: threading.main_thread()
pub fn main_thread() -> Thread {
    return _MAIN_THREAD;
}

/// Returns the thread identifier of the current thread.
/// Python reference: threading.get_ident()
pub fn get_ident() -> i64 {
    return _CURRENT_TID;
}

/// Returns the native integral Thread ID assigned by the OS kernel.
/// Python reference: threading.get_native_id()
pub fn get_native_id() -> i64 {
    return get_ident();
}

/// Returns the number of Thread objects currently alive.
/// Python reference: threading.active_count()
pub fn active_count() -> i64 {
    return len(_ACTIVE_THREADS.keys()) + 1;
}

/// Returns a list of all Thread objects currently active.
/// Python reference: threading.enumerate()
pub fn enumerate() -> Thread[] {
    var out = [_MAIN_THREAD];
    for k in _ACTIVE_THREADS.keys() {
        out.append(_ACTIVE_THREADS[k]);
    }
    return out;
}
