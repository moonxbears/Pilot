// ==============================================================================
// FILE: selfhost/check/view_cast.pilot
// `xs as view T`: its type, what it may view, and the call the engines make.
// ==============================================================================
// A program binds `as view` to functions with
// `__engine("bind_operator_fn", "as view", nameof(f))` (stdlib/core/
// reinterpret.pilot); an `as view` calls the one whose first parameter takes
// its source's type, else the first bound (infer.pilot `view_fn`).
// `f<E, T>(xs, from_float, from_signed, from_width, to_float, to_signed,
// to_width)` builds the view; its declared return type, given `E` (the
// element type of `xs`) and `T`, is the type of the expression. The six
// integers are the register shape of `E` and of `T`: 1 for a float, 1 for a
// signed integer (else 0), and the width in bits.
//
// TYPE003 refuses a view the function cannot build: an element or target
// that is not a primitive integer of 8, 16, 32 or 64 bits or a float of 32
// or 64, a character (as the target not every 32-bit pattern is one; as the
// source, a `char[]` literal holds its elements as text, known bug
// engine.char_list_literal), or a program with no binding. Elements and
// targets of different widths are viewed little-endian
// (stdlib/core/reinterpret.pilot).
//
// The seed reads the call from the run plan: one `ViewCast` row per
// `as view`, `[action, span start, span end, node kind, function, the six
// integers separated by spaces]`. PilIR asks `view_shapes` itself
// (selfhost/ir/lower_view.pilot). The expression's type is `view_type`
// (selfhost/check/infer.pilot).
// ==============================================================================
pub lvl(0) pkg selfhost.check;


/// The bits a value of primitive `t` holds, from its `[Bits]`, or -1.
fn bits_width(var ref p: Program, t: i64) -> i64 {
    if !ty_is_named(p.tt, t) { return -1; }
    for decl in nl_get(p.type_decls, node_name(p.s, ty_decl(p.tt, t))) {
        if some args = prog_attr_nodes(p, decl, "Bits") {
            if args.len() > 0 {
                if some bits = prog_const(p, args[0]) { return bits; }
            }
        }
    }
    return -1;
}

/// The register shape of `t` as `[float, signed, width]`, or empty when an
/// `as view` cannot read or make a `t`.
pub fn view_shape(var ref p: Program, t: i64) -> List<i64> {
    var out: List<i64> = [];
    if is_scalar_type(p, t) { return out; }
    let class = prog_class(p, t);
    let w = bits_width(p, t);
    if is_float_class(class) && (w == 32 || w == 64) {
        out.push(1);
        out.push(1);
        out.push(w);
    } else if is_integer_class(class) && (w == 8 || w == 16 || w == 32 || w == 64) {
        out.push(0);
        out.push(if is_signed_class(class) { 1 } else { 0 });
        out.push(w);
    }
    return out;
}

/// The six integers of `as view` node `n` (the shape of the element type,
/// then of the target), or empty with `why` saying what is wrong.
pub fn view_shapes(var ref inf: Infer, n: i64, var ref why: List<str>) -> List<i64> {
    let p = inf.p;
    let s = p.s;
    var out: List<i64> = [];
    let src = type_of(inf, lhs(s, n));
    let elem = element_type(p, src);
    let target = prog_annot_type(p, rhs(s, n));
    if view_fn(inf, n) < 0 {
        why.push("no function is bound to `as view`");
        return out;
    }
    if !ty_is_named(p.tt, elem) {
        why.push(f"`{ty_display(p.tt, src)}` has no elements to view");
        return out;
    }
    let from = view_shape(p, elem);
    let to = view_shape(p, target);
    if from.len() == 0 || to.len() == 0 {
        let which = if from.len() == 0 { elem } else { target };
        why.push(f"`{ty_display(p.tt, which)}` is not a primitive `as view` reads or makes (integers of 8, 16, 32 or 64 bits, floats of 32 or 64)");
        return out;
    }
    for v in from { out.push(v); }
    for v in to { out.push(v); }
    return out;
}

/// TYPE003 for each `as view` of the user's files that cannot be built.
pub fn check_view_casts(var ref inf: Infer, var ref sink: DiagSink) {
    let s = inf.p.s;
    var n = s.user_lo;
    while n < s.user_hi {
        if kind(s, n) == nk_binary() && flags(s, n) == op_as_view() && in_user_file(s, n) {
            var why: List<str> = [];
            let shapes = view_shapes(inf, n, why);
            if shapes.len() == 0 && why.len() > 0 {
                let target = prog_annot_type(inf.p, rhs(s, n));
                sink_error(sink, n, "TYPE003", f"cannot view `{ty_display(inf.p.tt, type_of(inf, lhs(s, n)))}` as `{ty_display(inf.p.tt, target)}`: {why[0]}");
            }
        }
        n = n + 1;
    }
}

/// Adds a `ViewCast` row to `rows` for each `as view` of the files the
/// program links that can be built.
pub fn plan_view_casts(var ref inf: Infer, var ref rows: List<List<any>>) {
    let p = inf.p;
    let s = p.s;
    for n in prog_nodes_of_kind(p, nk_binary()) {
        if flags(s, n) == op_as_view() && in_linked_file(s, n) {
            var why: List<str> = [];
            let shapes = view_shapes(inf, n, why);
            if shapes.len() == 6 {
                let f = node_name(s, view_fn(inf, n));
                var parts: List<str> = [];
                for v in shapes { parts.push(f"{v}"); }
                rows.push([DropAction::ViewCast as i64, span_start(s, n), span_end(s, n), kind(s, n), f, text_join(parts)]);
            }
        }
    }
}

/// `parts` separated by single spaces.
fn text_join(ref parts: List<str>) -> str {
    var out = "";
    for x in parts { out = if out == "" { x } else { out + " " + x }; }
    return out;
}
