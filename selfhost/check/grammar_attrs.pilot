// ==============================================================================
// FILE: selfhost/check/grammar_attrs.pilot
// GRAM005-GRAM007: the operator-declaring attributes (PROP-008 step 1).
// ==============================================================================
// `[Infix]`, `[InfixWord]`, `[Prefix]`, `[Postfix]` and `[Shaped]`
// (stdlib/core/operators/shapes.pilot) each declare one operator. Written
// on an `op`, the operator is that `op`'s own symbol; written on a `syntax`
// rule, the attribute names the symbol (or the rule's name is the operator).
// The checker reports, in the user's files:
//   GRAM005  the symbol or readable word is structural syntax (the 13 tokens
//            `( ) [ ] { } , ; : :: . => =`) or a seed word; the seed ignores
//            such an entry, so the operator would silently not exist;
//   GRAM006  the declaration's operands do not fit the shape: an infix
//            operator takes two (an `op` one parameter beside `self`, a rule
//            two), a prefix or postfix operator one (an `op` none, a rule one);
//   GRAM007  the attribute is on a declaration that cannot define an
//            operator: neither an `op` nor a `syntax` rule.
// and, on every `op` whose symbol marks its operands with `_` holes
// (PROP-018: `_+_` infix, `-_` prefix, `_?` postfix, `|_|` circumfix,
// `<|_, ..|>` matchfix, anything else mixfix):
//   GRAM005  the symbol is only a hole (`op _`);
//   GRAM008  the holes have no operator symbol between them (`op _ _`);
//   GRAM009  the holes give another operand count than the `op` takes, or a
//            fixity the operator attribute on it does not declare;
//   GRAM010  a hole is given a kind (`op _:Type ?`, `op $t:Type ?`): an
//            `op` is a member of a type, so its operands are values; an
//            operator over types, blocks or names is a `syntax` rule with
//            `$name:Kind` holes (PROP-019 recommendation 1);
//   GRAM011  an `op` written without holes is infix when it takes one
//            parameter and prefix when it takes none; anything else
//            (indexing `_[_]`, `_[_]=_`, two or more parameters) must
//            write its holes (owner direction 2026-11-16);
//   SEAM001  circumfix, matchfix and mixfix other than indexing (`_[_]`,
//            `_[_]=_`) are declared but no use site parses them yet.
// and, on the user's own operators (PROP-008 step 2):
//   GRAM001  an operator attribute declares a symbol or readable word that
//            is built in: declared outside the user's files (the standard
//            library), or a symbol the seed's lexer table already reads as
//            one token (stdlib/core/lex/seed_kinds.pilot);
//   GRAM003  two of the user's operator attributes declare one symbol in
//            one position (infix, prefix or postfix) with another level,
//            associativity or shape;
//   SEAM001  `grammar.user_ops_seed`: any other operator the user declares
//            (by an attribute, or an `op` whose symbol the seed's lexer table
//            has no token for). The seed lexes with the table built from the
//            standard library's declarations and lowers only the operators
//            the standard library declares, so such an operator cannot run.
//   GRAM002  a new symbol would end inside a token of its declaring file
//            (selfhost/check/grammar_lex.pilot).
// GRAM004 (conflicting relative placements) waits for `tighter_than` /
// `looser_than` placement (PROP-008 §5).
pub lvl(0) pkg selfhost.check;

// The 13 structural tokens and the 14 seed words are declared once, by
// stdlib/core/lex/words.pilot; the families the seed's lexer table holds,
// by stdlib/core/lex/seed_kinds.pilot.
use Pilot.Core.Lex.Words;
use Pilot.Core.Lex.SeedKinds;
use Pilot.Core.Lex.SeedForms;


/// The operator attributes and, for each, the positions (after the target)
/// of its explicit symbol, readable word, shape, level and associativity
/// (-1: it has none) and whether its shape is fixed to one operand.
struct GrammarAttr : IValue {
    pub name:      str;
    pub symbol_at: i64;
    pub word_at:   i64;
    pub shape_at:  i64;
    pub level_at:  i64;
    pub assoc_at:  i64;
    pub unary:     bool;
}

fn grammar_attrs() -> List<GrammarAttr> => [
    GrammarAttr { name: nameof(Infix),     symbol_at: 2, word_at: -1, shape_at: -1, level_at: 0,  assoc_at: 1,  unary: false },
    GrammarAttr { name: nameof(InfixWord), symbol_at: 3, word_at: 0,  shape_at: -1, level_at: 1,  assoc_at: 2,  unary: false },
    GrammarAttr { name: nameof(Prefix),    symbol_at: 1, word_at: 2,  shape_at: -1, level_at: 0,  assoc_at: -1, unary: true },
    GrammarAttr { name: nameof(Postfix),   symbol_at: 0, word_at: -1, shape_at: -1, level_at: -1, assoc_at: -1, unary: true },
    GrammarAttr { name: nameof(Shaped),    symbol_at: 3, word_at: 4,  shape_at: 0,  level_at: 1,  assoc_at: 2,  unary: false },
];

/// The shapes of `[Shaped]` that take one operand.
fn unary_shapes() -> List<str> => [nameof(Prefix), nameof(Postfix)];

/// Whether `sym` is, or starts with a delimiter that is always, structural
/// syntax or a seed word. (`..` and `:=` start with `.` and `:` but lex as
/// operators of their own, so only an exact match counts for those.)
pub fn is_structural_symbol(sym: str) -> bool {
    if sym.len() == 0 { return true; }
    for t in STRUCTURAL_TOKENS { if sym == t { return true; } }
    for w in SEED_WORDS { if sym == w { return true; } }
    for t in ["(", ")", "[", "]", "{", "}", ",", ";"] { if sym.starts_with(t) { return true; } }
    return false;
}

/// The text of attribute argument `a`: a string, a name (`::Add` is `Add`)
/// or `nameof(word)`; empty for anything else.
fn arg_text(ref s: Snap, a: i64) -> str {
    let k = kind(s, a);
    if k == nk_str() || k == nk_ident() { return node_name(s, a); }
    if k == nk_call() {
        let ch = children(s, a);
        if ch.len() == 2 && kind(s, ch[0]) == nk_ident() && node_name(s, ch[0]) == nameof(nameof) {
            return node_name(s, ch[1]);
        }
    }
    return "";
}

/// Whether `d` is a `syntax` rule: a function whose body is a quote template.
pub fn is_syntax_rule(ref s: Snap, d: i64) -> bool {
    if kind(s, d) != nk_fn() { return false; }
    let body = fn_body(s, d);
    return body >= 0 && kind(s, body) == nk_quote();
}

/// The fixity an `op` symbol's holes give it (PROP-018 §1).
pub enum Fixity : u8 {
    Infix,
    Prefix,
    Postfix,
    Circumfix,
    Matchfix,
    Mixfix,
    Index,     // `_[_]` and `_[_]=_`: mixfix, built as indexing
}

fn fixity_text(f: Fixity) -> str {
    if f == Fixity::Infix { return "infix"; }
    if f == Fixity::Prefix { return "prefix"; }
    if f == Fixity::Postfix { return "postfix"; }
    if f == Fixity::Circumfix { return "circumfix"; }
    if f == Fixity::Matchfix { return "matchfix"; }
    return "mixfix";
}

/// The fixity each operator attribute declares, for the ones that fix it.
fn attr_fixity(attr: str) -> Fixity? {
    if attr == nameof(Infix) || attr == nameof(InfixWord) { return some(Fixity::Infix); }
    if attr == nameof(Prefix) { return some(Fixity::Prefix); }
    if attr == nameof(Postfix) { return some(Fixity::Postfix); }
    return none;
}

fn is_word_byte(c: i64) -> bool => (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95;

/// The `op` symbol as written, holes included: the text between `op` and
/// its parameter list.
fn op_pattern(ref s: Snap, d: i64) -> str {
    let text = node_text(s, d);
    let kw = nameof(op);
    let n = kw.len();
    var i = 0;
    while i + n <= text.len() {
        let before = i == 0 || !is_word_byte(text.byte_at(i - 1));
        let after = i + n >= text.len() || !is_word_byte(text.byte_at(i + n));
        if before && after && text.slice(i, i + n) == kw { break; }
        i = i + 1;
    }
    var j = i + n;
    while j < text.len() && text.byte_at(j) != 40 { j = j + 1; }
    return if j <= text.len() && i + n <= j { text.slice(i + n, j).trim() } else { "" };
}

/// The byte positions of the holes in `pat`: each `_` not part of a word.
fn hole_positions(pat: str) -> List<i64> {
    var out: List<i64> = [];
    var i = 0;
    while i < pat.len() {
        let lone = (i == 0 || !is_word_byte(pat.byte_at(i - 1))) && (i + 1 >= pat.len() || !is_word_byte(pat.byte_at(i + 1)));
        if pat.byte_at(i) == 95 && lone { out.push(i); }
        i = i + 1;
    }
    return out;
}

/// `pat` without its holes: `*_` is `*`, `_ and _` is `and`.
pub fn strip_holes(pat: str) -> str {
    let holes = hole_positions(pat);
    var out = "";
    var last = 0;
    for h in holes {
        out = out + pat.slice(last, h);
        last = h + 1;
    }
    return (out + pat.slice(last, pat.len())).trim();
}

/// Whether only spaces separate two holes (or a hole from the list mark).
fn only_spaces(pat: str, lo: i64, hi: i64) -> bool {
    var i = lo;
    while i < hi { if pat.byte_at(i) != 32 { return false; } i = i + 1; }
    return true;
}

/// Whether the hole at `h` is a matchfix list hole: `_, ..`.
fn is_list_hole(pat: str, h: i64) -> bool {
    var i = h + 1;
    while i < pat.len() && pat.byte_at(i) == 32 { i = i + 1; }
    if i >= pat.len() || pat.byte_at(i) != 44 { return false; }
    i = i + 1;
    while i < pat.len() && pat.byte_at(i) == 32 { i = i + 1; }
    return i + 2 <= pat.len() && pat.slice(i, i + 2) == "..";
}

/// The fixity holes `holes` (at least one) give the `op` symbol `pat`.
fn fixity_of(pat: str, ref holes: List<i64>) -> Fixity {
    let bare = strip_holes(pat);
    let n = holes.len();
    let first = holes[0] == 0;
    let last = holes[n - 1] == pat.len() - 1;
    var list = false;
    for h in holes { if is_list_hole(pat, h) { list = true; } }
    return if list { Fixity::Matchfix }
        else if bare == "[]" || bare == "[]=" { Fixity::Index }
        else if n == 2 && first && last { Fixity::Infix }
        else if n == 1 && last { Fixity::Prefix }
        else if n == 1 && first { Fixity::Postfix }
        else if n == 1 { Fixity::Circumfix }
        else { Fixity::Mixfix };
}

fn params_text(n: i64) -> str => if n == 1 { "1 parameter" } else { f"{n} parameters" };
fn operands_text(n: i64) -> str => if n == 1 { "1 operand" } else { f"{n} operands" };

/// GRAM005, GRAM008, GRAM009 and the shape seams on an `op` whose symbol is
/// written with holes. `shape_reported`: GRAM006 already said the operand
/// count is wrong.
fn check_holes(ref p: Program, var ref sink: DiagSink, d: i64, shape_reported: bool) {
    let s = p.s;
    let pat = op_pattern(s, d);
    let holes = hole_positions(pat);
    var kinded = pat.find("$", 0) >= 0;
    for h in holes {
        var i = h + 1;
        while i < pat.len() && pat.byte_at(i) == 32 { i = i + 1; }
        if i < pat.len() && pat.byte_at(i) == 58 { kinded = true; }
    }
    if kinded {
        sink_error(sink, d, "GRAM010", f"`op {pat}` gives an operand a kind; an `op`'s operands are values, so each is a plain `_`. For an operator over types, blocks or names, write a `syntax` rule with `$name:Kind` holes");
        return;
    }
    if holes.len() == 0 {
        // Without holes: one parameter is infix, none prefix, nothing else.
        let params = fn_params(s, d).len();
        if pat.len() > 0 && (params > 1 || is_structural_symbol(pat)) {
            sink_error(sink, d, "GRAM011", f"`op {pat}` takes {params_text(params)} and has no holes; without holes an `op` is infix (one parameter) or prefix (none), so write its holes (indexing is `op _[_]`, assigning through an index `op _[_]=_`)");
        }
        return;
    }
    if pat == "_" {
        sink_error(sink, d, "GRAM005", f"`op {pat}` is only a hole; `_` marks an operand and cannot be an operator symbol");
        return;
    }
    let bare = strip_holes(pat);
    var gap = bare.len() == 0;
    var k = 1;
    while k < holes.len() { if only_spaces(pat, holes[k - 1] + 1, holes[k]) { gap = true; } k = k + 1; }
    if gap {
        sink_error(sink, d, "GRAM008", f"`op {pat}` has no operator symbol between its holes");
        return;
    }
    let n = holes.len();
    let fix = fixity_of(pat, holes);
    // An `op` takes its first operand as `self`; a matchfix `op` takes its
    // list as its one parameter.
    let params = fn_params(s, d).len();
    let given = if fix == Fixity::Matchfix { params } else { params + 1 };
    let wanted = if fix == Fixity::Matchfix { 1 } else { n };
    if given != wanted && !shape_reported {
        sink_error(sink, d, "GRAM009", f"`op {pat}` is {fixity_text(fix)}, which takes {operands_text(wanted)}, but it takes {given}");
    }
    for ga in grammar_attrs() {
        guard some declared = attr_fixity(ga.name) else { continue; }
        if prog_attr_nodes(p, d, ga.name) == none || declared == fix { continue; }
        sink_error(sink, d, "GRAM009", f"`op {pat}` is {fixity_text(fix)}, but `[{ga.name}]` declares a {fixity_text(declared)} operator");
    }
    // Each seam is written out whole so `pilot gate` finds it.
    let seam = if fix == Fixity::Circumfix { "unconnected seam `grammar.circumfix_shape`" }
        else if fix == Fixity::Matchfix { "unconnected seam `grammar.matchfix_shape`" }
        else if fix == Fixity::Mixfix { "unconnected seam `grammar.mixfix_shape`" }
        else { "" };
    if seam.len() > 0 {
        let what = fixity_text(fix);
        sink_error(sink, d, "SEAM001",
            f"{seam}: `op {pat}` is a {what} operator; declaring it is checked, but no use site parses {what} operators yet (proposals.md PROP-018 §4.5)");
    }
}

/// GRAM005-GRAM007 on `d`; whether it reported GRAM006.
fn check_decl(ref p: Program, var ref sink: DiagSink, d: i64) -> bool {
    // No attribute on `d`: every grammar attribute below is skipped.
    if nl_get(p.attrs, f"{d}").len() == 0 { return false; }
    let s = p.s;
    let is_op = kind(s, d) == nk_operator();
    // An `op` is shown, and its symbol taken, as written (`op -`, not the
    // member `-_`).
    let pat = if is_op { op_pattern(s, d) } else { "" };
    let name = if is_op && pat.len() > 0 { strip_holes(pat) } else { node_name(s, d) };
    var shape_reported = false;
    for ga in grammar_attrs() {
        guard some args = prog_attr_nodes(p, d, ga.name) else { continue; }
        if !is_op && !is_syntax_rule(s, d) {
            sink_error(sink, d, "GRAM007", f"`[{ga.name}]` is on `{name}`, which is neither an `op` declaration nor a `syntax` rule, so it cannot define an operator");
            continue;
        }
        let symbol = if ga.symbol_at >= 0 && ga.symbol_at < args.len() { arg_text(s, args[ga.symbol_at]) } else { "" };
        let sym = if symbol.len() > 0 { symbol } else { name };
        if is_structural_symbol(sym) {
            sink_error(sink, d, "GRAM005", f"`[{ga.name}]` on `{name}` declares `{sym}`, which is structural syntax or a seed word; an operator cannot be one");
        }
        if ga.word_at >= 0 && ga.word_at < args.len() {
            let word = arg_text(s, args[ga.word_at]);
            if word.len() > 0 && is_structural_symbol(word) {
                sink_error(sink, d, "GRAM005", f"`[{ga.name}]` on `{name}` gives the readable word `{word}`, which is structural syntax or a seed word");
            }
        }
        var unary = ga.unary;
        if ga.shape_at >= 0 && ga.shape_at < args.len() {
            let shape = arg_text(s, args[ga.shape_at]);
            for u in unary_shapes() { if shape == u { unary = true; } }
        }
        let operands = if unary { 1 } else { 2 };
        // An `op` takes its left (or only) operand as `self`.
        let given = if is_op { fn_params(s, d).len() + 1 } else { fn_params(s, d).len() };
        if given != operands {
            let what = if unary { "one operand" } else { "two operands" };
            let decl = if is_op { nameof(op) + " " + pat } else { name };
            sink_error(sink, d, "GRAM006", f"`[{ga.name}]` declares `{sym}` as an operator of {what}, but `{decl}` takes {given}");
            shape_reported = true;
        }
    }
    return shape_reported;
}

/// GRAM001, GRAM003, GRAM005-GRAM009 and the operator seams over the
/// user's files.
pub fn check_grammar_attrs(ref inf: Infer, var ref sink: DiagSink) {
    let p = inf.p;
    let s = p.s;
    var claims: List<GrammarClaim> = [];
    // The symbols the seed's table has no family for (GRAM002).
    var news: List<NewSymbol> = [];
    // The library's spellings, read once and only when a declaration needs them.
    var library = Map<str, bool>();
    var have_library = false;
    var d = s.user_lo;
    while d < s.user_hi {
        if in_user_file(s, d) {
            let k = kind(s, d);
            if k == nk_operator() || k == nk_fn() || k == nk_struct() || k == nk_interface() || k == nk_adt() || k == nk_const() {
                let shape_reported = check_decl(p, sink, d);
                if k == nk_operator() { check_holes(p, sink, d, shape_reported); }
                if k == nk_operator() || is_syntax_rule(s, d) {
                    let mine = claims_of(p, d);
                    if mine.len() == 0 && k == nk_operator() {
                        let sym = unclaimed_symbol(s, d);
                        if sym.len() > 0 && !seed_lexes(sym) {
                            if !have_library { library = library_spellings(p); have_library = true; }
                            if !library.has(sym) {
                                report_user_op_seam(s, sink, d, sym, NOT_ONE_TOKEN);
                                add_new_symbol(s, news, sym, d);
                            }
                        }
                    }
                    for c in mine { claims.push(c); }
                }
            }
        }
        d = d + 1;
    }
    if claims.len() > 0 {
        if !have_library { library = library_spellings(p); }
        check_claims(p, sink, claims, library, news);
    }
    if news.len() > 0 { check_new_symbols(s, sink, news); }
}

/// One operator a grammar attribute declares: its symbol and readable word,
/// where it stands, its level, associativity and shape as written, and the
/// declaration and attribute that declare it.
pub struct GrammarClaim : IValue {
    pub symbol: str;
    pub word:   str;
    pub place:  Fixity;
    pub level:  str;
    pub assoc:  str;
    pub shape:  str;
    pub decl:   i64;
    pub attr:   str;
}

/// The text of argument `at` of `args`, or "" when it is not given.
fn arg_at(ref s: Snap, ref args: List<i64>, at: i64) -> str => if at >= 0 && at < args.len() { arg_text(s, args[at]) } else { "" };

/// The operators the grammar attributes on `d` declare.
pub fn claims_of(ref p: Program, d: i64) -> List<GrammarClaim> {
    let s = p.s;
    var out: List<GrammarClaim> = [];
    if nl_get(p.attrs, f"{d}").len() == 0 { return out; }
    let is_op = kind(s, d) == nk_operator();
    let pat = if is_op { op_pattern(s, d) } else { "" };
    let name = if is_op && pat.len() > 0 { strip_holes(pat) } else { node_name(s, d) };
    for ga in grammar_attrs() {
        guard some args = prog_attr_nodes(p, d, ga.name) else { continue; }
        let symbol = arg_at(s, args, ga.symbol_at);
        let shape = if ga.shape_at >= 0 { arg_at(s, args, ga.shape_at) } else { ga.name };
        let place = if ga.name == nameof(Prefix) || shape == nameof(Prefix) { Fixity::Prefix }
            else if ga.name == nameof(Postfix) || shape == nameof(Postfix) { Fixity::Postfix }
            else { Fixity::Infix };
        out.push(GrammarClaim {
            symbol: if symbol.len() > 0 { symbol } else { name },
            word: arg_at(s, args, ga.word_at),
            place: place,
            level: arg_at(s, args, ga.level_at),
            assoc: arg_at(s, args, ga.assoc_at),
            shape: shape,
            decl: d,
            attr: ga.name,
        });
    }
    return out;
}

/// The operator symbols and readable words that declarations outside the
/// user's files declare: the pieces of every `op` symbol and the symbol and
/// word of every grammar attribute.
fn library_spellings(ref p: Program) -> Map<str, bool> {
    let s = p.s;
    var out = Map<str, bool>();
    var d = 0;
    while d < s.count {
        let is_op = kind(s, d) == nk_operator();
        if !in_user_file(s, d) && (is_op || is_syntax_rule(s, d)) {
            if is_op {
                for piece in op_pieces(op_pattern(s, d)) { out.set(piece, true); }
            }
            for c in claims_of(p, d) {
                out.set(c.symbol, true);
                if c.word.len() > 0 { out.set(c.word, true); }
            }
        }
        d = d + 1;
    }
    return out;
}

/// Whether the seed lexes `sym` as one token without the user's files: a
/// family seed_kinds.pilot names, or one of the seed's own forms
/// (seed_forms.pilot). A spelling only the generic `SEED_OPERATOR_KIND`
/// would take is not one: the table lexes only the declared symbols.
fn seed_lexes(sym: str) -> bool {
    for f in SEED_FORM_SPELLINGS {
        if f == sym { return true; }
    }
    guard some e = seed_kind_of(sym) else { return false; }
    return e.emit == SeedEmit::Token && e.kind != SEED_OPERATOR_KIND;
}

/// Whether `sym` is built in: declared outside the user's files, or a
/// symbol the seed's lexer table already reads as one token (a declared
/// operator, or one of the seed's own forms, stdlib/core/lex/seed_forms.pilot).
fn is_builtin_spelling(ref library: Map<str, bool>, sym: str) -> bool =>
    library.has(sym) || (!is_word_text(sym) && seed_lexes(sym));

/// Whether `sym` is a word (`and`): a word lexes as a name, not an operator.
fn is_word_text(sym: str) -> bool {
    var i = 0;
    while i < sym.len() {
        if !is_word_byte(sym.byte_at(i) as i64) { return false; }
        i = i + 1;
    }
    return sym.len() > 0;
}

/// The seam an operator of the user stops at on the seed.
fn report_user_op_seam(ref s: Snap, var ref sink: DiagSink, d: i64, sym: str, why: str) {
    let what = if kind(s, d) == nk_operator() { nameof(op) + " " + op_pattern(s, d) } else { node_name(s, d) };
    sink_error(sink, d, "SEAM001",
        f"unconnected seam `grammar.user_ops_seed`: `{what}` declares the operator `{sym}`, which {why} (proposals.md PROP-008 step 2)");
}

/// Why the seed cannot read a symbol it has no token for.
const NOT_ONE_TOKEN: str = "the seed cannot read as one token: it lexes with the table built from the standard library's declarations (stdlib/core/lex/toolchain.lex)";

/// The symbol of an infix, prefix or postfix `op` with no grammar
/// attribute that the seed's table must lex as one token, or "" when it
/// needs none (a structural symbol, a word, another shape). The table lexes
/// it when `seed_lexes` or the library declares it; otherwise the
/// declaration stops at the seam.
fn unclaimed_symbol(ref s: Snap, d: i64) -> str {
    let pat = op_pattern(s, d);
    let holes = hole_positions(pat);
    if holes.len() > 0 {
        let fix = fixity_of(pat, holes);
        if fix != Fixity::Infix && fix != Fixity::Prefix && fix != Fixity::Postfix { return ""; }
    }
    let sym = strip_holes(pat);
    if sym.len() == 0 || is_structural_symbol(sym) || is_word_text(sym) { return ""; }
    return sym;
}

/// GRAM001, GRAM003 and the seam on the operators the user's attributes
/// declare, in declaration order.
fn check_claims(ref p: Program, var ref sink: DiagSink, ref claims: List<GrammarClaim>, ref library: Map<str, bool>, var ref news: List<NewSymbol>) {
    let s = p.s;
    var seamed = Map<str, bool>();
    var i = 0;
    while i < claims.len() {
        let c = claims[i];
        i = i + 1;
        // GRAM005 already reported a structural symbol or word.
        if is_structural_symbol(c.symbol) || (c.word.len() > 0 && is_structural_symbol(c.word)) { continue; }
        let taken = if is_builtin_spelling(library, c.symbol) { c.symbol } else if c.word.len() > 0 && library.has(c.word) { c.word } else { "" };
        if taken.len() > 0 {
            sink_error(sink, c.decl, "GRAM001", f"`[{c.attr}]` declares `{taken}`, which is already a built-in operator symbol or readable word; a program declares new operators and cannot redefine one");
            continue;
        }
        // The first declaration of the symbol in this position places it;
        // each later one must agree with it.
        var j = 0;
        while j < i - 1 {
            let e = claims[j];
            j = j + 1;
            if e.symbol != c.symbol || e.place != c.place { continue; }
            if e.level != c.level || e.assoc != c.assoc || e.shape != c.shape {
                sink_error(sink, c.decl, "GRAM003", f"`[{c.attr}]` declares the {fixity_text(c.place)} operator `{c.symbol}` at `{c.level}` `{c.assoc}`, but its first declaration gives it `{e.level}` `{e.assoc}` (`[{e.attr}]`); one symbol has one level, associativity and shape in each position");
            }
            break;
        }
        let key = f"{c.decl}";
        if seamed.has(key) { continue; }
        seamed.set(key, true);
        let new_symbol = !is_word_text(c.symbol) && !seed_lexes(c.symbol);
        if new_symbol { add_new_symbol(s, news, c.symbol, c.decl); }
        let why = if new_symbol { NOT_ONE_TOKEN } else { "the seed cannot lower: it lowers only the operators the standard library declares" };
        report_user_op_seam(s, sink, c.decl, c.symbol, why);
    }
}

/// Every operator symbol the program and its declarations declare, in node
/// order, each once: the pieces of each `op` symbol between its holes
/// (`_?_:_` gives `?` and `:`), and the symbol an operator attribute on a
/// `syntax` rule names. Words (`and`), structural tokens and seed words are
/// left out: they lex as names or as the structural tokens themselves.
/// These are the operator tokens of the lexer (PROP-021 slice 21C).
pub fn declared_operator_symbols(ref p: Program) -> List<str> {
    let s = p.s;
    var out: List<str> = [];
    var seen = Map<str, bool>();
    var d = 0;
    while d < s.count {
        let is_op = kind(s, d) == nk_operator();
        if is_op {
            for piece in op_pieces(op_pattern(s, d)) { add_operator_symbol(out, seen, piece); }
        }
        if is_op || is_syntax_rule(s, d) {
            for ga in grammar_attrs() {
                guard some args = prog_attr_nodes(p, d, ga.name) else { continue; }
                if ga.symbol_at >= 0 && ga.symbol_at < args.len() {
                    add_operator_symbol(out, seen, arg_text(s, args[ga.symbol_at]));
                }
            }
        }
        d = d + 1;
    }
    return out;
}

/// The pieces of `op` symbol `pat`: the text between its holes, split at
/// spaces (`_, ..|>` holds several), each trimmed and not empty.
fn op_pieces(pat: str) -> List<str> {
    var out: List<str> = [];
    var last = 0;
    var cuts = hole_positions(pat);
    cuts.push(pat.len());
    for h in cuts {
        var start = last;
        var i = last;
        while i <= h {
            if i == h || pat.byte_at(i) == 32 {
                let piece = pat.slice(start, i).trim();
                if piece.len() > 0 { out.push(piece); }
                start = i + 1;
            }
            i = i + 1;
        }
        last = h + 1;
    }
    return out;
}

fn add_operator_symbol(var ref out: List<str>, var ref seen: Map<str, bool>, piece: str) {
    let sym = piece.trim();
    if sym.len() == 0 || seen.has(sym) || is_structural_symbol(sym) { return; }
    var word = true;
    var i = 0;
    while i < sym.len() {
        if !is_word_byte(sym.byte_at(i) as i64) { word = false; }
        i = i + 1;
    }
    if word { return; }
    seen.set(sym, true);
    out.push(sym);
}

/// The symbols of the postfix operators the program declares: an operator
/// whose pattern is one hole followed by its symbol (`_?`). After one, an
/// operand has ended.
pub fn declared_postfix_symbols(ref p: Program) -> List<str> {
    let s = p.s;
    var out: List<str> = [];
    var seen = Map<str, bool>();
    var d = 0;
    while d < s.count {
        if kind(s, d) == nk_operator() {
            let pat = op_pattern(s, d);
            let holes = hole_positions(pat);
            if holes.len() == 1 && holes[0] == 0 {
                add_operator_symbol(out, seen, pat.slice(1, pat.len()));
            }
        }
        d = d + 1;
    }
    return out;
}
