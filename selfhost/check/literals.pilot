// ==============================================================================
// FILE: selfhost/check/literals.pilot
// Number literals read by the declared number patterns (PROP-021 slices
// 21D and 21F).
// ==============================================================================
// LIT001: a number literal's text must be one number as the patterns of
// stdlib/core/lex/numbers.pilot declare it, then at most a type suffix (a
// type whose [Bits] register is an integer or float one). Today's seed lexer
// still reads `1__000`, `1000_` and `0x_FF` as numbers; the checker reads
// each literal's text with the table built from the declared patterns
// (`NUMBER_TABLE`) and reports any that are not one.
//
// LIT003: a string may hold only the escapes `ESCAPES` declares; any other
// is refused (owner decision 2026-11-16), where the seed kept its bytes.
//
// LIT002: a number literal must fit the type it lands in. An integer's
// value comes from `int_from_text` (stdlib/core/lex/literal_value.pilot),
// at any size, and must lie in the type's range. A float's comes from
// `float_from_text`, every digit kept; it is rounded to the type's IEEE
// format (correctly, stdlib/core/convert/decimal_round.pilot) and refused
// only when it is past the largest finite value (slice 21F). The range and
// the format come from the type's [Bits] width and register class, so no
// type name or width is written here. A literal lands where `assignable`
// checks it (a binding, argument, return, default) or, with no type around
// it, in its literal slot's type.
// ==============================================================================
pub lvl(0) pkg selfhost.check;

use Pilot.Core.Lex.Numbers;
use Pilot.Core.Lex.LiteralValue;
use Pilot.Core.FloatBits;
use pilot.lex.build;

/// The table of the declared number tokens, built once (imp_type.md Rule
/// 13). A structured `comptime` value is built when the program starts
/// (stand-in `ir.comptime_at_start`), so it is built once per check.
const NUMBER_TABLE: LexTable = comptime { build_table(number_tokens()).table };

/// The node under any unary minuses of `e`, and how many there are.
fn under_negation(ref s: Snap, e: i64) -> List<i64> {
    var cur = e;
    var count = 0;
    while cur >= 0 && kind(s, cur) == nk_unary() && flags(s, cur) == 0 {
        cur = lhs(s, cur);
        count = count + 1;
    }
    return [cur, count];
}

/// Where the longest number at the start of `text` ends (0 when none
/// starts there).
fn number_end(ref inf: Infer, text: str) -> i64 {
    let l = match_at(NUMBER_TABLE, text, 0, LexContextKind::Start);
    return if l.decl < 0 { 0 } else { l.end };
}

/// The bit width a type's [Bits] declares, or -1.
fn type_bits(ref p: Program, t: i64) -> i64 {
    if !ty_is_named(p.tt, t) { return -1; }
    for td in nl_get(p.type_decls, p.tt.name[t]) {
        if some bits = prog_attr_nodes(p, td, nameof(Bits)) {
            if bits.len() >= 1 {
                if some w = prog_const(p, bits[0]) { return w; }
            }
        }
    }
    return -1;
}

/// Why expression `e` cannot land in type `dst` (LIT002), or "" when it
/// can, when `e` is no integer literal, or when `dst` is no integer type.
pub fn literal_range_problem(var ref inf: Infer, e: i64, into: i64) -> str {
    let p = inf.p;
    let s = p.s;
    if e < 0 { return ""; }
    let under = under_negation(s, e);
    let core = under[0];
    if core < 0 || (kind(s, core) != nk_int() && kind(s, core) != nk_float()) { return ""; }
    // A literal put in an optional (`u8?`) or a result lands in its payload,
    // the type the destination's `op ?` gives.
    let dst = if is_unwrappable(p, into) { unwrap_type(p, into) } else { into };
    if kind(s, core) == nk_float() { return float_range_problem(inf, e, core, dst); }
    let class = prog_class(p, dst);
    if !is_integer_class(class) { return ""; }
    let bits = type_bits(p, dst);
    if bits <= 0 { return ""; }
    let text = node_text(s, core);
    let end = number_end(inf, text);
    guard some v = int_from_text(text.slice(0, end)) else { return ""; }
    let signed = is_signed_class(class);
    if v.fits(bits, signed, under[1] % 2 == 1) { return ""; }
    let sign_word = if signed { "signed" } else { "unsigned" };
    let shown = node_text(s, e);
    let values = range_text(bits, signed);
    return f"`{shown}` does not fit `{ty_display(p.tt, dst)}`, which holds {values} ({bits}-bit {sign_word})";
}

/// LIT002 for float literal `core` (under `e`'s minuses) landing in `dst`:
/// why it does not fit, or "" when it does or `dst` is no float type. The
/// type's [Bits] width picks its IEEE format; the literal is rounded to it
/// exactly (stdlib/core/convert/decimal_round.pilot), and only a value past
/// the largest finite one is refused (PROP-021 §2.9).
fn float_range_problem(var ref inf: Infer, e: i64, core: i64, dst: i64) -> str {
    let p = inf.p;
    let s = p.s;
    if !is_float_class(prog_class(p, dst)) { return ""; }
    let bits = type_bits(p, dst);
    guard some fmt = format_of_width(bits) else { return ""; };
    let text = node_text(s, core);
    let end = number_end(inf, text);
    guard some v = float_from_text(text.slice(0, end)) else { return ""; };
    if v.encoding(fmt) != none { return ""; }
    let shown = node_text(s, e);
    return f"`{shown}` does not fit `{ty_display(p.tt, dst)}`, whose largest finite value is (2 - 2^-{fmt.fraction_bits}) * 2^{fmt.bias} ({bits}-bit float)";
}

/// LIT002 for comparison `n` (`==` through `>=`) between a number literal
/// and a value of a number type: the literal must fit the other side's
/// type, or the comparison is decided before it runs (`x == 300` for a
/// `u8` `x` is never true). The literal may stand on either side.
pub fn check_compared_literal(var ref inf: Infer, var ref sink: DiagSink, n: i64) {
    let p = inf.p;
    let s = p.s;
    let op = flags(s, n);
    if op < op_eq() || op > op_ge() { return; }
    let sides = [lhs(s, n), rhs(s, n)];
    for i in 0 .. 2 {
        let lit = sides[i];
        let other = sides[1 - i];
        if lit < 0 || other < 0 { continue; }
        let t = type_of(inf, other);
        let problem = literal_range_problem(inf, lit, t);
        if problem != "" { sink_error(sink, lit, "LIT002", f"compared with a `{ty_display(p.tt, t)}`: " + problem); }
    }
}

/// The literal slot type a literal with no type around it lands in: the
/// float one for a float literal (under any minuses), else the integer one.
pub fn default_literal_type(ref p: Program, e: i64) -> i64 {
    let core = under_negation(p.s, e)[0];
    let k = if core >= 0 && kind(p.s, core) == nk_float() { nk_float() } else { nk_int() };
    return prog_slot_type(p, literal_slot(k));
}

/// Whether `word` names a type a number may be suffixed with: one whose
/// [Bits] register is an integer or float one.
fn is_number_suffix(ref p: Program, word: str) -> bool {
    if !p.bits_class.has(word) { return false; }
    let class = p.bits_class.get(word);
    return is_integer_class(class) || is_float_class(class);
}

/// LIT001 for number literal `n` whose text is not one declared number
/// (plus a type suffix).
pub fn check_number_text(var ref inf: Infer, var ref sink: DiagSink, n: i64) {
    let p = inf.p;
    let text = node_text(p.s, n);
    let end = number_end(inf, text);
    // A literal the parser made, spelled by no number in the source.
    if end == 0 || end == text.len() as i64 { return; }
    let rest = text.slice(end, text.len());
    if is_number_suffix(p, rest) { return; }
    let number = text.slice(0, end);
    var why = f"`{text}` is not a number: it reads as the number `{number}` followed by `{rest}`";
    if text.contains(DIGIT_SEPARATOR) {
        why = why + f"; a `{DIGIT_SEPARATOR}` may only stand between two digits (`digits` in stdlib/core/lex/numbers.pilot)";
    }
    sink_error(sink, n, "LIT001", why);
}

/// LIT003 for string node `n`: each escape in its token that `ESCAPES`
/// does not declare (stdlib/core/lex/literal_value.pilot). The token is
/// read from the source, so an f-string's text is checked outside its
/// holes; `seen` holds the tokens already checked, by where they start
/// (a map, so each string is one lookup, not a scan of all before it).
pub fn check_string_escapes(var ref inf: Infer, var ref sink: DiagSink, n: i64, var ref seen: Map<i64, bool>) {
    let s = inf.p.s;
    let at = span_start(s, n);
    if seen.has(at) { return; }
    seen.set(at, true);
    for bad in string_escape_problems(node_text(s, n)) {
        sink_error(sink, n, "LIT003", f"unknown escape `{bad.text}` in a string; the escapes are {escapes_text()}");
    }
}
