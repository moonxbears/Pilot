// ==============================================================================
// FILE: selfhost/check/quote_value.pilot
// `quote { e }` as a value: its tree, its holes, what it may hold, and the
// calls the engines make to build it.
// ==============================================================================
// A quote is checked where it is written, like any code there, and never
// run: its type is `ast<T>` for `T` the type of `e` (infer.pilot
// `quote_type`), and a hole `$x` is a `U` inside it when `x` is an `ast<U>`,
// else a value of `x`'s own type made into its literal (`hole_type`).
//
// The engines build the value with the functions the program binds
// (stdlib/core/primitives/ast.pilot): `quote` decodes the tree this module
// writes (`quote_wire`), each hole in source order is then filled with
// `quote hole`, after making a literal tree of a plain value with the
// `quote lift` function whose parameter takes its type.
//
// Wire: each node in preorder as `kind/length/text/children;`, the length
// that of the text in bytes. The text of a literal, a name or an operator
// is its source text, so the tree keeps what was written (`0x10`, `"a\n"`).
//
// QUOTE001: a construct a quote cannot hold yet (it is never dropped), or a
// program with no function bound to `quote`. QUOTE002: a hole whose value
// is neither an `ast` nor a type some `quote lift` takes. QUOTE003: `$x`
// outside a quote.
//
// The seed reads the calls from the run plan: a `QuoteBuild` row per quote
// `[action, span, kind, decode function, wire]` and a `QuoteHole` row per
// hole `[action, span, kind, fill function, lift function or ""]`. PilIR
// asks this module itself (selfhost/ir/lower_quote.pilot).
// ==============================================================================
pub lvl(0) pkg selfhost.check;


/// What a quote may hold, for QUOTE001.
pub pure fn quote_holds() -> str =>
    "literals, names, operators, calls, members, indexing, lists, tuples, blocks, `let`/`var`, `if`, `return` and assignments";

/// The source text between offsets `a` and `b` of the file node `n` is in,
/// without spaces or the parentheses around operands: the operator written
/// between two operands.
fn text_between(ref s: Snap, n: i64, a: i64, b: i64) -> str {
    let full = node_text(s, n);
    let base = span_start(s, n);
    if a < base || b < a || b - base > full.len() as i64 { return ""; }
    let raw = full.slice(a - base, b - base);
    var out = "";
    var i: i64 = 0;
    while i < raw.len() {
        let c = raw.byte_at(i);
        if c != 32 && c != 9 && c != 10 && c != 13 && c != 40 && c != 41 { out = out + raw.slice(i, i + 1); }
        i = i + 1;
    }
    return out;
}

/// One node of the wire.
fn piece(word: str, text: str, count: i64) -> str => f"{word}/{text.len()}/{text}/{count};";

/// The node kinds on the wire ("str", "let", "if", ..) are wire tags that
/// stdlib/core/primitives/ast.pilot decodes, not Pilot names: they stay
/// string literals on both sides, so the rename litmus leaves them equal.
/// Writes node `n` and its subtree to `out`, listing its holes in `holes`
/// in source order; a node a quote cannot hold goes to `bad` instead.
fn wire_node(ref s: Snap, n: i64, var ref out: List<str>, var ref holes: List<i64>, var ref bad: List<i64>) {
    let k = kind(s, n);
    var word = "";
    var text = "";
    var kids: List<i64> = [];
    if k == nk_ident() && flags(s, n) == 1 {
        holes.push(n);
        out.push(piece("hole", node_name(s, n), 0));
        return;
    }
    if k == nk_expr_stmt() && is_tail(s, n) {
        wire_node(s, lhs(s, n), out, holes, bad);
        return;
    }
    if k == nk_int() || k == nk_float() || k == nk_bool() || k == nk_none() {
        word = if k == nk_int() { "int" } else if k == nk_float() { "float" } else if k == nk_bool() { "bool" } else { "none" };
        text = node_text(s, n);
    } else if k == nk_str() {
        let t = node_text(s, n);
        if t.len() < 2 || t.byte_at(0) != 34 || t.starts_with("\"\"\"") {
            bad.push(n);
            return;
        }
        word = "str";
        text = t.slice(1, t.len() - 1);
    } else if k == nk_ident() {
        word = "name";
        text = node_name(s, n);
    } else if k == nk_type_named() {
        word = "type";
        text = node_text(s, n);
    } else if k == nk_binary() && flags(s, n) != op_pipe() && flags(s, n) != op_pipe_backward() {
        word = "binary";
        text = text_between(s, n, span_end(s, lhs(s, n)), span_start(s, rhs(s, n)));
        kids = [lhs(s, n), rhs(s, n)];
    } else if k == nk_unary() && flags(s, n) != unary_some() && flags(s, n) != unary_splat()
        && flags(s, n) != unary_double_splat() && flags(s, n) != unary_deep_flatten() {
        word = "unary";
        text = text_between(s, n, span_start(s, n), span_start(s, lhs(s, n)));
        kids = [lhs(s, n)];
    } else if k == nk_call() && flags(s, n) == 0 {
        word = "call";
        kids = children(s, n);
    } else if k == nk_member() && lhs(s, n) >= 0 {
        word = "member";
        text = sym_text(s, rhs(s, n));
        kids = [lhs(s, n)];
    } else if k == nk_index() {
        word = "index";
        kids = [lhs(s, n), rhs(s, n)];
    } else if k == nk_list() || k == nk_tuple() || k == nk_block() {
        word = if k == nk_list() { "list" } else if k == nk_tuple() { "tuple" } else { "block" };
        kids = children(s, n);
    } else if k == nk_expr_stmt() && lhs(s, n) >= 0 {
        word = "stmt";
        kids = [lhs(s, n)];
    } else if k == nk_let() || k == nk_var() {
        word = if k == nk_let() { "let" } else { "var" };
        text = if annot(s, n) >= 0 { node_name(s, n) + ": " + node_text(s, annot(s, n)) } else { node_name(s, n) };
        if rhs(s, n) >= 0 { kids = [rhs(s, n)]; }
    } else if k == nk_if() {
        word = "if";
        kids = children(s, n);
    } else if k == nk_return() {
        word = "return";
        if lhs(s, n) >= 0 { kids = [lhs(s, n)]; }
    } else if k == nk_assign() {
        word = "assign";
        text = text_between(s, n, span_end(s, lhs(s, n)), span_start(s, rhs(s, n)));
        kids = [lhs(s, n), rhs(s, n)];
    } else {
        bad.push(n);
        return;
    }
    for c in kids {
        if c < 0 || kind(s, c) == nk_call_arg() {
            bad.push(if c < 0 { n } else { c });
            return;
        }
    }
    out.push(piece(word, text, kids.len() as i64));
    for c in kids { wire_node(s, c, out, holes, bad); }
}

/// The wire of quote `q`; its holes go to `holes`, a node it cannot hold
/// to `bad`.
pub fn quote_wire(ref s: Snap, q: i64, var ref holes: List<i64>, var ref bad: List<i64>) -> str {
    var out: List<str> = [];
    let root = quoted_root(s, q);
    if root < 0 {
        bad.push(q);
        return "";
    }
    wire_node(s, root, out, holes, bad);
    var text = "";
    for x in out { text = text + x; }
    return text;
}

/// The function that makes the literal tree of a value of type `t`, or -1.
pub fn lift_fn(var ref p: Program, t: i64) -> i64 {
    if !ty_is_named(p.tt, t) { return -1; }
    for f in bound_fns(p, quote_lift_symbol()) {
        let params = fn_params(p.s, f);
        if params.len() > 0 {
            let pt = prog_annot_type(p, rhs(p.s, params[0]));
            if ty_is_named(p.tt, pt) && ty_decl(p.tt, pt) == ty_decl(p.tt, t) { return f; }
        }
    }
    return -1;
}

/// The type of the value hole `h` splices (the type of `x` in `$x`).
fn hole_value_type(var ref inf: Infer, h: i64) -> i64 {
    let b = inf.r.ref_of[h];
    return if b >= 0 { binding_type(inf, b) } else { ty_unknown() };
}

/// How a hole is spliced: the function that fills it, and the one that
/// makes its value a literal tree first (-1 when the value is a tree).
pub type HoleFns = (i64, i64);
/// `HoleFns` as the names the run plan carries ("" for no lift).
pub type HoleCalls = (str, str);

/// How hole `h` is spliced, or none when it cannot be.
pub fn hole_fns(var ref inf: Infer, h: i64) -> HoleFns? {
    let p = inf.p;
    let fills = bound_fns(p, quote_hole_symbol());
    if fills.len() == 0 { return none; }
    let t = hole_value_type(inf, h);
    let lift = if is_quote_type(p, t) { -1 } else { lift_fn(p, t) };
    if lift < 0 && !is_quote_type(p, t) { return none; }
    return (fills[0], lift);
}

/// `hole_fns` as the names the run plan carries, or none.
pub fn hole_calls(var ref inf: Infer, h: i64) -> HoleCalls? {
    guard some f = hole_fns(inf, h) else { return none; };
    return (node_name(inf.p.s, f.0), if f.1 < 0 { "" } else { node_name(inf.p.s, f.1) });
}

/// Whether the program binds `name` to an engine function
/// (`bind_native_fn`, stdlib/core/builtins/native_calls.pilot).
fn is_native_name(var ref p: Program, name: str) -> bool {
    for row in prog_engine_bindings(p) {
        if row.hook == "bind_native_fn" && row.args.len() >= 1 && row.args[0] == name { return true; }
    }
    return false;
}

/// The innermost quote around node `n`, or -1.
pub fn enclosing_quote(ref p: Program, n: i64) -> i64 {
    var cur = p.parents[n];
    while cur >= 0 {
        if kind(p.s, cur) == nk_quote() { return cur; }
        cur = p.parents[cur];
    }
    return -1;
}

/// Whether node `n` is part of the program: a `syntax` rule's expansion
/// copies the code its holes read, and the code read stays in the tree
/// unattached.
fn in_program(ref p: Program, n: i64) -> bool {
    var cur = n;
    while p.parents[cur] >= 0 { cur = p.parents[cur]; }
    return cur != n && kind(p.s, cur) == nk_program();
}

/// Whether quote node `q` is a quote value, not a `syntax` rule's template
/// (which the parser expands where the rule is used; flags 1).
pub fn is_quote_value(ref s: Snap, q: i64) -> bool => kind(s, q) == nk_quote() && flags(s, q) == 0;

/// QUOTE001-003 for the quotes and holes of the user's files.
pub fn check_quotes(var ref inf: Infer, var ref sink: DiagSink) {
    let p = inf.p;
    let s = p.s;
    // DECL001 below needs a quote value around the name: none in the
    // program, no ancestor walk.
    var any_value = false;
    for q in prog_nodes_of_kind(p, nk_quote()) {
        if is_quote_value(s, q) {
            any_value = true;
            break;
        }
    }
    var n = s.user_lo;
    while n < s.user_hi {
        if in_user_file(s, n) && is_quote_value(s, n) {
            var holes: List<i64> = [];
            var bad: List<i64> = [];
            quote_wire(s, n, holes, bad);
            if quote_fn(p) < 0 {
                sink_error(sink, n, "QUOTE001", "no function is bound to `quote`, so a quote cannot be a value");
            } else if bad.len() > 0 {
                sink_error(sink, bad[0], "QUOTE001", f"a quote cannot hold this construct yet; it holds {quote_holds()}");
            }
            for h in holes {
                let t = hole_value_type(inf, h);
                if !ty_is_unknown(p.tt, t) && hole_calls(inf, h) == none {
                    sink_error(sink, h, "QUOTE002", f"cannot splice `{ty_display(p.tt, t)}` into a quote: a hole takes an `ast`, an integer, a float, a bool or a string");
                }
            }
        }
        // The engines never compile a quote's code, so the names it uses
        // are checked here: a binding in scope, a function, a constant or
        // a type.
        if any_value && in_user_file(s, n) && kind(s, n) == nk_ident() && flags(s, n) == 0 && inf.r.ref_of[n] < 0 {
            let q = enclosing_quote(p, n);
            if q >= 0 && is_quote_value(s, q) {
                let name = node_name(s, n);
                if nl_get(p.fns, name).len() == 0 && global_const(inf, n) < 0 && prog_type_decl(p, name) < 0 && !is_native_name(p, name) {
                    sink_error(sink, n, "DECL001", f"undefined name `{name}`");
                }
            }
        }
        if in_user_file(s, n) && kind(s, n) == nk_ident() && flags(s, n) == 1 && in_program(p, n) && enclosing_quote(p, n) < 0 {
            sink_error(sink, n, "QUOTE003", f"`${node_name(s, n)}` splices into a quote, and is not inside one");
        }
        n = n + 1;
    }
}

/// A `QuoteBuild` row for each quote of the files the program links that
/// can be built, and a `QuoteHole` row for each of its holes.
pub fn plan_quotes(var ref inf: Infer, var ref rows: List<DropRow>) {
    let p = inf.p;
    let s = p.s;
    let decode = quote_fn(p);
    if decode < 0 { return; }
    for q in prog_nodes_of_kind(p, nk_quote()) {
        if in_linked_file(s, q) && is_quote_value(s, q) {
            var holes: List<i64> = [];
            var bad: List<i64> = [];
            let wire = quote_wire(s, q, holes, bad);
            var ok = bad.len() == 0;
            var calls: List<HoleCalls> = [];
            for h in holes {
                if some c = hole_calls(inf, h) { calls.push(c); } else { ok = false; }
            }
            if ok {
                rows.push((DropAction::QuoteBuild as i64, span_start(s, q), span_end(s, q), kind(s, q), node_name(s, decode), wire));
                var i = 0;
                while i < holes.len() {
                    let h = holes[i];
                    rows.push((DropAction::QuoteHole as i64, span_start(s, h), span_end(s, h), kind(s, h), calls[i].0, calls[i].1));
                    i = i + 1;
                }
            }
        }
    }
}
