// ==============================================================================
// FILE: selfhost/check/methods.pilot
// Method tables, layout plans and lattice bits of the program's types.
// ==============================================================================
// For each type the checker meets it builds, once:
//   - its method table (selfhost/types/method_table.pilot), from its own
//     `struct`/`interface` members (tier 1), the members of the `*Bundle`
//     and `*Facet` types it splices, after `with`/`without` (tier 2), the
//     default members of the interfaces it names directly (tier 3) and of
//     the interfaces those reach (tier 4), and its `ext` members (tier 5);
//   - its layout plan (selfhost/types/bundle_splice.pilot), from its own
//     fields and the fields of its splices after `coalesce`/`with`/`without`;
//     the plan gives the fields the type exposes and their lattice bits;
//   - its lattice bits: the bits of the `[Lattice(..)]` interfaces it
//     reaches when it names any (its fields and `~self()` are checked
//     against them, COMP005), otherwise the bits its fields and `~self()`
//     give it (the plan's `computed_lattice`).
// The libraries' collision and lattice findings (COMP001-COMP007) are
// reported on the type's declaration when it is in a user file.
//
// A built member keeps its declaration and the generic arguments that apply
// to its signature, written in terms of the type's own generic parameters;
// a lookup on `T<args>` substitutes `args` for them.
pub lvl(0) pkg selfhost.check;

use selfhost.types.*;

/// Everything built for one type name.
pub struct BuiltType {
    pub name: str;
    /// The declaration that introduces the type's generic parameters.
    pub decl: i64;
    pub tparams: List<str>;
    pub table: MethodTable;
    pub plan: StructLayoutPlan;
    /// Member names registered in `table`, in registration order.
    pub names: List<str>;
    /// `name@origin` -> index into `found`.
    pub sides: Map<str, i64>;
    pub found: List<Member>;
    /// Exposed field name -> index into `found`.
    pub fields: Map<str, i64>;
    /// Members interfaces declare without a body, by name -> `found` index;
    /// they type a call when no table entry does.
    pub requires: Map<str, i64>;
    pub require_names: List<str>;
    /// Whether every splice and base resolved to a declaration.
    pub complete: bool;
    /// Lattice bits: the declared ones, or those of its fields and `~self()`.
    pub lattice: i64;
    pub declared: i64;
    pub declares_lattice: bool;
    /// Fields of the type itself and of its splices, for bundle catalogs.
    pub own_fields: List<BundleFieldDef>;
    pub own_methods: List<BundleMethodDef>;
    /// Body node per `own_methods` entry: its `accessed_fields` are filled
    /// only when a splice reads the catalog.
    pub own_method_bodies: List<i64>;
    /// The type's own field members, by name -> `found` index.
    pub field_decls: Map<str, i64>;
    /// The types it splices, in order.
    pub spliced: List<str>;
    /// `Bundle.method` -> `found` index: every method of every splice, the
    /// ones `without` hides and `with .. as` renames included, for static
    /// delegation `Bundle.method(var ref self, ..)`.
    pub delegates: Map<str, i64>;
    /// `(bundle name, splice node)` per splice written in a `partial`
    /// declaration, where a finding about that splice is reported.
    pub partial_splices: List<(str, i64)>;
    /// `Bundle.member` -> the name a splice's `with { member as name }`
    /// gives that member in this type, for the splices it writes and the
    /// ones those splice in turn; `alias_keys` lists the keys.
    pub aliases: Map<str, str>;
    pub alias_keys: List<str>;
}

fn is_method_kind(k: i64) -> bool => k == nk_fn() || k == nk_operator() || k == nk_indexer();

fn member_name(ref s: Snap, m: i64) -> str => if kind(s, m) == nk_indexer() { "[]" } else { node_name(s, m) };

fn is_field(ref s: Snap, m: i64) -> bool {
    let k = kind(s, m);
    return k == nk_param() || ((k == nk_let() || k == nk_var()) && annot(s, m) >= 0);
}

fn field_type_node(ref s: Snap, m: i64) -> i64 => if kind(s, m) == nk_param() { rhs(s, m) } else { annot(s, m) };

/// The generic arguments that stand for a type's own parameters.
fn own_args(var ref p: Program, decl: i64, ref names: List<str>) -> List<i64> {
    var out: List<i64> = [];
    for n in names { out.push(ty_param(p.tt, decl, n)); }
    return out;
}

fn generic_decl(ref p: Program, name: str) -> i64 {
    for d in nl_get(p.type_decls, name) {
        if prog_tparam_names(p, d).len() > 0 { return d; }
    }
    return prog_type_decl(p, name);
}

// `return_type` and `params` are left empty: nothing reads them, and the
// member itself (`Member.decl`) carries the signature.
fn entry_for(name: str, tier: MemberTier, origin: str) -> MethodTableEntry {
    return MethodTableEntry {
        method_name: name,
        tier: tier,
        origin_type_name: origin,
        return_type: "",
        params: "",
        is_mut: false,
        is_static: false,
        field_remap_bundle: "",
        clearance_lvl: 0,
        visibility: 0,
    };
}

fn add_found(var ref bt: BuiltType, m: Member) -> i64 {
    bt.found.push(m);
    return (bt.found.len() as i64) - 1;
}

/// Registers member `m` under `name` at `tier`, with origin `origin`.
fn register(var ref bt: BuiltType, name: str, tier: MemberTier, origin: str, m: Member, excluded: bool) {
    var mt = bt.table;
    register_method(var mt, entry_for(name, tier, origin), excluded);
    if excluded { return; }
    let key = name + "@" + origin;
    if !bt.sides.has(key) { bt.sides.set(key, add_found(bt, m)); }
    var seen = false;
    for n in bt.names {
        if n == name {
            seen = true;
            break;
        }
    }
    if !seen { bt.names.push(name); }
}

/// The member a type `sub` built for `name`, with its generic arguments
/// rewritten from `sub`'s parameters to the arguments `st` gives them.
fn compose(var ref p: Program, ref sub: BuiltType, ref m: Member, st: i64) -> Member {
    var values: List<i64> = [];
    for v in m.values { values.push(ty_subst(p.tt, v, sub.tparams, ty_args(p.tt, st))); }
    return Member { decl: m.decl, names: m.names, values: values };
}

/// The winning member of `sub` for `name`, or none.
fn winner(ref sub: BuiltType, name: str) -> Member? {
    if !sub.table.methods.has(name) { return none; }
    let e: MethodTableEntry = sub.table.methods[name];
    let key = name + "@" + e.origin_type_name;
    if !sub.sides.has(key) { return none; }
    return sub.found[sub.sides.get(key)];
}

/// The splice modifiers listed for splice node `u`: `(sub-slot, member,
/// alias)` rows.
fn splice_rows(ref s: Snap, u: i64) -> List<(i64, str, str)> {
    var out: List<(i64, str, str)> = [];
    for row in s.splice_mods {
        if row[0] == u {
            let alias = if row[3] > 0 { sym_text(s, row[3]) } else { "" };
            out.push((row[1], sym_text(s, row[2]), alias));
        }
    }
    return out;
}

fn directive_for(ref s: Snap, u: i64, bundle: str) -> BundleSpliceDirective {
    var d = bundle_splice_directive_new(bundle);
    for r in splice_rows(s, u) {
        let sub = r.0;
        let member = r.1;
        let alias = r.2;
        if sub == splice_coalesce() { d.coalesce_fields.push(member); }
        if sub == splice_without() { d.without_items.push(member); }
        if sub == splice_with() && alias.len() > 0 {
            d.with_aliases[member] = alias;
            d.with_names.push(member);
        }
    }
    return d;
}

fn listed(ref items: List<str>, name: str) -> bool {
    for i in items { if i == name { return true; } }
    return false;
}

/// The bytes a value of a type takes and the byte boundary it is placed on.
pub struct TypeExtent : IValue {
    pub size: usize;
    pub align: usize;
}

/// The extent of type `t`, or `none` when the checker does not know it (a
/// generic parameter, an interface, an enum, or a struct with such a field).
/// A `[Bits(width, ..)]` type takes `ceil(width / 8)` bytes and is aligned to
/// that size rounded up to a power of two (the natural alignment C gives a
/// scalar on the 64-bit targets: a 1-bit `bool` takes 1 byte, a 128-bit
/// integer 16). A struct takes its layout plan's size and alignment.
pub fn type_extent(var ref p: Program, t: i64, depth: i64) -> TypeExtent? {
    if !ty_is_named(p.tt, t) { return none; }
    let d = ty_decl(p.tt, t);
    let name = node_name(p.s, d);
    for decl in nl_get(p.type_decls, name) {
        if some args = prog_attr_nodes(p, decl, nameof(Bits)) {
            if args.len() > 0 {
                if some bits = prog_const(p, args[0]) {
                    let size = ((bits + 7) / 8) as usize;
                    var align: usize = 1;
                    while align < size { align = align * 2; }
                    return TypeExtent { size: size, align: align };
                }
            }
        }
    }
    if kind(p.s, d) != nk_struct() || depth > 8 { return none; }
    let bt = build_type(p, name, depth + 1);
    for f in bt.own_fields {
        if f.byte_align == 0 { return none; }
    }
    return TypeExtent { size: bt.plan.total_size, align: bt.plan.alignment };
}

/// Bytes a value of type `t` takes as a field; 0 when not known.
[StandIn("check.field_size", "the byte size of every field type", "fields of a generic parameter, interface or enum type count 0 bytes", "F5")]
fn byte_size(var ref p: Program, t: i64, depth: i64) -> usize {
    guard some e = type_extent(p, t, depth) else { return 0; }
    return e.size;
}

/// The byte boundary a field of type `t` is placed on; 0 when not known.
fn byte_align(var ref p: Program, t: i64, depth: i64) -> usize {
    guard some e = type_extent(p, t, depth) else { return 0; }
    return e.align;
}

/// The lattice bits of type `t` (0 when it is not derived).
pub fn lattice_of(var ref p: Program, t: i64) -> i64 {
    if ty_is_union(p.tt, t) {
        // A union holds any one of its members: the bits of all of them.
        var bits = 0;
        for m in ty_args(p.tt, t) { bits = bits | lattice_of(p, m); }
        return bits;
    }
    if !ty_is_named(p.tt, t) { return 0; }
    return build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0).lattice;
}

/// The lattice bits a field adds to its struct: a `ref` field borrows what it
/// holds (the bits of the reference root, `Cfg.Lang.ref_t`), any other field
/// adds the bits of its type.
fn field_lattice(var ref p: Program, m: i64, t: i64) -> i64 {
    if kind(p.s, m) == nk_param() && flags(p.s, m) != 0 {
        let bits = lattice_attr(p, prog_slot_name(p, "ref_t"));
        if bits >= 0 { return bits; }
    }
    return lattice_of(p, t);
}

/// The bits the `[Lattice(..)]` attribute of interface `name` declares, or -1.
fn lattice_attr(var ref p: Program, name: str) -> i64 {
    for d in nl_get(p.type_decls, name) {
        if some args = prog_attr_nodes(p, d, nameof(Lattice)) {
            if args.len() > 0 {
                if some bits = prog_const(p, args[0]) { return bits; }
            }
        }
    }
    return -1;
}

/// Accessed fields of a bundle method: members read through the receiver
/// (`.x`, or a name no local binds, such as the receiver itself).
fn accessed_fields(ref s: Snap, n: i64, var ref out: List<str>, depth: i64) {
    if n < 0 || depth > 64 { return; }
    if kind(s, n) == nk_member() {
        let recv = lhs(s, n);
        if flags(s, n) == member_implied() || (recv >= 0 && kind(s, recv) == nk_ident()) {
            out.push(sym_text(s, rhs(s, n)));
        }
    }
    for c in children(s, n) { accessed_fields(s, c, out, depth + 1); }
}

fn empty_built(ref p: Program, name: str) -> BuiltType {
    let decl = generic_decl(p, name);
    let tparams = if decl >= 0 { prog_tparam_names(p, decl) } else { [] };
    return BuiltType {
        name: name,
        decl: decl,
        tparams: tparams,
        table: method_table_new(name),
        plan: struct_layout_plan_new(name, false, 0),
        names: [],
        sides: Map<str, i64>(),
        found: [],
        fields: Map<str, i64>(),
        requires: Map<str, i64>(),
        require_names: [],
        complete: true,
        lattice: 0,
        declared: 0,
        declares_lattice: false,
        own_fields: [],
        own_methods: [],
        own_method_bodies: [],
        field_decls: Map<str, i64>(),
        spliced: [],
        delegates: Map<str, i64>(),
        partial_splices: [],
        aliases: Map<str, str>(),
        alias_keys: [],
    };
}

/// The built type of `name`, building it on first use.
pub fn build_type(var ref p: Program, name: str, depth: i64) -> BuiltType {
    if p.built_index.has(name) { return p.built[p.built_index.get(name)]; }
    let bt = empty_built(p, name);
    // Registered before its parts are built, so a cycle ends here.
    p.built_index.set(name, p.built.len() as i64);
    p.built.push(bt);
    if bt.decl < 0 || depth > 12 { return bt; }
    let s = p.s;
    let args = own_args(p, bt.decl, bt.tparams);
    var primary: List<BundleFieldDef> = [];
    var directives: List<BundleSpliceDirective> = [];
    var catalog: Map<str, BundleDef> = [:];
    var has_dtor = false;
    var splices: List<i64> = [];
    // Whether each splice is written in a `partial` declaration.
    var splice_in_partial: List<bool> = [];

    // Tier 1: the type's own members.
    for d in nl_get(p.type_decls, name) {
        for m in type_members(s, d) {
            let k = kind(s, m);
            let member = Member { decl: m, names: bt.tparams, values: args };
            if k == nk_dtor() { has_dtor = true; }
            if k == nk_scope() {
                // Parsed, but nothing runs its clauses: stop, not skip.
                let _ = seam("lifecycle.scope_self", f"`{name}` declares a `scope` block, whose enter and exit clauses are not run yet: which block enters a value of the type is not decided");
            }
            if is_method_kind(k) {
                let mname = member_name(s, m);
                if kind(s, d) == nk_interface() && fn_body(s, m) < 0 {
                    if !bt.requires.has(mname) {
                        bt.requires.set(mname, add_found(bt, member));
                        bt.require_names.push(mname);
                    }
                } else {
                    register(bt, mname, MemberTier::Tier1ExplicitStruct, name, member, false);
                    bt.own_methods.push(BundleMethodDef { name: mname, return_type: "", params: "", is_mut: false, accessed_fields: [] });
                    bt.own_method_bodies.push(fn_body(s, m));
                }
            } else if is_field(s, m) {
                let fname = node_name(s, m);
                if is_static_decl(s, m) {
                    let fidx = add_found(bt, member);
                    bt.field_decls.set(fname, fidx);
                    bt.fields.set(fname, fidx);
                } else {
                    let ft = prog_annot_type(p, field_type_node(s, m));
                    let fdef = BundleFieldDef {
                        name: fname,
                        type_name: node_text(s, field_type_node(s, m)),
                        layout_id: 0,
                        byte_size: byte_size(p, ft, depth),
                        byte_align: byte_align(p, ft, depth),
                        lattice_bits: field_lattice(p, m, ft) as u8,
                        is_mutable: kind(s, m) == nk_var(),
                    };
                    primary.push(fdef);
                    bt.own_fields.push(fdef);
                    bt.field_decls.set(fname, add_found(bt, member));
                }
            } else if k == nk_expr_stmt() {
                let u = lhs(s, m);
                if u >= 0 && kind(s, u) == nk_unary() && flags(s, u) == unary_splat() && lhs(s, u) >= 0 {
                    splices.push(u);
                    splice_in_partial.push(is_partial_decl(s, d));
                }
            }
        }
    }

    // Tier 2: members of the spliced bundles and facets.
    var si = 0;
    while si < splices.len() {
        let u = splices[si];
        let in_partial = splice_in_partial[si];
        si = si + 1;
        let st = prog_annot_type(p, lhs(s, u));
        if !ty_is_named(p.tt, st) { bt.complete = false; continue; }
        let bname = node_name(s, ty_decl(p.tt, st));
        let sub = build_type(p, bname, depth + 1);
        if !sub.complete { bt.complete = false; }
        var dir = directive_for(s, u, bname);
        dir.from_partial = in_partial;
        if in_partial { bt.partial_splices.push((bname, u)); }
        bt.spliced.push(bname);
        for old_name in dir.with_names { note_alias(bt, bname + "." + old_name, dir.with_aliases[old_name]); }
        for k in sub.alias_keys {
            let inner = sub.aliases[k];
            note_alias(bt, k, if dir.with_aliases.has(inner) { dir.with_aliases[inner] } else { inner });
        }
        for mname in sub.names {
            if some m = winner(sub, mname) {
                let key = bname + "." + mname;
                if !bt.delegates.has(key) { bt.delegates.set(key, add_found(bt, compose(p, sub, m, st))); }
                let exposed = if dir.with_aliases.has(mname) { dir.with_aliases[mname] } else { mname };
                if exposed != mname {
                    // Delegation names the member by its own name, not its alias.
                    var mt = bt.table;
                    register_method(var mt, entry_for(mname, MemberTier::Tier2SplicedBundleFacet, bname), true);
                }
                register(bt, exposed, MemberTier::Tier2SplicedBundleFacet, bname, compose(p, sub, m, st),
                    listed(dir.without_items, mname));
            }
        }
        var bdef = bundle_def_new(bname, sub.own_fields.len() == 0);
        for f in sub.own_fields { bdef.fields.push(f); }
        var mi = 0;
        for bm in sub.own_methods {
            var used: List<str> = [];
            accessed_fields(s, sub.own_method_bodies[mi], used, 0);
            mi = mi + 1;
            bdef.methods.push(BundleMethodDef { name: bm.name, return_type: "", params: "", is_mut: false, accessed_fields: used });
        }
        catalog[bname] = bdef;
        directives.push(dir);
        // The fields the splice exposes, under their exposed names.
        for f in sub.own_fields {
            if !listed(dir.without_items, f.name) {
                let exposed = if dir.with_aliases.has(f.name) { dir.with_aliases[f.name] } else { f.name };
                if !bt.fields.has(exposed) && sub.field_decls.has(f.name) {
                    bt.fields.set(exposed, add_found(bt, compose(p, sub, sub.found[sub.field_decls.get(f.name)], st)));
                }
            }
        }
    }
    for f in bt.own_fields {
        if bt.field_decls.has(f.name) { bt.fields.set(f.name, bt.field_decls[f.name]); }
    }

    // Tiers 3 and 4: default members of the interfaces it implements.
    for b in nl_get(p.bases, name) {
        let it = prog_annot_type(p, b);
        if !ty_is_named(p.tt, it) { bt.complete = false; continue; }
        let iname = node_name(s, ty_decl(p.tt, it));
        let sub = build_type(p, iname, depth + 1);
        if !sub.complete { bt.complete = false; }
        for mname in sub.names {
            if some m = winner(sub, mname) {
                let e: MethodTableEntry = sub.table.methods[mname];
                let tier = if e.tier == MemberTier::Tier1ExplicitStruct { MemberTier::Tier3SubInterfaceDefault } else { MemberTier::Tier4BaseInterfaceDefault };
                register(bt, mname, tier, e.origin_type_name, compose(p, sub, m, it), false);
            }
        }
        for rname in sub.require_names {
            if !bt.requires.has(rname) {
                bt.requires.set(rname, add_found(bt, compose(p, sub, sub.found[sub.requires.get(rname)], it)));
                bt.require_names.push(rname);
            }
        }
        let bits = lattice_attr(p, iname);
        if bits >= 0 { bt.declared = bt.declared | bits; bt.declares_lattice = true; }
        if sub.declares_lattice { bt.declared = bt.declared | sub.declared; bt.declares_lattice = true; }
    }
    let own_bits = lattice_attr(p, name);
    if own_bits >= 0 { bt.declared = bt.declared | own_bits; bt.declares_lattice = true; }

    // Tier 5: `ext` members.
    let ext_prefix = name + ".";
    for d in nl_get(p.ext_decls, name) {
        for m in type_members(s, d) {
            if is_method_kind(kind(s, m)) {
                register(bt, member_name(s, m), MemberTier::Tier5ScopedExtension, ext_prefix + nameof(ext),
                    Member { decl: m, names: bt.tparams, values: args }, false);
            }
        }
    }
    for f in nl_get(p.dotted_fns, name) {
        let full = node_name(s, f);
        register(bt, full.slice(ext_prefix.len(), full.len()), MemberTier::Tier5ScopedExtension, ext_prefix + nameof(ext),
            Member { decl: f, names: bt.tparams, values: args }, false);
    }

    // Layout plan and lattice bits.
    var plan = if bt.declares_lattice {
        struct_layout_plan_new(name, false, bt.declared as u8)
    } else {
        struct_layout_plan_undeclared(name, false)
    };
    plan.explicit_dtor = has_dtor;
    compute_struct_layout(var plan, primary, directives, catalog);
    bt.plan = plan;
    // A type that declares a lattice is classified by its declaration; the
    // plan checks its fields and destructor against it (COMP005). One that
    // declares none takes the bits its fields and destructor give it.
    bt.lattice = if bt.declares_lattice { bt.declared } else { plan.computed_lattice as i64 };
    p.built[p.built_index.get(name)] = bt;
    return bt;
}

// ------------------------------------------------------------------------------
// Lookups used by inference and the rules
// ------------------------------------------------------------------------------

fn instantiate(var ref p: Program, ref bt: BuiltType, ref m: Member, t: i64) -> Member {
    // `ty_subst` with no type parameters gives each value back.
    if bt.tparams.len() == 0 { return m; }
    var values: List<i64> = [];
    for v in m.values { values.push(ty_subst(p.tt, v, bt.tparams, ty_args(p.tt, t))); }
    return Member { decl: m.decl, names: m.names, values: values };
}

/// The member `member` of type `t`: a field it exposes, the winner of its
/// method table, or a member an interface it implements requires. None when
/// `t` is not a named type or has no such member.
pub fn prog_member(var ref p: Program, t: i64, member: str) -> Member? {
    if !ty_is_named(p.tt, t) { return none; }
    let bt = build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0);
    if bt.fields.has(member) { return instantiate(p, bt, bt.found[bt.fields.get(member)], t); }
    if some m = winner(bt, member) { return instantiate(p, bt, m, t); }
    if bt.requires.has(member) { return instantiate(p, bt, bt.found[bt.requires.get(member)], t); }
    return none;
}

fn note_alias(var ref bt: BuiltType, key: str, name: str) {
    if !bt.aliases.has(key) { bt.alias_keys.push(key); }
    bt.aliases.set(key, name);
}

/// The name member `member` of the splice `bundle` has in type `t`: the
/// alias `t` gives it (`*Bundle with { member as alias }`), else `member`.
pub fn prog_spliced_name(var ref p: Program, t: i64, bundle: str, member: str) -> str {
    if !ty_is_named(p.tt, t) { return member; }
    let bt = build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0);
    let key = bundle + "." + member;
    return if bt.aliases.has(key) { bt.aliases.get(key) } else { member };
}

/// The method declaration that `type_name.method_name` overrides from a spliced
/// bundle/facet or a base interface, or -1 if none exists.
pub fn prog_overridden_member(var ref p: Program, type_name: str, method_name: str) -> i64 {
    let s = p.s;
    let bt = build_type(p, type_name, 0);
    for bname in bt.spliced {
        let sub = build_type(p, bname, 0);
        if some m = winner(sub, method_name) { return m.decl; }
    }
    for b in nl_get(p.bases, type_name) {
        let it = prog_annot_type(p, b);
        if !ty_is_named(p.tt, it) { continue; }
        let iname = node_name(s, ty_decl(p.tt, it));
        let sub = build_type(p, iname, 0);
        if some m = winner(sub, method_name) { return m.decl; }
    }
    return -1;
}

/// Whether type `t` splices the type named `bundle`.
pub fn prog_splices(var ref p: Program, t: i64, bundle: str) -> bool {
    if !ty_is_named(p.tt, t) { return false; }
    return listed(build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0).spliced, bundle);
}

/// The method `Bundle.method(receiver, ..)` delegates to when the receiver's
/// type `t` splices `bundle`: that splice's own `method`, even when `t` hides
/// it with `without` or renames it with `with .. as`. None when `t` does not
/// splice `bundle` or the splice has no such method.
pub fn prog_delegate(var ref p: Program, t: i64, bundle: str, method: str) -> Member? {
    if !ty_is_named(p.tt, t) { return none; }
    let bt = build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0);
    guard some _e = resolve_static_delegation(bt.table, bundle, method) else { return none; };
    let key = bundle + "." + method;
    if !bt.delegates.has(key) { return none; }
    return instantiate(p, bt, bt.found[bt.delegates.get(key)], t);
}

/// Whether type `name` has `member` itself: a field or property it exposes,
/// or a method its table resolves (its own, a splice's, an interface
/// default or an extension). None while its table is incomplete.
pub fn type_provides(var ref p: Program, name: str, member: str) -> bool? {
    let bt = build_type(p, name, 0);
    if !bt.complete { return none; }
    if bt.fields.has(member) { return true; }
    if some _m = winner(bt, member) { return true; }
    return false;
}

/// Whether `t` splices a bundle that declares `name`, and `t` itself hides
/// or renames `name` (`without { name }` or `with { name as ... }`) without
/// providing a replacement of that name.
pub fn prog_has_hidden_splice_member(var ref p: Program, t: i64, name: str) -> bool {
    if !ty_is_named(p.tt, t) { return false; }
    let bt = build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0);
    if bt.spliced.len() == 0 { return false; }
    if some _m = prog_member(p, t, name) { return false; }
    for bundle in bt.spliced {
        if some has = type_provides(p, bundle, name) {
            if has { return true; }
        }
    }
    return false;
}

/// Whether the member lookup on `t` is complete: every splice and base of
/// the type and its parts resolved to a declaration. When it is not, a
/// missing member may still exist and must not be reported.
pub fn prog_members_complete(var ref p: Program, t: i64) -> bool {
    if !ty_is_named(p.tt, t) { return false; }
    return build_type(p, node_name(p.s, ty_decl(p.tt, t)), 0).complete;
}

/// Whether values of `t` are owned (lattice bit 1): moving one ends the
/// source binding's use.
pub fn prog_is_owned(var ref p: Program, t: i64) -> bool => (lattice_of(p, t) & 2) != 0;

/// The code of a library finding (`COMP004: ...` -> `COMP004`).
fn finding_code(msg: str) -> str {
    let colon = msg.find(":", 0);
    return if colon > 0 { msg.slice(0, colon) } else { msg };
}

/// The text of a library finding after its code (`COMP004: text` -> `text`).
fn finding_text(msg: str) -> str {
    let colon = msg.find(": ", 0);
    return if colon > 0 { msg.slice(colon + 2, msg.len()) } else { msg };
}

/// Where a layout finding is reported: the `partial` splice it quotes
/// (`'Bundle'`), else the type's declaration `decl`.
fn finding_site(ref bt: BuiltType, msg: str, decl: i64) -> i64 {
    for row in bt.partial_splices {
        if msg.find("'" + row.0 + "'", 0) >= 0 { return row.1; }
    }
    return decl;
}

/// Reports the method-table and layout findings of every type declared in
/// a user file, on its first declaration there.
pub fn check_type_tables(var ref p: Program, var ref sink: DiagSink) {
    let s = p.s;
    var done = Map<str, i64>();
    var i = 0;
    i = s.user_lo;
    while i < s.user_hi {
        let k = kind(s, i);
        if (k == nk_struct() || k == nk_interface()) && in_user_file(s, i) {
            let name = node_name(s, i);
            if !done.has(name) {
                done.set(name, i);
                let bt = build_type(p, name, 0);
                for msg in bt.table.diagnostics { sink_error(sink, i, finding_code(msg), finding_text(msg)); }
                for msg in bt.plan.diagnostics { sink_error(sink, finding_site(bt, msg, i), finding_code(msg), finding_text(msg)); }
            }
        }
        i = i + 1;
    }
}
