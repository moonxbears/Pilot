// ==============================================================================
// FILE: selfhost/check/main.pilot
// Entry point of the type checker (`pilot check`, `pilot run`).
// ==============================================================================
// Reads the linked program, indexes its declarations, resolves names, infers
// types and applies the rules. Returns the diagnostics as rows for
// crates/pilot-cli/src/check.rs.
pub lvl(0) pkg Pilot.SelfHost.Check.Main;

use selfhost.check.snapshot.*;
use selfhost.check.program.*;
use selfhost.check.resolve.*;
use selfhost.check.infer.*;
use selfhost.check.rules.*;
use selfhost.check.diag.*;
use selfhost.check.generics.*;
use selfhost.check.methods.*;
use selfhost.check.own.*;
use selfhost.check.borrows.*;
use selfhost.check.contracts.*;
use selfhost.check.access.*;
use selfhost.check.drops.*;
use selfhost.check.copies.*;

pub fn check_program() -> List<List<any>> {
    let s = snap_load();
    let sink = sink_new(s);
    let p = prog_new(s);
    let r = resolve_program(p, sink);
    let inf = infer_new(p, r);
    check_rules(inf, sink);
    check_generics(inf, sink);
    check_ownership(inf, sink);
    check_escapes(inf, sink);
    check_type_tables(p, sink);
    check_contracts(p, sink);
    check_access(inf, sink);
    return sink.rows;
}

/// Where each owned value of the program is dropped (selfhost/check/drops.pilot),
/// as rows for crates/pilot-cli/src/check.rs `drop_plan`.
pub fn drop_plan() -> List<List<any>> {
    let s = snap_load();
    let p = prog_new(s);
    let r = resolve_program(p, sink_new(s));
    let inf = infer_new(p, r);
    let pl = drop_planner(inf);
    plan_copies(pl);
    return pl.rows;
}
