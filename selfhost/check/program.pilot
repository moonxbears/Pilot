// ==============================================================================
// FILE: selfhost/check/program.pilot
// Declarations of the linked program: types, functions, members, slots.
// ==============================================================================
// Nothing here knows a Pilot type by name. A type is recognised by what its
// declaration says about itself:
//   - `[Lang(Cfg.Lang.<slot>)]` binds it to a receptor slot. The checker asks
//     for slots, never for names (`prog_slot_type`).
//   - `[Bits(<width>, <register class>)]` gives its register class; integer
//     and float literals fit any type of a matching class.
//   - Its members and lattice bits come from its method table and layout
//     plan (selfhost/check/methods.pilot).
//   - A constant written as a member chain (`Cfg.Lattice.object`) is read
//     from the map literal its root names (`prog_const`).
pub lvl(0) pkg Pilot.SelfHost.Check.Program;

use selfhost.check.snapshot.*;
use selfhost.check.types.*;

/// Receptor slot each literal kind takes when nothing else fixes its type.
/// The slot keys are the `Cfg.Lang` keys of stdlib/core/core.pilot.
pub fn literal_slot(lit_kind: i64) -> str {
    if lit_kind == nk_int() { return "i64_t"; }
    if lit_kind == nk_float() { return "f64_t"; }
    if lit_kind == nk_str() { return "str_t"; }
    if lit_kind == nk_bool() { return "bool_t"; }
    return "";
}

/// The slot of the bottom type, which a call that never returns has.
pub pure fn never_slot() -> str => "never_t";

/// Register classes (`Cfg.Reg` keys) whose types hold integers and floats.
pub fn is_integer_class(class: str) -> bool => class == "gpr_s" || class == "gpr_u";
pub fn is_float_class(class: str) -> bool => class == "simd_f";
/// The `Cfg.Reg` width key of a type that holds no value.
pub pure fn zero_width() -> str => "b0";

/// A node-keyed list of node lists.
pub struct NodeLists {
    pub index: Map<str, i64>;
    pub lists: List<List<i64>>;
}

pub fn nl_new() -> NodeLists => NodeLists { index: Map<str, i64>(), lists: [] };

pub fn nl_add(m: NodeLists, key: str, v: i64) {
    if !m.index.has(key) {
        let fresh: List<i64> = [];
        m.index.set(key, m.lists.len());
        m.lists.push(fresh);
    }
    let l: List<i64> = m.lists[m.index.get(key)];
    l.push(v);
}

pub fn nl_get(m: NodeLists, key: str) -> List<i64> {
    if !m.index.has(key) { return []; }
    return m.lists[m.index.get(key)];
}

pub struct Program {
    pub s: Snap;
    pub tt: TypeTable;
    pub parents: List<i64>;
    /// Type name -> declarations (`struct`, `enum`, `interface`; partial
    /// declarations share a name).
    pub type_decls: NodeLists;
    /// Function name -> top-level `fn` declarations.
    pub fns: NodeLists;
    /// `Type.member` -> member declarations in the type's own bodies.
    pub members: NodeLists;
    /// Type name -> its `ext` blocks.
    pub ext_decls: NodeLists;
    /// Type name -> top-level `fn Type.m` declarations.
    pub dotted_fns: NodeLists;
    /// Type name -> type nodes of its `*Bundle` splices.
    pub splices: NodeLists;
    /// Type name -> base type nodes (`: IFoo, IBar`).
    pub bases: NodeLists;
    /// Node -> attribute rows.
    pub attrs: NodeLists;
    /// Owner node -> generic parameter symbols.
    pub tparams: NodeLists;
    /// Slot key -> declaration.
    pub slots: Map<str, i64>;
    /// Type name -> `[Bits]` register class and width keys. A type's
    /// attributes may sit on any of its declarations, so facts are kept by
    /// name.
    pub bits_class: Map<str, str>;
    pub bits_width: Map<str, str>;
    /// Type node -> its type, once computed (-1 before).
    pub annot_memo: List<i64>;
    /// Binding name -> `let`/`const` declarations, for `prog_const`.
    pub lets: NodeLists;
    /// Type name -> index into `built` (selfhost/check/methods.pilot).
    pub built_index: Map<str, i64>;
    pub built: List<any>;
    /// Receptor slot -> the name its table gives it (`prog_slot_name`).
    pub slot_names: Map<str, str>;
}

fn key(n: i64) -> str => f"{n}";

/// The last name in an attribute argument (`Cfg.Lang.i64_t` -> `i64_t`).
fn attr_arg_key(s: Snap, a: i64) -> str {
    let k = kind(s, a);
    if k == nk_member() { return sym_text(s, rhs(s, a)); }
    if k == nk_ident() || k == nk_str() || k == nk_type_named() { return node_name(s, a); }
    return "";
}

/// The argument keys of the attribute named `name` on node `n`, or none.
pub fn prog_attr_args(p: Program, n: i64, name: str) -> List<str>? {
    for row_index in nl_get(p.attrs, key(n)) {
        let row: List<any> = p.s.attrs[row_index];
        if sym_text(p.s, row[1]) == name {
            var out: List<str> = [];
            let args: List<i64> = row[2];
            for a in args { out.push(attr_arg_key(p.s, a)); }
            return out;
        }
    }
    return none;
}

fn is_type_decl_kind(k: i64) -> bool => k == nk_struct() || k == nk_interface() || k == nk_adt();

fn index_members(p: Program, owner_name: str, decl: i64, into: NodeLists) {
    let s = p.s;
    for m in type_members(s, decl) {
        let k = kind(s, m);
        if k == nk_param() || k == nk_fn() || k == nk_operator() || k == nk_indexer()
            || ((k == nk_let() || k == nk_var()) && annot(s, m) >= 0) {
            nl_add(into, owner_name + "." + node_name(s, m), m);
        } else if k == nk_expr_stmt() {
            let u = lhs(s, m);
            if u >= 0 && kind(s, u) == nk_unary() && flags(s, u) == unary_splat() && lhs(s, u) >= 0 {
                nl_add(p.splices, owner_name, lhs(s, u));
            }
        }
    }
}

/// Indexes the declarations of the snapshot.
pub fn prog_new(s: Snap) -> Program {
    var memo: List<i64> = [];
    var i = 0;
    while i < s.count { memo.push(-1); i = i + 1; }
    let p = Program {
        s: s,
        tt: tt_new(),
        parents: parents_of(s),
        type_decls: nl_new(),
        fns: nl_new(),
        members: nl_new(),
        ext_decls: nl_new(),
        dotted_fns: nl_new(),
        splices: nl_new(),
        bases: nl_new(),
        attrs: nl_new(),
        tparams: nl_new(),
        slots: Map<str, i64>(),
        bits_class: Map<str, str>(),
        bits_width: Map<str, str>(),
        annot_memo: memo,
        lets: nl_new(),
        built_index: Map<str, i64>(),
        built: [],
        slot_names: Map<str, str>(),
    };
    var r = 0;
    while r < s.attrs.len() {
        let row: List<any> = s.attrs[r];
        nl_add(p.attrs, key(row[0]), r);
        r = r + 1;
    }
    for tp in s.type_params { nl_add(p.tparams, key(tp[0]), tp[1]); }
    i = 0;
    while i < s.count {
        let k = kind(s, i);
        if is_type_decl_kind(k) {
            let name = node_name(s, i);
            nl_add(p.type_decls, name, i);
            if k != nk_adt() { index_members(p, name, i, p.members); }
            if some slot = prog_attr_args(p, i, "Lang") {
                if slot.len() > 0 && !p.slots.has(slot[0]) { p.slots.set(slot[0], i); }
            }
            if some bits = prog_attr_args(p, i, "Bits") {
                if bits.len() >= 2 {
                    p.bits_width.set(name, bits[0]);
                    p.bits_class.set(name, bits[1]);
                }
            }
        } else if k == nk_extend() {
            nl_add(p.ext_decls, node_name(s, i), i);
        } else if (k == nk_let() || k == nk_const()) && rhs(s, i) >= 0 {
            nl_add(p.lets, node_name(s, i), i);
        } else if k == nk_program() {
            for c in children(s, i) {
                if kind(s, c) == nk_fn() {
                    let name = node_name(s, c);
                    let dot = name.find(".", 0);
                    if dot > 0 {
                        nl_add(p.dotted_fns, name.slice(0, dot), c);
                    } else {
                        nl_add(p.fns, name, c);
                    }
                }
            }
        }
        i = i + 1;
    }
    for b in s.bases {
        let owner = b[0];
        if owner >= 0 && b[1] >= 0 { nl_add(p.bases, node_name(s, owner), b[1]); }
    }
    return p;
}

/// The canonical declaration of type name `name`, or -1.
pub fn prog_type_decl(p: Program, name: str) -> i64 {
    let decls = nl_get(p.type_decls, name);
    if decls.len() == 0 { return -1; }
    return decls[0];
}

/// The generic parameter names of declaration `owner`.
pub fn prog_tparam_names(p: Program, owner: i64) -> List<str> {
    var out: List<str> = [];
    for sym in nl_get(p.tparams, key(owner)) { out.push(sym_text(p.s, sym)); }
    return out;
}

/// The type of the declaration bound to `slot`, with no type arguments,
/// or the unknown type when no declaration takes that slot.
pub fn prog_slot_type(p: Program, slot: str) -> i64 {
    if !p.slots.has(slot) { return ty_unknown(); }
    let name = node_name(p.s, p.slots.get(slot));
    let no_args: List<i64> = [];
    return ty_named(p.tt, prog_type_decl(p, name), name, no_args);
}

/// The `[Bits]` register class of a type, or "".
pub fn prog_class(p: Program, t: i64) -> str {
    if !ty_is_named(p.tt, t) { return ""; }
    let d = node_name(p.s, ty_decl(p.tt, t));
    return if p.bits_class.has(d) { p.bits_class.get(d) } else { "" };
}

/// Whether a type holds no value (`void`, `never`).
pub fn prog_is_zero_width(p: Program, t: i64) -> bool {
    if !ty_is_named(p.tt, t) { return false; }
    let d = node_name(p.s, ty_decl(p.tt, t));
    return p.bits_width.has(d) && p.bits_width.get(d) == zero_width();
}

/// Whether `t` is the bottom type.
pub fn prog_is_never(p: Program, t: i64) -> bool {
    return t > 0 && ty_is_named(p.tt, t) && p.slots.has(never_slot())
        && node_name(p.s, ty_decl(p.tt, t)) == node_name(p.s, p.slots.get(never_slot()));
}

/// The generic parameter `name` visible at node `at`, as a type, or the
/// unknown type when no enclosing declaration introduces it.
fn visible_tparam(p: Program, at: i64, name: str) -> i64 {
    var cur = at;
    var depth = 0;
    while cur >= 0 && depth < 200 {
        for sym in nl_get(p.tparams, key(cur)) {
            if sym_text(p.s, sym) == name { return ty_param(p.tt, cur, name); }
        }
        cur = p.parents[cur];
        depth = depth + 1;
    }
    return ty_unknown();
}

/// Whether type node `n` names something: a type declaration or a generic
/// parameter in scope.
pub fn prog_type_name_known(p: Program, n: i64) -> bool {
    let name = node_name(p.s, n);
    return prog_type_decl(p, name) >= 0 || visible_tparam(p, n, name) > 0;
}

/// The name the `Cfg.Lang`-style table of receptor slots gives `slot`
/// (`fn_t` -> the function type's name), found through the `[Lang(..)]`
/// arguments that index that table; "" when there is none.
pub fn prog_slot_name(p: Program, slot: str) -> str {
    if p.slot_names.has(slot) { return p.slot_names.get(slot); }
    let name = find_slot_name(p, slot);
    p.slot_names.set(slot, name);
    return name;
}

fn find_slot_name(p: Program, slot: str) -> str {
    let s = p.s;
    var r = 0;
    while r < s.attrs.len() {
        let row: List<any> = s.attrs[r];
        let args: List<i64> = row[2];
        if sym_text(s, row[1]) == "Lang" && args.len() > 0 && kind(s, args[0]) == nk_member() {
            let table = const_node(p, lhs(s, args[0]), 0);
            if table >= 0 && kind(s, table) == nk_map() {
                let v = map_entry(s, table, slot);
                return if v >= 0 && kind(s, v) == nk_str() { str_value(s, v) } else { "" };
            }
        }
        r = r + 1;
    }
    return "";
}

/// The receptor slot of function values.
pub pure fn fn_slot() -> str => "fn_t";
/// The receptor slot of the list a collection literal builds.
pub pure fn list_slot() -> str => "list_t";

/// The type a type node denotes.
pub fn prog_annot_type(p: Program, n: i64) -> i64 {
    if n < 0 { return ty_unknown(); }
    if p.annot_memo[n] >= 0 { return p.annot_memo[n]; }
    var t = ty_unknown();
    if kind(p.s, n) == nk_type_named() {
        let name = node_name(p.s, n);
        let tp = visible_tparam(p, n, name);
        if tp > 0 {
            t = tp;
        } else {
            let d = prog_type_decl(p, name);
            var args: List<i64> = [];
            if d >= 0 || name == prog_slot_name(p, fn_slot()) {
                for a in children(p.s, n) { args.push(prog_annot_type(p, a)); }
            }
            if d >= 0 {
                t = ty_named(p.tt, d, name, args);
            } else if name == prog_slot_name(p, fn_slot()) {
                t = ty_func(p.tt, name, args);
            }
        }
    }
    p.annot_memo[n] = t;
    return t;
}

/// A member found on a type: its declaration and the generic parameter
/// names and arguments that apply to its signature.
pub struct Member {
    pub decl: i64;
    pub names: List<str>;
    pub values: List<i64>;
}

/// The declared type of a member: a field's annotation, or the return type
/// of a method or operator; with the type's arguments substituted.
pub fn prog_member_type(p: Program, m: Member) -> i64 {
    let n = m.decl;
    let k = kind(p.s, n);
    var t = ty_unknown();
    if k == nk_param() { t = prog_annot_type(p, rhs(p.s, n)); }
    else { t = prog_annot_type(p, annot(p.s, n)); }
    return ty_subst(p.tt, t, m.names, m.values);
}

/// The argument nodes of the attribute named `name` on node `n`, or none.
pub fn prog_attr_nodes(p: Program, n: i64, name: str) -> List<i64>? {
    for row_index in nl_get(p.attrs, key(n)) {
        let row: List<any> = p.s.attrs[row_index];
        if sym_text(p.s, row[1]) == name {
            let args: List<i64> = row[2];
            return args;
        }
    }
    return none;
}

/// The value of entry `name` in map literal `m`, or -1.
fn map_entry(s: Snap, m: i64, name: str) -> i64 {
    let ch = children(s, m);
    var i = 0;
    while i + 1 < ch.len() {
        if node_name(s, ch[i]) == name { return ch[i + 1]; }
        i = i + 2;
    }
    return -1;
}

/// The node a constant expression stands for: a literal is itself; a member
/// chain `Root.a.b` is entry `b` of entry `a` of the map literal bound to
/// `Root`. -1 when it cannot be followed.
fn const_node(p: Program, e: i64, depth: i64) -> i64 {
    let s = p.s;
    if e < 0 || depth > 16 { return -1; }
    let k = kind(s, e);
    if k == nk_ident() {
        let lets = nl_get(p.lets, node_name(s, e));
        return if lets.len() > 0 { rhs(s, lets[0]) } else { -1 };
    }
    if k == nk_member() {
        let base = const_node(p, lhs(s, e), depth + 1);
        if base < 0 || kind(s, base) != nk_map() { return -1; }
        return map_entry(s, base, sym_text(s, rhs(s, e)));
    }
    return e;
}

/// The integer a constant expression evaluates to, or none.
pub fn prog_const(p: Program, e: i64) -> i64? {
    let n = const_node(p, e, 0);
    if n >= 0 && kind(p.s, n) == nk_int() { return lit_value(p.s, n); }
    return none;
}
