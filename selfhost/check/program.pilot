// ==============================================================================
// FILE: selfhost/check/program.pilot
// Declarations of the linked program: types, functions, members, slots.
// ==============================================================================
// Nothing here knows a Pilot type by name. A type is recognised by what its
// declaration says about itself:
//   - `[Lang(Cfg.Lang.<slot>)]` binds it to a receptor slot. The checker asks
//     for slots, never for names (`prog_slot_type`).
//   - `[Bits(<width>, <register class>)]` gives its register class; integer
//     and float literals fit any type of a matching class.
//   - Its members and lattice bits come from its method table and layout
//     plan (selfhost/check/methods.pilot).
//   - A constant written as a member chain (`Cfg.Lattice.object`) is read
//     from the map literal its root names (`prog_const`).
pub lvl(0) pkg selfhost.check;


/// Receptor slot each literal kind takes when nothing else fixes its type.
/// The slot keys are the `Cfg.Lang` keys of stdlib/core/core.pilot.
pub fn literal_slot(lit_kind: i64) -> str {
    if lit_kind == nk_int() { return "i64_t"; }
    if lit_kind == nk_float() { return "f64_t"; }
    if lit_kind == nk_str() { return "str_t"; }
    if lit_kind == nk_bool() { return "bool_t"; }
    return "";
}

/// The slot of the type whose values are Unicode scalar values (characters).
pub pure fn scalar_slot() -> str => "char_t";

/// The code point of `text` when it holds exactly one Unicode scalar value
/// in UTF-8 (RFC 3629), or -1.
pub fn scalar_code(text: str) -> i64 {
    let n = text.len();
    if n == 0 || n > 4 { return -1; }
    let b0 = text.byte_at(0) as i64;
    if b0 < 128 { return if n == 1 { b0 } else { -1 }; }
    var need = 0;
    var code = 0;
    if b0 >= 192 && b0 < 224 { need = 2; code = b0 - 192; }
    else if b0 >= 224 && b0 < 240 { need = 3; code = b0 - 224; }
    else if b0 >= 240 && b0 < 248 { need = 4; code = b0 - 240; }
    if need == 0 || n != need { return -1; }
    var i = 1;
    while i < n {
        let b = text.byte_at(i) as i64;
        if b < 128 || b >= 192 { return -1; }
        code = code * 64 + (b - 128);
        i = i + 1;
    }
    return code;
}

/// The slot of the bottom type, which a call that never returns has.
pub pure fn never_slot() -> str => "never_t";

/// Register classes (`Cfg.Reg` keys) whose types hold integers and floats.
pub fn is_integer_class(class: str) -> bool => class == "gpr_s" || class == "gpr_u";
pub fn is_float_class(class: str) -> bool => class == "simd_f";
pub fn is_signed_class(class: str) -> bool => class == "gpr_s";
/// The `Cfg.Reg` width key of a type that holds no value.
pub pure fn zero_width() -> str => "b0";

/// A node-keyed list of node lists.
pub struct NodeLists {
    pub index: Map<str, i64>;
    pub lists: List<List<i64>>;
}

pub fn nl_new() -> NodeLists => NodeLists { index: Map<str, i64>(), lists: [] };

pub fn nl_add(var ref m: NodeLists, key: str, v: i64) {
    if !m.index.has(key) {
        let fresh: List<i64> = [];
        m.index.set(key, m.lists.len() as i64);
        m.lists.push(fresh);
    }
    let l: List<i64> = m.lists[m.index.get(key)];
    l.push(v);
}

pub fn nl_get(ref m: NodeLists, key: str) -> List<i64> {
    if !m.index.has(key) { return []; }
    return m.lists[m.index.get(key)];
}

pub struct Program {
    pub ref s: Snap;
    pub tt: TypeTable;
    pub parents: List<i64>;
    /// Type name -> declarations (`struct`, `enum`, `interface`; partial
    /// declarations share a name).
    pub type_decls: NodeLists;
    /// Function name -> top-level `fn` declarations.
    pub fns: NodeLists;
    /// `Type.member` -> member declarations in the type's own bodies.
    pub members: NodeLists;
    /// Type name -> its `ext` blocks.
    pub ext_decls: NodeLists;
    /// Type name -> top-level `fn Type.m` declarations.
    pub dotted_fns: NodeLists;
    /// Type name -> type nodes of its `*Bundle` splices.
    pub splices: NodeLists;
    /// Type name -> base type nodes (`: IFoo, IBar`).
    pub bases: NodeLists;
    /// Node -> attribute rows.
    pub attrs: NodeLists;
    /// Owner node -> generic parameter symbols.
    pub tparams: NodeLists;
    /// Owner node -> the default type node of each generic parameter, in
    /// the same order (-1 for a parameter without one).
    pub tparam_defaults: NodeLists;
    /// Slot key -> declaration.
    pub slots: Map<str, i64>;
    /// Type name -> `[Bits]` register class and width keys. A type's
    /// attributes may sit on any of its declarations, so facts are kept by
    /// name.
    pub bits_class: Map<str, str>;
    pub bits_width: Map<str, str>;
    /// Type node -> its type, once computed (-1 before).
    pub annot_memo: List<i64>;
    /// Binding name -> `let`/`const` declarations, for `prog_const`.
    pub lets: NodeLists;
    /// Type name -> index into `built` (selfhost/check/methods.pilot).
    pub built_index: Map<str, i64>;
    pub built: List<BuiltType>;
    /// Receptor slot -> the name its table gives it (`prog_slot_name`).
    pub slot_names: Map<str, str>;
    /// Node lists computed once on demand (selfhost/check/generators.pilot).
    pub gen_memo: Map<str, List<i64>>;
    /// The engine bindings (`prog_engine_bindings`), once computed: empty
    /// before, one list after.
    pub engine_memo: List<List<EngineBinding>>;
    /// The top-level bindings by name (selfhost/check/effects.pilot), once
    /// computed: empty before, one map after.
    pub globals_memo: List<Map<str, i64>>;
    /// Map literal node -> index into `entry_maps`, for the map literals
    /// `map_entry` has looked into.
    pub entry_index: Map<str, i64>;
    /// Entry name -> value node of a map literal (the first entry of each
    /// name), built on first lookup.
    pub entry_maps: List<Map<str, i64>>;
}

fn key(n: i64) -> str => f"{n}";

/// The last name in an attribute argument (`Cfg.Lang.i64_t` -> `i64_t`).
fn attr_arg_key(ref s: Snap, a: i64) -> str {
    let k = kind(s, a);
    if k == nk_member() { return sym_text(s, rhs(s, a)); }
    if k == nk_ident() || k == nk_str() || k == nk_type_named() { return node_name(s, a); }
    return "";
}

/// The argument keys of the attribute named `name` on node `n`, or none.
pub fn prog_attr_args(ref p: Program, n: i64, name: str) -> List<str>? {
    for row_index in nl_get(p.attrs, key(n)) {
        let row = p.s.attrs[row_index];
        if sym_text(p.s, row.1) == name {
            var out: List<str> = [];
            let args = row.2;
            for a in args { out.push(attr_arg_key(p.s, a)); }
            return out;
        }
    }
    return none;
}

fn is_type_decl_kind(k: i64) -> bool => k == nk_struct() || k == nk_interface() || k == nk_adt();

fn index_members(var ref p: Program, owner_name: str, decl: i64) {
    let s = p.s;
    for m in type_members(s, decl) {
        let k = kind(s, m);
        if k == nk_param() || k == nk_fn() || k == nk_operator() || k == nk_indexer()
            || ((k == nk_let() || k == nk_var()) && annot(s, m) >= 0) {
            let mname = if k == nk_indexer() { "[]" } else { node_name(s, m) };
            nl_add(p.members, owner_name + "." + mname, m);
        } else if k == nk_expr_stmt() {
            let u = lhs(s, m);
            if u >= 0 && kind(s, u) == nk_unary() && flags(s, u) == unary_splat() && lhs(s, u) >= 0 {
                nl_add(p.splices, owner_name, lhs(s, u));
            }
        }
    }
}

/// Indexes the declarations of the snapshot.
pub fn prog_new(ref s: Snap) -> Program {
    let memo = filled(s.count, -1);
    let p = Program {
        s: s,
        tt: tt_new(),
        parents: parents_of(s),
        type_decls: nl_new(),
        fns: nl_new(),
        members: nl_new(),
        ext_decls: nl_new(),
        dotted_fns: nl_new(),
        splices: nl_new(),
        bases: nl_new(),
        attrs: nl_new(),
        tparams: nl_new(),
        tparam_defaults: nl_new(),
        slots: Map<str, i64>(),
        bits_class: Map<str, str>(),
        bits_width: Map<str, str>(),
        annot_memo: memo,
        lets: nl_new(),
        built_index: Map<str, i64>(),
        built: [],
        slot_names: Map<str, str>(),
        gen_memo: Map<str, List<i64>>(),
        engine_memo: [],
        globals_memo: [],
        entry_index: Map<str, i64>(),
        entry_maps: [],
    };
    var r = 0;
    while r < s.attrs.len() {
        nl_add(p.attrs, key(s.attrs[r].0), r);
        r = r + 1;
    }
    for tp in s.type_params {
        nl_add(p.tparams, key(tp[0]), tp[1]);
        nl_add(p.tparam_defaults, key(tp[0]), if tp.len() > 2 { tp[2] } else { -1 });
    }
    // Every node indexed here is a declaration (`Snap.decl_nodes`).
    for i in s.decl_nodes {
        let k = kind(s, i);
        if is_type_decl_kind(k) {
            let name = node_name(s, i);
            nl_add(p.type_decls, name, i);
            if k != nk_adt() { index_members(p, name, i); }
            if some slot = prog_attr_args(p, i, nameof(Lang)) {
                if slot.len() > 0 && !p.slots.has(slot[0]) { p.slots.set(slot[0], i); }
            }
            if some bits = prog_attr_args(p, i, nameof(Bits)) {
                if bits.len() >= 2 {
                    p.bits_width.set(name, bits[0]);
                    p.bits_class.set(name, bits[1]);
                }
            }
        } else if k == nk_extend() {
            nl_add(p.ext_decls, node_name(s, i), i);
        } else if (k == nk_let() || k == nk_const()) && rhs(s, i) >= 0 {
            nl_add(p.lets, node_name(s, i), i);
        } else if k == nk_program() {
            for c in children(s, i) {
                if kind(s, c) == nk_fn() {
                    let name = node_name(s, c);
                    let dot = name.find(".", 0);
                    if dot > 0 {
                        nl_add(p.dotted_fns, name.slice(0, dot), c);
                    } else {
                        nl_add(p.fns, name, c);
                    }
                }
            }
        }
    }
    for b in s.bases {
        let owner = b[0];
        if owner >= 0 && b[1] >= 0 { nl_add(p.bases, node_name(s, owner), b[1]); }
    }
    return p;
}

/// The canonical declaration of type name `name`, or -1.
pub fn prog_type_decl(ref p: Program, name: str) -> i64 {
    let decls = nl_get(p.type_decls, name);
    if decls.len() == 0 { return -1; }
    return decls[0];
}

/// The generic parameter names of declaration `owner`.
pub fn prog_tparam_names(ref p: Program, owner: i64) -> List<str> {
    var out: List<str> = [];
    for sym in nl_get(p.tparams, key(owner)) { out.push(sym_text(p.s, sym)); }
    return out;
}

/// The default type nodes of the generic parameters of the type named
/// `name` (-1 for a parameter without one), from the declaration that
/// lists them.
pub fn prog_tparam_defaults(ref p: Program, name: str) -> List<i64> {
    for d in nl_get(p.type_decls, name) {
        let defaults = nl_get(p.tparam_defaults, key(d));
        if defaults.len() > 0 { return defaults; }
    }
    let empty: List<i64> = [];
    return empty;
}

/// The type of the declaration bound to `slot`, with no type arguments,
/// or the unknown type when no declaration takes that slot.
pub fn prog_slot_type(var ref p: Program, slot: str) -> i64 {
    if !p.slots.has(slot) { return ty_unknown(); }
    let name = node_name(p.s, p.slots[slot]);
    let no_args: List<i64> = [];
    return ty_named(p.tt, prog_type_decl(p, name), name, no_args);
}

/// The `[Bits]` register class of a type, or "".
pub fn prog_class(ref p: Program, t: i64) -> str {
    if !ty_is_named(p.tt, t) { return ""; }
    let d = node_name(p.s, ty_decl(p.tt, t));
    return if p.bits_class.has(d) { p.bits_class.get(d) } else { "" };
}

/// The bits a value of primitive `t` holds, from its `[Bits]`, or -1.
pub fn prog_bits(var ref p: Program, t: i64) -> i64 {
    if !ty_is_named(p.tt, t) { return -1; }
    for decl in nl_get(p.type_decls, node_name(p.s, ty_decl(p.tt, t))) {
        if some args = prog_attr_nodes(p, decl, nameof(Bits)) {
            if args.len() > 0 {
                if some bits = prog_const(p, args[0]) { return bits; }
            }
        }
    }
    return -1;
}

/// Whether every value of integer type `src` is a value of integer type
/// `dst`, so a `src` fits where a `dst` is expected without a cast (owner
/// decision 2026-11-16): an unsigned type into a wider unsigned or a wider
/// signed type, a signed type into a wider signed type. Read from `[Bits]`
/// alone; `bool` and the character type are not integers here.
pub fn prog_widens(var ref p: Program, src: i64, dst: i64) -> bool {
    let sc = prog_class(p, src);
    let dc = prog_class(p, dst);
    if !is_integer_class(sc) || !is_integer_class(dc) { return false; }
    let bt = prog_slot_type(p, literal_slot(nk_bool()));
    let ct = prog_slot_type(p, scalar_slot());
    for t in [src, dst] {
        if ty_is_named(p.tt, bt) && ty_decl(p.tt, t) == ty_decl(p.tt, bt) { return false; }
        if ty_is_named(p.tt, ct) && ty_decl(p.tt, t) == ty_decl(p.tt, ct) { return false; }
    }
    let sw = prog_bits(p, src);
    let dw = prog_bits(p, dst);
    if sw <= 0 || dw <= sw { return false; }
    return !is_signed_class(sc) || is_signed_class(dc);
}

/// The register class values of type `t` travel in: its `[Bits]` class, or
/// for an enum declared over a primitive (`enum E : u8`) that primitive's.
pub fn prog_value_class(var ref p: Program, t: i64) -> str {
    let c = prog_class(p, t);
    if c != "" || !ty_is_named(p.tt, t) { return c; }
    let d = ty_decl(p.tt, t);
    if d < 0 || kind(p.s, d) != nk_adt() { return ""; }
    for b in nl_get(p.bases, node_name(p.s, d)) {
        let bc = prog_class(p, prog_annot_type(p, b));
        if bc != "" { return bc; }
    }
    return "";
}

/// Whether a type holds no value (`void`, `never`).
pub fn prog_is_zero_width(ref p: Program, t: i64) -> bool {
    if !ty_is_named(p.tt, t) { return false; }
    let d = node_name(p.s, ty_decl(p.tt, t));
    return p.bits_width.has(d) && p.bits_width.get(d) == zero_width();
}

/// Whether `t` is the bottom type.
pub fn prog_is_never(ref p: Program, t: i64) -> bool {
    return t > 0 && ty_is_named(p.tt, t) && p.slots.has(never_slot())
        && node_name(p.s, ty_decl(p.tt, t)) == node_name(p.s, p.slots[never_slot()]);
}

/// The generic parameter `name` visible at node `at`, as a type, or the
/// unknown type when no enclosing declaration introduces it.
pub fn visible_tparam(var ref p: Program, at: i64, name: str) -> i64 {
    var cur = at;
    var depth = 0;
    while cur >= 0 && depth < 200 {
        for sym in nl_get(p.tparams, key(cur)) {
            if sym_text(p.s, sym) == name { return ty_param(p.tt, cur, name); }
        }
        cur = p.parents[cur];
        depth = depth + 1;
    }
    return ty_unknown();
}

/// Whether type node `n` names something: a type declaration or a generic
/// parameter in scope.
pub fn prog_type_name_known(var ref p: Program, n: i64) -> bool {
    let name = node_name(p.s, n);
    return prog_type_decl(p, name) >= 0 || visible_tparam(p, n, name) > 0
        || name == prog_slot_name(p, fn_slot());
}

/// The name the `Cfg.Lang`-style table of receptor slots gives `slot`
/// (`fn_t` -> the function type's name), found through the `[Lang(..)]`
/// arguments that index that table; "" when there is none.
pub fn prog_slot_name(var ref p: Program, slot: str) -> str {
    if p.slot_names.has(slot) { return p.slot_names[slot]; }
    let name = find_slot_name(p, slot);
    p.slot_names.set(slot, name);
    return name;
}

fn find_slot_name(var ref p: Program, slot: str) -> str {
    let s = p.s;
    var r = 0;
    while r < s.attrs.len() {
        let row = s.attrs[r];
        let args = row.2;
        if sym_text(s, row.1) == nameof(Lang) && args.len() > 0 && kind(s, args[0]) == nk_member() {
            let table = const_node(p, lhs(s, args[0]), 0);
            if table >= 0 && kind(s, table) == nk_map() {
                let v = map_entry(p, table, slot);
                return if v >= 0 && kind(s, v) == nk_str() { str_value(s, v) } else { "" };
            }
        }
        r = r + 1;
    }
    return "";
}

/// The receptor slot of the two-member union type (`A | B`).
pub pure fn union_slot() -> str => "union_t";
/// The receptor slot of function values.
pub pure fn fn_slot() -> str => "fn_t";
/// The receptor slot of the list a collection literal builds.
pub pure fn list_slot() -> str => "list_t";

/// Whether type declaration `d` is `type Name = Target;` (or generic
/// `type Name<T> = Target;`): it has no variants and its right side is the
/// target type.
pub fn is_type_alias(ref p: Program, d: i64) -> bool =>
    kind(p.s, d) == nk_adt() && flags(p.s, d) == 0 && rhs(p.s, d) >= 0;

/// Whether type declaration `d` is `type Name = Target;` with no generic
/// parameters: it has no variants and its right side is the target type.
pub fn is_plain_alias(ref p: Program, d: i64) -> bool {
    if !is_type_alias(p, d) { return false; }
    return nl_get(p.tparams, key(d)).len() == 0;
}

/// Whether `t` is the character type (the `char_t` slot).
pub fn is_scalar_type(var ref p: Program, t: i64) -> bool {
    let ct = prog_slot_type(p, scalar_slot());
    return ty_is_named(p.tt, t) && ty_is_named(p.tt, ct) && ty_decl(p.tt, t) == ty_decl(p.tt, ct);
}

/// Whether node `e` is a string literal that holds exactly one Unicode
/// scalar value: where a character is expected, it is that character.
pub fn is_scalar_literal(ref p: Program, e: i64) -> bool =>
    e >= 0 && kind(p.s, e) == nk_str() && scalar_code(node_name(p.s, e)) >= 0;

/// The type a type node denotes.
pub fn prog_annot_type(var ref p: Program, n: i64) -> i64 {
    if n < 0 { return ty_unknown(); }
    if p.annot_memo[n] >= 0 { return p.annot_memo[n]; }
    var t = ty_unknown();
    if kind(p.s, n) == nk_type_named() {
        let name = node_name(p.s, n);
        let tp = visible_tparam(p, n, name);
        if tp > 0 {
            t = tp;
        } else {
            let d = prog_type_decl(p, name);
            var args: List<i64> = [];
            let is_fn = d < 0 && name == prog_slot_name(p, fn_slot());
            if d >= 0 {
                for a in children(p.s, n) { args.push(prog_annot_type(p, a)); }
                // Parameters left out take their defaults (`Generator<i64>`
                // is `Generator<i64, void>`).
                if args.len() > 0 {
                    let defaults = prog_tparam_defaults(p, name);
                    while args.len() < defaults.len() && defaults[args.len()] >= 0 {
                        args.push(prog_annot_type(p, defaults[args.len()]));
                    }
                }
            } else if is_fn {
                // `(A, B) => R` gives the parameters as one tuple type
                // (`()` for none); each of its items is a parameter.
                let ch = children(p.s, n);
                var i = 0;
                while i < ch.len() {
                    if i + 1 < ch.len() && kind(p.s, ch[i]) == nk_type_tuple() {
                        for item in children(p.s, ch[i]) { args.push(prog_annot_type(p, item)); }
                    } else {
                        args.push(prog_annot_type(p, ch[i]));
                    }
                    i = i + 1;
                }
            }
            if d >= 0 && is_type_alias(p, d) {
                // `type Meters = i64;` or `type Pair<T> = (T, T);` is another
                // name for its target. The memo is set first so a cyclic
                // alias ends as unknown.
                p.annot_memo[n] = ty_unknown();
                let tp_names = prog_tparam_names(p, d);
                if tp_names.len() > 0 {
                    if args.len() > 0 {
                        let target = prog_annot_type(p, rhs(p.s, d));
                        t = ty_subst(p.tt, target, tp_names, args);
                    }
                } else {
                    t = prog_annot_type(p, rhs(p.s, d));
                }
            } else if d >= 0 && args.len() >= 2 && name == prog_slot_name(p, union_slot()) {
                // `union<A, B>` (`A | B`) is the union of its members: a
                // value of either fits it.
                t = ty_union(p.tt, args);
            } else if d >= 0 {
                t = ty_named(p.tt, d, name, args);
            } else if name == prog_slot_name(p, fn_slot()) {
                t = ty_func(p.tt, name, args);
            }
        }
    }
    p.annot_memo[n] = t;
    return t;
}

/// A member found on a type: its declaration and the generic parameter
/// names and arguments that apply to its signature.
pub struct Member {
    pub decl: i64;
    pub names: List<str>;
    pub values: List<i64>;
}

/// The declared type of a member: a field's annotation, or the return type
/// of a method or operator; with the type's arguments substituted.
pub fn prog_member_type(var ref p: Program, ref m: Member) -> i64 {
    let n = m.decl;
    let k = kind(p.s, n);
    var t = ty_unknown();
    if k == nk_param() { t = prog_annot_type(p, rhs(p.s, n)); }
    else { t = prog_annot_type(p, annot(p.s, n)); }
    return ty_subst(p.tt, t, m.names, m.values);
}

/// The argument nodes of the attribute named `name` on node `n`, or none.
pub fn prog_attr_nodes(ref p: Program, n: i64, name: str) -> List<i64>? {
    for row_index in nl_get(p.attrs, key(n)) {
        let row = p.s.attrs[row_index];
        if sym_text(p.s, row.1) == name {
            let args = row.2;
            return args;
        }
    }
    return none;
}

/// Every node of kind `k`, in node order (`nodes_of`, built once with the
/// snapshot). The list is shared: a caller must not change it.
pub fn prog_nodes_of_kind(ref p: Program, k: i64) -> List<i64> => nodes_of(p.s, k);

/// The value of entry `name` in map literal `m`, or -1.
fn map_entry(var ref p: Program, m: i64, name: str) -> i64 {
    let at = key(m);
    if !p.entry_index.has(at) {
        // The constant tables are large map literals read many times: their
        // entries are indexed by name once, the first entry of a name kept.
        let s = p.s;
        let entries = Map<str, i64>();
        let ch = children(s, m);
        var i = 0;
        while i + 1 < ch.len() {
            let entry = node_name(s, ch[i]);
            if !entries.has(entry) { entries.set(entry, ch[i + 1]); }
            i = i + 2;
        }
        p.entry_index.set(at, p.entry_maps.len() as i64);
        p.entry_maps.push(entries);
    }
    let entries = p.entry_maps[p.entry_index.get(at)];
    return if entries.has(name) { entries.get(name) } else { -1 };
}

/// The node a constant expression stands for: a literal is itself; a member
/// chain `Root.a.b` is entry `b` of entry `a` of the map literal bound to
/// `Root`. -1 when it cannot be followed.
fn const_node(var ref p: Program, e: i64, depth: i64) -> i64 {
    let s = p.s;
    if e < 0 || depth > 16 { return -1; }
    let k = kind(s, e);
    if k == nk_ident() {
        let lets = nl_get(p.lets, node_name(s, e));
        return if lets.len() > 0 { rhs(s, lets[0]) } else { -1 };
    }
    if k == nk_member() {
        let base = const_node(p, lhs(s, e), depth + 1);
        if base < 0 || kind(s, base) != nk_map() { return -1; }
        return map_entry(p, base, sym_text(s, rhs(s, e)));
    }
    return e;
}

/// The name a constant expression stands for (`Cfg.Reg.gpr_s` ->
/// `gpr_signed`), or "".
pub fn prog_const_name(var ref p: Program, e: i64) -> str {
    let n = const_node(p, e, 0);
    return if n >= 0 && kind(p.s, n) == nk_ident() { node_name(p.s, n) } else { "" };
}

/// A constant expression as text: a string's contents, a name, or an
/// integer's digits (`Cfg.Hooks.receptor` -> `bind_receptor`); "" when it is
/// none of these.
pub fn prog_const_text(var ref p: Program, e: i64) -> str {
    let n = const_node(p, e, 0);
    if n < 0 { return ""; }
    let k = kind(p.s, n);
    if k == nk_str() { return str_value(p.s, n); }
    if k == nk_ident() { return node_name(p.s, n); }
    if k == nk_int() { return f"{lit_value(p.s, n)}"; }
    return "";
}

/// The integer a constant expression evaluates to, or none.
pub fn prog_const(var ref p: Program, e: i64) -> i64? {
    let n = const_node(p, e, 0);
    if n >= 0 && kind(p.s, n) == nk_int() { return lit_value(p.s, n); }
    return none;
}
/// The seed token for engine calls.
pub pure fn engine_token() -> str => nameof(__engine);

/// The text of a binding argument: `nameof(f)` is `f`, a string its value,
/// a name itself.
fn engine_arg_text(var ref p: Program, n: i64) -> str {
    let s = p.s;
    let k = kind(s, n);
    if k == nk_call() {
        let ch = children(s, n);
        return if ch.len() == 2 { engine_arg_text(p, ch[1]) } else { "" };
    }
    if k == nk_str() || k == nk_ident() { return node_name(s, n); }
    // `Cfg.Hooks.receptor`, `33`: what the constant tables make of it.
    return prog_const_text(p, n);
}

/// One engine binding of the linked program: a bind hook's call
/// (`bind_native_fn(..)`) or an `__engine("<hook>", ..)` call whose hook is a
/// string, with its arguments as text.
pub struct EngineBinding {
    pub hook: str;
    pub args: List<str>;
}

/// Every engine binding of the linked program, in source order. The program
/// is walked once; the list is shared, so a caller must not change it.
pub fn prog_engine_bindings(var ref p: Program) -> List<EngineBinding> {
    if p.engine_memo.len() == 0 { p.engine_memo.push(scan_engine_bindings(p)); }
    return p.engine_memo[0];
}

fn is_bridge_bind_hook(name: str) -> bool {
    return name == "bind_operator_fn"
        || name == "bind_unit_literal"
        || name == "bind_owned_elements"
        || name == "bind_owned_payload"
        || name == "bind_generator"
        || name == "bind_try_protocol"
        || name == "bind_lift"
        || name == "bind_absent"
        || name == "bind_membership"
        || name == "bind_native_member"
        || name == "bind_native_fn"
        || name == "bind_native_method"
        || name == "bind_native_property"
        || name == "bind_native_value"
        || name == "bind_type_query"
        || name == "bind_operator_intrinsic"
        || name == "bind_absent_test"
        || name == "bind_range_index"
        || name == "bind_slice_pattern"
        || name == "bind_record_pattern"
        || name == "bind_list_literal"
        || name == "bind_list_splat"
        || name == "bind_map_literal"
        || name == "bind_format_spec"
        || name == "bind_scalar_text"
        || name == "bind_native_effect"
        || name == "bind_enumerator"
        || name == "bind_receptor";
}

/// The receptor kind `bind_receptor` gives the symbol-quoting word
/// (`bind_receptor(nameof(nameof), 33, 25)`, stdlib/core/core.pilot and
/// stdlib/core/syntax/expr_sugar.pilot): a call of that word is the text of
/// the name it quotes.
pub pure fn name_quote_receptor_kind() -> str => "33";

/// Whether `name` is bound as the symbol-quoting receptor (`nameof`), whose
/// call is a string whatever else of that name is in view: the keyword
/// registry declares `nameof {}`, which a glob import of
/// `Pilot.Core.Keywords` brings into view.
pub fn prog_is_name_quote(var ref p: Program, name: str) -> bool {
    for row in prog_engine_bindings(p) {
        if row.hook == "bind_receptor" && row.args.len() >= 2 && row.args[0] == name && row.args[1] == name_quote_receptor_kind() { return true; }
    }
    return false;
}

/// Whether `name` is bound as a compile-time question about a type
/// (`bind_type_query(sizeof, ..)`).
pub fn prog_is_type_query(var ref p: Program, name: str) -> bool {
    for row in prog_engine_bindings(p) {
        if row.hook == "bind_type_query" && row.args.len() >= 2 && row.args[0] == name { return true; }
    }
    return false;
}

fn scan_engine_bindings(var ref p: Program) -> List<EngineBinding> {
    let s = p.s;
    var out: List<EngineBinding> = [];
    let ident_kind = nk_ident();
    let token = engine_token();
    for n in nodes_of(s, nk_call()) {
        // Most calls are not engine calls: their callee (the first present
        // child) is looked at before their children are listed.
        var c = lhs(s, n);
        let end = c + rhs(s, n);
        while c < end && s.extra[c] < 0 { c = c + 1; }
        if c < end && kind(s, s.extra[c]) == ident_kind {
            let cname = node_name(s, s.extra[c]);
            if cname == token {
                let ch = children(s, n);
                // A bind hook's own definition in bridge_lang.pilot passes its
                // parameters on (`__engine("bind_absent_test", intrinsic_name)`):
                // that is not a binding, and read as one it would name the
                // parameter as the op. Bindings call the hook by its name.
                if ch.len() >= 3 && kind(s, ch[0]) == ident_kind && node_name(s, ch[0]) == token && engine_arg_text(p, ch[1]) != "" && !is_bridge_bind_hook(engine_arg_text(p, ch[1])) {
                    var args: List<str> = [];
                    var i = 2;
                    while i < ch.len() {
                        args.push(engine_arg_text(p, ch[i]));
                        i = i + 1;
                    }
                    out.push(EngineBinding { hook: engine_arg_text(p, ch[1]), args: args });
                }
            } else if is_bridge_bind_hook(cname) {
                let ch = children(s, n);
                if ch.len() >= 2 && kind(s, ch[0]) == ident_kind && node_name(s, ch[0]) == cname && engine_arg_text(p, ch[1]) != "" {
                    var args: List<str> = [];
                    var i = 1;
                    while i < ch.len() {
                        args.push(engine_arg_text(p, ch[i]));
                        i = i + 1;
                    }
                    out.push(EngineBinding { hook: cname, args: args });
                }
            }
        }
    }
    return out;
}

