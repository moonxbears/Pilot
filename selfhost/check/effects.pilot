// ==============================================================================
// FILE: selfhost/check/effects.pilot
// What a function body does besides computing its result: the facts the
// `pure` (PURE001) and `noalloc` (NOALLOC001) checks and the parameter-mode
// checks (ALIAS001, ISO001) share.
// ==============================================================================
// Everything here is read from the program's own tables:
//   - native calls (stdlib/core/builtins/native_calls.pilot) say what they
//     do with `bind_native_effect` rows (stdlib/core/native_effects.pilot,
//     linked by the prelude): "io" (reads or writes
//     outside the program), "alloc" (takes heap memory), "mutates" (changes
//     the value it is called on);
//   - modifiers are the flags the parser records for the action each word
//     is registered with (`register_modifier`), never their spelling.
pub lvl(0) pkg Pilot.SelfHost.Check.Effects;

use selfhost.check.snapshot.*;
use selfhost.check.program.*;
use selfhost.check.resolve.*;
use selfhost.check.infer.*;
use selfhost.check.own.*;

/// The native effects a check asks about.
pub pure fn effect_io() -> str => "io";
pub pure fn effect_alloc() -> str => "alloc";
pub pure fn effect_mutates() -> str => "mutates";

/// The engine bindings the checks read, indexed once.
pub struct Effects : IObject {
    pub inf: Infer;
    pub flow: Flow;
    /// `name@effect` -> 1 for every `bind_native_effect` row.
    pub native_effects: Map<str, i64>;
    /// Names of the top-level `let`/`var` bindings of the linked files.
    pub globals: Map<str, i64>;
}

pub fn effects_new(f: Flow) -> Effects {
    let inf = f.inf;
    let s = inf.p.s;
    let e = Effects {
        inf: inf,
        flow: f,
        native_effects: Map<str, i64>(),
        globals: Map<str, i64>(),
    };
    for row in f.engine {
        if row.len() < 3 { continue; }
        let hook = row[0];
        if hook == "bind_native_effect" { e.native_effects.set(row[1] + "@" + row[2], 1); }
    }
    var i = 0;
    while i < s.count {
        if kind(s, i) == nk_program() && in_linked_file(s, i) {
            for c in children(s, i) {
                let k = kind(s, c);
                if (k == nk_let() || k == nk_var()) && lhs(s, c) >= 0 { e.globals.set(node_name(s, c), c); }
            }
        }
        i = i + 1;
    }
    return e;
}

/// Whether declaration `n` is written with the modifier registered for
/// action "effect_noalloc" (`noalloc fn`); the parser records it.
pub fn is_noalloc_fn(s: Snap, n: i64) -> bool => is_noalloc_decl(s, n);

/// Whether parameter `prm` lends its argument for changing (`var ref xs`,
/// `var xs`): the caller's value is changed in place, and nothing else may
/// reach it during the call.
pub fn is_exclusive_param(e: Effects, prm: i64) -> bool => param_flag(e.inf.p.s, prm, param_flag_mutable());

/// Whether parameter `prm` takes its argument isolated (`iso xs`).
pub fn is_iso_param(e: Effects, prm: i64) -> bool => param_flag(e.inf.p.s, prm, param_flag_isolated());

/// The nodes of the body of function-like node `fnode`, closures inside it
/// included and nested function declarations left out.
pub fn body_nodes(s: Snap, fnode: i64) -> List<i64> {
    var out: List<i64> = [];
    let k = kind(s, fnode);
    let body = if k == nk_lambda() { rhs(s, fnode) } else { fn_body(s, fnode) };
    if body >= 0 { collect_body(s, body, out); }
    return out;
}

fn collect_body(s: Snap, n: i64, out: List<i64>) {
    let k = kind(s, n);
    if k == nk_fn() || k == nk_operator() || k == nk_struct() || k == nk_interface() || k == nk_extend() { return; }
    out.push(n);
    for c in children(s, n) {
        if c >= 0 { collect_body(s, c, out); }
    }
}

/// The name of the function call `call` makes when no declaration answers
/// it (`print(..)`, answered by the engine), or "".
pub fn native_fn_called(e: Effects, call: i64) -> str {
    let inf = e.inf;
    let s = inf.p.s;
    let ch = children(s, call);
    if ch.len() == 0 || kind(s, ch[0]) != nk_ident() || inf.r.ref_of[ch[0]] >= 0 { return ""; }
    if called_fn(inf, call) >= 0 { return ""; }
    return node_name(s, ch[0]);
}

/// The name of the method call `call` makes (`xs.push(..)`), or "". The
/// engine answers it when no declaration does, or when the declaration has
/// no body.
pub fn native_method_called(e: Effects, call: i64) -> str {
    let s = e.inf.p.s;
    let ch = children(s, call);
    if ch.len() == 0 || kind(s, ch[0]) != nk_member() { return ""; }
    let target = call_target(e.flow, call);
    if target >= 0 && fn_body(s, target) >= 0 { return ""; }
    return sym_text(s, rhs(s, ch[0]));
}

/// Whether native `name` is bound with effect `effect` (a call with no
/// declaration the checker can read).
pub fn native_has_effect(e: Effects, name: str, effect: str) -> bool => name != "" && e.native_effects.has(name + "@" + effect);

/// The identifier a place (`x`, `x.a`, `x[i].b`) is rooted in, or -1.
pub fn place_root(s: Snap, n: i64) -> i64 {
    var cur = n;
    while cur >= 0 && (kind(s, cur) == nk_member() || kind(s, cur) == nk_index()) { cur = lhs(s, cur); }
    return if cur >= 0 && kind(s, cur) == nk_ident() { cur } else { -1 };
}

/// Whether identifier `n` names a top-level `let`/`var` of the program.
pub fn names_global(e: Effects, n: i64) -> bool {
    if n < 0 || e.inf.r.ref_of[n] >= 0 { return false; }
    return e.globals.has(node_name(e.inf.p.s, n));
}

/// The parameter declaration identifier `n` names when that parameter
/// lends the caller's value (written `ref`, `var` or `iso`), or -1.
pub fn lent_param(e: Effects, n: i64) -> i64 {
    if n < 0 { return -1; }
    let r = e.inf.r;
    let b = r.ref_of[n];
    if b < 0 || r.bind_kind[b] != BindKind::Param { return -1; }
    let site = r.site[b];
    let s = e.inf.p.s;
    return if kind(s, site) == nk_param() && flags(s, site) != 0 { site } else { -1 };
}

/// The method call whose receiver is the place `n` (`n.push(..)`), or -1.
pub fn receiver_call_of(e: Effects, n: i64) -> i64 {
    let p = e.inf.p;
    let s = p.s;
    let up = p.parents[n];
    if up < 0 || kind(s, up) != nk_member() || lhs(s, up) != n { return -1; }
    let call = p.parents[up];
    if call < 0 || kind(s, call) != nk_call() || children(s, call)[0] != up { return -1; }
    return call;
}

/// The argument expression of each argument of `call`, with the parameter
/// of `target` it is passed for (-1 when none matches): `[arg, param]`.
pub fn call_args(s: Snap, call: i64, target: i64) -> List<List<i64>> {
    var out: List<List<i64>> = [];
    let params = if target >= 0 { fn_params(s, target) } else { [] };
    let ch = children(s, call);
    var i = 1;
    while i < ch.len() {
        let c = ch[i];
        if kind(s, c) == nk_call_arg() {
            var prm = -1;
            for q in params {
                if node_name(s, q) == node_name(s, c) { prm = q; }
            }
            out.push([rhs(s, c), prm]);
        } else {
            out.push([c, if i - 1 < params.len() { params[i - 1] } else { -1 }]);
        }
        i = i + 1;
    }
    return out;
}

/// The name a call's callee is written with, for messages.
pub fn callee_label(s: Snap, call: i64) -> str {
    let ch = children(s, call);
    if ch.len() == 0 { return "this call"; }
    let c = ch[0];
    if kind(s, c) == nk_ident() { return node_name(s, c); }
    if kind(s, c) == nk_member() { return sym_text(s, rhs(s, c)); }
    return "this call";
}
