// ==============================================================================
// FILE: selfhost/check/drops.pilot
// F7: where each owned value is dropped (the drop plan).
// ==============================================================================
// A local or by-value parameter whose type needs dropping (it has `~self()`,
// or holds such a value in a field) is dropped right after the statement
// where it is last used, on every path:
//   - a value moved (bound, returned, stored, passed by value) is not
//     dropped where it was moved: its new owner drops it;
//   - on a branch of an `if` that does not use it, it is dropped as the
//     branch starts (an `if` without `else` gets the drop on its false path);
//   - a value used in a loop it was not declared in lives until the loop
//     ends; one declared in a loop body is dropped in each iteration;
//   - a `return`, or a `break` / `continue` that leaves its scope, taken
//     while it is live drops it first (after a returned value is computed);
//     so does a failed `?` that leaves the function, or jumps to `catch`
//     out of the `try` block it was declared in, unless its operand moved
//     it.
// A scoped guard (lattice 0b11) is released when its block ends, the last
// declared first, whatever its last use.
//
// Dropping a value runs its type's destructor, then drops its fields that
// need dropping, in declaration order.
//
// Assigning an owned `var` a new value drops the value it held, once the new
// one is made; a var moved away before the assignment, on every path, has
// nothing to drop.
//
// A binding moved on only some paths (a move under `&&`, `??` or a
// conditional expression, a var assigned after a move on one branch, a `?`
// in a statement that also moves it) gets a drop flag kept at run time: set
// when it is bound or assigned, cleared where a move completes (for a value
// passed to a call or put in a literal, once the call or literal is made).
// Its drops happen only while the flag is set.
//
// An expression statement that makes an owned value and throws it away
// (`make();`, `rs.pop();`) drops it once the statement has run (Discard rows,
// `plan_discard`); a method handing back its receiver makes nothing new.
//
// A collection that owns its elements (selfhost/check/own.pilot
// `owned_elements`, from the `bind_owned_elements` engine binding: a list,
// a map's values) drops each element; the engine holds the collection
// itself, so its declared fields are not dropped. Its glue row names the
// element type and the engine operations that walk it. `let x = rs[i]` and
// `for x in rs` borrow the element, so `x` is not dropped and `rs` lives
// while `x` is used. Assigning an element (`rs[i] = v`, `m[k] = v`) drops the
// one it replaces, if there was one (ReplaceElement rows,
// `plan_element_replace`).
//
// An optional the engine holds as its payload or none (`owned_payload`, from
// `bind_owned_payload`) drops its payload unless the absent test says none.
// Unwrapping it (`o?`, `o ?? d`, `if some x = o`, `guard some x = o`) moves
// it; the unwrapped `x` owns the payload in its branch, or for the rest of the
// block after a guard.
//
// What the analysis cannot place yet stops at a seam where it runs: a
// closure capturing an owned value (own.capture), and other values holding
// values that need dropping, a result, a tuple or a type that holds itself
// through its elements (own.collection_drop).
//
// The plan is rows for crates/pilot-cli/src/check.rs (`drop_plan`), each
// led by its `DropAction` and naming a node by its program-wide span and kind:
//   [action, start, end, kind, binding, type]  Before, After, Exit, Else, Guard,
//                                              Replace, Flag, Moved, Discard (""),
//                                              ReplaceElement (lookup op, collection type)
//   [Seam, start, end, kind, id, note]
//   [Glue, type, destructor owner or "", [field, field type, ..],
//    element type, length op, element op, sequence op,
//    payload type, absent op]  (the element four "" without elements, the
//    sequence op "" when the collection is walked as is; the payload two ""
//    without a payload)
pub lvl(0) pkg Pilot.SelfHost.Check.Drops;

use selfhost.check.snapshot.*;
use selfhost.check.types.*;
use selfhost.check.program.*;
use selfhost.check.methods.*;
use selfhost.check.resolve.*;
use selfhost.check.infer.*;
use selfhost.check.diag.*;
use selfhost.check.own.*;
use selfhost.check.borrows.*;

/// What a row of the drop plan says. The seed reads the numbers
/// (crates/pilot-vm/src/lower_drop.rs `DropAction`), so they are fixed.
pub enum DropAction : u8 {
    /// How to drop a value of one type.
    Glue,
    /// Drop before the node runs.
    Before,
    /// Drop after the node runs.
    After,
    /// A `return`, `break` or `continue` drops as it leaves.
    Exit,
    /// An `if` without `else` drops on its false path.
    Else,
    /// A scoped guard bound here is released when its block ends.
    Guard,
    /// The node stops at a seam.
    Seam,
    /// The value the node gives is copied (selfhost/check/copies.pilot).
    Copy,
    /// How to copy a value of one type: the value-type fields to copy too.
    CopyGlue,
    /// An assignment drops the value its target held, after the new value
    /// is made and before it is stored; a flagged binding's flag is set
    /// again once the new value is stored.
    Replace,
    /// The binding gets its drop flag, set, before the node runs (its
    /// declaration, or the function body for a parameter).
    Flag,
    /// A move of the binding completes when the node has run: its flag is
    /// cleared.
    Moved,
    /// The expression statement throws away the owned value it makes: it is
    /// dropped once the statement has run.
    Discard,
    /// The assignment `rs[i] = v` drops the element it replaces once `v` is
    /// made and before it is stored; the row names the collection's type,
    /// whose glue walks its elements.
    ReplaceElement,
    /// The node is the receiver of a method call and has the named type
    /// (selfhost/check/receivers.pilot); the seed reads it where it cannot
    /// tell the receiver's type itself.
    ReceiverType,
    /// The node is arithmetic whose result has the named numeric type, of
    /// another width than the engine's numbers (selfhost/check/numeric.pilot).
    NumericType,
    /// The node is `x is T`: the kind of value `T` holds and `T`'s name
    /// (selfhost/check/type_tests.pilot).
    TypeTest,
}

/// What planning the drops of one program keeps.
pub struct DropPlanner : IObject {
    pub flow: Flow;
    pub rows: List<List<any>>;
    /// Type display -> 1 needs dropping, 0 not, 2 a collection of values
    /// that do (not supported yet).
    pub needs: Map<str, i64>;
    /// Type display -> met again while its verdict was being decided.
    pub cyclic: Map<str, bool>;
    /// Type display -> its glue row was written.
    pub glued: Map<str, bool>;
    /// Node -> the rows naming it, for a reader in the same program (the
    /// PilIR lowering): `[action, binding, type, a, b]`, with the binding
    /// index and type id being planned (-1 and the unknown type for a copy's
    /// binding).
    pub at: Map<str, List<List<any>>>;
    /// The binding and type being planned.
    pub cur_binding: i64;
    pub cur_type: i64;
    /// What views and guards borrow (selfhost/check/borrows.pilot).
    pub borrows: Borrows;
    /// The bindings that borrow from the binding being planned: it lives
    /// until their last use too.
    pub borrowers: List<i64>;
    /// Whether the binding being planned is moved on only some paths, so
    /// its drops depend on a flag kept at run time.
    pub flagged: bool;
}

pub fn row(pl: DropPlanner, action: DropAction, n: i64, a: str, b: str) {
    let s = pl.flow.inf.p.s;
    pl.rows.push([action as i64, span_start(s, n), span_end(s, n), kind(s, n), a, b]);
    let k = f"{n}";
    if !pl.at.has(k) { pl.at.set(k, []); }
    pl.at.get(k).push([action as i64, pl.cur_binding, pl.cur_type, a, b]);
}

/// The struct declaration of named type `t`, or -1.
pub fn struct_decl(p: Program, t: i64) -> i64 {
    if !ty_is_named(p.tt, t) { return -1; }
    let d = ty_decl(p.tt, t);
    return if d >= 0 && kind(p.s, d) == nk_struct() { d } else { -1 };
}

/// Whether struct `d` declares a destructor with something in it: running
/// an empty `~self() {}` does nothing, so it needs no drop.
fn has_dtor(p: Program, d: i64) -> bool {
    for m in type_members(p.s, d) {
        if kind(p.s, m) == nk_dtor() {
            let body = lhs(p.s, m);
            return body < 0 || kind(p.s, body) != nk_block() || children(p.s, body).len() > 0;
        }
    }
    return false;
}

/// Field name and type of each stored field of struct type `t`.
pub fn stored_fields(p: Program, t: i64) -> List<List<any>> {
    var out: List<List<any>> = [];
    let d = struct_decl(p, t);
    if d < 0 { return out; }
    for slot in build_type(p, node_name(p.s, d), 0).plan.physical_fields {
        if some m = prog_member(p, t, slot.canonical_name) {
            out.push([slot.canonical_name, prog_member_type(p, m)]);
        }
    }
    return out;
}

/// 1 when a value of type `t` needs dropping (its destructor, its fields,
/// the elements a collection owns: `owned_elements`, or an optional's
/// payload: `owned_payload`), 2 when it holds values that do some other way
/// (a result, a tuple, another generic, or a type that holds itself through
/// its elements), else 0.
pub fn needs_drop(pl: DropPlanner, t: i64, depth: i64) -> i64 {
    let p = pl.flow.inf.p;
    if !owns(pl.flow, t) || depth > 16 { return 0; }
    let key = ty_display(p.tt, t);
    if pl.needs.has(key) {
        // -1: met again while it is being decided, so it holds itself. That
        // matters only if it needs dropping, decided below.
        let known = pl.needs.get(key);
        if known < 0 {
            pl.cyclic.set(key, true);
            return 0;
        }
        return known;
    }
    pl.needs.set(key, -1);
    var verdict = 0;
    // A collection that owns its elements is held by the engine itself: its
    // declared fields are not what runs.
    let pt = owned_payload(pl.flow, t);
    let has_payload = !ty_is_unknown(p.tt, pt);
    let held = owned_elements(pl.flow, t).len() > 0 || has_payload;
    let d = if held { -1 } else { struct_decl(p, t) };
    if d >= 0 {
        if has_dtor(p, d) { verdict = 1; }
        for fl in stored_fields(p, t) {
            let ft: i64 = fl[1];
            let v = needs_drop(pl, ft, depth + 1);
            if v == 2 { verdict = 2; } else if v == 1 && verdict == 0 { verdict = 1; }
        }
    }
    if ty_is_named(p.tt, t) {
        // A collection that owns its elements drops each, an optional its
        // payload; any other generic holding values that need dropping stops
        // at a seam.
        let elem = if owned_elements(pl.flow, t).len() > 0 { owned_element_type(p, t) } else { ty_unknown() };
        for a in ty_args(p.tt, t) {
            let v = needs_drop(pl, a, depth + 1);
            if (a == elem || (has_payload && a == pt)) && v == 1 { if verdict == 0 { verdict = 1; } }
            else if v != 0 { verdict = 2; }
        }
    }
    // A type that needs dropping and holds itself would need glue as deep
    // as its values are.
    if verdict == 1 && pl.cyclic.has(key) { verdict = 2; }
    pl.needs.set(key, verdict);
    return verdict;
}

/// Writes the glue rows of `t` and of the field and element types it drops.
fn glue(pl: DropPlanner, t: i64) {
    let p = pl.flow.inf.p;
    let key = ty_display(p.tt, t);
    if pl.glued.has(key) { return; }
    pl.glued.set(key, true);
    let ops = owned_elements(pl.flow, t);
    let pt = owned_payload(pl.flow, t);
    var payload_key = "";
    var absent_op = "";
    if !ty_is_unknown(p.tt, pt) && needs_drop(pl, pt, 0) == 1 {
        payload_key = ty_display(p.tt, pt);
        absent_op = payload_absent_op(pl.flow, t);
        glue(pl, pt);
    }
    let d = if ops.len() > 0 || payload_key != "" { -1 } else { struct_decl(p, t) };
    var fields: List<str> = [];
    for fl in stored_fields(p, t) {
        let ft: i64 = fl[1];
        if d >= 0 && needs_drop(pl, ft, 0) == 1 {
            fields.push(fl[0]);
            fields.push(ty_display(p.tt, ft));
            glue(pl, ft);
        }
    }
    let owner = if d >= 0 && has_dtor(p, d) { node_name(p.s, d) } else { "" };
    var elem_key = "";
    var len_op = "";
    var get_op = "";
    var seq_op = "";
    if ops.len() == 4 {
        let et = owned_element_type(p, t);
        if needs_drop(pl, et, 0) == 1 {
            elem_key = ty_display(p.tt, et);
            len_op = ops[0];
            get_op = ops[1];
            seq_op = ops[2];
            glue(pl, et);
        }
    }
    pl.rows.push([DropAction::Glue as i64, key, owner, fields, elem_key, len_op, get_op, seq_op, payload_key, absent_op]);
}

// --- Walking the tree --------------------------------------------------------

fn uses(pl: DropPlanner, n: i64, b: i64) -> bool {
    if n < 0 { return false; }
    let s = pl.flow.inf.p.s;
    if kind(s, n) == nk_ident() {
        let at = pl.flow.inf.r.ref_of[n];
        if at == b { return true; }
        for v in pl.borrowers { if at == v { return true; } }
    }
    for c in children(s, n) { if uses(pl, c, b) { return true; } }
    return false;
}

/// The identifiers naming `b` inside `n`.
fn refs(pl: DropPlanner, n: i64, b: i64, out: List<i64>) {
    if n < 0 { return; }
    let s = pl.flow.inf.p.s;
    if kind(s, n) == nk_ident() && pl.flow.inf.r.ref_of[n] == b { out.push(n); }
    for c in children(s, n) { refs(pl, c, b, out); }
}

/// Whether `inner` lies inside node `outer` (or is it).
fn nested_in(s: Snap, inner: i64, outer: i64) -> bool =>
    span_start(s, inner) >= span_start(s, outer) && span_end(s, inner) <= span_end(s, outer);

/// The first node of `kinds` on the path from `n` up to (not including)
/// `stop`, or -1.
fn ancestor_of_kind(pl: DropPlanner, n: i64, stop: i64, kinds: List<i64>) -> i64 {
    let p = pl.flow.inf.p;
    var at = p.parents[n];
    while at >= 0 && at != stop {
        for k in kinds { if kind(p.s, at) == k { return at; } }
        at = p.parents[at];
    }
    return -1;
}

/// The loop a `break` / `continue` leaves.
fn loop_of(pl: DropPlanner, n: i64) -> i64 => ancestor_of_kind(pl, n, -1, [nk_while(), nk_for()]);

/// Writes `exit` rows for the jumps in `n` that leave the scope of `b`
/// (declared at `site`) while it is live.
fn exits(pl: DropPlanner, n: i64, b: i64, site: i64, key: str) {
    if n < 0 { return; }
    let s = pl.flow.inf.p.s;
    let k = kind(s, n);
    if k == nk_lambda() || k == nk_fn() { return; }
    if k == nk_return() {
        if !moves(pl, n, b) { row(pl, ::Exit, n, pl.flow.inf.r.name[b], key); }
        // A `?` in the returned value leaves before the return does.
        for c in children(s, n) { exits(pl, c, b, site, key); }
        return;
    }
    if k == nk_break() || k == nk_continue() {
        let lp = loop_of(pl, n);
        let leaves = lp >= 0 && nested_in(s, site, lp);
        if leaves { row(pl, ::Exit, n, pl.flow.inf.r.name[b], key); }
        return;
    }
    if k == nk_try_propagate() { try_exit(pl, n, b, site, key); }
    for c in children(s, n) { exits(pl, c, b, site, key); }
}

/// The `try` block that a failed `?` (node `n`) jumps out of, inside the
/// same function, or -1 when it leaves the function.
fn try_region(pl: DropPlanner, n: i64) -> i64 {
    let p = pl.flow.inf.p;
    let s = p.s;
    var at = p.parents[n];
    while at >= 0 {
        let k = kind(s, at);
        if k == nk_fn() || k == nk_operator() || k == nk_lambda() { return -1; }
        if k == nk_try() {
            let ch = children(s, at);
            if ch.len() > 0 && nested_in(s, n, ch[0]) { return ch[0]; }
        }
        at = p.parents[at];
    }
    return -1;
}

/// The statement of a block that `n` lies in.
fn statement_of(pl: DropPlanner, n: i64) -> i64 {
    let p = pl.flow.inf.p;
    var at = n;
    while p.parents[at] >= 0 && kind(p.s, p.parents[at]) != nk_block() { at = p.parents[at]; }
    return at;
}

/// A `?` (node `n`) reached while `b` is live. A failure leaves the
/// function, or jumps to the `catch` of a `try` block in it. Leaving `b`'s
/// scope either way (the function, or the try block `b` was declared in),
/// it drops `b` unless its operand moved it; jumping to a `catch` that `b`
/// is still in scope for keeps it (the statement holding the `try` drops
/// it). In a statement that also moves `b`, the drop depends on `b`'s flag.
fn try_exit(pl: DropPlanner, n: i64, b: i64, site: i64, key: str) {
    let s = pl.flow.inf.p.s;
    let name = pl.flow.inf.r.name[b];
    let region = try_region(pl, n);
    if region >= 0 && !nested_in(s, site, region) { return; }
    if moves(pl, lhs(s, n), b) { return; }
    // In a statement that also moves `b`, whether the move came first is
    // known only at run time: the flag says.
    if moves(pl, statement_of(pl, n), b) { pl.flagged = true; }
    row(pl, ::Exit, n, name, key);
}

/// Whether `n` moves `b`: some identifier naming it stands where it is
/// used by value.
fn moves(pl: DropPlanner, n: i64, b: i64) -> bool {
    var ids: List<i64> = [];
    refs(pl, n, b, ids);
    for i in ids { if is_move_position(pl.flow, i) { return true; } }
    return false;
}

/// A move of `b` in statement `n` that only some paths through `n` take.
fn conditional_move(pl: DropPlanner, n: i64, b: i64) -> bool {
    var ids: List<i64> = [];
    refs(pl, n, b, ids);
    for i in ids {
        if is_move_position(pl.flow, i) && ancestor_of_kind(pl, i, n, [nk_if(), nk_match(), nk_coalesce(), nk_binary()]) >= 0 {
            return true;
        }
    }
    return false;
}

fn is_loop(k: i64) -> bool => k == nk_while() || k == nk_for();

/// Places the drop of `b`, live on entry to `n` and dead after it.
fn place(pl: DropPlanner, n: i64, b: i64, site: i64, key: str) {
    let s = pl.flow.inf.p.s;
    let name = pl.flow.inf.r.name[b];
    let k = kind(s, n);
    if k == nk_block() {
        place_seq(pl, n, children(s, n), 0, b, site, key, true);
        return;
    }
    if k == nk_if() {
        let ch = children(s, n);
        // A condition that moves it (`if some y = c`) leaves nothing to drop;
        // one that may move it leaves the branches' drops behind its flag.
        if ch.len() > 0 && moves_always(pl, ch[0], b) { return; }
        if ch.len() > 0 && moves(pl, ch[0], b) { pl.flagged = true; }
        var i = 1;
        while i < ch.len() {
            if uses(pl, ch[i], b) { place(pl, ch[i], b, site, key); } else { row(pl, ::Before, ch[i], name, key); }
            i = i + 1;
        }
        if ch.len() < 3 { row(pl, ::Else, n, name, key); }
        return;
    }
    if is_loop(k) || k == nk_match() {
        exits(pl, n, b, site, key);
        row(pl, ::After, n, name, key);
        return;
    }
    if k == nk_return() || k == nk_break() || k == nk_continue() {
        exits(pl, n, b, site, key);
        return;
    }
    if moves(pl, n, b) {
        // A `?` before the move completes leaves with the value still ours.
        exits(pl, n, b, site, key);
        if conditional_move(pl, n, b) {
            // Dropped after the statement on the paths that did not move it.
            pl.flagged = true;
            row(pl, ::After, n, name, key);
        }
        return;
    }
    exits(pl, n, b, site, key);
    row(pl, ::After, n, name, key);
}

/// Places the drop of `b` among `stmts[from..]` of block `blk`. With
/// `at_entry`, a block that never uses `b` drops it as it starts.
fn place_seq(pl: DropPlanner, blk: i64, stmts: List<i64>, from: i64, b: i64, site: i64, key: str, at_entry: bool) -> bool {
    var last = -1;
    var i = from;
    while i < stmts.len() {
        if uses(pl, stmts[i], b) { last = i; }
        i = i + 1;
    }
    if last < 0 {
        if at_entry { row(pl, ::Before, blk, pl.flow.inf.r.name[b], key); }
        return false;
    }
    i = from;
    while i < last {
        exits(pl, stmts[i], b, site, key);
        i = i + 1;
    }
    place(pl, stmts[last], b, site, key);
    return true;
}

/// The statement of block `blk` that `n` lies in, as its index, or -1.
fn index_in(s: Snap, stmts: List<i64>, n: i64) -> i64 {
    var i = 0;
    while i < stmts.len() {
        if nested_in(s, n, stmts[i]) { return i; }
        i = i + 1;
    }
    return -1;
}

/// Whether `b` is moved by `st` on every path through it: a move standing
/// outside any branch, short-circuit, loop or closure inside `st`.
fn moves_always(pl: DropPlanner, st: i64, b: i64) -> bool {
    let s = pl.flow.inf.p.s;
    let k = kind(s, st);
    let branching: List<i64> = [nk_if(), nk_match(), nk_coalesce(), nk_binary(), nk_while(), nk_for(), nk_lambda()];
    for x in branching { if k == x { return false; } }
    var ids: List<i64> = [];
    refs(pl, st, b, ids);
    for i in ids {
        if is_move_position(pl.flow, i) && ancestor_of_kind(pl, i, st, branching) < 0 { return true; }
    }
    return false;
}

/// Whether `b`, which may have been moved before assignment `n`, was moved
/// on every path: by `n`'s own right-hand side, or by an earlier statement
/// of the same block with no assignment to `b` after it.
fn moved_before(pl: DropPlanner, n: i64, b: i64) -> bool {
    let p = pl.flow.inf.p;
    let s = p.s;
    if moves_always(pl, rhs(s, n), b) { return true; }
    let blk = p.parents[n];
    if blk < 0 || kind(s, blk) != nk_block() { return false; }
    let stmts = children(s, blk);
    var i = index_in(s, stmts, n) - 1;
    while i >= 0 {
        let st = stmts[i];
        if assigns(pl, st, b) { return false; }
        if moves(pl, st, b) { return moves_always(pl, st, b); }
        i = i - 1;
    }
    return false;
}

/// Whether `n` assigns `b` a new value somewhere inside it.
fn assigns(pl: DropPlanner, n: i64, b: i64) -> bool {
    let p = pl.flow.inf.p;
    var ids: List<i64> = [];
    refs(pl, n, b, ids);
    for i in ids {
        let up = p.parents[i];
        if up >= 0 && kind(p.s, up) == nk_assign() && lhs(p.s, up) == i { return true; }
    }
    return false;
}

/// Writes a `Replace` row on each assignment to `b` that may find it holding
/// a value (flagging `b` when it was moved on only some paths before), and
/// a seam row on every closure that captures it; true when there is a seam.
fn unsupported_uses(pl: DropPlanner, body: i64, b: i64, key: str) -> bool {
    let s = pl.flow.inf.p.s;
    var ids: List<i64> = [];
    refs(pl, body, b, ids);
    var found = false;
    let name = pl.flow.inf.r.name[b];
    for i in ids {
        let up = pl.flow.inf.p.parents[i];
        if up >= 0 && kind(s, up) == nk_assign() && lhs(s, up) == i {
            let at = f"{up}";
            let maybe = pl.flow.moved_at.has(at) && pl.flow.moved_at.get(at);
            if !maybe { row(pl, ::Replace, up, name, key); }
            else if !moved_before(pl, up, b) {
                // Moved on some paths only: the flag says whether to drop.
                pl.flagged = true;
                row(pl, ::Replace, up, name, key);
            }
        }
        let lam = ancestor_of_kind(pl, i, body, [nk_lambda()]);
        if lam >= 0 {
            row(pl, ::Seam, lam, "own.capture", f"a closure capturing `{name}` owns it; dropping it with the closure comes with the PilIR drop pass (F7)");
            found = true;
        }
    }
    return found;
}

/// Plans the drops of binding `b` in the function whose body is `body`.
fn plan_binding(pl: DropPlanner, b: i64, body: i64) {
    let f = pl.flow;
    let p = f.inf.p;
    let s = p.s;
    let r = f.inf.r;
    let kindof = r.bind_kind[b];
    if kindof != BindKind::Local && kindof != BindKind::Param && kindof != BindKind::Unwrapped { return; }
    if kindof == BindKind::Param && flags(s, r.site[b]) != 0 { return; }
    // `let x = rs[i]` borrows the element; `rs` drops it.
    if borrows_element(f, b) { return; }
    let t = flow_binding_type(f, b);
    pl.cur_binding = b;
    pl.cur_type = t;
    pl.borrowers = borrowers_of(pl.borrows, b);
    pl.flagged = false;
    let need = needs_drop(pl, t, 0);
    if need == 0 { return; }
    let key = ty_display(p.tt, t);
    let site = r.site[b];
    let scope = if kindof == BindKind::Unwrapped { unwrap_scope(pl, site) } else { [] };
    if kindof == BindKind::Unwrapped && scope.len() == 0 { return; }
    let decl = if kindof == BindKind::Local { site } else if kindof == BindKind::Unwrapped { scope[0] } else { body };
    if need == 2 {
        row(pl, ::Seam, decl, "own.collection_drop", f"`{r.name[b]}` holds values that need dropping inside a result, a tuple or another generic, or a type that holds itself; dropping those comes with the PilIR drop pass (F7)");
        return;
    }
    glue(pl, t);
    if unsupported_uses(pl, body, b, key) { return; }
    if declares_guard(p, t) && kindof == BindKind::Local {
        row(pl, ::Guard, site, r.name[b], key);
        return;
    }
    if kindof == BindKind::Param {
        place_seq(pl, body, children(s, body), 0, b, body, key, true);
    } else if kindof == BindKind::Unwrapped {
        // `if some x = o { .. }`: the branch's statements, dropped as the
        // branch starts when it never uses `x`. `guard some x = o else ..;`:
        // the statements after the guard.
        let blk = scope[1];
        let from = scope[2];
        if !place_seq(pl, blk, children(s, blk), from, b, site, key, from == 0) && from > 0 {
            row(pl, ::After, scope[0], r.name[b], key);
        }
    } else {
        // A local: the statements after its declaration in its block.
        let blk = p.parents[site];
        if blk < 0 || kind(s, blk) != nk_block() { return; }
        let stmts = children(s, blk);
        let at = index_in(s, stmts, site);
        if !place_seq(pl, blk, stmts, at + 1, b, site, key, false) {
            row(pl, ::After, site, r.name[b], key);
        }
    }
    if pl.flagged { flag_rows(pl, b, decl, body, key); }
}

/// Where the binding an unwrap (`if some x = o`, `guard some x = o`) makes
/// at identifier `site` lives: `[decl, block, first statement]`, where
/// `decl` is the `if`'s branch or the guard statement; empty when the shape
/// is not one of these.
fn unwrap_scope(pl: DropPlanner, site: i64) -> List<i64> {
    let p = pl.flow.inf.p;
    let s = p.s;
    let a = p.parents[site];
    if a < 0 || kind(s, a) != nk_assign() { return []; }
    let up = p.parents[a];
    if up < 0 { return []; }
    if kind(s, up) == nk_guard() {
        let blk = ancestor_of_kind(pl, up, -1, [nk_block()]);
        if blk < 0 { return []; }
        let stmts = children(s, blk);
        let at = index_in(s, stmts, up);
        if at < 0 { return []; }
        return [stmts[at], blk, at + 1];
    }
    let cond = up;
    let iff = p.parents[cond];
    if iff < 0 || kind(s, iff) != nk_if() { return []; }
    let ch = children(s, iff);
    if ch.len() < 2 || ch[0] != cond || kind(s, ch[1]) != nk_block() { return []; }
    return [ch[1], ch[1], 0];
}

/// The node where a move of `b` through identifier `i` completes: the call
/// it is passed to, or the list, tuple or struct literal it is put in; else
/// the identifier itself (bound, assigned or returned).
fn move_completes_at(pl: DropPlanner, i: i64) -> i64 {
    let p = pl.flow.inf.p;
    let s = p.s;
    var up = p.parents[i];
    if up < 0 { return i; }
    if kind(s, up) == nk_call_arg() { up = p.parents[up]; }
    else if kind(s, up) == nk_map() && p.parents[up] >= 0 && kind(s, p.parents[up]) == nk_call() { up = p.parents[up]; }
    if up >= 0 && (kind(s, up) == nk_call() || kind(s, up) == nk_list() || kind(s, up) == nk_tuple()) { return up; }
    return i;
}

/// The rows a flagged binding `b` needs: its flag at `decl`, cleared where
/// each move of it completes, and a `Replace` on every assignment (which
/// sets it again).
fn flag_rows(pl: DropPlanner, b: i64, decl: i64, body: i64, key: str) {
    let p = pl.flow.inf.p;
    let s = p.s;
    let name = pl.flow.inf.r.name[b];
    row(pl, ::Flag, decl, name, key);
    var ids: List<i64> = [];
    refs(pl, body, b, ids);
    for i in ids {
        if ancestor_of_kind(pl, i, body, [nk_lambda()]) >= 0 { continue; }
        let up = p.parents[i];
        if up >= 0 && kind(s, up) == nk_assign() && lhs(s, up) == i {
            if !has_row(pl, up, DropAction::Replace) { row(pl, ::Replace, up, name, key); }
            continue;
        }
        if is_move_position(pl.flow, i) {
            let at = move_completes_at(pl, i);
            if !has_row(pl, at, DropAction::Moved) { row(pl, ::Moved, at, name, key); }
        }
    }
}

/// Whether node `n` already has a row of `action` for the binding being
/// planned.
fn has_row(pl: DropPlanner, n: i64, action: DropAction) -> bool {
    let k = f"{n}";
    if !pl.at.has(k) { return false; }
    for r in pl.at.get(k) {
        let a: i64 = r[0];
        let b: i64 = r[1];
        if a == action as i64 && b == pl.cur_binding { return true; }
    }
    return false;
}

/// A planner over `inf` that has planned the drops of every function body
/// in the user's files.
pub fn drop_planner(inf: Infer) -> DropPlanner {
    let s = inf.p.s;
    let f = flow_new(inf, sink_new(s));
    // The moves before each assignment (moved_at); OWN001 is reported by
    // check_program, not here.
    walk_bodies(f);
    let pl = DropPlanner {
        flow: f, rows: [], needs: Map<str, i64>(), cyclic: Map<str, bool>(), glued: Map<str, bool>(),
        at: Map<str, List<List<any>>>(), cur_binding: -1, cur_type: ty_unknown(),
        borrows: borrows_new(f), borrowers: [], flagged: false,
    };
    var b = 0;
    while b < inf.r.site.len() {
        let owner = inf.r.owner[b];
        if owner >= 0 && in_user_file(s, owner) && is_owned_binding(f, b) {
            let k = kind(s, owner);
            let body = if k == nk_lambda() { rhs(s, owner) } else if k == nk_fn() || k == nk_operator() { fn_body(s, owner) } else { -1 };
            if body >= 0 && kind(s, body) == nk_block() { plan_binding(pl, b, body); }
        }
        b = b + 1;
    }
    var n = 0;
    while n < s.count {
        if kind(s, n) == nk_expr_stmt() && in_user_file(s, n) { plan_discard(pl, n); }
        if kind(s, n) == nk_assign() && in_user_file(s, n) { plan_element_replace(pl, n); }
        n = n + 1;
    }
    return pl;
}

/// Whether `n`, an identifier, names the receiver of the method it is in.
fn names_receiver(s: Snap, n: i64) -> bool => s.receiver != "" && kind(s, n) == nk_ident() && node_name(s, n) == s.receiver;

/// Whether some value `body` gives may be the receiver itself: an
/// expression body that is it, or a `return` of it.
fn may_give_receiver(s: Snap, body: i64) -> bool {
    if body < 0 { return false; }
    if names_receiver(s, body) { return true; }
    if kind(s, body) == nk_block() {
        var out = false;
        for c in children(s, body) { if gives_receiver(s, c) { out = true; } }
        return out;
    }
    return false;
}

fn gives_receiver(s: Snap, n: i64) -> bool {
    if n < 0 { return false; }
    let k = kind(s, n);
    if k == nk_lambda() || k == nk_fn() { return false; }
    if k == nk_return() && lhs(s, n) >= 0 && names_receiver(s, lhs(s, n)) { return true; }
    for c in children(s, n) { if gives_receiver(s, c) { return true; } }
    return false;
}

/// Whether call `c` makes a new value: a function's, a constructor's or a
/// struct literal's result, or a method's that is not the receiver handed
/// back. A method returning its receiver's own type with no body (an engine
/// method such as `push`) is taken to hand the receiver back.
fn makes_new_value(pl: DropPlanner, c: i64) -> bool {
    let f = pl.flow;
    let s = f.inf.p.s;
    let ch = children(s, c);
    if ch.len() == 0 || kind(s, ch[0]) != nk_member() { return true; }
    let recv_t = type_of(f.inf, lhs(s, ch[0]));
    if type_of(f.inf, c) != recv_t { return true; }
    let target = call_target(f, c);
    if target < 0 { return false; }
    let body = fn_body(s, target);
    return body >= 0 && !may_give_receiver(s, body);
}

/// Plans the drop of the element assignment `n` (`rs[i] = v`) replaces in a
/// collection that owns its elements.
fn plan_element_replace(pl: DropPlanner, n: i64) {
    let f = pl.flow;
    let s = f.inf.p.s;
    let target = lhs(s, n);
    if !is_owned_element(f, target) { return; }
    let t = type_of(f.inf, lhs(s, target));
    pl.cur_binding = -1;
    pl.cur_type = t;
    let need = needs_drop(pl, owned_element_type(f.inf.p, t), 0);
    if need == 0 { return; }
    if need == 2 || flags(s, n) != 0 {
        row(pl, ::Seam, n, "own.collection_drop", f"the element this assignment replaces holds values that need dropping inside a result, a tuple or another generic, or a type that holds itself, or is updated in place; dropping those comes with the PilIR drop pass (F7)");
        return;
    }
    let lookup: str = owned_elements(f, t)[3];
    glue(pl, t);
    row(pl, ::ReplaceElement, n, lookup, ty_display(f.inf.p.tt, t));
}


/// Plans the drop of the owned value expression statement `n` makes and
/// throws away (a statement ending in `;`, not a block's value).
fn plan_discard(pl: DropPlanner, n: i64) {
    let f = pl.flow;
    let s = f.inf.p.s;
    let e = lhs(s, n);
    if e < 0 || kind(s, e) != nk_call() || span_end(s, n) == span_end(s, e) { return; }
    let t = type_of(f.inf, e);
    let need = needs_drop(pl, t, 0);
    if need == 0 || !makes_new_value(pl, e) { return; }
    pl.cur_binding = -1;
    pl.cur_type = t;
    if need == 2 {
        row(pl, ::Seam, n, "own.collection_drop", f"the value this statement throws away holds values that need dropping inside a result, a tuple or another generic, or a type that holds itself; dropping those comes with the PilIR drop pass (F7)");
        return;
    }
    glue(pl, t);
    row(pl, ::Discard, n, "", ty_display(f.inf.p.tt, t));
}
