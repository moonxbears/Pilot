// ==============================================================================
// FILE: selfhost/check/own.pilot
// OWN001: using an owned value after it was moved.
// OWN004: moving out an element a collection owns.
// ==============================================================================
// A local or parameter whose type is owned (lattice bit 1) is moved when it
// is used by value: bound by `let`/`var`, assigned, returned, put in a list
// or struct literal, or passed for a plain parameter (one written without
// `ref`, `var`, `iso` or `comptime`) of the function or method the call
// resolves to. Reading a field of it, calling a method on it or comparing it
// is not a move. Unwrapping it (`o?`, `o ?? d`, `if some x = o`) moves it.
// Assigning the binding a new value makes it usable again.
//
// Each function body is walked in evaluation order with the set of bindings
// that may have been moved:
//   - `if` and `switch` branches start from the same set; after them, a
//     binding moved on any branch that can fall through may have been moved;
//   - a loop body is walked twice, the second time from what the first left,
//     so a move in one iteration reaches the uses of the next; bindings
//     declared inside the loop are fresh on every iteration;
//   - after `return`, the rest of the block is not reached;
//   - creating a closure reads what it captures (a binding moved before is
//     reported at its use inside the closure) and moves each captured owned
//     binding the closure's body moves, whether or not it is ever called.
// Each closure body is also walked on its own, for its own bindings.
//
// A collection whose type the engine bindings name as owning its elements
// (`bind_owned_elements`) drops them with itself. Reading one by index, or
// walking them with `for`, borrows it: `let x = rs[i]` and `for x in rs`
// make `x` a borrower of `rs` (selfhost/check/borrows.pilot), never dropped
// itself. Moving the element, or a binding borrowing it, is OWN004.
pub lvl(0) pkg selfhost.check;


pub struct Flow {
    pub ref inf: Infer;
    pub ref sink: DiagSink;
    /// Binding -> whether its type is owned, once asked.
    pub owned: Map<i64, bool>;
    /// Assignment to a local -> whether, on some walk, the local may have
    /// been moved just before it is assigned (`walk_bodies` fills it).
    pub moved_at: Map<str, bool>;
    /// The program's engine bindings (`prog_engine_bindings`).
    pub engine: List<List<str>>;
    /// Binding -> whether it borrows an owned element, once asked.
    pub element: Map<i64, bool>;
    /// Parameter -> the `param_flag_*` bits to read it with in place of the
    /// written ones: what `pilot check --fix` proposes (fix_borrows.pilot).
    pub assumed: Map<i64, i64>;
}

/// A flow over the program `inf` describes, reporting to `sink`.
pub fn flow_new(var ref inf: Infer, ref sink: DiagSink) -> Flow {
    return Flow {
        inf: inf, sink: sink, owned: Map<i64, bool>(), moved_at: Map<str, bool>(),
        engine: prog_engine_bindings(inf.p), element: Map<i64, bool>(),
        assumed: Map<i64, i64>(),
    };
}

/// The binding hook naming a type the engine holds whose elements it owns,
/// with the engine operations that give its length and its element at a
/// position (stdlib/core/builtins/native_calls.pilot).
pub pure fn owned_elements_hook() -> str => "bind_owned_elements";

/// The type of the elements a collection of type `t` owns: what its `[]`
/// gives (a map's values), else what iterating it gives.
pub fn owned_element_type(var ref p: Program, t: i64) -> i64 {
    if some m = prog_member(p, t, op_index()) { return prog_member_type(p, m); }
    return element_type(p, t);
}

/// When values of `t` own their elements and those elements are owned, the
/// engine operations that reach them: `[length, element at, sequence,
/// lookup]`. A non-empty `sequence` first turns the collection into a list of
/// its elements (a map's values) that `length` and `element at` walk by
/// position; `lookup` reads the element an index or key names, or none when
/// a key is absent. Else empty.
pub fn owned_elements(ref f: Flow, t: i64) -> List<str> {
    let p = f.inf.p;
    if !ty_is_named(p.tt, t) || !prog_is_owned(p, owned_element_type(p, t)) { return []; }
    let name = p.tt.name[t];
    for row in f.engine {
        if row.len() == 6 && row[0] == owned_elements_hook() && row[1] == name { return [row[2], row[3], row[4], row[5]]; }
    }
    return [];
}

/// The binding hook naming a type the engine holds as its payload itself, or
/// as none (stdlib/core/option.pilot): the member whose type is the payload,
/// and the engine operation that tests for none.
pub pure fn owned_payload_hook() -> str => "bind_owned_payload";

/// The payload type of `t` when the engine holds a value of `t` as its
/// payload or none and the payload is owned; else the unknown type.
pub fn owned_payload(ref f: Flow, t: i64) -> i64 {
    let p = f.inf.p;
    if !ty_is_named(p.tt, t) { return ty_unknown(); }
    let name = p.tt.name[t];
    for row in f.engine {
        if row.len() == 4 && row[0] == owned_payload_hook() && row[1] == name {
            if some m = prog_member(p, t, row[2]) {
                let pt = prog_member_type(p, m);
                if prog_is_owned(p, pt) { return pt; }
            }
        }
    }
    return ty_unknown();
}

/// Whether the engine bindings `engine` name `name` as a type the engine
/// holds itself (an optional kept as its payload or none, a collection): it
/// is not a record of its declared fields, so it is never copied field by
/// field.
pub fn engine_holds(ref engine: List<List<str>>, name: str) -> bool {
    for row in engine {
        if row.len() >= 2 && row[1] == name && (row[0] == owned_payload_hook() || row[0] == owned_elements_hook()) { return true; }
    }
    return false;
}

/// The engine operation that tests a value of `t` for none, when `t` has
/// an owned payload (`owned_payload`); else "".
pub fn payload_absent_op(ref f: Flow, t: i64) -> str {
    let p = f.inf.p;
    if !ty_is_named(p.tt, t) { return ""; }
    let name = p.tt.name[t];
    for row in f.engine {
        if row.len() == 4 && row[0] == owned_payload_hook() && row[1] == name { return row[3]; }
    }
    return "";
}

/// Whether values of `t` are owned: its lattice says so, or it holds a
/// value that is (an optional's payload, a result's value or error, any
/// generic argument).
pub fn owns(var ref f: Flow, t: i64) -> bool => owns_at(f.inf.p, t, 0);

fn owns_at(var ref p: Program, t: i64, depth: i64) -> bool {
    if prog_is_owned(p, t) { return true; }
    if depth > 8 || !ty_is_named(p.tt, t) { return false; }
    for a in ty_args(p.tt, t) {
        if owns_at(p, a, depth + 1) { return true; }
    }
    return false;
}

/// Whether `n` reads an element that a collection owns (`rs[i]`).
pub fn is_owned_element(var ref f: Flow, n: i64) -> bool {
    let s = f.inf.p.s;
    return n >= 0 && kind(s, n) == nk_index() && owned_elements(f, type_of(f.inf, lhs(s, n))).len() > 0;
}

/// Whether binding `b` borrows an element a collection owns: `let x = rs[i]`
/// or the variable of `for x in rs`. It is never dropped itself and cannot
/// be moved out (OWN004).
pub fn borrows_element(var ref f: Flow, b: i64) -> bool {
    if !f.element.has(b) {
        let r = f.inf.r;
        let s = f.inf.p.s;
        let src = r.source[b];
        var yes = false;
        if src >= 0 && r.bind_kind[b] == BindKind::Loop { yes = owned_elements(f, type_of(f.inf, src)).len() > 0; }
        else if src >= 0 && r.bind_kind[b] == BindKind::Local { yes = kind(s, r.site[b]) == nk_let() && is_owned_element(f, src); }
        f.element.set(b, yes);
    }
    return f.element[b];
}

/// OWN004: an element a collection owns, or a binding borrowing one, used
/// where it would be moved.
fn check_element_move(var ref f: Flow, n: i64, what: str) {
    let p = f.inf.p;
    let up = p.parents[n];
    // `let x = rs[i]` borrows the element.
    if up >= 0 && kind(p.s, up) == nk_let() && is_owned_element(f, n) { return; }
    if is_move_position(f, n) {
        sink_error(f.sink, n, "OWN004", f"{what} is owned by its collection and cannot be moved out of it; take it out with `pop` or `remove_at`");
    }
}

fn has(ref xs: List<i64>, b: i64) -> bool {
    for x in xs { if x == b { return true; } }
    return false;
}

fn copy(ref xs: List<i64>) -> List<i64> {
    var out: List<i64> = [];
    for x in xs { out.push(x); }
    return out;
}

fn add(var ref xs: List<i64>, b: i64) { if !has(xs, b) { xs.push(b); } }

fn union_into(var ref into: List<i64>, ref other: List<i64>) { for x in other { add(into, x); } }

fn drop_binding(ref xs: List<i64>, b: i64) -> List<i64> {
    var out: List<i64> = [];
    for x in xs { if x != b { out.push(x); } }
    return out;
}

pub fn is_owned_binding(var ref f: Flow, b: i64) -> bool {
    if !f.owned.has(b) {
        let r = f.inf.r;
        var t = ty_unknown();
        if r.annot[b] >= 0 { t = prog_annot_type(f.inf.p, r.annot[b]); }
        else if r.source[b] >= 0 && r.bind_kind[b] == BindKind::Local { t = type_of(f.inf, r.source[b]); }
        else if r.source[b] >= 0 && r.bind_kind[b] == BindKind::Unwrapped { t = owned_payload(f, type_of(f.inf, r.source[b])); }
        f.owned.set(b, owns(f, t));
    }
    return f.owned[b];
}

/// The declaration a call resolves to (a function, or a method of the
/// receiver's type), or -1.
pub fn call_target(ref f: Flow, call: i64) -> i64 {
    let inf = f.inf;
    let s = inf.p.s;
    let fnode = called_fn(inf, call);
    if fnode >= 0 { return fnode; }
    let ch = children(s, call);
    if ch.len() == 0 || kind(s, ch[0]) != nk_member() { return -1; }
    let callee = ch[0];
    if some m = prog_member(inf.p, type_of(inf, lhs(s, callee)), sym_text(s, rhs(s, callee))) {
        let k = kind(s, m.decl);
        if k == nk_fn() || k == nk_operator() { return m.decl; }
    }
    return -1;
}

/// Whether the identifier `n` is used by value where it stands.
pub fn is_move_position(var ref f: Flow, n: i64) -> bool {
    let p = f.inf.p;
    let s = p.s;
    let up = p.parents[n];
    if up < 0 { return false; }
    let k = kind(s, up);
    if k == nk_assign() && rhs(s, up) == n {
        // Storing into a `ref` field borrows the value.
        let target = lhs(s, up);
        if target >= 0 && kind(s, target) == nk_member() {
            return !is_ref_field(f, type_of(f.inf, lhs(s, target)), sym_text(s, rhs(s, target)));
        }
        return true;
    }
    if (k == nk_let() || k == nk_var() || k == nk_const() || k == nk_assign()) { return rhs(s, up) == n; }
    if k == nk_return() { return lhs(s, up) == n; }
    // `fn f(..) -> T => n` returns it: a move when `T` owns; returning it
    // as a view (`-> slice<T> => self.items[0]`) only lends it.
    if k == nk_fn() { return fn_body(s, up) == n && owns(f, fn_return_type(f.inf, up)); }
    // Unwrapping an optional or a result (`o?`, `o ?? d`) takes its payload.
    if k == nk_try_propagate() || k == nk_coalesce() { return true; }
    if k == nk_list() { return true; }
    if k == nk_map() {
        // A struct literal's value for a `ref` field is borrowed, not moved.
        let built = if p.parents[up] >= 0 { type_of(f.inf, p.parents[up]) } else { ty_unknown() };
        let ch = children(s, up);
        var i = 1;
        while i < ch.len() {
            if ch[i] == n { return !is_ref_field(f, built, node_name(s, ch[i - 1])); }
            i = i + 2;
        }
        return false;
    }
    if k == nk_call_arg() {
        // `name: value`: the parameter of that name.
        let call = p.parents[up];
        if call < 0 || kind(s, call) != nk_call() { return false; }
        let target = call_target(f, call);
        if target < 0 { return false; }
        for prm in fn_params(s, target) {
            if kind(s, prm) == nk_param() && node_name(s, prm) == node_name(s, up) { return by_value(f, prm); }
        }
        return false;
    }
    if k == nk_call() {
        let ch = children(s, up);
        let target = call_target(f, up);
        if target < 0 { return false; }
        let params = fn_params(s, target);
        var i = 1;
        while i < ch.len() {
            if ch[i] == n { return i - 1 < params.len() && by_value(f, params[i - 1]); }
            i = i + 1;
        }
    }
    return false;
}

/// Whether `field` of type `t` is declared `ref` (it borrows what it holds).
fn is_ref_field(var ref f: Flow, t: i64, field: str) -> bool {
    if some m = prog_member(f.inf.p, t, field) {
        let s = f.inf.p.s;
        return kind(s, m.decl) == nk_param() && flags(s, m.decl) != 0;
    }
    return false;
}

/// A parameter written without `ref`, `var`, `iso` or `comptime`.
pub fn plain_param(ref s: Snap, prm: i64) -> bool => kind(s, prm) == nk_param() && flags(s, prm) == 0;

/// The `param_flag_*` bits of parameter `prm`: the written ones, or those
/// `f.assumed` gives it.
pub fn flow_param_flags(ref f: Flow, prm: i64) -> i64 {
    if f.assumed.has(prm) { return f.assumed[prm]; }
    return flags(f.inf.p.s, prm);
}

/// Whether parameter `prm` takes its argument by value (it is plain), as
/// written or as `f.assumed` gives it.
pub fn by_value(ref f: Flow, prm: i64) -> bool => kind(f.inf.p.s, prm) == nk_param() && flow_param_flags(f, prm) == 0;

/// Whether parameter `prm` may change the value it is given: a `var ref`,
/// `var` or `iso` parameter. A plain `ref` parameter is a read-only borrow
/// (DECL004, consts.pilot check_consts).
pub fn may_change_param(ref f: Flow, prm: i64) -> bool {
    if kind(f.inf.p.s, prm) != nk_param() { return false; }
    let fl = flow_param_flags(f, prm);
    if fl == 0 { return false; }
    return (fl / param_flag_mutable()) % 2 == 1 || (fl / param_flag_isolated()) % 2 == 1 || (fl / param_flag_ref()) % 2 == 0;
}

/// Bindings declared inside node `n`, which are fresh each time it runs.
fn outside_of(ref f: Flow, ref xs: List<i64>, n: i64) -> List<i64> {
    let s = f.inf.p.s;
    var out: List<i64> = [];
    for b in xs {
        let site = f.inf.r.site[b];
        if !(span_start(s, site) >= span_start(s, n) && span_end(s, site) <= span_end(s, n)) { out.push(b); }
    }
    return out;
}

/// What walking a node leaves: the bindings that may be moved, and whether
/// control can still leave the node normally.
pub struct FlowState {
    pub moved: List<i64>;
    pub falls_through: bool;
}

fn flow_state(moved: List<i64>, falls: bool) -> FlowState => FlowState { moved: moved, falls_through: falls };

fn walk_seq(ref f: Flow, ref nodes: List<i64>, moved: List<i64>) -> FlowState {
    var cur = moved;
    for c in nodes {
        let st = walk(f, c, cur);
        cur = st.moved;
        if !st.falls_through { return flow_state(cur, false); }
    }
    return flow_state(cur, true);
}

/// Joins branch results: the moves of every branch that falls through.
fn join(ref branches: List<FlowState>) -> FlowState {
    var moved: List<i64> = [];
    var falls = false;
    for b in branches {
        if b.falls_through {
            union_into(moved, b.moved);
            falls = true;
        }
    }
    return flow_state(moved, falls);
}

fn walk_loop(ref f: Flow, n: i64, ref head: List<i64>, ref body: List<i64>, moved: List<i64>) -> FlowState {
    let entry = walk_seq(f, head, moved).moved;
    let first = walk_seq(f, body, copy(entry));
    var again = copy(entry);
    union_into(again, outside_of(f, first.moved, n));
    let second = walk_seq(f, body, again);
    var out = copy(entry);
    union_into(out, outside_of(f, second.moved, n));
    return flow_state(out, true);
}

fn walk(var ref f: Flow, n: i64, moved: List<i64>) -> FlowState {
    let inf = f.inf;
    let s = inf.p.s;
    if n < 0 { return flow_state(moved, true); }
    let k = kind(s, n);
    if k == nk_fn() || k == nk_operator() { return flow_state(moved, true); }
    if k == nk_lambda() {
        let inside = walk(f, rhs(s, n), copy(moved));
        var out = copy(moved);
        union_into(out, outside_of(f, inside.moved, n));
        return flow_state(out, true);
    }
    if k == nk_ident() {
        let b = inf.r.ref_of[n];
        if b < 0 { return flow_state(moved, true); }
        if has(moved, b) {
            sink_error(f.sink, n, "OWN001", f"`{inf.r.name[b]}` is used after it was moved");
            return flow_state(moved, true);
        }
        if borrows_element(f, b) {
            check_element_move(f, n, f"`{inf.r.name[b]}` borrows an element that");
            return flow_state(moved, true);
        }
        if is_owned_binding(f, b) && is_move_position(f, n) {
            var out = copy(moved);
            add(out, b);
            return flow_state(out, true);
        }
        return flow_state(moved, true);
    }
    if k == nk_index() && is_owned_element(f, n) { check_element_move(f, n, "this element"); }
    if k == nk_assign() {
        let st = walk(f, rhs(s, n), moved);
        let target = lhs(s, n);
        if target >= 0 && kind(s, target) == nk_ident() && inf.r.ref_of[target] >= 0 {
            let at = f"{n}";
            let was = f.moved_at.has(at) && f.moved_at[at];
            f.moved_at.set(at, was || has(st.moved, inf.r.ref_of[target]));
            return flow_state(drop_binding(st.moved, inf.r.ref_of[target]), st.falls_through);
        }
        return walk(f, target, st.moved);
    }
    if k == nk_return() {
        let st = walk(f, lhs(s, n), moved);
        return flow_state(st.moved, false);
    }
    if k == nk_break() || k == nk_continue() { return flow_state(moved, false); }
    if k == nk_if() {
        let ch = children(s, n);
        if ch.len() == 0 { return flow_state(moved, true); }
        let cond = walk(f, ch[0], moved);
        var branches: List<FlowState> = [];
        var i = 1;
        while i < ch.len() {
            branches.push(walk(f, ch[i], copy(cond.moved)));
            i = i + 1;
        }
        if ch.len() < 3 { branches.push(flow_state(cond.moved, true)); }
        return join(branches);
    }
    if k == nk_match() {
        let ch = children(s, n);
        if ch.len() == 0 { return flow_state(moved, true); }
        let scrut = walk(f, ch[0], moved);
        var branches: List<FlowState> = [];
        var i = 1;
        while i < ch.len() {
            branches.push(walk(f, rhs(s, ch[i]), copy(scrut.moved)));
            i = i + 1;
        }
        if branches.len() == 0 { return scrut; }
        return join(branches);
    }
    if k == nk_while() { return walk_loop(f, n, [lhs(s, n)], [rhs(s, n)], moved); }
    if k == nk_for() {
        let clause = flags(s, n) - 1;
        var head: List<i64> = [];
        if clause >= 0 && clause < s.for_clauses.len() {
            let c: List<i64> = s.for_clauses[clause];
            head.push(c[0]);
        }
        return walk_loop(f, n, head, [rhs(s, n)], moved);
    }
    return walk_seq(f, children(s, n), moved);
}

/// Walks every function body in the user's files: reports OWN001 to the
/// flow's sink and fills its `moved_at`.
pub fn walk_bodies(ref f: Flow) {
    let s = f.inf.p.s;
    var i = 0;
    i = s.user_lo;
    while i < s.user_hi {
        let k = kind(s, i);
        if (k == nk_fn() || k == nk_operator() || k == nk_lambda()) && in_user_file(s, i) {
            let body = if k == nk_lambda() { rhs(s, i) } else { fn_body(s, i) };
            if body >= 0 {
                let empty: List<i64> = [];
                let _ = walk(f, body, empty);
            }
        }
        i = i + 1;
    }
}

/// Runs OWN001 over every function body in the user's files.
pub fn check_ownership(var ref inf: Infer, ref sink: DiagSink) { walk_bodies(flow_new(inf, sink)); }
