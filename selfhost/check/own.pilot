// ==============================================================================
// FILE: selfhost/check/own.pilot
// OWN001: using an owned value after it was moved.
// ==============================================================================
// A local or parameter whose type is owned (lattice bit 1) is moved when it
// is used by value: bound by `let`/`var`, assigned, returned, put in a list
// or struct literal, or passed for a plain parameter (one written without
// `ref`, `var`, `iso` or `comptime`) of the function or method the call
// resolves to. Reading a field of it, calling a method on it or comparing it
// is not a move. Assigning the binding a new value makes it usable again.
//
// Each function body is walked in evaluation order with the set of bindings
// that may have been moved:
//   - `if` and `switch` branches start from the same set; after them, a
//     binding moved on any branch that can fall through may have been moved;
//   - a loop body is walked twice, the second time from what the first left,
//     so a move in one iteration reaches the uses of the next; bindings
//     declared inside the loop are fresh on every iteration;
//   - after `return`, the rest of the block is not reached;
//   - creating a closure reads what it captures (a binding moved before is
//     reported at its use inside the closure) and moves each captured owned
//     binding the closure's body moves, whether or not it is ever called.
// Each closure body is also walked on its own, for its own bindings.
pub lvl(0) pkg Pilot.SelfHost.Check.Own;

use selfhost.check.snapshot.*;
use selfhost.check.types.*;
use selfhost.check.program.*;
use selfhost.check.methods.*;
use selfhost.check.resolve.*;
use selfhost.check.infer.*;
use selfhost.check.diag.*;

pub struct Flow {
    pub inf: Infer;
    pub sink: DiagSink;
    /// Binding -> whether its type is owned: 1 owned, 0 not, -1 not asked.
    pub owned: List<i64>;
}

fn has(xs: List<i64>, b: i64) -> bool {
    for x in xs { if x == b { return true; } }
    return false;
}

fn copy(xs: List<i64>) -> List<i64> {
    var out: List<i64> = [];
    for x in xs { out.push(x); }
    return out;
}

fn add(xs: List<i64>, b: i64) { if !has(xs, b) { xs.push(b); } }

fn union_into(into: List<i64>, other: List<i64>) { for x in other { add(into, x); } }

fn drop_binding(xs: List<i64>, b: i64) -> List<i64> {
    var out: List<i64> = [];
    for x in xs { if x != b { out.push(x); } }
    return out;
}

pub fn is_owned_binding(f: Flow, b: i64) -> bool {
    if f.owned[b] < 0 {
        let r = f.inf.r;
        var t = ty_unknown();
        if r.annot[b] >= 0 { t = prog_annot_type(f.inf.p, r.annot[b]); }
        else if r.source[b] >= 0 && r.bind_kind[b] == BindKind::Local { t = type_of(f.inf, r.source[b]); }
        f.owned[b] = if prog_is_owned(f.inf.p, t) { 1 } else { 0 };
    }
    return f.owned[b] == 1;
}

/// The declaration a call resolves to (a function, or a method of the
/// receiver's type), or -1.
fn call_target(f: Flow, call: i64) -> i64 {
    let inf = f.inf;
    let s = inf.p.s;
    let fnode = called_fn(inf, call);
    if fnode >= 0 { return fnode; }
    let ch = children(s, call);
    if ch.len() == 0 || kind(s, ch[0]) != nk_member() { return -1; }
    let callee = ch[0];
    if some m = prog_member(inf.p, type_of(inf, lhs(s, callee)), sym_text(s, rhs(s, callee))) {
        let k = kind(s, m.decl);
        if k == nk_fn() || k == nk_operator() { return m.decl; }
    }
    return -1;
}

/// Whether the identifier `n` is used by value where it stands.
pub fn is_move_position(f: Flow, n: i64) -> bool {
    let p = f.inf.p;
    let s = p.s;
    let up = p.parents[n];
    if up < 0 { return false; }
    let k = kind(s, up);
    if k == nk_assign() && rhs(s, up) == n {
        // Storing into a `ref` field borrows the value.
        let target = lhs(s, up);
        if target >= 0 && kind(s, target) == nk_member() {
            return !is_ref_field(f, type_of(f.inf, lhs(s, target)), sym_text(s, rhs(s, target)));
        }
        return true;
    }
    if (k == nk_let() || k == nk_var() || k == nk_const() || k == nk_assign()) { return rhs(s, up) == n; }
    if k == nk_return() { return lhs(s, up) == n; }
    if k == nk_list() { return true; }
    if k == nk_map() {
        // A struct literal's value for a `ref` field is borrowed, not moved.
        let built = if p.parents[up] >= 0 { type_of(f.inf, p.parents[up]) } else { ty_unknown() };
        let ch = children(s, up);
        var i = 1;
        while i < ch.len() {
            if ch[i] == n { return !is_ref_field(f, built, node_name(s, ch[i - 1])); }
            i = i + 2;
        }
        return false;
    }
    if k == nk_call_arg() {
        // `name: value`: the parameter of that name.
        let call = p.parents[up];
        if call < 0 || kind(s, call) != nk_call() { return false; }
        let target = call_target(f, call);
        if target < 0 { return false; }
        for prm in fn_params(s, target) {
            if kind(s, prm) == nk_param() && node_name(s, prm) == node_name(s, up) { return plain_param(s, prm); }
        }
        return false;
    }
    if k == nk_call() {
        let ch = children(s, up);
        let target = call_target(f, up);
        if target < 0 { return false; }
        let params = fn_params(s, target);
        var i = 1;
        while i < ch.len() {
            if ch[i] == n { return i - 1 < params.len() && plain_param(s, params[i - 1]); }
            i = i + 1;
        }
    }
    return false;
}

/// Whether `field` of type `t` is declared `ref` (it borrows what it holds).
fn is_ref_field(f: Flow, t: i64, field: str) -> bool {
    if some m = prog_member(f.inf.p, t, field) {
        let s = f.inf.p.s;
        return kind(s, m.decl) == nk_param() && flags(s, m.decl) != 0;
    }
    return false;
}

/// A parameter written without `ref`, `var`, `iso` or `comptime`.
fn plain_param(s: Snap, prm: i64) -> bool => kind(s, prm) == nk_param() && flags(s, prm) == 0;

/// Bindings declared inside node `n`, which are fresh each time it runs.
fn outside_of(f: Flow, xs: List<i64>, n: i64) -> List<i64> {
    let s = f.inf.p.s;
    var out: List<i64> = [];
    for b in xs {
        let site = f.inf.r.site[b];
        if !(span_start(s, site) >= span_start(s, n) && span_end(s, site) <= span_end(s, n)) { out.push(b); }
    }
    return out;
}

/// What walking a node leaves: the bindings that may be moved, and whether
/// control can still leave the node normally.
pub struct FlowState {
    pub moved: List<i64>;
    pub falls_through: bool;
}

fn flow_state(moved: List<i64>, falls: bool) -> FlowState => FlowState { moved: moved, falls_through: falls };

fn walk_seq(f: Flow, nodes: List<i64>, moved: List<i64>) -> FlowState {
    var cur = moved;
    for c in nodes {
        let st = walk(f, c, cur);
        cur = st.moved;
        if !st.falls_through { return flow_state(cur, false); }
    }
    return flow_state(cur, true);
}

/// Joins branch results: the moves of every branch that falls through.
fn join(branches: List<FlowState>) -> FlowState {
    var moved: List<i64> = [];
    var falls = false;
    for b in branches {
        if b.falls_through {
            union_into(moved, b.moved);
            falls = true;
        }
    }
    return flow_state(moved, falls);
}

fn walk_loop(f: Flow, n: i64, head: List<i64>, body: List<i64>, moved: List<i64>) -> FlowState {
    let entry = walk_seq(f, head, moved).moved;
    let first = walk_seq(f, body, copy(entry));
    var again = copy(entry);
    union_into(again, outside_of(f, first.moved, n));
    let second = walk_seq(f, body, again);
    var out = copy(entry);
    union_into(out, outside_of(f, second.moved, n));
    return flow_state(out, true);
}

fn walk(f: Flow, n: i64, moved: List<i64>) -> FlowState {
    let inf = f.inf;
    let s = inf.p.s;
    if n < 0 { return flow_state(moved, true); }
    let k = kind(s, n);
    if k == nk_fn() || k == nk_operator() { return flow_state(moved, true); }
    if k == nk_lambda() {
        let inside = walk(f, rhs(s, n), copy(moved));
        var out = copy(moved);
        union_into(out, outside_of(f, inside.moved, n));
        return flow_state(out, true);
    }
    if k == nk_ident() {
        let b = inf.r.ref_of[n];
        if b < 0 { return flow_state(moved, true); }
        if has(moved, b) {
            sink_error(f.sink, n, "OWN001", f"`{inf.r.name[b]}` is used after it was moved");
            return flow_state(moved, true);
        }
        if is_owned_binding(f, b) && is_move_position(f, n) {
            var out = copy(moved);
            add(out, b);
            return flow_state(out, true);
        }
        return flow_state(moved, true);
    }
    if k == nk_assign() {
        let st = walk(f, rhs(s, n), moved);
        let target = lhs(s, n);
        if target >= 0 && kind(s, target) == nk_ident() && inf.r.ref_of[target] >= 0 {
            return flow_state(drop_binding(st.moved, inf.r.ref_of[target]), st.falls_through);
        }
        return walk(f, target, st.moved);
    }
    if k == nk_return() {
        let st = walk(f, lhs(s, n), moved);
        return flow_state(st.moved, false);
    }
    if k == nk_break() || k == nk_continue() { return flow_state(moved, false); }
    if k == nk_if() {
        let ch = children(s, n);
        if ch.len() == 0 { return flow_state(moved, true); }
        let cond = walk(f, ch[0], moved);
        var branches: List<FlowState> = [];
        var i = 1;
        while i < ch.len() {
            branches.push(walk(f, ch[i], copy(cond.moved)));
            i = i + 1;
        }
        if ch.len() < 3 { branches.push(flow_state(cond.moved, true)); }
        return join(branches);
    }
    if k == nk_match() {
        let ch = children(s, n);
        if ch.len() == 0 { return flow_state(moved, true); }
        let scrut = walk(f, ch[0], moved);
        var branches: List<FlowState> = [];
        var i = 1;
        while i < ch.len() {
            branches.push(walk(f, rhs(s, ch[i]), copy(scrut.moved)));
            i = i + 1;
        }
        if branches.len() == 0 { return scrut; }
        return join(branches);
    }
    if k == nk_while() { return walk_loop(f, n, [lhs(s, n)], [rhs(s, n)], moved); }
    if k == nk_for() {
        let clause = flags(s, n) - 1;
        var head: List<i64> = [];
        if clause >= 0 && clause < s.for_clauses.len() {
            let c: List<i64> = s.for_clauses[clause];
            head.push(c[0]);
        }
        return walk_loop(f, n, head, [rhs(s, n)], moved);
    }
    return walk_seq(f, children(s, n), moved);
}

/// Runs OWN001 over every function body in the user's files.
pub fn check_ownership(inf: Infer, sink: DiagSink) {
    let s = inf.p.s;
    var owned: List<i64> = [];
    var i = 0;
    while i < inf.r.site.len() { owned.push(-1); i = i + 1; }
    let f = Flow { inf: inf, sink: sink, owned: owned };
    i = 0;
    while i < s.count {
        let k = kind(s, i);
        if (k == nk_fn() || k == nk_operator() || k == nk_lambda()) && in_user_file(s, i) {
            let body = if k == nk_lambda() { rhs(s, i) } else { fn_body(s, i) };
            if body >= 0 {
                let empty: List<i64> = [];
                let _ = walk(f, body, empty);
            }
        }
        i = i + 1;
    }
}
