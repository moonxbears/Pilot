// ==============================================================================
// FILE: selfhost/check/infer.pilot
// The type of every expression, derived from declarations and protocols.
// ==============================================================================
// Literals take the type of their receptor slot. A local takes its
// annotation, or the type of the value it was bound to. A call takes the
// declared return type of the function or method it resolves to, with the
// generic arguments the receiver or the arguments fix; a call through a
// local closure takes the closure's return type. Postfix `?`, `??` and
// `catch` unwrap through the operand type's `op ?`; indexing goes through its
// `op []`. A `for` variable takes the element type of what it iterates: the
// `current` of the enumerator the enumeration protocol's `get` member gives,
// else the type's `op []`, else a range's bounds. A block, `if` or `switch`
// used as a value takes the type its branches agree on; a list literal is a
// list (the `list_t` slot) of the type its items agree on. Whatever is not
// derived yet is the unknown type, which every rule accepts.
pub lvl(0) pkg selfhost.check;

pub struct Infer {
    pub ref p: Program;
    pub ref r: Resolution;
    /// Node -> its type; -1 not computed yet, -2 being computed.
    pub memo: List<i64>;
    /// Name -> the top-level `const` declarations of that name in the files
    /// the program links.
    pub consts: Map<str, List<i64>>;
}

pub fn infer_new(ref p: Program, ref r: Resolution) -> Infer {
    let consts = Map<str, List<i64>>();
    for root in nodes_of(p.s, nk_program()) {
        if in_linked_file(p.s, root) {
            for c in children(p.s, root) {
                if kind(p.s, c) == nk_const() && lhs(p.s, c) >= 0 {
                    let name = node_name(p.s, c);
                    if !consts.has(name) { consts.set(name, []); }
                    consts.get(name).push(c);
                }
            }
        }
    }
    return Infer { p: p, r: r, memo: filled(p.s.count, -1), consts: consts };
}

/// The top-level `const` identifier `n` names when no local binding covers
/// it (the only one of that name, or the one in `n`'s file), or -1.
pub fn global_const(ref inf: Infer, n: i64) -> i64 {
    let s = inf.p.s;
    if inf.r.ref_of[n] >= 0 { return -1; }
    let name = node_name(s, n);
    if !inf.consts.has(name) { return -1; }
    let found = inf.consts.get(name);
    if found.len() == 1 { return found[0]; }
    for d in found {
        if unit_of(s, d) == unit_of(s, n) { return d; }
    }
    return -1;
}

/// The operator symbols whose declarations the checker reads.
pub pure fn op_unwrap() -> str => "_?";
/// The members the unpack sigils call: `*x`, `**x`, `*..x` (PROP-018).
pub pure fn op_splat() -> str => "*_";
pub pure fn op_pairs() -> str => "**_";
pub pure fn op_flatten() -> str => "*.._";
pub pure fn op_index() -> str => "[]";

/// The value `t` holds once unwrapped by its `op ?`, or unknown.
pub fn unwrap_type(var ref p: Program, t: i64) -> i64 {
    if some m = prog_member(p, t, op_unwrap()) { return prog_member_type(p, m); }
    return ty_unknown();
}

/// Whether `t` can be unwrapped (it declares `op ?`).
pub fn is_unwrappable(var ref p: Program, t: i64) -> bool => prog_member(p, t, op_unwrap()) != none;

/// The function a call's callee names, when it names exactly one top-level
/// function and no local binding; -1 otherwise.
pub fn called_fn(ref inf: Infer, call: i64) -> i64 {
    let s = inf.p.s;
    let ch = children(s, call);
    if ch.len() == 0 { return -1; }
    let callee = ch[0];
    if kind(s, callee) != nk_ident() || inf.r.ref_of[callee] >= 0 { return -1; }
    let fns = nl_get(inf.p.fns, node_name(s, callee));
    return if fns.len() == 1 { fns[0] } else { -1 };
}

/// The type a type-name identifier denotes when used as a value receiver
/// (`Shade::Dim`, `result<..>.err(..)`), with its generic arguments unknown.
pub fn type_receiver(var ref inf: Infer, n: i64) -> i64 {
    let s = inf.p.s;
    let k = kind(s, n);
    if (k != nk_ident() && k != nk_type_named()) || inf.r.ref_of[n] >= 0 { return ty_unknown(); }
    let name = node_name(s, n);
    let d = prog_type_decl(inf.p, name);
    if d < 0 { return ty_unknown(); }
    var args: List<i64> = [];
    for _p in prog_tparam_names(inf.p, d) { args.push(ty_unknown()); }
    return ty_named(inf.p.tt, d, name, args);
}

/// The type of the receiver word at node `n`: the struct, interface or
/// extended type whose body holds `n`, over its own generic parameters. The
/// unknown type outside any such body.
fn receiver_type(ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    var cur = p.parents[n];
    while cur >= 0 {
        let k = kind(s, cur);
        if k == nk_struct() || k == nk_interface() || k == nk_extend() {
            let name = node_name(s, cur);
            let d = prog_type_decl(p, name);
            if d < 0 { return ty_unknown(); }
            var args: List<i64> = [];
            for tp in prog_tparam_names(p, d) { args.push(ty_param(p.tt, d, tp)); }
            return ty_named(p.tt, d, name, args);
        }
        cur = p.parents[cur];
    }
    return ty_unknown();
}

/// The type two branches agree on: the other when one is unknown or never
/// returns, the type when both are the same, else the unknown type.
pub fn agree(ref p: Program, a: i64, b: i64) -> i64 {
    if ty_is_unknown(p.tt, a) || prog_is_never(p, a) { return b; }
    if ty_is_unknown(p.tt, b) || prog_is_never(p, b) || a == b { return a; }
    return ty_unknown();
}

/// The element type values of type `t` yield when iterated.
pub fn element_type(var ref p: Program, t: i64) -> i64 {
    let proto = p.s.enumeration;
    if proto.len() >= 3 {
        if some g = prog_member(p, t, proto[0]) {
            if some c = prog_member(p, prog_member_type(p, g), proto[2]) { return prog_member_type(p, c); }
        }
    }
    if some m = prog_member(p, t, op_index()) { return prog_member_type(p, m); }
    return ty_unknown();
}

/// The element type `*x` gives for an `x` of type `t`: of what its prefix
/// `op * ()` returns, or of `t` itself when it is a sequence.
pub fn unpacked_element(var ref p: Program, t: i64) -> i64 {
    if some m = prog_member(p, t, op_splat()) { return element_type(p, prog_member_type(p, m)); }
    return element_type(p, t);
}

/// The element type of the iterable expression `e`.
fn iterated_type(var ref inf: Infer, e: i64) -> i64 {
    let s = inf.p.s;
    if e < 0 { return ty_unknown(); }
    let k = kind(s, e);
    if k == nk_binary() && flags(s, e) == op_step() { return iterated_type(inf, lhs(s, e)); }
    if (k == nk_binary() && (flags(s, e) == op_range() || flags(s, e) == op_range_inclusive())) || k == nk_range() {
        return agree(inf.p, type_of(inf, lhs(s, e)), type_of(inf, rhs(s, e)));
    }
    return element_type(inf.p, type_of(inf, e));
}

/// The value a block ends with: its last item when written without a `;`.
pub fn block_value(var ref inf: Infer, b: i64) -> i64 {
    let s = inf.p.s;
    if b < 0 { return ty_unknown(); }
    if kind(s, b) != nk_block() { return type_of(inf, b); }
    let ch = children(s, b);
    if ch.len() == 0 { return ty_unknown(); }
    let last = ch[ch.len() - 1];
    if kind(s, last) == nk_expr_stmt() && lhs(s, last) >= 0 && span_end(s, last) == span_end(s, lhs(s, last)) {
        return type_of(inf, lhs(s, last));
    }
    return ty_unknown();
}

fn lambda_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let ch = children(s, n);
    var args: List<i64> = [];
    var i = 0;
    while i + 1 < ch.len() {
        let prm = ch[i];
        args.push(if kind(s, prm) == nk_param() { prog_annot_type(p, rhs(s, prm)) } else { ty_unknown() });
        i = i + 1;
    }
    // A lambda that yields returns the generator over its items.
    args.push(if is_generator(p, n) { generator_type(inf, yielded_type(inf, n)) } else { block_value(inf, rhs(s, n)) });
    return ty_func(p.tt, prog_slot_name(p, fn_slot()), args);
}

fn list_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    var elem = ty_unknown();
    var first = true;
    for c in children(p.s, n) {
        // `*x` among the items gives the elements of what it unpacks.
        let spread = kind(p.s, c) == nk_unary() && flags(p.s, c) == unary_splat();
        let t = if spread { unpacked_element(p, type_of(inf, lhs(p.s, c))) } else { type_of(inf, c) };
        elem = if first { t } else { agree(p, elem, t) };
        first = false;
    }
    let lt = prog_slot_type(p, list_slot());
    if !ty_is_named(p.tt, lt) { return ty_unknown(); }
    let name = p.tt.name[lt];
    return ty_named(p.tt, ty_decl(p.tt, lt), name, [elem]);
}

pub fn binding_type(var ref inf: Infer, b: i64) -> i64 {
    let r = inf.r;
    if r.annot[b] >= 0 { return prog_annot_type(inf.p, r.annot[b]); }
    if r.bind_kind[b] == BindKind::Local && r.source[b] >= 0 { return type_of(inf, r.source[b]); }
    if r.bind_kind[b] == BindKind::Loop && r.source[b] >= 0 { return iterated_type(inf, r.source[b]); }
    if r.bind_kind[b] == BindKind::Unwrapped && r.source[b] >= 0 {
        return unwrap_type(inf.p, type_of(inf, r.source[b]));
    }
    if r.bind_kind[b] == BindKind::Param && r.owner[b] >= 0 && kind(inf.p.s, r.owner[b]) == nk_lambda() {
        return lambda_param_type(inf, r.owner[b], r.site[b]);
    }
    return ty_unknown();
}

/// The type of unannotated parameter `prm` of lambda `lam` passed straight
/// to a call: the matching parameter of the function type the callee
/// declares for that argument (`(c) => ..` given as `f: (Captures) => str`
/// makes `c` a `Captures`); unknown otherwise.
fn lambda_param_type(var ref inf: Infer, lam: i64, prm: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let lch = children(s, lam);
    var index = -1;
    var i = 0;
    while i + 1 < lch.len() {
        if lch[i] == prm { index = i; }
        i = i + 1;
    }
    let call = p.parents[lam];
    if index < 0 || call < 0 || kind(s, call) != nk_call() { return ty_unknown(); }
    let ch = children(s, call);
    var arg = -1;
    i = 1;
    while i < ch.len() {
        if ch[i] == lam { arg = i - 1; }
        i = i + 1;
    }
    if arg < 0 { return ty_unknown(); }
    var f = called_fn(inf, call);
    if f < 0 && kind(s, ch[0]) == nk_member() {
        let recv = lhs(s, ch[0]);
        var rt = type_of(inf, recv);
        if ty_is_unknown(p.tt, rt) { rt = type_receiver(inf, recv); }
        if some m = prog_member(p, rt, sym_text(s, rhs(s, ch[0]))) {
            if kind(s, m.decl) == nk_fn() { f = m.decl; }
        }
    }
    if f < 0 { return ty_unknown(); }
    var params: List<i64> = [];
    for q in fn_params(s, f) {
        let is_receiver = params.len() == 0 && s.receiver.len() > 0 && node_name(s, q) == s.receiver;
        if kind(s, q) == nk_param() && !is_receiver { params.push(q); }
    }
    if arg >= params.len() { return ty_unknown(); }
    let ft = prog_annot_type(p, rhs(s, params[arg]));
    if !ty_is_func(p.tt, ft) { return ty_unknown(); }
    let fargs = ty_args(p.tt, ft);
    if index + 1 >= fargs.len() { return ty_unknown(); }
    return fargs[index];
}

/// Binds the generic parameters of function `f` from the argument types of
/// call `call`: a parameter declared as a bare generic parameter takes the
/// argument's type.
pub fn call_generic_args(var ref inf: Infer, f: i64, call: i64) -> List<i64> {
    let s = inf.p.s;
    let names = prog_tparam_names(inf.p, f);
    var values: List<i64> = [];
    for _n in names { values.push(ty_unknown()); }
    let params = fn_params(s, f);
    let args = children(s, call);
    var i = 0;
    while i < params.len() && i + 1 < args.len() {
        let pt = prog_annot_type(inf.p, rhs(s, params[i]));
        if ty_is_param(inf.p.tt, pt) {
            var j = 0;
            while j < names.len() {
                if names[j] == inf.p.tt.name[pt] && values[j] == ty_unknown() {
                    values[j] = type_of(inf, args[i + 1]);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return values;
}

/// The type of `asm(op, operands..)`: what its machine operation gives.
fn asm_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let ch = children(p.s, n);
    guard some o = asm_op_of(p.s, n) else { return ty_unknown(); };
    if o.gives == AsmGives::Truth { return prog_slot_type(p, literal_slot(nk_bool())); }
    if o.gives == AsmGives::Operand && ch.len() > 2 { return type_of(inf, ch[2]); }
    if o.gives == AsmGives::Target && ch.len() > 3 { return type_receiver(inf, ch[ch.len() - 1]); }
    return ty_unknown();
}

fn call_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let ch = children(s, n);
    if ch.len() == 0 { return ty_unknown(); }
    let callee = ch[0];
    let ck = kind(s, callee);
    if ck == nk_ident() && node_name(s, callee) == asm_token() { return asm_type(inf, n); }
    if ck == nk_ident() && inf.r.ref_of[callee] >= 0 {
        return ty_func_return(p.tt, type_of(inf, callee));
    }
    if ck == nk_ident() {
        let as_type = type_receiver(inf, callee);
        if ty_is_named(p.tt, as_type) && ch.len() == 2 && kind(s, ch[1]) == nk_map() {
            return as_type;
        }
        let f = called_fn(inf, n);
        // `Type(args)` with no function of that name constructs the type,
        // unless the name is a compile-time type question (`sizeof(T)`): the
        // keyword registry declares `sizeof {}`, which a glob import of
        // `Pilot.Core.Keywords` brings into view.
        if f < 0 && ty_is_named(p.tt, as_type) && nl_get(p.fns, node_name(s, callee)).len() == 0 && !prog_is_type_query(inf.p, node_name(s, callee)) { return as_type; }
        if f < 0 { return ty_unknown(); }
        let ret = fn_return_type(inf, f);
        return ty_subst(p.tt, ret, prog_tparam_names(p, f), call_generic_args(inf, f, n));
    }
    if ck == nk_member() {
        let recv = lhs(s, callee);
        var rt = type_of(inf, recv);
        if ty_is_unknown(p.tt, rt) { rt = type_receiver(inf, recv); }
        if some m = prog_member(p, rt, sym_text(s, rhs(s, callee))) {
            let mk = kind(s, m.decl);
            if mk == nk_fn() || mk == nk_operator() {
                // A generator method written without a return type returns
                // the generator over its items, as a function does.
                let mt = prog_member_type(p, m);
                if ty_is_unknown(p.tt, mt) && mk == nk_fn() && is_generator(p, m.decl) { return fn_return_type(inf, m.decl); }
                return mt;
            }
        }
        let f = module_fn(inf, callee);
        if f >= 0 { return fn_return_type(inf, f); }
    }
    return ty_unknown();
}

/// The module path imported as `alias` in the unit containing `at`, or "".
fn aliased_module(ref p: Program, at: i64, alias: str) -> str {
    let s = p.s;
    let u = unit_of(s, at);
    for imp in prog_nodes_of_kind(p, nk_import_decl()) {
        if is_package_decl(s, imp) || unit_of(s, imp) != u { continue; }
        let al = rhs(s, imp);
        if al > 0 && sym_text(s, al) == alias { return node_name(s, imp); }
    }
    return "";
}

/// Whether unit `u` declares `pkg <pkg_name>`.
fn unit_declares_pkg(ref p: Program, u: i64, pkg_name: str) -> bool {
    let s = p.s;
    for imp in prog_nodes_of_kind(p, nk_import_decl()) {
        if is_package_decl(s, imp) && unit_of(s, imp) == u && node_name(s, imp) == pkg_name {
            return true;
        }
    }
    return false;
}

/// The top-level function a module-qualified callee (`io.read_line` or
/// `t.join_text` after `use std.text as t;`) names: `X` is no binding or
/// type, and a linked file matching `X` (or its aliased module) declares one
/// function of that name; -1 otherwise.
pub fn module_fn(var ref inf: Infer, callee: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    if kind(s, callee) != nk_member() { return -1; }
    let recv = lhs(s, callee);
    if kind(s, recv) != nk_ident() || inf.r.ref_of[recv] >= 0 { return -1; }
    if !ty_is_unknown(p.tt, type_receiver(inf, recv)) { return -1; }
    let alias_mod = aliased_module(p, callee, node_name(s, recv));
    let tail = if alias_mod.len() > 0 {
        "/" + alias_mod.replace(".", "/") + ".pilot"
    } else {
        "/" + node_name(s, recv) + ".pilot"
    };
    var found = -1;
    for f in nl_get(p.fns, sym_text(s, rhs(s, callee))) {
        let u = unit_of(s, f);
        if u < 0 || u >= s.files.len() || !in_linked_file(s, f) { continue; }
        let row: List<any> = s.files[u];
        let path: str = row[0];
        let matches_pkg = alias_mod.len() > 0 && unit_declares_pkg(p, u, alias_mod);
        if !matches_pkg && !path.replace("\\", "/").ends_with(tail) { continue; }
        if found >= 0 { return -1; }
        found = f;
    }
    return found;
}

fn member_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let recv = lhs(s, n);
    let name = sym_text(s, rhs(s, n));
    let rt = type_of(inf, recv);
    if !ty_is_unknown(p.tt, rt) {
        if some m = prog_member(p, rt, name) {
            if kind(s, m.decl) == nk_fn() { return ty_unknown(); }
            return prog_member_type(p, m);
        }
        return ty_unknown();
    }
    let as_type = type_receiver(inf, recv);
    if ty_is_named(p.tt, as_type) {
        if kind(s, ty_decl(p.tt, as_type)) == nk_adt() { return as_type; }
        if some m = prog_member(p, as_type, name) {
            if is_static_decl(s, m.decl) && is_field(s, m.decl) {
                return prog_member_type(p, m);
            }
        }
    }
    return ty_unknown();
}

/// `xs as view T` (selfhost/check/view_cast.pilot checks it).
/// The operator symbol `as view` is bound under (crates/pilot-ast
/// `BinaryOp::symbol`).
pub pure fn view_symbol() -> str => "as view";

/// The function `as view` node `n` calls, or -1: of the functions the
/// program binds `as view` to, the one whose first parameter takes the
/// type of `xs` (a `List`), else the first bound.
pub fn view_fn(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let src = type_of(inf, lhs(s, n));
    var first = -1;
    for row in prog_engine_bindings(p) {
        if row.len() >= 3 && row[0] == "bind_operator_fn" && row[1] == view_symbol() {
            let fns = nl_get(p.fns, row[2]);
            if fns.len() == 1 {
                if first < 0 { first = fns[0]; }
                let params = fn_params(s, fns[0]);
                if params.len() > 0 && ty_is_named(p.tt, src) {
                    let pt = prog_annot_type(p, rhs(s, params[0]));
                    if ty_is_named(p.tt, pt) && ty_decl(p.tt, pt) == ty_decl(p.tt, src) { return fns[0]; }
                }
            }
        }
    }
    return first;
}

/// The type of `xs as view T`: the chosen function's return type over the
/// element type of `xs` and `T`, or the unknown type.
pub fn view_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let f = view_fn(inf, n);
    if f < 0 || annot(s, f) < 0 { return ty_unknown(); }
    let ret = prog_annot_type(p, annot(s, f));
    if !ty_is_named(p.tt, ret) { return ty_unknown(); }
    let elem = element_type(p, type_of(inf, lhs(s, n)));
    let target = prog_annot_type(p, rhs(s, n));
    let name = p.tt.name[ret];
    return ty_named(p.tt, ty_decl(p.tt, ret), name, [elem, target]);
}

/// The binding keys of `quote` values (stdlib/core/primitives/ast.pilot):
/// the function that builds a quote's tree, the one that fills its next
/// hole, and the ones that make a literal tree of a plain value.
pub pure fn quote_symbol() -> str => "quote";
pub pure fn quote_hole_symbol() -> str => "quote hole";
pub pure fn quote_lift_symbol() -> str => "quote lift";

/// The functions the program binds `key` to, in binding order.
pub fn bound_fns(var ref p: Program, key: str) -> List<i64> {
    var out: List<i64> = [];
    for row in prog_engine_bindings(p) {
        if row.len() >= 3 && row[0] == "bind_operator_fn" && row[1] == key {
            let fns = nl_get(p.fns, row[2]);
            if fns.len() == 1 { out.push(fns[0]); }
        }
    }
    return out;
}

/// The function that builds a quote's tree, or -1.
pub fn quote_fn(var ref p: Program) -> i64 {
    let fns = bound_fns(p, quote_symbol());
    return if fns.len() > 0 { fns[0] } else { -1 };
}

/// Whether `t` is the type of a quote's value (`ast<T>`).
pub fn is_quote_type(var ref p: Program, t: i64) -> bool {
    let f = quote_fn(p);
    if f < 0 || annot(p.s, f) < 0 || !ty_is_named(p.tt, t) { return false; }
    let ret = prog_annot_type(p, annot(p.s, f));
    return ty_is_named(p.tt, ret) && ty_decl(p.tt, ret) == ty_decl(p.tt, t);
}

/// Whether `n` is the value a block ends with: an expression written
/// without a `;`, or an `if` that ends the block.
pub fn is_tail(ref s: Snap, n: i64) -> bool {
    if kind(s, n) == nk_if() { return true; }
    return kind(s, n) == nk_expr_stmt() && lhs(s, n) >= 0 && span_end(s, n) == span_end(s, lhs(s, n));
}

/// The code quote `q` holds: its block's only value when the block has no
/// statement, else the block (or the expression after `quote`).
pub fn quoted_root(ref s: Snap, q: i64) -> i64 {
    let b = lhs(s, q);
    if b < 0 || kind(s, b) != nk_block() { return b; }
    let ch = children(s, b);
    if ch.len() == 1 && is_tail(s, ch[0]) {
        return if kind(s, ch[0]) == nk_if() { ch[0] } else { lhs(s, ch[0]) };
    }
    return b;
}

/// The type of `quote { e }`: the quote function's return type over the
/// type of `e`.
pub fn quote_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let f = quote_fn(p);
    if f < 0 || annot(p.s, f) < 0 { return ty_unknown(); }
    let ret = prog_annot_type(p, annot(p.s, f));
    if !ty_is_named(p.tt, ret) { return ty_unknown(); }
    let name = p.tt.name[ret];
    return ty_named(p.tt, ty_decl(p.tt, ret), name, [type_of(inf, quoted_root(p.s, n))]);
}

/// The type hole `$x` has inside its template: `T` when `x` is an
/// `ast<T>`, else the type of `x` (a value made into its literal).
pub fn hole_type(ref inf: Infer, bt: i64) -> i64 {
    let p = inf.p;
    if !is_quote_type(p, bt) { return bt; }
    let args = ty_args(p.tt, bt);
    return if args.len() > 0 { args[0] } else { ty_unknown() };
}

fn binary_type(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let op = flags(s, n);
    if (op >= op_eq() && op <= op_or()) || op == op_is() { return prog_slot_type(p, literal_slot(nk_bool())); }
    if op == op_as() { return prog_annot_type(p, rhs(s, n)); }
    if op == op_as_view() { return view_type(inf, n); }
    if op == op_coalesce() {
        let inner = unwrap_type(p, type_of(inf, lhs(s, n)));
        return if ty_is_unknown(p.tt, inner) { type_of(inf, rhs(s, n)) } else { inner };
    }
    // Arithmetic (1..7) and bitwise (`&` 16, `|` 17, `^` 18, `<<` 19,
    // `>>` 20) operators give their left operand's type, or the right's
    // when the left's is unknown.
    if (op >= 1 && op <= 7) || (op >= 16 && op <= 20) {
        let l = type_of(inf, lhs(s, n));
        if ty_is_unknown(p.tt, l) { return type_of(inf, rhs(s, n)); }
        // A literal on the left takes the other side's numeric type
        // (`1 + b` for a `u8` `b` is a `u8`), as one on the right does.
        // Shifts keep the type of the value shifted.
        let lk = kind(s, lhs(s, n));
        if (lk == nk_int() || lk == nk_float()) && op != 19 && op != 20 {
            let r = type_of(inf, rhs(s, n));
            let rc = prog_class(p, r);
            if lk == nk_int() && (is_integer_class(rc) || is_float_class(rc)) { return r; }
            if lk == nk_float() && is_float_class(rc) { return r; }
        }
        return l;
    }
    // Any other operator the left operand's type declares (`..=` on an
    // integer, or through an `ext` block) gives what that declaration returns.
    let symbols = binary_op_symbols();
    if op > 0 && op < symbols.len() {
        if some m = prog_member(p, type_of(inf, lhs(s, n)), symbols[op]) { return prog_member_type(p, m); }
    }
    return ty_unknown();
}

/// Whether `x[a ..= b]` on a value of type `t` calls `t`'s own `op []`:
/// that operator takes a structured value (a range), not a register number.
pub fn index_takes_range(var ref p: Program, t: i64) -> bool {
    guard some m = prog_member(p, t, op_index()) else { return false; }
    let s = p.s;
    for prm in fn_params(s, m.decl) {
        if annot(s, prm) < 0 || node_name(s, prm) == s.receiver { continue; }
        let pt = prog_annot_type(p, annot(s, prm));
        return ty_is_named(p.tt, pt) && prog_class(p, pt) == "";
    }
    return false;
}

fn compute(var ref inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let k = kind(s, n);
    if k == nk_int() || k == nk_float() || k == nk_str() || k == nk_bool() {
        return prog_slot_type(p, literal_slot(k));
    }
    if k == nk_ident() {
        let b = inf.r.ref_of[n];
        let is_receiver = s.receiver.len() > 0 && node_name(s, n) == s.receiver;
        if b >= 0 {
            // A method's own `self` / `ref self` parameter carries no type
            // annotation: it is the type whose body holds the method.
            let bt = binding_type(inf, b);
            // `$x` in a quote: what `x` puts into the template.
            if flags(s, n) == 1 { return hole_type(inf, bt); }
            if !is_receiver || !ty_is_unknown(p.tt, bt) { return bt; }
        }
        if is_receiver { return receiver_type(inf, n); }
        let c = global_const(inf, n);
        if c >= 0 {
            if annot(s, c) >= 0 { return prog_annot_type(p, annot(s, c)); }
            if rhs(s, c) >= 0 { return type_of(inf, rhs(s, c)); }
        }
        return ty_unknown();
    }
    if k == nk_call() { return call_type(inf, n); }
    if k == nk_quote() { return quote_type(inf, n); }
    if k == nk_member() { return member_type(inf, n); }
    if k == nk_index() {
        // `x[a..b]` is the part of `x` between the bounds: a value of `x`'s
        // own type, as every engine gives it (the part of a list is a
        // list, of a string a string).
        let idx = rhs(s, n);
        if idx >= 0 && ((kind(s, idx) == nk_binary() && (flags(s, idx) == op_range() || flags(s, idx) == op_range_inclusive())) || kind(s, idx) == nk_range()) {
            let lt = type_of(inf, lhs(s, n));
            if index_takes_range(p, lt) {
                if some m = prog_member(p, lt, op_index()) { return prog_member_type(p, m); }
            }
            return lt;
        }
        if some m = prog_member(p, type_of(inf, lhs(s, n)), op_index()) { return prog_member_type(p, m); }
        return ty_unknown();
    }
    if k == nk_binary() { return binary_type(inf, n); }
    if k == nk_unary() {
        if flags(s, n) == unary_some() { return prog_slot_type(p, literal_slot(nk_bool())); }
        return type_of(inf, lhs(s, n));
    }
    if k == nk_try_propagate() || k == nk_catch_recovery() {
        return unwrap_type(p, type_of(inf, lhs(s, n)));
    }
    if k == nk_expr_stmt() { return type_of(inf, lhs(s, n)); }
    if k == nk_lambda() { return lambda_type(inf, n); }
    if k == nk_list() { return list_type(inf, n); }
    if k == nk_yield() { return sent_type(inf, n); }
    if k == nk_for() && for_collects(p, n) { return collected_type(inf, n); }
    // `for .. then fallback` has the fallback's type (a `break value` must
    // give a value of it).
    if k == nk_for() && for_then(s, n) >= 0 { return type_of(inf, for_then(s, n)); }
    if k == nk_block() { return block_value(inf, n); }
    if k == nk_if() {
        let ch = children(s, n);
        if ch.len() < 3 { return ty_unknown(); }
        return agree(p, block_value(inf, ch[1]), block_value(inf, ch[2]));
    }
    if k == nk_match() {
        let ch = children(s, n);
        var t = ty_unknown();
        var i = 1;
        while i < ch.len() {
            let body = block_value(inf, rhs(s, ch[i]));
            t = if i == 1 { body } else { agree(p, t, body) };
            i = i + 1;
        }
        return t;
    }
    return ty_unknown();
}

/// The return type of function `f`: its annotation, or for a generator
/// written without one, the generator type over the items it yields.
pub fn fn_return_type(var ref inf: Infer, f: i64) -> i64 {
    let p = inf.p;
    if annot(p.s, f) >= 0 { return prog_annot_type(p, annot(p.s, f)); }
    if is_generator(p, f) { return generator_type(inf, yielded_type(inf, f)); }
    return ty_unknown();
}

/// The generator type over items of type `item`, its other parameters at
/// their defaults; the unknown type when no generator type is bound.
pub fn generator_type(ref inf: Infer, item: i64) -> i64 {
    let p = inf.p;
    let d = generator_decl(p);
    if d < 0 { return ty_unknown(); }
    let name = p.s.generator[0];
    var args: List<i64> = [item];
    let defaults = prog_tparam_defaults(p, name);
    while args.len() < defaults.len() && defaults[args.len()] >= 0 {
        args.push(prog_annot_type(p, defaults[args.len()]));
    }
    return ty_named(p.tt, d, name, args);
}

/// The type the `yield`s belonging to `owner` agree on: each `yield e`
/// gives `e`, each `yield *xs` an element of `xs`.
pub fn yielded_type(var ref inf: Infer, owner: i64) -> i64 {
    let p = inf.p;
    var t = ty_unknown();
    var first = true;
    for y in owned_yields(p, owner) {
        let v = lhs(p.s, y);
        let item = if is_delegation(p, y) { iterated_type(inf, lhs(p.s, v)) } else { type_of(inf, v) };
        t = if first { item } else { agree(p, t, item) };
        first = false;
    }
    return t;
}

/// The value of `yield` node `y`: what a `send` passes in, the generator
/// type's second argument; unknown inside a collecting `for`.
fn sent_type(var ref inf: Infer, y: i64) -> i64 {
    let p = inf.p;
    let owner = yield_owner(p, y);
    if owner < 0 || kind(p.s, owner) == nk_for() || is_delegation(p, y) { return ty_unknown(); }
    let g = fn_return_type(inf, owner);
    if !ty_is_named(p.tt, g) || ty_decl(p.tt, g) != generator_decl(p) { return ty_unknown(); }
    let args = ty_args(p.tt, g);
    return if args.len() > 1 { args[1] } else { ty_unknown() };
}

/// A collecting `for`: a list (the `list_t` slot) of what it yields.
fn collected_type(var ref inf: Infer, f: i64) -> i64 {
    let p = inf.p;
    let lt = prog_slot_type(p, list_slot());
    if !ty_is_named(p.tt, lt) { return ty_unknown(); }
    let name = p.tt.name[lt];
    return ty_named(p.tt, ty_decl(p.tt, lt), name, [yielded_type(inf, f)]);
}

/// The type of expression `n` (the unknown type when not derived).
pub fn type_of(var ref inf: Infer, n: i64) -> i64 {
    if n < 0 { return ty_unknown(); }
    let m = inf.memo[n];
    if m >= 0 { return m; }
    if m == -2 { return ty_unknown(); }
    inf.memo[n] = -2;
    let t = compute(inf, n);
    inf.memo[n] = t;
    return t;
}
