// ==============================================================================
// FILE: selfhost/check/infer.pilot
// The type of every expression, derived from declarations and protocols.
// ==============================================================================
// Literals take the type of their receptor slot. A local takes its
// annotation, or the type of the value it was bound to. A call takes the
// declared return type of the function or method it resolves to, with the
// generic arguments the receiver or the arguments fix; a call through a
// local closure takes the closure's return type. Postfix `?`, `??` and
// `catch` unwrap through the operand type's `op ?`; indexing goes through its
// `op []`. A `for` variable takes the element type of what it iterates: the
// `current` of the enumerator the enumeration protocol's `get` member gives,
// else the type's `op []`, else a range's bounds. A block, `if` or `switch`
// used as a value takes the type its branches agree on; a list literal is a
// list (the `list_t` slot) of the type its items agree on. Whatever is not
// derived yet is the unknown type, which every rule accepts.
pub lvl(0) pkg Pilot.SelfHost.Check.Infer;

use selfhost.check.snapshot.*;
use selfhost.check.types.*;
use selfhost.check.program.*;
use selfhost.check.methods.*;
use selfhost.check.resolve.*;
use selfhost.check.generators.*;

pub struct Infer {
    pub p: Program;
    pub r: Resolution;
    /// Node -> its type; -1 not computed yet, -2 being computed.
    pub memo: List<i64>;
}

pub fn infer_new(p: Program, r: Resolution) -> Infer {
    var memo: List<i64> = [];
    var i = 0;
    while i < p.s.count { memo.push(-1); i = i + 1; }
    return Infer { p: p, r: r, memo: memo };
}

/// The operator symbols whose declarations the checker reads.
pub pure fn op_unwrap() -> str => "?";
pub pure fn op_index() -> str => "[]";

/// The value `t` holds once unwrapped by its `op ?`, or unknown.
pub fn unwrap_type(p: Program, t: i64) -> i64 {
    if some m = prog_member(p, t, op_unwrap()) { return prog_member_type(p, m); }
    return ty_unknown();
}

/// Whether `t` can be unwrapped (it declares `op ?`).
pub fn is_unwrappable(p: Program, t: i64) -> bool => prog_member(p, t, op_unwrap()) != none;

/// The function a call's callee names, when it names exactly one top-level
/// function and no local binding; -1 otherwise.
pub fn called_fn(inf: Infer, call: i64) -> i64 {
    let s = inf.p.s;
    let ch = children(s, call);
    if ch.len() == 0 { return -1; }
    let callee = ch[0];
    if kind(s, callee) != nk_ident() || inf.r.ref_of[callee] >= 0 { return -1; }
    let fns = nl_get(inf.p.fns, node_name(s, callee));
    return if fns.len() == 1 { fns[0] } else { -1 };
}

/// The type a type-name identifier denotes when used as a value receiver
/// (`Shade::Dim`, `result<..>.err(..)`), with its generic arguments unknown.
pub fn type_receiver(inf: Infer, n: i64) -> i64 {
    let s = inf.p.s;
    if kind(s, n) != nk_ident() || inf.r.ref_of[n] >= 0 { return ty_unknown(); }
    let name = node_name(s, n);
    let d = prog_type_decl(inf.p, name);
    if d < 0 { return ty_unknown(); }
    var args: List<i64> = [];
    for _p in prog_tparam_names(inf.p, d) { args.push(ty_unknown()); }
    return ty_named(inf.p.tt, d, name, args);
}

/// The type of the receiver word at node `n`: the struct, interface or
/// extended type whose body holds `n`, over its own generic parameters. The
/// unknown type outside any such body.
fn receiver_type(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    var cur = p.parents[n];
    while cur >= 0 {
        let k = kind(s, cur);
        if k == nk_struct() || k == nk_interface() || k == nk_extend() {
            let name = node_name(s, cur);
            let d = prog_type_decl(p, name);
            if d < 0 { return ty_unknown(); }
            var args: List<i64> = [];
            for tp in prog_tparam_names(p, d) { args.push(ty_param(p.tt, d, tp)); }
            return ty_named(p.tt, d, name, args);
        }
        cur = p.parents[cur];
    }
    return ty_unknown();
}

/// The type two branches agree on: the other when one is unknown or never
/// returns, the type when both are the same, else the unknown type.
pub fn agree(p: Program, a: i64, b: i64) -> i64 {
    if ty_is_unknown(p.tt, a) || prog_is_never(p, a) { return b; }
    if ty_is_unknown(p.tt, b) || prog_is_never(p, b) || a == b { return a; }
    return ty_unknown();
}

/// The element type values of type `t` yield when iterated.
pub fn element_type(p: Program, t: i64) -> i64 {
    let proto = p.s.enumeration;
    if proto.len() >= 3 {
        if some g = prog_member(p, t, proto[0]) {
            if some c = prog_member(p, prog_member_type(p, g), proto[2]) { return prog_member_type(p, c); }
        }
    }
    if some m = prog_member(p, t, op_index()) { return prog_member_type(p, m); }
    return ty_unknown();
}

/// The element type of the iterable expression `e`.
fn iterated_type(inf: Infer, e: i64) -> i64 {
    let s = inf.p.s;
    if e < 0 { return ty_unknown(); }
    let k = kind(s, e);
    if (k == nk_binary() && (flags(s, e) == op_range() || flags(s, e) == op_range_inclusive())) || k == nk_range() {
        return agree(inf.p, type_of(inf, lhs(s, e)), type_of(inf, rhs(s, e)));
    }
    return element_type(inf.p, type_of(inf, e));
}

/// The value a block ends with: its last item when written without a `;`.
pub fn block_value(inf: Infer, b: i64) -> i64 {
    let s = inf.p.s;
    if b < 0 { return ty_unknown(); }
    if kind(s, b) != nk_block() { return type_of(inf, b); }
    let ch = children(s, b);
    if ch.len() == 0 { return ty_unknown(); }
    let last = ch[ch.len() - 1];
    if kind(s, last) == nk_expr_stmt() && lhs(s, last) >= 0 && span_end(s, last) == span_end(s, lhs(s, last)) {
        return type_of(inf, lhs(s, last));
    }
    return ty_unknown();
}

fn lambda_type(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let ch = children(s, n);
    var args: List<i64> = [];
    var i = 0;
    while i + 1 < ch.len() {
        let prm = ch[i];
        args.push(if kind(s, prm) == nk_param() { prog_annot_type(p, rhs(s, prm)) } else { ty_unknown() });
        i = i + 1;
    }
    // A lambda that yields returns the generator over its items.
    args.push(if is_generator(p, n) { generator_type(inf, yielded_type(inf, n)) } else { block_value(inf, rhs(s, n)) });
    return ty_func(p.tt, prog_slot_name(p, fn_slot()), args);
}

fn list_type(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    var elem = ty_unknown();
    var first = true;
    for c in children(p.s, n) {
        let t = type_of(inf, c);
        elem = if first { t } else { agree(p, elem, t) };
        first = false;
    }
    let lt = prog_slot_type(p, list_slot());
    if !ty_is_named(p.tt, lt) { return ty_unknown(); }
    return ty_named(p.tt, ty_decl(p.tt, lt), p.tt.name[lt], [elem]);
}

pub fn binding_type(inf: Infer, b: i64) -> i64 {
    let r = inf.r;
    if r.annot[b] >= 0 { return prog_annot_type(inf.p, r.annot[b]); }
    if r.bind_kind[b] == BindKind::Local && r.source[b] >= 0 { return type_of(inf, r.source[b]); }
    if r.bind_kind[b] == BindKind::Loop && r.source[b] >= 0 { return iterated_type(inf, r.source[b]); }
    if r.bind_kind[b] == BindKind::Unwrapped && r.source[b] >= 0 {
        return unwrap_type(inf.p, type_of(inf, r.source[b]));
    }
    return ty_unknown();
}

/// Binds the generic parameters of function `f` from the argument types of
/// call `call`: a parameter declared as a bare generic parameter takes the
/// argument's type.
pub fn call_generic_args(inf: Infer, f: i64, call: i64) -> List<i64> {
    let s = inf.p.s;
    let names = prog_tparam_names(inf.p, f);
    var values: List<i64> = [];
    for _n in names { values.push(ty_unknown()); }
    let params = fn_params(s, f);
    let args = children(s, call);
    var i = 0;
    while i < params.len() && i + 1 < args.len() {
        let pt = prog_annot_type(inf.p, rhs(s, params[i]));
        if ty_is_param(inf.p.tt, pt) {
            var j = 0;
            while j < names.len() {
                if names[j] == inf.p.tt.name[pt] && values[j] == ty_unknown() {
                    values[j] = type_of(inf, args[i + 1]);
                }
                j = j + 1;
            }
        }
        i = i + 1;
    }
    return values;
}

fn call_type(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let ch = children(s, n);
    if ch.len() == 0 { return ty_unknown(); }
    let callee = ch[0];
    let ck = kind(s, callee);
    if ck == nk_ident() && inf.r.ref_of[callee] >= 0 {
        return ty_func_return(p.tt, type_of(inf, callee));
    }
    if ck == nk_ident() {
        let as_type = type_receiver(inf, callee);
        if ty_is_named(p.tt, as_type) && ch.len() == 2 && kind(s, ch[1]) == nk_map() {
            return as_type;
        }
        let f = called_fn(inf, n);
        // `Type(args)` with no function of that name constructs the type.
        if f < 0 && ty_is_named(p.tt, as_type) && nl_get(p.fns, node_name(s, callee)).len() == 0 { return as_type; }
        if f < 0 { return ty_unknown(); }
        let ret = fn_return_type(inf, f);
        return ty_subst(p.tt, ret, prog_tparam_names(p, f), call_generic_args(inf, f, n));
    }
    if ck == nk_member() {
        let recv = lhs(s, callee);
        var rt = type_of(inf, recv);
        if ty_is_unknown(p.tt, rt) { rt = type_receiver(inf, recv); }
        if some m = prog_member(p, rt, sym_text(s, rhs(s, callee))) {
            let mk = kind(s, m.decl);
            if mk == nk_fn() || mk == nk_operator() { return prog_member_type(p, m); }
        }
        let f = module_fn(inf, callee);
        if f >= 0 && annot(s, f) >= 0 { return prog_annot_type(p, annot(s, f)); }
    }
    return ty_unknown();
}

/// The top-level function a module-qualified callee (`io.read_line`) names:
/// `X` is no binding or type, and a linked file named `X` (`.../X.pilot`)
/// declares one function of that name; -1 otherwise.
pub fn module_fn(inf: Infer, callee: i64) -> i64 {
    let s = inf.p.s;
    if kind(s, callee) != nk_member() { return -1; }
    let recv = lhs(s, callee);
    if kind(s, recv) != nk_ident() || inf.r.ref_of[recv] >= 0 { return -1; }
    if !ty_is_unknown(inf.p.tt, type_receiver(inf, recv)) { return -1; }
    let tail = "/" + node_name(s, recv) + ".pilot";
    var found = -1;
    for f in nl_get(inf.p.fns, sym_text(s, rhs(s, callee))) {
        let u = unit_of(s, f);
        if u < 0 || u >= s.files.len() || !in_linked_file(s, f) { continue; }
        let row: List<any> = s.files[u];
        let path: str = row[0];
        if !path.replace("\\", "/").ends_with(tail) { continue; }
        if found >= 0 { return -1; }
        found = f;
    }
    return found;
}

fn member_type(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let recv = lhs(s, n);
    let name = sym_text(s, rhs(s, n));
    let rt = type_of(inf, recv);
    if !ty_is_unknown(p.tt, rt) {
        if some m = prog_member(p, rt, name) {
            if kind(s, m.decl) == nk_fn() { return ty_unknown(); }
            return prog_member_type(p, m);
        }
        return ty_unknown();
    }
    let as_type = type_receiver(inf, recv);
    if ty_is_named(p.tt, as_type) && kind(s, ty_decl(p.tt, as_type)) == nk_adt() { return as_type; }
    return ty_unknown();
}

fn binary_type(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let op = flags(s, n);
    if (op >= op_eq() && op <= op_or()) || op == op_is() { return prog_slot_type(p, literal_slot(nk_bool())); }
    if op == op_as() || op == op_as_view() { return prog_annot_type(p, rhs(s, n)); }
    if op == op_coalesce() {
        let inner = unwrap_type(p, type_of(inf, lhs(s, n)));
        return if ty_is_unknown(p.tt, inner) { type_of(inf, rhs(s, n)) } else { inner };
    }
    if op >= 1 && op <= 7 {
        let l = type_of(inf, lhs(s, n));
        return if ty_is_unknown(p.tt, l) { type_of(inf, rhs(s, n)) } else { l };
    }
    return ty_unknown();
}

fn compute(inf: Infer, n: i64) -> i64 {
    let p = inf.p;
    let s = p.s;
    let k = kind(s, n);
    if k == nk_int() || k == nk_float() || k == nk_str() || k == nk_bool() {
        return prog_slot_type(p, literal_slot(k));
    }
    if k == nk_ident() {
        let b = inf.r.ref_of[n];
        if b >= 0 { return binding_type(inf, b); }
        if s.receiver.len() > 0 && node_name(s, n) == s.receiver { return receiver_type(inf, n); }
        return ty_unknown();
    }
    if k == nk_call() { return call_type(inf, n); }
    if k == nk_member() { return member_type(inf, n); }
    if k == nk_index() {
        if some m = prog_member(p, type_of(inf, lhs(s, n)), op_index()) { return prog_member_type(p, m); }
        return ty_unknown();
    }
    if k == nk_binary() { return binary_type(inf, n); }
    if k == nk_unary() {
        if flags(s, n) == unary_some() { return prog_slot_type(p, literal_slot(nk_bool())); }
        return type_of(inf, lhs(s, n));
    }
    if k == nk_try_propagate() || k == nk_catch_recovery() {
        return unwrap_type(p, type_of(inf, lhs(s, n)));
    }
    if k == nk_expr_stmt() { return type_of(inf, lhs(s, n)); }
    if k == nk_lambda() { return lambda_type(inf, n); }
    if k == nk_list() { return list_type(inf, n); }
    if k == nk_yield() { return sent_type(inf, n); }
    if k == nk_for() && for_collects(p, n) { return collected_type(inf, n); }
    if k == nk_block() { return block_value(inf, n); }
    if k == nk_if() {
        let ch = children(s, n);
        if ch.len() < 3 { return ty_unknown(); }
        return agree(p, block_value(inf, ch[1]), block_value(inf, ch[2]));
    }
    if k == nk_match() {
        let ch = children(s, n);
        var t = ty_unknown();
        var i = 1;
        while i < ch.len() {
            let body = block_value(inf, rhs(s, ch[i]));
            t = if i == 1 { body } else { agree(p, t, body) };
            i = i + 1;
        }
        return t;
    }
    return ty_unknown();
}

/// The return type of function `f`: its annotation, or for a generator
/// written without one, the generator type over the items it yields.
pub fn fn_return_type(inf: Infer, f: i64) -> i64 {
    let p = inf.p;
    if annot(p.s, f) >= 0 { return prog_annot_type(p, annot(p.s, f)); }
    if is_generator(p, f) { return generator_type(inf, yielded_type(inf, f)); }
    return ty_unknown();
}

/// The generator type over items of type `item`, its other parameters at
/// their defaults; the unknown type when no generator type is bound.
pub fn generator_type(inf: Infer, item: i64) -> i64 {
    let p = inf.p;
    let d = generator_decl(p);
    if d < 0 { return ty_unknown(); }
    let name = p.s.generator[0];
    var args: List<i64> = [item];
    let defaults = prog_tparam_defaults(p, name);
    while args.len() < defaults.len() && defaults[args.len()] >= 0 {
        args.push(prog_annot_type(p, defaults[args.len()]));
    }
    return ty_named(p.tt, d, name, args);
}

/// The type the `yield`s belonging to `owner` agree on: each `yield e`
/// gives `e`, each `yield *xs` an element of `xs`.
pub fn yielded_type(inf: Infer, owner: i64) -> i64 {
    let p = inf.p;
    var t = ty_unknown();
    var first = true;
    for y in owned_yields(p, owner) {
        let v = lhs(p.s, y);
        let item = if is_delegation(p, y) { iterated_type(inf, lhs(p.s, v)) } else { type_of(inf, v) };
        t = if first { item } else { agree(p, t, item) };
        first = false;
    }
    return t;
}

/// The value of `yield` node `y`: what a `send` passes in, the generator
/// type's second argument; unknown inside a collecting `for`.
fn sent_type(inf: Infer, y: i64) -> i64 {
    let p = inf.p;
    let owner = yield_owner(p, y);
    if owner < 0 || kind(p.s, owner) == nk_for() || is_delegation(p, y) { return ty_unknown(); }
    let g = fn_return_type(inf, owner);
    if !ty_is_named(p.tt, g) || ty_decl(p.tt, g) != generator_decl(p) { return ty_unknown(); }
    let args = ty_args(p.tt, g);
    return if args.len() > 1 { args[1] } else { ty_unknown() };
}

/// A collecting `for`: a list (the `list_t` slot) of what it yields.
fn collected_type(inf: Infer, f: i64) -> i64 {
    let p = inf.p;
    let lt = prog_slot_type(p, list_slot());
    if !ty_is_named(p.tt, lt) { return ty_unknown(); }
    return ty_named(p.tt, ty_decl(p.tt, lt), p.tt.name[lt], [yielded_type(inf, f)]);
}

/// The type of expression `n` (the unknown type when not derived).
pub fn type_of(inf: Infer, n: i64) -> i64 {
    if n < 0 { return ty_unknown(); }
    let m = inf.memo[n];
    if m >= 0 { return m; }
    if m == -2 { return ty_unknown(); }
    inf.memo[n] = -2;
    let t = compute(inf, n);
    inf.memo[n] = t;
    return t;
}
