// ==============================================================================
// FILE: selfhost/check/diag.pilot
// Diagnostics the checker collects, in the shape the host reads back.
// ==============================================================================
// Each entry is `[code, message, span start, span end, severity]`, spans in
// the linked program's offset space (crates/pilot-cli/src/check.rs maps them
// to files). Severities follow selfhost/diagnostics/model.pilot: 1 error,
// 2 warning, 3 info.
pub lvl(0) pkg selfhost.check;


/// One diagnostic: code, message, span start, span end, severity.
pub type DiagRow = (str, str, i64, i64, i64);

pub struct DiagSink {
    pub ref s: Snap;
    pub rows: List<DiagRow>;
    /// `code@start` of every reported diagnostic, so a node is reported once.
    pub seen: Map<str, i64>;
}

pub fn sink_new(ref s: Snap) -> DiagSink => DiagSink { s: s, rows: [], seen: Map<str, i64>() };

fn sink_add(var ref sink: DiagSink, n: i64, code: str, message: str, severity: i64) {
    if !in_user_file(sink.s, n) { return; }
    let start = span_start(sink.s, n);
    let key = code + "@" + f"{start}";
    if sink.seen.has(key) { return; }
    sink.seen.set(key, 1);
    sink.rows.push((code, message, start, span_end(sink.s, n), severity));
}

pub fn sink_error(var ref sink: DiagSink, n: i64, code: str, message: str) {
    sink_add(sink, n, code, message, 1);
}

pub fn sink_warning(var ref sink: DiagSink, n: i64, code: str, message: str) {
    sink_add(sink, n, code, message, 2);
}

pub fn sink_info(var ref sink: DiagSink, n: i64, code: str, message: str) {
    sink_add(sink, n, code, message, 3);
}
