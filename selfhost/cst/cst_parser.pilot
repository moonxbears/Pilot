// ============================================================================
// FILE: selfhost/cst/cst_parser.pilot
// Milestone 53.1 & 53.2: Lossless Trivia-Preserving CST Parser & Recovery
// Preserves 100% of whitespace/comments/shebangs and synthesizes zero-width
// MissingIdent, MissingRParen, and MissingRBrace recovery markers.
// ============================================================================

comptime {
    __engine("bind_receptor", nameof(cst_detect_missing_ident), 33, 25);
}

pub struct ParsedCstSummary {
    pub lossless_text: str;
    pub has_missing_ident: bool;
    pub has_missing_rparen: bool;
    pub has_missing_rbrace: bool;
    pub diagnostic_count: i64;
    pub first_fix_it: str;
}

pub pure fn is_ascii_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

pub pure fn is_horiz_ws(b: u8) -> bool {
    return b == 32 || b == 9 || b == 13;
}

pub pure fn is_ident_start_byte(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

pub pure fn is_ident_cont_byte(b: u8) -> bool {
    return is_ident_start_byte(b) || (b >= 48 && b <= 57);
}

pub fn unwrap_sym_quote_arg(raw: str) -> str {
    let n = raw.len();
    if n < 2 || raw.byte_at(0) != 34 || raw.byte_at(n - 1) != 34 {
        return raw;
    }
    var out = "";
    var i = 1;
    let end = n - 1;
    while i < end {
        let b = raw.byte_at(i);
        if b == 92 && i + 1 < end {
            let nx = raw.byte_at(i + 1);
            if nx == 110 {
                out = out + "\n";
            } else if nx == 114 {
                out = out + "\r";
            } else if nx == 116 {
                out = out + "\t";
            } else if nx == 34 {
                out = out + "\"";
            } else if nx == 92 {
                out = out + "\\";
            } else {
                out = out + raw.slice(i + 1, i + 2);
            }
            i = i + 2;
        } else {
            out = out + raw.slice(i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

// Advances past whitespace and comments (`//...`, `/*...*/`, line-1 shebang) starting at `pos`.
pub fn skip_cst_trivia(src: str, pos: i64) -> i64 {
    let n = src.len();
    var p = pos;
    while p < n {
        let b = src.byte_at(p);
        if is_ascii_ws(b) {
            p = p + 1;
        } else if b == 47 && p + 1 < n && src.byte_at(p + 1) == 47 {
            p = p + 2;
            while p < n && src.byte_at(p) != 10 {
                p = p + 1;
            }
        } else if b == 47 && p + 1 < n && src.byte_at(p + 1) == 42 {
            p = p + 2;
            while p + 1 < n && !(src.byte_at(p) == 42 && src.byte_at(p + 1) == 47) {
                p = p + 1;
            }
            if p + 1 < n {
                p = p + 2;
            } else {
                p = n;
            }
        } else if p == 0 && b == 35 && p + 1 < n && src.byte_at(p + 1) == 33 {
            while p < n && src.byte_at(p) != 10 {
                p = p + 1;
            }
        } else {
            return p;
        }
    }
    return p;
}

// Consumes trailing horizontal trivia, trailing line comment, and up to one `\n` on the same line.
pub fn consume_cst_line_tail_trivia(src: str, pos: i64) -> i64 {
    let n = src.len();
    var p = pos;
    while p < n {
        let b = src.byte_at(p);
        if is_horiz_ws(b) {
            p = p + 1;
        } else if b == 47 && p + 1 < n && src.byte_at(p + 1) == 47 {
            p = p + 2;
            while p < n && src.byte_at(p) != 10 {
                p = p + 1;
            }
            if p < n && src.byte_at(p) == 10 {
                return p + 1;
            }
            return p;
        } else if b == 47 && p + 1 < n && src.byte_at(p + 1) == 42 {
            var q = p + 2;
            var saw_nl = false;
            while q + 1 < n && !(src.byte_at(q) == 42 && src.byte_at(q + 1) == 47) {
                if src.byte_at(q) == 10 {
                    saw_nl = true;
                }
                q = q + 1;
            }
            if saw_nl || q + 1 >= n {
                return p;
            }
            p = q + 2;
        } else if b == 10 {
            return p + 1;
        } else {
            return p;
        }
    }
    return p;
}

// Scans the identifier starting at `pos` (or returns `""` if not at an identifier).
pub fn read_ident_at(src: str, pos: i64) -> str {
    let n = src.len();
    if pos >= n || !is_ident_start_byte(src.byte_at(pos)) {
        return "";
    }
    var end = pos + 1;
    while end < n && is_ident_cont_byte(src.byte_at(end)) {
        end = end + 1;
    }
    return src.slice(pos, end);
}

pub fn skip_cst_string_or_char(src: str, pos: i64) -> i64 {
    let n = src.len();
    if pos >= n {
        return pos;
    }
    let quote_b = src.byte_at(pos);
    var p = pos + 1;
    while p < n && src.byte_at(p) != quote_b {
        if src.byte_at(p) == 92 {
            p = p + 2;
        } else {
            p = p + 1;
        }
    }
    if p < n {
        p = p + 1;
    }
    return p;
}

pub fn skip_cst_balanced_delim(src: str, pos: i64, open_b: u8, close_b: u8) -> i64 {
    let n = src.len();
    if pos >= n || src.byte_at(pos) != open_b {
        return pos;
    }
    var depth = 1;
    var p = pos + 1;
    while p < n && depth > 0 {
        let b = src.byte_at(p);
        if b == 34 || b == 39 {
            p = skip_cst_string_or_char(src, p);
        } else if b == 47 && p + 1 < n && src.byte_at(p + 1) == 47 {
            p = p + 2;
            while p < n && src.byte_at(p) != 10 {
                p = p + 1;
            }
        } else if b == 47 && p + 1 < n && src.byte_at(p + 1) == 42 {
            p = p + 2;
            while p + 1 < n && !(src.byte_at(p) == 42 && src.byte_at(p + 1) == 47) {
                p = p + 1;
            }
            if p + 1 < n {
                p = p + 2;
            } else {
                p = n;
            }
        } else {
            if b == open_b {
                depth = depth + 1;
            } else if b == close_b {
                depth = depth - 1;
            }
            p = p + 1;
        }
    }
    return p;
}

// Classifies a top-level CST declaration island in a 100% name-blind manner via `nameof(...)`.
pub fn classify_cst_decl_kind(island_src: str) -> i64 {
    let n = island_src.len();
    var p = skip_cst_trivia(island_src, 0);
    while p < n {
        let b = island_src.byte_at(p);
        if b == 91 {
            p = skip_cst_balanced_delim(island_src, p, 91, 93);
            p = skip_cst_trivia(island_src, p);
        } else if is_ident_start_byte(b) {
            let w = read_ident_at(island_src, p);
            if w == nameof(fn) {
                return cst_kind_fn_decl();
            }
            if w == nameof(struct) {
                return cst_kind_struct_decl();
            }
            if w == nameof(interface) {
                return cst_kind_interface_decl();
            }
            if w == nameof(let) || w == nameof(var) || w == nameof(const) {
                return cst_kind_let_stmt();
            }
            p = p + w.len();
            p = skip_cst_trivia(island_src, p);
            if w == nameof(lvl) && p < n && island_src.byte_at(p) == 40 {
                p = skip_cst_balanced_delim(island_src, p, 40, 41);
                p = skip_cst_trivia(island_src, p);
            }
        } else {
            return cst_kind_let_stmt();
        }
    }
    return cst_kind_whitespace();
}

// Builds a lossless GreenNode for a single declaration island with token/block sub-children.
pub fn build_cst_decl_node(island_src: str) -> i64 {
    let n = island_src.len();
    let kind = classify_cst_decl_kind(island_src);
    let decl = cst_alloc_node(kind, island_src);

    var p = skip_cst_trivia(island_src, 0);
    if p > 0 {
        let lead = cst_alloc_node(cst_kind_comment(), island_src.slice(0, p));
        cst_append_child(decl, lead);
    }

    while p < n {
        let tok_start = p;
        let b = island_src.byte_at(p);
        var tok_kind = cst_kind_token();
        if b == 123 {
            tok_kind = cst_kind_block_expr();
            p = skip_cst_balanced_delim(island_src, p, 123, 125);
        } else if is_ident_start_byte(b) {
            tok_kind = cst_kind_ident();
            let w = read_ident_at(island_src, p);
            p = p + w.len();
        } else if b == 34 || b == 39 {
            p = skip_cst_string_or_char(island_src, p);
        } else if b >= 48 && b <= 57 {
            while p < n && (is_ident_cont_byte(island_src.byte_at(p)) || island_src.byte_at(p) == 46) {
                p = p + 1;
            }
        } else if (b == 45 || b == 61) && p + 1 < n && island_src.byte_at(p + 1) == 62 {
            p = p + 2;
        } else {
            p = p + 1;
        }
        let next_p = skip_cst_trivia(island_src, p);
        let child = cst_alloc_node(tok_kind, island_src.slice(tok_start, next_p));
        cst_append_child(decl, child);
        p = next_p;
    }

    return decl;
}

// Parses `src` into a hierarchical lossless GreenNode CST rooted at `cst_kind_program()` (`500`).
pub fn parse_lossless_cst(src: str) -> i64 {
    let n = src.len();
    let root = cst_alloc_node(cst_kind_program(), src);
    if n == 0 {
        return root;
    }

    var island_start = 0;
    var brace_depth = 0;
    var paren_depth = 0;
    var bracket_depth = 0;
    var has_code_tok = false;
    var last_decl = -1;
    var i = 0;

    while i < n {
        let next_tok = skip_cst_trivia(src, i);
        if next_tok >= n {
            if has_code_tok {
                let d_eof = build_cst_decl_node(src.slice(island_start, n));
                cst_append_child(root, d_eof);
                last_decl = d_eof;
            } else if island_start < n {
                if last_decl >= 0 {
                    cst_append_text_and_child(last_decl, src.slice(island_start, n));
                } else {
                    let tr_only = cst_alloc_node(cst_kind_comment(), src.slice(island_start, n));
                    cst_append_child(root, tr_only);
                }
            }
            return root;
        }

        i = next_tok;
        has_code_tok = true;
        let b = src.byte_at(i);

        if b == 34 || b == 39 {
            i = skip_cst_string_or_char(src, i);
        } else if b == 40 {
            paren_depth = paren_depth + 1;
            i = i + 1;
        } else if b == 41 {
            if paren_depth > 0 {
                paren_depth = paren_depth - 1;
            }
            i = i + 1;
        } else if b == 91 {
            bracket_depth = bracket_depth + 1;
            i = i + 1;
        } else if b == 93 {
            if bracket_depth > 0 {
                bracket_depth = bracket_depth - 1;
            }
            i = i + 1;
        } else if b == 123 {
            brace_depth = brace_depth + 1;
            i = i + 1;
        } else if b == 125 {
            if brace_depth > 0 {
                brace_depth = brace_depth - 1;
            }
            i = i + 1;
            if brace_depth == 0 && paren_depth == 0 && bracket_depth == 0 {
                let after_semi = skip_cst_trivia(src, i);
                if after_semi < n && src.byte_at(after_semi) == 59 {
                    i = after_semi + 1;
                }
                let island_end = consume_cst_line_tail_trivia(src, i);
                let decl_node = build_cst_decl_node(src.slice(island_start, island_end));
                cst_append_child(root, decl_node);
                last_decl = decl_node;
                island_start = island_end;
                has_code_tok = false;
                i = island_end;
            }
        } else if b == 59 && brace_depth == 0 && paren_depth == 0 && bracket_depth == 0 {
            i = i + 1;
            let island_end = consume_cst_line_tail_trivia(src, i);
            let decl_node = build_cst_decl_node(src.slice(island_start, island_end));
            cst_append_child(root, decl_node);
            last_decl = decl_node;
            island_start = island_end;
            has_code_tok = false;
            i = island_end;
        } else {
            i = i + 1;
        }
    }

    if island_start < n {
        if has_code_tok || last_decl < 0 {
            let tail_decl = build_cst_decl_node(src.slice(island_start, n));
            cst_append_child(root, tail_decl);
        } else {
            cst_append_text_and_child(last_decl, src.slice(island_start, n));
        }
    }
    return root;
}

// Detects missing identifier after `fn`, `struct`, `interface`, `let`, or `var`
// while ignoring keywords inside string literals and line/block comments.
pub fn cst_detect_missing_ident(src: str) -> bool {
    let clean = unwrap_sym_quote_arg(src);
    let n = clean.len();
    var p = skip_cst_trivia(clean, 0);
    while p < n {
        let b = clean.byte_at(p);
        if b == 34 || b == 39 {
            p = skip_cst_string_or_char(clean, p);
        } else if is_ident_start_byte(b) {
            let word = read_ident_at(clean, p);
            p = p + word.len();
            let next_p = skip_cst_trivia(clean, p);
            if word == nameof(fn) || word == nameof(struct) || word == nameof(interface) {
                if next_p >= n || !is_ident_start_byte(clean.byte_at(next_p)) {
                    return true;
                }
            } else if word == nameof(let) || word == nameof(var) {
                if next_p >= n || (!is_ident_start_byte(clean.byte_at(next_p)) && clean.byte_at(next_p) != 40 && clean.byte_at(next_p) != 91) {
                    return true;
                }
            }
        } else {
            p = p + 1;
        }
        p = skip_cst_trivia(clean, p);
    }
    return false;
}

// Detects missing closing parenthesis `)` before `{` or `;` or EOF.
pub fn cst_detect_missing_rparen(src: str) -> bool {
    let n = src.len();
    var paren_depth = 0;
    var p = skip_cst_trivia(src, 0);
    while p < n {
        let b = src.byte_at(p);
        if b == 34 || b == 39 {
            p = skip_cst_string_or_char(src, p);
        } else {
            if b == 40 {
                paren_depth = paren_depth + 1;
            } else if b == 41 {
                if paren_depth > 0 {
                    paren_depth = paren_depth - 1;
                } else {
                    return true;
                }
            } else if (b == 123 || b == 59) && paren_depth > 0 {
                return true;
            }
            p = p + 1;
        }
        p = skip_cst_trivia(src, p);
    }
    return paren_depth > 0;
}

// Detects unclosed `{` block at EOF (`MissingRBrace`).
pub fn cst_detect_missing_rbrace(src: str) -> bool {
    let n = src.len();
    var brace_depth = 0;
    var p = skip_cst_trivia(src, 0);
    while p < n {
        let b = src.byte_at(p);
        if b == 34 || b == 39 {
            p = skip_cst_string_or_char(src, p);
        } else {
            if b == 123 {
                brace_depth = brace_depth + 1;
            } else if b == 125 {
                if brace_depth > 0 {
                    brace_depth = brace_depth - 1;
                } else {
                    return true;
                }
            }
            p = p + 1;
        }
        p = skip_cst_trivia(src, p);
    }
    return brace_depth > 0;
}

// Lossless round-trip CST text projection (`cst_roundtrip_text(src) == src`).
pub fn cst_roundtrip_text(src: str) -> str {
    let root = parse_lossless_cst(src);
    return cst_node_text(root);
}
