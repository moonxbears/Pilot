// ==============================================================================
// FILE: selfhost/lex/lex_tool.pilot
// `pilot lex <file>`: a file's tokens, from the token declarations alone.
// ==============================================================================
// The modal lexer is built from every token family declared in
// stdlib/core/lex/ and from every operator symbol the program and its
// declarations declare (PROP-021 slice 21C), and the file is read into the
// token tape (`pilot.lex`, slice 21E). One line per token on the tape
// (spaces and newlines are not on it): `family:text` (a newline inside the
// text is shown as `\n`). A byte that starts no token is LEX001 and an
// unbalanced bracket LEX006; the exit code is then 1.
pub lvl(0) pkg selfhost.lex;

use selfhost.check.*;
use Pilot.Core.Lex.Patterns;
use Pilot.Core.Lex.Lexicon;
use Pilot.Core.Lex.Operators;
use pilot.lex.build;
use pilot.lex.modes;
use pilot.lex.cache;
use pilot.lex;

/// The lexer modes of the program being checked: every token family
/// declared in stdlib/core/lex/ and every operator the program and its
/// declarations declare.
pub fn program_modes() -> List<LexMode> {
    let s = snap_load();
    let p = prog_new(s);
    return core_modes(operator_tokens(declared_operator_symbols(p), declared_postfix_symbols(p)));
}

/// The modal lexer of `program_modes()`, built (or read from the cache);
/// its build errors are reported.
pub fn program_lexer() -> ModalBuild {
    let modes = program_modes();
    let built = build_modes_cached(modes, LEX_CACHE_DIR);
    for e in built.errors {
        eprint(f"{e.code}: {e.message}");
    }
    return built;
}

/// The tokens of the file at `path`, as described above.
pub fn lex_main(path: str) -> i64 {
    let built = program_lexer();
    if !built.ok() { return 1; }
    let src = File.read_text(path);
    let tb = build_tape(built.lexer, src);
    var i = 0;
    while i < tb.tape.len() {
        let fam = tb.tape.family(built.lexer, i);
        let text = tb.tape.text(built.lexer, src, i).replace("\n", "\\n");
        print(f"{fam}:{text}");
        i = i + 1;
    }
    for e in tb.errors {
        eprint(f"{e.code}: {e.message} of {path}");
    }
    return if tb.ok() { 0 } else { 1 };
}
