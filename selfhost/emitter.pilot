# ==============================================================================
# selfhost/emitter.pilot: C11/C23 Code Generator Written in Pilot
# ==============================================================================

def emit_c_preamble() -> void {
    puts("/* Generated by Self-Hosted Pilot Compiler (C11 Backend) */")
    puts("#ifndef _GNU_SOURCE")
    puts("#define _GNU_SOURCE")
    puts("#endif")
    puts("#include <stdint.h>")
    puts("#include <stdbool.h>")
    puts("#include <stddef.h>")
    puts("#include <stdio.h>")
    puts("#include <stdlib.h>")
    puts("#include <string.h>")
    puts("#include <math.h>")
    puts("#include <time.h>")
    puts("#include \"pilot_runtime.h\"")
    puts("")
}

def emit_c_function_header(name: str, ret_type: str, params: str) -> void {
    printf("%s %s(%s) {\n", ret_type, name, params)
}

def emit_c_function_footer() -> void {
    puts("}\n")
}
