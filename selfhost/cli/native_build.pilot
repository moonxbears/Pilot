// ==============================================================================
// FILE: selfhost/cli/native_build.pilot
// `pilot build`: a Pilot program to a native executable through C11 (F6).
// ==============================================================================
// `pilot build <file> [-o out] [--target native|c] [--release]`
//
// The program is emitted as C by `pilot emit c` (selfhost/transpile/, from
// typed PilIR), which checks it first: a program the compiler rejects is
// reported with its diagnostics, exactly as `pilot run` reports them, and
// nothing is written. The C is kept beside the executable (`<out>.c`) and
// compiled by the host's `cc` against the runtime header
// (runtime/c/pilot_rt.h) at `-O2` (`-O3` with `--release`). `--target c`
// writes the C source to `out` without compiling it. Other targets stop at
// the seam `build.target`.
//
// Exit codes: 0 built, 1 the program or the C compiler rejected it,
// 2 bad usage.
pub lvl(0) pkg Pilot.SelfHost.Cli.NativeBuild;

use Pilot.Core.File;
use std.proc;
use Pilot.SelfHost.Cli.TestEmit;

/// The executable `pilot build` writes for `program` when no `-o` is given:
/// its file name without `.pilot`, in the working directory.
pub fn default_build_output(program: str) -> str {
    var start = 0;
    var i = 0;
    while i < program.len() {
        if program.byte_at(i) == 47 { start = i + 1; }
        i = i + 1;
    }
    let base = program.slice(start, program.len());
    return if base.ends_with(".pilot") { base.slice(0, base.len() - 6) } else { base + ".out" };
}

/// Builds `program` for `target` into `out`; the command's exit code.
pub fn native_build(program: str, out: str, target: str, release: bool) -> i64 {
    if target != "native" && target != "c" {
        return seam("build.target", f"`pilot build --target {target}`: the only backend is C11 (`native`, `c`); LLVM, WASM, GPU and assembly backends come later");
    }
    let exe = proc.current_exe() ?? "pilot";
    let emitted = proc.run(exe, ["emit", "c", program], "");
    // Diagnostics, warnings included, as `pilot emit` reported them.
    if emitted.stderr.len() > 0 { eprint(emitted.stderr.slice(0, emitted.stderr.len() - 1)); }
    if emitted.exit_code != 0 { return 1; }
    let c_path = if target == "c" { out } else { out + ".c" };
    if !File.write_text(c_path, emitted.stdout) {
        eprint(f"error: cannot write `{c_path}`");
        return 1;
    }
    if target == "c" { return 0; }
    let level = if release { "-O3" } else { "-O2" };
    let cc = proc.run("cc", ["-std=c11", level, "-w", "-I", c_runtime_dir(), c_path, "-o", out, "-lm"], "");
    if cc.exit_code != 0 {
        eprint(f"error: the C compiler rejected `{c_path}`");
        eprint(cc.stdout + cc.stderr);
        return 1;
    }
    return 0;
}
