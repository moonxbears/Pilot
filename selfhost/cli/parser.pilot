// ==============================================================================
// FILE: selfhost/cli/parser.pilot
// Milestone 3.2: Zero-Copy POSIX/GNU Argument Parser & Typo Recommender
// Implements --flag=val, -f, -- passthrough, and Damerau-Levenshtein suggestions
// ==============================================================================
pub lvl(0) pkg selfhost.cli;

use Pilot.Core.Primitives.Map::*;
use Pilot.Core.Env::*;

// ------------------------------------------------------------------------------
// String Utilities
// ------------------------------------------------------------------------------

pub pure fn cp_trim(s: str) -> str {
    let l = s.len();
    var start: i64 = 0;
    while start < l {
        let b = s.byte_at(start);
        if b != 32 && b != 9 && b != 13 && b != 10 { break; }
        start = start + 1;
    }
    var end: i64 = l;
    while end > start {
        let b = s.byte_at(end - 1);
        if b != 32 && b != 9 && b != 13 && b != 10 { break; }
        end = end - 1;
    }
    return s.slice(start, end);
}

pub pure fn cp_starts_with(s: str, pfx: str) -> bool {
    let sl = s.len();
    let pl = pfx.len();
    if pl > sl { return false; }
    var i: i64 = 0;
    while i < pl {
        if s.byte_at(i) != pfx.byte_at(i) { return false; }
        i = i + 1;
    }
    return true;
}

pub pure fn cp_ends_with(s: str, sfx: str) -> bool {
    let sl = s.len();
    let xl = sfx.len();
    if xl > sl { return false; }
    var i: i64 = 0;
    while i < xl {
        if s.byte_at(sl - xl + i) != sfx.byte_at(i) { return false; }
        i = i + 1;
    }
    return true;
}

pub pure fn cp_min(a: i64, b: i64) -> i64 {
    return if a < b { a } else { b };
}

// ------------------------------------------------------------------------------
// Damerau-Levenshtein Edit Distance (Bounded on <= 32 char tokens)
// ------------------------------------------------------------------------------

pub fn cli_levenshtein(s1: str, s2: str) -> i64 {
    let l1 = s1.len();
    let l2 = s2.len();
    if l1 == 0 { return l2; }
    if l2 == 0 { return l1; }

    var v0: List<i64> = [];
    var v1: List<i64> = [];

    var j: i64 = 0;
    while j <= l2 {
        v0.push(j);
        v1.push(0);
        j = j + 1;
    }

    var i: i64 = 0;
    while i < l1 {
        v1[0] = i + 1;
        let c1 = s1.byte_at(i);

        j = 0;
        while j < l2 {
            let c2 = s2.byte_at(j);
            let cost: i64 = if c1 == c2 { 0 } else { 1 };
            let deletion: i64 = v0[j + 1] + 1;
            let insertion: i64 = v1[j] + 1;
            let substitution: i64 = v0[j] + cost;

            let m1 = cp_min(deletion, insertion);
            let res = cp_min(m1, substitution);
            v1[j + 1] = res;
            j = j + 1;
        }

        j = 0;
        while j <= l2 {
            v0[j] = v1[j];
            j = j + 1;
        }

        i = i + 1;
    }

    return v0[l2];
}

pub fn cli_suggest_typo(input: str, ref candidates: List<str>) -> str {
    let count = candidates.len();
    var best_match = "";
    var best_dist: i64 = 3; // strictly <= 2

    var i: i64 = 0;
    while i < count {
        let cand = candidates[i];
        let d = cli_levenshtein(input, cand);
        if d < best_dist {
            best_dist = d;
            best_match = cand;
        }
        i = i + 1;
    }

    return if best_dist <= 2 { best_match } else { "" };
}

// ------------------------------------------------------------------------------
// Tokenizer supporting whitespace and \x1f separators
// ------------------------------------------------------------------------------

pub fn cli_tokenize(raw: str) -> List<str> {
    var tokens: List<str> = [];
    let l = raw.len();
    if l == 0 { return tokens; }

    // Check if ASCII 31 (\x1f) is used as separator
    var has_unit_sep = false;
    var i: i64 = 0;
    while i < l {
        if raw.byte_at(i) == 31 {
            has_unit_sep = true;
            break;
        }
        i = i + 1;
    }

    // Separated argv entries are exact: each is kept verbatim, empty or not.
    if has_unit_sep {
        var start: i64 = 0;
        i = 0;
        while i < l {
            if raw.byte_at(i) == 31 {
                tokens.push(raw.slice(start, i));
                start = i + 1;
            }
            i = i + 1;
        }
        tokens.push(raw.slice(start, l));
        return tokens;
    }

    // Standard shell whitespace splitting with quote awareness
    var pos: i64 = 0;
    while pos < l {
        while pos < l && (raw.byte_at(pos) == 32 || raw.byte_at(pos) == 9) {
            pos = pos + 1;
        }
        if pos >= l { break; }

        let b = raw.byte_at(pos);
        if b == 34 { // '"'
            pos = pos + 1;
            let start = pos;
            while pos < l && raw.byte_at(pos) != 34 {
                pos = pos + 1;
            }
            let tok = raw.slice(start, pos);
            tokens.push(tok);
            if pos < l { pos = pos + 1; }
        } else if b == 39 { // '\''
            pos = pos + 1;
            let start = pos;
            while pos < l && raw.byte_at(pos) != 39 {
                pos = pos + 1;
            }
            let tok = raw.slice(start, pos);
            tokens.push(tok);
            if pos < l { pos = pos + 1; }
        } else {
            let start = pos;
            while pos < l && raw.byte_at(pos) != 32 && raw.byte_at(pos) != 9 {
                pos = pos + 1;
            }
            let tok = raw.slice(start, pos);
            tokens.push(tok);
        }
    }

    return tokens;
}

// ------------------------------------------------------------------------------
// Argument Parser Engine
// ------------------------------------------------------------------------------

pub fn cli_parse_args(ref reg: CommandRegistry, raw_argv_line: str) -> CliParse {
    let tokens = cli_tokenize(raw_argv_line);
    let num_tokens = tokens.len();

    var parsed = parsed_args_new();

    if num_tokens == 0 {
        parsed.command = "help";
        return cli_parse_ok(parsed);
    }

    let tok0 = tokens[0];

    // Global flags without subcommands
    if tok0 == "--help" || tok0 == "-h" || tok0 == "help" {
        parsed.command = "help";
        return cli_parse_ok(parsed);
    }
    if tok0 == "--version" || tok0 == "-v" || tok0 == "version" {
        parsed.command = "version";
        return cli_parse_ok(parsed);
    }
    if tok0 == "--schema-json" {
        parsed.command = "schema-json";
        return cli_parse_ok(parsed);
    }

    // Direct script detection
    var start_arg_idx: i64 = 1;
    var cmd_idx: i64 = -1;

    if cp_ends_with(tok0, ".pilot") || cp_ends_with(tok0, ".pilc") {
        parsed.command = "run";
        parsed.positionals.push(tok0);
        cmd_idx = spec_registry_find_by_name(reg, "run");
    } else {
        cmd_idx = spec_registry_find_by_name(reg, tok0);
        if cmd_idx < 0 {
            // Collect all command names & aliases for typo checking
            var candidate_list: List<str> = [];
            let n_cmds = spec_registry_count(reg);
            var ci: i64 = 0;
            while ci < n_cmds {
                let spec = reg.commands[ci];
                candidate_list.push(spec.name);
                ci = ci + 1;
            }
            let suggestion = cli_suggest_typo(tok0, candidate_list);
            let msg = if suggestion.len() > 0 {
                "CLI001: Unknown command '" + tok0 + "'. Did you mean '" + suggestion + "'?"
            } else {
                "CLI001: Unknown command '" + tok0 + "'"
            };
            return cli_parse_error("CLI001", msg);
        }
        let spec = reg.commands[cmd_idx];
        parsed.command = spec.name;
    }

    let cmd_spec = if cmd_idx >= 0 { reg.commands[cmd_idx] } else { reg.commands[0] };

    // Build lookup table for command flags
    let valid_flags = Map<str, FlagSpec>();
    var flag_candidates: List<str> = [];
    let n_flags = cmd_spec.flags.len();
    var fi: i64 = 0;
    while fi < n_flags {
        let f = cmd_spec.flags[fi];
        valid_flags.set(f.long_name, f);
        flag_candidates.push(f.long_name);
        if f.short_char.len() > 0 {
            valid_flags.set(f.short_char, f);
        }
        fi = fi + 1;
    }

    var in_passthrough = false;
    var t: i64 = start_arg_idx;

    while t < num_tokens {
        let tok = tokens[t];

        if in_passthrough {
            parsed.passthrough_args.push(tok);
            t = t + 1;
            continue;
        }

        if tok == "--" {
            in_passthrough = true;
            t = t + 1;
            continue;
        }

        // Long Flag
        if cp_starts_with(tok, "--") && tok.len() > 2 {
            let flag_body = tok.slice(2, tok.len());
            var flag_name = flag_body;
            var flag_val = "";
            var has_eq = false;

            var eq_idx: i64 = 0;
            while eq_idx < flag_body.len() {
                if flag_body.byte_at(eq_idx) == 61 { // '='
                    flag_name = flag_body.slice(0, eq_idx);
                    flag_val = flag_body.slice(eq_idx + 1, flag_body.len());
                    has_eq = true;
                    break;
                }
                eq_idx = eq_idx + 1;
            }

            if !valid_flags.has(flag_name) {
                // If it's a known global flag (--help, --version, --json)
                if flag_name == "help" || flag_name == "version" || flag_name == "json" {
                    parsed_add_flag(parsed, flag_name, "true");
                    t = t + 1;
                    continue;
                }

                let f_sugg = cli_suggest_typo(flag_name, flag_candidates);
                let msg = if f_sugg.len() > 0 {
                    "CLI002: Unknown flag '--" + flag_name + "'. Did you mean '--" + f_sugg + "'?"
                } else {
                    "CLI002: Unknown flag '--" + flag_name + "'"
                };
                return cli_parse_error("CLI002", msg);
            }

            let f_spec = valid_flags[flag_name];

            if !has_eq {
                if f_spec.kind_tag == 0 || f_spec.default_val == "false" || f_spec.default_val == "true" { // Bool
                    flag_val = "true";
                } else if t + 1 < num_tokens {
                    t = t + 1;
                    flag_val = tokens[t];
                } else {
                    let msg = "CLI003: Flag '--" + flag_name + "' requires a value";
                    return cli_parse_error("CLI003", msg);
                }
            }

            // Choice validation
            if f_spec.kind_tag == 5 && f_spec.choices_csv.len() > 0 {
                let choices = f_spec.choices_csv;
                var found_choice = false;
                var c_start: i64 = 0;
                while c_start < choices.len() {
                    var c_end = c_start;
                    while c_end < choices.len() && choices.byte_at(c_end) != 44 { // ','
                        c_end = c_end + 1;
                    }
                    let opt = cp_trim(choices.slice(c_start, c_end));
                    if opt == flag_val {
                        found_choice = true;
                        break;
                    }
                    c_start = c_end + 1;
                }
                if !found_choice {
                    let msg = "CLI004: Invalid value '" + flag_val + "' for flag '--" + flag_name + "'. Allowed: " + choices;
                    return cli_parse_error("CLI004", msg);
                }
            }

            parsed_add_flag(parsed, f_spec.long_name, flag_val);
            t = t + 1;
            continue;
        }

        // Short Flag
        if cp_starts_with(tok, "-") && tok.len() > 1 && !cp_starts_with(tok, "--") {
            let sc = tok.slice(1, 2);
            if valid_flags.has(sc) {
                let f_spec = valid_flags[sc];
                var flag_val = "";
                if f_spec.kind_tag == 0 || f_spec.default_val == "false" || f_spec.default_val == "true" { // Bool
                    flag_val = "true";
                } else if tok.len() > 2 {
                    flag_val = tok.slice(2, tok.len());
                } else if t + 1 < num_tokens {
                    t = t + 1;
                    flag_val = tokens[t];
                }

                parsed_add_flag(parsed, f_spec.long_name, flag_val);
                t = t + 1;
                continue;
            }
        }

        // Positional argument
        parsed.positionals.push(tok);
        t = t + 1;
    }

    // Check required flags
    fi = 0;
    while fi < n_flags {
        let f = cmd_spec.flags[fi];
        if f.required && !parsed.flag_values.has(f.long_name) {
            if f.env_fallback.len() > 0 {
                let ev = Env.get(f.env_fallback);
                if ev.len() > 0 {
                    parsed_add_flag(parsed, f.long_name, ev);
                } else {
                    let msg = "CLI003: Missing required flag '--" + f.long_name + "'";
                    return cli_parse_error("CLI003", msg);
                }
            } else {
                let msg = "CLI003: Missing required flag '--" + f.long_name + "'";
                return cli_parse_error("CLI003", msg);
            }
        }
        fi = fi + 1;
    }

    return cli_parse_ok(parsed);
}
