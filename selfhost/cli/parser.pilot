// ==============================================================================
// FILE: selfhost/cli/parser.pilot
// Milestone 3.2: Zero-Copy POSIX/GNU Argument Parser & Typo Recommender
// Implements --flag=val, -f, -- passthrough, and Damerau-Levenshtein suggestions
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Cli.Parser;

use Pilot.Core.Primitives.Map::*;
use Pilot.Core.Env::*;
use Pilot.SelfHost.Cli.Spec::*;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// String Utilities
// ------------------------------------------------------------------------------

pub pure fn cp_trim(s: str) -> str {
    let l = s.len();
    var start: usize = 0;
    while start < l {
        let b = s.byte_at(start);
        if b != 32 && b != 9 && b != 13 && b != 10 { break; }
        start = start + 1;
    }
    var end: usize = l;
    while end > start {
        let b = s.byte_at(end - 1);
        if b != 32 && b != 9 && b != 13 && b != 10 { break; }
        end = end - 1;
    }
    return s.slice(start, end);
}

pub pure fn cp_starts_with(s: str, pfx: str) -> bool {
    let sl = s.len();
    let pl = pfx.len();
    if pl > sl { return false; }
    var i: usize = 0;
    while i < pl {
        if s.byte_at(i) != pfx.byte_at(i) { return false; }
        i = i + 1;
    }
    return true;
}

pub pure fn cp_ends_with(s: str, sfx: str) -> bool {
    let sl = s.len();
    let xl = sfx.len();
    if xl > sl { return false; }
    var i: usize = 0;
    while i < xl {
        if s.byte_at(sl - xl + i) != sfx.byte_at(i) { return false; }
        i = i + 1;
    }
    return true;
}

pub pure fn cp_min(a: i64, b: i64) -> i64 {
    return if a < b { a } else { b };
}

// ------------------------------------------------------------------------------
// Damerau-Levenshtein Edit Distance (Bounded on <= 32 char tokens)
// ------------------------------------------------------------------------------

pub fn cli_levenshtein(s1: str, s2: str) -> i64 {
    let l1 = s1.len();
    let l2 = s2.len();
    if l1 == 0 { return l2 as i64; }
    if l2 == 0 { return l1 as i64; }

    let v0 = cli_list_new();
    let v1 = cli_list_new();

    var j: usize = 0;
    while j <= l2 {
        let _ = cli_list_push(v0, j as i64);
        let _ = cli_list_push(v1, 0 as i64);
        j = j + 1;
    }

    var i: usize = 0;
    while i < l1 {
        Map.set_handle(v1, 0, (i + 1) as i64);
        let c1 = s1.byte_at(i);

        j = 0;
        while j < l2 {
            let c2 = s2.byte_at(j);
            let cost: i64 = if c1 == c2 { 0 } else { 1 };
            let deletion: i64 = Map.get_handle(v0, j + 1) as i64 + 1;
            let insertion: i64 = Map.get_handle(v1, j) as i64 + 1;
            let substitution: i64 = Map.get_handle(v0, j) as i64 + cost;

            let m1 = cp_min(deletion, insertion);
            let res = cp_min(m1, substitution);
            Map.set_handle(v1, j + 1, res);
            j = j + 1;
        }

        j = 0;
        while j <= l2 {
            let val = Map.get_handle(v1, j);
            Map.set_handle(v0, j, val);
            j = j + 1;
        }

        i = i + 1;
    }

    return Map.get_handle(v0, l2) as i64;
}

pub fn cli_suggest_typo(input: str, candidates: i64) -> str {
    let count = cli_list_len(candidates);
    var best_match = "";
    var best_dist: i64 = 3; // strictly <= 2

    var i: usize = 0;
    while i < count {
        let cand = cli_list_get_str(candidates, i);
        let d = cli_levenshtein(input, cand);
        if d < best_dist {
            best_dist = d;
            best_match = cand;
        }
        i = i + 1;
    }

    return if best_dist <= 2 { best_match } else { "" };
}

// ------------------------------------------------------------------------------
// Tokenizer supporting whitespace and \x1f separators
// ------------------------------------------------------------------------------

pub fn cli_tokenize(raw: str) -> i64 {
    let tokens = cli_list_new();
    let l = raw.len();
    if l == 0 { return tokens; }

    // Check if ASCII 31 (\x1f) is used as separator
    var has_unit_sep = false;
    var i: usize = 0;
    while i < l {
        if raw.byte_at(i) == 31 {
            has_unit_sep = true;
            break;
        }
        i = i + 1;
    }

    // Separated argv entries are exact: each is kept verbatim, empty or not.
    if has_unit_sep {
        var start: usize = 0;
        i = 0;
        while i < l {
            if raw.byte_at(i) == 31 {
                let _ = cli_list_push(tokens, raw.slice(start, i));
                start = i + 1;
            }
            i = i + 1;
        }
        let _ = cli_list_push(tokens, raw.slice(start, l));
        return tokens;
    }

    // Standard shell whitespace splitting with quote awareness
    var pos: usize = 0;
    while pos < l {
        while pos < l && (raw.byte_at(pos) == 32 || raw.byte_at(pos) == 9) {
            pos = pos + 1;
        }
        if pos >= l { break; }

        let b = raw.byte_at(pos);
        if b == 34 { // '"'
            pos = pos + 1;
            let start = pos;
            while pos < l && raw.byte_at(pos) != 34 {
                pos = pos + 1;
            }
            let tok = raw.slice(start, pos);
            let _ = cli_list_push(tokens, tok);
            if pos < l { pos = pos + 1; }
        } else if b == 39 { // '\''
            pos = pos + 1;
            let start = pos;
            while pos < l && raw.byte_at(pos) != 39 {
                pos = pos + 1;
            }
            let tok = raw.slice(start, pos);
            let _ = cli_list_push(tokens, tok);
            if pos < l { pos = pos + 1; }
        } else {
            let start = pos;
            while pos < l && raw.byte_at(pos) != 32 && raw.byte_at(pos) != 9 {
                pos = pos + 1;
            }
            let tok = raw.slice(start, pos);
            let _ = cli_list_push(tokens, tok);
        }
    }

    return tokens;
}

// ------------------------------------------------------------------------------
// Argument Parser Engine
// ------------------------------------------------------------------------------

pub fn cli_parse_args(reg: ref<CommandRegistry>, raw_argv_line: str) -> i64 {
    let res = cli_map_new();
    let _ = cli_map_set(res, "ok", false);
    let _ = cli_map_set(res, "exit_code", 0 as i64);

    let tokens = cli_tokenize(raw_argv_line);
    let num_tokens = cli_list_len(tokens);

    let parsed = ParsedArgs {
        command: "",
        flag_values: cli_map_new(),
        positionals: cli_list_new(),
        passthrough_args: cli_list_new(),
    };

    if num_tokens == 0 {
        parsed.command = "help";
        let _ = cli_map_set(res, "ok", true);
        let _ = cli_map_set(res, "parsed", parsed);
        return res;
    }

    let tok0 = cli_list_get_str(tokens, 0);

    // Global flags without subcommands
    if tok0 == "--help" || tok0 == "-h" || tok0 == "help" {
        parsed.command = "help";
        let _ = cli_map_set(res, "ok", true);
        let _ = cli_map_set(res, "parsed", parsed);
        return res;
    }
    if tok0 == "--version" || tok0 == "-v" || tok0 == "version" {
        parsed.command = "version";
        let _ = cli_map_set(res, "ok", true);
        let _ = cli_map_set(res, "parsed", parsed);
        return res;
    }
    if tok0 == "--schema-json" {
        parsed.command = "schema-json";
        let _ = cli_map_set(res, "ok", true);
        let _ = cli_map_set(res, "parsed", parsed);
        return res;
    }

    // Direct script detection
    var start_arg_idx: usize = 1;
    var cmd_idx: i64 = -1;

    if cp_ends_with(tok0, ".pilot") || cp_ends_with(tok0, ".pilc") {
        parsed.command = "run";
        let _ = cli_list_push(parsed.positionals, tok0);
        cmd_idx = spec_registry_find_by_name(reg, "run");
    } else {
        cmd_idx = spec_registry_find_by_name(reg, tok0);
        if cmd_idx < 0 {
            // Collect all command names & aliases for typo checking
            let candidate_list = cli_list_new();
            let n_cmds = spec_registry_count(reg);
            var ci: usize = 0;
            while ci < n_cmds {
                let spec = spec_registry_get(reg, ci);
                let _ = cli_list_push(candidate_list, spec.name);
                ci = ci + 1;
            }
            let suggestion = cli_suggest_typo(tok0, candidate_list);
            let msg = if suggestion.len() > 0 {
                "CLI001: Unknown command '" + tok0 + "'. Did you mean '" + suggestion + "'?"
            } else {
                "CLI001: Unknown command '" + tok0 + "'"
            };
            let _ = cli_map_set(res, "code", "CLI001");
            let _ = cli_map_set(res, "message", msg);
            let _ = cli_map_set(res, "exit_code", 2 as i64);
            return res;
        }
        let spec = spec_registry_get(reg, cmd_idx as usize);
        parsed.command = spec.name;
    }

    let cmd_spec = if cmd_idx >= 0 { spec_registry_get(reg, cmd_idx as usize) } else { spec_registry_get(reg, 0) };

    // Build lookup table for command flags
    let valid_flags = cli_map_new();
    let flag_candidates = cli_list_new();
    let n_flags = cli_list_len(cmd_spec.flags_handle);
    var fi: usize = 0;
    while fi < n_flags {
        let f: FlagSpec = cli_list_get(cmd_spec.flags_handle, fi);
        let _ = cli_map_set(valid_flags, f.long_name, f);
        let _ = cli_list_push(flag_candidates, f.long_name);
        if f.short_char.len() > 0 {
            let _ = cli_map_set(valid_flags, f.short_char, f);
        }
        fi = fi + 1;
    }

    var in_passthrough = false;
    var t: usize = start_arg_idx;

    while t < num_tokens {
        let tok = cli_list_get_str(tokens, t);

        if in_passthrough {
            let _ = cli_list_push(parsed.passthrough_args, tok);
            t = t + 1;
            continue;
        }

        if tok == "--" {
            in_passthrough = true;
            t = t + 1;
            continue;
        }

        // Long Flag
        if cp_starts_with(tok, "--") && tok.len() > 2 {
            let flag_body = tok.slice(2, tok.len());
            var flag_name = flag_body;
            var flag_val = "";
            var has_eq = false;

            var eq_idx: usize = 0;
            while eq_idx < flag_body.len() {
                if flag_body.byte_at(eq_idx) == 61 { // '='
                    flag_name = flag_body.slice(0, eq_idx);
                    flag_val = flag_body.slice(eq_idx + 1, flag_body.len());
                    has_eq = true;
                    break;
                }
                eq_idx = eq_idx + 1;
            }

            if !cli_map_contains(valid_flags, flag_name) {
                // If it's a known global flag (--help, --version, --json)
                if flag_name == "help" || flag_name == "version" || flag_name == "json" {
                    let val_list = cli_list_new();
                    let _ = cli_list_push(val_list, "true");
                    let _ = cli_map_set(parsed.flag_values, flag_name, val_list);
                    t = t + 1;
                    continue;
                }

                let f_sugg = cli_suggest_typo(flag_name, flag_candidates);
                let msg = if f_sugg.len() > 0 {
                    "CLI002: Unknown flag '--" + flag_name + "'. Did you mean '--" + f_sugg + "'?"
                } else {
                    "CLI002: Unknown flag '--" + flag_name + "'"
                };
                let _ = cli_map_set(res, "code", "CLI002");
                let _ = cli_map_set(res, "message", msg);
                let _ = cli_map_set(res, "exit_code", 2 as i64);
                return res;
            }

            let f_spec: FlagSpec = cli_map_get(valid_flags, flag_name);

            if !has_eq {
                if f_spec.kind_tag == 0 || f_spec.default_val == "false" || f_spec.default_val == "true" { // Bool
                    flag_val = "true";
                } else if t + 1 < num_tokens {
                    t = t + 1;
                    flag_val = cli_list_get_str(tokens, t);
                } else {
                    let msg = "CLI003: Flag '--" + flag_name + "' requires a value";
                    let _ = cli_map_set(res, "code", "CLI003");
                    let _ = cli_map_set(res, "message", msg);
                    let _ = cli_map_set(res, "exit_code", 2 as i64);
                    return res;
                }
            }

            // Choice validation
            if f_spec.kind_tag == 5 && f_spec.choices_csv.len() > 0 {
                let choices = f_spec.choices_csv;
                var found_choice = false;
                var c_start: usize = 0;
                while c_start < choices.len() {
                    var c_end = c_start;
                    while c_end < choices.len() && choices.byte_at(c_end) != 44 { // ','
                        c_end = c_end + 1;
                    }
                    let opt = cp_trim(choices.slice(c_start, c_end));
                    if opt == flag_val {
                        found_choice = true;
                        break;
                    }
                    c_start = c_end + 1;
                }
                if !found_choice {
                    let msg = "CLI004: Invalid value '" + flag_val + "' for flag '--" + flag_name + "'. Allowed: " + choices;
                    let _ = cli_map_set(res, "code", "CLI004");
                    let _ = cli_map_set(res, "message", msg);
                    let _ = cli_map_set(res, "exit_code", 2 as i64);
                    return res;
                }
            }

            var val_list: i64 = 0;
            if cli_map_contains(parsed.flag_values, f_spec.long_name) {
                val_list = cli_map_get(parsed.flag_values, f_spec.long_name) as i64;
            } else {
                val_list = cli_list_new();
                let _ = cli_map_set(parsed.flag_values, f_spec.long_name, val_list);
            }
            let _ = cli_list_push(val_list, flag_val);
            t = t + 1;
            continue;
        }

        // Short Flag
        if cp_starts_with(tok, "-") && tok.len() > 1 && !cp_starts_with(tok, "--") {
            let sc = tok.slice(1, 2);
            if cli_map_contains(valid_flags, sc) {
                let f_spec: FlagSpec = cli_map_get(valid_flags, sc);
                var flag_val = "";
                if f_spec.kind_tag == 0 || f_spec.default_val == "false" || f_spec.default_val == "true" { // Bool
                    flag_val = "true";
                } else if tok.len() > 2 {
                    flag_val = tok.slice(2, tok.len());
                } else if t + 1 < num_tokens {
                    t = t + 1;
                    flag_val = cli_list_get_str(tokens, t);
                }

                var val_list: i64 = 0;
                if cli_map_contains(parsed.flag_values, f_spec.long_name) {
                    val_list = cli_map_get(parsed.flag_values, f_spec.long_name) as i64;
                } else {
                    val_list = cli_list_new();
                    let _ = cli_map_set(parsed.flag_values, f_spec.long_name, val_list);
                }
                let _ = cli_list_push(val_list, flag_val);
                t = t + 1;
                continue;
            }
        }

        // Positional argument
        let _ = cli_list_push(parsed.positionals, tok);
        t = t + 1;
    }

    // Check required flags
    fi = 0;
    while fi < n_flags {
        let f: FlagSpec = cli_list_get(cmd_spec.flags_handle, fi);
        if f.required && !cli_map_contains(parsed.flag_values, f.long_name) {
            if f.env_fallback.len() > 0 {
                let ev = Env.get(f.env_fallback);
                if ev.len() > 0 {
                    let vlist = cli_list_new();
                    let _ = cli_list_push(vlist, ev);
                    let _ = cli_map_set(parsed.flag_values, f.long_name, vlist);
                } else {
                    let msg = "CLI003: Missing required flag '--" + f.long_name + "'";
                    let _ = cli_map_set(res, "code", "CLI003");
                    let _ = cli_map_set(res, "message", msg);
                    let _ = cli_map_set(res, "exit_code", 2 as i64);
                    return res;
                }
            } else {
                let msg = "CLI003: Missing required flag '--" + f.long_name + "'";
                let _ = cli_map_set(res, "code", "CLI003");
                let _ = cli_map_set(res, "message", msg);
                let _ = cli_map_set(res, "exit_code", 2 as i64);
                return res;
            }
        }
        fi = fi + 1;
    }

    let _ = cli_map_set(res, "ok", true);
    let _ = cli_map_set(res, "parsed", parsed);
    return res;
}
