// Milestone 60.3: Name-Blind Interactive REPL Formatter & Evaluator
// Replaces hardcoded type tables with dynamic session evaluator.
// =========================================================================
pub pkg Pilot.SelfHost.Cli.Repl;

pub pure fn nameof(sym: str) -> str => sym;

pub enum ReplTokenKind {
    None,
    Number,
    Ident,
    Plus,
    Minus,
    Star,
    Slash,
    LParen,
    RParen,
    Eof,
}

pub enum ReplStatementKind {
    Binding,
    Assignment,
    Expression,
}

pub fn format_repl_value(val_repr: str, layout_id: i64) -> str {
    let byte_size = if layout_id >= 0 { __engine("layout_metrics", layout_id) } else { 8 };
    return "=> " + val_repr + " (" + byte_size + "B register)";
}

pub pure fn wrap_repl_snippet(line: str) -> str {
    return nameof(fn) + " __repl_entry() { " + nameof(return) + " " + line + "; }";
}

pub fn repl_session_new() -> i64 {
    return __engine("map_new");
}

fn repl_is_digit(ch: str) -> bool {
    let b = __engine("str_byte_at", ch, 0);
    return b >= 48 && b <= 57;
}

fn repl_is_alpha(ch: str) -> bool {
    if ch == "_" { return true; }
    let b = __engine("str_byte_at", ch, 0);
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122);
}

fn repl_parse_int(s: str) -> i64 {
    let len = __engine("str_len", s);
    var v = 0;
    var i = 0;
    while i < len {
        let ch = __engine("str_slice", s, i, i + 1);
        var d = 0;
        if ch == "1" { d = 1; }
        else if ch == "2" { d = 2; }
        else if ch == "3" { d = 3; }
        else if ch == "4" { d = 4; }
        else if ch == "5" { d = 5; }
        else if ch == "6" { d = 6; }
        else if ch == "7" { d = 7; }
        else if ch == "8" { d = 8; }
        else if ch == "9" { d = 9; }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

fn repl_trim(s: str) -> str {
    let len = __engine("str_len", s);
    var start = 0;
    while start < len {
        let ch = __engine("str_slice", s, start, start + 1);
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" || ch == ";" {
            start = start + 1;
        } else {
            break;
        }
    }
    var end = len;
    while end > start {
        let ch = __engine("str_slice", s, end - 1, end);
        if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" || ch == ";" {
            end = end - 1;
        } else {
            break;
        }
    }
    return __engine("str_slice", s, start, end);
}

fn repl_tokenize(src: str) -> i64 {
    let tmap = __engine("map_new");
    let len = __engine("str_len", src);
    var pos = 0;
    var count = 0;

    while pos < len {
        while pos < len {
            let ch = __engine("str_slice", src, pos, pos + 1);
            if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                pos = pos + 1;
            } else {
                break;
            }
        }
        if pos >= len { break; }

        let ch = __engine("str_slice", src, pos, pos + 1);
        if ch == "+" {
            __engine("map_set", tmap, count + "_kind", 3);
            __engine("map_set", tmap, count + "_text", "+");
            count = count + 1;
            pos = pos + 1;
        } else if ch == "-" {
            __engine("map_set", tmap, count + "_kind", 4);
            __engine("map_set", tmap, count + "_text", "-");
            count = count + 1;
            pos = pos + 1;
        } else if ch == "*" {
            __engine("map_set", tmap, count + "_kind", 5);
            __engine("map_set", tmap, count + "_text", "*");
            count = count + 1;
            pos = pos + 1;
        } else if ch == "/" {
            __engine("map_set", tmap, count + "_kind", 6);
            __engine("map_set", tmap, count + "_text", "/");
            count = count + 1;
            pos = pos + 1;
        } else if ch == "(" {
            __engine("map_set", tmap, count + "_kind", 7);
            __engine("map_set", tmap, count + "_text", "(");
            count = count + 1;
            pos = pos + 1;
        } else if ch == ")" {
            __engine("map_set", tmap, count + "_kind", 8);
            __engine("map_set", tmap, count + "_text", ")");
            count = count + 1;
            pos = pos + 1;
        } else if repl_is_digit(ch) {
            let start = pos;
            while pos < len {
                let d = __engine("str_slice", src, pos, pos + 1);
                if repl_is_digit(d) {
                    pos = pos + 1;
                } else {
                    break;
                }
            }
            let num_str = __engine("str_slice", src, start, pos);
            let num_val = repl_parse_int(num_str);
            __engine("map_set", tmap, count + "_kind", 1);
            __engine("map_set", tmap, count + "_text", num_str);
            __engine("map_set", tmap, count + "_val", num_val);
            count = count + 1;
        } else if repl_is_alpha(ch) {
            let start = pos;
            while pos < len {
                let a = __engine("str_slice", src, pos, pos + 1);
                if repl_is_alpha(a) || repl_is_digit(a) {
                    pos = pos + 1;
                } else {
                    break;
                }
            }
            let ident_str = __engine("str_slice", src, start, pos);
            __engine("map_set", tmap, count + "_kind", 2);
            __engine("map_set", tmap, count + "_text", ident_str);
            count = count + 1;
        } else {
            pos = pos + 1;
        }
    }

    __engine("map_set", tmap, "len", count);
    return tmap;
}

fn repl_parse_factor(sess: i64, tmap: i64, pmap: i64) -> i64 {
    let ti = __engine("map_get", pmap, "pos");
    let tcnt = __engine("map_get", tmap, "len");
    if ti >= tcnt { return 0; }

    let kind = __engine("map_get", tmap, ti + "_kind");
    if kind == 1 {
        __engine("map_set", pmap, "pos", ti + 1);
        return __engine("map_get", tmap, ti + "_val");
    }
    if kind == 2 {
        let id_name = __engine("map_get", tmap, ti + "_text");
        __engine("map_set", pmap, "pos", ti + 1);
        let val = __engine("map_get", sess, id_name);
        return val;
    }
    if kind == 4 {
        __engine("map_set", pmap, "pos", ti + 1);
        let inner = repl_parse_factor(sess, tmap, pmap);
        return 0 - inner;
    }
    if kind == 7 {
        __engine("map_set", pmap, "pos", ti + 1);
        let inner = repl_parse_expr(sess, tmap, pmap);
        let nti = __engine("map_get", pmap, "pos");
        if nti < tcnt && __engine("map_get", tmap, nti + "_kind") == 8 {
            __engine("map_set", pmap, "pos", nti + 1);
        }
        return inner;
    }
    return 0;
}

fn repl_parse_term(sess: i64, tmap: i64, pmap: i64) -> i64 {
    var val = repl_parse_factor(sess, tmap, pmap);
    let tcnt = __engine("map_get", tmap, "len");
    while true {
        let ti = __engine("map_get", pmap, "pos");
        if ti >= tcnt { break; }
        let kind = __engine("map_get", tmap, ti + "_kind");
        if kind == 5 {
            __engine("map_set", pmap, "pos", ti + 1);
            let rhs = repl_parse_factor(sess, tmap, pmap);
            val = val * rhs;
        } else if kind == 6 {
            __engine("map_set", pmap, "pos", ti + 1);
            let rhs = repl_parse_factor(sess, tmap, pmap);
            if rhs != 0 {
                val = val / rhs;
            } else {
                val = 0;
            }
        } else {
            break;
        }
    }
    return val;
}

fn repl_parse_expr(sess: i64, tmap: i64, pmap: i64) -> i64 {
    var val = repl_parse_term(sess, tmap, pmap);
    let tcnt = __engine("map_get", tmap, "len");
    while true {
        let ti = __engine("map_get", pmap, "pos");
        if ti >= tcnt { break; }
        let kind = __engine("map_get", tmap, ti + "_kind");
        if kind == 3 {
            __engine("map_set", pmap, "pos", ti + 1);
            let rhs = repl_parse_term(sess, tmap, pmap);
            val = val + rhs;
        } else if kind == 4 {
            __engine("map_set", pmap, "pos", ti + 1);
            let rhs = repl_parse_term(sess, tmap, pmap);
            val = val - rhs;
        } else {
            break;
        }
    }
    return val;
}

fn repl_eval_str(sess: i64, expr_str: str) -> i64 {
    let tmap = repl_tokenize(expr_str);
    let pmap = __engine("map_new");
    __engine("map_set", pmap, "pos", 0);
    return repl_parse_expr(sess, tmap, pmap);
}

fn repl_find_char(s: str, ch: str) -> i64 {
    let len = __engine("str_len", s);
    var i = 0;
    while i < len {
        if __engine("str_slice", s, i, i + 1) == ch {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn repl_eval_line(sess: i64, line: str) -> str {
    let clean = repl_trim(line);
    let clen = __engine("str_len", clean);
    if clen == 0 { return "0"; }

    // Check if let / var binding
    let is_let = clen >= 4 && __engine("str_slice", clean, 0, 4) == "let ";
    let is_var = clen >= 4 && __engine("str_slice", clean, 0, 4) == "var ";

    if is_let || is_var {
        let eq_idx = repl_find_char(clean, "=");
        if eq_idx > 4 {
            let var_name = repl_trim(__engine("str_slice", clean, 4, eq_idx));
            let rhs_str = repl_trim(__engine("str_slice", clean, eq_idx + 1, clen));
            let res = repl_eval_str(sess, rhs_str);
            __engine("map_set", sess, var_name, res);
            return "" + res;
        }
    }

    // Check if reassignment e.g. beta = beta - 5
    let eq_pos = repl_find_char(clean, "=");
    if eq_pos > 0 {
        let prev_ch = __engine("str_slice", clean, eq_pos - 1, eq_pos);
        var is_assign = true;
        if prev_ch == "=" || prev_ch == "!" || prev_ch == "<" || prev_ch == ">" {
            is_assign = false;
        }
        if eq_pos + 1 < clen {
            let next_ch = __engine("str_slice", clean, eq_pos + 1, eq_pos + 2);
            if next_ch == "=" {
                is_assign = false;
            }
        }
        if is_assign {
            let var_name = repl_trim(__engine("str_slice", clean, 0, eq_pos));
            let rhs_str = repl_trim(__engine("str_slice", clean, eq_pos + 1, clen));
            let res = repl_eval_str(sess, rhs_str);
            __engine("map_set", sess, var_name, res);
            return "" + res;
        }
    }

    let res = repl_eval_str(sess, clean);
    return "" + res;
}
