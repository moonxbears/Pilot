// ==============================================================================
// FILE: selfhost/cli/inspect_cmd.pilot
// Milestone 7.1: Zero-Black-Box Inspection CLI Command Handler
// Registers `pilot inspect` with --weave, --layout, --methods, --perceus, --ir
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Cli.InspectCmd;

use Pilot.SelfHost.Inspect.Selector::*;

pub pure fn nameof(sym: str) -> str => sym;

pub fn inspect_cmd_help() -> str {
    var h = "";
    h = h + "Usage: pilot inspect <selector> [options]\n";
    h = h + "Options:\n";
    h = h + "  --all       Inspect all lenses (weave, layout, methods, perceus)\n";
    h = h + "  --weave     Inspect expanded attribute pipelines & synthesized accessors\n";
    h = h + "  --layout    Inspect visual byte offsets, alignment padding, and 64B cache lines\n";
    h = h + "  --methods   Inspect 4-tier MethodTable dispatch resolution and collision modifiers\n";
    h = h + "  --perceus   Inspect ARC lifetime annotations [borrow], [move], [dup], [drop]\n";
    return h;
}

// Which lenses a flag string asks for, as a bit set.
pub pure fn inspect_lens_weave()   -> u32 => 1;
pub pure fn inspect_lens_layout()  -> u32 => 2;
pub pure fn inspect_lens_methods() -> u32 => 4;
pub pure fn inspect_lens_perceus() -> u32 => 8;

pub fn inspect_parse_lenses(lens_flags: str) -> u32 {
    var bits: u32 = 0;
    if lens_flags.find("--all") >= 0 {
        return inspect_lens_weave() | inspect_lens_layout() | inspect_lens_methods() | inspect_lens_perceus();
    }
    if lens_flags.find("--weave") >= 0 { bits = bits | inspect_lens_weave(); }
    if lens_flags.find("--layout") >= 0 { bits = bits | inspect_lens_layout(); }
    if lens_flags.find("--methods") >= 0 { bits = bits | inspect_lens_methods(); }
    if lens_flags.find("--perceus") >= 0 { bits = bits | inspect_lens_perceus(); }
    return bits;
}

// Parses the selector and the lens flags, then hands the query to the
// type-checked program, which does not exist yet: the lenses render facts
// (woven statements, field offsets, MethodTable winners, Perceus events)
// that only a checked unit can supply.
pub fn inspect_run(selector_str: str, lens_flags: str) -> str {
    let q = parse_inspect_selector(selector_str);
    let lenses = inspect_parse_lenses(lens_flags);
    return seam("inspect.resolve_target", "resolving a selector against a type-checked PilotDb unit arrives in F4");
}
