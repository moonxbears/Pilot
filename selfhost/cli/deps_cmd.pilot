pub pkg Pilot.SelfHost.Cli.DepsCmd;

pub pure fn nameof(sym: str) -> str => sym;

fn str_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if haystack.slice(i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn format_manifest_tree(json_src: str) -> str {
    var name = "pilot_project";
    var version = "0.1.0";
    var license = "MIT";

    let n_idx = str_find(json_src, "\"name\":", 0);
    if n_idx >= 0 {
        let q1 = str_find(json_src, "\"", n_idx + 7);
        if q1 >= 0 {
            let q2 = str_find(json_src, "\"", q1 + 1);
            if q2 >= 0 { name = json_src.slice(q1 + 1, q2); }
        }
    }

    let v_idx = str_find(json_src, "\"version\":", 0);
    if v_idx >= 0 {
        let q1 = str_find(json_src, "\"", v_idx + 10);
        if q1 >= 0 {
            let q2 = str_find(json_src, "\"", q1 + 1);
            if q2 >= 0 { version = json_src.slice(q1 + 1, q2); }
        }
    }

    let l_idx = str_find(json_src, "\"license\":", 0);
    if l_idx >= 0 {
        let q1 = str_find(json_src, "\"", l_idx + 10);
        if q1 >= 0 {
            let q2 = str_find(json_src, "\"", q1 + 1);
            if q2 >= 0 { license = json_src.slice(q1 + 1, q2); }
        }
    }

    var out = name + " (v" + version + ") [" + license + "]\n";

    let d_idx = str_find(json_src, "\"dependencies\":", 0);
    if d_idx < 0 {
        out = out + "└── (no external dependencies)\n";
        return out;
    }

    let b_open = str_find(json_src, "{", d_idx + 15);
    if b_open < 0 {
        out = out + "└── (no external dependencies)\n";
        return out;
    }

    let b_close = str_find(json_src, "}", b_open + 1);
    if b_close < 0 {
        out = out + "└── (no external dependencies)\n";
        return out;
    }

    // Count how many dependencies exist
    var dep_count = 0;
    var scan_p = b_open + 1;
    while scan_p < b_close {
        let kq1 = str_find(json_src, "\"", scan_p);
        if kq1 < 0 || kq1 >= b_close { break; }
        let kq2 = str_find(json_src, "\"", kq1 + 1);
        if kq2 < 0 || kq2 >= b_close { break; }
        let col = str_find(json_src, ":", kq2 + 1);
        if col < 0 || col >= b_close { break; }
        let vq1 = str_find(json_src, "\"", col + 1);
        if vq1 < 0 || vq1 >= b_close { break; }
        let vq2 = str_find(json_src, "\"", vq1 + 1);
        if vq2 < 0 || vq2 >= b_close { break; }
        dep_count = dep_count + 1;
        scan_p = vq2 + 1;
    }

    if dep_count == 0 {
        out = out + "└── (no external dependencies)\n";
        return out;
    }

    var p = b_open + 1;
    var cur_idx = 0;
    while p < b_close {
        let k_q1 = str_find(json_src, "\"", p);
        if k_q1 < 0 || k_q1 >= b_close { break; }
        let k_q2 = str_find(json_src, "\"", k_q1 + 1);
        if k_q2 < 0 || k_q2 >= b_close { break; }
        let d_name = json_src.slice(k_q1 + 1, k_q2);

        let col = str_find(json_src, ":", k_q2 + 1);
        if col < 0 || col >= b_close { break; }
        let v_q1 = str_find(json_src, "\"", col + 1);
        if v_q1 < 0 || v_q1 >= b_close { break; }
        let v_q2 = str_find(json_src, "\"", v_q1 + 1);
        if v_q2 < 0 || v_q2 >= b_close { break; }
        let d_ver = json_src.slice(v_q1 + 1, v_q2);

        cur_idx = cur_idx + 1;
        let is_last = cur_idx == dep_count;
        let prefix = if is_last { "└── " } else { "├── " };
        out = out + prefix + d_name + " (" + d_ver + ")\n";

        p = v_q2 + 1;
    }

    return out;
}

pub pure fn format_tree_branch(prefix: str, is_last: bool, label: str) -> str {
    let connector = if is_last { "└── " } else { "├── " };
    return prefix + connector + label;
}

pub pure fn format_tree_next_prefix(prefix: str, is_last: bool) -> str {
    let indent = if is_last { "    " } else { "│   " };
    return prefix + indent;
}
