// ==============================================================================
// FILE: selfhost/cli/spec.pilot
// Milestone 3.1: Declarative CLI Command Registry & Specification Protocol
// Replaces static numeric dispatch and hardcoded CLI strings (CLI001 - CLI006)
// ==============================================================================
pub lvl(0) pkg selfhost.cli;

use Pilot.Core.Primitives.Map::*;

// ------------------------------------------------------------------------------
// 2-Bit Lattice Specifications (0b00 : IValue)
// ------------------------------------------------------------------------------

pub enum FlagValueKind : u8 {
    Bool = 0,
    Int = 1,
    Float = 2,
    Str = 3,
    Path = 4,
    EnumChoice = 5,
    StringList = 6,
}

[Layout(c_abi)]
pub struct FlagSpec : IValue {
    pub long_name:    str;
    pub short_char:   str;
    pub kind_tag:     u8;
    pub default_val:  str;
    pub env_fallback: str;
    pub choices_csv:  str;
    pub repeatable:   bool;
    pub required:     bool;
    pub summary:      str;
}

[Layout(c_abi)]
pub struct PositionalSpec : IValue {
    pub name:     str;
    pub kind_tag: u8;
    pub required: bool;
    pub variadic: bool;
    pub summary:  str;
}

/// A command: its words, its help text, and the flags and positionals it
/// takes. It owns its lists, so it is an owned record (0b10).
pub struct CommandSpec : IObject {
    pub name:        str;
    pub aliases_csv: str;
    pub category:    str;
    pub summary:     str;
    pub examples:    str;
    pub flags:       List<FlagSpec>;
    pub positionals: List<PositionalSpec>;
}

// ------------------------------------------------------------------------------
// Parsed Arguments Container (0b10 : IObject)
// ------------------------------------------------------------------------------

pub struct ParsedArgs : IObject {
    pub command:          str;
    /// Each flag given, by its long name, with every value given for it.
    pub flag_values:      Map<str, List<str>>;
    pub positionals:      List<str>;
    /// The arguments after `--`, passed to the program as they are.
    pub passthrough_args: List<str>;
}

pub fn parsed_args_new() -> ParsedArgs => ParsedArgs {
    command:          "",
    flag_values:      Map<str, List<str>>(),
    positionals:      [],
    passthrough_args: [],
};

/// Whether flag `flag` was given.
pub pure fn parsed_has_flag(ref args: ParsedArgs, flag: str) -> bool => args.flag_values.has(flag);

/// The first value given for `flag`, or `fallback` when it was not given.
pub pure fn parsed_get_str(ref args: ParsedArgs, flag: str, fallback: str) -> str {
    if args.flag_values.has(flag) && args.flag_values[flag].len() > 0 { return args.flag_values[flag][0]; }
    return fallback;
}

/// Adds `value` to the values given for flag `flag`.
pub fn parsed_add_flag(var ref args: ParsedArgs, flag: str, value: str) {
    var values: List<str> = args.flag_values.get(flag) ?? [];
    values.push(value);
    args.flag_values.set(flag, values);
}

/// The outcome of parsing a command line: the parsed arguments, or the
/// usage error (`code`, `message`) and the exit code to stop with.
pub struct CliParse : IObject {
    pub ok:        bool;
    pub exit_code: i64;
    pub code:      str;
    pub message:   str;
    pub parsed:    ParsedArgs;
}

pub fn cli_parse_ok(parsed: ParsedArgs) -> CliParse =>
    CliParse { ok: true, exit_code: 0, code: "", message: "", parsed: parsed };

pub fn cli_parse_error(code: str, message: str) -> CliParse =>
    CliParse { ok: false, exit_code: 2, code: code, message: message, parsed: parsed_args_new() };

// ------------------------------------------------------------------------------
// Command Registry (0b10 : IObject)
// ------------------------------------------------------------------------------

pub struct CommandRegistry : IObject {
    pub commands:         List<CommandSpec>;
    pub name_to_index:    Map<str, i64>;
    pub alias_to_primary: Map<str, str>;
}

pub pure fn spec_registry_count(ref reg: CommandRegistry) -> i64 => reg.commands.len();

/// The index of the command named or aliased `name`, or -1.
pub pure fn spec_registry_find_by_name(ref reg: CommandRegistry, name: str) -> i64 {
    if some idx = reg.name_to_index.get(name) { return idx; }
    if some primary = reg.alias_to_primary.get(name) {
        if some idx = reg.name_to_index.get(primary) { return idx; }
    }
    return -1;
}

// ------------------------------------------------------------------------------
// Spec Factory Constructors
// ------------------------------------------------------------------------------

pub fn spec_new_flag(long_name: str, short_char: str, kind_tag: u8, default_val: str, env_fallback: str, choices_csv: str, repeatable: bool, required: bool, summary: str) -> FlagSpec {
    return FlagSpec {
        long_name: long_name,
        short_char: short_char,
        kind_tag: kind_tag,
        default_val: default_val,
        env_fallback: env_fallback,
        choices_csv: choices_csv,
        repeatable: repeatable,
        required: required,
        summary: summary,
    };
}

pub fn spec_new_positional(name: str, kind_tag: u8, required: bool, variadic: bool, summary: str) -> PositionalSpec {
    return PositionalSpec {
        name: name,
        kind_tag: kind_tag,
        required: required,
        variadic: variadic,
        summary: summary,
    };
}

pub fn spec_new_command(name: str, aliases_csv: str, category: str, summary: str, examples: str) -> CommandSpec {
    return CommandSpec {
        name: name,
        aliases_csv: aliases_csv,
        category: category,
        summary: summary,
        examples: examples,
        flags: [],
        positionals: [],
    };
}

pub fn spec_command_add_flag(var ref cmd: CommandSpec, flag: FlagSpec) {
    cmd.flags.push(flag);
}

pub fn spec_command_add_positional(var ref cmd: CommandSpec, pos: PositionalSpec) {
    cmd.positionals.push(pos);
}

pub fn spec_registry_new() -> CommandRegistry {
    return CommandRegistry {
        commands: [],
        name_to_index: Map<str, i64>(),
        alias_to_primary: Map<str, str>(),
    };
}

pub fn spec_registry_register(var ref reg: CommandRegistry, spec: CommandSpec) -> i64 {
    let idx = reg.commands.len();
    reg.name_to_index.set(spec.name, idx);

    // Register aliases if any
    let al = spec.aliases_csv;
    if al.len() > 0 {
        var start: i64 = 0;
        let l = al.len();
        while start < l {
            var end = start;
            while end < l && al.byte_at(end) != 44 { // ','
                end = end + 1;
            }
            let alias = al.slice(start, end);
            if alias.len() > 0 {
                reg.alias_to_primary.set(alias, spec.name);
            }
            start = end + 1;
        }
    }

    reg.commands.push(spec);
    return idx;
}
