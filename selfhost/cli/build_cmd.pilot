// =========================================================================
// FILE: selfhost/cli/build_cmd.pilot
// Milestone 60.3: Self-Hosted Build, Check & Compile Command Driver
// Coordinates selfhost/codegen/* and selfhost/vm/compiler.pilot.
// =========================================================================
pub pkg Pilot.SelfHost.Cli.BuildCmd;

pub pure fn nameof(sym: str) -> str => sym;

pub enum BuildTarget {
    Native,
    C,
    Llvm,
    Wasm,
    Gpu,
    Asm,
}

pub pure fn resolve_build_target(target_flag: str) -> BuildTarget {
    if target_flag == "c" { return ::C; }
    if target_flag == "llvm" { return ::Llvm; }
    if target_flag == "wasm" { return ::Wasm; }
    if target_flag == "gpu" { return ::Gpu; }
    if target_flag == "asm" { return ::Asm; }
    return ::Native;
}

pub pure fn build_target_to_name(target: BuildTarget) -> str {
    if target == ::C { return "c"; }
    if target == ::Llvm { return "llvm"; }
    if target == ::Wasm { return "wasm"; }
    if target == ::Gpu { return "gpu"; }
    if target == ::Asm { return "asm"; }
    return "native";
}

pub pure fn format_build_summary(module_name: str, target_flag: str, out_path: str) -> str {
    return "Built " + module_name + " [" + target_flag + "] -> " + out_path;
}

// Parses e.g. "build app/guidance.pilot --target wasm --release -o out/guidance.wasm"
// into "<cmd>|<input>|<target>|<release_0_or_1>|<out>"
pub fn parse_cli_build_args(argv_line: str) -> str {
    let len = argv_line.len();
    var cmd = "";
    var input = "";
    var target = "native";
    var release = "0";
    var out_path = "";

    var pos = 0;
    var token_idx = 0;
    while pos < len {
        // Skip whitespace
        while pos < len {
            let ch = argv_line.slice(pos, pos + 1);
            if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                pos = pos + 1;
            } else {
                break;
            }
        }
        if pos >= len { break; }

        let start = pos;
        while pos < len {
            let ch = argv_line.slice(pos, pos + 1);
            if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                break;
            }
            pos = pos + 1;
        }
        let tok = argv_line.slice(start, pos);

        if token_idx == 0 {
            cmd = tok;
            token_idx = 1;
        } else if tok == "--target" {
            // Next token is target
            while pos < len {
                let ch = argv_line.slice(pos, pos + 1);
                if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                    pos = pos + 1;
                } else {
                    break;
                }
            }
            let t_start = pos;
            while pos < len {
                let ch = argv_line.slice(pos, pos + 1);
                if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                    break;
                }
                pos = pos + 1;
            }
            let raw_target = argv_line.slice(t_start, pos);
            let b_target = resolve_build_target(raw_target);
            let b_name = build_target_to_name(b_target);
            target = if b_name != "native" { b_name } else { raw_target };
        } else if tok == "--release" {
            release = "1";
        } else if tok == "-o" || tok == "--output" {
            // Next token is output path
            while pos < len {
                let ch = argv_line.slice(pos, pos + 1);
                if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                    pos = pos + 1;
                } else {
                    break;
                }
            }
            let o_start = pos;
            while pos < len {
                let ch = argv_line.slice(pos, pos + 1);
                if ch == " " || ch == "\t" || ch == "\n" || ch == "\r" {
                    break;
                }
                pos = pos + 1;
            }
            out_path = argv_line.slice(o_start, pos);
        } else {
            if input == "" && tok.slice(0, 1) != "-" {
                input = tok;
            }
        }
    }

    return cmd + "|" + input + "|" + target + "|" + release + "|" + out_path;
}
