// ==============================================================================
// FILE: selfhost/cli/report.pilot
// Printing the diagnostics of `pilot run` and `pilot check`.
// ==============================================================================
// Every diagnostic the seed reports for a program is rendered by the shared
// renderer (`selfhost/diagnostics/renderer.pilot`) and written to stderr.
pub lvl(0) pkg Pilot.SelfHost.Cli.Report;

use Pilot.Core.File;
use Pilot.Diagnostics.Model;
use Pilot.Diagnostics.Renderer;
use Pilot.SelfHost.Cli.Host;

/// The diagnostic `d` in the renderer's model. A span that covers nothing
/// (the loader points at where a declaration starts) is shown as one column.
pub fn report_diagnostic(d: HostDiag) -> Diagnostic {
    let end = if d.end > d.start { d.end } else { d.start + 1 };
    return diagnostic_new(d.code, d.severity, d.message, source_span_new(0, d.start, end));
}

/// Renders `diags` to stderr and returns how many are errors.
pub fn report_diagnostics(diags: List<HostDiag>) -> i64 {
    var errors = 0;
    for d in diags {
        let src = if File.exists(d.file) { File.read_text(d.file) } else { "" };
        eprint(render_diagnostic_human(report_diagnostic(d), src, d.file, false));
        if d.severity == diag_severity_error() { errors = errors + 1; }
    }
    return errors;
}

/// The diagnostics of `diags` at least as severe as `severity` (errors are
/// the most severe). `pilot run` shows errors and warnings, not the
/// analyzer's info and hint notes.
pub fn report_at_least(diags: List<HostDiag>, severity: u8) -> List<HostDiag> {
    var out: List<HostDiag> = [];
    for d in diags {
        if d.severity <= severity { out.push(d); }
    }
    return out;
}

/// The code the seed compiler gives a construct it cannot run yet
/// (`crates/pilot-vm/src/codes.rs`, catalog category `Seed`): a limit of the
/// seed, not an error in the program.
pub pure fn seed_limit_code() -> str => "SEED001";

/// The diagnostics of `diags` that are not seed limits. A tool that never
/// runs the program on the seed (`pilot ir`) is not stopped by them.
pub fn without_seed_limits(diags: List<HostDiag>) -> List<HostDiag> {
    var out: List<HostDiag> = [];
    for d in diags {
        if d.code != seed_limit_code() { out.push(d); }
    }
    return out;
}
