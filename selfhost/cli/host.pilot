// ==============================================================================
// FILE: selfhost/cli/host.pilot
// The CLI's host operations (`crates/pilot-cli/src/host.rs`), typed.
// ==============================================================================
// The CLI is Pilot; compiling and running a program is still done by the seed.
// These wrappers are the only place the CLI reaches it.
pub lvl(0) pkg Pilot.SelfHost.Cli.Host;

use Pilot.Diagnostics.Model;

/// A diagnostic the seed reported for a program: catalog code, message, and
/// the byte span in `file` it points at.
pub struct HostDiag : IValue {
    pub code:    str;
    pub message: str;
    pub file:    str;
    pub start:   u32;
    pub end:     u32;
    /// `diag_severity_*` in `selfhost/diagnostics/model.pilot`.
    pub severity: u8;
}

/// What running a program gave: its exit code, or the diagnostics that kept
/// it from running.
pub struct RunOutcome : IValue {
    pub exit_code: i64;
    pub diags:     List<HostDiag>;
}

/// A top-level function a file declares, with the names of its attributes.
pub struct DeclaredFn : IValue {
    pub name:  str;
    pub attrs: List<str>;
}

fn host_diags(raw: List<any>) -> List<HostDiag> {
    var out: List<HostDiag> = [];
    for d in raw {
        out.push(HostDiag { code: d[0], message: d[1], file: d[2], start: d[3], end: d[4], severity: d[5] });
    }
    return out;
}

/// Links, parses and compiles `path` without running it.
pub fn host_check(path: str) -> List<HostDiag> => host_diags(__engine("cli_check", path));

/// The self-hosted analyzer's diagnostics for the file `path`.
pub fn host_analyze(path: str) -> List<HostDiag> => host_diags(__engine("cli_analyze", path));

/// The type checker's diagnostics for the program at `path`, in the
/// program's own files. `checker` lists the checker's sources in link order.
pub fn host_typecheck(path: str, checker: List<str>, decls: List<str>) -> List<HostDiag> =>
    host_diags(__engine("cli_typecheck", path, checker, decls));

/// Runs the tool made of `files`, calling `entry`, over the program at
/// `path` linked with `decls`; the tool reads the program the way the type
/// checker does. Its result is the tool's exit code.
pub fn host_program_tool(path: str, files: List<str>, decls: List<str>, entry: str) -> i64 =>
    __engine("cli_program_tool", path, files, decls, entry);

/// Runs the tool made of `files`, calling `entry`, on the text of the file
/// at `path`. Its result is the tool's exit code.
pub fn host_text_tool(path: str, files: List<str>, entry: str) -> i64 =>
    __engine("cli_text_tool", path, files, entry);

/// The declarations every program is checked against, linked after the
/// program: files, or directories whose `.pilot` files are taken in name
/// order. `core.pilot` holds the `Cfg` tables (lattice masks, register
/// classes), `operator.pilot` the root and operator interfaces.
pub fn cli_checker_decls() -> List<str> => [
    "stdlib/core/core.pilot",
    "stdlib/core/operator.pilot",
    "stdlib/core/primitives",
];

/// The type checker's sources (`selfhost/check/`), in link order.
pub fn cli_checker_files() -> List<str> => [
    "stdlib/core/syntax/visibility.pilot",
    "selfhost/check/snapshot.pilot",
    "selfhost/check/types.pilot",
    "selfhost/check/diag.pilot",
    "selfhost/check/program.pilot",
    "selfhost/types/method_table.pilot",
    "selfhost/types/bundle_splice.pilot",
    "selfhost/check/methods.pilot",
    "selfhost/check/resolve.pilot",
    "selfhost/check/generators.pilot",
    "selfhost/check/infer.pilot",
    "selfhost/check/rules.pilot",
    "selfhost/check/generics.pilot",
    "selfhost/check/own.pilot",
    "selfhost/check/drops.pilot",
    "selfhost/check/contracts.pilot",
    "selfhost/check/access.pilot",
    "selfhost/check/main.pilot",
];

/// Compiles and runs `path` with the script arguments `args`. A non-empty
/// `tail` is linked after the program as its entry and runs instead of `main`.
/// Owned values are dropped where the type checker's drop plan
/// (`selfhost/check/drops.pilot`) says.
pub fn host_run(path: str, args: List<str>, tail: str) -> RunOutcome {
    let raw = __engine("cli_run", path, args, tail, cli_checker_files(), cli_checker_decls());
    return RunOutcome { exit_code: raw[0], diags: host_diags(raw[1]) };
}

/// The top-level functions of `path`, or `none` when it cannot be read.
pub fn host_functions(path: str) -> List<DeclaredFn>? {
    let raw = __engine("cli_functions", path);
    if raw == none { return none; }
    var out: List<DeclaredFn> = [];
    for f in raw {
        out.push(DeclaredFn { name: f[0], attrs: f[1] });
    }
    return out;
}

/// Runs the self-hosted tool made of `files`, calling `entry`; its result as text.
pub fn host_tool(files: List<str>, entry: str) -> str => __engine("cli_tool", files, entry);

/// Like `host_tool`, with the tool's AST queries answering about `input`.
pub fn host_tool_on(files: List<str>, entry: str, input: str) -> str => __engine("cli_tool_on", files, entry, input);
