// ==============================================================================
// FILE: selfhost/cli/test_ir.pilot
// `pilot test --ir`: the conformance corpus on the PilIR interpreter (F5).
// ==============================================================================
// Every conformance case is eligible except one whose expected stderr is a
// seed limit (SEED001): that expectation describes what the seed cannot run,
// which the PilIR interpreter is not bound by. Each case is run as
// `pilot ir run-roundtrip <case> -- <args>` (its `.stdin` as input), one
// process that does what `pilot ir roundtrip` and then `pilot ir run` do.
// The module must round-trip: printed, parsed and printed again, it is the
// same text (a program the compiler rejects has no module). The run is then
// checked against the case's expectation files exactly as `pilot test`
// checks `pilot run`: its output, its diagnostics and runtime errors, and
// its exit code.
//
// A case with a `<stem>.ir.inlined` file (one function name per line) is
// also run as `pilot ir opt <case>`: each named function must be in the
// optimised module, and no `call_direct` in it may still call it, so every
// call to it was inlined (selfhost/ir/pass_inline.pilot).
//
// A case whose lowering or run stops at a registered `ir.*` seam is counted
// as stopped at a seam: neither passed nor failed. Every other difference is
// a failure. The other cases are counted as not eligible.
pub lvl(0) pkg selfhost.cli;

use Pilot.Core.File;
use std.proc;
use std.text;

/// The seam prefix of the PilIR lowering and interpreter.
pub pure fn ir_seam_prefix() -> str => "`ir.";
/// The line `pilot ir run-roundtrip` writes when a module does not
/// round-trip (`roundtrip_failed()` in selfhost/ir/main.pilot; the CLI does
/// not link the lowerer).
pub pure fn roundtrip_failed_line() -> str => "error: the PilIR text does not round-trip; the program was not run";
/// The diagnostic code of an unconnected seam.
pub pure fn seam_code() -> str => "SEAM001";

/// The totals of a `pilot test --ir` run.
pub struct IrTally : IObject {
    pub passed:       i64;
    pub failed:       i64;
    pub at_seam:      i64;
    pub not_eligible: i64;
}

fn read_optional(path: str) -> str? {
    if File.exists(path) { return File.read_text(path); }
    return none;
}

/// Whether conformance case `program` is one `pilot ir run` must answer.
pub fn ir_eligible(program: str) -> bool {
    let stem = test_stem(program);
    let expected_stderr = read_optional(stem + ".stderr") ?? "";
    return expected_stderr.find(seed_limit_code(), 0) < 0;
}

fn job(program: str, mode: str) -> proc.ProcessJob {
    let input = read_optional(test_stem(program) + ".stdin") ?? "";
    let exe = proc.current_exe() ?? "pilot";
    var argv: List<str> = ["ir", mode, program, "--"];
    let arg_text = read_optional(test_stem(program) + ".args");
    if arg_text != none {
        for a in test_lines(arg_text) { argv.push(a); }
    }
    return proc.job(exe, argv, input);
}

/// Runs `mode` on each of `programs` (`proc.run_all`).
fn run_all(ref programs: List<str>, mode: str) -> List<proc.ProcessOutput> {
    var jobs: List<proc.ProcessJob> = [];
    for program in programs { jobs.push(job(program, mode)); }
    return proc.run_all(jobs);
}

/// The extension of the list of functions whose calls must be inlined.
pub pure fn ir_inlined_ext() -> str => ".ir.inlined";

/// The text after `prefix` in `line` up to the next space or `"`.
fn word_after(line: str, prefix: str) -> str {
    let at = line.find(prefix, 0);
    if at < 0 { return ""; }
    var end = at + prefix.len();
    while end < line.len() && line.byte_at(end) != 32 && line.byte_at(end) != 34 { end = end + 1; }
    return line.slice(at + prefix.len(), end);
}

/// The problems with `optimized`, the `pilot ir opt` output of a case, given the
/// functions `wanted` whose calls must all be inlined.
pub fn inlined_problems(optimized: proc.ProcessOutput, ref wanted: List<str>) -> List<str> {
    var problems: List<str> = [];
    if optimized.exit_code != 0 { return [f"`pilot ir opt` failed\n--- stderr ---\n{optimized.stderr}"]; }
    // Each `fn <index> "<name>" ...` line's index and name.
    var indices: List<str> = [];
    var all_names: List<str> = [];
    var called: List<str> = [];
    for line in test_lines(optimized.stdout) {
        if line.starts_with("fn ") {
            let q = line.find("\"", 0);
            let q2 = line.find("\"", q + 1);
            if q > 0 && q2 > q {
                indices.push(line.slice(3, q - 1));
                all_names.push(line.slice(q + 1, q2));
            }
        } else {
            let callee = word_after(line, "call_direct.");
            if callee != "" { called.push(callee); }
        }
    }
    for name in wanted {
        var found = false;
        for n in all_names { if n == name { found = true; } }
        if !found { problems.push(f"`{name}` is not in the optimised module"); continue; }
        var hit = false;
        for c in called {
            var j = 0;
            while j < indices.len() {
                if indices[j] == c && all_names[j] == name { hit = true; }
                j = j + 1;
            }
        }
        if hit { problems.push(f"a call to `{name}` is not inlined"); }
    }
    return problems;
}

fn stopped_at_seam(out: proc.ProcessOutput) -> bool =>
    out.stderr.find(seam_code(), 0) >= 0 && out.stderr.find(ir_seam_prefix(), 0) >= 0;

/// The seam a run stopped at, as its message line.
fn seam_line(out: proc.ProcessOutput) -> str {
    for line in test_lines(out.stderr) {
        if line.find(seam_code(), 0) >= 0 { return line; }
    }
    return "";
}

fn fail(program: str, ref problems: List<str>, var ref tally: IrTally) {
    tally.failed = tally.failed + 1;
    print(f"FAIL {program}");
    for p in problems { print("  " + p); }
}

/// `pilot test --ir [paths...] [--filter text]`: exit 0 when no eligible case
/// fails, 1 otherwise.
pub fn test_ir_command(ref paths: List<str>, filter: str) -> i64 {
    var tally = IrTally { passed: 0, failed: 0, at_seam: 0, not_eligible: 0 };
    let roots = if paths.len == 0 { [test_default_dir()] } else { paths };
    var cases: List<str> = [];
    for root in roots {
        let programs = if root.ends_with(".pilot") { [root] } else { test_programs_in(root) };
        for program in programs {
            if program.find(filter, 0) < 0 || !File.exists(test_stem(program) + ".stdout") { continue; }
            if ir_eligible(program) { cases.push(program); } else { tally.not_eligible = tally.not_eligible + 1; }
        }
    }
    let runs = run_all(cases, "run-roundtrip");
    // The cases that name functions whose calls must be inlined.
    var opt_cases: List<str> = [];
    for c in cases {
        if File.exists(test_stem(c) + ir_inlined_ext()) { opt_cases.push(c); }
    }
    let opts = run_all(opt_cases, "opt");
    var i = 0;
    while i < cases.len() {
        let out = runs[i];
        if stopped_at_seam(out) {
            tally.at_seam = tally.at_seam + 1;
            print(f"SEAM {cases[i]}: {seam_line(out)}");
        } else if out.stderr.find(roundtrip_failed_line(), 0) >= 0 {
            fail(cases[i], [f"the PilIR text does not round-trip\n--- stderr ---\n{out.stderr}"], tally);
        } else {
            let r = test_check_case(cases[i], out);
            var k = 0;
            while k < opt_cases.len() {
                if opt_cases[k] == cases[i] {
                    let wanted = test_lines(File.read_text(test_stem(cases[i]) + ir_inlined_ext()));
                    var named: List<str> = [];
                    for w in wanted { if w.trim().len() > 0 { named.push(w.trim()); } }
                    for p in inlined_problems(opts[k], named) { r.problems.push(p); }
                }
                k = k + 1;
            }
            if r.problems.len == 0 {
                tally.passed = tally.passed + 1;
            } else {
                fail(cases[i], r.problems, tally);
            }
        }
        i = i + 1;
    }
    print(f"RESULT (ir): {tally.passed} passed, {tally.failed} failed, {tally.at_seam} stopped at a seam, {tally.not_eligible} not eligible");
    return if tally.failed == 0 { 0 } else { 1 };
}
