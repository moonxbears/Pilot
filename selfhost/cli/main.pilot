// ==============================================================================
// FILE: selfhost/cli/main.pilot
// Milestone 3.4: Declarative CommandRegistry Router & Single-Source CLI Entry
// Replaces hardcoded numeric dispatch in Pure Pilot (CLI001 - CLI006)
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Cli.Main;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// Default Built-in Command Registry Construction
// ------------------------------------------------------------------------------

pub fn default_command_registry() -> CommandRegistry {
    let reg = spec_registry_new();

    // 1. Run & Build
    let cmd_run = spec_new_command(
        "run", "", "Run & Build",
        "Execute Pilot program via PilVM v3 / Native AOT",
        "pilot run app.pilot [args...]"
    );
    let _ = spec_registry_register(reg, cmd_run);

    let cmd_build = spec_new_command(
        "build", "", "Run & Build",
        "Compile Pilot program to Native/LLVM/C/WASM/GPU",
        "pilot build app.pilot --target wasm --release -o app.wasm"
    );
    spec_command_add_flag(cmd_build, spec_new_flag("target", "t", 5, "native", "", "native,c,llvm,wasm,gpu,asm", false, false, "Compilation target backend"));
    spec_command_add_flag(cmd_build, spec_new_flag("release", "r", 0, "false", "", "", false, false, "Optimize binary for release mode"));
    spec_command_add_flag(cmd_build, spec_new_flag("output", "o", 4, "", "", "", false, false, "Output destination path"));
    let _ = spec_registry_register(reg, cmd_build);

    let cmd_compile = spec_new_command(
        "compile", "", "Run & Build",
        "Compile source into .pilc v3 bytecode binary",
        "pilot compile app.pilot -o app.pilc"
    );
    spec_command_add_flag(cmd_compile, spec_new_flag("output", "o", 4, "", "", "", false, false, "Output destination path"));
    let _ = spec_registry_register(reg, cmd_compile);

    // 2. Analysis & Quality
    let cmd_check = spec_new_command(
        "check", "", "Analysis & Quality",
        "Verify syntax, type safety, and comptime contracts",
        "pilot check src/main.pilot"
    );
    spec_command_add_flag(cmd_check, spec_new_flag("fix", "", 0, "false", "", "", false, false, "Automatically apply lossless CST fixes"));
    let _ = spec_registry_register(reg, cmd_check);

    let cmd_fmt = spec_new_command(
        "fmt", "", "Analysis & Quality",
        "Format source code according to Pilot style",
        "pilot fmt src/ --write"
    );
    spec_command_add_flag(cmd_fmt, spec_new_flag("write", "w", 0, "false", "", "", false, false, "Write formatting changes directly to disk"));
    spec_command_add_flag(cmd_fmt, spec_new_flag("check", "", 0, "false", "", "", false, false, "Check if files are formatted without editing"));
    spec_command_add_flag(cmd_fmt, spec_new_flag("style", "", 5, "preserve", "", "preserve,readable,compact", false, false, "Formatting syntax style"));
    let _ = spec_registry_register(reg, cmd_fmt);

    let cmd_test = spec_new_command(
        "test", "", "Analysis & Quality",
        "Run integrated test suite or differential tests",
        "pilot test [filter]"
    );
    spec_command_add_flag(cmd_test, spec_new_flag("filter", "", 3, "", "", "", false, false, "Filter test cases by name substring"));
    spec_command_add_flag(cmd_test, spec_new_flag("ir", "", 0, "false", "", "", false, false, "Run the conformance cases on the PilIR interpreter (`pilot ir run`) and check their text round trip"));
    spec_command_add_flag(cmd_test, spec_new_flag("emit", "", 3, "", "", "", false, false, "Run the conformance cases through `pilot emit <lang>` and the host's toolchain for that language"));
    let _ = spec_registry_register(reg, cmd_test);

    let cmd_bench = spec_new_command(
        "bench", "", "Analysis & Quality",
        "Show the milestone tests' average, fastest, slowest and latest times",
        "pilot bench --filter test_59"
    );
    spec_command_add_flag(cmd_bench, spec_new_flag("filter", "", 3, "", "", "", false, false, "Show only tests whose name contains this text"));
    let _ = spec_registry_register(reg, cmd_bench);

    let cmd_gate = spec_new_command(
        "gate", "", "Analysis & Quality",
        "Run pure-Pilot architectural & bootstrap gates",
        "pilot gate --full --json"
    );
    spec_command_add_flag(cmd_gate, spec_new_flag("full", "", 0, "false", "", "", false, false, "Run full suite including rename litmus"));
    spec_command_add_flag(cmd_gate, spec_new_flag("json", "", 0, "false", "", "", false, false, "Emit structured machine-readable JSON report"));
    spec_command_add_flag(cmd_gate, spec_new_flag("litmus", "", 0, "false", "", "", false, false, "Include Dual-Pass Universal Rename Litmus gate"));
    spec_command_add_flag(cmd_gate, spec_new_flag("seed", "", 1, "0", "", "", false, false, "Deterministic seed for Pass-1 Rename Litmus"));
    spec_command_add_flag(cmd_gate, spec_new_flag("only", "", 3, "", "", "", false, false, "Run only the specified gate id"));
    spec_command_add_flag(cmd_gate, spec_new_flag("ratchet-update", "", 0, "false", "", "", false, false, "Update Rust LOC ratchet ceilings in manifest"));
    let _ = spec_registry_register(reg, cmd_gate);

    // 3. Packages & Deps
    let cmd_pkg = spec_new_command(
        "pkg", "package", "Packages & Deps",
        "Manage packages, dependencies, and lockfiles",
        "pilot pkg init my_app\npilot pkg add std.col"
    );
    let _ = spec_registry_register(reg, cmd_pkg);

    let cmd_deps = spec_new_command(
        "deps", "", "Packages & Deps",
        "Inspect, list, and verify dependencies",
        "pilot deps list\npilot deps check"
    );
    spec_command_add_flag(cmd_deps, spec_new_flag("depth", "d", 1, "99", "", "", false, false, "Maximum traversal depth"));
    spec_command_add_flag(cmd_deps, spec_new_flag("flat", "l", 0, "false", "", "", false, false, "List dependencies in flat alphabetical format"));
    let _ = spec_registry_register(reg, cmd_deps);

    let cmd_tree = spec_new_command(
        "tree", "", "Packages & Deps",
        "Display visual dependency tree of imports or packages",
        "pilot tree src/main.pilot"
    );
    let _ = spec_registry_register(reg, cmd_tree);

    let cmd_venv = spec_new_command(
        "venv", "", "Packages & Deps",
        "Manage isolated virtual environments",
        "pilot venv init .pilot_env"
    );
    let _ = spec_registry_register(reg, cmd_venv);

    // 4. IDE, Debug & AI
    let cmd_repl = spec_new_command(
        "repl", "", "IDE, Debug & AI",
        "Start interactive Name-Blind Pilot REPL",
        "pilot repl"
    );
    let _ = spec_registry_register(reg, cmd_repl);

    let cmd_debug = spec_new_command(
        "debug", "", "IDE, Debug & AI",
        "Launch VmHook-stepped debugger or DAP server",
        "pilot debug app.pilot --dap"
    );
    spec_command_add_flag(cmd_debug, spec_new_flag("dap", "", 0, "false", "", "", false, false, "Launch resident Debug Adapter Protocol server"));
    let _ = spec_registry_register(reg, cmd_debug);

    let cmd_lsp = spec_new_command(
        "lsp", "", "IDE, Debug & AI",
        "Start resident PilVM Language Server",
        "pilot lsp"
    );
    let _ = spec_registry_register(reg, cmd_lsp);

    let cmd_perf = spec_new_command(
        "perf", "", "IDE, Debug & AI",
        "Profile and optimize code performance",
        "pilot perf profile app.pilot"
    );
    let _ = spec_registry_register(reg, cmd_perf);

    let cmd_emit = spec_new_command(
        "emit", "--emit", "IDE, Debug & AI",
        "Transpile Pilot code to target foreign language",
        "pilot emit python app.pilot -o app.py"
    );
    spec_command_add_flag(cmd_emit, spec_new_flag("output", "o", 4, "", "", "", false, false, "Output file path"));
    let _ = spec_registry_register(reg, cmd_emit);

    let cmd_ir = spec_new_command(
        "ir", "", "IDE, Debug & AI",
        "Lower a program (or read a .pir file) to PilIR: verify it, print it, run it on the IR interpreter, or check its text round trip",
        "pilot ir run app.pilot"
    );
    let _ = spec_registry_register(reg, cmd_ir);

    let cmd_from = spec_new_command(
        "from", "--from", "IDE, Debug & AI",
        "Ingest foreign code into Pilot AST",
        "pilot from python app.py -o app.pilot"
    );
    spec_command_add_flag(cmd_from, spec_new_flag("output", "o", 4, "", "", "", false, false, "Output file path"));
    let _ = spec_registry_register(reg, cmd_from);

    let cmd_map = spec_new_command(
        "map", "outline", "IDE, Debug & AI",
        "Display visual symbol map of namespaces, classes, fns",
        "pilot map src/main.pilot"
    );
    let _ = spec_registry_register(reg, cmd_map);

    let cmd_ide_sync = spec_new_command(
        "ide-sync", "", "IDE, Debug & AI",
        "Synchronize VS Code extension grammar and schemas",
        "pilot ide-sync"
    );
    let _ = spec_registry_register(reg, cmd_ide_sync);

    let cmd_completions = spec_new_command(
        "completions", "", "IDE, Debug & AI",
        "Generate shell completion script (bash, zsh, fish, pwsh)",
        "pilot completions zsh > _pilot"
    );
    let _ = spec_registry_register(reg, cmd_completions);

    return reg;
}

// ------------------------------------------------------------------------------
// Backward-Compatible Facade APIs
// ------------------------------------------------------------------------------

pub pure fn resolve_cli_subcommand(cmd: str) -> i64 {
    let reg = default_command_registry();
    let idx = spec_registry_find_by_name(reg, cmd);
    return if idx >= 0 { idx + 1 } else { 0 };
}

// ------------------------------------------------------------------------------
// Single-Source CLI Entry Point
// ------------------------------------------------------------------------------

/// Parses the `\x1f`-separated command line, dispatches the command to its
/// handler (`cli_handlers()` in `commands.pilot`) and returns the process exit
/// code.
pub fn run_cli_entry(raw_args_line: str) -> i64 {
    let reg = default_command_registry();
    let p_res = cli_parse_args(reg, raw_args_line);

    if !(cli_map_get(p_res, "ok") as bool) {
        eprint(cli_map_get(p_res, "message"));
        return cli_map_get_int(p_res, "exit_code");
    }
    let p: ParsedArgs = cli_map_get(p_res, "parsed");

    if parsed_has_flag(p, "help") {
        let c_idx = spec_registry_find_by_name(reg, p.command);
        if c_idx >= 0 {
            print(render_command_help(spec_registry_get(reg, c_idx as usize)));
            return 0;
        }
    }

    let handlers = cli_handlers();
    if !cli_map_contains(handlers, p.command) {
        return seam("cli.command_handler", f"`pilot {p.command}` is not implemented yet: no handler is registered for it");
    }
    let handler = cli_map_get(handlers, p.command);
    return handler(p, reg);
}
