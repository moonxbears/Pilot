// ==============================================================================
// FILE: selfhost/cli/test_cmd.pilot
// `pilot test`: the conformance corpus and `[Test]` functions.
// ==============================================================================
// A path is a directory of programs or one program. Each program `<name>.pilot`
// is one of:
//
// * a conformance case, when `<name>.stdout` exists. It is run as
//   `pilot run <name>.pilot -- <args>` in its own process and must
//   - write exactly `<name>.stdout` to stdout,
//   - exit with the code in `<name>.exit` (0 when there is none),
//   - write every non-empty line of `<name>.stderr`, when there is one,
//     somewhere in its stderr.
//   `<name>.args` holds the script arguments, one per line, and `<name>.stdin`
//   is written to its standard input.
// * a unit-test file, when it declares `[Test]` functions. Each runs on its own
//   and passes when it returns without a runtime error.
//
// A directory's `known_bugs/` holds programs that reproduce registered seed
// bugs (`bug_registry()` in `selfhost/gate/ledger/seams.pilot`). Their
// expectation files hold the correct output, so each must still fail; one
// that passes means its bug is fixed and its entry must be retired.
//
// The programs of a directory are its top-level `.pilot` files and those of
// its case folders (subfolders that hold `.stdout` files, one per area of the
// language); packages the cases import live in subfolders without any.
//
// Choosing and running (`TestSelect`, the same for every engine):
// * `<name>.tags` holds a case's tags, separated by commas, spaces or
//   newlines (`slow`). `--tag a,b` runs only the cases with one of them,
//   `--skip-tag a,b` none of those; `SKIPPED n of m cases by tag` counts the
//   cases left out.
// * `--shard K/N` runs the K-th of N disjoint parts: the cases tagged `slow`
//   are dealt out first, then the rest, each in path order, the i-th to
//   shard (i mod N) + 1, so the slow ones spread over the shards. Known-bug
//   programs run on shard 1.
// * `--list` prints the chosen cases, one path per line, and runs nothing,
//   so a CI job can hand each shard its list.
// * `--fail-fast` starts no more cases after the first failure;
//   `STOPPED at the first failure: n not run` counts what it skipped.
// * `--jobs N` runs at most N cases at once (one per CPU by default).
// * `--timeout S` fails a case still running S seconds after it started
//   (`timed out after S s`) and goes on without it; 300 by default, 0 for
//   none. A `slow` case gets 4 times as long, and a `timeout=N` tag sets a
//   case's own limit. The child is left running: the seed cannot stop it
//   yet (seam `bridge.proc_signal`).
pub lvl(0) pkg selfhost.cli;

use Pilot.Core.File;
use std.proc;
use std.text;

/// The directory `pilot test` runs when it is given no path.
pub pure fn test_default_dir() -> str => "tests/conformance";
/// The subdirectory of known-bug reproductions.
pub pure fn test_known_bugs_dir() -> str => "known_bugs";
/// The attribute that marks a unit test.
pub pure fn test_attr() -> str => "Test";
/// The extension of a case's tag file.
pub const TAGS_EXT: str = ".tags";
/// The tag of the cases dealt out first by `--shard`, and given
/// `SLOW_FACTOR` times the time limit.
pub const SLOW_TAG: str = "slow";
pub const SLOW_FACTOR: i64 = 4;
/// The prefix of a tag that sets a case's own time limit (`timeout=900`).
pub const TIMEOUT_TAG: str = "timeout=";
/// The time limit of a case, in seconds, when `--timeout` is not given.
pub const DEFAULT_TIMEOUT: i64 = 300;

/// Which cases a `pilot test` run takes, and how it runs them.
pub struct TestSelect : IObject {
    /// Only programs whose path holds this text.
    pub filter:    str;
    /// Only cases with one of these tags (none: every case).
    pub tags:      List<str>;
    /// No case with one of these tags.
    pub skip_tags: List<str>;
    /// The part to run, 1 ..= `shards` (0: no sharding).
    pub shard:     i64;
    pub shards:    i64;
    /// Start no more cases after the first failure.
    pub fail_fast: bool;
    /// Print the chosen cases and run nothing.
    pub list:      bool;
    /// At most this many cases at once (0: one per CPU).
    pub jobs:      i64;
    /// A case's time limit in seconds (0: none); see `test_limit`.
    pub timeout:   i64;
}

/// A selection that takes every case and runs it.
pub fn test_select_all(filter: str) -> TestSelect =>
    TestSelect { filter: filter, tags: [], skip_tags: [], shard: 0, shards: 0, fail_fast: false, list: false, jobs: 0, timeout: DEFAULT_TIMEOUT };

/// The words of `text` separated by commas, spaces or newlines.
pub fn test_words(text: str) -> List<str> {
    var out: List<str> = [];
    var word = "";
    for i in 0 .. text.len() {
        let b = text.byte_at(i) as i64;
        if b == 44 || b == 32 || b == 10 || b == 13 || b == 9 {
            if word != "" { out.push(word); }
            word = "";
        } else {
            word = word + text.slice(i, i + 1);
        }
    }
    if word != "" { out.push(word); }
    return out;
}

/// The tags of `program`, from its `.tags` file.
pub fn test_tags(program: str) -> List<str> {
    let path = test_stem(program) + TAGS_EXT;
    return if File.exists(path) { test_words(File.read_text(path)) } else { [] };
}

fn shares_any(ref a: List<str>, ref b: List<str>) -> bool {
    for x in a {
        if test_listed(b, x) { return true; }
    }
    return false;
}

/// The time limit of `program` in seconds (0: none): its `timeout=N` tag,
/// else `sel.timeout`, times `SLOW_FACTOR` when it is tagged `slow`.
pub fn test_limit(ref sel: TestSelect, program: str) -> i64 {
    let tags = test_tags(program);
    for t in tags {
        if t.starts_with(TIMEOUT_TAG) {
            if some n = text.parse_i64(t.slice(TIMEOUT_TAG.len(), t.len())) { return n; }
        }
    }
    return if test_listed(tags, SLOW_TAG) { sel.timeout * SLOW_FACTOR } else { sel.timeout };
}

/// Sets each job of `pool`, the job of `programs[i]`, to its time limit.
pub fn test_set_limits(var ref pool: proc.JobPool, ref sel: TestSelect, ref programs: List<str>) {
    for i in 0 .. programs.len() { pool.set_limit(i, test_limit(sel, programs[i])); }
}

/// The problem of a case stopped at its time limit.
pub fn test_timed_out(ref sel: TestSelect, program: str) -> str => f"timed out after {test_limit(sel, program)} s";

/// What is wrong with `sel`, or "" when nothing is.
pub fn test_select_problem(ref sel: TestSelect) -> str {
    for t in sel.tags {
        if test_listed(sel.skip_tags, t) { return f"`--tag` and `--skip-tag` both name `{t}`, so no case could run"; }
    }
    if sel.shards > 0 && (sel.shard < 1 || sel.shard > sel.shards) {
        return f"`--shard {sel.shard}/{sel.shards}` names no shard: K must be 1 ..= N";
    }
    return "";
}

/// Reads `K/N` into `sel`; false when it is not two numbers.
pub fn test_parse_shard(spec: str, var ref sel: TestSelect) -> bool {
    let slash = spec.find("/", 0);
    if slash < 1 { return false; }
    guard some k = text.parse_i64(spec.slice(0, slash)) else { return false; };
    guard some n = text.parse_i64(spec.slice(slash + 1, spec.len())) else { return false; };
    if n < 1 { return false; }
    sel.shard = k;
    sel.shards = n;
    return true;
}

/// The programs of `programs` the run takes, in order: those whose path
/// holds the filter, then those the tags allow, then (with `sharded`) those
/// of the shard. Unless `quiet`, prints the SKIPPED and SHARD counts.
pub fn test_pick(ref sel: TestSelect, ref programs: List<str>, sharded: bool, quiet: bool) -> List<str> {
    var tagged: List<str> = [];
    var named = 0;
    for p in programs {
        if p.find(sel.filter, 0) < 0 { continue; }
        named = named + 1;
        let tags = test_tags(p);
        if sel.tags.len() > 0 && !shares_any(tags, sel.tags) { continue; }
        if shares_any(tags, sel.skip_tags) { continue; }
        tagged.push(p);
    }
    if !quiet && tagged.len() < named { print(f"SKIPPED {named - tagged.len()} of {named} cases by tag"); }
    if !sharded || sel.shards == 0 { return tagged; }
    // Deal the slow cases first, then the rest.
    var shard_of: List<i64> = [];
    var dealt = 0;
    for p in tagged { shard_of.push(0); }
    for pass in 0 .. 2 {
        for i in 0 .. tagged.len() {
            let slow = test_listed(test_tags(tagged[i]), SLOW_TAG);
            if (pass == 0) == slow {
                shard_of[i] = dealt % sel.shards + 1;
                dealt = dealt + 1;
            }
        }
    }
    var out: List<str> = [];
    for i in 0 .. tagged.len() {
        if shard_of[i] == sel.shard { out.push(tagged[i]); }
    }
    if !quiet { print(f"SHARD {sel.shard}/{sel.shards}: {out.len()} of {tagged.len()} cases"); }
    return out;
}

/// Prints `programs`, one per line (`--list`).
pub fn test_print_list(ref programs: List<str>) {
    for p in programs { print(p); }
}

/// How one program or test function fared.
pub struct TestResult : IValue {
    pub name:     str;
    pub problems: List<str>;
}

/// The totals of a `pilot test` run.
pub struct TestTally : IObject {
    pub passed:         i64;
    pub failed:         i64;
    /// Known-bug programs that still fail, as they must.
    pub bugs_reproduced: i64;
    /// Known-bug programs that now pass: their bug is fixed.
    pub bugs_fixed:      i64;
    /// Programs `--fail-fast` did not run.
    pub not_run:         i64;
}

/// The lines of `text`, without line endings.
pub fn test_lines(text: str) -> List<str> {
    var out: List<str> = [];
    var at = 0;
    while at < text.len() {
        var nl = text.find("\n", at);
        if nl < 0 { nl = text.len(); }
        var line = text.slice(at, nl);
        if line.ends_with("\r") { line = line.slice(0, line.len() - 1); }
        out.push(line);
        at = nl + 1;
    }
    return out;
}

/// `path` without its final `.pilot`.
pub fn test_stem(path: str) -> str => path.slice(0, path.len() - 6);

/// The last component of `path`.
pub fn test_base_name(path: str) -> str {
    var at = path.len();
    while at > 0 && path.slice(at - 1, at) != "/" { at = at - 1; }
    return path.slice(at, path.len());
}

/// `path` below `prefix` (which ends with `/`), or "" when it is not below it.
fn test_below(path: str, prefix: str) -> str {
    let at = path.find(prefix, 0);
    if at < 0 { return ""; }
    return path.slice(at + prefix.len(), path.len());
}

fn test_listed(ref names: List<str>, name: str) -> bool {
    for n in names {
        if n == name { return true; }
    }
    return false;
}

/// The programs of `dir`: its own top-level `.pilot` files, and those of
/// each case folder directly inside it. A case folder is a subfolder that
/// holds an expectation file (`.stdout`) of its own, such as
/// `tests/conformance/errors/`; a folder of packages the cases import
/// (`lib/`) holds none, and `known_bugs/` is run apart.
pub fn test_programs_in(dir: str) -> List<str> {
    var out: List<str> = [];
    let prefix = if dir.ends_with("/") { dir } else { dir + "/" };
    let files = test_lines(File.walk_files(dir));
    var case_dirs: List<str> = [];
    for f in files {
        if !f.ends_with(".stdout") { continue; }
        let rest = test_below(f, prefix);
        let slash = rest.find("/", 0);
        if slash > 0 && rest.find("/", slash + 1) < 0 {
            let sub = rest.slice(0, slash);
            if sub != test_known_bugs_dir() && !test_listed(case_dirs, sub) { case_dirs.push(sub); }
        }
    }
    for f in files {
        if !f.ends_with(".pilot") { continue; }
        let rest = test_below(f, prefix);
        if rest == "" { continue; }
        let slash = rest.find("/", 0);
        if slash < 0 {
            out.push(f);
        } else if rest.find("/", slash + 1) < 0 && test_listed(case_dirs, rest.slice(0, slash)) {
            out.push(f);
        }
    }
    return out;
}

fn read_optional(path: str) -> str? {
    if File.exists(path) { return File.read_text(path); }
    return none;
}

/// The process that runs conformance case `program`:
/// `pilot run <program> -- <args>` with its `.stdin` as input.
pub fn test_case_job(program: str) -> proc.ProcessJob {
    let stem = test_stem(program);
    var argv: List<str> = ["run", program, "--"];
    let arg_text = read_optional(stem + ".args");
    if arg_text != none {
        for a in test_lines(arg_text) { argv.push(a); }
    }
    let input = read_optional(stem + ".stdin") ?? "";
    let exe = proc.current_exe() ?? "pilot";
    return proc.job(exe, argv, input);
}

/// Every way the result `out` of conformance case `program` differs from
/// its expectation files.
pub fn test_check_case(program: str, out: proc.ProcessOutput) -> TestResult {
    let stem = test_stem(program);
    var problems: List<str> = [];
    let expected_stdout = File.read_text(stem + ".stdout");
    let exit_text = (read_optional(stem + ".exit") ?? "0").trim();
    let expected_exit = text.parse_i64(exit_text) ?? -1;
    if expected_exit == -1 && exit_text != "-1" {
        problems.push(f"`{stem}.exit` must hold an integer, found `{exit_text}`");
    }
    if out.stdout != expected_stdout {
        problems.push(f"stdout differs\n--- expected ---\n{expected_stdout}--- actual ---\n{out.stdout}--- stderr ---\n{out.stderr}");
    }
    if out.exit_code != expected_exit {
        problems.push(f"exit code {out.exit_code}, expected {expected_exit}\n--- stderr ---\n{out.stderr}");
    }
    let stderr_text = read_optional(stem + ".stderr");
    if stderr_text != none {
        for line in test_lines(stderr_text) {
            let want = line.trim();
            if want.len() > 0 && out.stderr.find(want, 0) < 0 {
                problems.push(f"stderr lacks `{want}`\n--- stderr ---\n{out.stderr}");
            }
        }
    }
    return TestResult { name: program, problems: problems };
}

/// What running some cases left: per case its result, and whether it ran.
pub struct CaseRuns : IObject {
    pub results: List<TestResult>;
    pub ran:     List<bool>;
    /// Whether a failure stopped the run before every case ran.
    pub stopped: bool;
}

/// Runs the conformance cases `programs` (a `proc.JobPool`), judging each
/// as it finishes; with `fail_fast`, starts no more after the first failure.
pub fn test_run_cases(ref programs: List<str>, ref sel: TestSelect, fail_fast: bool) -> CaseRuns {
    var jobs: List<proc.ProcessJob> = [];
    var results: List<TestResult> = [];
    var ran: List<bool> = [];
    for program in programs {
        jobs.push(test_case_job(program));
        results.push(TestResult { name: program, problems: [] });
        ran.push(false);
    }
    var pool = proc.job_pool_at_most(jobs, sel.jobs);
    test_set_limits(pool, sel, programs);
    var stopped = false;
    loop {
        guard some f = pool.next() else { break; };
        let program = programs[f.index];
        let r = if f.timed_out { TestResult { name: program, problems: [test_timed_out(sel, program)] } } else { test_check_case(program, f.out) };
        results[f.index] = r;
        ran[f.index] = true;
        if fail_fast && r.problems.len > 0 {
            stopped = true;
            break;
        }
    }
    pool.finish();
    return CaseRuns { results: results, ran: ran, stopped: stopped };
}

/// The `[Test]` functions of `program`, each run on its own.
pub fn test_run_functions(program: str, filter: str) -> List<TestResult> {
    var out: List<TestResult> = [];
    let fns = host_functions(program) ?? [];
    for f in fns {
        var marked = false;
        for a in f.attrs {
            if a == test_attr() { marked = true; }
        }
        let name = program + "::" + f.name;
        if !marked || name.find(filter, 0) < 0 { continue; }
        var problems: List<str> = [];
        let run = host_run(program, [], f.name + "();");
        if report_diagnostics(run.diags) > 0 {
            problems.push("does not compile");
        } else if run.exit_code != 0 {
            problems.push(f"failed with exit code {run.exit_code}");
        }
        out.push(TestResult { name: name, problems: problems });
    }
    return out;
}

/// Whether `program` declares any `[Test]` function.
pub fn test_has_functions(program: str) -> bool {
    for f in host_functions(program) ?? [] {
        for a in f.attrs {
            if a == test_attr() { return true; }
        }
    }
    return false;
}

fn print_failure(r: TestResult) {
    print(f"FAIL {r.name}");
    for p in r.problems { print("  " + p); }
}

/// Whether `program` is a conformance case (it has a `.stdout` file).
fn is_case(program: str) -> bool => File.exists(test_stem(program) + ".stdout");

fn test_tally_result(r: TestResult, var ref tally: TestTally) {
    if r.problems.len == 0 {
        tally.passed = tally.passed + 1;
    } else {
        tally.failed = tally.failed + 1;
        print_failure(r);
    }
}

/// Runs `programs` (conformance cases and unit-test files, already chosen)
/// into `tally`, in order. The cases run in parallel first; their results
/// are reported in place. Returns whether `--fail-fast` stopped the run.
pub fn test_programs(ref programs: List<str>, ref sel: TestSelect, var ref tally: TestTally) -> bool {
    var cases: List<str> = [];
    for program in programs {
        if is_case(program) { cases.push(program); }
    }
    let runs = test_run_cases(cases, sel, sel.fail_fast);
    var stopped = runs.stopped;
    var next_case = 0;
    for program in programs {
        if is_case(program) {
            if runs.ran[next_case] { test_tally_result(runs.results[next_case], tally); } else { tally.not_run = tally.not_run + 1; }
            next_case = next_case + 1;
        } else if stopped {
            tally.not_run = tally.not_run + 1;
        } else if test_has_functions(program) {
            for r in test_run_functions(program, sel.filter) { test_tally_result(r, tally); }
            if sel.fail_fast && tally.failed > 0 { stopped = true; }
        } else {
            test_tally_result(TestResult { name: program, problems: ["has no `.stdout` expectation file and no `[Test]` functions"] }, tally);
            if sel.fail_fast { stopped = true; }
        }
    }
    return stopped;
}

/// Runs the known-bug programs `programs`; each must still fail.
pub fn test_known_bug_programs(ref programs: List<str>, ref sel: TestSelect, var ref tally: TestTally) {
    for r in test_run_cases(programs, sel, false).results {
        if r.problems.len == 0 {
            tally.bugs_fixed = tally.bugs_fixed + 1;
            print(f"FIXED {r.name}: the bug it reproduces is gone; move it up into the corpus, delete its `bug_registry()` entry and undo every [Workaround] naming it");
        } else {
            tally.bugs_reproduced = tally.bugs_reproduced + 1;
        }
    }
}

/// Prints the STOPPED line when `--fail-fast` left cases unrun.
pub fn test_report_stopped(not_run: i64) {
    if not_run > 0 { print(f"STOPPED at the first failure: {not_run} not run"); }
}

/// `pilot test [paths...] [--filter text] [--tag ..] [--skip-tag ..]
/// [--shard K/N] [--list] [--fail-fast]`: exit 0 when every case passes and
/// every known bug still reproduces, 1 otherwise, 2 for a bad request.
pub fn test_command(ref paths: List<str>, ref sel: TestSelect) -> i64 {
    let problem = test_select_problem(sel);
    if problem != "" {
        eprint(f"error: {problem}");
        return 2;
    }
    var tally = TestTally { passed: 0, failed: 0, bugs_reproduced: 0, bugs_fixed: 0, not_run: 0 };
    let roots = if paths.len == 0 { [test_default_dir()] } else { paths };
    var programs: List<str> = [];
    var bugs: List<str> = [];
    for root in roots {
        if root.ends_with(".pilot") {
            if !File.exists(root) {
                eprint(f"error: no such file `{root}`");
                return 2;
            }
            // A program of a `known_bugs/` directory must still fail.
            if root.find("/" + test_known_bugs_dir() + "/", 0) >= 0 { bugs.push(root); } else { programs.push(root); }
            continue;
        }
        let found = test_programs_in(root);
        if found.len == 0 {
            eprint(f"error: no `.pilot` programs in `{root}`");
            return 2;
        }
        for p in found { programs.push(p); }
        let bug_dir = (if root.ends_with("/") { root } else { root + "/" }) + test_known_bugs_dir();
        for p in test_programs_in(bug_dir) { bugs.push(p); }
    }
    let picked = test_pick(sel, programs, true, sel.list);
    let picked_bugs = if sel.shard > 1 { [] } else { test_pick(sel, bugs, false, true) };
    if sel.list {
        test_print_list(picked);
        test_print_list(picked_bugs);
        return 0;
    }
    let stopped = test_programs(picked, sel, tally);
    if stopped {
        tally.not_run = tally.not_run + picked_bugs.len();
    } else if picked_bugs.len() > 0 {
        test_known_bug_programs(picked_bugs, sel, tally);
    }
    test_report_stopped(tally.not_run);
    print(f"RESULT: {tally.passed} passed, {tally.failed} failed, {tally.bugs_reproduced} known bugs reproduced, {tally.bugs_fixed} known bugs fixed");
    return if tally.failed == 0 && tally.bugs_fixed == 0 { 0 } else { 1 };
}
