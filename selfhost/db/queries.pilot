pub lvl(0) pkg Pilot.SelfHost.Db.Queries;

use Pilot.SelfHost.Db.Revision::*;
use Pilot.SelfHost.Db.Engine::*;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// The 8 Canonical Queries
// ------------------------------------------------------------------------------

pub fn query_source_text(db: i64, file_id: u64) -> str {
    let k = query_key_new(stage_source_text(), 0, file_id);
    return pilotdb_query_with_fn(db, k);
}

