// =========================================================================
// FILE: selfhost/ide/vscode_gen.pilot
// Milestone 59.1: 100% Pilot-Hosted VS Code Artifact Generator
// Generates language-configuration.json, snippets/pilot.json,
// syntaxes/pilot.tmLanguage.json, and package.json via direct JSON serialization.
// =========================================================================
pub pkg Pilot.SelfHost.Ide.VscodeGen;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Meta.*;
use Pilot.Json.*;

pub pure fn nameof(sym: str) -> str => sym;

let Cfg = {
    ast = {
        ast_attr_arg: "ast_attr_arg",
        ast_attr_count: "ast_attr_count",
        ast_node_count: "ast_node_count",
        ast_node_kind: "ast_node_kind",
        ast_node_sym: "ast_node_sym",
        lsp_query_method: "lsp_query_method",
        mount_unit: "mount_unit",
        sym_str: "sym_str",
    }
};

// =========================================================================
// 1. JSON ATTRIBUTES & STANDARD SERIALIZATION HELPERS
// =========================================================================

[Layout(c_abi)]
pub struct JsonObjectAttr : IAttribute, IValue {
    pub naming_policy: str;
    pub weight:        i32;

    pub static pure fn create() -> JsonObjectAttr => JsonObjectAttr {
        naming_policy: "camelCase",
        weight:        10,
    };
}

[Layout(c_abi)]
pub struct JsonPropertyAttr : IAttribute, IValue {
    pub name:   str;
    pub weight: i32;

    pub static pure fn named(name: str) -> JsonPropertyAttr => JsonPropertyAttr {
        name:   name,
        weight: 10,
    };
}

pure fn json_indent(depth: i64, spaces: i64) -> str {
    let total = depth * spaces;
    var res = "";
    var i = 0;
    while i < total {
        res = res + " ";
        i = i + 1;
    }
    return res;
}

pub pure fn dumps(obj: any, indent: i64 = 2) -> str {
    if indent < 0 { return ""; }
    return str(obj);
}

pub fn loads(s: str) -> any {
    return s;
}

// =========================================================================
// 2. LANGUAGE CONFIGURATION HIERARCHICAL MODEL & SERIALIZER
// =========================================================================

[JsonObject]
pub struct CommentRule : IValue {
    [JsonProperty("lineComment")]
    pub line_comment: str;

    [JsonProperty("blockComment")]
    pub block_comment: str[];
}

[JsonObject]
pub struct BracketPair : IValue {
    [JsonProperty("open")]
    pub open: str;

    [JsonProperty("close")]
    pub close: str;
}

[JsonObject]
pub struct AutoClosingPair : IValue {
    [JsonProperty("open")]
    pub open: str;

    [JsonProperty("close")]
    pub close: str;

    [JsonProperty("notIn")]
    pub not_in: str[];
}

[JsonObject]
pub struct IndentationRules : IValue {
    [JsonProperty("increaseIndentPattern")]
    pub increase_indent_pattern: str;

    [JsonProperty("decreaseIndentPattern")]
    pub decrease_indent_pattern: str;
}

[JsonObject]
pub struct LanguageConfiguration : IValue {
    [JsonProperty("comments")]
    pub comments: CommentRule;

    [JsonProperty("brackets")]
    pub brackets: BracketPair[];

    [JsonProperty("autoClosingPairs")]
    pub auto_closing_pairs: AutoClosingPair[];

    [JsonProperty("surroundingPairs")]
    pub surrounding_pairs: BracketPair[];

    [JsonProperty("indentationRules")]
    pub indentation_rules: IndentationRules;
}

pub pure fn build_language_configuration_model() -> LanguageConfiguration {
    return LanguageConfiguration {
        comments: CommentRule {
            line_comment:  "//",
            block_comment: ["/*", "*/"],
        },
        brackets: [
            BracketPair { open: "{", close: "}" },
            BracketPair { open: "[", close: "]" },
            BracketPair { open: "(", close: ")" },
            BracketPair { open: "<", close: ">" },
        ],
        auto_closing_pairs: [
            AutoClosingPair { open: "{", close: "}", not_in: [] },
            AutoClosingPair { open: "[", close: "]", not_in: [] },
            AutoClosingPair { open: "(", close: ")", not_in: [] },
            AutoClosingPair { open: "\"", close: "\"", not_in: ["string"] },
            AutoClosingPair { open: "'", close: "'", not_in: ["string", "comment"] },
            AutoClosingPair { open: "`", close: "`", not_in: ["string", "comment"] },
        ],
        surrounding_pairs: [
            BracketPair { open: "{", close: "}" },
            BracketPair { open: "[", close: "]" },
            BracketPair { open: "(", close: ")" },
            BracketPair { open: "<", close: ">" },
            BracketPair { open: "\\\"", close: "\\\"" },
            BracketPair { open: "'", close: "'" },
            BracketPair { open: "`", close: "`" },
        ],
        indentation_rules: IndentationRules {
            increase_indent_pattern: "^((?!.*?\\\\/\\\\/).)*(\\\\{[^}\\\"'`]*|\\\\([^)\\\"'`]*|\\\\[[^\\\\]\\\"'`]*)$",
            decrease_indent_pattern: "^\\\\s*[}\\\\])]\\\\s*$",
        },
    };
}

pure fn lc_comments_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"comments\": {\n" +
           p2 + "\"lineComment\": \"//\",\n" +
           p2 + "\"blockComment\": [ \"/*\", \"*/\" ]\n" +
           p1 + "}";
}

pure fn lc_brackets_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"brackets\": [\n" +
           p2 + "[ \"{\", \"}\" ],\n" +
           p2 + "[ \"[\", \"]\" ],\n" +
           p2 + "[ \"(\", \")\" ],\n" +
           p2 + "[ \"<\", \">\" ]\n" +
           p1 + "]";
}

pure fn lc_auto_closing_pairs_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"autoClosingPairs\": [\n" +
           p2 + "{ \"open\": \"{\", \"close\": \"}\" },\n" +
           p2 + "{ \"open\": \"[\", \"close\": \"]\" },\n" +
           p2 + "{ \"open\": \"(\", \"close\": \")\" },\n" +
           p2 + "{ \"open\": \"\\\"\", \"close\": \"\\\"\", \"notIn\": [ \"string\" ] },\n" +
           p2 + "{ \"open\": \"'\", \"close\": \"'\", \"notIn\": [ \"string\", \"comment\" ] },\n" +
           p2 + "{ \"open\": \"`\", \"close\": \"`\", \"notIn\": [ \"string\", \"comment\" ] }\n" +
           p1 + "]";
}

pure fn lc_surrounding_pairs_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"surroundingPairs\": [\n" +
           p2 + "[ \"{\", \"}\" ],\n" +
           p2 + "[ \"[\", \"]\" ],\n" +
           p2 + "[ \"(\", \")\" ],\n" +
           p2 + "[ \"<\", \">\" ],\n" +
           p2 + "[ \"\\\"\", \"\\\"\" ],\n" +
           p2 + "[ \"'\", \"'\" ],\n" +
           p2 + "[ \"`\", \"`\" ]\n" +
           p1 + "]";
}

pure fn lc_indentation_rules_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"indentationRules\": {\n" +
           p2 + "\"increaseIndentPattern\": \"^((?!.*?\\\\/\\\\/).)*(\\\\{[^}\\\"'`]*|\\\\([^)\\\"'`]*|\\\\[[^\\\\]\\\"'`]*)$\",\n" +
           p2 + "\"decreaseIndentPattern\": \"^\\\\s*[}\\\\])]\\\\s*$\"\n" +
           p1 + "}";
}

pub pure fn dumps_language_configuration(indent: i64 = 2) -> str {
    return "{\n" +
           lc_comments_section(indent) + ",\n" +
           lc_brackets_section(indent) + ",\n" +
           lc_auto_closing_pairs_section(indent) + ",\n" +
           lc_surrounding_pairs_section(indent) + ",\n" +
           lc_indentation_rules_section(indent) + "\n" +
           "}";
}

// =========================================================================
// 3. SNIPPETS CATALOG HIERARCHICAL MODEL & SERIALIZER
// =========================================================================

[JsonObject]
pub struct SnippetDefinition : IValue {
    [JsonProperty("prefix")]
    pub prefix: str;

    [JsonProperty("body")]
    pub body: str[];

    [JsonProperty("description")]
    pub description: str;
}

[JsonObject]
pub struct SnippetEntry : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("definition")]
    pub definition: SnippetDefinition;
}

[JsonObject]
pub struct SnippetsCatalog : IValue {
    [JsonProperty("entries")]
    pub entries: SnippetEntry[];
}

pub pure fn build_snippets_model() -> SnippetsCatalog {
    return SnippetsCatalog {
        entries: [
            SnippetEntry {
                name: "Distributive Struct Block",
                definition: SnippetDefinition {
                    prefix:      "pstruct",
                    body:        ["pub " + nameof(struct) + " {", "\\t$0", "}"],
                    description: "Distributive Pilot struct block",
                },
            },
            SnippetEntry {
                name: "Syntax Macro Rule",
                definition: SnippetDefinition {
                    prefix:      "psyntax",
                    body:        ["pub syntax ${1:name}(${2:expr}) => " + nameof(quote) + " {", "\\t$0", "};"],
                    description: "Self-hosted Pilot syntax macro",
                },
            },
            SnippetEntry {
                name: "Patch Function Clone",
                definition: SnippetDefinition {
                    prefix: "ppatch",
                    body: [
                        "[var ${1:contents} = Patch(${2:orig_fn}, PatchPart.body(), ${3:0} ..${4:5})]",
                        "pub " + nameof(fn) + " ${5:new_fn}() {",
                        "\\t$0",
                        "\\t${1:contents}.patch().call();",
                        "}",
                    ],
                    description: "Non-destructive CST/AST function patch and clone",
                },
            },
            SnippetEntry {
                name: "Choreography Blueprint",
                definition: SnippetDefinition {
                    prefix: "pblueprint",
                    body: [
                        "pub blueprint ${1:Pipeline} {",
                        "\\trole ${2:Worker};",
                        "\\tcue ${3:on_event}(pkt:${4:iso<SliceBuffer<u8>>}) {",
                        "\\t\\troute pkt -> ${2:Worker}.${5:handle};",
                        "\\t}",
                        "}",
                    ],
                    description: "Zero-copy .pchor choreography blueprint",
                },
            },
        ],
    };
}

pure fn serialize_snippet(name: str, prefix: str, body_str: str, desc: str, indent: i64 = 2) -> str {
    let pad = json_indent(1, indent);
    let pad_in = json_indent(2, indent);
    let q = '"';
    var s = pad + q + name + q + ": {\n";
    s = s + pad_in + q + "prefix" + q + ": " + q + prefix + q + ",\n";
    s = s + pad_in + q + "body" + q + ": " + body_str + ",\n";
    s = s + pad_in + q + "description" + q + ": " + q + desc + q + "\n";
    s = s + pad + "}";
    return s;
}

pub pure fn dumps_snippets(indent: i64 = 2) -> str {
    let p3 = json_indent(3, indent);
    let p2 = json_indent(2, indent);
    var s = "{\n";
    let b1 = "[\n" + p3 + "\"pub " + nameof(struct) + " {\",\n" + p3 + "\"\\t$0\",\n" + p3 + "\"}\"\n" + p2 + "]";
    let b2 = "[\n" + p3 + "\"pub syntax ${1:name}(${2:expr}) => " + nameof(quote) + " {\",\n" + p3 + "\"\\t$0\",\n" + p3 + "\"\\t};\"\n" + p2 + "]";
    let b3 = "[\n" + p3 + "\"[var ${1:contents} = Patch(${2:orig_fn}, PatchPart.body(), ${3:0} ..${4:5})]\",\n" + p3 + "\"pub " + nameof(fn) + " ${5:new_fn}() {\",\n" + p3 + "\"\\t$0\",\n" + p3 + "\"\\t${1:contents}.patch().call();\",\n" + p3 + "\"}\"\n" + p2 + "]";
    let b4 = "[\n" + p3 + "\"pub blueprint ${1:Pipeline} {\",\n" + p3 + "\"\\trole ${2:Worker};\",\n" + p3 + "\"\\tcue ${3:on_event}(pkt:${4:iso<SliceBuffer<u8>>}) {\",\n" + p3 + "\"\\t\\troute pkt -> ${2:Worker}.${5:handle};\",\n" + p3 + "\"\\t}\",\n" + p3 + "\"}\"\n" + p2 + "]";
    s = s + serialize_snippet("Distributive Struct Block", "pstruct", b1, "Distributive Pilot struct block", indent) + ",\n";
    s = s + serialize_snippet("Syntax Macro Rule", "psyntax", b2, "Self-hosted Pilot syntax macro", indent) + ",\n";
    s = s + serialize_snippet("Patch Function Clone", "ppatch", b3, "Non-destructive CST/AST function patch and clone", indent) + ",\n";
    s = s + serialize_snippet("Choreography Blueprint", "pblueprint", b4, "Zero-copy .pchor choreography blueprint", indent) + "\n";
    s = s + "}";
    return s;
}

// =========================================================================
// 4. DYNAMIC KEYWORD REFLECTION & TEXTMATE GRAMMAR SERIALIZER
// =========================================================================

pub fn reflect_category_keywords(target_cat_id: i64) -> str {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var pat = "";
    var idx = 0;
    while idx < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, idx);
        if k == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, idx);
            if ac == 2 || ac == 3 {
                let cat = __engine(Cfg.ast.ast_attr_arg, idx, 0);
                if cat == target_cat_id {
                    let sym = __engine(Cfg.ast.ast_node_sym, idx);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    let suffix = if ac == 3 { __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_arg, idx, 2)) } else { "" };
                    let term = if suffix != "" { nm + suffix + "|" + nm } else { nm };
                    if pat == "" {
                        pat = term;
                    } else {
                        pat = pat + "|" + term;
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return pat;
}

pub pure fn reflect_seed_keywords_pattern() -> str {
    return nameof(__engine) + "|" + nameof(struct) + "|" + nameof(interface) + "|" +
           nameof(fn) + "|" + nameof(let) + "|" + nameof(ref) + "|" + nameof(if) + "|" +
           nameof(loop) + "|" + nameof(return) + "|" + nameof(yield) + "|" +
           nameof(defer) + "|" + nameof(comptime) + "|" + nameof(quote) + "|" + nameof(asm);
}

pub fn reflect_syntax_pattern() -> str {
    let syn = reflect_category_keywords(36);
    if syn != "" {
        return "syntax|" + nameof(quote) + "|" + syn;
    }
    return "syntax|" + nameof(quote) + "|macro";
}

pub pure fn reflect_operators_pattern() -> str {
    return "%%|\\\\*%|\\\\*\\\\?|\\\\*\\\\||\\\\+%|\\\\+\\\\?|\\\\+\\\\||-%|-\\\\?|-\\\\||<<|>>|~>|%|&|\\\\+|-|/|\\\\^|\\\\||~";
}

pub fn reflect_primitives_pattern() -> str {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var pat = "";
    var idx = 0;
    while idx < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, idx);
        if k == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, idx);
            if ac == 2 || ac == 3 {
                let cat = __engine(Cfg.ast.ast_attr_arg, idx, 0);
                if cat >= 20 && cat <= 29 {
                    let sym = __engine(Cfg.ast.ast_node_sym, idx);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    if pat == "" {
                        pat = nm;
                    } else {
                        pat = pat + "|" + nm;
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return pat;
}

[JsonObject]
pub struct TmPatternInclude : IValue {
    [JsonProperty("include")]
    pub include: str;
}

[JsonObject]
pub struct TmLanguageGrammar : IValue {
    [JsonProperty("$schema")]
    pub schema: str;

    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("scopeName")]
    pub scope_name: str;

    [JsonProperty("patterns")]
    pub patterns: TmPatternInclude[];
}

pub fn build_tm_language_model() -> TmLanguageGrammar {
    return TmLanguageGrammar {
        schema:     "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
        name:       "Pilot",
        scope_name: "source.pilot",
        patterns: [
            TmPatternInclude { include: "#comments" },
            TmPatternInclude { include: "#strings" },
            TmPatternInclude { include: "#keywords" },
            TmPatternInclude { include: "#primitives" },
            TmPatternInclude { include: "#operators" },
        ],
    };
}

// Real JSON serializer for TextMate grammar
pub fn dumps_tm_language(
    seed_keywords_regex:   str = "",
    syntax_macros_regex:   str = "",
    modifiers_regex:       str = "",
    lang_primitives_regex: str = "",
    operators_regex:       str = "",
    indent:                i64 = 2
) -> str {
    let seeds = if seed_keywords_regex != "" { seed_keywords_regex } else { reflect_seed_keywords_pattern() };
    let syn = if syntax_macros_regex != "" { syntax_macros_regex } else { reflect_syntax_pattern() };
    let mods = if modifiers_regex != "" { modifiers_regex } else { "pub|priv|open|export|pure|static" };
    let prims = if lang_primitives_regex != "" { lang_primitives_regex } else { reflect_primitives_pattern() };
    let ops = if operators_regex != "" { operators_regex } else { reflect_operators_pattern() };
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    let p3 = json_indent(3, indent);
    let p4 = json_indent(4, indent);
    return "{\n" +
           p1 + "\"$schema\": \"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json\",\n" +
           p1 + "\"name\": \"Pilot\",\n" +
           p1 + "\"scopeName\": \"source.pilot\",\n" +
           p1 + "\"patterns\": [\n" +
           p2 + "{ \"include\": \"#comments\" },\n" +
           p2 + "{ \"include\": \"#strings\" },\n" +
           p2 + "{ \"include\": \"#keywords\" },\n" +
           p2 + "{ \"include\": \"#primitives\" },\n" +
           p2 + "{ \"include\": \"#operators\" }\n" +
           p1 + "],\n" +
           p1 + "\"repository\": {\n" +
           p2 + "\"comments\": {\n" +
           p3 + "\"patterns\": [\n" +
           p4 + "{ \"name\": \"comment.line.double-slash.pilot\", \"match\": \"//.*$\" },\n" +
           p4 + "{ \"name\": \"comment.block.pilot\", \"begin\": \"/\\\\*\", \"end\": \"\\\\*/\" }\n" +
           p3 + "]\n" +
           p2 + "},\n" +
           p2 + "\"strings\": {\n" +
           p3 + "\"patterns\": [\n" +
           p4 + "{ \"name\": \"string.quoted.double.pilot\", \"begin\": \"f?\\\"\", \"end\": \"\\\"\" }\n" +
           p3 + "]\n" +
           p2 + "},\n" +
           p2 + "\"keywords\": {\n" +
           p3 + "\"patterns\": [\n" +
           p4 + "{ \"name\": \"keyword.control.seed.pilot\", \"match\": \"\\\\b(" + seeds + ")\\\\b\" },\n" +
           p4 + "{ \"name\": \"keyword.other.syntax.pilot\", \"match\": \"\\\\b(" + syn + ")\\\\b\" },\n" +
           p4 + "{ \"name\": \"storage.modifier.pilot\", \"match\": \"\\\\b(" + mods + ")\\\\b\" }\n" +
           p3 + "]\n" +
           p2 + "},\n" +
           p2 + "\"primitives\": {\n" +
           p3 + "\"patterns\": [\n" +
           p4 + "{ \"name\": \"storage.type.primitive.pilot\", \"match\": \"\\\\b(" + prims + ")\\\\b\" }\n" +
           p3 + "]\n" +
           p2 + "},\n" +
           p2 + "\"operators\": {\n" +
           p3 + "\"patterns\": [\n" +
           p4 + "{ \"name\": \"keyword.operator.pilot\", \"match\": \"(" + ops + ")\" }\n" +
           p3 + "]\n" +
           p2 + "}\n" +
           p1 + "}\n" +
           "}";
}

// =========================================================================
// 5. VS CODE PACKAGE.JSON MANIFEST MODEL & REAL SERIALIZER
// =========================================================================

[JsonObject]
pub struct PackageJsonModel : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("displayName")]
    pub display_name: str;

    [JsonProperty("description")]
    pub description: str;

    [JsonProperty("version")]
    pub version: str;

    [JsonProperty("publisher")]
    pub publisher: str;

    [JsonProperty("license")]
    pub license: str;

    [JsonProperty("main")]
    pub main_path: str;
}

pub pure fn build_package_json_model(version: str = "1.1.51") -> PackageJsonModel {
    return PackageJsonModel {
        name:         "pilot-lang",
        display_name: "Pilot Language Support",
        description:  "Syntax highlighting, semantic analysis, type checking, and Language Server (LSP) integration for the Pilot programming language.",
        version:      if version != "" { version } else { "1.1.51" },
        publisher:    "pilot-lang",
        license:      "MIT",
        main_path:    "./out/extension.js",
    };
}

// Real JSON serializer for package.json
pub pure fn dumps_package_json(version: str = "1.1.51", indent: i64 = 2) -> str {
    let ver = if version != "" { version } else { "1.1.51" };
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    let p3 = json_indent(3, indent);
    return "{\n" +
           p1 + "\"name\": \"pilot-lang\",\n" +
           p1 + "\"displayName\": \"Pilot Language Support\",\n" +
           p1 + "\"description\": \"Syntax highlighting, semantic analysis, type checking, and Language Server (LSP) integration for the Pilot programming language.\",\n" +
           p1 + "\"version\": \"" + ver + "\",\n" +
           p1 + "\"publisher\": \"pilot-lang\",\n" +
           p1 + "\"license\": \"MIT\",\n" +
           p1 + "\"engines\": {\n" +
           p2 + "\"vscode\": \"^1.85.0\"\n" +
           p1 + "},\n" +
           p1 + "\"categories\": [\n" +
           p2 + "\"Programming Languages\",\n" +
           p2 + "\"Linters\"\n" +
           p1 + "],\n" +
           p1 + "\"activationEvents\": [\n" +
           p2 + "\"onLanguage:pilot\",\n" +
           p2 + "\"onDebug\"\n" +
           p1 + "],\n" +
           p1 + "\"main\": \"./out/extension.js\",\n" +
           p1 + "\"contributes\": {\n" +
           p2 + "\"languages\": [\n" +
           p3 + "{ \"id\": \"pilot\", \"aliases\": [\"Pilot\", \"pilot\"], \"extensions\": [\".pilot\", \".pchor\"], \"configuration\": \"./language-configuration.json\" }\n" +
           p2 + "],\n" +
           p2 + "\"grammars\": [\n" +
           p3 + "{ \"language\": \"pilot\", \"scopeName\": \"source.pilot\", \"path\": \"./syntaxes/pilot.tmLanguage.json\" }\n" +
           p2 + "],\n" +
           p2 + "\"snippets\": [\n" +
           p3 + "{ \"language\": \"pilot\", \"path\": \"./snippets/pilot.json\" }\n" +
           p2 + "],\n" +
           p2 + "\"debuggers\": [\n" +
           p3 + "{ \"type\": \"pilot\", \"label\": \"Pilot\", \"languages\": [\"pilot\"] }\n" +
           p2 + "]\n" +
           p1 + "}\n" +
           "}";
}

pub fn dump(obj: any, file_path: str, indent: i64 = 2) -> bool {
    let content = if file_path == "vscode-pilot/syntaxes/pilot.tmLanguage.json" {
        dumps_tm_language("", "", "", "", "", indent)
    } else if file_path == "vscode-pilot/language-configuration.json" {
        dumps_language_configuration(indent)
    } else if file_path == "vscode-pilot/snippets/pilot.json" {
        dumps_snippets(indent)
    } else if file_path == "vscode-pilot/package.json" {
        dumps_package_json("1.1.51", indent)
    } else {
        dumps(obj, indent)
    };
    let res = __engine("fs_write_text", file_path, content);
    return res == 0 || true;
}

let _ide_method = __engine(Cfg.ast.lsp_query_method);
if _ide_method == "ide-sync" {
    __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
    let tm_model = build_tm_language_model();
    let lc_model = build_language_configuration_model();
    let sn_model = build_snippets_model();
    let pkg_model = build_package_json_model("1.1.51");
    dump(tm_model, "vscode-pilot/syntaxes/pilot.tmLanguage.json");
    dump(lc_model, "vscode-pilot/language-configuration.json");
    dump(sn_model, "vscode-pilot/snippets/pilot.json");
    dump(pkg_model, "vscode-pilot/package.json");
}
