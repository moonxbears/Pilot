// ============================================================================
// FILE: selfhost/perceus/arc.pilot
// Milestone 54.1: 2-Bit Lattice Perceus ARC Engine & Drop-Guided Memory Reuse
// Zero hardcoded type names; operates strictly on 2-bit hardware lattice masks
// (`0b00` Value, `0b01` Reference View, `0b10` Owned Object, `0b11` Scoped Guard).
// ============================================================================

[Layout(c_abi)]
pub struct BindingLifecycleState : IValue {
    pub lattice_bits: i64;
    pub move_by_default: bool;
    pub is_moved: bool;
    pub allow_early_last_use_drop: bool;
    pub needs_scope_exit_drop: bool;
    pub elided_retain: bool;
}

pub pure fn ownership_trivial_bit_copy() -> i64 { return 0; }
pub pure fn ownership_lexical_borrow_only() -> i64 { return 1; }
pub pure fn ownership_move_and_drop() -> i64 { return 2; }
pub pure fn ownership_scoped_guard_move_and_drop() -> i64 { return 3; }

// 1-cycle bitwise classification of Perceus lifecycle action from 2-bit lattice (`0..3`).
pub pure fn classify_perceus_action(lattice: i64) -> i64 {
    let bits = lattice & 3;
    if bits == 0 { return 0; }
    if bits == 1 { return 1; }
    if bits == 2 { return 2; }
    return 3;
}

// 1-cycle bitwise lattice check for local binding lifecycle registration.
pub fn track_binding_by_lattice(var_name: str, lattice_bits: i64) -> BindingLifecycleState {
    let bits = lattice_bits & 3;
    let has_name = var_name.len() >= 0;
    if (bits & 2) == 0 && has_name {
        return BindingLifecycleState {
            lattice_bits: bits,
            move_by_default: false,
            is_moved: false,
            allow_early_last_use_drop: false,
            needs_scope_exit_drop: false,
            elided_retain: true,
        };
    }
    let is_guard = (bits & 1) != 0;
    return BindingLifecycleState {
        lattice_bits: bits,
        move_by_default: true,
        is_moved: false,
        allow_early_last_use_drop: !is_guard,
        needs_scope_exit_drop: true,
        elided_retain: false,
    };
}

// Checks whether passing/assigning a binding of `lattice_bits` moves ownership (`true`)
// or performs a trivial bit-copy (`false`).
pub pure fn requires_move_on_transfer(lattice_bits: i64) -> bool {
    return (lattice_bits & 2) != 0;
}

// Emits the canonical Perceus ARC drop operation for `var_name` with `lattice_bits`.
pub fn emit_drop_op_for_lattice(var_name: str, lattice_bits: i64, at_scope_exit: bool) -> str {
    let bits = lattice_bits & 3;
    if (bits & 2) == 0 {
        return "";
    }
    let is_guard = (bits & 1) != 0;
    if !at_scope_exit {
        if is_guard {
            return "";
        }
        return "Drop:" + var_name;
    }
    return "ScopeExitDrop:" + var_name;
}

// Milestone 14: Emits a Perceus drop operation with foreign destructor function pointer.
pub fn emit_foreign_drop_op(var_name: str, dtor_sym: str) -> str {
    if dtor_sym.len() > 0 {
        return "ForeignDrop:" + var_name + "(" + dtor_sym + ")";
    }
    return "Drop:" + var_name;
}

// Emits a Perceus `DropReuse` token when a dropped `0b10` object's layout size matches
// an immediately following allocation (`rc == 1` in-place memory recycling).
pub fn emit_drop_reuse_op(
    dropped_var: str,
    dropped_lattice: i64,
    dropped_size: i64,
    target_var: str,
    target_size: i64
) -> str {
    let bits = dropped_lattice & 3;
    if bits == 2 && dropped_size > 0 && dropped_size == target_size {
        return "DropReuse:" + dropped_var + "->" + target_var;
    }
    if (bits & 2) != 0 {
        return "Drop:" + dropped_var;
    }
    return "";
}

// Emits reverse-order (LIFO) `ScopeExitDrop` instructions for comma-separated `0b11` guards
// declared in a lexical block (`"g1,g2,g3"` -> `"ScopeExitDrop:g3;ScopeExitDrop:g2;ScopeExitDrop:g1"`).
pub fn emit_reverse_guard_drops(guards_csv: str) -> str {
    let n = guards_csv.len();
    if n == 0 {
        return "";
    }
    var out = "";
    var end = n;
    var i = n - 1;
    while i >= 0 {
        if guards_csv.byte_at(i) == 44 {
            let gname = guards_csv.slice(i + 1, end);
            if gname.len() > 0 {
                if out.len() > 0 {
                    out = out + ";";
                }
                out = out + "ScopeExitDrop:" + gname;
            }
            end = i;
        }
        i = i - 1;
    }
    let first = guards_csv.slice(0, end);
    if first.len() > 0 {
        if out.len() > 0 {
            out = out + ";";
        }
        out = out + "ScopeExitDrop:" + first;
    }
    return out;
}

// Appends an ARC schedule token onto `;`-delimited `acc`.
pub fn arc_append_tok(acc: str, tok: str) -> str {
    if tok.len() == 0 {
        return acc;
    }
    if acc.len() == 0 {
        return tok;
    }
    return acc + ";" + tok;
}

// Finds `StructDecl` (`kind_tag == 1`) with matching `sym_id` (`-1` if not found).
pub fn arc_find_struct_decl(type_sym: i64, node_count: i64) -> i64 {
    if type_sym <= 0 {
        return -1;
    }
    var i = 0;
    while i < node_count {
        if __engine("ast_node_kind", i) == 1 && __engine("ast_node_sym", i) == type_sym {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Finds `InterfaceDecl` (`kind_tag == 2`) with matching `sym_id` (`-1` if not found).
pub fn arc_find_interface_decl(type_sym: i64, node_count: i64) -> i64 {
    if type_sym <= 0 {
        return -1;
    }
    var i = 0;
    while i < node_count {
        if __engine("ast_node_kind", i) == 2 && __engine("ast_node_sym", i) == type_sym {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Finds `FnDecl` (`kind_tag == 3`) with matching `sym_id` (`-1` if not found).
pub fn arc_find_fn_decl_by_sym(fn_sym: i64, node_count: i64) -> i64 {
    if fn_sym <= 0 {
        return -1;
    }
    var i = 0;
    while i < node_count {
        if __engine("ast_node_kind", i) == 3 && __engine("ast_node_sym", i) == fn_sym {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

// Reads explicit `[Lattice(mask)]` attribute mask on `decl_nid` (`-1` if absent).
pub fn arc_read_lattice_attr(decl_nid: i64) -> i64 {
    let acnt = __engine("ast_attr_decl_count", decl_nid);
    var ai = 0;
    while ai < acnt {
        let aname = __engine("sym_str", __engine("ast_attr_name", decl_nid, ai));
        if aname == nameof(Lattice) && __engine("ast_attr_decl_arg_count", decl_nid, ai) >= 1 {
            return __engine("ast_attr_decl_arg", decl_nid, ai, 0) & 3;
        }
        ai = ai + 1;
    }
    return -1;
}

// Checks whether `struct_nid` owns a `~self()` destructor (`decl_flags & 1024` or `DestructorDecl`).
pub fn arc_struct_has_dtor(struct_nid: i64) -> bool {
    if (__engine("ast_decl_flags", struct_nid) & 1024) != 0 {
        return true;
    }
    let cc = __engine("ast_child_count", struct_nid);
    var ci = 0;
    while ci < cc {
        let ch = __engine("ast_child_at", struct_nid, ci);
        if __engine("ast_orig_kind", ch) == 14 {
            return true;
        }
        ci = ci + 1;
    }
    return false;
}

// Deduces the 2-bit lattice (`0..3`) for `type_sym` from `[Lattice(mask)]`, core lattice
// interfaces (`IValue`, `IReference`, `IObject`, `IGuard`), `~self()`, and stored fields.
pub fn arc_deduce_type_lattice(type_sym: i64, node_count: i64, memo: i64, depth: i64) -> i64 {
    if type_sym <= 0 || depth > 16 {
        return 0;
    }
    let cached = __engine("map_get", memo, "lat_" + type_sym);
    if cached > 0 {
        return (cached - 1) & 3;
    }

    let tname = __engine("sym_str", type_sym);
    if tname == nameof(IAnyValue) || tname == nameof(IValue) {
        __engine("map_set", memo, "lat_" + type_sym, 1);
        return 0;
    }
    if tname == nameof(IReference) {
        __engine("map_set", memo, "lat_" + type_sym, 2);
        return 1;
    }
    if tname == nameof(IObject) {
        __engine("map_set", memo, "lat_" + type_sym, 3);
        return 2;
    }
    if tname == nameof(IGuard) {
        __engine("map_set", memo, "lat_" + type_sym, 4);
        return 3;
    }

    // Break potential recursive cycles conservatively at 0 before unfolding bases/fields
    __engine("map_set", memo, "lat_" + type_sym, 1);

    let iface_nid = arc_find_interface_decl(type_sym, node_count);
    if iface_nid >= 0 {
        var ibits = 0;
        let lat_attr = arc_read_lattice_attr(iface_nid);
        if lat_attr >= 0 {
            ibits = ibits | lat_attr;
        }
        let bcnt = __engine("ast_base_count", iface_nid);
        var bi = 0;
        while bi < bcnt {
            let bsym = __engine("ast_base_at", iface_nid, bi);
            ibits = ibits | arc_deduce_type_lattice(bsym, node_count, memo, depth + 1);
            bi = bi + 1;
        }
        ibits = ibits & 3;
        __engine("map_set", memo, "lat_" + type_sym, ibits + 1);
        return ibits;
    }

    let struct_nid = arc_find_struct_decl(type_sym, node_count);
    if struct_nid >= 0 {
        var sbits = 0;
        let slat_attr = arc_read_lattice_attr(struct_nid);
        if slat_attr >= 0 {
            sbits = sbits | slat_attr;
        }
        let sbcnt = __engine("ast_base_count", struct_nid);
        var sbi = 0;
        while sbi < sbcnt {
            let sbsym = __engine("ast_base_at", struct_nid, sbi);
            sbits = sbits | arc_deduce_type_lattice(sbsym, node_count, memo, depth + 1);
            sbi = sbi + 1;
        }
        if arc_struct_has_dtor(struct_nid) {
            sbits = sbits | 2;
        }
        let fcnt = __engine("ast_child_count", struct_nid);
        var fi = 0;
        while fi < fcnt {
            let fnid = __engine("ast_child_at", struct_nid, fi);
            let fk = __engine("ast_node_kind", fnid);
            if fk == 21 || fk == 4 {
                let ftsym = __engine("ast_node_raw_bits", fnid);
                if ftsym > 0 && ftsym != type_sym {
                    sbits = sbits | arc_deduce_type_lattice(ftsym, node_count, memo, depth + 1);
                }
            }
            fi = fi + 1;
        }
        sbits = sbits & 3;
        __engine("map_set", memo, "lat_" + type_sym, sbits + 1);
        return sbits;
    }

    return 0;
}

// Queries `LayoutTable` `byte_size` (`layout_metrics`) for `type_sym`.
pub fn arc_resolve_type_byte_size(type_sym: i64, node_count: i64) -> i64 {
    let sid = arc_find_struct_decl(type_sym, node_count);
    if sid < 0 {
        return 0;
    }
    let lid = __engine("ast_get_bound_layout", sid);
    if lid == 4294967295 || lid < 0 {
        return 0;
    }
    return __engine("layout_metrics", lid);
}

// Infers `type_sym` for an unannotated RHS expression when possible.
pub fn arc_infer_rhs_type_sym(rhs_nid: i64, state: i64, node_count: i64) -> i64 {
    if rhs_nid <= 0 {
        return 0;
    }
    let k = __engine("ast_node_kind", rhs_nid);
    if k == 14 {
        let vname = __engine("sym_str", __engine("ast_node_sym", rhs_nid));
        let ts_plus = __engine("map_get", state, "vts_" + vname);
        if ts_plus > 0 {
            return ts_plus - 1;
        }
        return 0;
    }
    if k == 16 && __engine("ast_child_count", rhs_nid) > 0 {
        let callee = __engine("ast_child_at", rhs_nid, 0);
        if __engine("ast_node_kind", callee) == 14 {
            let csym = __engine("ast_node_sym", callee);
            if arc_find_struct_decl(csym, node_count) >= 0 {
                return csym;
            }
        }
    }
    return 0;
}

// Records all reads of tracked local variables inside `expr_nid` during statement `stmt_idx`.
pub fn arc_collect_expr_reads(expr_nid: i64, stmt_idx: i64, state: i64) -> i64 {
    if expr_nid <= 0 {
        return 0;
    }
    let k = __engine("ast_node_kind", expr_nid);
    let orig = __engine("ast_orig_kind", expr_nid);

    if k == 14 {
        let name = __engine("sym_str", __engine("ast_node_sym", expr_nid));
        let reg_plus = __engine("map_get", state, "vreg_" + name);
        if reg_plus > 0 {
            let prev = __engine("map_get", state, "vtot_" + name) + 0;
            __engine("map_set", state, "vtot_" + name, prev + 1);
            __engine("map_set", state, "vlast_" + name, stmt_idx + 1);
            let scnt = __engine("map_get", state, "vsr_" + stmt_idx) + 0;
            __engine("map_set", state, "vsrn_" + stmt_idx + "_" + scnt, name);
            __engine("map_set", state, "vsr_" + stmt_idx, scnt + 1);
        }
        return 1;
    }

    if k == 16 {
        let cc = __engine("ast_child_count", expr_nid);
        if cc == 0 {
            return 0;
        }
        let callee = __engine("ast_child_at", expr_nid, 0);
        // Only walk callee if it is a local closure variable or member receiver
        if __engine("ast_node_kind", callee) != 14 {
            arc_collect_expr_reads(callee, stmt_idx, state);
        } else {
            let cname = __engine("sym_str", __engine("ast_node_sym", callee));
            if __engine("map_get", state, "vreg_" + cname) > 0 {
                arc_collect_expr_reads(callee, stmt_idx, state);
            }
        }
        if cc == 2 && __engine("ast_orig_kind", __engine("ast_child_at", expr_nid, 1)) == 219 {
            let map_nid = __engine("ast_child_at", expr_nid, 1);
            let mcc = __engine("ast_child_count", map_nid);
            var mi = 1;
            while mi < mcc {
                arc_collect_expr_reads(__engine("ast_child_at", map_nid, mi), stmt_idx, state);
                mi = mi + 2;
            }
            return 1;
        }
        var ai = 1;
        while ai < cc {
            arc_collect_expr_reads(__engine("ast_child_at", expr_nid, ai), stmt_idx, state);
            ai = ai + 1;
        }
        return 1;
    }

    if k == 20 {
        let acc = __engine("ast_child_count", expr_nid);
        if acc >= 1 {
            let lhs = __engine("ast_child_at", expr_nid, 0);
            if __engine("ast_node_kind", lhs) != 14 {
                arc_collect_expr_reads(lhs, stmt_idx, state);
            }
        }
        if acc >= 2 {
            arc_collect_expr_reads(__engine("ast_child_at", expr_nid, 1), stmt_idx, state);
        }
        return 1;
    }

    if orig == 219 {
        let pcc = __engine("ast_child_count", expr_nid);
        var pi = 1;
        while pi < pcc {
            arc_collect_expr_reads(__engine("ast_child_at", expr_nid, pi), stmt_idx, state);
            pi = pi + 2;
        }
        return 1;
    }

    let cc = __engine("ast_child_count", expr_nid);
    var ci = 0;
    while ci < cc {
        arc_collect_expr_reads(__engine("ast_child_at", expr_nid, ci), stmt_idx, state);
        ci = ci + 1;
    }
    return 1;
}

// Checks whether statement `stmt_nid` is a direct ownership-moving transfer of `vname`
// (`return vname;` or `let other = vname;`).
pub fn arc_is_direct_move_stmt(stmt_nid: i64, vname: str) -> bool {
    let k = __engine("ast_node_kind", stmt_nid);
    if k == 8 || k == 4 {
        if __engine("ast_child_count", stmt_nid) == 1 {
            let ch = __engine("ast_child_at", stmt_nid, 0);
            if __engine("ast_node_kind", ch) == 14 {
                if __engine("sym_str", __engine("ast_node_sym", ch)) == vname {
                    return true;
                }
            }
        }
    }
    return false;
}

// Schedules Perceus `Dup`, `Drop`, `DropReuse`, and LIFO `ScopeExitDrop` instructions
// for the `FnDecl` named `fn_name` in `PhysicsRegistry`.
pub fn perceus_schedule_fn(fn_name: str) -> str {
    let node_count = __engine("ast_node_count", 0);
    var fn_nid = -1;
    var i = 0;
    while i < node_count {
        if __engine("ast_node_kind", i) == 3 {
            if __engine("sym_str", __engine("ast_node_sym", i)) == fn_name {
                fn_nid = i;
                break;
            }
        }
        i = i + 1;
    }
    if fn_nid < 0 || __engine("ast_child_count", fn_nid) == 0 {
        return "";
    }

    let memo = __engine("map_new");
    let state = __engine("map_new");
    var var_count = 0;
    var guards_csv = "";

    // Register owned/guard parameters (`1 .. child_count`)
    let fn_cc = __engine("ast_child_count", fn_nid);
    var pi = 1;
    while pi < fn_cc {
        let pid = __engine("ast_child_at", fn_nid, pi);
        if __engine("ast_node_kind", pid) == 21 && !rt_param_has_modifier(pid, nameof(ref)) {
            let pname = __engine("sym_str", __engine("ast_node_sym", pid));
            let ptsym = __engine("ast_node_raw_bits", pid);
            let plat = arc_deduce_type_lattice(ptsym, node_count, memo, 0);
            let psz = arc_resolve_type_byte_size(ptsym, node_count);
            __engine("map_set", state, "vname_" + var_count, pname);
            __engine("map_set", state, "vreg_" + pname, var_count + 1);
            __engine("map_set", state, "vts_" + pname, ptsym + 1);
            __engine("map_set", state, "vlat_" + pname, plat);
            __engine("map_set", state, "vsz_" + pname, psz);
            __engine("map_set", state, "vdecl_" + pname, 0);
            var_count = var_count + 1;
            if plat == 3 {
                if guards_csv.len() > 0 {
                    guards_csv = guards_csv + "," + pname;
                } else {
                    guards_csv = pname;
                }
            }
        }
        pi = pi + 1;
    }

    let body_id = __engine("ast_child_at", fn_nid, 0);
    let stmt_count = __engine("ast_child_count", body_id);

    // Pass 1: Scan statements in order, collecting reads and registering local bindings
    var s = 0;
    while s < stmt_count {
        let st_nid = __engine("ast_child_at", body_id, s);
        let sk = __engine("ast_node_kind", st_nid);
        if sk == 4 {
            var rhs_nid = 0;
            if __engine("ast_child_count", st_nid) > 0 {
                rhs_nid = __engine("ast_child_at", st_nid, 0);
                arc_collect_expr_reads(rhs_nid, s, state);
            }
            let vname = __engine("sym_str", __engine("ast_node_sym", st_nid));
            var vtsym = __engine("ast_node_raw_bits", st_nid);
            if vtsym == 0 && rhs_nid > 0 {
                vtsym = arc_infer_rhs_type_sym(rhs_nid, state, node_count);
            }
            var vlat = arc_deduce_type_lattice(vtsym, node_count, memo, 0);
            if rhs_nid > 0 && __engine("ast_orig_kind", rhs_nid) == 218 {
                vlat = 2;
            }
            let vsz = arc_resolve_type_byte_size(vtsym, node_count);
            __engine("map_set", state, "vname_" + var_count, vname);
            __engine("map_set", state, "vreg_" + vname, var_count + 1);
            __engine("map_set", state, "vts_" + vname, vtsym + 1);
            __engine("map_set", state, "vlat_" + vname, vlat);
            __engine("map_set", state, "vsz_" + vname, vsz);
            __engine("map_set", state, "vdecl_" + vname, s + 1);
            var_count = var_count + 1;

            // Mark fresh 0b10 object construction at statement `s` for DropReuse matching
            if vlat == 2 && vsz > 0 && rhs_nid > 0 && __engine("ast_node_kind", rhs_nid) != 14 {
                __engine("map_set", state, "alloc_var_" + s, vname);
                __engine("map_set", state, "alloc_sz_" + s, vsz);
            }
            if vlat == 3 {
                if guards_csv.len() > 0 {
                    guards_csv = guards_csv + "," + vname;
                } else {
                    guards_csv = vname;
                }
            }
        } else {
            arc_collect_expr_reads(st_nid, s, state);
        }
        s = s + 1;
    }

    // Pass 2: Determine drop / reuse points for `0b10` (`IObject`) bindings
    var vi = 0;
    while vi < var_count {
        let vn = __engine("map_get", state, "vname_" + vi);
        let vlat = __engine("map_get", state, "vlat_" + vn) + 0;
        if vlat == 2 {
            let vtot = __engine("map_get", state, "vtot_" + vn) + 0;
            let vdecl_plus = __engine("map_get", state, "vdecl_" + vn) + 0;
            let vsz = __engine("map_get", state, "vsz_" + vn) + 0;
            if vtot == 0 {
                // Unused 0b10 binding drops after declaration statement
                var drop_s = 0;
                if vdecl_plus > 0 {
                    drop_s = vdecl_plus - 1;
                }
                let next_s = drop_s + 1;
                let next_sz = __engine("map_get", state, "alloc_sz_" + next_s) + 0;
                let claimed = __engine("map_get", state, "alloc_used_" + next_s) + 0;
                if next_s < stmt_count && next_sz > 0 && claimed == 0 && vsz == next_sz {
                    let target_vn = __engine("map_get", state, "alloc_var_" + next_s);
                    let reuse_tok = emit_drop_reuse_op(vn, 2, vsz, target_vn, next_sz);
                    let prev_after = __engine("map_get", state, "after_ops_" + drop_s);
                    var base_after = "";
                    if prev_after.len() > 0 && prev_after != "null" {
                        base_after = prev_after;
                    }
                    __engine("map_set", state, "after_ops_" + drop_s, arc_append_tok(base_after, reuse_tok));
                    __engine("map_set", state, "alloc_used_" + next_s, 1);
                } else {
                    let drop_tok = emit_drop_op_for_lattice(vn, 2, false);
                    let prev_after = __engine("map_get", state, "after_ops_" + drop_s);
                    var base_after = "";
                    if prev_after.len() > 0 && prev_after != "null" {
                        base_after = prev_after;
                    }
                    __engine("map_set", state, "after_ops_" + drop_s, arc_append_tok(base_after, drop_tok));
                }
            } else if vtot == 1 {
                let last_s = (__engine("map_get", state, "vlast_" + vn) + 0) - 1;
                let last_nid = __engine("ast_child_at", body_id, last_s);
                if !arc_is_direct_move_stmt(last_nid, vn) {
                    let next_s = last_s + 1;
                    let next_sz = __engine("map_get", state, "alloc_sz_" + next_s) + 0;
                    let claimed = __engine("map_get", state, "alloc_used_" + next_s) + 0;
                    if next_s < stmt_count && next_sz > 0 && claimed == 0 && vsz == next_sz {
                        let target_vn = __engine("map_get", state, "alloc_var_" + next_s);
                        let reuse_tok = emit_drop_reuse_op(vn, 2, vsz, target_vn, next_sz);
                        let prev_after = __engine("map_get", state, "after_ops_" + last_s);
                        var base_after = "";
                        if prev_after.len() > 0 && prev_after != "null" {
                            base_after = prev_after;
                        }
                        __engine("map_set", state, "after_ops_" + last_s, arc_append_tok(base_after, reuse_tok));
                        __engine("map_set", state, "alloc_used_" + next_s, 1);
                    } else if last_s + 1 < stmt_count {
                        let drop_tok = emit_drop_op_for_lattice(vn, 2, false);
                        let prev_after = __engine("map_get", state, "after_ops_" + last_s);
                        var base_after = "";
                        if prev_after.len() > 0 && prev_after != "null" {
                            base_after = prev_after;
                        }
                        __engine("map_set", state, "after_ops_" + last_s, arc_append_tok(base_after, drop_tok));
                    }
                }
            }
        }
        vi = vi + 1;
    }

    // Pass 3: Assemble execution-order schedule (`Dup`, `Drop` / `DropReuse`, LIFO `ScopeExitDrop`)
    var schedule = "";
    var guards_emitted = false;
    s = 0;
    while s < stmt_count {
        let st_nid = __engine("ast_child_at", body_id, s);
        let rcnt = __engine("map_get", state, "vsr_" + s) + 0;
        var ri = 0;
        while ri < rcnt {
            let rname = __engine("map_get", state, "vsrn_" + s + "_" + ri);
            let rlat = __engine("map_get", state, "vlat_" + rname) + 0;
            let rtot = __engine("map_get", state, "vtot_" + rname) + 0;
            if rlat == 2 && rtot >= 2 {
                let seen = (__engine("map_get", state, "vseen_" + rname) + 0) + 1;
                __engine("map_set", state, "vseen_" + rname, seen);
                if seen < rtot {
                    schedule = arc_append_tok(schedule, "Dup:" + rname);
                }
            }
            ri = ri + 1;
        }

        if __engine("ast_node_kind", st_nid) == 8 && !guards_emitted {
            let lifo = emit_reverse_guard_drops(guards_csv);
            schedule = arc_append_tok(schedule, lifo);
            guards_emitted = true;
        }

        let after_s = __engine("map_get", state, "after_ops_" + s);
        if after_s.len() > 0 && after_s != "null" {
            schedule = arc_append_tok(schedule, after_s);
        }
        s = s + 1;
    }

    if !guards_emitted {
        let lifo = emit_reverse_guard_drops(guards_csv);
        schedule = arc_append_tok(schedule, lifo);
    }

    return schedule;
}
