// ============================================================================
// FILE: selfhost/perceus/realtime.pilot
// Milestone 54.2: `[HardRealtime]`, `noalloc` & `.pchor` Cue Boundary Verifier
// Enforces PILOT104 (zero Tier 2 global heap allocations in `[HardRealtime]` /
// `noalloc` contexts) and PILOT105 (zero-copy `.pchor` cue capability transfer)
// without function-name ("dsp") sniffing or legacy `@` decorator checks.
// ============================================================================

// Verifies that an allocation with `escape_state` (`0 = Stack`, `1 = Region`, `2 = Global`)
// inside a `[HardRealtime]` or `noalloc` context does not allocate on the global heap (`PILOT104`).
pub fn verify_noalloc_escape(escape_state: i64, in_realtime_or_noalloc: bool) -> str {
    if in_realtime_or_noalloc && escape_state == 2 {
        return "PILOT104";
    }
    return "";
}

// Verifies that a value with `lattice_bits` (`0..3`) and optional `iso` capability
// can cross a `.pchor` `cue` or realtime arena boundary with zero heap allocations (`PILOT105`).
// Allows `0b00` (`IValue`) unconditionally and `iso`-qualified `0b10` (`IObject`).
// Rejects unisolated `0b10` and all borrow-tracked types (`0b01` and `0b11`).
pub fn verify_cue_transfer_by_lattice(
    cue_name: str,
    lattice_bits: i64,
    is_iso_qualified: bool
) -> str {
    let bits = lattice_bits & 3;
    if bits == 0 {
        return "";
    }
    if bits == 2 && is_iso_qualified {
        return "";
    }
    return "PILOT105";
}

pub pure fn is_ident_byte(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95;
}

// Checks whether a source snippet contains the standalone keyword `kw` outside string literals.
pub fn source_contains_keyword(src: str, kw: str) -> bool {
    let n = src.len();
    let klen = kw.len();
    if klen == 0 || n < klen {
        return false;
    }
    var i = 0;
    while i + klen <= n {
        let b = src.byte_at(i);
        if b == 34 {
            i = i + 1;
            while i < n && src.byte_at(i) != 34 {
                if src.byte_at(i) == 92 { i = i + 2; } else { i = i + 1; }
            }
            if i < n { i = i + 1; }
        } else {
            if src.slice(i, i + klen) == kw {
                let prev_ok = (i == 0) || !is_ident_byte(src.byte_at(i - 1));
                let next_ok = (i + klen == n) || !is_ident_byte(src.byte_at(i + klen));
                if prev_ok && next_ok {
                    return true;
                }
            }
            i = i + 1;
        }
    }
    return false;
}

// Detects canonical `[HardRealtime]` attribute or `noalloc` scope modifier in `src`
// using `nameof(noalloc)` (zero function-name "dsp" sniffing, zero `@` decorators).
pub fn has_hard_realtime_or_noalloc_contract(src: str) -> bool {
    if source_contains_keyword(src, nameof(noalloc)) {
        return true;
    }
    if source_contains_keyword(src, "HardRealtime") {
        return true;
    }
    return false;
}
