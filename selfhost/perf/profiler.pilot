pub pkg Pilot.SelfHost.Perf.Profiler;

pub pure fn nameof(sym: str) -> str => sym;

pub enum ProfilerFormat {
    Svg,
    ChromeTrace,
}

fn prof_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = __engine("str_len", haystack);
    let nl = __engine("str_len", needle);
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if __engine("str_slice", haystack, i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

fn prof_parse_int(s: str) -> i64 {
    let n = __engine("str_len", s);
    var v = 0;
    var i = 0;
    while i < n {
        let b = __engine("str_byte_at", s, i);
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48);
            i = i + 1;
        } else {
            break;
        }
    }
    return v;
}

// Parses folded stacks e.g. "main;fn_a 1\nmain;fn_b 3" or raw "main;fn_a\n" lines
// Aggregates samples per frame into map.
pub fn parse_and_aggregate_folded_stacks(folded_stacks: str) -> i64 {
    let m = __engine("map_new");
    let total_len = __engine("str_len", folded_stacks);
    var pos = 0;
    var frame_count = 0;
    while pos < total_len {
        let nl = prof_find(folded_stacks, "\n", pos);
        let line_end = if nl >= 0 { nl } else { total_len };
        if line_end > pos {
            let line = __engine("str_slice", folded_stacks, pos, line_end);
            let sp = prof_find(line, " ", 0);
            var stack = line;
            var cnt = 1;
            if sp >= 0 {
                stack = __engine("str_slice", line, 0, sp);
                cnt = prof_parse_int(__engine("str_slice", line, sp + 1, __engine("str_len", line)));
                if cnt <= 0 { cnt = 1; }
            }
            // Extract leaf function name after last ';'
            var last_semi = -1;
            let slen = __engine("str_len", stack);
            var si = 0;
            while si < slen {
                if __engine("str_byte_at", stack, si) == 59 { last_semi = si; }
                si = si + 1;
            }
            let fn_name = if last_semi >= 0 { __engine("str_slice", stack, last_semi + 1, slen) } else { stack };
            
            let cur_val = __engine("map_get", m, "dur:" + fn_name);
            let prev = if cur_val != null { cur_val } else { 0 };
            let _s = __engine("map_set", m, "dur:" + fn_name, prev + cnt);
            if prev == 0 {
                let _fn = __engine("map_set", m, "frame:" + frame_count, fn_name);
                frame_count = frame_count + 1;
            }
            let tot_val = __engine("map_get", m, "total_samples");
            let prev_tot = if tot_val != null { tot_val } else { 0 };
            let _st = __engine("map_set", m, "total_samples", prev_tot + cnt);
        }
        if nl < 0 { break; }
        pos = nl + 1;
    }
    let _fc = __engine("map_set", m, "frame_count", frame_count);
    return m;
}

pub fn profile_folded_stacks_to_svg(folded_stacks: str, total_width_px: i64) -> str {
    let m = parse_and_aggregate_folded_stacks(folded_stacks);
    let total_samples = __engine("map_get", m, "total_samples");
    let tot = if total_samples != null && total_samples > 0 { total_samples } else { 1 };
    let frame_count = __engine("map_get", m, "frame_count");
    let fc = if frame_count != null { frame_count } else { 0 };

    var svg = "<?xml version=\"1.0\" standalone=\"no\"?>\n" +
              "<!DOCTYPE svg PUBLIC \"-//W3C//DTD SVG 1.1//EN\" \"http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd\">\n" +
              "<svg version=\"1.1\" width=\"" + total_width_px + "\" height=\"300\" onload=\"init(evt)\" viewBox=\"0 0 " + total_width_px + " 300\" xmlns=\"http://www.w3.org/2000/svg\">\n";

    var cur_x = 0;
    var i = 0;
    while i < fc {
        let fn_name = __engine("map_get", m, "frame:" + i);
        let samples = __engine("map_get", m, "dur:" + fn_name);
        let rect_w = (samples * total_width_px) / tot;
        let w = if rect_w > 0 { rect_w } else { 1 };
        svg = svg + "  <rect x=\"" + cur_x + "\" y=\"50\" width=\"" + w + "\" height=\"20\" fill=\"rgb(235,110,52)\"/>\n" +
                    "  <text x=\"" + (cur_x + 2) + "\" y=\"65\">" + fn_name + "</text>\n";
        cur_x = cur_x + w;
        i = i + 1;
    }
    svg = svg + "</svg>\n";
    return svg;
}

pub fn profile_folded_stacks_to_chrome_trace(folded_stacks: str) -> str {
    let m = parse_and_aggregate_folded_stacks(folded_stacks);
    let frame_count = __engine("map_get", m, "frame_count");
    let fc = if frame_count != null { frame_count } else { 0 };

    var json = "{\"traceEvents\":[";
    var cur_ts = 1000;
    var i = 0;
    while i < fc {
        let fn_name = __engine("map_get", m, "frame:" + i);
        let dur = __engine("map_get", m, "dur:" + fn_name);
        if i > 0 { json = json + ","; }
        json = json + "{\"name\":\"" + fn_name + "\",\"cat\":\"call\",\"ph\":\"X\",\"ts\":" + cur_ts + ",\"dur\":" + dur + ",\"pid\":1,\"tid\":1}";
        cur_ts = cur_ts + dur;
        i = i + 1;
    }
    json = json + "]}";
    return json;
}
