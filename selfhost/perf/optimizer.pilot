// =========================================================================
// FILE: selfhost/perf/optimizer.pilot
// Milestone 60.2: Real AST Constant-Folding & Pre-Allocation Optimizer
// Replaces crates/pilot-perf/src/optimize.rs in Pure Pilot.
// =========================================================================
pub pkg Pilot.SelfHost.Perf.Optimizer;

pub pure fn nameof(sym: str) -> str => sym;

pub fn fold_binary_int_constants(op_flag: i64, lhs_val: i64, rhs_val: i64) -> i64 {
    if op_flag == 1 {
        return lhs_val + rhs_val;
    }
    if op_flag == 2 {
        return lhs_val - rhs_val;
    }
    if op_flag == 3 {
        return lhs_val * rhs_val;
    }
    if op_flag == 4 && rhs_val != 0 {
        return lhs_val / rhs_val;
    }
    return lhs_val;
}

pub fn count_foldable_binary_nodes() -> i64 {
    let n = __engine("ast_node_count");
    var foldable = 0;
    var i = 0;
    while i < n {
        if __engine("ast_node_kind", i) == 19 {
            if __engine("ast_child_count", i) >= 2 {
                let c0 = __engine("ast_child_at", i, 0);
                let c1 = __engine("ast_child_at", i, 1);
                if __engine("ast_node_kind", c0) == 15 && __engine("ast_node_kind", c1) == 15 {
                    foldable = foldable + 1;
                }
            }
        }
        i = i + 1;
    }
    return foldable;
}
