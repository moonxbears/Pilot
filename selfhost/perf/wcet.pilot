// =========================================================================
// FILE: selfhost/perf/wcet.pilot
// Milestone 60.2: Static WCET & [HardRealtime] Loop Bound Verifier
// =========================================================================
pub pkg Pilot.SelfHost.Perf.Wcet;

pub pure fn nameof(sym: str) -> str => sym;

pub enum WcetResultStatus {
    Pass,
    FailUnboundedLoop,
    FailWcetExceeded,
}

let WcetStatusId = [
    Pass: 0,
    FailUnboundedLoop: 1,
    FailWcetExceeded: 2,
];

pub enum LoopConstructKind {
    None,
    BoundedFor,
    UnboundedWhile,
}

let LoopKindId = [
    None: 0,
    BoundedFor: 1,
    UnboundedWhile: 2,
];

pub pure fn wcet_status_to_string(status: WcetResultStatus, cycles: i64, budget: i64) -> str {
    if status == WcetStatusId.FailUnboundedLoop {
        return "FAIL:UNBOUNDED_LOOP";
    }
    if status == WcetStatusId.FailWcetExceeded {
        return "FAIL:WCET_EXCEEDED";
    }
    return "PASS:" + cycles + "/" + budget;
}

pub pure fn detect_loop_kind(orig_kind: i64) -> LoopConstructKind {
    if orig_kind == 106 {
        return LoopKindId.UnboundedWhile;
    }
    if orig_kind == 204 {
        return LoopKindId.BoundedFor;
    }
    return LoopKindId.None;
}

pub fn verify_arena_wcet() -> str {
    let node_count = __engine("ast_node_count");
    
    // Check for unbounded while loop
    var i = 0;
    while i < node_count {
        let orig = __engine("ast_orig_kind", i);
        let lk = detect_loop_kind(orig);
        if lk == LoopKindId.UnboundedWhile {
            return wcet_status_to_string(WcetStatusId.FailUnboundedLoop, 0, 0);
        }
        i = i + 1;
    }

    // Search for [Wcet(budget)]
    var budget = 0;
    var j = 0;
    while j < node_count {
        let attr_cnt = __engine("ast_attr_decl_count", j);
        if attr_cnt > 0 {
            var ai = 0;
            while ai < attr_cnt {
                let name_sym = __engine("ast_attr_name", j, ai);
                let name = __engine("sym_str", name_sym);
                if name == "Wcet" {
                    budget = __engine("ast_attr_decl_arg", j, ai, 0);
                }
                ai = ai + 1;
            }
        }
        j = j + 1;
    }

    // If bounded for loop, count iterations and body cost
    var loop_bound = 1;
    var body_ops = 1;
    var found_loop = false;
    var m = 0;
    while m < node_count {
        let orig = __engine("ast_orig_kind", m);
        // NodeKind::ForExpr is 204
        if orig == 204 {
            found_loop = true;
            let cc = __engine("ast_child_count", m);
            if cc >= 2 {
                let iter_node = __engine("ast_child_at", m, 0);
                let body_node = __engine("ast_child_at", m, 1);
                // In binary range (RangeExpr == 220 or BinaryExpr == 19)
                let iter_orig = __engine("ast_orig_kind", iter_node);
                if iter_orig == 220 || __engine("ast_node_kind", iter_node) == 19 {
                    let rhs = __engine("ast_child_at", iter_node, 1);
                    if __engine("ast_node_kind", rhs) == 15 || __engine("ast_orig_kind", rhs) == 301 {
                        loop_bound = __engine("ast_node_raw_bits", rhs);
                    }
                }
                body_ops = __engine("ast_child_count", body_node) + 2;
            }
        }
        m = m + 1;
    }

    let cycles = if found_loop { loop_bound * body_ops } else { 10 };
    if budget > 0 && cycles > budget {
        return wcet_status_to_string(WcetStatusId.FailWcetExceeded, cycles, budget);
    }
    return wcet_status_to_string(WcetStatusId.Pass, cycles, budget);
}
