// ==============================================================================
// FILE: selfhost/pilotc.pilot
// Milestone 61.2 / F8: Self-Hosted Bootstrap Compiler Entry Points
// ==============================================================================
// `pilotc` is the compiler written in Pilot. Its pipeline (lex -> parse ->
// expand -> analyze -> lower to PilIR -> Perceus -> C11) does not exist yet:
// the analyzer arrives in F4, PilIR in F5, the C11 backend and process spawn
// in F6, ownership in F7, and the driver that builds compiler stages in F8.
// Until then both entry points stop at registered seams
// (`selfhost/gate/ledger/seams.pilot`), and the bootstrap parity gate reports
// that it stops at `bootstrap.stage_compile`.
// ==============================================================================
pub pkg Pilot.SelfHost.Pilotc;

/// Which compiler produced an artifact: the Rust seed (stage 1), the compiler
/// stage 1 built from `selfhost/` (stage 2), or the one stage 2 built from the
/// same sources (stage 3). Stage 2 and stage 3 must be byte-identical.
pub enum CompilerBootstrapStage : u8 {
    Seed,
    Stage2,
    Stage3,
}

pub pure fn pilotc_version_banner() -> str {
    return "pilotc (self-hosted compiler; pipeline not yet connected, see F4-F8)";
}

/// Compiles a whole Pilot program to standalone C11 source.
pub fn pilotc_compile_source_to_c11(pilot_src: str) -> str {
    return seam("pilotc.compile_c11",
        "no self-hosted pipeline lowers a Pilot program to C11 yet (analyzer F4, PilIR F5, C11 backend F6, driver F8)");
}

/// Builds the compiler of `stage` from the compiler sources `compiler_unit_src`
/// with the compiler of the previous stage, and returns the built artifact.
pub fn pilotc_bootstrap_stage_c11(stage: CompilerBootstrapStage, compiler_unit_src: str) -> str {
    return seam("bootstrap.stage_compile",
        "building a compiler stage from selfhost/ needs the real self-hosted driver and C11 backend (F8)");
}
