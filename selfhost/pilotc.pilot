// ==============================================================================
// FILE: selfhost/pilotc.pilot
// Entry points of `pilotc`, the compiler built from `selfhost/` sources.
// ==============================================================================
// The pieces of the pipeline exist in Pilot: the checker (selfhost/check/),
// lowering to typed PilIR (selfhost/ir/lower.pilot), Perceus
// (selfhost/ir/pass_perceus.pilot) and C11 output (`pilot build`,
// selfhost/cli/native_build.pilot through selfhost/transpile/c_family.pilot).
// What is missing is the driver that builds a compiler stage from the
// `selfhost/` sources with the previous stage. Both entry points here stop at
// registered seams (`selfhost/gate/ledger/seams.pilot`): `pilotc.compile_c11`
// and `bootstrap.stage_compile`; the bootstrap parity gate reports that it
// stops at `bootstrap.stage_compile`.
// Reached by the milestone01, milestone60 and milestone61 Rust tests; no
// `pilot` command calls these functions.
// ==============================================================================
pub pkg selfhost;

/// Which compiler produced an artifact: the Rust seed (stage 1), the compiler
/// stage 1 built from `selfhost/` (stage 2), or the one stage 2 built from the
/// same sources (stage 3). Stage 2 and stage 3 must be byte-identical.
pub enum CompilerBootstrapStage : u8 {
    Seed,
    Stage2,
    Stage3,
}

pub pure fn pilotc_version_banner() -> str {
    return "pilotc (self-hosted compiler; stage driver not built, see seam bootstrap.stage_compile)";
}

/// Compiles a whole Pilot program to standalone C11 source.
pub fn pilotc_compile_source_to_c11(pilot_src: str) -> str {
    return seam("pilotc.compile_c11",
        "pilotc is not connected to the checker, PilIR lowering and C11 emitter (selfhost/cli/native_build.pilot); the stage driver is missing (bootstrap.stage_compile)");
}

/// Builds the compiler of `stage` from the compiler sources `compiler_unit_src`
/// with the compiler of the previous stage, and returns the built artifact.
pub fn pilotc_bootstrap_stage_c11(stage: CompilerBootstrapStage, compiler_unit_src: str) -> str {
    return seam("bootstrap.stage_compile",
        "no driver builds a compiler stage from the selfhost/ sources with the previous stage");
}
