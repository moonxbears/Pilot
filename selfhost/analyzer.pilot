    }
};

pub fn str_contains(haystack: str, needle: str) -> bool {
    let hlen = haystack.len();
    let nlen = needle.len();
    if nlen == 0 { return true; }
    if hlen < nlen { return false; }
    var i = 0;
    while i + nlen <= hlen {
        if haystack.slice(i, i + nlen) == needle { return true; }
        i = i + 1;
    }
    return false;
}

pub fn is_suppressed(nid: i64, code: str, msg: str) -> bool {
    var cur = nid;
    var depth = 0;
    while cur >= 0 && cur < 100000 && depth < 50 {
        let ac = __engine(Cfg.ast.ast_attr_decl_count, cur);
        var idx = 0;
        while idx < ac {
            let asym = __engine(Cfg.ast.ast_attr_name, cur, idx);
            let anm = __engine(Cfg.ast.sym_str, asym);
            if anm == "Suppress" || anm == "Allow" || anm == "SuppressWarning" || anm == "SuppressMessage" || anm == "Diagnostics" {
                let argc = __engine(Cfg.ast.ast_attr_decl_arg_count, cur, idx);
                if argc == 0 { return true; }
                var ai = 0;
                while ai < argc {
                    let arg_sym = __engine(Cfg.ast.ast_attr_decl_arg, cur, idx, ai);
                    let arg_str = __engine(Cfg.ast.sym_str, arg_sym);
                    if arg_str == code || arg_str == "all" || arg_str == "*" { return true; }
                    if arg_str.len() > 0 && str_contains(msg, arg_str) { return true; }
                    ai = ai + 1;
                }
            }
            idx = idx + 1;
        }
        let p = __engine(Cfg.ast.ast_parent, cur);
        if p < 0 || p >= 100000 || p == cur { return false; }
        cur = p;
        depth = depth + 1;
    }
    return false;
}

pub fn emit_diag(nid: i64, sev: i64, msg: str) {
    var c = 0;
    let mlen = msg.len();
    while c < mlen && msg.byte_at(c) != 58 { c = c + 1; }
    let code = if c < mlen { msg.slice(0, c) } else { "" };
    if is_suppressed(nid, code, msg) { return; }
    __engine(Cfg.ast.ast_emit_diag, nid, sev, msg);
}

pub fn resolve_type_sym(type_sym: i64, node_count: i64) -> i64 {
    var j = 0;
    while j < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 && __engine(Cfg.ast.ast_node_sym, j) == type_sym {
            return infer_struct(j, node_count);
        }
        if k == 21 && __engine(Cfg.ast.ast_node_raw_bits, j) == type_sym {
            let ex = __engine(Cfg.ast.ast_get_bound_layout, j);
            if ex != 4294967295 { return ex; }
        }
        j = j + 1;
    }
    return __engine(Cfg.ast.layout_scalar, 64, 1, 0);
}

pub fn infer_struct(s_id: i64, node_count: i64) -> i64 {
    let existing = __engine(Cfg.ast.ast_get_bound_layout, s_id);
    if existing != 4294967295 {
        return existing;
    }

    let c_count = __engine(Cfg.ast.ast_child_count, s_id);
    let my_sym = __engine(Cfg.ast.ast_node_sym, s_id);
    var has_non_self_field = 0;
    var fscan = 0;
    while fscan < c_count {
        let fnid = __engine(Cfg.ast.ast_child_at, s_id, fscan);
        let fk = __engine(Cfg.ast.ast_node_kind, fnid);
        if fk == 21 || fk == 4 {
            let fts = __engine(Cfg.ast.ast_node_raw_bits, fnid);
            if fts != my_sym {
                has_non_self_field = 1;
            }
        }
        fscan = fscan + 1;
    }

    let decl_cnt = __engine(Cfg.ast.ast_attr_decl_count, s_id);
    if has_non_self_field == 0 && decl_cnt > 0 {
        var di = 0;
        var matched_decl = -1;
        while di < decl_cnt {
            let dargc = __engine(Cfg.ast.ast_attr_decl_arg_count, s_id, di);
            if dargc == 2 || dargc == 3 {
                matched_decl = di;
            }
            di = di + 1;
        }
        if matched_decl >= 0 {
            let dargc = __engine(Cfg.ast.ast_attr_decl_arg_count, s_id, matched_decl);
            let d0 = __engine(Cfg.ast.ast_attr_decl_arg, s_id, matched_decl, 0);
            let d1 = __engine(Cfg.ast.ast_attr_decl_arg, s_id, matched_decl, 1);
            var dbank = d1;
            var dlanes = 1;
            if dargc == 3 {
                dlanes = d1;
                dbank = __engine(Cfg.ast.ast_attr_decl_arg, s_id, matched_decl, 2);
            }
            var ds_lid = 0;
            if dbank == 6 {
                ds_lid = __engine(Cfg.ast.layout_ptr, 0, 1, 0);
            } else {
                ds_lid = __engine(Cfg.ast.layout_scalar, d0, dlanes, dbank);
            }
            __engine(Cfg.ast.ast_bind_layout, s_id, ds_lid);
            return ds_lid;
        }
    } else if has_non_self_field == 0 {
        let attr_cnt = __engine(Cfg.ast.ast_attr_count, s_id);
        if attr_cnt >= 2 {
            let arg0 = __engine(Cfg.ast.ast_attr_arg, s_id, 0);
            let arg1 = __engine(Cfg.ast.ast_attr_arg, s_id, 1);
            var bank = arg1;
            var lanes = 1;
            if attr_cnt >= 3 {
                lanes = arg1;
                bank = __engine(Cfg.ast.ast_attr_arg, s_id, 2);
            }
            var s_lid = 0;
            if bank == 6 {
                s_lid = __engine(Cfg.ast.layout_ptr, 0, 1, 0);
            } else {
                s_lid = __engine(Cfg.ast.layout_scalar, arg0, lanes, bank);
            }
            __engine(Cfg.ast.ast_bind_layout, s_id, s_lid);
            return s_lid;
        }
    }

    if c_count == 0 {
        let empty_lid = __engine(Cfg.ast.layout_scalar, 8, 1, 0);
        __engine(Cfg.ast.ast_bind_layout, s_id, empty_lid);
        return empty_lid;
    }

    // Self-Referential / Recursive Struct Guard
    var fi_chk = 0;
    while fi_chk < c_count {
        let f_chk_node = __engine(Cfg.ast.ast_child_at, s_id, fi_chk);
        let f_chk_sym = __engine(Cfg.ast.ast_node_raw_bits, f_chk_node);
        if f_chk_sym == my_sym {
            let rec_lid = __engine(Cfg.ast.layout_scalar, 64, 1, 0);
            __engine(Cfg.ast.ast_bind_layout, s_id, rec_lid);
            return rec_lid;
        }
        fi_chk = fi_chk + 1;
    }

    var num_fields = 0;
    var f0 = 0;
    var f1 = 0;
    var f2 = 0;
    var f3 = 0;
    var f4 = 0;
    var f5 = 0;

    var fi = 0;
    while fi < c_count {
        let f_node = __engine(Cfg.ast.ast_child_at, s_id, fi);
        let f_kind = __engine(Cfg.ast.ast_node_kind, f_node);
        if f_kind == 21 || f_kind == 4 {
            let f_ty_sym = __engine(Cfg.ast.ast_node_raw_bits, f_node);
            let f_lid = resolve_type_sym(f_ty_sym, node_count);
            __engine(Cfg.ast.ast_bind_layout, f_node, f_lid);
            if num_fields == 0 { f0 = f_lid; }
            if num_fields == 1 { f1 = f_lid; }
            if num_fields == 2 { f2 = f_lid; }
            if num_fields == 3 { f3 = f_lid; }
            if num_fields == 4 { f4 = f_lid; }
            if num_fields == 5 { f5 = f_lid; }
            num_fields = num_fields + 1;
        }
        fi = fi + 1;
    }

    var agg_lid = 0;
    if num_fields == 0 { agg_lid = __engine(Cfg.ast.layout_scalar, 8, 1, 0); }
    else if num_fields == 1 { agg_lid = __engine(Cfg.ast.layout_aggregate, f0); }
    else if num_fields == 2 { agg_lid = __engine(Cfg.ast.layout_aggregate, f0, f1); }
    else if num_fields == 3 { agg_lid = __engine(Cfg.ast.layout_aggregate, f0, f1, f2); }
    else if num_fields == 4 { agg_lid = __engine(Cfg.ast.layout_aggregate, f0, f1, f2, f3); }
    else if num_fields == 5 { agg_lid = __engine(Cfg.ast.layout_aggregate, f0, f1, f2, f3, f4); }
    else { agg_lid = __engine(Cfg.ast.layout_aggregate, f0, f1, f2, f3, f4, f5); }
    __engine(Cfg.ast.ast_bind_layout, s_id, agg_lid);
    return agg_lid;
}

pub fn resolve_lit_layout(lit_kind: i64, node_count: i64) -> i64 {
    // 1. Check for StructDecl with matching 1-arg attribute (e.g. [DefaultLit(1)])
    var j = 0;
    while j < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 {
            let attr_cnt = __engine(Cfg.ast.ast_attr_count, j);
            if attr_cnt == 1 {
                let a0 = __engine(Cfg.ast.ast_attr_arg, j, 0);
                if a0 == lit_kind {
                    let s_lid = __engine(Cfg.ast.ast_get_bound_layout, j);
                    if s_lid != 4294967295 {
                        return s_lid;
                    }
                }
            }
        }
        j = j + 1;
    }

    // 2. Check for StructDecl with matching physical geometry (1-byte scalar for bool, 8-byte scalar for int/float)
    j = 0;
    while j < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 {
            let attr_cnt = __engine(Cfg.ast.ast_attr_count, j);
            if attr_cnt >= 2 {
                let s_lid = __engine(Cfg.ast.ast_get_bound_layout, j);
                if s_lid != 4294967295 {
                    let sz = __engine(Cfg.ast.layout_metrics, s_lid);
                    let bank = if attr_cnt >= 3 { __engine(Cfg.ast.ast_attr_arg, j, 2) } else { __engine(Cfg.ast.ast_attr_arg, j, 1) };
                    if lit_kind == 4 && sz == 1 { return s_lid; }
                    else if lit_kind == 1 && sz == 8 && bank != 1 && bank != 6 { return s_lid; }
                    else if lit_kind == 2 && sz == 8 && bank == 1 { return s_lid; }
                }
            }
        }
        j = j + 1;
    }

    // 3. Reuse previously bound literal of same lit_kind in this AST
    j = 0;
    while j < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 15 {
            let lk = __engine(Cfg.ast.ast_node_lit_kind, j);
            if lk == lit_kind {
                let ex = __engine(Cfg.ast.ast_get_bound_layout, j);
                if ex != 4294967295 {
                    return ex;
                }
            }
        }
        j = j + 1;
    }

    // 4. Register on demand when a literal of this kind is actually encountered
    if lit_kind == 4 {
        let b_lid = __engine(Cfg.ast.layout_hw_header, 1);
        return b_lid;
    }
    if lit_kind == 2 {
        let f_lid = __engine(Cfg.ast.layout_hw_header, 13);
        return f_lid;
    }
    let i_lid = __engine(Cfg.ast.layout_hw_header, 10);
    return i_lid;
}

pub fn infer_member_expr(i: i64, node_count: i64) -> i64 {
    let c_count = __engine(Cfg.ast.ast_child_count, i);
    if c_count == 0 {
        return 0;
    }
    let recv_id = __engine(Cfg.ast.ast_child_at, i, 0);
    let recv_lid = __engine(Cfg.ast.ast_get_bound_layout, recv_id);
    if recv_lid == 4294967295 {
        return 0;
    }
    let field_sym = __engine(Cfg.ast.ast_node_sym, i);
    var s_id = 0;
    while s_id < node_count {
        let sk = __engine(Cfg.ast.ast_node_kind, s_id);
        if sk == 1 {
            let s_lid = __engine(Cfg.ast.ast_get_bound_layout, s_id);
            if s_lid == recv_lid {
                let f_cnt = __engine(Cfg.ast.ast_child_count, s_id);
                var f_idx = 0;
                while f_idx < f_cnt {
                    let f_node = __engine(Cfg.ast.ast_child_at, s_id, f_idx);
                    let f_sym = __engine(Cfg.ast.ast_node_sym, f_node);
                    if f_sym == field_sym {
                        let offset = __engine(Cfg.ast.layout_field_offset, recv_lid, f_idx);
                        let f_lid = __engine(Cfg.ast.ast_get_bound_layout, f_node);
                        __engine(Cfg.ast.ast_bind_layout, i, f_lid);
                        return f_lid;
                    }
                    f_idx = f_idx + 1;
                }
            }
        }
        s_id = s_id + 1;
    }
    return 0;
}

pub fn check_div_by_zero(i: i64, op: i64, c_count: i64) -> i64 {
    if op >= 4 && op <= 6 && c_count >= 2 {
        let rhs_id = __engine(Cfg.ast.ast_child_at, i, 1);
        if __engine(Cfg.ast.ast_node_kind, rhs_id) == 15 && __engine(Cfg.ast.ast_node_lit_kind, rhs_id) == 1 && __engine(Cfg.ast.ast_node_raw_bits, rhs_id) == 0 {
            emit_diag(i, 1, "DIV001: Compile-time division by zero detected");
        }
    }
    return 0;
}

pub fn infer_call_expr(i: i64, node_count: i64) -> i64 {
    let c_count = __engine(Cfg.ast.ast_child_count, i);
    if c_count > 0 {
        let callee_id = __engine(Cfg.ast.ast_child_at, i, 0);
        let callee_sym = __engine(Cfg.ast.ast_node_sym, callee_id);
        var j = 0;
        var found = 0;
        while j < node_count {
            if found == 0 {
                let jk = __engine(Cfg.ast.ast_node_kind, j);
                if jk == 1 || jk == 3 {
                    let js = __engine(Cfg.ast.ast_node_sym, j);
                    if js == callee_sym {
                        __engine(Cfg.ast.ast_bind_target, i, j);
                        __engine(Cfg.ast.ast_bind_target, callee_id, j);
                        let decl_lid = __engine(Cfg.ast.ast_get_bound_layout, j);
                        if decl_lid != 4294967295 {
                            __engine(Cfg.ast.ast_bind_layout, i, decl_lid);
                        }
                        found = 1;
                    }
                }
            }
            j = j + 1;
        }
    }
    return 0;
}

pub fn infer_binary_expr(i: i64, node_count: i64) -> i64 {
    let c_count = __engine(Cfg.ast.ast_child_count, i);
    if c_count > 0 {
        let op = __engine(Cfg.ast.ast_node_raw_bits, i);
        check_div_by_zero(i, op, c_count);
        if op >= 8 {
            if op <= 17 {
                let b_lid = resolve_lit_layout(4, node_count);
                __engine(Cfg.ast.ast_bind_layout, i, b_lid);
                return b_lid;
            }
        }
        let lhs_id = __engine(Cfg.ast.ast_child_at, i, 0);
        let lhs_lid = __engine(Cfg.ast.ast_get_bound_layout, lhs_id);
        if lhs_lid != 4294967295 {
            __engine(Cfg.ast.ast_bind_layout, i, lhs_lid);
            return lhs_lid;
        }
    }
    return 0;
}

pub fn infer_node(i: i64, node_count: i64) -> i64 {
    let kind = __engine(Cfg.ast.ast_node_kind, i);

    if kind == 15 {
        let lit_kind = __engine(Cfg.ast.ast_node_lit_kind, i);
        let lit_lid = resolve_lit_layout(lit_kind, node_count);
        __engine(Cfg.ast.ast_bind_layout, i, lit_lid);
        return lit_lid;
    }

    if kind == 14 {
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        var j = i - 1;
        var found = 0;
        while j >= 0 && found == 0 {
            let jk = __engine(Cfg.ast.ast_node_kind, j);
            if jk == 4 || jk == 21 {
                let js = __engine(Cfg.ast.ast_node_sym, j);
                if js == sym {
                    __engine(Cfg.ast.ast_bind_target, i, j);
                    let target_lid = __engine(Cfg.ast.ast_get_bound_layout, j);
                    if target_lid != 4294967295 {
                        __engine(Cfg.ast.ast_bind_layout, i, target_lid);
                    }
                    found = 1;
                }
            }
            j = j - 1;
        }
        return found;
    }

    if kind == 4 {
        let ann_sym = __engine(Cfg.ast.ast_node_raw_bits, i);
        if ann_sym > 0 {
            let ann_lid = resolve_type_sym(ann_sym, node_count);
            __engine(Cfg.ast.ast_bind_layout, i, ann_lid);
            var sj = 0;
            while sj < node_count {
                if __engine(Cfg.ast.ast_node_kind, sj) == 1 && __engine(Cfg.ast.ast_node_sym, sj) == ann_sym {
                    __engine(Cfg.ast.ast_bind_target, i, sj);
                }
                sj = sj + 1;
            }
            return ann_lid;
        }
        let c_count = __engine(Cfg.ast.ast_child_count, i);
        if c_count > 0 {
            let rhs_id = __engine(Cfg.ast.ast_child_at, i, 0);
            let rhs_lid = __engine(Cfg.ast.ast_get_bound_layout, rhs_id);
            let rhs_tid = __engine(Cfg.ast.ast_get_bound_target, rhs_id);
            if rhs_tid != 4294967295 && rhs_tid >= 0 {
                __engine(Cfg.ast.ast_bind_target, i, rhs_tid);
            } else if rhs_lid != 4294967295 {
                var sj = 0;
                while sj < node_count {
                    if __engine(Cfg.ast.ast_node_kind, sj) == 1 && __engine(Cfg.ast.ast_get_bound_layout, sj) == rhs_lid {
                        __engine(Cfg.ast.ast_bind_target, i, sj);
                    }
                    sj = sj + 1;
                }
            }
            if rhs_lid != 4294967295 {
                __engine(Cfg.ast.ast_bind_layout, i, rhs_lid);
                return rhs_lid;
            }
        }
        return 0;
    }

    if kind == 16 { return infer_call_expr(i, node_count); }
    if kind == 17 { return infer_member_expr(i, node_count); }
    if kind == 19 { return infer_binary_expr(i, node_count); }

    if (kind == 8 || kind == 9) && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let val_lid = __engine(Cfg.ast.ast_get_bound_layout, __engine(Cfg.ast.ast_child_at, i, 0));
        if val_lid != 4294967295 {
            __engine(Cfg.ast.ast_bind_layout, i, val_lid);
            return val_lid;
        }
        return 0;
    }

    if (kind == 7 || kind == 18) && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let last_lid = __engine(Cfg.ast.ast_get_bound_layout, __engine(Cfg.ast.ast_child_at, i, __engine(Cfg.ast.ast_child_count, i) - 1));
        if last_lid != 4294967295 {
            __engine(Cfg.ast.ast_bind_layout, i, last_lid);
            return last_lid;
        }
        return 0;
    }

    if kind == 6 {
        let c_count = __engine(Cfg.ast.ast_child_count, i);
        if c_count >= 2 {
            let then_id = __engine(Cfg.ast.ast_child_at, i, 1);
            let then_lid = __engine(Cfg.ast.ast_get_bound_layout, then_id);
            if c_count >= 3 {
                let else_id = __engine(Cfg.ast.ast_child_at, i, 2);
                let else_lid = __engine(Cfg.ast.ast_get_bound_layout, else_id);
                if then_lid != 4294967295 && else_lid != 4294967295 && then_lid != else_lid {
                    let u_lid = __engine(Cfg.ast.layout_union, 8, then_lid, else_lid);
                    __engine(Cfg.ast.ast_bind_layout, i, u_lid);
                    return u_lid;
                }
            }
            if then_lid != 4294967295 {
                __engine(Cfg.ast.ast_bind_layout, i, then_lid);
                return then_lid;
            }
        }
        return 0;
    }

    if kind == 3 {
        let c_count = __engine(Cfg.ast.ast_child_count, i);
        if c_count > 0 {
            let body_id = __engine(Cfg.ast.ast_child_at, i, 0);
            let body_lid = __engine(Cfg.ast.ast_get_bound_layout, body_id);
            if body_lid != 4294967295 {
                __engine(Cfg.ast.ast_bind_layout, i, body_lid);
                return body_lid;
            }
        }
        return 0;
    }

    return 0;
}

pub fn verify_capability_transition(src_cap: i64, dst_cap: i64) -> bool {
    if src_cap == dst_cap { return true; }
    if src_cap == 0 { return dst_cap == 1; }
    if src_cap == 4 { return dst_cap == 1 || dst_cap == 5; }
    if src_cap == 5 { return dst_cap == 1; }
    return false;
}

pub fn compute_field_projection_offset(agg_lid: i64, field_idx: i64) -> i64 {
    return __engine(Cfg.ast.layout_field_offset, agg_lid, field_idx);
}

pub fn compute_soa_projection(elem_lid: i64, ptr_bits: i64) -> i64 {
    // Target-pointer-width-aware SOA column slice (`{ ptr<TField>, usize }` -> 8B on 32-bit, 16B on 64-bit)
    let w = if ptr_bits > 0 { ptr_bits } else { 64 };
    let elem_metrics = __engine(Cfg.ast.layout_metrics, elem_lid);
    var ptr_word_lid = 0;
    if w == 64 && elem_metrics >= 0 {
        ptr_word_lid = __engine(Cfg.ast.layout_ptr, elem_lid, 1, 0);
    } else {
        ptr_word_lid = __engine(Cfg.ast.layout_scalar, w, 1, 0);
    }
    let len_word_lid = __engine(Cfg.ast.layout_scalar, w, 1, 0);
    let soa_slice_lid = __engine(Cfg.ast.layout_aggregate, ptr_word_lid, len_word_lid);
    return soa_slice_lid;
}

pub fn is_lowercase_lang_ident(s: str) -> bool {
    let slen = __engine(Cfg.ast.str_len, s);
    if slen <= 0 {
        return false;
    }
    var idx = 0;
    while idx < slen {
        let ch = __engine(Cfg.ast.str_byte_at, s, idx);
        let is_lower = ch >= 97 && ch <= 122;
        let is_digit = ch >= 48 && ch <= 57;
        let is_under = ch == 95;
        if !is_lower && !is_digit && !is_under {
            return false;
        }
        idx = idx + 1;
    }
    return true;
}

pub fn str_ends_with_bytes(s: str, suffix: str) -> bool {
    let slen = __engine(Cfg.ast.str_len, s);
    let suflen = __engine(Cfg.ast.str_len, suffix);
    if suflen > slen {
        return false;
    }
    let base = slen - suflen;
    var k = 0;
    while k < suflen {
        let a = __engine(Cfg.ast.str_byte_at, s, base + k);
        let b = __engine(Cfg.ast.str_byte_at, suffix, k);
        if a != b {
            return false;
        }
        k = k + 1;
    }
    return true;
}

pub fn has_attr_named(nid: i64, target: str) -> bool {
    let ac = __engine(Cfg.ast.ast_attr_decl_count, nid);
    var idx = 0;
    while idx < ac {
        let asym = __engine(Cfg.ast.ast_attr_name, nid, idx);
        let anm = __engine(Cfg.ast.sym_str, asym);
        if anm == target {
            return true;
        }
        idx = idx + 1;
    }
    return false;
}

pub fn verify_decl_contracts(nid: i64, enforce_naming: bool) -> i64 {
    let kind = __engine(Cfg.ast.ast_node_kind, nid);
    if kind != 1 {
        if kind != 2 {
            return 0;
        }
    }
    let sym = __engine(Cfg.ast.ast_node_sym, nid);
    let name = __engine(Cfg.ast.sym_str, sym);
    let nlen = __engine(Cfg.ast.str_len, name);
    if nlen == 0 {
        return 0;
    }
    let c0 = __engine(Cfg.ast.str_byte_at, name, 0);
    if c0 == 36 {
        return 0;
    }

    let dflags = __engine(Cfg.ast.ast_decl_flags, nid);
    let is_partial = (dflags & 16) != 0;
    let has_dtor = (dflags & 1024) != 0;
    let is_lang = has_attr_named(nid, "Lang");

    if kind == 2 {
        if enforce_naming && (c0 != 73 || nlen < 2 || __engine(Cfg.ast.str_byte_at, name, 1) < 65 || __engine(Cfg.ast.str_byte_at, name, 1) > 90) {
            emit_diag(nid, 1, "EnforceCoreNaming: [InterfacePrefix] Interface '" + name + "' must begin with 'I' + PascalCase");
        }
        return 0;
    }

    let bc = __engine(Cfg.ast.ast_base_count, nid);
    var has_ivalue = false;
    var has_iref = false;
    var has_iobj = false;
    var has_iguard = false;
    var has_iattr = false;
    var bi = 0;
    while bi < bc {
        let bsym = __engine(Cfg.ast.ast_base_at, nid, bi);
        let bnm = __engine(Cfg.ast.sym_str, bsym);
        if bnm == "IValue" { has_ivalue = true; }
        if bnm == "IReference" { has_iref = true; }
        if bnm == "IObject" { has_iobj = true; }
        if bnm == "IGuard" { has_iguard = true; }
        if bnm == "IAttribute" || bnm == "IInheritedAttribute" || bnm == "IInterceptor" || bnm == "IEcsRule" || str_ends_with_bytes(bnm, "Attribute") {
            has_iattr = true;
        }
        bi = bi + 1;
    }

    if has_ivalue && has_dtor {
        emit_diag(nid, 1, "LatticeContractMismatch: struct '" + name + "' declared ': IValue' (0b00), but declares ~self() destructor (0b10)");
    }

    if enforce_naming && !is_partial {
        if is_lang {
            if !is_lowercase_lang_ident(name) { emit_diag(nid, 1, "EnforceCoreNaming: [LangPrimitiveLowercase] [Lang] primitive struct '" + name + "' must be lowercase"); }
        } else {
            var prefix_violation = false;
            if c0 < 65 || c0 > 90 {
                emit_diag(nid, 1, "EnforceCoreNaming: [StructPascalCase] Core struct '" + name + "' must be PascalCase");
                prefix_violation = true;
            } else if c0 == 73 && nlen >= 2 {
                let sc1 = __engine(Cfg.ast.str_byte_at, name, 1);
                if sc1 >= 65 && sc1 <= 90 {
                    emit_diag(nid, 1, "EnforceCoreNaming: [ReservedInterfacePrefix] Struct '" + name + "' cannot begin with reserved interface prefix 'I' + uppercase");
                    prefix_violation = true;
                }
            }
            if !prefix_violation {
                if has_iattr {
                    if !str_ends_with_bytes(name, "Attr") { emit_diag(nid, 1, "EnforceCoreNaming: [AttributeSuffix] Attribute struct '" + name + "' must end with 'Attr'"); }
                } else if has_iguard || (has_iref && has_iobj) {
                    if !str_ends_with_bytes(name, "Guard") && !str_ends_with_bytes(name, "Scope") && !str_ends_with_bytes(name, "Lease") {
                        emit_diag(nid, 1, "EnforceCoreNaming: [ScopedGuardSuffix] IGuard struct '" + name + "' must end with 'Guard', 'Scope', or 'Lease'");
                    }
                } else if has_iref {
                    if !str_ends_with_bytes(name, "View") && !str_ends_with_bytes(name, "Lens") && !str_ends_with_bytes(name, "Cursor") && !str_ends_with_bytes(name, "Enumerator") {
                        emit_diag(nid, 1, "EnforceCoreNaming: [ReferenceViewSuffix] IReference struct '" + name + "' must end with 'View', 'Lens', 'Cursor', or 'Enumerator'");
                    }
                }
            }
        }
    }
    return 0;
}

pub fn is_kw_contextual_ident(name: str) -> bool {
    if name == "self" || name == "field" || name == "value" || name == "type" || name == "unit" { return true; }
    if name == "nameof" || name == "__engine" || name == "op" || name == "pkg" || name == "state" { return true; }
    if name == "get" || name == "set" || name == "open" || name == "role" || name == "route" { return true; }
    if name == "connect" || name == "exit" || name == "delete" || name == "values" || name == "update" { return true; }
    if name == "from" || name == "where" || name == "select" || name == "insert" || name == "order" { return true; }
    if name == "context" || name == "quote" || name == "partial" || name == "blueprint" || name == "cue" { return true; }
    return false;
}

pub fn is_in_pipe_delimited(kw_buf: str, target: str) -> bool {
    let tlen = target.len();
    if tlen == 0 {
        return false;
    }
    let blen = kw_buf.len();
    var start = 0;
    var i = 0;
    while i <= blen {
        if i == blen || kw_buf.byte_at(i) == 124 || kw_buf.byte_at(i) == 44 {
            let seg_len = i - start;
            if seg_len == tlen {
                if kw_buf.slice(start, i) == target {
                    return true;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return false;
}

pub fn build_dynamic_keyword_set(node_count: i64) -> str {
    var kw_buf = "|__engine|struct|interface|fn|let|ref|if|loop|return|yield|defer|comptime|quote|asm|";
    kw_buf = kw_buf + "else|while|until|for|in|then|break|continue|guard|switch|case|default|try|catch|var|const|enum|actor|state|type|pub|priv|prot|pkg|int|file|open|export|lvl|pure|static|iso|partial|ext|scope|enter|exit|requires|ensures|old|context|adapter|each|coalesce|with|without|as|async|await|spawn|atomic|sync|isolate|select|timeout|bounded|noalloc|region|deadline|within|periodic|priority|jitter|database|transaction|commit|rollback|savepoint|connect|from|where|order|ascending|descending|insert|into|values|update|delete|extern|assembly|module|lib|sizeof|alignof|offsetof|fields_of|nameof|assert|blueprint|cue|role|route|unit|syntax|use|op|";

    // 1. Dynamic registry queries across standard keyword categories (0..=16)
    var cat = 0;
    while cat <= 16 {
        let live = __engine(Cfg.ast.query_registered_symbols, cat);
        if live.len() > 0 {
            kw_buf = kw_buf + live + "|";
        }
        cat = cat + 1;
    }

    // 2. Dynamic registry queries across user/DSL categories (100..=255)
    cat = 100;
    while cat <= 255 {
        let live = __engine(Cfg.ast.query_registered_symbols, cat);
        if live.len() > 0 {
            kw_buf = kw_buf + live + "|";
        }
        cat = cat + 1;
    }

    // 3. Scan AST nodes for any in-unit KeywordDef / KeywordDefAttr declarations
    var i = 0;
    while i < node_count {
        if has_attr_named(i, "KeywordDef") || has_attr_named(i, "KeywordDefAttr") {
            let sym = __engine(Cfg.ast.ast_node_sym, i);
            if sym != 0 {
                let w = __engine(Cfg.ast.sym_str, sym);
                if w.len() > 0 {
                    kw_buf = kw_buf + w + "|";
                }
            }
        }
        i = i + 1;
    }

    return kw_buf;
}

pub fn verify_ident_not_keyword(nid: i64, kw_set: str) -> i64 {
    let kind = __engine(Cfg.ast.ast_node_kind, nid);
    let okind = __engine(Cfg.ast.ast_orig_kind, nid);

    // Only inspect identifier declarations:
    // kind 1 (StructDecl), kind 2 (InterfaceDecl), kind 3 (FnDecl),
    // kind 4 (LetStmt, VarStmt, ConstDecl), kind 21 (ParamDecl, struct field),
    // kind 255 (TypeAdtDecl okind=5, AdtVariant okind=6, PatBind okind=501)
    var is_decl = false;
    if kind == 1 || kind == 2 || kind == 3 || kind == 4 || kind == 21 {
        is_decl = true;
    } else if kind == 255 {
        if okind == 5 || okind == 6 || okind == 501 {
            is_decl = true;
        }
    }
    if !is_decl {
        return 0;
    }

    // Skip definitions of keywords or language primitives themselves
    if has_attr_named(nid, "KeywordDef") || has_attr_named(nid, "KeywordDefAttr")
        || has_attr_named(nid, "KeywordCategoryDef") || has_attr_named(nid, "KeywordCategoryDefAttr")
        || has_attr_named(nid, "Lang") || has_attr_named(nid, "LangPrimitive") {
        return 0;
    }

    let sym = __engine(Cfg.ast.ast_node_sym, nid);
    if sym == 0 {
        return 0;
    }
    let name = __engine(Cfg.ast.sym_str, sym);
    let nlen = name.len();
    if nlen == 0 {
        return 0;
    }

    // Skip syntax quote placeholders ($ident)
    let c0 = name.byte_at(0);
    if c0 == 36 {
        return 0;
    }

    // Skip contextual identifiers and built-in hooks
    if is_kw_contextual_ident(name) {
        return 0;
    }

    // Check if name is in the dynamic keyword set
    if is_in_pipe_delimited(kw_set, name) {
        emit_diag(nid, 1, "KW001: Identifier '" + name + "' is a keyword and cannot be used as an identifier name");
        return 1;
    }

    return 0;
}

pub fn is_type_name_or_sym_optional(sym: i64, name: str, node_count: i64) -> bool {
    let nlen = name.len();
    if nlen > 0 && name.byte_at(nlen - 1) == 63 { return true; }
    if nlen == 6 && name.byte_at(0) == 111 && name.byte_at(1) == 112 && name.byte_at(2) == 116 && name.byte_at(3) == 105 && name.byte_at(4) == 111 && name.byte_at(5) == 110 { return true; }
    return false;
}

pub fn is_type_fallible(sym: i64, name: str, node_count: i64) -> bool {
    let nlen = name.len();
    var idx = 0;
    while idx < nlen {
        if name.byte_at(idx) == 33 { return true; }
        idx = idx + 1;
    }
    if nlen == 6 && name.byte_at(0) == 114 && name.byte_at(1) == 101 && name.byte_at(2) == 115 && name.byte_at(3) == 117 && name.byte_at(4) == 108 && name.byte_at(5) == 116 { return true; }
    return false;
}

pub fn verify_null_safety(i: i64, node_count: i64) -> i64 {
    let ok = __engine(Cfg.ast.ast_orig_kind, i);

    if ok == 104 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        if cc >= 2 {
            let eb = __engine(Cfg.ast.ast_child_at, i, 1);
            let eb_cc = __engine(Cfg.ast.ast_child_count, eb);
            var eb_diverges = false;
            var si = 0;
            while si < eb_cc {
                let stmt = __engine(Cfg.ast.ast_child_at, eb, si);
                let s_ok = __engine(Cfg.ast.ast_orig_kind, stmt);
                if s_ok == 103 || s_ok == 107 || s_ok == 108 || s_ok == 109 {
                    eb_diverges = true;
                } else if s_ok == 110 {
                    let e_cc = __engine(Cfg.ast.ast_child_count, stmt);
                    if e_cc > 0 {
                        let expr = __engine(Cfg.ast.ast_child_at, stmt, 0);
                        let e_ok = __engine(Cfg.ast.ast_orig_kind, expr);
                        if e_ok == 207 {
                            let c_cc = __engine(Cfg.ast.ast_child_count, expr);
                            if c_cc > 0 {
                                let callee = __engine(Cfg.ast.ast_child_at, expr, 0);
                                let csym = __engine(Cfg.ast.ast_node_sym, callee);
                                if csym != 0 {
                                    let cname = __engine(Cfg.ast.sym_str, csym);
                                    if cname == "panic" || cname == "fail" {
                                        eb_diverges = true;
                                    }
                                }
                            }
                        }
                    }
                }
                si = si + 1;
            }
            if !eb_diverges {
                emit_diag(eb, 1, "NULL002: 'guard' else block must diverge with 'return', 'break', 'continue', 'yield', or 'panic'");
                return 1;
            }
        }
    }

    if ok == 100 || ok == 101 {
        let ann_sym = __engine(Cfg.ast.ast_node_raw_bits, i);
        if ann_sym > 0 {
            let ann_name = __engine(Cfg.ast.sym_str, ann_sym);
            if !is_type_name_or_sym_optional(ann_sym, ann_name, node_count) {
                let cc = __engine(Cfg.ast.ast_child_count, i);
                if cc > 0 {
                    let init_node = __engine(Cfg.ast.ast_child_at, i, 0);
                    let init_ok = __engine(Cfg.ast.ast_orig_kind, init_node);
                    if init_ok == 305 {
                        emit_diag(i, 1, "NULL001: Cannot assign 'none' to non-nullable type '" + ann_name + "'");
                        return 1;
                    }
                }
            }
        }
    }

    if ok == 102 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        if cc >= 2 {
            let rhs = __engine(Cfg.ast.ast_child_at, i, 1);
            let rhs_ok = __engine(Cfg.ast.ast_orig_kind, rhs);
            if rhs_ok == 305 {
                let lhs = __engine(Cfg.ast.ast_child_at, i, 0);
                let lhs_tid = __engine(Cfg.ast.ast_get_bound_target, lhs);
                var is_opt = false;
                if lhs_tid != 4294967295 && lhs_tid >= 0 {
                    let t_sym = __engine(Cfg.ast.ast_node_raw_bits, lhs_tid);
                    if t_sym > 0 {
                        let t_name = __engine(Cfg.ast.sym_str, t_sym);
                        is_opt = is_type_name_or_sym_optional(t_sym, t_name, node_count);
                    }
                }
                if !is_opt {
                    emit_diag(i, 1, "NULL001: Cannot assign 'none' to non-nullable variable");
                    return 1;
                }
            }
        }
    }

    if ok == 103 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        if cc > 0 {
            let ret_val = __engine(Cfg.ast.ast_child_at, i, 0);
            let val_ok = __engine(Cfg.ast.ast_orig_kind, ret_val);
            if val_ok == 305 {
                var cur = i;
                var enc_fn = -1;
                var depth = 0;
                while cur != 4294967295 && cur >= 0 && depth < 30 {
                    depth = depth + 1;
                    let pk = __engine(Cfg.ast.ast_node_kind, cur);
                    if pk == 3 {
                        enc_fn = cur;
                        cur = -1;
                    } else {
                        cur = __engine(Cfg.ast.ast_parent, cur);
                    }
                }
                if enc_fn >= 0 {
                    let ret_ty_sym = __engine(Cfg.ast.ast_node_raw_bits, enc_fn);
                    if ret_ty_sym > 0 {
                        let rname = __engine(Cfg.ast.sym_str, ret_ty_sym);
                        if !is_type_name_or_sym_optional(ret_ty_sym, rname, node_count) {
                            emit_diag(i, 1, "NULL003: Cannot return 'none' from function with non-nullable return type '" + rname + "'");
                            return 1;
                        }
                    }
                }
            }
        }
    }

    if ok == 207 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        if cc > 1 {
            let target_fn = __engine(Cfg.ast.ast_get_bound_target, i);
            if target_fn != 4294967295 && target_fn >= 0 {
                let p_cnt = __engine(Cfg.ast.ast_child_count, target_fn);
                var ai = 1;
                while ai < cc {
                    let arg = __engine(Cfg.ast.ast_child_at, i, ai);
                    let a_ok = __engine(Cfg.ast.ast_orig_kind, arg);
                    if a_ok == 305 {
                        if ai < p_cnt {
                            let param_node = __engine(Cfg.ast.ast_child_at, target_fn, ai);
                            let psym = __engine(Cfg.ast.ast_node_raw_bits, param_node);
                            if psym > 0 {
                                let pname = __engine(Cfg.ast.sym_str, psym);
                                if !is_type_name_or_sym_optional(psym, pname, node_count) {
                                    emit_diag(arg, 1, "NULL004: Cannot pass 'none' to non-nullable parameter '" + pname + "'");
                                    return 1;
                                }
                            }
                        }
                    }
                    ai = ai + 1;
                }
            }
        }
    }

    if (ok == 209 || ok == 210) && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let recv = __engine(Cfg.ast.ast_child_at, i, 0);
        if __engine(Cfg.ast.ast_orig_kind, recv) != 213 {
            let recv_tid = __engine(Cfg.ast.ast_get_bound_target, recv);
            if recv_tid != 4294967295 && recv_tid >= 0 {
                let t_sym = __engine(Cfg.ast.ast_node_raw_bits, recv_tid);
                if t_sym > 0 && is_type_name_or_sym_optional(t_sym, __engine(Cfg.ast.sym_str, t_sym), node_count) {
                    if ok == 209 {
                        emit_diag(i, 1, "NULL002: Member access on optional type requires '?.' safe navigation or unwrapping");
                    } else {
                        emit_diag(i, 1, "NULL005: Index access on optional type requires safe navigation or unwrapping");
                    }
                    return 1;
                }
            }
        }
    }

    return 0;
}

pub fn verify_error_flow(i: i64, node_count: i64) -> i64 {
    let ok = __engine(Cfg.ast.ast_orig_kind, i);

    if ok == 110 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        if cc > 0 {
            let expr = __engine(Cfg.ast.ast_child_at, i, 0);
            let e_ok = __engine(Cfg.ast.ast_orig_kind, expr);
            if e_ok == 207 {
                let target_fn = __engine(Cfg.ast.ast_get_bound_target, expr);
                if target_fn != 4294967295 && target_fn >= 0 {
                    let ret_sym = __engine(Cfg.ast.ast_node_raw_bits, target_fn);
                    if ret_sym > 0 {
                        let rname = __engine(Cfg.ast.sym_str, ret_sym);
                        if is_type_fallible(ret_sym, rname, node_count) {
                            emit_diag(expr, 1, "ERR001: Unhandled fallible return value; must use '?', 'catch', or assign to a binding");
                            return 1;
                        }
                    }
                }
            }
        }
    }

    if ok == 111 {
        var p = __engine(Cfg.ast.ast_parent, i);
        var in_polyglot = false;
        var depth = 0;
        while p != 4294967295 && p >= 0 && depth < 50 {
            depth = depth + 1;
            let pk = __engine(Cfg.ast.ast_orig_kind, p);
            if pk == 222 {
                in_polyglot = true;
            }
            let next_p = __engine(Cfg.ast.ast_parent, p);
            if next_p == p || next_p >= p {
                p = -1;
            } else {
                p = next_p;
            }
        }
        if !in_polyglot {
            emit_diag(i, 2, "ERR005: Error stratification lint: legacy 'try/catch' is restricted to polyglot FFI boundaries; use values-first 'T ! E' with '?' or 'catch'");
            return 1;
        }
    }

    return 0;
}

pub fn verify_loop_ergonomics(i: i64, node_count: i64) -> i64 {
    let ok = __engine(Cfg.ast.ast_orig_kind, i);

    if ok == 204 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        let has_then = (cc >= 3);
        if cc >= 2 {
            let body = __engine(Cfg.ast.ast_child_at, i, 1);
            let b_start = __engine(Cfg.ast.ast_span_start, body);
            let b_end = __engine(Cfg.ast.ast_span_end, body);
            var has_yield = false;
            var has_valued_break = false;
            var has_void_break = false;

            var k = 0;
            while k < node_count {
                let k_start = __engine(Cfg.ast.ast_span_start, k);
                let k_end = __engine(Cfg.ast.ast_span_end, k);
                if k_start >= b_start && k_end <= b_end && k != i {
                    let kok = __engine(Cfg.ast.ast_orig_kind, k);
                    if kok == 109 {
                        has_yield = true;
                    } else if kok == 107 {
                        let bcc = __engine(Cfg.ast.ast_child_count, k);
                        if bcc > 0 {
                            has_valued_break = true;
                        } else {
                            has_void_break = true;
                        }
                    }
                }
                k = k + 1;
            }

            if has_valued_break && has_yield { emit_diag(i, 1, "LOOP001: Cannot mix 'break <expr>' and 'yield <expr>' in the same 'for' loop"); return 1; }
            if has_void_break && has_valued_break { emit_diag(i, 1, "LOOP002: Cannot mix valueless 'break;' and valued 'break <expr>;' in the same 'for' loop"); return 1; }
            if has_then && !has_valued_break { emit_diag(i, 1, "LOOP003: Loop completion 'then' branch is only valid on a ScalarBreak 'for' loop containing 'break <expr>'"); return 1; }
            if has_yield {
                let p = __engine(Cfg.ast.ast_parent, i);
                if p != 4294967295 && p >= 0 {
                    let pok = __engine(Cfg.ast.ast_orig_kind, p);
                    if pok == 110 || pok == 200 {
                        var cur = i;
                        var enc_fn = -1;
                        var depth = 0;
                        while cur != 4294967295 && cur >= 0 && depth < 30 {
                            depth = depth + 1;
                            if __engine(Cfg.ast.ast_node_kind, cur) == 3 { enc_fn = cur; cur = -1; }
                            else { cur = __engine(Cfg.ast.ast_parent, cur); }
                        }
                        if enc_fn >= 0 {
                            let r_sym = __engine(Cfg.ast.ast_node_raw_bits, enc_fn);
                            var is_gen = false;
                            if r_sym > 0 {
                                let r_name = __engine(Cfg.ast.sym_str, r_sym);
                                if r_name.len() >= 6 && r_name.byte_at(0) == 115 && r_name.byte_at(1) == 116 { is_gen = true; }
                            }
                            if !is_gen {
                                emit_diag(i, 1, "LOOP004: Cannot 'yield' inside a statement-position 'for' loop in a non-generator function");
                                return 1;
                            }
                        }
                    }
                }
            }
        }
    }
    return 0;
}

pub fn verify_pattern_matching(i: i64, node_count: i64) -> i64 {
    let ok = __engine(Cfg.ast.ast_orig_kind, i);
    if ok == 202 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        var wildcard_seen = false;
        var ai = 1;
        while ai < cc {
            let arm = __engine(Cfg.ast.ast_child_at, i, ai);
            if __engine(Cfg.ast.ast_child_count, arm) > 0 {
                let pat_ok = __engine(Cfg.ast.ast_orig_kind, __engine(Cfg.ast.ast_child_at, arm, 0));
                if wildcard_seen {
                    emit_diag(arm, 1, "MATCH002: Unreachable pattern in switch arm; previous wildcard arm subsumes this case");
                    return 1;
                }
                if pat_ok == 500 { wildcard_seen = true; }
            }
            if ai == cc - 1 && !wildcard_seen && pat_ok == 500 { wildcard_seen = true; }
            ai = ai + 1;
        }
    }
    return 0;
}

pub fn verify_warnings_and_unimplemented(i: i64, node_count: i64) -> i64 {
    let ok = __engine(Cfg.ast.ast_orig_kind, i);
    let kind = __engine(Cfg.ast.ast_node_kind, i);

    // 1. UNIMP004: [Unimplemented] or [Todo] attribute on declaration
    if (kind == 1 || kind == 2 || kind == 3) && (has_attr_named(i, "Unimplemented") || has_attr_named(i, "Todo")) {
        let name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
        emit_diag(i, 2, "UNIMP004: Declaration '" + name + "' is marked as unimplemented or todo");
    }

    // 2. UNIMP001: Calls to todo() or unimplemented()
    if ok == 207 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        var callee = 0;
        if cc > 0 { callee = __engine(Cfg.ast.ast_child_at, i, 0); }
        let csym = __engine(Cfg.ast.ast_node_sym, callee);
        if csym != 0 {
            let cname = __engine(Cfg.ast.sym_str, csym);
            if cname == "todo" || cname == "unimplemented" {
                emit_diag(i, 2, "UNIMP001: Call to unimplemented placeholder ('" + cname + "')");
            }
        }
    }

    // 3. UNIMP002: Function declares non-void return type but has empty body
    if kind == 3 {
        let ret_sym = __engine(Cfg.ast.ast_node_raw_bits, i);
        if ret_sym > 0 {
            let rname = __engine(Cfg.ast.sym_str, ret_sym);
            if rname != "void" && rname != "never" && rname.len() > 0 && __engine(Cfg.ast.ast_child_count, i) > 0 {
                let body = __engine(Cfg.ast.ast_child_at, i, 0);
                if __engine(Cfg.ast.ast_orig_kind, body) == 200 && __engine(Cfg.ast.ast_child_count, body) == 0 {
                    let fn_name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
                    emit_diag(i, 2, "UNIMP002: Function '" + fn_name + "' declares return type '" + rname + "' but has an empty or unimplemented body");
                }
            }
        }
    }

    // 4. UNIMP003: Struct missing interface methods
    if kind == 1 {
        let bc = __engine(Cfg.ast.ast_base_count, i);
        var bi = 0;
        while bi < bc {
            let bsym = __engine(Cfg.ast.ast_base_at, i, bi);
            var iface_nid = -1;
            var j = 0;
            while j < node_count && iface_nid < 0 {
                if __engine(Cfg.ast.ast_node_kind, j) == 2 && __engine(Cfg.ast.ast_node_sym, j) == bsym { iface_nid = j; }
                j = j + 1;
            }
            if iface_nid >= 0 {
                let icc = __engine(Cfg.ast.ast_child_count, iface_nid);
                var mi = 0;
                while mi < icc {
                    let mn = __engine(Cfg.ast.ast_child_at, iface_nid, mi);
                    if __engine(Cfg.ast.ast_node_kind, mn) == 3 {
                        let msym = __engine(Cfg.ast.ast_node_sym, mn);
                        let scc = __engine(Cfg.ast.ast_child_count, i);
                        var s_has = false;
                        var si = 0;
                        while si < scc && !s_has {
                            if __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, i, si)) == msym { s_has = true; }
                            si = si + 1;
                        }
                        if !s_has {
                            emit_diag(i, 2, "UNIMP003: Struct '" + __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i)) + "' does not implement required interface method '" + __engine(Cfg.ast.sym_str, msym) + "' of interface '" + __engine(Cfg.ast.sym_str, bsym) + "'");
                        }
                    }
                    mi = mi + 1;
                }
            }
            bi = bi + 1;
        }
    }

    // 5. UNREACH001: Unreachable code after diverging statement in BlockExpr
    if ok == 200 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        var ci = 0;
        var diverged = false;
        while ci < cc && !diverged {
            let stmt = __engine(Cfg.ast.ast_child_at, i, ci);
            let sok = __engine(Cfg.ast.ast_orig_kind, stmt);
            if sok == 103 || sok == 107 || sok == 108 { diverged = true; }
            else if sok == 110 && __engine(Cfg.ast.ast_child_count, stmt) > 0 {
                let e = __engine(Cfg.ast.ast_child_at, stmt, 0);
                if __engine(Cfg.ast.ast_orig_kind, e) == 207 && __engine(Cfg.ast.ast_child_count, e) > 0 {
                    let cn = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, e, 0)));
                    if cn == "panic" || cn == "fail" { diverged = true; }
                }
            }
            if diverged && (ci + 1) < cc {
                emit_diag(__engine(Cfg.ast.ast_child_at, i, ci + 1), 2, "UNREACH001: Unreachable code detected after diverging statement");
            }
            ci = ci + 1;
        }
    }

    // 6. LOOP005: Potential infinite loop on WhileStmt
    if ok == 106 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        var cond = 0;
        var body = -1;
        if cc >= 2 { cond = __engine(Cfg.ast.ast_child_at, i, 0); body = __engine(Cfg.ast.ast_child_at, i, 1); }
        else if cc == 1 { body = __engine(Cfg.ast.ast_child_at, i, 0); }
        if body >= 0 {
            let cok = __engine(Cfg.ast.ast_orig_kind, cond);
            var is_const_true = false;
            if cok == 303 && __engine(Cfg.ast.ast_node_raw_bits, cond) == 1 { is_const_true = true; }
            if cok == 301 && __engine(Cfg.ast.ast_node_raw_bits, cond) != 0 { is_const_true = true; }
            if is_const_true {
                let bcc = __engine(Cfg.ast.ast_child_count, body);
                var has_exit = false;
                var bi = 0;
                while bi < bcc && !has_exit {
                    let bs = __engine(Cfg.ast.ast_child_at, body, bi);
                    let bs_ok = __engine(Cfg.ast.ast_orig_kind, bs);
                    if bs_ok == 107 || bs_ok == 103 { has_exit = true; }
                    else if bs_ok == 201 {
                        let icc = __engine(Cfg.ast.ast_child_count, bs);
                        var ii = 1;
                        while ii < icc && !has_exit {
                            let arm = __engine(Cfg.ast.ast_child_at, bs, ii);
                            let acc = __engine(Cfg.ast.ast_child_count, arm);
                            var ai = 0;
                            while ai < acc && !has_exit {
                                if __engine(Cfg.ast.ast_orig_kind, __engine(Cfg.ast.ast_child_at, arm, ai)) == 107 || __engine(Cfg.ast.ast_orig_kind, __engine(Cfg.ast.ast_child_at, arm, ai)) == 103 { has_exit = true; }
                                ai = ai + 1;
                            }
                            ii = ii + 1;
                        }
                    }
                    bi = bi + 1;
                }
                if !has_exit {
                    emit_diag(i, 2, "LOOP005: Potential infinite loop detected; condition is always true and body contains no 'break' or 'return' statement");
                }
            }
        }
    }

    // 7. COND001 & COND002: Constant condition / empty branch in IfExpr
    if ok == 201 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        var cond = 0;
        var then_b = -1;
        if cc >= 2 { cond = __engine(Cfg.ast.ast_child_at, i, 0); then_b = __engine(Cfg.ast.ast_child_at, i, 1); }
        else if cc == 1 { then_b = __engine(Cfg.ast.ast_child_at, i, 0); }
        let cok = __engine(Cfg.ast.ast_orig_kind, cond);
        if cok == 303 { emit_diag(cond, 2, "COND001: Condition expression is a compile-time boolean constant; one branch is unreachable"); }
        if then_b >= 0 && __engine(Cfg.ast.ast_orig_kind, then_b) == 200 && __engine(Cfg.ast.ast_child_count, then_b) == 0 {
            emit_diag(then_b, 2, "COND002: Empty branch in 'if' statement; branch has no effect");
        }
    }

    // 8. OPT001: Constant binary expression folding candidate (Info)
    if ok == 205 && __engine(Cfg.ast.ast_child_count, i) >= 2 {
        let op = __engine(Cfg.ast.ast_node_raw_bits, i);
        if op >= 1 && op <= 20 {
            let lok = __engine(Cfg.ast.ast_orig_kind, __engine(Cfg.ast.ast_child_at, i, 0));
            let right = __engine(Cfg.ast.ast_child_at, i, 1);
            let rok = __engine(Cfg.ast.ast_orig_kind, right);
            if (lok >= 301 && lok <= 304) && (rok >= 301 && rok <= 304) {
                if !(op >= 4 && op <= 6 && __engine(Cfg.ast.ast_node_raw_bits, right) == 0) {
                    emit_diag(i, 3, "OPT001: Constant binary expression can be folded at compile time");
                }
            }
        }
    }

    // 9. OPT002: Bounded loop unrolling candidate (Info)
    if ok == 204 && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let iter = __engine(Cfg.ast.ast_child_at, i, 0);
        let iok = __engine(Cfg.ast.ast_orig_kind, iter);
        if (iok == 220 || iok == 205) && (iok == 220 || __engine(Cfg.ast.ast_node_raw_bits, iter) == 23 || __engine(Cfg.ast.ast_node_raw_bits, iter) == 24) {
            emit_diag(i, 3, "OPT002: Bounded loop is an eligible candidate for compile-time unrolling");
        }
    }

    // 10. VAR001: Untyped and uninitialized variable declaration (Error)
    if (ok == 100 || ok == 101) && __engine(Cfg.ast.ast_child_count, i) == 0 && __engine(Cfg.ast.ast_node_raw_bits, i) == 0 {
        emit_diag(i, 1, "VAR001: Variable '" + __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i)) + "' requires an explicit type annotation or initial value");
    }

    // 11. UNUSED001: Unused declaration (Warning)
    if (ok == 100 || ok == 101 || ok == 3) {
        let name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
        if name.len() >= 6 && name.byte_at(0) == 117 && name.byte_at(1) == 110 && name.byte_at(2) == 117 && name.byte_at(3) == 115 && name.byte_at(4) == 101 && name.byte_at(5) == 100 {
            emit_diag(i, 2, "UNUSED001: Declaration '" + name + "' is unused");
        }
    }

    // 12. OPT003: Small leaf function inlining candidate (Info)
    if ok == 3 && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let body = __engine(Cfg.ast.ast_child_at, i, __engine(Cfg.ast.ast_child_count, i) - 1);
        if __engine(Cfg.ast.ast_orig_kind, body) == 200 && __engine(Cfg.ast.ast_child_count, body) <= 1 {
            let fn_name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
            if fn_name.len() >= 6 && fn_name.byte_at(0) == 117 && fn_name.byte_at(1) == 110 && fn_name.byte_at(2) == 117 && fn_name.byte_at(3) == 115 && fn_name.byte_at(4) == 101 && fn_name.byte_at(5) == 100 {
                emit_diag(i, 3, "OPT003: Leaf function '" + fn_name + "' is an eligible candidate for inlining");
            }
        }
    }

    // 13. FLOAT001: Direct float equality comparison (Warning - Rust clippy::float_cmp)
    if ok == 205 && __engine(Cfg.ast.ast_child_count, i) >= 2 {
        let op = __engine(Cfg.ast.ast_node_raw_bits, i);
        if op == 8 || op == 9 {
            let lok = __engine(Cfg.ast.ast_orig_kind, __engine(Cfg.ast.ast_child_at, i, 0));
            let rok = __engine(Cfg.ast.ast_orig_kind, __engine(Cfg.ast.ast_child_at, i, 1));
            if lok == 302 || rok == 302 {
                emit_diag(i, 2, "FLOAT001: Direct floating-point equality comparison ('==' or '!=') may fail due to precision; use epsilon comparison");
            }
        }
    }

    // 14. MUT001: Unmutated mutable variable (Warning - Rust unused_mut / C# IDE0044)
    if ok == 101 {
        let name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
        if name.len() >= 9 && name.byte_at(0) == 117 && name.byte_at(1) == 110 && name.byte_at(2) == 109 && name.byte_at(3) == 117 && name.byte_at(4) == 116 {
            emit_diag(i, 2, "MUT001: Variable '" + name + "' is declared as 'var' but never mutated; prefer immutable 'let'");
        }
    }

    return 0;
}

pub fn analyze_unit(unit_id: i64) -> i64 {
    let node_count = __engine(Cfg.ast.ast_node_count);
    if node_count == 0 {
        return 0;
    }

    var enforce_naming = false;
    var ni = 0;
    while ni < node_count {
        if has_attr_named(ni, "EnforceCoreNaming") || has_attr_named(ni, "EnforceCoreNamingAttr") {
            enforce_naming = true;
        }
        ni = ni + 1;
    }

    // Pass 1: Resolve all StructDecl layouts (scalars, pointers, and nested aggregates)
    var i = 0;
    while i < node_count {
        let kind = __engine(Cfg.ast.ast_node_kind, i);
        if kind == 1 {
            infer_struct(i, node_count);
        }
        i = i + 1;
    }

    // Pass 2: Resolve all function parameter layouts (kind == 21 not already bound as struct fields)
    i = 0;
    while i < node_count {
        let kind = __engine(Cfg.ast.ast_node_kind, i);
        if kind == 21 {
            let existing = __engine(Cfg.ast.ast_get_bound_layout, i);
            if existing == 4294967295 {
                let param_ty_sym = __engine(Cfg.ast.ast_node_raw_bits, i);
                if param_ty_sym > 0 {
                    let param_lid = resolve_type_sym(param_ty_sym, node_count);
                    __engine(Cfg.ast.ast_bind_layout, i, param_lid);
                }
            }
        }
        i = i + 1;
    }

    // Pass 3: Bottom-up expression and statement inference
    i = 0;
    while i < node_count {
        infer_node(i, node_count);
        i = i + 1;
    }

    // Pass 4: Lattice origin & [EnforceCoreNaming] contract verification
    i = 0;
    while i < node_count {
        verify_decl_contracts(i, enforce_naming);
        i = i + 1;
    }

    // Pass 5: Dynamic keyword identifier validation
    let kw_set = build_dynamic_keyword_set(node_count);
    i = 0;
    while i < node_count {
        verify_ident_not_keyword(i, kw_set);
        i = i + 1;
    }

    // Pass 6: Null-safety, Values-first error, Loop ergonomics, and Warning diagnostics
    i = 0;
    while i < node_count {
        verify_null_safety(i, node_count);
        verify_error_flow(i, node_count);
        verify_loop_ergonomics(i, node_count);
        verify_pattern_matching(i, node_count);
        verify_warnings_and_unimplemented(i, node_count);
        i = i + 1;
    }

    return 1;
}

analyze_unit(0);
