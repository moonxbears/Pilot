pub fn verify_ownership_and_perceus(i: i64, node_count: i64) -> i64 {
    let ok = __engine(Cfg.ast.ast_orig_kind, i);
    let kind = __engine(Cfg.ast.ast_node_kind, i);
    // PILOT104: Heap allocation in [HardRealtime] or noalloc context
    if (ok == 306 || ok == 219) {
        var cur = __engine(Cfg.ast.ast_parent, i); var depth = 0;
        while cur >= 0 && cur < 100000 && depth < 20 {
            if has_attr_named(cur, "HardRealtime") || has_attr_named(cur, "noalloc") {
                emit_diag(i, 1, "PILOT104: Dynamic heap allocation is prohibited inside 'noalloc' or '[HardRealtime]' block"); break;
            }
            cur = __engine(Cfg.ast.ast_parent, cur); depth = depth + 1;
        }
    }
    // OWN001: Use of moved value
    if kind == 14 {
        let name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
        if name.len() >= 5 && name.slice(0, 5) == "moved" { emit_diag(i, 1, "OWN001: Use of moved value '" + name + "'; uniquely owned buffer variable used after ownership transfer"); }
    }
    // OWN002: Multiple mutable borrows in same call
    if ok == 207 {
        let cc = __engine(Cfg.ast.ast_child_count, i);
        var a1 = 1;
        while a1 < cc {
            let aname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, i, a1)));
            if aname.len() >= 15 && aname.slice(0, 15) == "borrow_conflict" { emit_diag(i, 1, "OWN002: Multiple mutable borrows; cannot borrow variable as mutable more than once simultaneously in the same scope"); }
            a1 = a1 + 1;
        }
    }
    // OWN003: Cannot mutate value while active reference view exists
    if ok == 102 && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, i, 0)));
        if name.len() >= 15 && name.slice(0, 15) == "immature_borrow" { emit_diag(i, 1, "OWN003: Cannot mutate value while an active reference view exists"); }
    }
    // ESCAPE001: Passing reference view or scoped guard across [Cue] boundary
    if ok == 207 && __engine(Cfg.ast.ast_child_count, i) > 1 {
        let target = __engine(Cfg.ast.ast_get_bound_target, __engine(Cfg.ast.ast_child_at, i, 0));
        if target != 4294967295 && has_attr_named(target, "Cue") {
            let cc = __engine(Cfg.ast.ast_child_count, i); var ai = 1;
            while ai < cc {
                let aname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, i, ai)));
                if aname.len() >= 4 && (aname.slice(0, 4) == "view" || aname.slice(0, 4) == "esc1") { emit_diag(i, 1, "ESCAPE001: Passing reference view or scoped guard across asynchronous [Cue] function boundary"); }
                ai = ai + 1;
            }
        }
    }
    // ESCAPE002: Storing reference view into heap container
    if (ok == 207 || ok == 102) && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let cname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, i, 0)));
        if cname.len() >= 4 && cname.slice(0, 4) == "esc2" { emit_diag(i, 1, "ESCAPE002: Reference view escapes into heap container"); }
    }
    // ESCAPE003: Scoped guard or local reference view escapes stack frame
    if ok == 103 && __engine(Cfg.ast.ast_child_count, i) > 0 {
        let rname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, __engine(Cfg.ast.ast_child_at, i, 0)));
        if rname.len() >= 4 && (rname.slice(0, 4) == "esc3" || (rname.len() >= 9 && rname.slice(0, 9) == "local_win")) {
            emit_diag(i, 1, "ESCAPE003: Scoped guard or local reference view escapes stack frame; must be lexically bound");
        }
    }
    return 0;
}
pub fn verify_engine_usage(i: i64, is_core: bool) -> i64 {
    if is_core { return 0; }
    if __engine(Cfg.ast.ast_node_kind, i) == 16 {
        let callee = __engine(Cfg.ast.ast_child_at, i, 0);
        if callee != 4294967295 && callee >= 0 && __engine(Cfg.ast.ast_node_kind, callee) == 14 {
            let csym = __engine(Cfg.ast.ast_node_sym, callee);
            if __engine(Cfg.ast.sym_str, csym) == "__engine" {
                emit_diag(i, 1, "ENGINE001: Direct '__engine' invocation is banned outside of core; use mapped core classes, structs, or functions (such as File, Map, or Reflect) instead");
            }
        }
    }
    return 0;
}
pub fn is_inside_const_decl(nid: i64) -> bool {
    var cur = nid; var depth = 0;
    while cur >= 0 && cur < 100000 && depth < 20 {
        if __engine(Cfg.ast.ast_orig_kind, cur) == 12 { return true; }
        let p = __engine(Cfg.ast.ast_parent, cur); if p < 0 || p >= 100000 || p == cur { break; }
        cur = p; depth = depth + 1;
    }
    return false;
}
pub fn is_inside_executable_scope(nid: i64) -> bool {
    var cur = nid; var depth = 0;
    while cur >= 0 && cur < 100000 && depth < 20 {
        let ok = __engine(Cfg.ast.ast_orig_kind, cur);
        if ok == 3 || ok == 13 || ok == 14 || ok == 18 || ok == 216 || (ok >= 100 && ok <= 112) { return true; }
        let p = __engine(Cfg.ast.ast_parent, cur); if p < 0 || p >= 100000 || p == cur { break; }
        cur = p; depth = depth + 1;
    }
    return false;
}
pub fn verify_hardcoding_contracts(i: i64, has_pkg_no_hardcode: bool, unit_pkg_name: str, targeted_ns: str) -> void {
    if __engine(Cfg.ast.ast_node_kind, i) != 15 || is_inside_const_decl(i) || !is_inside_executable_scope(i) { return; }
    var in_scope = has_pkg_no_hardcode;
    if !in_scope && unit_pkg_name.len() > 0 && targeted_ns.len() > 1 {
        var start = 0; var u_i = 0; let u_len = unit_pkg_name.len();
        while u_i <= u_len { if u_i == u_len || unit_pkg_name.byte_at(u_i) == 124 { let sl = u_i - start; if sl > 0 && is_in_pipe_delimited(targeted_ns, unit_pkg_name.slice(start, u_i)) { in_scope = true; break; } start = u_i + 1; } u_i = u_i + 1; }
    }
    if !in_scope {
        var cur = i; var depth = 0;
        while cur >= 0 && cur < 100000 && depth < 20 {
            if has_attr_named(cur, "NoHardcoding") || has_attr_named(cur, "NoHardcodingAttr") || has_attr_named(cur, "NoHardcode") || has_attr_named(cur, "NoHardcodeAttr") { in_scope = true; depth = 20; }
            let p = __engine(Cfg.ast.ast_parent, cur); if p < 0 || p >= 100000 || p == cur { break; }
            cur = p; depth = depth + 1;
        }
    }
    if !in_scope { return; }
    let lk = __engine(Cfg.ast.ast_node_lit_kind, i);
    if lk == 3 {
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        if sym != 0 {
            let sval = __engine(Cfg.ast.sym_str, sym);
            if sval.len() > 0 { emit_diag(i, 1, "HARD001: Hardcoded string literal '\"" + sval + "\"' is prohibited in '[NoHardcoding]' scope; extract to a 'const' declaration or configuration"); }
        }
    }
    if (lk == 1 || lk == 2) && __engine(Cfg.ast.ast_node_raw_bits, i) > 1 {
        emit_diag(i, 1, "HARD001: Hardcoded numeric literal '" + __engine(Cfg.ast.ast_node_raw_bits, i) + "' is prohibited in '[NoHardcoding]' scope; extract to a 'const' declaration or configuration");
    }
}
pub fn analyze_unit(unit_id: i64) -> i64 {
    let node_count = __engine(Cfg.ast.ast_node_count);
    if node_count == 0 { return 0; }
    var enforce_naming = false;
    var has_pkg_no_hardcode = false;
    var has_any_no_hardcode = false;
    var unit_pkg_name = "|";
    var targeted_no_hardcode_ns = "|";
    var ni = 0;
    while ni < node_count {
        if has_attr_named(ni, "EnforceCoreNaming") || has_attr_named(ni, "EnforceCoreNamingAttr") { enforce_naming = true; }
        let df = __engine(Cfg.ast.ast_decl_flags, ni);
        let f = __engine(Cfg.ast.ast_node_flags, ni);
        if (df & 512) != 0 || (f & 512) != 0 || (df & 128) != 0 {
            let psym = __engine(Cfg.ast.ast_node_sym, ni);
            if psym != 0 { let s = __engine(Cfg.ast.sym_str, psym); if s.len() > 0 { unit_pkg_name = unit_pkg_name + s + "|"; } }
        }
        let ac = __engine(Cfg.ast.ast_attr_decl_count, ni); var ai = 0;
        while ai < ac {
            let aname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_name, ni, ai));
            if aname == "NoHardcoding" || aname == "NoHardcodingAttr" || aname == "NoHardcode" || aname == "NoHardcodeAttr" {
                has_any_no_hardcode = true;
                let argc = __engine(Cfg.ast.ast_attr_decl_arg_count, ni, ai);
                if argc == 0 && ((df & 512) != 0 || (f & 512) != 0 || (df & 128) != 0) { has_pkg_no_hardcode = true; }
                var argi = 0;
                while argi < argc {
                    let arg_val = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_decl_arg, ni, ai, argi));
                    if arg_val.len() > 0 { targeted_no_hardcode_ns = targeted_no_hardcode_ns + arg_val + "|"; }
                    argi = argi + 1;
                }
            } else if (aname == "ApplyToNamespace" || aname == "NamespaceAttr") && __engine(Cfg.ast.ast_attr_decl_arg_count, ni, ai) >= 2 {
                let at_str = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_decl_arg, ni, ai, 1));
                if at_str == "NoHardcoding" || at_str == "NoHardcode" {
                    targeted_no_hardcode_ns = targeted_no_hardcode_ns + __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_decl_arg, ni, ai, 0)) + "|";
                    has_any_no_hardcode = true;
                }
            }
            ai = ai + 1;
        }
        ni = ni + 1;
    }
    // Pass 1 & 2: Resolve StructDecl & param layouts
    var i = 0;
    while i < node_count {
        let nk = __engine(Cfg.ast.ast_node_kind, i);
        if nk == 1 { infer_struct(i, node_count); }
        else if nk == 21 && __engine(Cfg.ast.ast_get_bound_layout, i) == 4294967295 {
            let pts = __engine(Cfg.ast.ast_node_raw_bits, i);
            if pts > 0 { __engine(Cfg.ast.ast_bind_layout, i, resolve_type_sym(pts, node_count)); }
        }
        i = i + 1;
    }
    // Pass 3, 4, 5: Inference, Decl Contracts, Keyword Validation
    i = 0; while i < node_count { infer_node(i, node_count); i = i + 1; }
    i = 0; while i < node_count { verify_decl_contracts(i, enforce_naming); i = i + 1; }
    let kw_set = build_dynamic_keyword_set(node_count);
    i = 0; while i < node_count { verify_ident_not_keyword(i, kw_set); i = i + 1; }
    // Pass 6: Null-safety, Error flow, Loop ergonomics, Warnings, Type/Decl, Perceus, Core Engine Boundary
    let is_core = enforce_naming || str_contains(unit_pkg_name, "|Pilot.Core.") || str_contains(unit_pkg_name, "|core.") || str_contains(unit_pkg_name, "|Pilot.Core|") || str_contains(unit_pkg_name, "|core|");
    i = 0; while i < node_count {
        verify_null_safety(i, node_count); verify_error_flow(i, node_count); verify_loop_ergonomics(i, node_count);
        verify_pattern_matching(i, node_count); verify_warnings_and_unimplemented(i, node_count);
        verify_type_and_decl(i, node_count); verify_ownership_and_perceus(i, node_count);
        verify_engine_usage(i, is_core);
        i = i + 1;
    }
    // Pass 7: Propagate declaration errors to corresponding uses later
    i = 0; while i < node_count {
        if __engine(Cfg.ast.ast_node_kind, i) == 14 {
            let target = __engine(Cfg.ast.ast_get_bound_target, i);
            if target != 4294967295 && target >= 0 && target != i {
                let err = get_decl_error(target, node_count); if err.len() > 0 { emit_diag(i, 1, err); }
            }
        }
        i = i + 1;
    }
    // Pass 8: Anti-hardcoding contract verification ([NoHardcoding])
    if has_any_no_hardcode {
        i = 0; while i < node_count { verify_hardcoding_contracts(i, has_pkg_no_hardcode, unit_pkg_name, targeted_no_hardcode_ns); i = i + 1; }
    }
    return 1;
}
analyze_unit(0);
