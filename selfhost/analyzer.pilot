extern fn __engine(operation: string, ...args: i64) -> i64;

let Cfg = {
    ast = {
        ast_attr_arg: "ast_attr_arg",
        ast_attr_count: "ast_attr_count",
        ast_attr_decl_arg: "ast_attr_decl_arg",
        ast_attr_decl_arg_count: "ast_attr_decl_arg_count",
        ast_attr_decl_count: "ast_attr_decl_count",
        ast_attr_name: "ast_attr_name",
        ast_base_at: "ast_base_at",
        ast_base_count: "ast_base_count",
        ast_bind_layout: "ast_bind_layout",
        ast_bind_target: "ast_bind_target",
        ast_child_at: "ast_child_at",
        ast_child_count: "ast_child_count",
        ast_decl_flags: "ast_decl_flags",
        ast_emit_diag: "ast_emit_diag",
        ast_get_bound_layout: "ast_get_bound_layout",
        ast_get_bound_target: "ast_get_bound_target",
        ast_node_count: "ast_node_count",
        ast_node_flags: "ast_node_flags",
        ast_node_kind: "ast_node_kind",
        ast_node_lit_kind: "ast_node_lit_kind",
        ast_node_raw_bits: "ast_node_raw_bits",
