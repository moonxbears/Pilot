// ==============================================================================
// selfhost/analyzer.pilot: Semantic Analyzer & Type Checker Written in Pilot
// ==============================================================================

pub pkg Pilot.SelfHost.Analyzer;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

extern "c" {
    fn strcmp(s1: str, s2: str) -> i32;
}

pub const TYPE_UNKNOWN: i64 = 0;
pub const TYPE_INT: i64 = 1;
pub const TYPE_FLOAT: i64 = 2;
pub const TYPE_BOOL: i64 = 3;
pub const TYPE_STR: i64 = 4;
pub const TYPE_VOID: i64 = 5;

pub fn resolve_primitive_type(type_name: str) -> i64 {
    if strcmp(type_name, "i64") == 0 || strcmp(type_name, "int") == 0 { return TYPE_INT; }
    if strcmp(type_name, "f64") == 0 || strcmp(type_name, "float") == 0 { return TYPE_FLOAT; }
    if strcmp(type_name, "bool") == 0 { return TYPE_BOOL; }
    if strcmp(type_name, "str") == 0 { return TYPE_STR; }
    if strcmp(type_name, "void") == 0 { return TYPE_VOID; }
    return TYPE_UNKNOWN;
}

pub fn get_type_c_name(type_id: i64) -> str {
    if type_id == 1 { return "int64_t"; }
    if type_id == 2 { return "double"; }
    if type_id == 3 { return "bool"; }
    if type_id == 4 { return "const char*"; }
    if type_id == 5 { return "void"; }
    return "int64_t";
}
