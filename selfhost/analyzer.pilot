// ==============================================================================
// selfhost/analyzer.pilot: Name-Blind Type Inference & Semantic Analyzer
// 100% Pilot-Hosted Multi-Pass Analyzer Executed in PilVirtualMachine
// Driven by __engine(...) host bridge into PhysicsRegistry
// ==============================================================================

pub pkg Pilot.SelfHost.Analyzer;

// Top-level entrypoint executed by pilot-vm
pub fn analyze_unit(unit_id: i64) -> i64 {
    let total_nodes = __engine("ast_node_count");
    if total_nodes == 0 {
        return 0;
    }

    // Default scalar layouts registered dynamically
    let int_scalar = __engine("layout_scalar", 64, 1, 2);
    let float_scalar = __engine("layout_scalar", 64, 1, 1);
    let bool_scalar = __engine("layout_scalar", 8, 1, 0);

    // Pass 1: Declaration Registration
    var i = 0;
    while i < total_nodes {
        let kind = __engine("ast_node_kind", i);
        if kind == 1 {
            // Struct declaration
            let sym = __engine("ast_node_sym", i);
            let child_cnt = __engine("ast_child_count", i);
            var struct_lid = int_scalar;
            if child_cnt > 0 {
                struct_lid = __engine("layout_aggregate", int_scalar, int_scalar);
            }
            __engine("ast_bind_layout", i, struct_lid);
        } else if kind == 3 {
            // Fn declaration
            let fn_lid = __engine("layout_scalar", 64, 1, 0);
            __engine("ast_bind_layout", i, fn_lid);
        }
        i = i + 1;
    }

    // Pass 2: Statements & Expressions Inference
    i = 0;
    while i < total_nodes {
        let kind = __engine("ast_node_kind", i);
        if kind == 15 {
            // Literal Leaf
            let lit_kind = __engine("ast_node_lit_kind", i);
            var lit_lid = int_scalar;
            if lit_kind == 2 {
                lit_lid = float_scalar;
            } else if lit_kind == 4 {
                lit_lid = bool_scalar;
            }
            __engine("ast_bind_layout", i, lit_lid);
        } else if kind == 14 {
            // Identifier Leaf
            let sym = __engine("ast_node_sym", i);
            __engine("ast_bind_layout", i, int_scalar);
        } else if kind == 4 {
            // Let statement
            let child_cnt = __engine("ast_child_count", i);
            if child_cnt > 0 {
                let rhs_id = __engine("ast_child_at", i, 0);
                var rhs_lid = __engine("ast_get_bound_layout", rhs_id);
                if rhs_lid == 4294967295 {
                    rhs_lid = int_scalar;
                }
                __engine("ast_bind_layout", i, rhs_lid);
            } else {
                __engine("ast_bind_layout", i, int_scalar);
            }
        } else if kind == 19 {
            // Binary expression
            let child_cnt = __engine("ast_child_count", i);
            var res_lid = int_scalar;
            if child_cnt > 0 {
                let lhs_id = __engine("ast_child_at", i, 0);
                let lhs_lid = __engine("ast_get_bound_layout", lhs_id);
                if lhs_lid != 4294967295 {
                    res_lid = lhs_lid;
                }
            }
            __engine("ast_bind_layout", i, res_lid);
        } else if kind == 17 {
            // Field access (MemberExpr)
            let child_cnt = __engine("ast_child_count", i);
            if child_cnt > 0 {
                let recv_id = __engine("ast_child_at", i, 0);
                var recv_lid = __engine("ast_get_bound_layout", recv_id);
                if recv_lid == 4294967295 {
                    recv_lid = int_scalar;
                }
                let offset = __engine("layout_field_offset", recv_lid, 0);
                __engine("ast_bind_layout", i, int_scalar);
            } else {
                __engine("ast_bind_layout", i, int_scalar);
            }
        } else if kind == 6 {
            // If expression
            __engine("ast_bind_layout", i, int_scalar);
        } else if kind == 16 {
            // Call expression
            let sym = __engine("ast_node_sym", i);
            __engine("ast_bind_target", i, sym);
            __engine("ast_bind_layout", i, int_scalar);
        }
        i = i + 1;
    }

    return 1;
}

analyze_unit(0);
