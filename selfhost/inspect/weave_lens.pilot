// ==============================================================================
// FILE: selfhost/inspect/weave_lens.pilot
// `pilot inspect` weave lens text: expanded source with attribute weights and
// bundle origins. `pilot inspect` has no handler (seam cli.command_handler).
// Reached only by the milestone07 Rust test; no `pilot` command runs it.
// ==============================================================================
pub lvl(0) pkg selfhost.inspect;

// Formats an expanded statement annotated with its synthesis origin
pub fn format_woven_statement(stmt: str, origin_kind: str, origin_name: str, stage_weight: i32) -> str {
    var annot = "  // [Synthesized via " + origin_kind + " '" + origin_name + "'";
    if stage_weight != 0 {
        annot = annot + ", weight: " + stage_weight;
    }
    annot = annot + "]\n";
    return annot + "  " + stmt + "\n";
}

// Expands an implicit property getter/setter into standard backing store and method calls
pub fn expand_property_accessor(prop_name: str, type_name: str, backing_field: str, has_setter: bool) -> str {
    var out = "";
    out = out + format_woven_statement(nameof(priv) + " " + nameof(var) + " " + backing_field + ": " + type_name + ";", "PropertyBackingStorage", prop_name, 0);
    out = out + format_woven_statement(nameof(pub) + " " + nameof(fn) + " get_" + prop_name + "(" + nameof(ref) + " " + nameof(self) + ") -> " + type_name + " => " + nameof(self) + "." + backing_field + ";", "SynthesizedGetter", prop_name, 100);
    if has_setter {
        out = out + format_woven_statement(nameof(pub) + " " + nameof(fn) + " set_" + prop_name + "(" + nameof(var) + " " + nameof(ref) + " " + nameof(self) + ", " + nameof(value) + ": " + type_name + ") { " + nameof(self) + "." + backing_field + " = " + nameof(value) + "; }", "SynthesizedSetter", prop_name, 100);
    }
    return out;
}
