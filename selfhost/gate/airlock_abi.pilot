fn ab_viol(file: str, snippet: str, msg: str) -> GateViolation {
    return GateViolation {
        code: "GATE021",
        file_path: file,
        line: 1,
        column: 1,
        offending_snippet: snippet,
        message: msg,
        remediation: "Restore the frozen Model B+ airlock ABI in bridge_lang.pilot, bridge_os.pilot, os_abi.pilot, and bridge.rs",
        severity: GateSeverityId.Blocker,
    };
}

/// Verifies the frozen Model B+ airlock ABI across `bridge_os.pilot`, `os_abi.pilot`,
/// `bridge_lang.pilot`, and `crates/pilot-vm/src/bridge.rs`.
pub fn verify_airlock_abi(root: str, violations: i64) {
    let bridge_os = gate_fs_read_text(gm_join_path(root, "stdlib/core/bridge_os.pilot"));
    let os_abi = gate_fs_read_text(gm_join_path(root, "stdlib/core/os_abi.pilot"));
    let bridge_lang = gate_fs_read_text(gm_join_path(root, "stdlib/core/bridge_lang.pilot"));
    let bridge_rs = gate_fs_read_text(gm_join_path(root, "crates/pilot-vm/src/bridge.rs"));

    if bridge_os == "" || os_abi == "" || bridge_lang == "" || bridge_rs == "" {
        let _ = glist_push(violations, ab_viol("stdlib/core/bridge_os.pilot", "missing airlock file", "One or more Model B+ airlock files are missing"));
        return;
    }

    for row in airlock_host_ops() {
        let id: i64 = row[0];
        let rs_name: str = row[1];
        let fn_name: str = row[2];
        if !gm_contains(bridge_os, f"pub fn {fn_name}(") || !gm_contains(bridge_os, f"__engine(\"host_op\", {id}") {
            let _ = glist_push(violations, ab_viol("stdlib/core/bridge_os.pilot", fn_name, f"Frozen HostOp {id} ({fn_name}) missing or renumbered in bridge_os.pilot"));
        }
        if !gm_contains(bridge_rs, f"{rs_name} = {id},") {
            let _ = glist_push(violations, ab_viol("crates/pilot-vm/src/bridge.rs", rs_name, f"Frozen HostOp::{rs_name} = {id} missing or renumbered in bridge.rs"));
        }
    }

    for row in airlock_pilot_errs() {
        let code: i64 = row[0];
        let ename: str = row[1];
        if !gm_contains(os_abi, ename) || !gm_contains(os_abi, f" {code},") {
            let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", ename, f"Frozen PilotErr::{ename} = {code} missing in os_abi.pilot"));
        }
    }

    for row in airlock_arch_kinds() {
        let code: i64 = row[0];
        let aname: str = row[1];
        if !gm_contains(os_abi, f"{aname}") || !gm_contains(os_abi, f" {code},") {
            let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", aname, f"Frozen OsArchKind::{aname} = {code} missing in os_abi.pilot"));
        }
    }

    for row in airlock_c_structs() {
        let sname: str = row[0];
        let fields: List<str> = row[3];
        if !gm_contains(os_abi, f"pub struct {sname} : IValue") {
            let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", sname, f"Frozen C-ABI struct {sname} missing in os_abi.pilot"));
        }
        for f in fields {
            if !gm_contains(os_abi, f"pub {f}:") {
                let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", f, f"Frozen C-ABI field {sname}.{f} missing in os_abi.pilot"));
            }
        }
    }

    for h in airlock_lang_hooks() {
        if !gm_contains(bridge_lang, f"{h}(") || !gm_contains(bridge_lang, f"__engine(\"{h}\"") {
            let _ = glist_push(violations, ab_viol("stdlib/core/bridge_lang.pilot", h, f"Frozen bridge_lang hook {h} missing or altered in bridge_lang.pilot"));
        }
    }
}
