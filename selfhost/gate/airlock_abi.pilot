// ==============================================================================
// FILE: selfhost/gate/airlock_abi.pilot
// Model B+ Frozen Airlock ABI Snapshot & Drift Verifier (`GATE021`, PROP-002a)
// ==============================================================================
pub lvl(0) pkg selfhost.gate;

/// A frozen `HostOp`: its ID, its name in `bridge.rs`, and its owner method
/// (`Type.method`, or `""` while the op has no caller).
pub type HostOpRow = (i64, str, str);
/// A frozen numbered name (`PilotErr` code, `OsArchKind` ID): code, name.
pub type CodeNameRow = (i64, str);
/// A frozen `[Layout(c_abi)]` struct: name, size, align, field markers.
pub type CStructRow = (str, i64, i64, List<str>);
/// A Stage-A data op's owner: native, owner method (`Type.method`), file.
pub type NativeOwnerRow = (str, str, str);

/// Frozen Model B+ `HostOp` table (51 ops: `0..=50`): `(id, HostOp name, owner)`.
/// The ID and name are frozen forever. The owner (`Type.method`, Amendment A1)
/// is checked, not frozen: each op has at most one owner, and moving it needs
/// an owner-approved `proposals.md` entry. `""` means no caller yet, so no owner.
