pub fn airlock_transitional_hooks() -> List<str> => [];

/// Where each owner type lives (Amendment A1).
pub fn airlock_owner_files() -> Map<str, str> {
    let m = Map<str, str>();
    m.set("RawMem", "stdlib/core/host_raw.pilot");
    m.set("Fd", "stdlib/core/host_raw.pilot");
    m.set("File", "stdlib/core/file.pilot");
    m.set("Env", "stdlib/core/env.pilot");
    m.set("Process", "stdlib/core/env.pilot");
    m.set("TcpSocket", "stdlib/core/env.pilot");
    m.set("Thread", "stdlib/core/env.pilot");
    m.set("Clock", "stdlib/core/env.pilot");
    m.set("Entropy", "stdlib/core/env.pilot");
    m.set("Ffi", "stdlib/core/env.pilot");
    return m;
}

/// Owners of Stage-A data ops (PROP-002b): `(native, owner, file)`. Each is a
/// `priv static fn <m>_internal` marked `[EngineOp]` whose whole body is
/// `__engine("<native>", ..)`, called only by the type's public method `<m>`.
/// Unlike a `HostOp`, the op may still appear outside its owner: about 1,900
/// raw `__engine("map_*")` sites in legacy files wait for PROP-002b bucket B.
pub fn airlock_native_owners() -> List<NativeOwnerRow> => [
    ("map_get",    "Map.get",    "stdlib/core/primitives/map.pilot"),
    ("map_set",    "Map.set",    "stdlib/core/primitives/map.pilot"),
    ("map_has",    "Map.has",    "stdlib/core/primitives/map.pilot"),
    ("map_keys",   "Map.keys",   "stdlib/core/primitives/map.pilot"),
    ("map_remove", "Map.remove", "stdlib/core/primitives/map.pilot"),
];

/// Check 6: each Stage-A data op's owner (`airlock_native_owners()`) exists
/// with the op as its whole body, and only its public method calls it.
fn ab_check_native_owners(root: str, violations: i64) {
    for row in airlock_native_owners() {
        let nat = row.0;
        let owner = row.1;
        let file = row.2;
        let src = gate_fs_read_text(gm_join_path(root, file));
        let dot = gm_find(owner, ".", 0);
        let ty = owner.slice(0, dot);
        let meth = owner.slice(dot + 1, owner.len());
        let head = gm_find(src, f"[EngineOp]\n    priv static fn {meth}_internal(", 0);
        let arrow = if head < 0 { -1 } else { gm_find(src, "=>", head) };
        let semi = if head < 0 { -1 } else { gm_find(src, ";", head) };
        let body = gm_find(src, f"=> __engine(\"{nat}\", ", head);
        if head < 0 || arrow < 0 || body != arrow || semi < body {
            let _ = glist_push(violations, ab_viol(file, owner, f"{owner}_internal must be a `priv static fn` marked [EngineOp] whose whole body is `__engine(\"{nat}\", ...)`"));
            continue;
        }
        let calls = ab_count_calls(src, meth + "_internal");
        let public = gm_find(src, f"pub fn {meth}(", 0);
        let public_pure = gm_find(src, f"pub pure fn {meth}(", 0);
        let ppos = if public >= 0 { public } else { public_pure };
        let only = gm_find(src, f"{ty}.{meth}_internal(", 0);
        if calls != 1 || ppos < 0 || only < ppos || gm_find(src, ";", ppos) < only {
            let _ = glist_push(violations, ab_viol(file, owner, f"{owner}_internal must have exactly one caller, the public method `{meth}`; found {calls}"));
        }
    }
}

/// `TRANSITIONAL_NATIVE_BINDINGS` (Amendment A1): the Stage-A natives that
/// `bind_native_*` may still name until their owner methods exist and are as
/// fast on the seed (PROP-002b, after PROP-007). Shrink-only: a binding to a
/// native not listed here fails, and an entry no binding uses must be deleted.
pub fn transitional_native_bindings() -> List<str> => [
    "rt_print", "rt_eprint", "rt_fault", "seam_open", "list_new", "map_new",
    "str_from_bytes", "gen_resume", "gen_done", "gen_close", "gen_current",
    "str_copy_to_ptr", "str_from_ptr", "vm_thread_entry_ptr", "vm_callback_dispatch_ptr",
    "str_len", "map_get", "map_set", "map_has", "map_keys", "map_remove",
    "list_push", "list_pop", "list_remove_at", "str_trim", "to_str", "str_byte_at",
    "str_slice", "str_find", "str_replace", "str_contains", "str_starts_with",
    "str_ends_with", "is_null", "get_env", "list_get", "list_set",
];

fn ab_is_word(s: str) -> bool {
    var i = 0;
    while i < s.len() {
        let c = s.byte_at(i);
        if !((c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95) { return false; }
        i = i + 1;
    }
    return s.len() > 0;
}

fn ab_viol(file: str, snippet: str, msg: str) -> GateViolation {
    return GateViolation {
        code: "GATE021",
        file_path: file,
        line: 1,
        column: 1,
        offending_snippet: snippet,
        message: msg,
        remediation: "Keep the frozen Model B+ ABI and one op, one owner (proposals.md PROP-002a Amendment A1)",
        severity: GateSeverityId.Blocker,
    };
}

fn ab_rel(root: str, full: str) -> str {
    let pfx = if root.ends_with("/") { root } else { root + "/" };
    if full.starts_with(pfx) { return full.slice(pfx.len(), full.len()); }
    if full.starts_with("./") { return full.slice(2, full.len()); }
    return full;
}

/// The text of the line holding byte `at` up to `at`.
fn ab_line_prefix(src: str, at: i64) -> str {
    var b = at;
    while b > 0 && src.byte_at(b - 1) != 10 { b = b - 1; }
    return src.slice(b, at);
}

/// The decimal number starting at byte `at`, or -1.
fn ab_int_at(src: str, at: i64) -> i64 {
    var i = at;
    var v = 0;
    var any = false;
    while i < src.len() && src.byte_at(i) >= 48 && src.byte_at(i) <= 57 {
        v = v * 10 + (src.byte_at(i) - 48);
        any = true;
        i = i + 1;
    }
    return if any { v } else { -1 };
}

/// Checks one runtime op site: it must be the whole body of a `priv static fn
/// <m>_internal(...)` marked `[EngineOp]` in the owner's file (checks 1 and 2).
fn ab_check_site(src: str, at: i64, rel: str, id: i64, owner: str, files: Map<str, str>, violations: i64) {
    if owner == "" {
        let _ = glist_push(violations, ab_viol(rel, f"host_op {id}", f"HostOp {id} has no registered owner; register one in airlock_abi.pilot (proposals.md entry) before calling it"));
        return;
    }
    let dot = gm_find(owner, ".", 0);
    let ty = owner.slice(0, dot);
    let meth = owner.slice(dot + 1, owner.len());
    let want_file = if files.has(ty) { files.get(ty) } else { "" };
    if rel != want_file {
        let _ = glist_push(violations, ab_viol(rel, f"host_op {id}", f"HostOp {id} is owned by {owner} in {want_file}; it may not appear here"));
        return;
    }
    let head = f"[EngineOp]\n    priv static fn {meth}_internal(";
    let st = gm_find(src, f"pub struct {ty} : ", 0);
    let body_end = if st < 0 { -1 } else { gm_find(src, "\n}", st) };
    let hpos = if st < 0 { -1 } else { gm_find(src, head, st) };
    if hpos < 0 || hpos > at || body_end < at {
        let _ = glist_push(violations, ab_viol(rel, owner, f"{owner}_internal is missing, or is not a `priv static fn` marked [EngineOp]"));
        return;
    }
    let arrow = gm_find(src, "=>", hpos);
    var k = arrow + 2;
    while k < at && (src.byte_at(k) == 32 || src.byte_at(k) == 10) { k = k + 1; }
    if arrow < 0 || k != at {
        let _ = glist_push(violations, ab_viol(rel, owner, f"{owner}_internal must have `__engine(\"host_op\", {id}, ...)` as its whole body"));
    }
    let semi = gm_find(src, ";", at);
    let next_fn = gm_find(src, "fn ", hpos + head.len());
    if semi < 0 || (next_fn >= 0 && next_fn < semi) {
        let _ = glist_push(violations, ab_viol(rel, owner, f"{owner}_internal must end at its `__engine(...)` call"));
    }
}

/// The body of `struct <ty>` in `src` (from its header to the next top-level
/// declaration), so owners in one file with the same method name stay apart.
fn ab_struct_body(src: str, ty: str) -> str {
    let st = gm_find(src, f"pub struct {ty} : ", 0);
    if st < 0 { return ""; }
    let nx = gm_find(src, "\n}", st);
    return if nx < 0 { src.slice(st, src.len()) } else { src.slice(st, nx + 2) };
}

/// Counts `.<name>(` call sites in `src`.
fn ab_count_calls(src: str, name: str) -> i64 {
    let needle = "." + name + "(";
    var n = 0;
    var at = gm_find(src, needle, 0);
    while at >= 0 {
        n = n + 1;
        at = gm_find(src, needle, at + needle.len());
    }
    return n;
}

/// Verifies the frozen Model B+ ABI (`bridge.rs`, `os_abi.pilot`,
/// `bridge_lang.pilot`) and one op, one owner (Amendment A1) across the tree.
pub fn verify_airlock_abi(root: str, violations: i64) {
    let os_abi = gate_fs_read_text(gm_join_path(root, "stdlib/core/os_abi.pilot"));
    let bridge_lang = gate_fs_read_text(gm_join_path(root, "stdlib/core/bridge_lang.pilot"));
    let bridge_rs = gate_fs_read_text(gm_join_path(root, "crates/pilot-vm/src/bridge.rs"));
    if os_abi == "" || bridge_lang == "" || bridge_rs == "" {
        let _ = glist_push(violations, ab_viol("stdlib/core/bridge_lang.pilot", "missing airlock file", "One or more Model B+ airlock files are missing"));
        return;
    }
    let files = airlock_owner_files();
    let owners = Map<i64, str>();
    for row in airlock_host_ops() {
        let id = row.0;
        let rs_name = row.1;
        let owner = row.2;
        owners.set(id, owner);
        if !gm_contains(bridge_rs, f"{rs_name} = {id},") {
            let _ = glist_push(violations, ab_viol("crates/pilot-vm/src/bridge.rs", rs_name, f"Frozen HostOp::{rs_name} = {id} missing or renumbered in bridge.rs"));
        }
    }

    // Checks 1-3: every runtime op site, across every Pilot source tree.
    let seen = Map<i64, i64>();
    let needle = "__engine(\"host_op\", ";
    for subdir in ["stdlib", "selfhost", "tools", "tests", "examples"] {
        let walked = gate_fs_walk_files(gm_join_path(root, subdir));
        var wi = 0;
        while wi < walked.len() {
            let full = walked[wi];
            wi = wi + 1;
            if !full.ends_with(".pilot") { continue; }
            let src = gate_fs_read_text(full);
            if !src.contains("host_op") { continue; }
            let rel = ab_rel(root, full);
            if rel == "selfhost/gate/airlock_abi.pilot" { continue; }
            var at = gm_find(src, needle, 0);
            while at >= 0 {
                if !gm_contains(ab_line_prefix(src, at), "//") {
                    let id = ab_int_at(src, at + needle.len());
                    let owner = if owners.has(id) { owners.get(id) } else { "" };
                    seen.set(id, if seen.has(id) { seen.get(id) + 1 } else { 1 });
                    ab_check_site(src, at, rel, id, owner, files, violations);
                }
                at = gm_find(src, needle, at + needle.len());
            }
        }
    }
    for row in airlock_host_ops() {
        let id = row.0;
        let owner = row.2;
        if owner == "" { continue; }
        let n = if seen.has(id) { seen.get(id) } else { 0 };
        if n != 1 {
            let _ = glist_push(violations, ab_viol("selfhost/gate/airlock_abi.pilot", owner, f"HostOp {id} must appear exactly once, in {owner}_internal; found {n}"));
            continue;
        }
        // Check 3: the owner method has exactly one caller, its public method.
        let dot = gm_find(owner, ".", 0);
        let ty = owner.slice(0, dot);
        let meth = owner.slice(dot + 1, owner.len());
        let osrc = ab_struct_body(gate_fs_read_text(gm_join_path(root, files.get(ty))), ty);
        let calls = ab_count_calls(osrc, meth + "_internal");
        let public = f"pub static fn {meth}(";
        let ppos = gm_find(osrc, public, 0);
        let only = gm_find(osrc, f"{ty}.{meth}_internal(", 0);
        if calls != 1 || ppos < 0 || only < ppos || gm_find(osrc, ";", ppos) < only {
            let _ = glist_push(violations, ab_viol(files.get(ty), owner, f"{owner}_internal must have exactly one caller, `pub static fn {meth}`; found {calls}"));
        }
    }

    ab_check_native_owners(root, violations);

    // Check 4: native bindings only name transitional Stage-A natives.
    let allowed = Map<str, bool>();
    for nat in transitional_native_bindings() { allowed.set(nat, true); }
    let natives = gm_split_lines(gate_fs_read_text(gm_join_path(root, "stdlib/core/builtins/native_calls.pilot")));
    let used = Map<str, bool>();
    var li = 0;
    while li < glist_len(natives) {
        let line: str = glist_get(natives, li);
        li = li + 1;
        let t = line.trim();
        if !t.starts_with("bind_native_") { continue; }
        let q2 = gm_find(t, "\");", 0);
        if q2 < 0 { continue; }
        var q1 = q2 - 1;
        while q1 > 0 && t.byte_at(q1) != 34 { q1 = q1 - 1; }
        let nat = t.slice(q1 + 1, q2);
        // A native is named by a word; a symbol such as `*_` names the `op`
        // member a construct calls (PROP-018), not a native.
        if !ab_is_word(nat) { continue; }
        used.set(nat, true);
        if !allowed.has(nat) {
            let _ = glist_push(violations, ab_viol("stdlib/core/builtins/native_calls.pilot", nat, f"Native binding to {nat} is not in transitional_native_bindings(); give the op an owner method instead"));
        }
    }
    for nat in transitional_native_bindings() {
        if !used.has(nat) {
            let _ = glist_push(violations, ab_viol("selfhost/gate/airlock_abi.pilot", nat, f"transitional_native_bindings() lists {nat}, which no binding uses; delete the entry (the table only shrinks)"));
        }
    }

    for row in airlock_pilot_errs() {
        let code = row.0;
        let ename = row.1;
        if !gm_contains(os_abi, ename) || !gm_contains(os_abi, f" {code},") {
            let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", ename, f"Frozen PilotErr::{ename} = {code} missing in os_abi.pilot"));
        }
    }
    for row in airlock_arch_kinds() {
        let code = row.0;
        let aname = row.1;
        if !gm_contains(os_abi, f"{aname}") || !gm_contains(os_abi, f" {code},") {
            let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", aname, f"Frozen OsArchKind::{aname} = {code} missing in os_abi.pilot"));
        }
    }
    for row in airlock_c_structs() {
        let sname = row.0;
        let fields = row.3;
        if !gm_contains(os_abi, f"pub struct {sname} : IValue") {
            let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", sname, f"Frozen C-ABI struct {sname} missing in os_abi.pilot"));
        }
        for f in fields {
            if !gm_contains(os_abi, f"pub {f}:") {
                let _ = glist_push(violations, ab_viol("stdlib/core/os_abi.pilot", f, f"Frozen C-ABI field {sname}.{f} missing in os_abi.pilot"));
            }
        }
    }
    for h in airlock_lang_hooks() {
        if !gm_contains(bridge_lang, f"{h}(") || !gm_contains(bridge_lang, f"__engine(\"{h}\"") {
            let _ = glist_push(violations, ab_viol("stdlib/core/bridge_lang.pilot", h, f"Frozen bridge_lang hook {h} missing or altered in bridge_lang.pilot"));
        }
    }
}
