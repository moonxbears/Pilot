// ==============================================================================
// FILE: selfhost/gate/bootstrap_parity.pilot
// Milestone 1 / F8: Stage-2 == Stage-3 Bootstrap Parity Gate (`GATE009`)
// ==============================================================================
// The real check: the seed builds stage 2 from the `selfhost/` compiler
// sources, stage 2 builds stage 3 from the same sources, and the two
// artifacts must be byte-identical (`sha256(stage2) == sha256(stage3)`).
// Building a stage needs the self-hosted driver of F8, so
// `pilotc_bootstrap_stage_c11` stops at the seam `bootstrap.stage_compile`.
// While that seam is registered this gate reports that it stops there
// (`at_seam`), never a pass.
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Gate.BootstrapParity;

/// The seam the stage build stops at; the id of the `seam(..)` call in
/// `pilotc_bootstrap_stage_c11` (`selfhost/pilotc.pilot`).
fn bp_stage_seam() -> str => "bootstrap.stage_compile";

/// The compiler sources a stage is built from.
fn bp_compiler_unit() -> str => "selfhost/pilotc.pilot";

fn bp_violation(snippet: str, message: str, remediation: str) -> GateViolation {
    return GateViolation {
        code: "GATE009",
        file_path: bp_compiler_unit(),
        line: 1,
        column: 1,
        offending_snippet: snippet,
        message: message,
        remediation: remediation,
    };
}

/// Builds stage 2 and stage 3 from `compiler_src` and adds a violation when
/// they differ. Reached only once `bootstrap.stage_compile` is connected.
fn bp_check_fixed_point(compiler_src: str, violations: i64) -> usize {
    let s2 = pilotc_bootstrap_stage_c11(::Stage2, compiler_src);
    let s3 = pilotc_bootstrap_stage_c11(::Stage3, compiler_src);
    let sha2 = sha256_hex(s2);
    let sha3 = sha256_hex(s3);
    if s2.len() == 0 || sha2 != sha3 {
        let _ = glist_push(violations, bp_violation(sha2 + " != " + sha3,
            "Stage-2 and Stage-3 compiler artifacts differ (not a fixed point)",
            "Make every pass of the self-hosted compiler deterministic"));
    }
    return 2;
}

pub fn execute_bootstrap_parity_gate(workspace_root: str, _opts: ref<GateRunOptions>) -> GateReport {
    let t0 = gate_time_now_us();
    let root = resolve_workspace_root(workspace_root);
    let violations = glist_new();
    var scanned = 0;

    let unit_rel = bp_compiler_unit();
    let compiler_src = gate_fs_read_text(gm_join_path(root, unit_rel));
    if compiler_src.len() == 0 {
        let _ = glist_push(violations, bp_violation(unit_rel,
            "Missing selfhost/pilotc.pilot bootstrap compiler",
            "Ensure selfhost/pilotc.pilot is present in selfhost/"));
    } else {
        scanned = scanned + 1;
        if gm_contains(compiler_src, "PILOTC_BINARY[") || gm_contains(compiler_src, "system(") {
            let _ = glist_push(violations, bp_violation("PILOTC_BINARY/system",
                "Forbidden static stub or subprocess call in selfhost/pilotc.pilot",
                "Compile Pilot source directly in pure Pilot without external shell calls"));
        }
    }

    let seam_id = bp_stage_seam();
    if glist_len(violations) == 0 && gate_seam_open(seam_id) {
        return gate_at_seam_report("bootstrap_parity", GateCategoryId.BootstrapParity, seam_id, t0, scanned);
    }
    if glist_len(violations) == 0 {
        scanned = scanned + bp_check_fixed_point(compiler_src, violations);
    }

    let dt = gate_time_now_us() - t0;
    let elapsed = if dt >= 0 { dt } else { 0 };
    if elapsed > bootstrap_budget_us() {
        let _ = glist_push(violations, bp_violation("" + elapsed + " us",
            "Bootstrap parity check exceeded compile-speed latency budget",
            "Optimize the self-hosted compiler hot loops"));
    }

    return GateReport {
        gate_id: "bootstrap_parity",
        category: GateCategoryId.BootstrapParity,
        passed: glist_len(violations) == 0,
        elapsed_us: elapsed,
        items_scanned: scanned,
        violations: violations,
        at_seam: "",
    };
}
