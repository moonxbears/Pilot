// ==============================================================================
// FILE: selfhost/gate/rename_litmus.pilot
// Milestone 1 / F4: Dual-Pass Universal Rename Litmus Gate (`GATE008`)
// ==============================================================================
// The check: copy `stdlib/`, `selfhost/` and the conformance corpus into a
// sandbox, rename the core type names there (pass 0: the AGENTS.md pairs;
// pass 1: the same names plus `str` with a seeded suffix), consistently in
// every copied file, then run `pilot test` in the sandbox. The seed reads its
// syntax, native bindings and primitives from the stdlib of the directory it
// runs in (`pilot_parser::set_source_root`), and its own Pilot sources from
// there too, so the renamed toolchain checks and runs the renamed programs
// with no change to the seed. Every program whose result changes is a
// `GATE008` violation.
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Gate.RenameLitmus;

pub fn rl_make_pair(from_ident: str, to_ident: str) -> i64 {
    let p = __engine("map_new");
    __engine("map_set", p, "from", from_ident);
    __engine("map_set", p, "to", to_ident);
    return p;
}

fn rl_seed_tag(seed_in: i64) -> str {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    var state = if seed_in == 0 { 1311768467294899695 } else { seed_in };
    var tag = "";
    var i = 0;
    while i < 6 {
        state = (state ^ (state >> 12)) & 2147483647;
        state = ((state * 1103515245) + 12345 + i) & 2147483647;
        let idx = state % 26;
        let pos = if idx < 0 { 0 - idx } else { idx };
        tag = tag + alphabet.slice(pos, pos + 1);
        i = i + 1;
    }
    return tag;
}

/// Pass 0: the canonical renames of AGENTS.md (Dual-Pass Universal Rename).
pub fn build_canonical_litmus_pairs() -> i64 {
    let pairs = glist_new();
    let _ = glist_push(pairs, rl_make_pair(nameof(char), "c32"));
    let _ = glist_push(pairs, rl_make_pair(nameof(slice), "window"));
    let _ = glist_push(pairs, rl_make_pair(nameof(option), "maybe"));
    let _ = glist_push(pairs, rl_make_pair(nameof(opt), "maybe"));
    let _ = glist_push(pairs, rl_make_pair(nameof(result), "outcome"));
    let _ = glist_push(pairs, rl_make_pair(nameof(res), "outcome"));
    let _ = glist_push(pairs, rl_make_pair(nameof(range), "interval"));
    return pairs;
}

/// Pass 1: the same names (plus `str`) renamed to seeded, unpredictable names.
pub fn build_seeded_litmus_pairs(seed_val: i64) -> i64 {
    let sfx = "_" + rl_seed_tag(seed_val);
    let pairs = glist_new();
    let _ = glist_push(pairs, rl_make_pair(nameof(char), "c32" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(slice), "window" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(option), "maybe" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(opt), "maybe" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(result), "outcome" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(res), "outcome" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(range), "interval" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(str), "utf8view" + sfx));
    return pairs;
}

fn rl_pairs_to_map(rename_pairs: i64) -> i64 {
    let rmap = __engine("map_new");
    let n = glist_len(rename_pairs);
    var i = 0;
    while i < n {
        let item = glist_get(rename_pairs, i);
        let k = __engine("map_get", item, "from");
        let v = __engine("map_get", item, "to");
        if k.len() > 0 && v.len() > 0 {
            __engine("map_set", rmap, k, v);
        }
        i = i + 1;
    }
    return rmap;
}

// Lexer-aware whole-identifier alpha-renamer (preserves comments & string literals)
pub pure fn rl_rename_pilot_identifiers(src: str, rmap: i64) -> str {
    let n = src.len();
    var out = "";
    var chunk_start = 0;
    var pos = 0;
    while pos < n {
        let b = src.byte_at(pos);
        if b == 47 && pos + 1 < n && src.byte_at(pos + 1) == 47 {
            pos = pos + 2;
            while pos < n && src.byte_at(pos) != 10 {
                pos = pos + 1;
            }
        } else if b == 47 && pos + 1 < n && src.byte_at(pos + 1) == 42 {
            pos = pos + 2;
            while pos + 1 < n {
                if src.byte_at(pos) == 42 && src.byte_at(pos + 1) == 47 {
                    pos = pos + 2;
                    break;
                }
                pos = pos + 1;
            }
        } else if b == 34 {
            pos = pos + 1;
            while pos < n {
                let sb = src.byte_at(pos);
                if sb == 92 && pos + 1 < n {
                    pos = pos + 2;
                } else if sb == 34 {
                    pos = pos + 1;
                    break;
                } else {
                    pos = pos + 1;
                }
            }
        } else if b == 39 {
            pos = pos + 1;
            while pos < n {
                let cb = src.byte_at(pos);
                if cb == 92 && pos + 1 < n {
                    pos = pos + 2;
                } else if cb == 39 {
                    pos = pos + 1;
                    break;
                } else {
                    pos = pos + 1;
                }
            }
        } else if sa_is_upper(b) || sa_is_lower(b) || b == 95 {
            let st = pos;
            pos = pos + 1;
            while pos < n && sa_is_id_char(src.byte_at(pos)) {
                pos = pos + 1;
            }
            let word = src.slice(st, pos);
            let repl = __engine("map_get", rmap, word) ?? "";
            if repl.len() > 0 {
                out = out + src.slice(chunk_start, st) + repl;
                chunk_start = pos;
            }
        } else {
            pos = pos + 1;
        }
    }
    if n > chunk_start {
        out = out + src.slice(chunk_start, n);
    }
    return out;
}

/// Where the conformance corpus lives, relative to the workspace root.
fn rl_conformance_dir() -> str => "tests/conformance";

/// The trees copied into the sandbox, renamed: the stdlib the programs and
/// the seed's tables come from, the toolchain's own Pilot sources, and the
/// conformance corpus.
fn rl_sandbox_trees() -> List<str> => ["stdlib", "selfhost", rl_conformance_dir()];

/// What `pilot test` printed and returned in the sandbox.
pub struct LitmusRun : IValue {
    pub stdout: str;
    pub stderr: str;
    pub exit_code: i64;
}

/// Runs `pilot test <corpus>` with `sandbox_dir` as the working directory,
/// so the toolchain takes `stdlib/` and `selfhost/` from the renamed copies.
pub fn rl_run_corpus(sandbox_dir: str) -> LitmusRun {
    let exe = current_exe() ?? "pilot";
    let out = run_in(sandbox_dir, exe, ["test", rl_conformance_dir()], "");
    return LitmusRun { stdout: out.stdout, stderr: out.stderr, exit_code: out.exit_code };
}

fn rl_violation(file_path: str, snippet: str, message: str, remediation: str) -> GateViolation {
    return GateViolation {
        code: "GATE008",
        file_path: file_path,
        line: 1,
        column: 1,
        offending_snippet: snippet,
        message: message,
        remediation: remediation,
    };
}

/// Renames whole words in plain text, such as the diagnostics a `.stderr`
/// expectation file quotes (`option<Pair>` -> `maybe<Pair>`).
pub pure fn rl_rename_words(text: str, rmap: i64) -> str {
    let n = text.len();
    var out = "";
    var chunk_start = 0;
    var pos = 0;
    while pos < n {
        let b = text.byte_at(pos);
        if sa_is_upper(b) || sa_is_lower(b) || b == 95 {
            let st = pos;
            pos = pos + 1;
            while pos < n && sa_is_id_char(text.byte_at(pos)) { pos = pos + 1; }
            let repl = __engine("map_get", rmap, text.slice(st, pos)) ?? "";
            if repl.len() > 0 {
                out = out + text.slice(chunk_start, st) + repl;
                chunk_start = pos;
            }
        } else if b >= 48 && b <= 57 {
            pos = pos + 1;
            while pos < n && sa_is_id_char(text.byte_at(pos)) { pos = pos + 1; }
        } else {
            pos = pos + 1;
        }
    }
    return out + text.slice(chunk_start, n);
}

/// The decimal number `s` holds, or -1 when it holds anything else.
fn rl_parse_count(s: str) -> i64 {
    if s.len() == 0 { return -1; }
    var v = 0;
    var i = 0;
    while i < s.len() {
        let d = s.byte_at(i) - 48;
        if d < 0 || d > 9 { return -1; }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

/// One `.stderr` expectation line in the renamed sandbox. A location
/// `<file>.pilot:<line>:<col>` keeps its file and line; its column moves by
/// what renaming the source line before it changed. Any other line has its
/// words renamed.
fn rl_rename_expectation(line: str, src_lines: i64, rmap: i64) -> str {
    let ext = ".pilot:";
    let at = gm_find(line, ext, 0);
    if at < 0 { return rl_rename_words(line, rmap); }
    let rest = line.slice(at + ext.len(), line.len());
    let colon = gm_find(rest, ":", 0);
    if colon < 0 { return rl_rename_words(line, rmap); }
    let row = rl_parse_count(rest.slice(0, colon));
    let col = rl_parse_count(gm_trim(rest.slice(colon + 1, rest.len())));
    if row < 1 || col < 1 || row > glist_len(src_lines) { return line; }
    let src_line = glist_get(src_lines, row - 1);
    let before = src_line.slice(0, if col - 1 < src_line.len() { col - 1 } else { src_line.len() });
    let moved = rl_rename_pilot_identifiers(before, rmap).len() + 1;
    return line.slice(0, at + ext.len()) + row + ":" + moved;
}

/// The lines of `s` in order, empty ones included, so index `k` is line
/// `k + 1`.
fn rl_source_lines(s: str) -> i64 {
    let out = glist_new();
    var p = 0;
    while p <= s.len() {
        var nx = gm_find(s, "\n", p);
        if nx < 0 { nx = s.len(); }
        var end_pos = nx;
        if end_pos > p && s.byte_at(end_pos - 1) == 13 { end_pos = end_pos - 1; }
        let _ = glist_push(out, s.slice(p, end_pos));
        p = nx + 1;
    }
    return out;
}

/// A `.stderr` expectation file renamed to match its renamed program, whose
/// original source is `program_src`.
fn rl_rename_stderr(text: str, program_src: str, rmap: i64) -> str {
    let src_lines = rl_source_lines(program_src);
    let lines = gm_split_lines(text);
    var out = "";
    var i = 0;
    while i < glist_len(lines) {
        out = out + rl_rename_expectation(glist_get(lines, i), src_lines, rmap) + "\n";
        i = i + 1;
    }
    return out;
}

/// Copies every file under `<root>/<src_rel>` to `<sandbox>/<dst_rel>`,
/// renaming identifiers in `.pilot` files. Returns the number of files copied.
fn rl_copy_renamed_tree(root: str, src_rel: str, sandbox_dir: str, dst_rel: str, rmap: i64, violations: i64) -> usize {
    let base = gm_join_path(root, src_rel);
    let files = gm_split_lines(gate_fs_walk_files(base));
    let n = glist_len(files);
    var copied = 0;
    var i = 0;
    while i < n {
        let path = glist_get(files, i);
        let rel = path.slice(base.len() + 1, path.len());
        let text = gate_fs_read_text(path);
        var out_text = text;
        if gm_ends_with(rel, ".pilot") {
            out_text = rl_rename_pilot_identifiers(text, rmap);
        } else if gm_ends_with(rel, ".stderr") {
            let program = path.slice(0, path.len() - 7) + ".pilot";
            out_text = rl_rename_stderr(text, gate_fs_read_text(program), rmap);
        }
        let out_path = gm_join_path(sandbox_dir, dst_rel + "/" + rel);
        if gate_fs_write_text(out_path, out_text) {
            copied = copied + 1;
        } else {
            let _ = glist_push(violations, rl_violation(out_path, out_path,
                "Failed to write a renamed file into the litmus sandbox",
                "Check write permissions for the TempDirGuard sandbox"));
        }
        i = i + 1;
    }
    if n == 0 {
        let _ = glist_push(violations, rl_violation(src_rel, base,
            "Nothing to copy into the litmus sandbox",
            "Run the gate from the workspace root"));
    }
    return copied;
}

/// The GATE008 violations of one corpus run: every program `pilot test`
/// reports as failing, or the run itself when it reports no result.
fn rl_corpus_violations(run: LitmusRun, violations: i64) {
    let lines = gm_split_lines(run.stdout);
    var saw_result = false;
    var i = 0;
    while i < glist_len(lines) {
        let line = glist_get(lines, i);
        if gm_starts_with(line, "RESULT: ") { saw_result = true; }
        if gm_starts_with(line, "FAIL ") || gm_starts_with(line, "FIXED ") {
            let detail = if i + 1 < glist_len(lines) { gm_trim(glist_get(lines, i + 1)) } else { "" };
            let _ = glist_push(violations, rl_violation(line.slice(5, line.len()), detail,
                "Program result changed after renaming core types: the toolchain depends on a core type name",
                "Derive the behaviour from layouts, field anatomy, syntax rules or method tables, not names"));
        }
        i = i + 1;
    }
    if !saw_result {
        let _ = glist_push(violations, rl_violation(rl_conformance_dir(), "exit " + run.exit_code,
            "`pilot test` in the renamed sandbox reported no result: " + gm_trim(run.stderr),
            "Run `pilot test` in the sandbox by hand to see where the toolchain stops"));
    }
}

/// One litmus pass: build the renamed sandbox, then run the corpus in it.
/// Returns the number of files copied plus programs run.
fn rl_run_pass(root: str, rename_pairs: i64, violations: i64) -> usize {
    let rmap = rl_pairs_to_map(rename_pairs);
    let sandbox_dir = "/tmp/pilot_litmus_" + gate_proc_pid() + "_" + gate_time_now_us();
    let guard = temp_guard_new(sandbox_dir);
    var scanned = 0;
    for tree in rl_sandbox_trees() {
        scanned = scanned + rl_copy_renamed_tree(root, tree, sandbox_dir, tree, rmap, violations);
    }
    if glist_len(violations) == 0 {
        rl_corpus_violations(rl_run_corpus(sandbox_dir), violations);
    }

    let _ = temp_guard_cleanup(guard);
    if gate_fs_exists(sandbox_dir) {
        let _ = glist_push(violations, rl_violation(sandbox_dir, sandbox_dir,
            "TempDirGuard failed to unlink ephemeral litmus sandbox directory",
            "Ensure fs_remove_all cleans up /tmp/pilot_litmus_* on scope exit"));
    }
    return scanned;
}

pub fn execute_universal_rename_litmus(workspace_root: str, rename_pairs: i64) -> GateReport {
    let t0 = gate_time_now_us();
    let root = resolve_workspace_root(workspace_root);
    let violations = glist_new();
    let scanned = rl_run_pass(root, rename_pairs, violations);
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: "rename_litmus",
        category: GateCategoryId.Adaptability,
        passed: glist_len(violations) == 0,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: scanned,
        violations: violations,
        at_seam: "",
    };
}

pub fn execute_dual_pass_rename_gate(workspace_root: str, opts: ref<GateRunOptions>) -> GateReport {
    let t0 = gate_time_now_us();
    let pass0 = execute_universal_rename_litmus(workspace_root, build_canonical_litmus_pairs());
    let pass1 = execute_universal_rename_litmus(workspace_root, build_seeded_litmus_pairs(opts.seed));
    let combined = glist_new();
    let _ = glist_extend(combined, pass0.violations);
    let _ = glist_extend(combined, pass1.violations);
    let scanned = pass0.items_scanned + pass1.items_scanned;
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: "rename_litmus",
        category: GateCategoryId.Adaptability,
        passed: glist_len(combined) == 0 && pass0.passed && pass1.passed,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: scanned,
        violations: combined,
        at_seam: "",
    };
}
