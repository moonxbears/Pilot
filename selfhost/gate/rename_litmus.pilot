// ==============================================================================
// FILE: selfhost/gate/rename_litmus.pilot
// Milestone 1 / F4: Dual-Pass Universal Rename Litmus Gate (`GATE008`)
// ==============================================================================
// The check: copy the workspace (every file a checkout has) into a
// sandbox, rename the core type names there (pass 0: the AGENTS.md pairs;
// pass 1: the same names plus `str` with a seeded suffix), consistently in
// every copied file, then run `pilot test` in the sandbox. The seed reads its
// syntax, native bindings and primitives from the stdlib of the directory it
// runs in (`pilot_parser::set_source_root`), and its own Pilot sources from
// there too, so the renamed toolchain checks and runs the renamed programs
// with no change to the seed. Every program whose result changes is a
// `GATE008` violation; a program that passes when run again by itself in
// the sandbox (it ran out of time under load), or that fails in the
// workspace too, with no renaming (its failure is the corpus run's to
// report), is not, so the gate fails only on a dependence on a name.
// ==============================================================================
pub lvl(0) pkg selfhost.gate;

use std.text;
use std.proc;

/// One rename: every whole identifier `from` becomes `to`.
pub struct RenamePair : IAnyValue {
    pub from: str;
    pub to: str;
}

pub fn rl_make_pair(from_ident: str, to_ident: str) -> RenamePair => RenamePair { from: from_ident, to: to_ident };

/// The renames of one pass: each name in the order it is searched for, and
/// its new name by old name.
pub struct RenameMap : IObject {
    pub names: List<str>;
    pub to: Map<str, str>;
}

fn rl_seed_tag(seed_in: i64) -> str {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    var state = if seed_in == 0 { 1311768467294899695 } else { seed_in };
    var tag = "";
    var i = 0;
    while i < 6 {
        state = (state ^ (state >> 12)) & 2147483647;
        state = ((state * 1103515245) + 12345 + i) & 2147483647;
        let idx = state % 26;
        let pos = if idx < 0 { 0 - idx } else { idx };
        tag = tag + alphabet.slice(pos, pos + 1);
        i = i + 1;
    }
    return tag;
}

/// Pass 0: the canonical renames of AGENTS.md (Dual-Pass Universal Rename).
pub fn build_canonical_litmus_pairs() -> List<RenamePair> => [
    rl_make_pair(nameof(char), "c32"),
    rl_make_pair(nameof(slice), "window"),
    rl_make_pair(nameof(option), "maybe"),
    rl_make_pair(nameof(opt), "maybe"),
    rl_make_pair(nameof(result), "outcome"),
    rl_make_pair(nameof(res), "outcome"),
    rl_make_pair(nameof(range), "interval"),
];

/// Pass 1: the same names (plus `str`) renamed to seeded, unpredictable names.
pub fn build_seeded_litmus_pairs(seed_val: i64) -> List<RenamePair> {
    let sfx = "_" + rl_seed_tag(seed_val);
    return [
        rl_make_pair(nameof(char), "c32" + sfx),
        rl_make_pair(nameof(slice), "window" + sfx),
        rl_make_pair(nameof(option), "maybe" + sfx),
        rl_make_pair(nameof(opt), "maybe" + sfx),
        rl_make_pair(nameof(result), "outcome" + sfx),
        rl_make_pair(nameof(res), "outcome" + sfx),
        rl_make_pair(nameof(range), "interval" + sfx),
        rl_make_pair(nameof(str), "utf8view" + sfx),
    ];
}

/// The renames of `rename_pairs`, a pair with an empty side left out.
fn rl_pairs_to_map(ref rename_pairs: List<RenamePair>) -> RenameMap {
    var names: List<str> = [];
    var to = Map<str, str>();
    for pr in rename_pairs {
        if pr.from.len() > 0 && pr.to.len() > 0 {
            if !to.has(pr.from) { names.push(pr.from); }
            to.set(pr.from, pr.to);
        }
    }
    return RenameMap { names: names, to: to };
}

/// The first place at or after `from` where `key` is a whole identifier as
/// the renamer reads one (a run of identifier bytes from its first letter or
/// `_`), or -1.
pure fn rl_next_identifier(src: str, key: str, from: i64) -> i64 {
    let n = src.len();
    let kl = key.len();
    var at = gm_find(src, key, from);
    while at >= 0 {
        if at + kl >= n || !sa_is_id_char(src.byte_at(at + kl)) {
            var st = at;
            while st > 0 && sa_is_id_char(src.byte_at(st - 1)) { st = st - 1; }
            while st < at && src.byte_at(st) >= 48 && src.byte_at(st) <= 57 { st = st + 1; }
            if st == at { return at; }
        }
        at = gm_find(src, key, at + 1);
    }
    return -1;
}

/// Where the string or char literal opened just before `from` ends: after
/// its `closer`, or at the end of `src`. A backslash takes the byte
/// after it.
pure fn rl_literal_end(src: str, closer: str, from: i64) -> i64 {
    let n = src.len();
    var p = from;
    var esc = gm_find(src, "\\", p);
    while p < n {
        let close = gm_find(src, closer, p);
        if esc >= 0 && esc < p { esc = gm_find(src, "\\", p); }
        if esc >= 0 && (close < 0 || esc < close) {
            p = esc + 2;
        } else if close >= 0 {
            return close + 1;
        } else {
            return n;
        }
    }
    return n;
}

/// An f-string with its holes renamed, and the place just after it.
struct RlPiece : IAnyValue {
    pub text: str;
    pub end: i64;
}

/// Whether the quote at `at` opens an f-string: an `f` right before it that
/// is not the end of a longer name.
pure fn rl_is_fstring(src: str, at: i64) -> bool {
    if at < 1 || src.byte_at(at - 1) != 102 { return false; }
    return at == 1 || !sa_is_id_char(src.byte_at(at - 2));
}

/// The f-string whose quote opens at `open`, with the names in its `{...}`
/// holes renamed (a hole is Pilot code; `{{` is text), and where it ends.
pure fn rl_fstring(src: str, open: i64, ref rmap: RenameMap) -> RlPiece {
    let n = src.len();
    let q = src.byte_at(open);
    var out: List<str> = [];
    var start = open;
    var p = open + 1;
    var closed = false;
    while p < n && !closed {
        let b = src.byte_at(p);
        if b == 92 {
            p = p + 2;
        } else if b == q {
            p = p + 1;
            closed = true;
        } else if b == 123 && p + 1 < n && src.byte_at(p + 1) == 123 {
            p = p + 2;
        } else if b == 123 {
            let end = rl_hole_end(src, p + 1, rmap);
            out.push(src.slice(start, p + 1) + rl_rename_pilot_identifiers(src.slice(p + 1, end), rmap));
            start = end;
            p = end;
        } else {
            p = p + 1;
        }
    }
    if p > n { p = n; }
    out.push(src.slice(start, p));
    return RlPiece { text: text.join_text(out, ""), end: p };
}

/// Where the f-string hole whose code starts at `from` ends: at its closing
/// `}`, braces counted and literals (nested f-strings too) skipped; or the
/// end of `src`.
pure fn rl_hole_end(src: str, from: i64, ref rmap: RenameMap) -> i64 {
    let n = src.len();
    var depth = 0;
    var p = from;
    while p < n {
        let b = src.byte_at(p);
        if (b == 34 || b == 39) && rl_is_fstring(src, p) {
            p = rl_fstring(src, p, rmap).end;
        } else if b == 34 {
            p = rl_literal_end(src, "\"", p + 1);
        } else if b == 39 {
            p = rl_literal_end(src, "'", p + 1);
        } else if b == 123 {
            depth = depth + 1;
            p = p + 1;
        } else if b == 125 {
            if depth == 0 { return p; }
            depth = depth - 1;
            p = p + 1;
        } else {
            p = p + 1;
        }
    }
    return n;
}

// Lexer-aware whole-identifier alpha-renamer (preserves comments & string
// literals, but renames inside f-string holes, which are code). It jumps
// from one comment, literal or name to be renamed to the next with
// `gm_find`, so the bytes between them are never read one by one: this runs
// over the whole stdlib, toolchain and corpus in each pass.
pub pure fn rl_rename_pilot_identifiers(src: str, ref rmap: RenameMap) -> str {
    let n = src.len();
    let key_count = rmap.names.len() as i64;
    var keys: List<str> = [];
    var repls: List<str> = [];
    // Per name, its next whole-identifier place; -1 when there is none
    // left, -2 before the first search.
    var key_at: List<i64> = [];
    var k = 0;
    while k < key_count {
        let key = rmap.names[k];
        keys.push(key);
        repls.push(rmap.to.get(key) ?? key);
        key_at.push(-2);
        k = k + 1;
    }
    // The next `"`, `'`, `//` and `/*`, kept the same way.
    var quote_at = -2;
    var tick_at = -2;
    var line_at = -2;
    var block_at = -2;
    var out: List<str> = [];
    var chunk_start = 0;
    var pos = 0;
    while pos < n {
        if quote_at != -1 && quote_at < pos { quote_at = gm_find(src, "\"", pos); }
        if tick_at != -1 && tick_at < pos { tick_at = gm_find(src, "'", pos); }
        if line_at != -1 && line_at < pos { line_at = gm_find(src, "//", pos); }
        if block_at != -1 && block_at < pos { block_at = gm_find(src, "/*", pos); }
        var first = n;
        var what = -1;
        if quote_at >= 0 && quote_at < first { first = quote_at; what = -2; }
        if tick_at >= 0 && tick_at < first { first = tick_at; what = -3; }
        if line_at >= 0 && line_at < first { first = line_at; what = -4; }
        if block_at >= 0 && block_at < first { first = block_at; what = -5; }
        k = 0;
        while k < key_count {
            var at = key_at[k];
            if at != -1 && at < pos {
                at = rl_next_identifier(src, keys[k], pos);
                key_at[k] = at;
            }
            if at >= 0 && at < first { first = at; what = k; }
            k = k + 1;
        }
        if what == -1 {
            break;
        } else if (what == -2 || what == -3) && rl_is_fstring(src, first) {
            let piece = rl_fstring(src, first, rmap);
            out.push(src.slice(chunk_start, first) + piece.text);
            pos = piece.end;
            chunk_start = pos;
        } else if what == -2 {
            pos = rl_literal_end(src, "\"", first + 1);
        } else if what == -3 {
            pos = rl_literal_end(src, "'", first + 1);
        } else if what == -4 {
            let nl = gm_find(src, "\n", first + 2);
            pos = if nl < 0 { n } else { nl };
        } else if what == -5 {
            let close = gm_find(src, "*/", first + 2);
            pos = if close < 0 { n } else { close + 2 };
        } else {
            out.push(src.slice(chunk_start, first) + repls[what]);
            pos = first + keys[what].len();
            chunk_start = pos;
        }
    }
    if n > chunk_start {
        out.push(src.slice(chunk_start, n));
    }
    return text.join_text(out, "");
}

/// Where the conformance corpus lives, relative to the workspace root.
fn rl_conformance_dir() -> str => "tests/conformance";

/// Directory names a sandbox built without git leaves out wherever they
/// are: build output and package caches. Hidden directories (`.git`,
/// `.claude`, ..) are left out too.
const RL_SKIPPED_DIRS: List<str> = ["target", "node_modules",];

fn rl_skips_dir(name: str) -> bool {
    if gm_starts_with(name, ".") { return true; }
    for d in RL_SKIPPED_DIRS {
        if d == name { return true; }
    }
    return false;
}

/// The workspace files the sandbox holds, relative to `root`: every file a
/// checkout has (tracked, or new and not ignored), so a program that reads
/// any workspace file finds it renamed in the sandbox and this gate never
/// needs to know which files programs read. Without git, every file under
/// `root` outside `rl_skips_dir` directories.
fn rl_workspace_files(root: str) -> List<str> {
    let listed = run_in(root, "git", ["ls-files", "--cached", "--others", "--exclude-standard"], "");
    var out: List<str> = [];
    if listed.exit_code == 0 {
        for line in gm_split_lines(listed.stdout) {
            let rel = gm_trim(line);
            // A tracked file deleted from the working tree is not there.
            if rel.len() > 0 && gate_fs_exists(gm_join_path(root, rel)) { out.push(rel); }
        }
        return out;
    }
    rl_walk_workspace(root, "", out);
    return out;
}

fn rl_walk_workspace(root: str, rel: str, var ref out: List<str>) {
    let dir = if rel == "" { root } else { gm_join_path(root, rel) };
    for f in gate_fs_list_files(dir) {
        out.push(if rel == "" { f } else { rel + "/" + f });
    }
    for d in gate_fs_list_dirs(dir) {
        if !rl_skips_dir(d) { rl_walk_workspace(root, if rel == "" { d } else { rel + "/" + d }, out); }
    }
}

/// What `pilot test` printed and returned in the sandbox.
pub struct LitmusRun : IAnyValue {
    pub stdout: str;
    pub stderr: str;
    pub exit_code: i64;
}

/// Runs `pilot test <corpus>` with `sandbox_dir` as the working directory,
/// so the toolchain takes `stdlib/` and `selfhost/` from the renamed copies.
pub fn rl_run_corpus(sandbox_dir: str) -> LitmusRun {
    let exe = current_exe() ?? "pilot";
    let out = run_in(sandbox_dir, exe, ["test", rl_conformance_dir()], "");
    return LitmusRun { stdout: out.stdout, stderr: out.stderr, exit_code: out.exit_code };
}

fn rl_violation(file_path: str, snippet: str, message: str, remediation: str) -> GateViolation {
    return GateViolation {
        code: "GATE008",
        file_path: file_path,
        line: 1,
        column: 1,
        offending_snippet: snippet,
        message: message,
        remediation: remediation,
    };
}

/// Renames whole words in plain text, such as the diagnostics a `.stderr`
/// expectation file quotes (`option<Pair>` -> `maybe<Pair>`).
pub pure fn rl_rename_words(words: str, ref rmap: RenameMap) -> str {
    let n = words.len();
    var out = "";
    var chunk_start = 0;
    var pos = 0;
    while pos < n {
        let b = words.byte_at(pos);
        if sa_is_upper(b) || sa_is_lower(b) || b == 95 {
            let st = pos;
            pos = pos + 1;
            while pos < n && sa_is_id_char(words.byte_at(pos)) { pos = pos + 1; }
            let repl = rmap.to.get(words.slice(st, pos)) ?? "";
            if repl.len() > 0 {
                out = out + words.slice(chunk_start, st) + repl;
                chunk_start = pos;
            }
        } else if b >= 48 && b <= 57 {
            pos = pos + 1;
            while pos < n && sa_is_id_char(words.byte_at(pos)) { pos = pos + 1; }
        } else {
            pos = pos + 1;
        }
    }
    return out + words.slice(chunk_start, n);
}

/// The decimal number `s` holds, or -1 when it holds anything else.
fn rl_parse_count(s: str) -> i64 {
    if s.len() == 0 { return -1; }
    var v = 0;
    var i = 0;
    while i < s.len() {
        let d = s.byte_at(i) - 48;
        if d < 0 || d > 9 { return -1; }
        v = v * 10 + d;
        i = i + 1;
    }
    return v;
}

/// One `.stderr` expectation line in the renamed sandbox. A location
/// `<file>.pilot:<line>:<col>` keeps its file and line; its column moves by
/// what renaming the source line before it changed. Any other line has its
/// words renamed.
fn rl_rename_expectation(line: str, ref src_lines: List<str>, ref rmap: RenameMap) -> str {
    let ext = ".pilot:";
    let at = gm_find(line, ext, 0);
    if at < 0 { return rl_rename_words(line, rmap); }
    let rest = line.slice(at + ext.len(), line.len());
    let colon = gm_find(rest, ":", 0);
    if colon < 0 { return rl_rename_words(line, rmap); }
    let row = rl_parse_count(rest.slice(0, colon));
    let col = rl_parse_count(gm_trim(rest.slice(colon + 1, rest.len())));
    if row < 1 || col < 1 || row > src_lines.len() as i64 { return line; }
    let src_line = src_lines[row - 1];
    let before = src_line.slice(0, if col - 1 < src_line.len() { col - 1 } else { src_line.len() });
    let moved = rl_rename_pilot_identifiers(before, rmap).len() + 1;
    return line.slice(0, at + ext.len()) + row + ":" + moved;
}

/// The lines of `s` in order, empty ones included, so index `k` is line
/// `k + 1`.
fn rl_source_lines(s: str) -> List<str> {
    var out: List<str> = [];
    var p = 0;
    while p <= s.len() {
        var nx = gm_find(s, "\n", p);
        if nx < 0 { nx = s.len(); }
        var end_pos = nx;
        if end_pos > p && s.byte_at(end_pos - 1) == 13 { end_pos = end_pos - 1; }
        out.push(s.slice(p, end_pos));
        p = nx + 1;
    }
    return out;
}

/// A `.stderr` expectation file renamed to match its renamed program, whose
/// original source is `program_src`.
fn rl_rename_stderr(body: str, program_src: str, ref rmap: RenameMap) -> str {
    let src_lines = rl_source_lines(program_src);
    var out = "";
    for line in gm_split_lines(body) {
        out = out + rl_rename_expectation(line, src_lines, rmap) + "\n";
    }
    return out;
}

/// Copies `<root>/<rel>` to `<sandbox_dir>/<rel>`, renaming identifiers in
/// a `.pilot` file and the expectations of a `.stderr` file. Whether it was
/// written.
fn rl_copy_renamed_file(root: str, rel: str, sandbox_dir: str, ref rmap: RenameMap, var ref violations: List<GateViolation>) -> bool {
    let path = gm_join_path(root, rel);
    let file_text = gate_fs_read_text(path);
    var out_text = file_text;
    if gm_ends_with(rel, ".pilot") {
        out_text = rl_rename_pilot_identifiers(file_text, rmap);
    } else if gm_ends_with(rel, ".stderr") {
        let program = path.slice(0, path.len() - 7) + ".pilot";
        // Only `<file>.pilot:` locations read the program's source.
        let program_src = if gm_find(file_text, ".pilot:", 0) >= 0 && gate_fs_exists(program) { gate_fs_read_text(program) } else { "" };
        out_text = rl_rename_stderr(file_text, program_src, rmap);
    }
    let out_path = gm_join_path(sandbox_dir, rel);
    if gate_fs_write_text(out_path, out_text) { return true; }
    violations.push(rl_violation(out_path, out_path,
        "Failed to write a renamed file into the litmus sandbox",
        "Check write permissions for the TempDirGuard sandbox"));
    return false;
}

/// The name of the program a `pilot test` result line reports as failing
/// (`FAIL <name>`, `FIXED <name>: ..`), or "" for any other line. Only a
/// program of the corpus counts: a failing program's diff can quote the
/// result lines of a `pilot test` it ran itself (`runtime/test_timeout`
/// runs `tests/tool_fixtures/test_timeout`), and those are not the run's.
fn rl_failed_program(line: str) -> str {
    var name = "";
    if gm_starts_with(line, "FAIL ") { name = gm_trim(line.slice(5, line.len())); }
    if gm_starts_with(line, "FIXED ") {
        let rest = line.slice(6, line.len());
        let colon = gm_find(rest, ":", 0);
        name = gm_trim(if colon < 0 { rest } else { rest.slice(0, colon) });
    }
    if !gm_starts_with(name, rl_conformance_dir() + "/") { return ""; }
    return name;
}

/// The programs among `programs` that fail when `pilot test` runs them
/// again, by themselves, in `dir`; none when that run gives no result.
fn rl_failing_in(dir: str, ref programs: List<str>) -> List<str>? {
    var out: List<str> = [];
    if programs.len() == 0 { return out; }
    var args: List<str> = ["test",];
    for p in programs { args.push(p); }
    let run = run_in(dir, current_exe() ?? "pilot", args, "");
    var saw_result = false;
    for line in gm_split_lines(run.stdout) {
        if gm_starts_with(line, "RESULT: ") { saw_result = true; }
        let name = rl_failed_program(line);
        if name.len() > 0 { out.push(name); }
    }
    if !saw_result { return none; }
    return out;
}

/// The GATE008 violations of one corpus run in the sandbox `sandbox_dir`:
/// every program `pilot test` reports as failing that fails again when run
/// by itself in the sandbox (once the corpus is done, the sandbox's lexers
/// built, so a program that only ran out of time under the corpus's load
/// passes) and passes in the workspace itself (so only a change renaming
/// caused is reported); or the run itself when it reports no result.
fn rl_corpus_violations(root: str, sandbox_dir: str, run: LitmusRun, var ref violations: List<GateViolation>) {
    let lines = gm_split_lines(run.stdout);
    var saw_result = false;
    var failed: List<str> = [];
    var details: List<str> = [];
    let n_lines = lines.len() as i64;
    var i = 0;
    while i < n_lines {
        let line = lines[i];
        if gm_starts_with(line, "RESULT: ") { saw_result = true; }
        let name = rl_failed_program(line);
        if name.len() > 0 {
            failed.push(name);
            details.push(if i + 1 < n_lines { gm_trim(lines[i + 1]) } else { "" });
        }
        i = i + 1;
    }
    if !saw_result {
        violations.push(rl_violation(rl_conformance_dir(), "exit " + run.exit_code,
            "`pilot test` in the renamed sandbox reported no result: " + gm_trim(run.stderr),
            "Run `pilot test` in the sandbox by hand to see where the toolchain stops"));
        return;
    }
    let again = rl_failing_in(sandbox_dir, failed) ?? failed;
    let unrenamed = rl_failing_in(root, again) ?? [];
    var k = 0;
    while k < failed.len() as i64 {
        if again.contains(failed[k]) && !unrenamed.contains(failed[k]) {
            violations.push(rl_violation(failed[k], details[k],
                "Program result changed after renaming core types: the toolchain or the program depends on a core type name",
                "Derive the behaviour from layouts, field anatomy, syntax rules or method tables, not names; write a name as `nameof(..)`, not a string; compare printed source with a renamed fixture file, not a `.stdout` line"));
        }
        k = k + 1;
    }
}

/// A renamed sandbox: where it is, the guard that removes it, and the
/// number of files copied into it.
struct LitmusSandbox : IAnyValue {
    pub dir: str;
    pub guard: TempDirGuard;
    pub copied: i64;
}

/// Builds the renamed sandbox for `rename_pairs`: every file of
/// `rl_workspace_files(root)` copied from `root` with the names renamed.
fn rl_build_sandbox(root: str, ref files: List<str>, ref rename_pairs: List<RenamePair>, var ref violations: List<GateViolation>) -> LitmusSandbox {
    let rmap = rl_pairs_to_map(rename_pairs);
    let sandbox_dir = "/tmp/pilot_litmus_" + gate_proc_pid() + "_" + gate_time_now_us();
    let guard = temp_guard_new(sandbox_dir);
    var copied = 0;
    for rel in files {
        if rl_copy_renamed_file(root, rel, sandbox_dir, rmap, violations) { copied = copied + 1; }
    }
    if files.len() == 0 {
        violations.push(rl_violation(root, root,
            "Nothing to copy into the litmus sandbox",
            "Run the gate from the workspace root"));
    }
    return LitmusSandbox { dir: sandbox_dir, guard: guard, copied: copied };
}

/// Removes the sandbox; one that is still there is a violation.
fn rl_remove_sandbox(var ref sb: LitmusSandbox, var ref violations: List<GateViolation>) {
    let _ = temp_guard_cleanup(sb.guard);
    if gate_fs_exists(sb.dir) {
        violations.push(rl_violation(sb.dir, sb.dir,
            "TempDirGuard failed to unlink ephemeral litmus sandbox directory",
            "Ensure fs_remove_all cleans up /tmp/pilot_litmus_* on scope exit"));
    }
}

/// Starts `pilot test <corpus>` in the sandbox `dir` and returns at once.
fn rl_start_corpus(dir: str) -> ProcessHandle {
    let exe = current_exe() ?? "pilot";
    return spawn_in(dir, exe, ["test", rl_conformance_dir()], "");
}

/// What the corpus run started by `rl_start_corpus` left.
fn rl_finish_corpus(running: ProcessHandle) -> LitmusRun {
    let out = running.wait();
    return LitmusRun { stdout: out.stdout, stderr: out.stderr, exit_code: out.exit_code };
}

/// One litmus pass: build the renamed sandbox, then run the corpus in it.
/// Returns the number of files copied plus programs run.
fn rl_run_pass(root: str, ref rename_pairs: List<RenamePair>, var ref violations: List<GateViolation>) -> i64 {
    let files = rl_workspace_files(root);
    var sb = rl_build_sandbox(root, files, rename_pairs, violations);
    if violations.len() == 0 {
        rl_corpus_violations(root, sb.dir, rl_run_corpus(sb.dir), violations);
    }
    rl_remove_sandbox(sb, violations);
    return sb.copied;
}

pub fn execute_universal_rename_litmus(workspace_root: str, ref rename_pairs: List<RenamePair>) -> GateReport {
    let t0 = gate_time_now_us();
    let root = resolve_workspace_root(workspace_root);
    var violations: List<GateViolation> = [];
    let scanned = rl_run_pass(root, rename_pairs, violations);
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: "rename_litmus",
        category: GateCategoryId.Adaptability,
        passed: violations.len() == 0,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: scanned,
        violations: violations,
        at_seam: "",
    };
}

/// Both passes. The two sandboxes are built first, then both corpus runs
/// go at once, so the end of one run, when only its slowest programs are
/// left, overlaps the other instead of leaving the machine idle.
pub fn execute_dual_pass_rename_gate(workspace_root: str, ref opts: GateRunOptions) -> GateReport {
    let t0 = gate_time_now_us();
    let root = resolve_workspace_root(workspace_root);
    var violations0: List<GateViolation> = [];
    var violations1: List<GateViolation> = [];
    let files = rl_workspace_files(root);
    var sb0 = rl_build_sandbox(root, files, build_canonical_litmus_pairs(), violations0);
    var sb1 = rl_build_sandbox(root, files, build_seeded_litmus_pairs(opts.seed), violations1);
    if violations0.len() == 0 && violations1.len() == 0 {
        let run0 = rl_start_corpus(sb0.dir);
        let run1 = rl_start_corpus(sb1.dir);
        // Both runs finish before either's failures are run again, so the
        // reruns do not compete with a corpus run.
        let done0 = rl_finish_corpus(run0);
        let done1 = rl_finish_corpus(run1);
        rl_corpus_violations(root, sb0.dir, done0, violations0);
        rl_corpus_violations(root, sb1.dir, done1, violations1);
    }
    rl_remove_sandbox(sb0, violations0);
    rl_remove_sandbox(sb1, violations1);
    var combined: List<GateViolation> = [];
    for v in violations0 { combined.push(v); }
    for v in violations1 { combined.push(v); }
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: "rename_litmus",
        category: GateCategoryId.Adaptability,
        passed: combined.len() == 0,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: sb0.copied + sb1.copied,
        violations: combined,
        at_seam: "",
    };
}
