// ==============================================================================
// FILE: selfhost/gate/rename_litmus.pilot
// Milestone 1 / F4: Dual-Pass Universal Rename Litmus Gate (`GATE008`)
// ==============================================================================
// The check: copy `stdlib/` and the conformance programs into a sandbox,
// rename the core type names there (pass 0: the AGENTS.md pairs; pass 1: the
// same names with a seeded suffix), consistently in every copied file, then
// run each conformance program with `pilot run` against the sandbox stdlib and
// compare its stdout and exit code with the program's expectation files.
// Running a program needs process spawn (F6), so `rl_run_program` stops at
// the seam `gate.litmus_run_program`. The sandbox is built for real; while the
// seam is registered the gate reports that it stops there (`at_seam`), never a
// pass.
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Gate.RenameLitmus;

pub fn rl_make_pair(from_ident: str, to_ident: str) -> i64 {
    let p = __engine("map_new");
    __engine("map_set", p, "from", from_ident);
    __engine("map_set", p, "to", to_ident);
    return p;
}

fn rl_seed_tag(seed_in: i64) -> str {
    let alphabet = "abcdefghijklmnopqrstuvwxyz";
    var state = if seed_in == 0 { 1311768467294899695 } else { seed_in };
    var tag = "";
    var i = 0;
    while i < 6 {
        state = (state ^ (state >> 12)) & 2147483647;
        state = ((state * 1103515245) + 12345 + i) & 2147483647;
        let idx = state % 26;
        let pos = if idx < 0 { 0 - idx } else { idx };
        tag = tag + alphabet.slice(pos, pos + 1);
        i = i + 1;
    }
    return tag;
}

/// Pass 0: the canonical renames of AGENTS.md (Dual-Pass Universal Rename).
pub fn build_canonical_litmus_pairs() -> i64 {
    let pairs = glist_new();
    let _ = glist_push(pairs, rl_make_pair(nameof(char), "c32"));
    let _ = glist_push(pairs, rl_make_pair(nameof(slice), "window"));
    let _ = glist_push(pairs, rl_make_pair(nameof(option), "maybe"));
    let _ = glist_push(pairs, rl_make_pair(nameof(opt), "maybe"));
    let _ = glist_push(pairs, rl_make_pair(nameof(result), "outcome"));
    let _ = glist_push(pairs, rl_make_pair(nameof(res), "outcome"));
    let _ = glist_push(pairs, rl_make_pair(nameof(range), "interval"));
    return pairs;
}

/// Pass 1: the same names (plus `str`) renamed to seeded, unpredictable names.
pub fn build_seeded_litmus_pairs(seed_val: i64) -> i64 {
    let sfx = "_" + rl_seed_tag(seed_val);
    let pairs = glist_new();
    let _ = glist_push(pairs, rl_make_pair(nameof(char), "c32" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(slice), "window" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(option), "maybe" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(opt), "maybe" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(result), "outcome" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(res), "outcome" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(range), "interval" + sfx));
    let _ = glist_push(pairs, rl_make_pair(nameof(str), "utf8view" + sfx));
    return pairs;
}

fn rl_pairs_to_map(rename_pairs: i64) -> i64 {
    let rmap = __engine("map_new");
    let n = glist_len(rename_pairs);
    var i = 0;
    while i < n {
        let item = glist_get(rename_pairs, i);
        let k = __engine("map_get", item, "from");
        let v = __engine("map_get", item, "to");
        if k.len() > 0 && v.len() > 0 {
            __engine("map_set", rmap, k, v);
        }
        i = i + 1;
    }
    return rmap;
}

// Lexer-aware whole-identifier alpha-renamer (preserves comments & string literals)
pub pure fn rl_rename_pilot_identifiers(src: str, rmap: i64) -> str {
    let n = src.len();
    var out = "";
    var chunk_start = 0;
    var pos = 0;
    while pos < n {
        let b = src.byte_at(pos);
        if b == 47 && pos + 1 < n && src.byte_at(pos + 1) == 47 {
            pos = pos + 2;
            while pos < n && src.byte_at(pos) != 10 {
                pos = pos + 1;
            }
        } else if b == 47 && pos + 1 < n && src.byte_at(pos + 1) == 42 {
            pos = pos + 2;
            while pos + 1 < n {
                if src.byte_at(pos) == 42 && src.byte_at(pos + 1) == 47 {
                    pos = pos + 2;
                    break;
                }
                pos = pos + 1;
            }
        } else if b == 34 {
            pos = pos + 1;
            while pos < n {
                let sb = src.byte_at(pos);
                if sb == 92 && pos + 1 < n {
                    pos = pos + 2;
                } else if sb == 34 {
                    pos = pos + 1;
                    break;
                } else {
                    pos = pos + 1;
                }
            }
        } else if b == 39 {
            pos = pos + 1;
            while pos < n {
                let cb = src.byte_at(pos);
                if cb == 92 && pos + 1 < n {
                    pos = pos + 2;
                } else if cb == 39 {
                    pos = pos + 1;
                    break;
                } else {
                    pos = pos + 1;
                }
            }
        } else if sa_is_upper(b) || sa_is_lower(b) || b == 95 {
            let st = pos;
            pos = pos + 1;
            while pos < n && sa_is_id_char(src.byte_at(pos)) {
                pos = pos + 1;
            }
            let word = src.slice(st, pos);
            let repl = __engine("map_get", rmap, word) ?? "";
            if repl.len() > 0 {
                out = out + src.slice(chunk_start, st) + repl;
                chunk_start = pos;
            }
        } else {
            pos = pos + 1;
        }
    }
    if n > chunk_start {
        out = out + src.slice(chunk_start, n);
    }
    return out;
}

/// The seam a program run stops at; the id of the `seam(..)` call in
/// `rl_run_program`.
fn rl_run_seam() -> str => "gate.litmus_run_program";

/// Where the conformance programs live, relative to the workspace root.
fn rl_conformance_dir() -> str => "tests/conformance";

/// What one program run printed and returned.
[Layout(c_abi)]
pub struct LitmusRun : IValue {
    pub stdout: str;
    pub exit_code: i64;
}

/// Runs `pilot run <program_rel> <args..>` with `sandbox_dir` as the working
/// directory, so the toolchain resolves `stdlib/` to the renamed copy.
pub fn rl_run_program(sandbox_dir: str, program_rel: str, args: i64) -> LitmusRun {
    return seam("gate.litmus_run_program",
        "running a program needs a process-spawn intrinsic (F6) to start `pilot run` in the sandbox");
}

fn rl_violation(file_path: str, snippet: str, message: str, remediation: str) -> GateViolation {
    return GateViolation {
        code: "GATE008",
        file_path: file_path,
        line: 1,
        column: 1,
        offending_snippet: snippet,
        message: message,
        remediation: remediation,
    };
}

/// Copies every file under `<root>/<src_rel>` to `<sandbox>/<dst_rel>`,
/// renaming identifiers in `.pilot` files. Returns the number of files copied.
fn rl_copy_renamed_tree(root: str, src_rel: str, sandbox_dir: str, dst_rel: str, rmap: i64, violations: i64) -> usize {
    let base = gm_join_path(root, src_rel);
    let files = gm_split_lines(gate_fs_walk_files(base));
    let n = glist_len(files);
    var copied = 0;
    var i = 0;
    while i < n {
        let path = glist_get(files, i);
        let rel = path.slice(base.len() + 1, path.len());
        let text = gate_fs_read_text(path);
        let out_text = if gm_ends_with(rel, ".pilot") { rl_rename_pilot_identifiers(text, rmap) } else { text };
        let out_path = gm_join_path(sandbox_dir, dst_rel + "/" + rel);
        if gate_fs_write_text(out_path, out_text) {
            copied = copied + 1;
        } else {
            let _ = glist_push(violations, rl_violation(out_path, out_path,
                "Failed to write a renamed file into the litmus sandbox",
                "Check write permissions for the TempDirGuard sandbox"));
        }
        i = i + 1;
    }
    if n == 0 {
        let _ = glist_push(violations, rl_violation(src_rel, base,
            "Nothing to copy into the litmus sandbox",
            "Run the gate from the workspace root"));
    }
    return copied;
}

/// The conformance programs the litmus runs: the top-level `*.pilot` files of
/// `tests/conformance` that have a `.stdout` expectation.
fn rl_conformance_programs(root: str) -> i64 {
    let dir = gm_join_path(root, rl_conformance_dir());
    let files = gm_split_lines(gate_fs_walk_files(dir));
    let programs = glist_new();
    var i = 0;
    while i < glist_len(files) {
        let path = glist_get(files, i);
        let rel = path.slice(dir.len() + 1, path.len());
        if gm_ends_with(rel, ".pilot") && gm_find(rel, "/", 0) < 0 {
            let stem = rel.slice(0, rel.len() - 6);
            if gate_fs_exists(gm_join_path(dir, stem + ".stdout")) {
                let _ = glist_push(programs, stem);
            }
        }
        i = i + 1;
    }
    return programs;
}

/// Runs one renamed program and compares it with its expectation files.
fn rl_check_program(root: str, sandbox_dir: str, stem: str, violations: i64) -> bool {
    let dir = gm_join_path(root, rl_conformance_dir());
    let expected_out = gate_fs_read_text(gm_join_path(dir, stem + ".stdout"));
    let exit_text = gm_trim(gate_fs_read_text(gm_join_path(dir, stem + ".exit")));
    var expected_exit = 0;
    var k = 0;
    while k < exit_text.len() {
        expected_exit = expected_exit * 10 + (exit_text.byte_at(k) - 48);
        k = k + 1;
    }
    let args = gm_split_lines(gate_fs_read_text(gm_join_path(dir, stem + ".args")));
    let run = rl_run_program(sandbox_dir, "progs/" + stem + ".pilot", args);
    if run.stdout != expected_out || run.exit_code != expected_exit {
        let _ = glist_push(violations, rl_violation(rl_conformance_dir() + "/" + stem + ".pilot",
            "exit " + run.exit_code + " (expected " + expected_exit + ")",
            "Program output changed after renaming core types: the toolchain depends on a core type name",
            "Derive the behaviour from layouts, field anatomy, syntax rules or method tables, not names"));
        return false;
    }
    return true;
}

/// One litmus pass: build the renamed sandbox, then run every program in it.
/// Returns the number of items handled; sets `stopped` when the program runs
/// stop at `gate.litmus_run_program`.
fn rl_run_pass(root: str, rename_pairs: i64, violations: i64, stopped: i64) -> usize {
    let rmap = rl_pairs_to_map(rename_pairs);
    let sandbox_dir = "/tmp/pilot_litmus_" + gate_proc_pid() + "_" + gate_time_now_us();
    let guard = temp_guard_new(sandbox_dir);
    var scanned = rl_copy_renamed_tree(root, "stdlib", sandbox_dir, "stdlib", rmap, violations);
    scanned = scanned + rl_copy_renamed_tree(root, rl_conformance_dir() + "/lib", sandbox_dir, "progs/lib", rmap, violations);

    let programs = rl_conformance_programs(root);
    let dir = gm_join_path(root, rl_conformance_dir());
    var i = 0;
    while i < glist_len(programs) {
        let stem = glist_get(programs, i);
        let src = rl_rename_pilot_identifiers(gate_fs_read_text(gm_join_path(dir, stem + ".pilot")), rmap);
        if gate_fs_write_text(gm_join_path(sandbox_dir, "progs/" + stem + ".pilot"), src) {
            scanned = scanned + 1;
        }
        i = i + 1;
    }
    if glist_len(programs) == 0 {
        let _ = glist_push(violations, rl_violation(rl_conformance_dir(), dir,
            "No conformance programs with .stdout expectations found",
            "Run the gate from the workspace root"));
    }

    if glist_len(violations) == 0 && gate_seam_open(rl_run_seam()) {
        __engine("map_set", stopped, "seam", rl_run_seam());
    } else if glist_len(violations) == 0 {
        var p = 0;
        while p < glist_len(programs) {
            let _ = rl_check_program(root, sandbox_dir, glist_get(programs, p), violations);
            p = p + 1;
        }
    }

    let _ = temp_guard_cleanup(guard);
    if gate_fs_exists(sandbox_dir) {
        let _ = glist_push(violations, rl_violation(sandbox_dir, sandbox_dir,
            "TempDirGuard failed to unlink ephemeral litmus sandbox directory",
            "Ensure fs_remove_all cleans up /tmp/pilot_litmus_* on scope exit"));
    }
    return scanned;
}

pub fn execute_universal_rename_litmus(workspace_root: str, rename_pairs: i64) -> GateReport {
    let t0 = gate_time_now_us();
    let root = resolve_workspace_root(workspace_root);
    let violations = glist_new();
    let stopped = __engine("map_new");
    let scanned = rl_run_pass(root, rename_pairs, violations, stopped);
    let seam_id = __engine("map_get", stopped, "seam") ?? "";
    if seam_id.len() > 0 {
        return gate_at_seam_report("rename_litmus", GateCategoryId.Adaptability, seam_id, t0, scanned);
    }
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: "rename_litmus",
        category: GateCategoryId.Adaptability,
        passed: glist_len(violations) == 0,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: scanned,
        violations: violations,
        at_seam: "",
    };
}

pub fn execute_dual_pass_rename_gate(workspace_root: str, opts: ref<GateRunOptions>) -> GateReport {
    let t0 = gate_time_now_us();
    let pass0 = execute_universal_rename_litmus(workspace_root, build_canonical_litmus_pairs());
    let pass1 = execute_universal_rename_litmus(workspace_root, build_seeded_litmus_pairs(opts.seed));
    let combined = glist_new();
    let _ = glist_extend(combined, pass0.violations);
    let _ = glist_extend(combined, pass1.violations);
    let scanned = pass0.items_scanned + pass1.items_scanned;
    if glist_len(combined) == 0 && pass0.at_seam.len() > 0 {
        return gate_at_seam_report("rename_litmus", GateCategoryId.Adaptability, pass0.at_seam, t0, scanned);
    }
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: "rename_litmus",
        category: GateCategoryId.Adaptability,
        passed: glist_len(combined) == 0 && pass0.passed && pass1.passed,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: scanned,
        violations: combined,
        at_seam: "",
    };
}
