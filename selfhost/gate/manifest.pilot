pub pure fn max_total_rust_loc() -> usize => 5900;

// ------------------------------------------------------------------------------
// Seed Contraction Policy (AGENTS.md §1.1 & §1.2, PROP-002a)
// ------------------------------------------------------------------------------
// `crates/pilot-*` is a temporary, actively contracting bootstrap execution seed
// (`-> ~1,800` LOC -> C11 seed in M46 -> `0` non-Pilot LOC in M95). While
// `seed_contraction_paused()` is `true` prior to Stage-3 cutover:
//   - every wave touching `crates/` must hold flat or lower
//     `paused_max_total_rust_loc()` (`20,408` after PROP-002a; raised to
//     `21,000` by the owner on 2026-11-15, after PROP-009 step 2 and
//     PROP-010/012 brought the seed to 20,640; raised to `27,800` by the
//     owner on 2026-11-15 (PROP-016), when `cargo fmt` unpacked the seed's
//     long lines and its count went from 20,547 to 27,724 with no code
//     added: the ceiling counts formatted lines from then on; raised to
//     `28,000` by the owner on 2026-11-16 ("raise it to 28,000"), after
//     PROP-018/020/024/026 brought the seed to 27,807; lowered to `27,585`
//     on 2026-11-17 by the 415 lines PROP-021 21H and its Amendment A1
//     removed, the seed going from 27,920 to 27,505);
//   - each Rust source file must obey the `<= 1,500` LOC law (MOD001);
//   - retired crates (`pilot-rt`, `pilot-codegen`, etc.) must stay absent.
// To resume full per-crate contraction, set `seed_contraction_paused()` to
// `false` at Stage-3 cutover and run `pilot gate --ratchet-update`.
pub pure fn seed_contraction_paused() -> bool => true;
pub pure fn paused_max_total_rust_loc() -> usize => 27585;
pub pure fn paused_max_rust_file_loc() -> usize => 1500;
pub pure fn max_pilot_file_loc() -> usize => 1500;

/// Closed Stage-A VM-internal native set (`GATE021`, PROP-002a §4).
