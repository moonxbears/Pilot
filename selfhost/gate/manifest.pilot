pub fn build_banned_analysis_idents() -> i64 {
    let list = glist_new();
    let _ = glist_push(list, "TypeInferenceEngine");
    let _ = glist_push(list, "TypeArena");
    let _ = glist_push(list, "TypeKind");
    let _ = glist_push(list, "CollectionKind");
    let _ = glist_push(list, "LangItem");
    let _ = glist_push(list, "ReceptorSlot");
    let _ = glist_push(list, "StructuralShape");
    return list;
}

