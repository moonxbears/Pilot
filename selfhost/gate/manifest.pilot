    "rt_print", "rt_eprint", "rt_fault", "seam_open",
    "list_new", "list_push", "list_pop", "list_remove_at", "list_get", "list_set", "list_extend",
    "map_new", "map_get", "map_set", "map_has", "map_remove", "map_keys", "map_values",
    "str_len", "str_slice", "str_find", "str_contains", "str_starts_with", "str_ends_with",
    "str_trim", "str_replace", "str_byte_at", "str_from_bytes", "str_copy_to_ptr", "str_from_ptr",
    "to_str", "scalar_from", "num_pow", "is_null", "value_clone",
    "gen_resume", "gen_done", "gen_close", "gen_current",
    "get_env", "byte_size", "byte_align", "field_offset", "field_list",
    "vm_thread_entry_ptr", "vm_callback_dispatch_ptr",
];

/// Closed Stage-A host dispatch entry (`GATE021`, PROP-002a §4).
pub fn stage_a_host_natives() -> List<str> => ["host_op"];

