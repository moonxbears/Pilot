pub fn stage_a_host_natives() -> List<str> => ["host_op"];

/// Legacy `__engine` call-site ratchet outside `bridge_lang.pilot` and the `[EngineOp]` owners (`GATE021`).
/// Counts are lexer-aware non-comment/non-string `__engine(` occurrences and may only shrink to 0.
