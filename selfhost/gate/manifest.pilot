// ==============================================================================
// FILE: selfhost/gate/manifest.pilot
// Milestone 1: Pure-Pilot Architectural Gate Manifest & Open Registries
// Declarative registries for seed tokens, LOC ratchets, retired artifacts,
// and 2-bit lattice gate report structures (zero magic counts).
// ==============================================================================
pub lvl(0) pkg selfhost.gate;

use Pilot.Core.File;
use Pilot.Core.HostRaw;
use Pilot.Core.Env;

pub enum GateCategory : u8 {
    Adaptability,
    BootstrapParity,
    Performance,
    Hygiene,
}

let GateCategoryId = [
    Adaptability: 0,
    BootstrapParity: 1,
    Performance: 2,
    Hygiene: 3,
];

pub enum GateSeverity : u8 {
    Blocker,
    Warning,
    Advisory,
}

let GateSeverityId = [
    Blocker: 0,
    Warning: 1,
    Advisory: 2,
];

/// The seed tokens in registration order, and the same words as a set.
pub struct SeedTokenRegistry : IObject {
    pub tokens: List<str>;
    pub lookup: Map<str, bool>;

    pub pure fn count() -> i64 => .tokens.len() as i64;
}

[Layout(c_abi)]
pub struct CrateCeilingRule : IValue {
    pub crate_path: str;
    pub max_loc: usize;
    pub must_be_absent: bool;
}

[Layout(c_abi)]
pub struct GateViolation : IValue {
    pub code: str;
    pub file_path: str;
    pub line: usize;
    pub column: usize;
    pub offending_snippet: str;
    pub message: str;
    pub remediation: str;
}

[Layout(c_abi)]
pub struct GateReport : IObject {
    pub gate_id: str;
    pub category: GateCategory;
    pub passed: bool;
    pub elapsed_us: i64;
    pub items_scanned: i64;
    pub violations: List<GateViolation>;
    /// Empty when the gate ran its check. Otherwise the id of the registered
    /// seam (`selfhost/gate/ledger/seams.pilot`) the check stops at: the gate
    /// could not run, so `passed` is false and the runner reports `[SEAM]`.
    pub at_seam: str = "";

    ~self() {
    }
}

[Layout(c_abi)]
pub struct GateRunOptions : IValue {
    pub full: bool;
    pub only_id: str;
    pub json: bool;
    pub litmus: bool;
    pub seed: i64;
    pub ratchet_update: bool;
    pub show_help: bool;
    pub invalid_flag: str;
}

pub interface IGateCheck : IAnyValue {
    pub pure fn id() -> str;
    pub pure fn category() -> GateCategory;
    pub fn execute(workspace_root: str, ref opts: GateRunOptions) -> GateReport;
}

[Layout(c_abi)]
pub struct TempDirGuard : IGuard {
    pub dir_path: str;
    pub active: bool;

    ~self() {
    }
}

// ------------------------------------------------------------------------------
// Irreducible Host OS Wrappers & Scoped TempDirGuard (`0b11 : IGuard`)
// ------------------------------------------------------------------------------

pub fn gate_fs_exists(path: str) -> bool {
    return File.exists(path);
}

pub fn gate_fs_read_text(path: str) -> str {
    return File.read_text(path);
}

pub fn gate_fs_write_text(path: str, content: str) -> bool {
    return File.write_text(path, content);
}

pub fn gate_fs_walk_files(dir_path: str) -> List<str> {
    return File.walk_files(dir_path);
}

pub fn gate_fs_list_dirs(dir_path: str) -> List<str> {
    return File.list_dirs(dir_path);
}

pub fn gate_fs_list_files(dir_path: str) -> List<str> {
    return File.list_files(dir_path);
}

pub fn gate_fs_remove_all(path: str) -> bool {
    if path == "" { return false; }
    let n = path.len();
    let pbuf = RawMem.alloc(n, 1);
    let _ = str_copy_to_ptr(path, pbuf, n);
    let rc = File.remove(pbuf, n, 1);
    let _ = RawMem.free(pbuf, n, 1);
    return rc >= 0;
}

pub fn gate_time_now_us() -> i64 {
    return Clock.now_ns(1) / 1000;
}

pub fn gate_proc_pid() -> i64 {
    return Process.send_signal(2, 0, 0);
}

pub fn temp_guard_new(dir_path: str) -> TempDirGuard {
    return TempDirGuard {
        dir_path: dir_path,
        active: true,
    };
}

pub fn temp_guard_cleanup(var ref guard: TempDirGuard) -> bool {
    if guard.active == true && guard.dir_path.len() > 4 {
        if gate_fs_exists(guard.dir_path) {
            let _ = gate_fs_remove_all(guard.dir_path);
        }
        guard.active = false;
        return true;
    }
    return false;
}

// ------------------------------------------------------------------------------
// Gates That Stop at a Seam
// ------------------------------------------------------------------------------

/// Whether `seam_id` is still listed in `seam_registry()`. A gate whose real
/// check needs code that stops at that seam cannot run while it is listed;
/// connecting the seam deletes the entry, and the gate then runs its check.
pub fn gate_seam_open(seam_id: str) -> bool {
    for e in seam_registry() {
        if e.id == seam_id {
            return true;
        }
    }
    return false;
}

/// The report of a gate that stops at `seam_id`: not passed, no violations.
pub fn gate_at_seam_report(gate_id: str, cat: GateCategory, seam_id: str, t0: i64, scanned: i64) -> GateReport {
    let dt = gate_time_now_us() - t0;
    return GateReport {
        gate_id: gate_id,
        category: cat,
        passed: false,
        elapsed_us: if dt >= 0 { dt } else { 0 },
        items_scanned: scanned,
        violations: [],
        at_seam: seam_id,
    };
}

pub fn resolve_workspace_root(hint: str) -> str {
    if hint.len() > 0 && hint != "." {
        return hint;
    }
    if gate_fs_exists("crates") && gate_fs_exists("selfhost") && gate_fs_exists("stdlib") {
        return ".";
    }
    if gate_fs_exists("../crates") && gate_fs_exists("../selfhost") {
        return "..";
    }
    if gate_fs_exists("../../crates") && gate_fs_exists("../../selfhost") {
        return "../..";
    }
    return ".";
}

// ------------------------------------------------------------------------------
// Dynamic Open-Registry Collection & String Helpers (Zero Magic Counts)
// ------------------------------------------------------------------------------

// The `glist_*` and `gset_*` names are kept for the gate files that still
// call them (airlock_abi, bootstrap_parity, keyword_gate, lex_table_gate,
// seam_gate, seed_audit) and for the Pilot snippets the milestone-1 Rust
// test runs. New code uses `List<T>` and `Map<K, V>` methods directly.

pub fn glist_new<T: IAnyValue>() -> List<T> => [];

pub pure fn glist_len<T: IAnyValue>(ref list: List<T>) -> i64 => list.len() as i64;

/// Appends `item`; the new length.
pub fn glist_push<T: IAnyValue>(var ref list: List<T>, item: T) -> i64 {
    list.push(item);
    return list.len() as i64;
}

pub pure fn glist_get<T: IAnyValue>(ref list: List<T>, idx: i64) -> T => list[idx];

/// Appends every item of `src` to `dst`; the new length of `dst`.
pub fn glist_extend<T: IAnyValue>(var ref dst: List<T>, ref src: List<T>) -> i64 {
    for item in src { dst.push(item); }
    return dst.len() as i64;
}

pub fn gset_new() -> Map<str, bool> => Map<str, bool>();

/// Adds `key`; false when it was already there.
pub fn gset_insert(var ref s: Map<str, bool>, key: str) -> bool {
    if s.has(key) { return false; }
    s.set(key, true);
    return true;
}

pub pure fn gset_contains(ref s: Map<str, bool>, key: str) -> bool => s.has(key);

pub pure fn gset_len(ref s: Map<str, bool>) -> i64 => s.keys().len() as i64;

pub pure fn gm_join_path(root: str, rel: str) -> str {
    if root == "." || root.len() == 0 {
        return rel;
    }
    if root.byte_at(root.len() - 1) == 47 {
        return root + rel;
    }
    return root + "/" + rel;
}

pub pure fn gm_starts_with(s: str, pfx: str) -> bool {
    let pl = pfx.len();
    if s.len() < pl { return false; }
    return s.slice(0, pl) == pfx;
}

pub pure fn gm_ends_with(s: str, sfx: str) -> bool {
    let sl = sfx.len();
    let l = s.len();
    if l < sl { return false; }
    return s.slice(l - sl, l) == sfx;
}

/// The first `needle` in `haystack` at or after byte `start`, or -1 (and
/// -1 for an empty needle or a negative start). The search is the string's
/// own `find`, one engine step, not a byte loop on the interpreter: the
/// gate searches every file of the tree many times.
pub pure fn gm_find(haystack: str, needle: str, start: i64) -> i64 {
    if needle.len() == 0 || start < 0 { return -1; }
    if start + needle.len() > haystack.len() { return -1; }
    return haystack.find(needle, start);
}

pub pure fn gm_contains(haystack: str, needle: str) -> bool {
    return gm_find(haystack, needle, 0) >= 0;
}

pub pure fn gm_trim(s: str) -> str {
    let l = s.len();
    if l == 0 { return ""; }
    var a = 0;
    while a < l {
        let b = s.byte_at(a);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; }
        a = a + 1;
    }
    var e = l;
    while e > a {
        let b = s.byte_at(e - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; }
        e = e - 1;
    }
    return s.slice(a, e);
}

pub pure fn gm_count_lines(s: str) -> i64 {
    let n = s.len();
    if n == 0 { return 0; }
    var lines = 0;
    var p = 0;
    while p < n {
        let nx = gm_find(s, "\n", p);
        if nx < 0 {
            return lines + 1;
        }
        lines = lines + 1;
        p = nx + 1;
    }
    return lines;
}

pub fn gm_split_lines(s: str) -> List<str> {
    var out: List<str> = [];
    let n = s.len();
    if n == 0 { return out; }
    var p = 0;
    while p < n {
        let nx = gm_find(s, "\n", p);
        if nx < 0 {
            let tail = s.slice(p, n);
            if tail.len() > 0 { out.push(tail); }
            return out;
        }
        var end_pos = nx;
        if end_pos > p && s.byte_at(end_pos - 1) == 13 {
            end_pos = end_pos - 1;
        }
        let seg = s.slice(p, end_pos);
        if seg.len() > 0 { out.push(seg); }
        p = nx + 1;
    }
    return out;
}

pub pure fn gm_json_escape(s: str) -> str {
    let n = s.len();
    var out = "";
    var i = 0;
    while i < n {
        let b = s.byte_at(i);
        if b == 34 {
            out = out + "\\\"";
        } else if b == 92 {
            out = out + "\\\\";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + s.slice(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

pub pure fn gate_category_name(cat: GateCategory) -> str {
    if cat == GateCategoryId.Adaptability { return "Adaptability"; }
    if cat == GateCategoryId.BootstrapParity { return "BootstrapParity"; }
    if cat == GateCategoryId.Performance { return "Performance"; }
    return "Hygiene";
}

// ------------------------------------------------------------------------------
// Canonical Seed Token Registry (Count Derived Dynamically via `.tokens_len`)
// ------------------------------------------------------------------------------

fn gm_push_seed(var ref tokens: List<str>, var ref lookup: Map<str, bool>, word: str) -> i64 {
    let _ = gset_insert(lookup, word);
    tokens.push(word);
    return tokens.len() as i64;
}

pub fn seed_token_registry_new() -> SeedTokenRegistry {
    var toks: List<str> = [];
    var lkp = Map<str, bool>();
    let _ = gm_push_seed(toks, lkp, nameof(__engine));
    let _ = gm_push_seed(toks, lkp, nameof(struct));
    let _ = gm_push_seed(toks, lkp, nameof(interface));
    let _ = gm_push_seed(toks, lkp, nameof(fn));
    let _ = gm_push_seed(toks, lkp, nameof(let));
    let _ = gm_push_seed(toks, lkp, nameof(ref));
    let _ = gm_push_seed(toks, lkp, nameof(if));
    let _ = gm_push_seed(toks, lkp, nameof(loop));
    let _ = gm_push_seed(toks, lkp, nameof(return));
    let _ = gm_push_seed(toks, lkp, nameof(yield));
    let _ = gm_push_seed(toks, lkp, nameof(defer));
    let _ = gm_push_seed(toks, lkp, nameof(comptime));
    let _ = gm_push_seed(toks, lkp, nameof(quote));
    let _ = gm_push_seed(toks, lkp, nameof(asm));
    return SeedTokenRegistry {
        tokens: toks,
        lookup: lkp,
    };
}

pub pure fn seed_registry_count(ref reg: SeedTokenRegistry) -> i64 {
    return reg.tokens.len() as i64;
}

pub pure fn seed_registry_contains(ref reg: SeedTokenRegistry, word: str) -> bool {
    return gset_contains(reg.lookup, word);
}

pub pure fn seed_registry_at(ref reg: SeedTokenRegistry, idx: i64) -> str {
    return reg.tokens[idx];
}

// ------------------------------------------------------------------------------
// Crate LOC Ratchet Registry, File Caps & Retired Artifact Registries
// ------------------------------------------------------------------------------

fn gm_reg_crate(var ref reg: Map<str, CrateCeilingRule>, path: str, cap: usize, absent: bool) {
    reg.set(path, CrateCeilingRule {
        crate_path: path,
        max_loc: cap,
        must_be_absent: absent,
    });
}

/// Every registered crate directory and its rule, by path; `.keys()` lists
/// the paths in sorted order.
pub fn build_crate_ceiling_registry() -> Map<str, CrateCeilingRule> {
    var reg = Map<str, CrateCeilingRule>();

    // Surviving bootstrap crates (ratchet ceilings: LOC may shrink to 0, never grow)
    gm_reg_crate(reg, "crates/pilot-lexer", 860, false);
    gm_reg_crate(reg, "crates/pilot-ast", 450, false);
    gm_reg_crate(reg, "crates/pilot-parser", 1100, false);
    gm_reg_crate(reg, "crates/pilot-analysis", 780, false);
    gm_reg_crate(reg, "crates/pilot-vm", 650, false);
    gm_reg_crate(reg, "crates/pilot-cli", 100, false);
    gm_reg_crate(reg, "crates/pilot-intern", 300, false);
    gm_reg_crate(reg, "crates/pilot-span", 250, false);

    // Retired crates (must remain permanently absent)
    gm_reg_crate(reg, "crates/pilot-codegen", 0, true);
    gm_reg_crate(reg, "crates/pilot-rt", 0, true);
    gm_reg_crate(reg, "crates/pilot-arena", 0, true);
    gm_reg_crate(reg, "crates/pilot-ffi", 0, true);
    gm_reg_crate(reg, "crates/pilot-syntax", 0, true);
    gm_reg_crate(reg, "crates/pilot-fmt", 0, true);
    gm_reg_crate(reg, "crates/pilot-perceus", 0, true);
    gm_reg_crate(reg, "crates/pilot-transpile", 0, true);
    gm_reg_crate(reg, "crates/pilot-polyglot", 0, true);
    gm_reg_crate(reg, "crates/pilot-dap", 0, true);
    gm_reg_crate(reg, "crates/pilot-lsp", 0, true);
    gm_reg_crate(reg, "crates/pilot-lsp-macros", 0, true);
    gm_reg_crate(reg, "crates/pilot-db", 0, true);
    gm_reg_crate(reg, "crates/pilot-incremental", 0, true);
    gm_reg_crate(reg, "crates/pilot-pkg", 0, true);
    gm_reg_crate(reg, "crates/pilot-perf", 0, true);
    gm_reg_crate(reg, "crates/pilot-bench", 0, true);
    return reg;
}

