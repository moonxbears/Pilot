    let _ = gm_reg_fcap(reg, keys, "crates/pilot-rt/src/stdlib.rs", 90);
    let _ = gm_reg_fcap(reg, keys, "crates/pilot-cli/src/main.rs", 100);
    let _ = gm_reg_fcap(reg, keys, "selfhost/ide/vscode_gen.pilot", 1000);
    let _ = gm_reg_fcap(reg, keys, "selfhost/lsp/handlers.pilot", 1000);
    __engine("map_set", reg, "__keys__", keys);
    return reg;
}

