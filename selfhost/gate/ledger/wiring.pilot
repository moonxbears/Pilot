// ==============================================================================
// FILE: selfhost/gate/ledger/wiring.pilot
// THE WIRING LEDGER: how far each capability really works, with proof.
// ==============================================================================
// Milestone prose says what a capability should do. This ledger says what it
// does today. Read it before assuming any feature works, and update it in the
// same change that moves a capability.
//
// Levels, lowest to highest:
//   SPEC      designed only; no code.
//   DRAFT     code exists but is not verified on real input.
//   CORE      the part works on its own on real input, checked against an
//             answer it did not choose (a reference tool, a published test
//             vector, a conformance program's expected output). It may stop
//             at a seam.
//   WIRED     reachable through the language or the `pilot` CLI, with a
//             conformance program or CLI run as proof.
//   COMPLETE  the milestone's acceptance criteria pass through the CLI. Only
//             the project owner sets this level.
//   SIMULATED legacy code that returns fixed or caller-supplied values in
//             place of real behaviour. `evidence` names where. These are
//             defects to remove: replace the fake with real code or a seam.
//
// `blocked_by` lists what must exist first: milestone ids (`F6`), and seam and
// stand-in ids from `seams.pilot`, separated by spaces. `pilot gate` (the
// `seams` gate) checks that every CORE level or higher has evidence, that
// every SIMULATED row says where the fake is, that every id named here is
// registered, that every stand-in is named by at least one row, and that no
// row above DRAFT rests on a stand-in.
pub pkg Pilot.SelfHost.Gate.Ledger.Wiring;

pub enum WiringLevel : u8 {
    Spec,
    Draft,
    Core,
    Wired,
    Complete,
    Simulated,
}

/// One capability of a milestone and how far it works.
pub struct Capability : IValue {
    pub milestone: str;
    pub name: str;
    pub level: WiringLevel;
    /// For CORE and above, how to see it work. For SIMULATED, where the fake
    /// is. Otherwise a note.
    pub evidence: str;
    pub blocked_by: str;
}

fn cap(milestone: str, name: str, level: WiringLevel, evidence: str, blocked_by: str) -> Capability {
    return Capability {
        milestone: milestone,
        name: name,
        level: level,
        evidence: evidence,
        blocked_by: blocked_by,
    };
}

/// `"SPEC"`, `"DRAFT"`, .. for a level.
pub fn wiring_level_label(level: WiringLevel) -> str {
    switch level {
        case ::Spec: return "SPEC";
        case ::Draft: return "DRAFT";
        case ::Core: return "CORE";
        case ::Wired: return "WIRED";
        case ::Complete: return "COMPLETE";
        case ::Simulated: return "SIMULATED";
    }
    return "";
}

