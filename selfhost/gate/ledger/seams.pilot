/// `"ENTRY"`, `"EXIT"` or `"VALUE"`.
pub fn seam_kind_label(kind: SeamKind) -> str {
    switch kind {
        case ::Entry: return "ENTRY";
        case ::Exit: return "EXIT";
        case ::Value: return "VALUE";
    }
    return "";
}

/// One registered stand-in: working code with a temporary representation.
pub struct StandInEntry : IValue {
    /// The id given to `[StandIn(..)]`: `<area>.<what>`.
    pub id: str;
    /// What the spec calls for, for example `ptr<T>` or `truncated BLAKE3`.
    pub real: str;
    /// How the stand-in differs from it.
    pub differs: str;
    /// The milestone that replaces it.
    pub owner: str;
}

fn stand_in_entry(id: str, real: str, differs: str, owner: str) -> StandInEntry {
    return StandInEntry { id: id, real: real, differs: differs, owner: owner };
}

/// Every stand-in in the toolchain and standard library, ordered by id.
pub fn stand_in_registry() -> List<StandInEntry> {
    let entries: List<StandInEntry> = [
        stand_in_entry("adapter.errno_values", "per-target errno table", "Linux numbers on every target", "F6"),
        stand_in_entry("check.field_size", "the byte size of every field type", "fields of a generic parameter, interface or enum type count 0 bytes", "F5"),
        stand_in_entry("c.type_layout", "size and alignment of the resolved C type per target", "unknown types and aggregates count as 8 bytes", "F4"),
        stand_in_entry("db.fingerprint", "128-bit truncated BLAKE3", "two FNV-style lanes; weaker and different collisions", "M5"),
        stand_in_entry("emit.c_dynamic_values", "strings, lists, maps, struct values and function values laid out by their physics ([Layout] structs held in place, { ptr, len, cap } buffers, a code pointer and an environment)", "the C backend carries every value that is not a number or a boolean as one tagged 16-byte runtime value (pilot_val): a struct value is a heap-allocated C struct of its fields in their C types (pilot_r<layout>) reached through that value rather than held in place, and strings, lists, maps, variants, tuples and function values are the runtime's own dynamic values; checked at run time where the IR's types say scalar", "F6"),
        stand_in_entry("for.collect_list", "a collecting `for` is a SliceBuffer<T> of what it yielded (F5b)", "the value is the engine's own list, built by the operation bound to the `for`'s list type, on the seed and in PilIR", "F7"),
        stand_in_entry("ffi.int_address", "ptr<T> data pointer and native destructor fn pointer", "addresses held as i64 with no type or provenance", "F6"),
        stand_in_entry("json.decimal_to_f64", "correctly rounded decimal to binary64 conversion (IEEE 754 roundTiesToEven)", "exact up to 15 significant digits and |exponent| <= 22; beyond that repeated scaling can be off by an ulp or more", "F6"),
        stand_in_entry("inspect.cache_line", "cache line size of the inspected target", "64 bytes on every target", "F3"),
        stand_in_entry("ir.absent_as_null", "opt<T> is a tagged or niche-packed value whose tag says none or some", "where no type is expected, none is the engine's null (`undef` in the IR) and a `?`, `??` or `some` test on a value of unknown type treats null as absent, as on the seed", "F6"),
        stand_in_entry("ir.closure_record", "a function value is a code pointer and an environment pointer held in registers (fn<A, R> has a raw_ptr layout)", "the IR builds a record of the function's index and the captured values, which call_indirect reads; coerce never converts it", "F6"),
        stand_in_entry("ir.comptime_at_start", "comptime code runs while the program is compiled and its values are constants in the output", "the code is lowered to functions that <start> calls before anything else, as the seed runs it", "M30"),
        stand_in_entry("ir.unit_literal_call", "a dimensional literal is a constant in the output, valued while the program is compiled", "the IR calls the bound converter on the literal's text each time the literal is evaluated", "M30"),
        stand_in_entry("ir.engine_union_arg", "an engine operation is called with typed arguments, a union passed as its tagged record", "the engine takes any value, so a union's member value is passed in place of the record", "F6"),
        stand_in_entry("ir.aggregate_by_reference", "a 0b00 value is copied when it is bound or passed (memcpy)", "the IR interpreter shares one record between every copy, as the seed does", "F5"),
        stand_in_entry("ir.engine_sequence_for", "slice<T> is { ptr<T>, usize } enumerated by its SliceEnumerator", "the value is the engine's own list, as in the seed, and is indexed by engine operations", "F6"),
        stand_in_entry("ir.fixed_layout_ids", "layout ids handed out by the type registry from [Bits] and [Layout]", "each helper returns a fixed id (0-3) and fixed register facts", "F4"),
        stand_in_entry("ir.target_defaults", "target descriptor from --target and the compile driver", "backend llvm and little-endian on every target", "F3"),
        stand_in_entry("proto.packet_bytes", "borrowed slice<u8> wire view (0b01)", "generated views hold an owned List<i64>, one byte per element", "F7"),
        stand_in_entry("py.buffer_layout", "CPython Py_buffer C layout with typed pointers", "pointers are usize and format is a str, so the layout does not match", "F6"),
        stand_in_entry("seed.generator_frame", "a frame record of the body's live locals and a state index (F5b)", "on the seed the engine keeps the frame (its registers and resume point) and the value is its integer handle; the type declares none of the record's fields", "F6"),
        stand_in_entry("soa.row_base", "ptr<u8> base of the table's column planes", "integer address with no allocation behind it", "F7"),
    ];
    return entries;
}

/// One known bug in the seed, the standard library or the self-hosted tools:
/// code that runs but gives a wrong answer. Each has a repro program under
/// `tests/conformance/known_bugs/` whose expectation files hold the correct
/// output; the conformance runner requires it to keep failing, and reports
/// when it starts passing. Code bent around the bug is marked
/// `[Workaround("<id>", "<what was done instead>")]`.
pub struct KnownBug : IValue {
    /// `<area>.<what>`, for example `seed.u64_right_shift`.
    pub id: str;
    /// The component that holds the bug: a crate, file or stdlib package.
    pub component: str;
    /// What goes wrong, in one sentence.
    pub summary: str;
    /// The correct behaviour, and where that answer comes from.
    pub expected: str;
    /// What happens instead.
    pub actual: str;
    /// The repro program, relative to the workspace root.
    pub repro: str;
    /// The milestone or Phase F step that fixes it.
    pub owner: str;
}

fn known_bug(id: str, component: str, summary: str, expected: str, actual: str, repro: str, owner: str) -> KnownBug {
    return KnownBug {
        id: id,
        component: component,
        summary: summary,
        expected: expected,
        actual: actual,
        repro: repro,
        owner: owner,
    };
}

/// Every known bug, ordered by id.
pub fn bug_registry() -> List<KnownBug> {
    let entries: List<KnownBug> = [
        known_bug("seed.variant_compare_untyped", "crates/pilot-vm target-typed enum resolution",
            "`::Variant` is undefined when two enums share the variant name and the seed has no type at that spot: a struct literal field (`Cell { slot: ::Value }`) or a comparison with a field of a `for` element",
            "the field's enum picks the variant; prints true", "error[DECL001]: undefined name `Value`",
            "tests/conformance/known_bugs/variant_compare_untyped.pilot", "F5"),
        known_bug("seed.narrow_int_wrap", "crates/pilot-vm integer arithmetic",
            "arithmetic on an integer narrower than 64 bits keeps 64-bit results instead of wrapping to its width, and shift counts are taken mod 64 instead of the width",
            "i32 2147483647 + 1 is -2147483648, u8 255 + 1 is 0, i32 1 << 40 is 256", "prints 2147483648, 256, 1099511627776",
            "tests/conformance/known_bugs/narrow_int_wrap.pilot", "F6"),
        known_bug("seed.view_reinterpret_identity", "crates/pilot-vm `as view` casts",
            "`xs as view T` returns `xs` unchanged instead of reading the same memory as elements of `T`: an i32 slice viewed as u32 keeps its negative values",
            "the i32 bits read as u32; prints 4294967295, 7, 4294967294, 3", "prints -1, 7, -2, 3",
            "tests/conformance/known_bugs/view_reinterpret_identity.pilot", "F6"),
    ];
    return entries;
}
