/// `"ENTRY"`, `"EXIT"` or `"VALUE"`.
pub fn seam_kind_label(kind: SeamKind) -> str {
    switch kind {
        case ::Entry: return "ENTRY";
        case ::Exit: return "EXIT";
        case ::Value: return "VALUE";
    }
    return "";
}

/// One registered stand-in: working code with a temporary representation.
pub struct StandInEntry : IValue {
    /// The id given to `[StandIn(..)]`: `<area>.<what>`.
    pub id: str;
    /// What the spec calls for, for example `ptr<T>` or `truncated BLAKE3`.
    pub real: str;
    /// How the stand-in differs from it.
    pub differs: str;
    /// The milestone that replaces it.
    pub owner: str;
}

fn stand_in_entry(id: str, real: str, differs: str, owner: str) -> StandInEntry {
    return StandInEntry { id: id, real: real, differs: differs, owner: owner };
}

/// Every stand-in in the toolchain and standard library, ordered by id.
pub fn stand_in_registry() -> List<StandInEntry> {
    let entries: List<StandInEntry> = [
        stand_in_entry("adapter.errno_values", "per-target errno table", "Linux numbers on every target", "F6"),
        stand_in_entry("c.type_layout", "size and alignment of the resolved C type per target", "unknown types and aggregates count as 8 bytes", "F4"),
        stand_in_entry("db.fingerprint", "128-bit truncated BLAKE3", "two FNV-style lanes; weaker and different collisions", "M5"),
        stand_in_entry("ffi.int_address", "ptr<T> data pointer and native destructor fn pointer", "addresses held as i64 with no type or provenance", "F6"),
        stand_in_entry("json.decimal_to_f64", "correctly rounded decimal to binary64 conversion (IEEE 754 roundTiesToEven)", "exact up to 15 significant digits and |exponent| <= 22; beyond that repeated scaling can be off by an ulp or more", "F6"),
        stand_in_entry("inspect.cache_line", "cache line size of the inspected target", "64 bytes on every target", "F3"),
        stand_in_entry("ir.fixed_layout_ids", "layout ids handed out by the type registry from [Bits] and [Layout]", "each helper returns a fixed id (0-3) and fixed register facts", "F4"),
        stand_in_entry("ir.target_defaults", "target descriptor from --target and the compile driver", "backend llvm and little-endian on every target", "F3"),
        stand_in_entry("proto.packet_bytes", "borrowed slice<u8> wire view (0b01)", "generated views hold an owned List<i64>, one byte per element", "F7"),
        stand_in_entry("py.buffer_layout", "CPython Py_buffer C layout with typed pointers", "pointers are usize and format is a str, so the layout does not match", "F6"),
        stand_in_entry("soa.row_base", "ptr<u8> base of the table's column planes", "integer address with no allocation behind it", "F7"),
    ];
    return entries;
}

/// One known bug in the seed, the standard library or the self-hosted tools:
/// code that runs but gives a wrong answer. Each has a repro program under
/// `tests/conformance/known_bugs/` whose expectation files hold the correct
/// output; the conformance runner requires it to keep failing, and reports
/// when it starts passing. Code bent around the bug is marked
/// `[Workaround("<id>", "<what was done instead>")]`.
pub struct KnownBug : IValue {
    /// `<area>.<what>`, for example `seed.u64_right_shift`.
    pub id: str;
    /// The component that holds the bug: a crate, file or stdlib package.
    pub component: str;
    /// What goes wrong, in one sentence.
    pub summary: str;
    /// The correct behaviour, and where that answer comes from.
    pub expected: str;
    /// What happens instead.
    pub actual: str;
    /// The repro program, relative to the workspace root.
    pub repro: str;
    /// The milestone or Phase F step that fixes it.
    pub owner: str;
}

fn known_bug(id: str, component: str, summary: str, expected: str, actual: str, repro: str, owner: str) -> KnownBug {
    return KnownBug {
        id: id,
        component: component,
        summary: summary,
        expected: expected,
        actual: actual,
        repro: repro,
        owner: owner,
    };
}

/// Every known bug, ordered by id.
pub fn bug_registry() -> List<KnownBug> {
    let entries: List<KnownBug> = [
        known_bug("seed.enum_explicit_values", "crates/pilot-vm enum lowering",
            "explicit enum values are ignored; variants are numbered by position",
            "`Low = 5` casts to 5", "casts to its position, 0",
            "tests/conformance/known_bugs/enum_explicit_values.pilot", "F1"),
        known_bug("seed.field_closure_call", "crates/pilot-vm call lowering",
            "calling a closure stored in a field, `(self.f)(x)`, is lowered as a method call named `<Type>.f`",
            "the field's closure is called; prints 10", "error: no function named `Doubler.f`",
            "tests/conformance/known_bugs/field_closure_call.pilot", "F1"),
        known_bug("seed.hex_literal_u64", "crates/pilot-lexer / pilot-vm literal parsing",
            "a hex literal above i64::MAX evaluates to 0",
            "0xFFFFFFFFFFFFFFFF as u64 prints 18446744073709551615", "prints 0",
            "tests/conformance/known_bugs/hex_literal_u64.pilot", "F1"),
        known_bug("seed.local_named_op", "crates/pilot-parser statement parsing",
            "a local variable named `op` is parsed as an operator declaration",
            "`var op = 1; op = op + 2;` prints 3", "error: `OperatorDecl` is not lowered by the seed yet",
            "tests/conformance/known_bugs/local_named_op.pilot", "F1"),
        known_bug("seed.shared_variant_name", "crates/pilot-vm target-typed enum resolution",
            "`::Variant` as a call argument is undefined when two enums share the variant name",
            "the parameter type picks the enum; prints true", "error: undefined name `Value`",
            "tests/conformance/known_bugs/shared_variant_name.pilot", "F4"),
        known_bug("seed.u64_right_shift", "crates/pilot-vm integer shifts",
            "`>>` on a u64 with the top bit set does not shift in zeros",
            "xorshift64 (13,7,17) from 12345678 gives 17339054203798593560 on step 2 (64-bit unsigned reference)",
            "gives 1054037951226880024",
            "tests/conformance/known_bugs/u64_right_shift.pilot", "F1"),
    ];
    return entries;
}
