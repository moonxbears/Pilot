// =========================================================================
// 1. JSON ATTRIBUTES & STANDARD SERIALIZATION INTERFACES
// =========================================================================

[Layout(c_abi)]
pub struct JsonObjectAttr : IAttribute, IValue {
    pub naming_policy: str;
    pub weight:        i32;

    pub static pure fn create() -> JsonObjectAttr => JsonObjectAttr {
        naming_policy: "camelCase",
        weight:        10,
    };
}

[Layout(c_abi)]
pub struct JsonPropertyAttr : IAttribute, IValue {
    pub name:   str;
    pub weight: i32;

    pub static pure fn named(name: str) -> JsonPropertyAttr => JsonPropertyAttr {
        name:   name,
        weight: 10,
    };
}

// Formatting helpers for indented JSON generation
pure fn json_indent(depth: i64, spaces: i64) -> str {
    let total = depth * spaces;
    var res = "";
    var i = 0;
    while i < total {
        res = res + " ";
        i = i + 1;
    }
    return res;
}

pure fn json_format_str_array(arr: str[], indent: i64, depth: i64) -> str {
    let n = len(arr);
    if n == 0 {
        return "[]";
    }
    let pad_inner = json_indent(depth + 1, indent);
    let pad_outer = json_indent(depth, indent);
    var s = "[\n";
    var idx = 0;
    for item in arr {
        if idx > 0 {
            s = s + ",\n";
        }
        s = s + pad_inner + "\"" + item + "\"";
        idx = idx + 1;
    }
    s = s + "\n" + pad_outer + "]";
    return s;
}

pure fn json_format_str_array_inline(arr: str[]) -> str {
    var s = "[";
    var idx = 0;
    for item in arr {
        if idx > 0 {
            s = s + ", ";
        }
        s = s + "\"" + item + "\"";
        idx = idx + 1;
    }
    s = s + "]";
    return s;
}

// Standard JSON serialization and deserialization functions
pub pure fn dumps(obj: any, indent: i64 = 2) -> str {
    return obj.emit_json(indent);
}

pub pure fn loads(s: str) -> any {
    return s;
}

pub fn dump(obj: any, file_path: str, indent: i64 = 2) -> bool {
    let content = dumps(obj, indent);
    return len(content) > 0;
}

pub fn load(file_path: str) -> any {
    return "";
}

// =========================================================================
// 2. SEMANTIC TOKENS LEGEND HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct SemanticLegend : IValue {
    [JsonProperty("tokenTypes")]
    pub token_types: str[];

    [JsonProperty("tokenModifiers")]
    pub token_modifiers: str[];

    pub fn emit_json(indent: i64 = 2) -> str {
        let pad = json_indent(1, indent);
        let pad_close = json_indent(0, indent);
        let tt = json_format_str_array(self.token_types, indent, 1);
        let tm = json_format_str_array(self.token_modifiers, indent, 1);
        return f"{{\n{pad}\"tokenTypes\": {tt},\n{pad}\"tokenModifiers\": {tm}\n{pad_close}}}";
    }
}

pub pure fn build_semantic_legend_model() -> SemanticLegend {
    return SemanticLegend {
        token_types: [
            "namespace", "type", "class", "enum", "interface", "struct",
            "typeParameter", "parameter", "variable", "property", "enumMember",
            "event", "function", "method", "macro", "keyword", "modifier",
            "comment", "string", "number", "regexp", "operator", "decorator",
        ],
        token_modifiers: [
            "declaration", "definition", "readonly", "static", "deprecated",
            "abstract", "async", "modification", "documentation", "defaultLibrary",
            "constructor", "callable",
        ],
    };
}

pub pure fn build_semantic_legend_json() -> str {
    let model = build_semantic_legend_model();
    return dumps(model, 2);
}

// =========================================================================
// 3. LANGUAGE CONFIGURATION HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct CommentRule : IValue {
    [JsonProperty("lineComment")]
    pub line_comment: str;

    [JsonProperty("blockComment")]
    pub block_comment: str[];

    pub fn emit_json(indent: i64 = 2, depth: i64 = 1) -> str {
        let pad = json_indent(depth, indent);
        let pad_in = json_indent(depth + 1, indent);
        let bc = json_format_str_array_inline(self.block_comment);
        return f"{{\n{pad_in}\"lineComment\": \"{self.line_comment}\",\n{pad_in}\"blockComment\": {bc}\n{pad}}}";
    }
}

[JsonObject]
pub struct BracketPair : IValue {
    [JsonProperty("open")]
    pub open: str;

    [JsonProperty("close")]
    pub close: str;

    pub fn emit_json() -> str => f"[\"{self.open}\", \"{self.close}\"]";
}

[JsonObject]
pub struct AutoClosingPair : IValue {
    [JsonProperty("open")]
    pub open: str;

    [JsonProperty("close")]
    pub close: str;

    [JsonProperty("notIn")]
    pub not_in: str[];

    pub fn emit_json() -> str {
        let esc_open = if self.open == "\"" { "\\\"" } else { self.open };
        let esc_close = if self.close == "\"" { "\\\"" } else { self.close };
        if len(self.not_in) == 0 {
            return f"{{ \"open\": \"{esc_open}\", \"close\": \"{esc_close}\" }}";
        }
        let ni = json_format_str_array_inline(self.not_in);
        return f"{{ \"open\": \"{esc_open}\", \"close\": \"{esc_close}\", \"notIn\": {ni} }}";
    }
}

[JsonObject]
pub struct IndentationRules : IValue {
    [JsonProperty("increaseIndentPattern")]
    pub increase_indent_pattern: str;

    [JsonProperty("decreaseIndentPattern")]
    pub decrease_indent_pattern: str;

    pub fn emit_json(indent: i64 = 2, depth: i64 = 1) -> str {
        let pad = json_indent(depth, indent);
        let pad_in = json_indent(depth + 1, indent);
        return f"{{\n{pad_in}\"increaseIndentPattern\": \"{self.increase_indent_pattern}\",\n{pad_in}\"decreaseIndentPattern\": \"{self.decrease_indent_pattern}\"\n{pad}}}";
    }
}

[JsonObject]
pub struct LanguageConfiguration : IValue {
    [JsonProperty("comments")]
    pub comments: CommentRule;

    [JsonProperty("brackets")]
    pub brackets: BracketPair[];

    [JsonProperty("autoClosingPairs")]
    pub auto_closing_pairs: AutoClosingPair[];

    [JsonProperty("surroundingPairs")]
    pub surrounding_pairs: BracketPair[];

    [JsonProperty("indentationRules")]
    pub indentation_rules: IndentationRules;

    pub fn emit_json(indent: i64 = 2) -> str {
        let pad = json_indent(1, indent);
        let pad_in = json_indent(2, indent);
        let pad_close = json_indent(0, indent);

        let comm = self.comments.emit_json(indent, 1);

        var brk = "[\n";
        var idx = 0;
        for b in self.brackets {
            if idx > 0 { brk = brk + ",\n"; }
            brk = brk + pad_in + b.emit_json();
            idx = idx + 1;
        }
        brk = brk + "\n" + pad + "]";

        var acp = "[\n";
        idx = 0;
        for a in self.auto_closing_pairs {
            if idx > 0 { acp = acp + ",\n"; }
            acp = acp + pad_in + a.emit_json();
            idx = idx + 1;
        }
        acp = acp + "\n" + pad + "]";

        var surr = "[\n";
        idx = 0;
        for s in self.surrounding_pairs {
            if idx > 0 { surr = surr + ",\n"; }
            surr = surr + pad_in + s.emit_json();
            idx = idx + 1;
        }
        surr = surr + "\n" + pad + "]";

        let ind = self.indentation_rules.emit_json(indent, 1);

        return f"{{\n{pad}\"comments\": {comm},\n{pad}\"brackets\": {brk},\n{pad}\"autoClosingPairs\": {acp},\n{pad}\"surroundingPairs\": {surr},\n{pad}\"indentationRules\": {ind}\n{pad_close}}}";
    }
}

pub pure fn build_language_configuration_model() -> LanguageConfiguration {
    return LanguageConfiguration {
        comments: CommentRule {
            line_comment:  "//",
            block_comment: ["/*", "*/"],
        },
        brackets: [
            BracketPair { open: "{", close: "}" },
            BracketPair { open: "[", close: "]" },
            BracketPair { open: "(", close: ")" },
            BracketPair { open: "<", close: ">" },
        ],
        auto_closing_pairs: [
            AutoClosingPair { open: "{", close: "}", not_in: [] },
            AutoClosingPair { open: "[", close: "]", not_in: [] },
            AutoClosingPair { open: "(", close: ")", not_in: [] },
            AutoClosingPair { open: "\"", close: "\"", not_in: ["string"] },
            AutoClosingPair { open: "'", close: "'", not_in: ["string", "comment"] },
            AutoClosingPair { open: "`", close: "`", not_in: ["string", "comment"] },
        ],
        surrounding_pairs: [
            BracketPair { open: "{", close: "}" },
            BracketPair { open: "[", close: "]" },
            BracketPair { open: "(", close: ")" },
            BracketPair { open: "<", close: ">" },
            BracketPair { open: "\\\"", close: "\\\"" },
            BracketPair { open: "'", close: "'" },
            BracketPair { open: "`", close: "`" },
        ],
        indentation_rules: IndentationRules {
            increase_indent_pattern: "^((?!.*?\\/\\/).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$",
            decrease_indent_pattern: "^\\s*[}\\])]\\s*$",
        },
    };
}

pub pure fn build_language_configuration_json() -> str {
    return "{\n  \"comments\": {\n    \"lineComment\": \"//\",\n    \"blockComment\": [ \"/*\", \"*/\" ]\n  },\n  \"brackets\": [\n    [ \"{\", \"}\" ],\n    [ \"[\", \"]\" ],\n    [ \"(\", \")\" ],\n    [ \"<\", \">\" ]\n  ],\n  \"autoClosingPairs\": [\n    { \"open\": \"{\", \"close\": \"}\" },\n    { \"open\": \"[\", \"close\": \"]\" },\n    { \"open\": \"(\", \"close\": \")\" },\n    { \"open\": \"\\\"\", \"close\": \"\\\"\", \"notIn\": [ \"string\" ] },\n    { \"open\": \"'\", \"close\": \"'\", \"notIn\": [ \"string\", \"comment\" ] },\n    { \"open\": \"`\", \"close\": \"`\", \"notIn\": [ \"string\", \"comment\" ] }\n  ],\n  \"surroundingPairs\": [\n    [ \"{\", \"}\" ],\n    [ \"[\", \"]\" ],\n    [ \"(\", \")\" ],\n    [ \"<\", \">\" ],\n    [ \"\\\"\", \"\\\"\" ],\n    [ \"'\", \"'\" ],\n    [ \"`\", \"`\" ]\n  ],\n  \"indentationRules\": {\n    \"increaseIndentPattern\": \"^((?!.*?\\\\/\\\\/).)*(\\\\{[^}\\\"'`]*|\\\\([^)\\\"'`]*|\\\\[[^\\\\]\\\"'`]*)$\",\n    \"decreaseIndentPattern\": \"^\\\\s*[}\\\\])]\\\\s*$\"\n  }\n}";
}

// =========================================================================
// 4. SNIPPETS CATALOG HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct SnippetDefinition : IValue {
    [JsonProperty("prefix")]
    pub prefix: str;

    [JsonProperty("body")]
    pub body: str[];

    [JsonProperty("description")]
    pub description: str;

    pub fn emit_json(indent: i64 = 2, depth: i64 = 1) -> str {
        let pad = json_indent(depth, indent);
        let pad_in = json_indent(depth + 1, indent);
        let b = json_format_str_array(self.body, indent, depth + 1);
        return f"{{\n{pad_in}\"prefix\": \"{self.prefix}\",\n{pad_in}\"body\": {b},\n{pad_in}\"description\": \"{self.description}\"\n{pad}}}";
    }
}

[JsonObject]
pub struct SnippetEntry : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("definition")]
    pub definition: SnippetDefinition;
}

[JsonObject]
pub struct SnippetsCatalog : IValue {
    [JsonProperty("entries")]
    pub entries: SnippetEntry[];

    pub fn emit_json(indent: i64 = 2) -> str {
        let pad = json_indent(1, indent);
        let pad_close = json_indent(0, indent);
        var res = "{\n";
        var idx = 0;
        for entry in self.entries {
            if idx > 0 { res = res + ",\n"; }
            let def_str = entry.definition.emit_json(indent, 1);
            res = res + pad + f"\"{entry.name}\": {def_str}";
            idx = idx + 1;
        }
        res = res + "\n" + pad_close + "}";
        return res;
    }
}

pub pure fn build_snippets_model() -> SnippetsCatalog {
    return SnippetsCatalog {
        entries: [
            SnippetEntry {
                name: "Distributive Struct Block",
                definition: SnippetDefinition {
                    prefix:      "pstruct",
                    body:        ["pub struct {", "\t$0", "}"],
                    description: "Distributive Pilot struct block",
                },
            },
            SnippetEntry {
                name: "Syntax Macro Rule",
                definition: SnippetDefinition {
                    prefix:      "psyntax",
                    body:        ["pub syntax ${1:name}(${2:expr}) => quote {", "\t$0", "};"],
                    description: "Self-hosted Pilot syntax macro",
                },
            },
            SnippetEntry {
                name: "Patch Function Clone",
                definition: SnippetDefinition {
                    prefix: "ppatch",
                    body: [
                        "[var ${1:contents} = Patch(${2:orig_fn}, PatchPart.body(), ${3:0} ..${4:5})]",
                        "pub fn ${5:new_fn}() {",
                        "\t$0",
                        "\t${1:contents}.patch().call();",
                        "}",
                    ],
                    description: "Non-destructive CST/AST function patch and clone",
                },
            },
            SnippetEntry {
                name: "Choreography Blueprint",
                definition: SnippetDefinition {
                    prefix: "pblueprint",
                    body: [
                        "pub blueprint ${1:Pipeline} {",
                        "\trole ${2:Worker};",
                        "\tcue ${3:on_event}(pkt:${4:iso<SliceBuffer<u8>>}) {",
                        "\t\troute pkt -> ${2:Worker}.${5:handle};",
                        "\t}",
                        "}",
                    ],
                    description: "Zero-copy .pchor choreography blueprint",
                },
            },
        ],
    };
}

pub pure fn build_snippets_json() -> str {
    return "{\n  \"Distributive Struct Block\": {\n    \"prefix\": \"pstruct\",\n    \"body\": [\n      \"pub struct {\",\n      \"\\t$0\",\n      \"}\"\n    ],\n    \"description\": \"Distributive Pilot struct block\"\n  },\n  \"Syntax Macro Rule\": {\n    \"prefix\": \"psyntax\",\n    \"body\": [\n      \"pub syntax ${1:name}(${2:expr}) => quote {\",\n      \"\\t$0\",\n      \"};\"\n    ],\n    \"description\": \"Self-hosted Pilot syntax macro\"\n  },\n  \"Patch Function Clone\": {\n    \"prefix\": \"ppatch\",\n    \"body\": [\n      \"[var ${1:contents} = Patch(${2:orig_fn}, PatchPart.body(), ${3:0} ..${4:5})]\",\n      \"pub fn ${5:new_fn}() {\",\n      \"\\t$0\",\n      \"\\t${1:contents}.patch().call();\",\n      \"}\"\n    ],\n    \"description\": \"Non-destructive CST/AST function patch and clone\"\n  },\n  \"Choreography Blueprint\": {\n    \"prefix\": \"pblueprint\",\n    \"body\": [\n      \"pub blueprint ${1:Pipeline} {\",\n      \"\\trole ${2:Worker};\",\n      \"\\tcue ${3:on_event}(pkt:${4:iso<SliceBuffer<u8>>}) {\",\n      \"\\t\\troute pkt -> ${2:Worker}.${5:handle};\",\n      \"\\t}\",\n      \"}\"\n    ],\n    \"description\": \"Zero-copy .pchor choreography blueprint\"\n  }\n}";
}

// =========================================================================
// 5. TEXTMATE GRAMMAR HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct TmPatternInclude : IValue {
    [JsonProperty("include")]
    pub include: str;

    pub fn emit_json() -> str => f"{{ \"include\": \"{self.include}\" }}";
}

[JsonObject]
pub struct TmCaptureBinding : IValue {
    [JsonProperty("index")]
    pub index: str;

    [JsonProperty("name")]
    pub name: str;

    pub fn emit_json(indent: i64 = 2, depth: i64 = 6) -> str => f"{{ \"name\": \"{self.name}\" }}";
}

[JsonObject]
pub struct TmRule : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("match")]
    pub match_pattern: str;

    [JsonProperty("begin")]
    pub begin: str;

    [JsonProperty("end")]
    pub end: str;

    [JsonProperty("captures")]
    pub captures: TmCaptureBinding[];

    [JsonProperty("beginCaptures")]
    pub begin_captures: TmCaptureBinding[];

    [JsonProperty("endCaptures")]
    pub end_captures: TmCaptureBinding[];

    [JsonProperty("patterns")]
    pub patterns: TmRule[];

    [JsonProperty("include")]
    pub include: str;

    pub fn emit_json(indent: i64 = 2, depth: i64 = 4) -> str {
        let pad = json_indent(depth, indent);
        let pad_in = json_indent(depth + 1, indent);

        if len(self.include) > 0 {
            return f"{{ \"include\": \"{self.include}\" }}";
        }

        var s = "{\n";
        var has_prop = false;

        if len(self.name) > 0 {
            s = s + pad_in + f"\"name\": \"{self.name}\"";
            has_prop = true;
        }

        if len(self.match_pattern) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + f"\"match\": \"{self.match_pattern}\"";
            has_prop = true;
        }

        if len(self.begin) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + f"\"begin\": \"{self.begin}\"";
            has_prop = true;
        }

        if len(self.begin_captures) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + "\"beginCaptures\": {\n";
            var bc_idx = 0;
            let c_pad = json_indent(depth + 2, indent);
            for c in self.begin_captures {
                if bc_idx > 0 { s = s + ",\n"; }
                let c_json = c.emit_json(indent, depth + 2);
                s = s + c_pad + f"\"{c.index}\": {c_json}";
                bc_idx = bc_idx + 1;
            }
            s = s + "\n" + pad_in + "}";
            has_prop = true;
        }

        if len(self.end) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + f"\"end\": \"{self.end}\"";
            has_prop = true;
        }

        if len(self.end_captures) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + "\"endCaptures\": {\n";
            var ec_idx = 0;
            let c_pad = json_indent(depth + 2, indent);
            for c in self.end_captures {
                if ec_idx > 0 { s = s + ",\n"; }
                let c_json = c.emit_json(indent, depth + 2);
                s = s + c_pad + f"\"{c.index}\": {c_json}";
                ec_idx = ec_idx + 1;
            }
            s = s + "\n" + pad_in + "}";
            has_prop = true;
        }

        if len(self.captures) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + "\"captures\": {\n";
            var c_idx = 0;
            let c_pad = json_indent(depth + 2, indent);
            for c in self.captures {
                if c_idx > 0 { s = s + ",\n"; }
                let c_json = c.emit_json(indent, depth + 2);
                s = s + c_pad + f"\"{c.index}\": {c_json}";
                c_idx = c_idx + 1;
            }
            s = s + "\n" + pad_in + "}";
            has_prop = true;
        }

        if len(self.patterns) > 0 {
            if has_prop { s = s + ",\n"; }
            s = s + pad_in + "\"patterns\": [\n";
            var p_idx = 0;
            let p_pad = json_indent(depth + 2, indent);
            for p in self.patterns {
                if p_idx > 0 { s = s + ",\n"; }
                s = s + p_pad + p.emit_json(indent, depth + 2);
                p_idx = p_idx + 1;
            }
            s = s + "\n" + pad_in + "]";
            has_prop = true;
        }

        s = s + "\n" + pad + "}";
        return s;
    }
}

pub pure fn tm_cap(idx: str, name: str) -> TmCaptureBinding => TmCaptureBinding {
    index: idx,
    name:  name,
};

pub pure fn tm_include(inc: str) -> TmRule => TmRule {
    name: "", match_pattern: "", begin: "", end: "",
    captures: [], begin_captures: [], end_captures: [],
    patterns: [], include: inc,
};

pub pure fn tm_match(name: str, pat: str) -> TmRule => TmRule {
    name: name, match_pattern: pat, begin: "", end: "",
    captures: [], begin_captures: [], end_captures: [],
    patterns: [], include: "",
};

pub pure fn tm_match_caps(name: str, pat: str, caps: TmCaptureBinding[]) -> TmRule => TmRule {
    name: name, match_pattern: pat, begin: "", end: "",
    captures: caps, begin_captures: [], end_captures: [],
    patterns: [], include: "",
};

pub pure fn tm_block(name: str, begin: str, end: str, pats: TmRule[]) -> TmRule => TmRule {
    name: name, match_pattern: "", begin: begin, end: end,
    captures: [], begin_captures: [], end_captures: [],
    patterns: pats, include: "",
};

pub pure fn tm_block_caps(name: str, begin: str, end: str, b_caps: TmCaptureBinding[], e_caps: TmCaptureBinding[], pats: TmRule[]) -> TmRule => TmRule {
    name: name, match_pattern: "", begin: begin, end: end,
    captures: [], begin_captures: b_caps, end_captures: e_caps,
    patterns: pats, include: "",
};

[JsonObject]
pub struct TmSection : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("rules")]
    pub rules: TmRule[];

    pub fn emit_json(indent: i64 = 2, depth: i64 = 2) -> str {
        let pad = json_indent(depth, indent);
        let pad_in = json_indent(depth + 1, indent);
        var s = f"{{\n{pad_in}\"patterns\": [\n";
        var r_idx = 0;
        let r_pad = json_indent(depth + 2, indent);
        for r in self.rules {
            if r_idx > 0 { s = s + ",\n"; }
            let r_json = r.emit_json(indent, depth + 2);
            s = s + r_pad + r_json;
            r_idx = r_idx + 1;
        }
        s = s + "\n" + pad_in + "]\n" + pad + "}";
        return s;
    }
}

[JsonObject]
pub struct TmLanguageGrammar : IValue {
    [JsonProperty("$schema")]
    pub schema: str;

    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("scopeName")]
    pub scope_name: str;

    [JsonProperty("patterns")]
    pub patterns: TmPatternInclude[];

    [JsonProperty("repository")]
    pub repository: TmSection[];

    pub fn emit_json(indent: i64 = 2) -> str {
        let pad = json_indent(1, indent);
        let pad_in = json_indent(2, indent);
        let pad_close = json_indent(0, indent);

        var p_str = "[\n";
        var p_idx = 0;
        for p in self.patterns {
            if p_idx > 0 { p_str = p_str + ",\n"; }
            p_str = p_str + pad_in + p.emit_json();
            p_idx = p_idx + 1;
        }
        p_str = p_str + "\n" + pad + "]";

        var r_str = "{\n";
        var s_idx = 0;
        for s in self.repository {
            if s_idx > 0 { r_str = r_str + ",\n"; }
            let s_json = s.emit_json(indent, 2);
            r_str = r_str + pad_in + f"\"{s.name}\": {s_json}";
            s_idx = s_idx + 1;
        }
        r_str = r_str + "\n" + pad + "}";

        return f"{{\n{pad}\"$schema\": \"{self.schema}\",\n{pad}\"name\": \"{self.name}\",\n{pad}\"scopeName\": \"{self.scope_name}\",\n{pad}\"patterns\": {p_str},\n{pad}\"repository\": {r_str}\n{pad_close}}}";
    }
}

// =========================================================================
// 4B. DYNAMIC KEYWORD REFLECTION & OPEN CATEGORY TAXONOMY ENGINE
// =========================================================================

pub struct KeywordInfo : IValue {
    pub badge: str;
    pub doc:   str;
}

pub fn reflect_category_keywords(target_cat_id: i64) -> str {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var pat = "";
    var idx = 0;
    while idx < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, idx);
        if k == 1 {
            let ac = __engine("ast_attr_count", idx);
            if ac == 2 || ac == 3 {
                let cat = __engine("ast_attr_arg", idx, 0);
                if cat == target_cat_id {
                    let sym = __engine(Cfg.ast.ast_node_sym, idx);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    let suffix = if ac == 3 { __engine(Cfg.ast.sym_str, __engine("ast_attr_arg", idx, 2)) } else { "" };
                    let term = if suffix != "" { nm + suffix + "|" + nm } else { nm };
                    if pat == "" {
                        pat = term;
                    } else {
                        pat = pat + "|" + term;
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return pat;
}

pub fn reflect_primitives_pattern() -> str {
    var pat = "";
    var cid = 20;
    while cid <= 29 {
        let cpat = reflect_category_keywords(cid);
        if cpat != "" {
            if pat == "" {
                pat = cpat;
            } else {
                pat = pat + "|" + cpat;
            }
        }
        cid = cid + 1;
    }
    return pat;
}

pub fn reflect_keyword_doc(target_word: str) -> str {
    if target_word == "" {
        return "";
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == target_word {
                    let doc_sym = __engine("ast_attr_arg", i, 1);
                    return __engine(Cfg.ast.sym_str, doc_sym);
                }
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn reflect_keyword_badge(target_word: str) -> str {
    if target_word == "" {
        return "Core";
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    var target_cat_id = -1;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == target_word {
                    target_cat_id = __engine("ast_attr_arg", i, 0);
                    i = node_count;
                }
            }
        }
        i = i + 1;
    }
    if target_cat_id == -1 {
        return "Core";
    }
    var j = 0;
    while j < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 {
            let ac = __engine("ast_attr_count", j);
            if ac == 4 {
                let cid = __engine("ast_attr_arg", j, 0);
                if cid == target_cat_id {
                    let badge_sym = __engine("ast_attr_arg", j, 2);
                    return __engine(Cfg.ast.sym_str, badge_sym);
                }
            }
        }
        j = j + 1;
    }
    return "Core";
}

pub fn reflect_keyword_info(target_word: str) -> KeywordInfo {
    return KeywordInfo {
        badge: reflect_keyword_badge(target_word),
        doc:   reflect_keyword_doc(target_word),
    };
}

pub fn reflect_related_keywords(kw: str) -> str[] {
    if kw == "" {
        return [];
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    var target_cat = -1;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == kw {
                    target_cat = __engine("ast_attr_arg", i, 0);
                    i = node_count;
                }
            }
        }
        i = i + 1;
    }

    if target_cat == -1 {
        return [];
    }

    var related: str[] = [];
    var rel_count = 0;
    var j = 0;
    while j < node_count && rel_count < 5 {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 {
            let ac = __engine("ast_attr_count", j);
            if ac == 2 || ac == 3 {
                let cid = __engine("ast_attr_arg", j, 0);
                if cid == target_cat {
                    let sym = __engine(Cfg.ast.ast_node_sym, j);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    if nm != kw {
                        related = related + [nm];
                        rel_count = rel_count + 1;
                    }
                }
            }
        }
        j = j + 1;
    }
    return related;
}

pub fn build_tm_language_model(
    seed_keywords_regex:   str,
    syntax_macros_regex:   str,
    modifiers_regex:       str,
    lang_primitives_regex: str,
    operators_regex:       str
) -> TmLanguageGrammar {
    let seed_pat = if seed_keywords_regex != "" { seed_keywords_regex } else { reflect_category_keywords(0) };
    let mod_pat  = if modifiers_regex != "" { modifiers_regex } else { reflect_category_keywords(4) };
    let prim_pat = if lang_primitives_regex != "" { lang_primitives_regex } else { reflect_primitives_pattern() };
    let op_pat   = if operators_regex != "" { operators_regex } else { "%%|\\*%|\\*\\?|\\*\\||\\+%|\\+\\?|\\+\\||-%|-\\?|-\\||<<|>>|~>|%|&|\\+|-|/|\\^|\\||~" };
    let syn_pat  = if syntax_macros_regex != "" { syntax_macros_regex } else { "syntax|quote|macro" };

    return TmLanguageGrammar {
        schema:     "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
        name:       "Pilot",
        scope_name: "source.pilot",
        patterns: [
            TmPatternInclude { include: "#comments" },
            TmPatternInclude { include: "#preprocessor" },
            TmPatternInclude { include: "#polyglot-blocks" },
            TmPatternInclude { include: "#raw-dsl" },
            TmPatternInclude { include: "#strings" },
            TmPatternInclude { include: "#raw-idents" },
            TmPatternInclude { include: "#attributes" },
            TmPatternInclude { include: "#quote-splices" },
            TmPatternInclude { include: "#symbols" },
            TmPatternInclude { include: "#declarations" },
            TmPatternInclude { include: "#keywords" },
            TmPatternInclude { include: "#modifiers" },
            TmPatternInclude { include: "#primitives" },
            TmPatternInclude { include: "#call-targets" },
            TmPatternInclude { include: "#constants" },
            TmPatternInclude { include: "#object-keys" },
            TmPatternInclude { include: "#numbers" },
            TmPatternInclude { include: "#operators" },
            TmPatternInclude { include: "#punctuation" },
            TmPatternInclude { include: "#variables" },
        ],
        repository: [
            TmSection {
                name: "comments",
                rules: [
                    tm_match("comment.line.documentation.pilot", "///.*$"),
                    tm_block("comment.block.documentation.pilot", "/\\*\\*", "\\*/", []),
                    tm_match("comment.line.double-slash.pilot", "//.*$"),
                    tm_block("comment.block.pilot", "/\\*", "\\*/", []),
                ],
            },
            TmSection {
                name: "preprocessor",
                rules: [
                    tm_match_caps(
                        "meta.preprocessor.pilot",
                        "^\\s*(#(?:define|undef|if|elif|else|endif|region|endregion|error|warning|pragma|line))\\b(.*)$",
                        [
                            tm_cap("1", "keyword.control.directive.pilot"),
                            tm_cap("2", "string.unquoted.preprocessor.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "polyglot-blocks",
                rules: [
                    tm_block_caps(
                        "", "\\b(python|py)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.python"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(js|javascript)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.js"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(sql|postgres|postgresql)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.sql"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(c)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.c"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(cpp)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.cpp"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(rust)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.rust"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(lua)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.lua"), tm_include("$self")]
                    ),
                ],
            },
            TmSection {
                name: "raw-dsl",
                rules: [
                    tm_block("string.unquoted.raw.dsl.pilot", "```[a-zA-Z0-9_]*", "```", []),
                ],
            },
            TmSection {
                name: "strings",
                rules: [
                    tm_block_caps(
                        "string.quoted.triple.interpolated.pilot",
                        "(f)(\"\"\")", "\"\"\"",
                        [
                            tm_cap("1", "storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot"),
                            tm_cap("2", "punctuation.definition.string.begin.pilot"),
                        ],
                        [tm_cap("0", "punctuation.definition.string.end.pilot")],
                        [
                            tm_match("constant.character.escape.pilot", "\\\\."),
                            tm_block_caps(
                                "meta.interpolation.pilot", "\\{", "\\}",
                                [tm_cap("0", "punctuation.definition.template-expression.begin.pilot")],
                                [tm_cap("0", "punctuation.definition.template-expression.end.pilot")],
                                [tm_include("$self")]
                            ),
                        ]
                    ),
                    tm_block(
                        "string.quoted.triple.pilot", "\"\"\"", "\"\"\"",
                        [tm_match("constant.character.escape.pilot", "\\\\.")]
                    ),
                    tm_block_caps(
                        "string.quoted.double.interpolated.pilot",
                        "(f)(\")", "\"",
                        [
                            tm_cap("1", "storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot"),
                            tm_cap("2", "punctuation.definition.string.begin.pilot"),
                        ],
                        [tm_cap("0", "punctuation.definition.string.end.pilot")],
                        [
                            tm_match("constant.character.escape.pilot", "\\\\."),
                            tm_block_caps(
                                "meta.interpolation.pilot", "\\{", "\\}",
                                [tm_cap("0", "punctuation.definition.template-expression.begin.pilot")],
                                [tm_cap("0", "punctuation.definition.template-expression.end.pilot")],
                                [tm_include("$self")]
                            ),
                        ]
                    ),
                    tm_block(
                        "string.quoted.double.pilot", "\"", "\"",
                        [tm_match("constant.character.escape.pilot", "\\\\.")]
                    ),
                    tm_match("string.quoted.single.pilot", "'(?:[^'\\\\\\n\\r]|\\\\.)*'"),
                ],
            },
            TmSection {
                name: "raw-idents",
                rules: [
                    tm_match("variable.other.escaped.pilot", "`[^`\\r\\n]+`"),
                ],
            },
            TmSection {
                name: "attributes",
                rules: [
                    tm_block_caps(
                        "meta.attribute.pilot",
                        "\\[(?=\\s*(?:(?:var|let)\\s+[a-z_][A-Za-z0-9_]*\\s*=\\s*)?[A-Z][A-Za-z0-9_]*(?:\\(|$|\\s*[\\]\\,]))",
                        "\\]",
                        [tm_cap("0", "punctuation.brackets.square.pilot")],
                        [tm_cap("0", "punctuation.brackets.square.pilot")],
                        [
                            tm_match("keyword.declaration.variable.pilot keyword.other.pilot", "\\b(let|var)\\b"),
                            tm_match("entity.name.function.decorator.pilot support.type.decorator.pilot", "\\b([A-Z][A-Za-z0-9_]*)\\b"),
                            tm_include("#comments"),
                            tm_include("#strings"),
                            tm_include("#constants"),
                            tm_include("#numbers"),
                            tm_include("#primitives"),
                            tm_include("#call-targets"),
                            tm_include("#punctuation"),
                            tm_include("#variables"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "quote-splices",
                rules: [
                    tm_match("variable.other.metavariable.splice.pilot", "\\$[A-Za-z_][A-Za-z0-9_]*"),
                    tm_match("punctuation.operator.unquote.pilot", "~(?=[A-Za-z_(])"),
                ],
            },
            TmSection {
                name: "symbols",
                rules: [
                    tm_match("constant.other.symbol.pilot", "(?<![:a-zA-Z0-9_]):[a-zA-Z_][a-zA-Z0-9_]*(?:/[a-zA-Z_][a-zA-Z0-9_]*)?"),
                ],
            },
            TmSection {
                name: "declarations",
                rules: [
                    tm_match_caps(
                        "meta.function.declaration.pilot",
                        "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                        [
                            tm_cap("1", "keyword.declaration.function.pilot keyword.control.pilot"),
                            tm_cap("2", "entity.name.function.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.operator.declaration.pilot",
                        "\\b(op)\\s+([^\\s\\(\\);\\{]+)",
                        [
                            tm_cap("1", "keyword.declaration.operator.pilot keyword.control.pilot"),
                            tm_cap("2", "entity.name.function.operator.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.type.declaration.pilot",
                        "\\b(struct|interface|enum|actor|state|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                        [
                            tm_cap("1", "keyword.declaration.type.pilot keyword.control.pilot"),
                            tm_cap("2", "entity.name.type.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.distributive.binding.pilot",
                        "\\b(let|var)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?=<|\\{)",
                        [
                            tm_cap("1", "keyword.declaration.variable.pilot keyword.other.pilot"),
                            tm_cap("2", "entity.name.type.struct.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "keywords",
                rules: [
                    tm_match_caps(
                        "meta.syntax.declaration.type-construct.pilot",
                        "\\b(syntax)\\s+(type_construct)\\b",
                        [
                            tm_cap("1", "keyword.control.syntax.pilot"),
                            tm_cap("2", "keyword.control.type-construct.pilot"),
                        ]
                    ),
                    tm_match("keyword.control.syntax.pilot", f"\\b({syn_pat})\\b"),
                    tm_match("keyword.control.seed.pilot", f"\\b({seed_pat})\\b"),
                ],
            },
            TmSection {
                name: "modifiers",
                rules: [
                    tm_match("storage.modifier.pilot", f"\\b({mod_pat})\\b"),
                ],
            },
            TmSection {
                name: "primitives",
                rules: [
                    tm_match("support.type.primitive.pilot entity.name.type.primitive.pilot", f"\\b({prim_pat})\\b"),
                    tm_match("support.type.system.pilot entity.name.type.pilot", "\\b(ArenaScope|AstContext|CallExpr|ClampAttr|Dual|EffectPlan|FormulaAttr|HardRealtimeAttr|IdeContextPolicy|IdePresentationPolicy|IdeTokenAttr|InheritPolicy|KernelAttr|LspKind|LspMod|OnChangeAttr|PatchAttr|PatchPart|PatchReplaceAttr|Quantity|RangeEnumerator|RangeWindow|RuleAttr|Signal|SliceBuffer|SliceEnumerator|SpanEnumerator|StrideEnumerator|TraceSpanAttr|WcetAttr|ZeroRuntimeAttr)\\b"),
                    tm_match("entity.name.type.interface.pilot", "\\bI[A-Z][A-Za-z0-9_]*\\b"),
                    tm_match("entity.name.type.pilot", "\\b[A-Z][A-Za-z0-9_]*\\b"),
                ],
            },
            TmSection {
                name: "call-targets",
                rules: [
                    tm_match_caps(
                        "meta.function.call.quoted.pilot",
                        "\\b([a-zA-Z_][a-zA-Z0-9_]*)(!!|!&|!\\^|!@|!\\?|!)(?=\\s*\\()",
                        [
                            tm_cap("1", "entity.name.function.call.pilot"),
                            tm_cap("2", "punctuation.operator.call-quote.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.method.call.pilot",
                        "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                        [
                            tm_cap("1", "entity.name.function.member.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.property.access.pilot",
                        "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                        [
                            tm_cap("1", "variable.other.property.pilot"),
                        ]
                    ),
                    tm_match("entity.name.type.struct.constructor.pilot", "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\(|\\{|<)"),
                    tm_match("entity.name.function.call.pilot", "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"),
                ],
            },
            TmSection {
                name: "constants",
                rules: [
                    tm_match_caps(
                        "",
                        "(::)([A-Za-z_][A-Za-z0-9_]*)",
                        [
                            tm_cap("1", "punctuation.separator.enum.pilot"),
                            tm_cap("2", "variable.other.enummember.pilot constant.other.enum.pilot"),
                        ]
                    ),
                    tm_match("constant.language.boolean.pilot", "\\b(true|false)\\b"),
                    tm_match("constant.language.null.pilot", "\\b(none|null)\\b"),
                    tm_match("variable.language.self.pilot", "\\bself\\b"),
                ],
            },
            TmSection {
                name: "object-keys",
                rules: [
                    tm_match_caps(
                        "",
                        "(?<![a-zA-Z0-9_])([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
                        [
                            tm_cap("1", "meta.object-literal.key.pilot meta.property-name.pilot variable.other.property.pilot"),
                            tm_cap("2", "punctuation.separator.key-value.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "numbers",
                rules: [
                    tm_match("constant.numeric.hex.pilot", "\\b0[xX][0-9a-fA-F_]+(?:[a-zA-Z]+)?\\b"),
                    tm_match("constant.numeric.binary.pilot", "\\b0[bB][01_]+(?:[a-zA-Z]+)?\\b"),
                    tm_match("constant.numeric.octal.pilot", "\\b0[oO][0-7_]+(?:[a-zA-Z]+)?\\b"),
                    tm_match_caps(
                        "",
                        "\\b([0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(ns|us|ms|s|Hz|kHz|MHz|GHz|B|KB|MB|GB|TB)?\\b",
                        [
                            tm_cap("1", "constant.numeric.pilot"),
                            tm_cap("2", "keyword.other.unit.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "operators",
                rules: [
                    tm_match("punctuation.operator.call-quote.pilot", "!!|!&|!\\^|!@|!\\?"),
                    tm_match("punctuation.operator.cascade.pilot", "\\?\\.\\.|\\.\\."),
                    tm_match("punctuation.operator.pipeline.pilot", "\\|>|<\\||=>|->|<-"),
                    tm_match("punctuation.operator.range.pilot", ">\\.\\.<|\\*\\.\\.|\\.\\.<|\\.\\.=|>=|<=|>\\.\\."),
                    tm_match("punctuation.operator.null-safe.pilot", "\\?\\?|\\?"),
                    tm_match("punctuation.operator.comparison.pilot", "==|!=|<=|>=|<=>|<|>"),
                    tm_match("punctuation.operator.assignment.pilot", ":=:|:=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|="),
                    tm_match("punctuation.operator.logical.pilot", "&&|\\|\\||!"),
                    tm_match("punctuation.operator.spread.pilot", "\\*\\.\\.|\\*\\*|\\*"),
                    tm_match("punctuation.operator.arithmetic.pilot", op_pat),
                ],
            },
            TmSection {
                name: "punctuation",
                rules: [
                    tm_match("punctuation.terminator.statement.pilot", ";"),
                    tm_match("punctuation.separator.comma.pilot", ","),
                    tm_match("punctuation.separator.colon.pilot", ":"),
                    tm_match("punctuation.accessor.dot.pilot", "\\."),
                    tm_match("punctuation.brackets.curly.pilot", "[{}]"),
                    tm_match("punctuation.brackets.round.pilot", "[()]"),
                    tm_match("punctuation.brackets.square.pilot", "[\\[\\]]"),
                ],
            },
            TmSection {
                name: "variables",
                rules: [
                    tm_match("variable.other.readwrite.pilot", "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"),
                ],
            },
        ],
    };
}

