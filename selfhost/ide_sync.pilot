pure fn tm_comments_section() -> str => "    \"comments\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"comment.line.documentation.pilot\", \"match\": \"///.*$\" },\n" +
    "        { \"name\": \"comment.block.documentation.pilot\", \"begin\": \"/\\\\*\\\\*\", \"end\": \"\\\\*/\" },\n" +
    "        { \"name\": \"comment.line.double-slash.pilot\", \"match\": \"//.*$\" },\n" +
    "        { \"name\": \"comment.block.pilot\", \"begin\": \"/\\\\*\", \"end\": \"\\\\*/\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_preprocessor_section() -> str => "    \"preprocessor\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"meta.preprocessor.pilot\",\n" +
    "          \"match\": \"^\\\\s*(#(?:define|undef|if|elif|else|endif|region|endregion|error|warning|pragma|line))\\\\b(.*)$\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.directive.pilot\" },\n" +
    "            \"2\": { \"name\": \"string.unquoted.preprocessor.pilot\" }\n" +
