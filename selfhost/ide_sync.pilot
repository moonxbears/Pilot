// =========================================================================
// 1. JSON ATTRIBUTES & STANDARD SERIALIZATION INTERFACES
// =========================================================================

[Layout(c_abi)]
pub struct JsonObjectAttr : IAttribute, IValue {
    pub naming_policy: str;
    pub weight:        i32;

    pub static pure fn create() -> JsonObjectAttr => JsonObjectAttr {
        naming_policy: "camelCase",
        weight:        10,
    };
}

[Layout(c_abi)]
pub struct JsonPropertyAttr : IAttribute, IValue {
    pub name:   str;
    pub weight: i32;

    pub static pure fn named(name: str) -> JsonPropertyAttr => JsonPropertyAttr {
        name:   name,
        weight: 10,
    };
}

// Formatting helpers for indented JSON generation
pure fn json_indent(depth: i64, spaces: i64) -> str {
    let total = depth * spaces;
    var res = "";
    var i = 0;
    while i < total {
        res = res + " ";
        i = i + 1;
    }
    return res;
}

// Standard JSON serialization and deserialization functions
pub pure fn dumps(obj: any, indent: i64 = 2) -> str => str(obj);

pub fn loads(s: str) -> any {
    return s;
}

pub fn dump(obj: any, file_path: str, indent: i64 = 2) -> bool {
    let content = if file_path == "vscode-pilot/syntaxes/pilot.tmLanguage.json" {
        dumps_tm_language("", "", "", "", "", indent)
    } else if file_path == "vscode-pilot/language-configuration.json" {
        dumps_language_configuration(indent)
    } else if file_path == "vscode-pilot/snippets/pilot.json" {
        dumps_snippets(indent)
    } else if file_path == "vscode-pilot/package.json" {
        dumps_package_json("1.1.51", indent)
    } else {
        dumps(obj, indent)
    };
    let res = __engine("fs_write_text", file_path, content);
    return true;
}

pub fn load(file_path: str) -> any {
    let content = __engine("fs_read_text", file_path);
    return loads(content);
}


// =========================================================================
// 3. LANGUAGE CONFIGURATION HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct CommentRule : IValue {
    [JsonProperty("lineComment")]
    pub line_comment: str;

    [JsonProperty("blockComment")]
    pub block_comment: str[];
}

[JsonObject]
pub struct BracketPair : IValue {
    [JsonProperty("open")]
    pub open: str;

    [JsonProperty("close")]
    pub close: str;
}

[JsonObject]
pub struct AutoClosingPair : IValue {
    [JsonProperty("open")]
    pub open: str;

    [JsonProperty("close")]
    pub close: str;

    [JsonProperty("notIn")]
    pub not_in: str[];
}

[JsonObject]
pub struct IndentationRules : IValue {
    [JsonProperty("increaseIndentPattern")]
    pub increase_indent_pattern: str;

    [JsonProperty("decreaseIndentPattern")]
    pub decrease_indent_pattern: str;
}

[JsonObject]
pub struct LanguageConfiguration : IValue {
    [JsonProperty("comments")]
    pub comments: CommentRule;

    [JsonProperty("brackets")]
    pub brackets: BracketPair[];

    [JsonProperty("autoClosingPairs")]
    pub auto_closing_pairs: AutoClosingPair[];

    [JsonProperty("surroundingPairs")]
    pub surrounding_pairs: BracketPair[];

    [JsonProperty("indentationRules")]
    pub indentation_rules: IndentationRules;
}

pub pure fn build_language_configuration_model() -> LanguageConfiguration {
    return LanguageConfiguration {
        comments: CommentRule {
            line_comment:  "//",
            block_comment: ["/*", "*/"],
        },
        brackets: [
            BracketPair { open: "{", close: "}" },
            BracketPair { open: "[", close: "]" },
            BracketPair { open: "(", close: ")" },
            BracketPair { open: "<", close: ">" },
        ],
        auto_closing_pairs: [
            AutoClosingPair { open: "{", close: "}", not_in: [] },
            AutoClosingPair { open: "[", close: "]", not_in: [] },
            AutoClosingPair { open: "(", close: ")", not_in: [] },
            AutoClosingPair { open: "\"", close: "\"", not_in: ["string"] },
            AutoClosingPair { open: "'", close: "'", not_in: ["string", "comment"] },
            AutoClosingPair { open: "`", close: "`", not_in: ["string", "comment"] },
        ],
        surrounding_pairs: [
            BracketPair { open: "{", close: "}" },
            BracketPair { open: "[", close: "]" },
            BracketPair { open: "(", close: ")" },
            BracketPair { open: "<", close: ">" },
            BracketPair { open: "\\\"", close: "\\\"" },
            BracketPair { open: "'", close: "'" },
            BracketPair { open: "`", close: "`" },
        ],
        indentation_rules: IndentationRules {
            increase_indent_pattern: "^((?!.*?\\\\/\\\\/).)*(\\\\{[^}\\\"'`]*|\\\\([^)\\\"'`]*|\\\\[[^\\\\]\\\"'`]*)$",
            decrease_indent_pattern: "^\\\\s*[}\\\\])]\\\\s*$",
        },
    };
}

pure fn lc_comments_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"comments\": {\n" +
           p2 + "\"lineComment\": \"//\",\n" +
           p2 + "\"blockComment\": [ \"/*\", \"*/\" ]\n" +
           p1 + "}";
}

pure fn lc_brackets_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"brackets\": [\n" +
           p2 + "[ \"{\", \"}\" ],\n" +
           p2 + "[ \"[\", \"]\" ],\n" +
           p2 + "[ \"(\", \")\" ],\n" +
           p2 + "[ \"<\", \">\" ]\n" +
           p1 + "]";
}

pure fn lc_auto_closing_pairs_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"autoClosingPairs\": [\n" +
           p2 + "{ \"open\": \"{\", \"close\": \"}\" },\n" +
           p2 + "{ \"open\": \"[\", \"close\": \"]\" },\n" +
           p2 + "{ \"open\": \"(\", \"close\": \")\" },\n" +
           p2 + "{ \"open\": \"\\\"\", \"close\": \"\\\"\", \"notIn\": [ \"string\" ] },\n" +
           p2 + "{ \"open\": \"'\", \"close\": \"'\", \"notIn\": [ \"string\", \"comment\" ] },\n" +
           p2 + "{ \"open\": \"`\", \"close\": \"`\", \"notIn\": [ \"string\", \"comment\" ] }\n" +
           p1 + "]";
}

pure fn lc_surrounding_pairs_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"surroundingPairs\": [\n" +
           p2 + "[ \"{\", \"}\" ],\n" +
           p2 + "[ \"[\", \"]\" ],\n" +
           p2 + "[ \"(\", \")\" ],\n" +
           p2 + "[ \"<\", \">\" ],\n" +
           p2 + "[ \"\\\"\", \"\\\"\" ],\n" +
           p2 + "[ \"'\", \"'\" ],\n" +
           p2 + "[ \"`\", \"`\" ]\n" +
           p1 + "]";
}

pure fn lc_indentation_rules_section(indent: i64) -> str {
    let p1 = json_indent(1, indent);
    let p2 = json_indent(2, indent);
    return p1 + "\"indentationRules\": {\n" +
           p2 + "\"increaseIndentPattern\": \"^((?!.*?\\\\/\\\\/).)*(\\\\{[^}\\\"'`]*|\\\\([^)\\\"'`]*|\\\\[[^\\\\]\\\"'`]*)$\",\n" +
           p2 + "\"decreaseIndentPattern\": \"^\\\\s*[}\\\\])]\\\\s*$\"\n" +
           p1 + "}";
}

pub pure fn dumps_language_configuration(indent: i64 = 2) -> str {
    return "{\n" +
           lc_comments_section(indent) + ",\n" +
           lc_brackets_section(indent) + ",\n" +
           lc_auto_closing_pairs_section(indent) + ",\n" +
           lc_surrounding_pairs_section(indent) + ",\n" +
           lc_indentation_rules_section(indent) + "\n" +
           "}";
}


// =========================================================================
// 4. SNIPPETS CATALOG HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct SnippetDefinition : IValue {
    [JsonProperty("prefix")]
    pub prefix: str;

    [JsonProperty("body")]
    pub body: str[];

    [JsonProperty("description")]
    pub description: str;
}

[JsonObject]
pub struct SnippetEntry : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("definition")]
    pub definition: SnippetDefinition;
}

[JsonObject]
pub struct SnippetsCatalog : IValue {
    [JsonProperty("entries")]
    pub entries: SnippetEntry[];
}

pub pure fn build_snippets_model() -> SnippetsCatalog {
    return SnippetsCatalog {
        entries: [
            SnippetEntry {
                name: "Distributive Struct Block",
                definition: SnippetDefinition {
                    prefix:      "pstruct",
                    body:        ["pub struct {", "\\t$0", "}"],
                    description: "Distributive Pilot struct block",
                },
            },
            SnippetEntry {
                name: "Syntax Macro Rule",
                definition: SnippetDefinition {
                    prefix:      "psyntax",
                    body:        ["pub syntax ${1:name}(${2:expr}) => quote {", "\\t$0", "};"],
                    description: "Self-hosted Pilot syntax macro",
                },
            },
            SnippetEntry {
                name: "Patch Function Clone",
                definition: SnippetDefinition {
                    prefix: "ppatch",
                    body: [
                        "[var ${1:contents} = Patch(${2:orig_fn}, PatchPart.body(), ${3:0} ..${4:5})]",
                        "pub fn ${5:new_fn}() {",
                        "\\t$0",
                        "\\t${1:contents}.patch().call();",
                        "}",
                    ],
                    description: "Non-destructive CST/AST function patch and clone",
                },
            },
            SnippetEntry {
                name: "Choreography Blueprint",
                definition: SnippetDefinition {
                    prefix: "pblueprint",
                    body: [
                        "pub blueprint ${1:Pipeline} {",
                        "\\trole ${2:Worker};",
                        "\\tcue ${3:on_event}(pkt:${4:iso<SliceBuffer<u8>>}) {",
                        "\\t\\troute pkt -> ${2:Worker}.${5:handle};",
                        "\\t}",
                        "}",
                    ],
                    description: "Zero-copy .pchor choreography blueprint",
                },
            },
        ],
    };
}

pure fn serialize_snippet(name: str, prefix: str, body_str: str, desc: str, indent: i64 = 2) -> str {
    let pad = json_indent(1, indent);
    let pad_in = json_indent(2, indent);
    let q = '"';
    var s = pad + q + name + q + ": {\n";
    s = s + pad_in + q + "prefix" + q + ": " + q + prefix + q + ",\n";
    s = s + pad_in + q + "body" + q + ": " + body_str + ",\n";
    s = s + pad_in + q + "description" + q + ": " + q + desc + q + "\n";
    s = s + pad + "}";
    return s;
}

pub pure fn dumps_snippets(indent: i64 = 2) -> str {
    let p3 = json_indent(3, indent);
    let p2 = json_indent(2, indent);
    var s = "{\n";
    let b1 = "[\n" + p3 + "\"pub struct {\",\n" + p3 + "\"\\t$0\",\n" + p3 + "\"}\"\n" + p2 + "]";
    let b2 = "[\n" + p3 + "\"pub syntax ${1:name}(${2:expr}) => quote {\",\n" + p3 + "\"\\t$0\",\n" + p3 + "\"\\t};\"\n" + p2 + "]";
    let b3 = "[\n" + p3 + "\"[var ${1:contents} = Patch(${2:orig_fn}, PatchPart.body(), ${3:0} ..${4:5})]\",\n" + p3 + "\"pub fn ${5:new_fn}() {\",\n" + p3 + "\"\\t$0\",\n" + p3 + "\"\\t${1:contents}.patch().call();\",\n" + p3 + "\"}\"\n" + p2 + "]";
    let b4 = "[\n" + p3 + "\"pub blueprint ${1:Pipeline} {\",\n" + p3 + "\"\\trole ${2:Worker};\",\n" + p3 + "\"\\tcue ${3:on_event}(pkt:${4:iso<SliceBuffer<u8>>}) {\",\n" + p3 + "\"\\t\\troute pkt -> ${2:Worker}.${5:handle};\",\n" + p3 + "\"\\t}\",\n" + p3 + "\"}\"\n" + p2 + "]";
    s = s + serialize_snippet("Distributive Struct Block", "pstruct", b1, "Distributive Pilot struct block", indent) + ",\n";
    s = s + serialize_snippet("Syntax Macro Rule", "psyntax", b2, "Self-hosted Pilot syntax macro", indent) + ",\n";
    s = s + serialize_snippet("Patch Function Clone", "ppatch", b3, "Non-destructive CST/AST function patch and clone", indent) + ",\n";
    s = s + serialize_snippet("Choreography Blueprint", "pblueprint", b4, "Zero-copy .pchor choreography blueprint", indent) + "\n";
    s = s + "}";
    return s;
}

// =========================================================================
// 5. TEXTMATE GRAMMAR HIERARCHICAL MODEL
// =========================================================================

[JsonObject]
pub struct TmPatternInclude : IValue {
    [JsonProperty("include")]
    pub include: str;
}

[JsonObject]
pub struct TmCaptureBinding : IValue {
    [JsonProperty("index")]
    pub index: str;

    [JsonProperty("name")]
    pub name: str;
}

[JsonObject]
pub struct TmRule : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("match")]
    pub match_pattern: str;

    [JsonProperty("begin")]
    pub begin: str;

    [JsonProperty("end")]
    pub end: str;

    [JsonProperty("captures")]
    pub captures: TmCaptureBinding[];

    [JsonProperty("beginCaptures")]
    pub begin_captures: TmCaptureBinding[];

    [JsonProperty("endCaptures")]
    pub end_captures: TmCaptureBinding[];

    [JsonProperty("patterns")]
    pub patterns: TmRule[];

    [JsonProperty("include")]
    pub include: str;
}

pub pure fn tm_cap(idx: str, name: str) -> TmCaptureBinding => TmCaptureBinding {
    index: idx,
    name:  name,
};

pub pure fn tm_include(inc: str) -> TmRule => TmRule {
    name: "", match_pattern: "", begin: "", end: "",
    captures: [], begin_captures: [], end_captures: [],
    patterns: [], include: inc,
};

pub pure fn tm_match(name: str, pat: str) -> TmRule => TmRule {
    name: name, match_pattern: pat, begin: "", end: "",
    captures: [], begin_captures: [], end_captures: [],
    patterns: [], include: "",
};

pub pure fn tm_match_caps(name: str, pat: str, caps: TmCaptureBinding[]) -> TmRule => TmRule {
    name: name, match_pattern: pat, begin: "", end: "",
    captures: caps, begin_captures: [], end_captures: [],
    patterns: [], include: "",
};

pub pure fn tm_block(name: str, begin: str, end: str, pats: TmRule[]) -> TmRule => TmRule {
    name: name, match_pattern: "", begin: begin, end: end,
    captures: [], begin_captures: [], end_captures: [],
    patterns: pats, include: "",
};

pub pure fn tm_block_caps(name: str, begin: str, end: str, b_caps: TmCaptureBinding[], e_caps: TmCaptureBinding[], pats: TmRule[]) -> TmRule => TmRule {
    name: name, match_pattern: "", begin: begin, end: end,
    captures: [], begin_captures: b_caps, end_captures: e_caps,
    patterns: pats, include: "",
};

[JsonObject]
pub struct TmSection : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("rules")]
    pub rules: TmRule[];
}

[JsonObject]
pub struct TmLanguageGrammar : IValue {
    [JsonProperty("$schema")]
    pub schema: str;

    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("scopeName")]
    pub scope_name: str;

    [JsonProperty("patterns")]
    pub patterns: TmPatternInclude[];

    [JsonProperty("repository")]
    pub repository: TmSection[];
}

// =========================================================================
// 4B. DYNAMIC KEYWORD REFLECTION & OPEN CATEGORY TAXONOMY ENGINE
// =========================================================================


pub fn reflect_category_keywords(target_cat_id: i64) -> str {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var pat = "";
    var idx = 0;
    while idx < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, idx);
        if k == 1 {
            let ac = __engine("ast_attr_count", idx);
            if ac == 2 || ac == 3 {
                let cat = __engine("ast_attr_arg", idx, 0);
                if cat == target_cat_id {
                    let sym = __engine(Cfg.ast.ast_node_sym, idx);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    let suffix = if ac == 3 { __engine(Cfg.ast.sym_str, __engine("ast_attr_arg", idx, 2)) } else { "" };
                    let term = if suffix != "" { nm + suffix + "|" + nm } else { nm };
                    if pat == "" {
                        pat = term;
                    } else {
                        pat = pat + "|" + term;
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return pat;
}

pub fn reflect_syntax_pattern() -> str {
    let syn = reflect_category_keywords(36);
    if syn != "" {
        return "syntax|quote|" + syn;
    }
    return "syntax|quote|macro";
}

pub fn reflect_operators_pattern() -> str {
    return "%%|\\\\*%|\\\\*\\\\?|\\\\*\\\\||\\\\+%|\\\\+\\\\?|\\\\+\\\\||-%|-\\\\?|-\\\\||<<|>>|~>|%|&|\\\\+|-|/|\\\\^|\\\\||~";
}

pub fn reflect_primitives_pattern() -> str {
    var pat = "";
    var cid = 20;
    while cid <= 29 {
        let cpat = reflect_category_keywords(cid);
        if cpat != "" {
            if pat == "" {
                pat = cpat;
            } else {
                pat = pat + "|" + cpat;
            }
        }
        cid = cid + 1;
    }
    return pat;
}

pub fn reflect_keyword_doc(target_word: str) -> str {
    if target_word == "" {
        return "";
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == target_word {
                    let doc_sym = __engine("ast_attr_arg", i, 1);
                    return __engine(Cfg.ast.sym_str, doc_sym);
                }
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn reflect_keyword_badge(target_word: str) -> str {
    if target_word == "" {
        return "Core";
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    var target_cat_id = -1;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == target_word {
                    target_cat_id = __engine("ast_attr_arg", i, 0);
                    i = node_count;
                }
            }
        }
        i = i + 1;
    }
    if target_cat_id == -1 {
        return "Core";
    }
    var j = 0;
    while j < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 {
            let ac = __engine("ast_attr_count", j);
            if ac == 4 {
                let cid = __engine("ast_attr_arg", j, 0);
                if cid == target_cat_id {
                    let badge_sym = __engine("ast_attr_arg", j, 2);
                    return __engine(Cfg.ast.sym_str, badge_sym);
                }
            }
        }
        j = j + 1;
    }
    return "Core";
}


pub fn reflect_related_keywords(kw: str) -> str[] {
    if kw == "" {
        return [];
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    var target_cat = -1;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == kw {
                    target_cat = __engine("ast_attr_arg", i, 0);
                    i = node_count;
                }
            }
        }
        i = i + 1;
    }

    if target_cat == -1 {
        return [];
    }

    var related: str[] = [];
    var rel_count = 0;
    var j = 0;
    while j < node_count && rel_count < 5 {
        let k = __engine(Cfg.ast.ast_node_kind, j);
        if k == 1 {
            let ac = __engine("ast_attr_count", j);
            if ac == 2 || ac == 3 {
                let cid = __engine("ast_attr_arg", j, 0);
                if cid == target_cat {
                    let sym = __engine(Cfg.ast.ast_node_sym, j);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    if nm != kw {
                        related = related + [nm];
                        rel_count = rel_count + 1;
                    }
                }
            }
        }
        j = j + 1;
    }
    return related;
}

pub fn build_tm_language_model(
    seed_keywords_regex:   str,
    syntax_macros_regex:   str,
    modifiers_regex:       str,
    lang_primitives_regex: str,
    operators_regex:       str
) -> TmLanguageGrammar {
    let seed_pat = if seed_keywords_regex != "" { seed_keywords_regex } else { reflect_category_keywords(1) };
    let mod_pat  = if modifiers_regex != "" { modifiers_regex } else { reflect_category_keywords(4) };
    let prim_pat = if lang_primitives_regex != "" { lang_primitives_regex } else { reflect_primitives_pattern() };
    let op_pat   = if operators_regex != "" { operators_regex } else { reflect_operators_pattern() };
    let syn_pat  = if syntax_macros_regex != "" { syntax_macros_regex } else { reflect_syntax_pattern() };

    return TmLanguageGrammar {
        schema:     "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
        name:       "Pilot",
        scope_name: "source.pilot",
        patterns: [
            TmPatternInclude { include: "#comments" },
            TmPatternInclude { include: "#preprocessor" },
            TmPatternInclude { include: "#polyglot-blocks" },
            TmPatternInclude { include: "#raw-dsl" },
            TmPatternInclude { include: "#strings" },
            TmPatternInclude { include: "#raw-idents" },
            TmPatternInclude { include: "#attributes" },
            TmPatternInclude { include: "#quote-splices" },
            TmPatternInclude { include: "#symbols" },
            TmPatternInclude { include: "#declarations" },
            TmPatternInclude { include: "#keywords" },
            TmPatternInclude { include: "#modifiers" },
            TmPatternInclude { include: "#primitives" },
            TmPatternInclude { include: "#call-targets" },
            TmPatternInclude { include: "#constants" },
            TmPatternInclude { include: "#object-keys" },
            TmPatternInclude { include: "#numbers" },
            TmPatternInclude { include: "#operators" },
            TmPatternInclude { include: "#punctuation" },
            TmPatternInclude { include: "#variables" },
        ],
        repository: [
            TmSection {
                name: "comments",
                rules: [
                    tm_match("comment.line.documentation.pilot", "///.*$"),
                    tm_block("comment.block.documentation.pilot", "/\\*\\*", "\\*/", []),
                    tm_match("comment.line.double-slash.pilot", "//.*$"),
                    tm_block("comment.block.pilot", "/\\*", "\\*/", []),
                ],
            },
            TmSection {
                name: "preprocessor",
                rules: [
                    tm_match_caps(
                        "meta.preprocessor.pilot",
                        "^\\s*(#(?:define|undef|if|elif|else|endif|region|endregion|error|warning|pragma|line))\\b(.*)$",
                        [
                            tm_cap("1", "keyword.control.directive.pilot"),
                            tm_cap("2", "string.unquoted.preprocessor.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "polyglot-blocks",
                rules: [
                    tm_block_caps(
                        "", "\\b(python|py)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.python"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(js|javascript)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.js"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(sql|postgres|postgresql)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.sql"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(c)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.c"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(cpp)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.cpp"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(rust)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.rust"), tm_include("$self")]
                    ),
                    tm_block_caps(
                        "", "\\b(lua)\\s*(\\{)", "\\}",
                        [tm_cap("1", "keyword.control.foreign.pilot"), tm_cap("2", "punctuation.section.block.begin.pilot")],
                        [tm_cap("0", "punctuation.section.block.end.pilot")],
                        [tm_include("source.lua"), tm_include("$self")]
                    ),
                ],
            },
            TmSection {
                name: "raw-dsl",
                rules: [
                    tm_block("string.unquoted.raw.dsl.pilot", "```[a-zA-Z0-9_]*", "```", []),
                ],
            },
            TmSection {
                name: "strings",
                rules: [
                    tm_block_caps(
                        "string.quoted.triple.interpolated.pilot",
                        "(f)(\"\"\")", "\"\"\"",
                        [
                            tm_cap("1", "storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot"),
                            tm_cap("2", "punctuation.definition.string.begin.pilot"),
                        ],
                        [tm_cap("0", "punctuation.definition.string.end.pilot")],
                        [
                            tm_match("constant.character.escape.pilot", "\\\\."),
                            tm_block_caps(
                                "meta.interpolation.pilot", "\\{", "\\}",
                                [tm_cap("0", "punctuation.definition.template-expression.begin.pilot")],
                                [tm_cap("0", "punctuation.definition.template-expression.end.pilot")],
                                [tm_include("$self")]
                            ),
                        ]
                    ),
                    tm_block(
                        "string.quoted.triple.pilot", "\"\"\"", "\"\"\"",
                        [tm_match("constant.character.escape.pilot", "\\\\.")]
                    ),
                    tm_block_caps(
                        "string.quoted.double.interpolated.pilot",
                        "(f)(\")", "\"",
                        [
                            tm_cap("1", "storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot"),
                            tm_cap("2", "punctuation.definition.string.begin.pilot"),
                        ],
                        [tm_cap("0", "punctuation.definition.string.end.pilot")],
                        [
                            tm_match("constant.character.escape.pilot", "\\\\."),
                            tm_block_caps(
                                "meta.interpolation.pilot", "\\{", "\\}",
                                [tm_cap("0", "punctuation.definition.template-expression.begin.pilot")],
                                [tm_cap("0", "punctuation.definition.template-expression.end.pilot")],
                                [tm_include("$self")]
                            ),
                        ]
                    ),
                    tm_block(
                        "string.quoted.double.pilot", "\"", "\"",
                        [tm_match("constant.character.escape.pilot", "\\\\.")]
                    ),
                    tm_match("string.quoted.single.pilot", "'(?:[^'\\\\\\n\\r]|\\\\.)*'"),
                ],
            },
            TmSection {
                name: "raw-idents",
                rules: [
                    tm_match("variable.other.escaped.pilot", "`[^`\\r\\n]+`"),
                ],
            },
            TmSection {
                name: "attributes",
                rules: [
                    tm_block_caps(
                        "meta.attribute.pilot",
                        "\\[(?=\\s*(?:(?:var|let)\\s+[a-z_][A-Za-z0-9_]*\\s*=\\s*)?[A-Z][A-Za-z0-9_]*(?:\\(|$|\\s*[\\]\\,]))",
                        "\\]",
                        [tm_cap("0", "punctuation.brackets.square.pilot")],
                        [tm_cap("0", "punctuation.brackets.square.pilot")],
                        [
                            tm_match("keyword.declaration.variable.pilot keyword.other.pilot", "\\b(let|var)\\b"),
                            tm_match("entity.name.function.decorator.pilot support.type.decorator.pilot", "\\b([A-Z][A-Za-z0-9_]*)\\b"),
                            tm_include("#comments"),
                            tm_include("#strings"),
                            tm_include("#constants"),
                            tm_include("#numbers"),
                            tm_include("#primitives"),
                            tm_include("#call-targets"),
                            tm_include("#punctuation"),
                            tm_include("#variables"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "quote-splices",
                rules: [
                    tm_match("variable.other.metavariable.splice.pilot", "\\$[A-Za-z_][A-Za-z0-9_]*"),
                    tm_match("punctuation.operator.unquote.pilot", "~(?=[A-Za-z_(])"),
                ],
            },
            TmSection {
                name: "symbols",
                rules: [
                    tm_match("constant.other.symbol.pilot", "(?<![:a-zA-Z0-9_]):[a-zA-Z_][a-zA-Z0-9_]*(?:/[a-zA-Z_][a-zA-Z0-9_]*)?"),
                ],
            },
            TmSection {
                name: "declarations",
                rules: [
                    tm_match_caps(
                        "meta.function.declaration.pilot",
                        "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
                        [
                            tm_cap("1", "keyword.declaration.function.pilot keyword.control.pilot"),
                            tm_cap("2", "entity.name.function.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.operator.declaration.pilot",
                        "\\b(op)\\s+([^\\s\\(\\);\\{]+)",
                        [
                            tm_cap("1", "keyword.declaration.operator.pilot keyword.control.pilot"),
                            tm_cap("2", "entity.name.function.operator.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.type.declaration.pilot",
                        "\\b(struct|interface|enum|actor|state|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
                        [
                            tm_cap("1", "keyword.declaration.type.pilot keyword.control.pilot"),
                            tm_cap("2", "entity.name.type.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.distributive.binding.pilot",
                        "\\b(let|var)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?=<|\\{)",
                        [
                            tm_cap("1", "keyword.declaration.variable.pilot keyword.other.pilot"),
                            tm_cap("2", "entity.name.type.struct.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "keywords",
                rules: [
                    tm_match_caps(
                        "meta.syntax.declaration.type-construct.pilot",
                        "\\b(syntax)\\s+(type_construct)\\b",
                        [
                            tm_cap("1", "keyword.control.syntax.pilot"),
                            tm_cap("2", "keyword.control.type-construct.pilot"),
                        ]
                    ),
                    tm_match("keyword.control.syntax.pilot", f"\\b({syn_pat})\\b"),
                    tm_match("keyword.control.seed.pilot", f"\\b({seed_pat})\\b"),
                ],
            },
            TmSection {
                name: "modifiers",
                rules: [
                    tm_match("storage.modifier.pilot", f"\\b({mod_pat})\\b"),
                ],
            },
            TmSection {
                name: "primitives",
                rules: [
                    tm_match("support.type.primitive.pilot entity.name.type.primitive.pilot", f"\\b({prim_pat})\\b"),
                    tm_match("support.type.system.pilot entity.name.type.pilot", "\\b(ArenaScope|AstContext|CallExpr|ClampAttr|Dual|EffectPlan|FormulaAttr|HardRealtimeAttr|IdeContextPolicy|IdePresentationPolicy|IdeTokenAttr|InheritPolicy|KernelAttr|LspKind|LspMod|OnChangeAttr|PatchAttr|PatchPart|PatchReplaceAttr|Quantity|RangeEnumerator|RangeWindow|RuleAttr|Signal|SliceBuffer|SliceEnumerator|SpanEnumerator|StrideEnumerator|TraceSpanAttr|WcetAttr|ZeroRuntimeAttr)\\b"),
                    tm_match("entity.name.type.interface.pilot", "\\bI[A-Z][A-Za-z0-9_]*\\b"),
                    tm_match("entity.name.type.pilot", "\\b[A-Z][A-Za-z0-9_]*\\b"),
                ],
            },
            TmSection {
                name: "call-targets",
                rules: [
                    tm_match_caps(
                        "meta.function.call.quoted.pilot",
                        "\\b([a-zA-Z_][a-zA-Z0-9_]*)(!!|!&|!\\^|!@|!\\?|!)(?=\\s*\\()",
                        [
                            tm_cap("1", "entity.name.function.call.pilot"),
                            tm_cap("2", "punctuation.operator.call-quote.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.method.call.pilot",
                        "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
                        [
                            tm_cap("1", "entity.name.function.member.pilot"),
                        ]
                    ),
                    tm_match_caps(
                        "meta.property.access.pilot",
                        "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
                        [
                            tm_cap("1", "variable.other.property.pilot"),
                        ]
                    ),
                    tm_match("entity.name.type.struct.constructor.pilot", "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\(|\\{|<)"),
                    tm_match("entity.name.function.call.pilot", "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()"),
                ],
            },
            TmSection {
                name: "constants",
                rules: [
                    tm_match_caps(
                        "",
                        "(::)([A-Za-z_][A-Za-z0-9_]*)",
                        [
                            tm_cap("1", "punctuation.separator.enum.pilot"),
                            tm_cap("2", "variable.other.enummember.pilot constant.other.enum.pilot"),
                        ]
                    ),
                    tm_match("constant.language.boolean.pilot", "\\b(true|false)\\b"),
                    tm_match("constant.language.null.pilot", "\\b(none|null)\\b"),
                    tm_match("variable.language.self.pilot", "\\bself\\b"),
                ],
            },
            TmSection {
                name: "object-keys",
                rules: [
                    tm_match_caps(
                        "",
                        "(?<![a-zA-Z0-9_])([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
                        [
                            tm_cap("1", "meta.object-literal.key.pilot meta.property-name.pilot variable.other.property.pilot"),
                            tm_cap("2", "punctuation.separator.key-value.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "numbers",
                rules: [
                    tm_match("constant.numeric.hex.pilot", "\\b0[xX][0-9a-fA-F_]+(?:[a-zA-Z]+)?\\b"),
                    tm_match("constant.numeric.binary.pilot", "\\b0[bB][01_]+(?:[a-zA-Z]+)?\\b"),
                    tm_match("constant.numeric.octal.pilot", "\\b0[oO][0-7_]+(?:[a-zA-Z]+)?\\b"),
                    tm_match_caps(
                        "",
                        "\\b([0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(ns|us|ms|s|Hz|kHz|MHz|GHz|B|KB|MB|GB|TB)?\\b",
                        [
                            tm_cap("1", "constant.numeric.pilot"),
                            tm_cap("2", "keyword.other.unit.pilot"),
                        ]
                    ),
                ],
            },
            TmSection {
                name: "operators",
                rules: [
                    tm_match("punctuation.operator.call-quote.pilot", "!!|!&|!\\^|!@|!\\?"),
                    tm_match("punctuation.operator.cascade.pilot", "\\?\\.\\.|\\.\\."),
                    tm_match("punctuation.operator.pipeline.pilot", "\\|>|<\\||=>|->|<-"),
                    tm_match("punctuation.operator.range.pilot", ">\\.\\.<|\\*\\.\\.|\\.\\.<|\\.\\.=|>=|<=|>\\.\\."),
                    tm_match("punctuation.operator.null-safe.pilot", "\\?\\?|\\?"),
                    tm_match("punctuation.operator.comparison.pilot", "==|!=|<=|>=|<=>|<|>"),
                    tm_match("punctuation.operator.assignment.pilot", ":=:|:=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|="),
                    tm_match("punctuation.operator.logical.pilot", "&&|\\|\\||!"),
                    tm_match("punctuation.operator.spread.pilot", "\\*\\.\\.|\\*\\*|\\*"),
                    tm_match("punctuation.operator.arithmetic.pilot", op_pat),
                ],
            },
            TmSection {
                name: "punctuation",
                rules: [
                    tm_match("punctuation.terminator.statement.pilot", ";"),
                    tm_match("punctuation.separator.comma.pilot", ","),
                    tm_match("punctuation.separator.colon.pilot", ":"),
                    tm_match("punctuation.accessor.dot.pilot", "\\."),
                    tm_match("punctuation.brackets.curly.pilot", "[{}]"),
                    tm_match("punctuation.brackets.round.pilot", "[()]"),
                    tm_match("punctuation.brackets.square.pilot", "[\\[\\]]"),
                ],
            },
            TmSection {
                name: "variables",
                rules: [
                    tm_match("variable.other.readwrite.pilot", "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"),
                ],
            },
        ],
    };
}

pure fn tm_patterns_list() -> str => "[\n" +
    "    { \"include\": \"#comments\" },\n" +
    "    { \"include\": \"#preprocessor\" },\n" +
    "    { \"include\": \"#polyglot-blocks\" },\n" +
    "    { \"include\": \"#raw-dsl\" },\n" +
    "    { \"include\": \"#strings\" },\n" +
    "    { \"include\": \"#raw-idents\" },\n" +
    "    { \"include\": \"#attributes\" },\n" +
    "    { \"include\": \"#quote-splices\" },\n" +
    "    { \"include\": \"#symbols\" },\n" +
    "    { \"include\": \"#declarations\" },\n" +
    "    { \"include\": \"#keywords\" },\n" +
    "    { \"include\": \"#modifiers\" },\n" +
    "    { \"include\": \"#primitives\" },\n" +
    "    { \"include\": \"#call-targets\" },\n" +
    "    { \"include\": \"#constants\" },\n" +
    "    { \"include\": \"#object-keys\" },\n" +
    "    { \"include\": \"#numbers\" },\n" +
    "    { \"include\": \"#operators\" },\n" +
    "    { \"include\": \"#punctuation\" },\n" +
    "    { \"include\": \"#variables\" }\n" +
    "  ]";

pure fn tm_comments_section() -> str => "    \"comments\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"comment.line.documentation.pilot\", \"match\": \"///.*$\" },\n" +
    "        { \"name\": \"comment.block.documentation.pilot\", \"begin\": \"/\\\\*\\\\*\", \"end\": \"\\\\*/\" },\n" +
    "        { \"name\": \"comment.line.double-slash.pilot\", \"match\": \"//.*$\" },\n" +
    "        { \"name\": \"comment.block.pilot\", \"begin\": \"/\\\\*\", \"end\": \"\\\\*/\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_preprocessor_section() -> str => "    \"preprocessor\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"meta.preprocessor.pilot\",\n" +
    "          \"match\": \"^\\\\s*(#(?:define|undef|if|elif|else|endif|region|endregion|error|warning|pragma|line))\\\\b(.*)$\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.directive.pilot\" },\n" +
    "            \"2\": { \"name\": \"string.unquoted.preprocessor.pilot\" }\n" +
    "          }\n" +
    "        }\n" +
    "      ]\n" +
    "    }";

pure fn tm_polyglot_section() -> str => "    \"polyglot-blocks\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(python|py)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.python\" }, { \"include\": \"$self\" } ]\n" +
    "        },\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(js|javascript)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.js\" }, { \"include\": \"$self\" } ]\n" +
    "        },\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(sql|postgres|postgresql)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.sql\" }, { \"include\": \"$self\" } ]\n" +
    "        },\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(c)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.c\" }, { \"include\": \"$self\" } ]\n" +
    "        },\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(cpp)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.cpp\" }, { \"include\": \"$self\" } ]\n" +
    "        },\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(rust)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.rust\" }, { \"include\": \"$self\" } ]\n" +
    "        },\n" +
    "        {\n" +
    "          \"begin\": \"\\\\b(lua)\\\\s*(\\\\{)\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"keyword.control.foreign.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.section.block.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\\}\",\n" +
    "          \"endCaptures\": {\n" +
    "            \"0\": { \"name\": \"punctuation.section.block.end.pilot\" }\n" +
    "          },\n" +
    "          \"patterns\": [ { \"include\": \"source.lua\" }, { \"include\": \"$self\" } ]\n" +
    "        }\n" +
    "      ]\n" +
    "    }";

pure fn tm_raw_dsl_section() -> str => "    \"raw-dsl\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"string.unquoted.raw.dsl.pilot\", \"begin\": \"```[a-zA-Z0-9_]*\", \"end\": \"```\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_strings_section() -> str => "    \"strings\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"string.quoted.triple.interpolated.pilot\",\n" +
    "          \"begin\": \"(f)(\\\"\\\"\\\")\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.definition.string.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\"\\\"\\\"\",\n" +
    "          \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.string.end.pilot\" } },\n" +
    "          \"patterns\": [\n" +
    "            { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" },\n" +
    "            {\n" +
    "              \"name\": \"meta.interpolation.pilot\",\n" +
    "              \"begin\": \"\\\\{\",\n" +
    "              \"beginCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.begin.pilot\" } },\n" +
    "              \"end\": \"\\\\}\",\n" +
    "              \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.end.pilot\" } },\n" +
    "              \"patterns\": [ { \"include\": \"$self\" } ]\n" +
    "            }\n" +
    "          ]\n" +
    "        },\n" +
    "        { \"name\": \"string.quoted.triple.pilot\", \"begin\": \"\\\"\\\"\\\"\", \"end\": \"\\\"\\\"\\\"\", \"patterns\": [ { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" } ] },\n" +
    "        {\n" +
    "          \"name\": \"string.quoted.double.interpolated.pilot\",\n" +
    "          \"begin\": \"(f)(\\\")\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.definition.string.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\"\",\n" +
    "          \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.string.end.pilot\" } },\n" +
    "          \"patterns\": [\n" +
    "            { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" },\n" +
    "            {\n" +
    "              \"name\": \"meta.interpolation.pilot\",\n" +
    "              \"begin\": \"\\\\{\",\n" +
    "              \"beginCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.begin.pilot\" } },\n" +
    "              \"end\": \"\\\\}\",\n" +
    "              \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.end.pilot\" } },\n" +
    "              \"patterns\": [ { \"include\": \"$self\" } ]\n" +
    "            }\n" +
    "          ]\n" +
    "        },\n" +
    "        { \"name\": \"string.quoted.double.pilot\", \"begin\": \"\\\"\", \"end\": \"\\\"\", \"patterns\": [ { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" } ] },\n" +
    "        { \"name\": \"string.quoted.single.pilot\", \"match\": \"'(?:[^'\\\\\\\\\\n\\r]|\\\\\\\\.)*'\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_raw_idents_section() -> str => "    \"raw-idents\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"variable.other.escaped.pilot\", \"match\": \"`[^`\\\\r\\\\n]+`\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_attributes_section() -> str => "    \"attributes\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"meta.attribute.pilot\",\n" +
    "          \"begin\": \"\\\\[(?=\\\\s*(?:(?:var|let)\\\\s+[a-z_][A-Za-z0-9_]*\\\\s*=\\\\s*)?[A-Z][A-Za-z0-9_]*(?:\\\\(|$|\\\\s*[\\\\]\\\\,]))\",\n" +
    "          \"beginCaptures\": { \"0\": { \"name\": \"punctuation.brackets.square.pilot\" } },\n" +
    "          \"end\": \"\\\\]\",\n" +
    "          \"endCaptures\": { \"0\": { \"name\": \"punctuation.brackets.square.pilot\" } },\n" +
    "          \"patterns\": [\n" +
    "            { \"match\": \"\\\\b(let|var)\\\\b\", \"name\": \"keyword.declaration.variable.pilot keyword.other.pilot\" },\n" +
    "            { \"match\": \"\\\\b([A-Z][A-Za-z0-9_]*)\\\\b\", \"name\": \"entity.name.function.decorator.pilot support.type.decorator.pilot\" },\n" +
    "            { \"include\": \"#comments\" },\n" +
    "            { \"include\": \"#strings\" },\n" +
    "            { \"include\": \"#constants\" },\n" +
    "            { \"include\": \"#numbers\" },\n" +
    "            { \"include\": \"#primitives\" },\n" +
    "            { \"include\": \"#call-targets\" },\n" +
    "            { \"include\": \"#punctuation\" },\n" +
    "            { \"include\": \"#variables\" }\n" +
    "          ]\n" +
    "        }\n" +
    "      ]\n" +
    "    }";

pure fn tm_quote_splices_section() -> str => "    \"quote-splices\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"variable.other.metavariable.splice.pilot\", \"match\": \"\\\\$[A-Za-z_][A-Za-z0-9_]*\" },\n" +
    "        { \"name\": \"punctuation.operator.unquote.pilot\", \"match\": \"~(?=[A-Za-z_(])\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_symbols_section() -> str => "    \"symbols\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"constant.other.symbol.pilot\", \"match\": \"(?<![:a-zA-Z0-9_]):[a-zA-Z_][a-zA-Z0-9_]*(?:/[a-zA-Z_][a-zA-Z0-9_]*)?\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_declarations_section() -> str => "    \"declarations\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"meta.function.declaration.pilot\",\n" +
    "          \"match\": \"\\\\b(fn)\\\\s+([a-zA-Z_][a-zA-Z0-9_]*)\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"keyword.declaration.function.pilot keyword.control.pilot\" },\n" +
    "            \"2\": { \"name\": \"entity.name.function.pilot\" }\n" +
    "          }\n" +
    "        },\n" +
    "        {\n" +
    "          \"name\": \"meta.operator.declaration.pilot\",\n" +
    "          \"match\": \"\\\\b(op)\\\\s+([^\\\\s\\\\(\\\\);\\\\{]+)\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"keyword.declaration.operator.pilot keyword.control.pilot\" },\n" +
    "            \"2\": { \"name\": \"entity.name.function.operator.pilot\" }\n" +
    "          }\n" +
    "        },\n" +
    "        {\n" +
    "          \"name\": \"meta.type.declaration.pilot\",\n" +
    "          \"match\": \"\\\\b(struct|interface|enum|actor|state|type)\\\\s+([A-Za-z_][A-Za-z0-9_]*)\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"keyword.declaration.type.pilot keyword.control.pilot\" },\n" +
    "            \"2\": { \"name\": \"entity.name.type.pilot\" }\n" +
    "          }\n" +
    "        },\n" +
    "        {\n" +
    "          \"name\": \"meta.distributive.binding.pilot\",\n" +
    "          \"match\": \"\\\\b(let|var)\\\\s+([A-Z][A-Za-z0-9_]*)\\\\s*(?=<|\\\\{)\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"keyword.declaration.variable.pilot keyword.other.pilot\" },\n" +
    "            \"2\": { \"name\": \"entity.name.type.struct.pilot\" }\n" +
    "          }\n" +
    "        }\n" +
    "      ]\n" +
    "    }";

fn tm_keywords_section(seed_pat: str, syn_pat: str) -> str {
    var s = "    \"keywords\": {\n      \"patterns\": [\n" +
        "        {\n" +
        "          \"name\": \"meta.syntax.declaration.type-construct.pilot\",\n" +
        "          \"match\": \"\\\\b(syntax)\\\\s+(type_construct)\\\\b\",\n" +
        "          \"captures\": {\n" +
        "            \"1\": { \"name\": \"keyword.control.syntax.pilot\" },\n" +
        "            \"2\": { \"name\": \"keyword.control.type-construct.pilot\" }\n" +
        "          }\n" +
        "        },\n" +
        "        { \"name\": \"keyword.control.syntax.pilot\", \"match\": \"\\\\b(" + syn_pat + ")\\\\b\" },\n" +
        "        { \"name\": \"keyword.control.seed.pilot\", \"match\": \"\\\\b(" + seed_pat + ")\\\\b\" }";

    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 4 {
                let cid = __engine("ast_attr_arg", i, 0);
                if cid != 0 && cid != 3 && cid != 4 {
                    let scope = __engine(Cfg.ast.sym_str, __engine("ast_attr_arg", i, 1));
                    let pat = reflect_category_keywords(cid);
                    if pat != "" {
                        s = s + ',\n        { "name": "' + scope + '", "match": "\\\\b(' + pat + ')\\\\b" }';
                    }
                }
            }
        }
        i = i + 1;
    }
    s = s + "\n      ]\n    }";
    return s;
}

fn tm_modifiers_section(mod_pat: str) -> str {
    let vis_pat = reflect_category_keywords(3);
    var s = "    \"modifiers\": {\n      \"patterns\": [\n";
    if vis_pat != "" {
        s = s + "        { \"name\": \"storage.modifier.visibility.pilot\", \"match\": \"\\\\b(" + vis_pat + ")\\\\b\" },\n";
    }
    s = s + "        { \"name\": \"storage.modifier.pilot\", \"match\": \"\\\\b(" + mod_pat + ")\\\\b\" }\n      ]\n    }";
    return s;
}

pure fn tm_primitives_section(prim_pat: str) -> str => "    \"primitives\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"support.type.primitive.pilot entity.name.type.primitive.pilot\", \"match\": \"\\\\b(" + prim_pat + ")\\\\b\" },\n" +
    "        { \"name\": \"support.type.system.pilot entity.name.type.pilot\", \"match\": \"\\\\b(ArenaScope|AstContext|CallExpr|ClampAttr|Dual|EffectPlan|FormulaAttr|HardRealtimeAttr|IdeContextPolicy|IdePresentationPolicy|IdeTokenAttr|InheritPolicy|KernelAttr|LspKind|LspMod|OnChangeAttr|PatchAttr|PatchPart|PatchReplaceAttr|Quantity|RangeEnumerator|RangeWindow|RuleAttr|Signal|SliceBuffer|SliceEnumerator|SpanEnumerator|StrideEnumerator|TraceSpanAttr|WcetAttr|ZeroRuntimeAttr)\\\\b\" },\n" +
    "        { \"name\": \"entity.name.type.interface.pilot\", \"match\": \"\\\\bI[A-Z][A-Za-z0-9_]*\\\\b\" },\n" +
    "        { \"name\": \"entity.name.type.pilot\", \"match\": \"\\\\b[A-Z][A-Za-z0-9_]*\\\\b\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_call_targets_section() -> str => "    \"call-targets\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"meta.function.call.quoted.pilot\",\n" +
    "          \"match\": \"\\\\b([a-zA-Z_][a-zA-Z0-9_]*)(!!|!&|!\\\\^|!@|!\\\\?|!)(?=\\\\s*\\\\()\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"entity.name.function.call.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.operator.call-quote.pilot\" }\n" +
    "          }\n" +
    "        },\n" +
    "        {\n" +
    "          \"name\": \"meta.method.call.pilot\",\n" +
    "          \"match\": \"(?<=\\\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\\\s*(?=\\\\()\",\n" +
    "          \"captures\": { \"1\": { \"name\": \"entity.name.function.member.pilot\" } }\n" +
    "        },\n" +
    "        {\n" +
    "          \"name\": \"meta.property.access.pilot\",\n" +
    "          \"match\": \"(?<=\\\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\\\b\",\n" +
    "          \"captures\": { \"1\": { \"name\": \"variable.other.property.pilot\" } }\n" +
    "        },\n" +
    "        { \"name\": \"entity.name.type.struct.constructor.pilot\", \"match\": \"\\\\b([A-Z][A-Za-z0-9_]*)\\\\s*(?=\\\\(|\\\\{|<)\" },\n" +
    "        { \"name\": \"entity.name.function.call.pilot\", \"match\": \"\\\\b([a-zA-Z_][a-zA-Z0-9_]*)\\\\s*(?=\\\\()\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_constants_section() -> str => "    \"constants\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"match\": \"(::)([A-Za-z_][A-Za-z0-9_]*)\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"punctuation.separator.enum.pilot\" },\n" +
    "            \"2\": { \"name\": \"variable.other.enummember.pilot constant.other.enum.pilot\" }\n" +
    "          }\n" +
    "        },\n" +
    "        { \"name\": \"constant.language.boolean.pilot\", \"match\": \"\\\\b(true|false)\\\\b\" },\n" +
    "        { \"name\": \"constant.language.null.pilot\", \"match\": \"\\\\b(none|null)\\\\b\" },\n" +
    "        { \"name\": \"variable.language.self.pilot\", \"match\": \"\\\\bself\\\\b\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_object_keys_section() -> str => "    \"object-keys\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"match\": \"(?<![a-zA-Z0-9_])([a-zA-Z_][a-zA-Z0-9_]*)\\\\s*(:)(?!:)\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"meta.object-literal.key.pilot meta.property-name.pilot variable.other.property.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.separator.key-value.pilot\" }\n" +
    "          }\n" +
    "        }\n" +
    "      ]\n" +
    "    }";

pure fn tm_numbers_section() -> str => "    \"numbers\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"constant.numeric.hex.pilot\", \"match\": \"\\\\b0[xX][0-9a-fA-F_]+(?:[a-zA-Z]+)?\\\\b\" },\n" +
    "        { \"name\": \"constant.numeric.binary.pilot\", \"match\": \"\\\\b0[bB][01_]+(?:[a-zA-Z]+)?\\\\b\" },\n" +
    "        { \"name\": \"constant.numeric.octal.pilot\", \"match\": \"\\\\b0[oO][0-7_]+(?:[a-zA-Z]+)?\\\\b\" },\n" +
    "        {\n" +
    "          \"match\": \"\\\\b([0-9][0-9_]*(?:\\\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(ns|us|ms|s|Hz|kHz|MHz|GHz|B|KB|MB|GB|TB)?\\\\b\",\n" +
    "          \"captures\": {\n" +
    "            \"1\": { \"name\": \"constant.numeric.pilot\" },\n" +
    "            \"2\": { \"name\": \"keyword.other.unit.pilot\" }\n" +
    "          }\n" +
    "        }\n" +
    "      ]\n" +
    "    }";

pure fn tm_operators_section(op_pat: str) -> str => "    \"operators\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"punctuation.operator.call-quote.pilot\", \"match\": \"!!|!&|!\\\\^|!@|!\\\\?\" },\n" +
    "        { \"name\": \"punctuation.operator.cascade.pilot\", \"match\": \"\\\\?\\\\.\\\\.|\\\\.\\\\.\" },\n" +
    "        { \"name\": \"punctuation.operator.pipeline.pilot\", \"match\": \"\\\\|>|<\\\\||=>|->|<-\" },\n" +
    "        { \"name\": \"punctuation.operator.range.pilot\", \"match\": \">\\\\.\\\\.<|\\\\*\\\\.\\\\.|\\\\.\\\\.<|\\\\.\\\\.=|>=|<=|>\\\\.\\\\.\" },\n" +
    "        { \"name\": \"punctuation.operator.null-safe.pilot\", \"match\": \"\\\\?\\\\?|\\\\?\" },\n" +
    "        { \"name\": \"punctuation.operator.comparison.pilot\", \"match\": \"==|!=|<=|>=|<=>|<|>\" },\n" +
    "        { \"name\": \"punctuation.operator.assignment.pilot\", \"match\": \":=:|:=|\\\\+=|-=|\\\\*=|/=|%=|&=|\\\\|=|\\\\^=|<<=|>>=|=\" },\n" +
    "        { \"name\": \"punctuation.operator.logical.pilot\", \"match\": \"&&|\\\\|\\\\||!\" },\n" +
    "        { \"name\": \"punctuation.operator.spread.pilot\", \"match\": \"\\\\*\\\\.\\\\.|\\\\*\\\\*|\\\\*\" },\n" +
    '        { "name": "punctuation.operator.arithmetic.pilot", "match": "' + op_pat + '" }\n' +
    "      ]\n" +
    "    }";

pure fn tm_variables_section() -> str => "    \"variables\": {\n" +
    "      \"patterns\": [\n" +
    "        { \"name\": \"variable.other.readwrite.pilot\", \"match\": \"\\\\b[a-zA-Z_][a-zA-Z0-9_]*\\\\b\" }\n" +
    "      ]\n" +
    "    }";

pub fn dumps_tm_language(
    seed_keywords_regex:   str,
    syntax_macros_regex:   str,
    modifiers_regex:       str,
    lang_primitives_regex: str,
    operators_regex:       str,
    indent:                i64 = 2
) -> str {
    let seed_pat = if seed_keywords_regex != "" { seed_keywords_regex } else { reflect_category_keywords(0) };
    let mod_pat  = if modifiers_regex != "" { modifiers_regex } else { reflect_category_keywords(4) };
    let prim_pat = if lang_primitives_regex != "" { lang_primitives_regex } else { reflect_primitives_pattern() };
    let op_pat   = if operators_regex != "" { operators_regex } else { reflect_operators_pattern() };
    let syn_pat  = if syntax_macros_regex != "" { syntax_macros_regex } else { reflect_syntax_pattern() };

    var s = "{\n  \"$schema\": \"https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json\",\n  \"name\": \"Pilot\",\n  \"scopeName\": \"source.pilot\",\n  \"patterns\": " + tm_patterns_list() + ",\n  \"repository\": {\n";
    s = s + tm_comments_section() + ",\n";
    s = s + tm_preprocessor_section() + ",\n";
    s = s + tm_polyglot_section() + ",\n";
    s = s + tm_raw_dsl_section() + ",\n";
    s = s + tm_strings_section() + ",\n";
    s = s + tm_raw_idents_section() + ",\n";
    s = s + tm_attributes_section() + ",\n";
    s = s + tm_quote_splices_section() + ",\n";
    s = s + tm_symbols_section() + ",\n";
    s = s + tm_declarations_section() + ",\n";
    s = s + tm_keywords_section(seed_pat, syn_pat) + ",\n";
    s = s + tm_modifiers_section(mod_pat) + ",\n";
    s = s + tm_primitives_section(prim_pat) + ",\n";
    s = s + tm_call_targets_section() + ",\n";
    s = s + tm_constants_section() + ",\n";
    s = s + tm_object_keys_section() + ",\n";
    s = s + tm_numbers_section() + ",\n";
    s = s + tm_operators_section(op_pat) + ",\n";
    s = s + "    \"punctuation\": {\n      \"patterns\": [\n        { \"name\": \"punctuation.terminator.statement.pilot\", \"match\": \";\" },\n        { \"name\": \"punctuation.separator.comma.pilot\", \"match\": \",\" },\n        { \"name\": \"punctuation.separator.colon.pilot\", \"match\": \":\" },\n        { \"name\": \"punctuation.accessor.dot.pilot\", \"match\": \"\\\\.\" },\n        { \"name\": \"punctuation.brackets.curly.pilot\", \"match\": \"[{}]\" },\n        { \"name\": \"punctuation.brackets.round.pilot\", \"match\": \"[()]\" },\n        { \"name\": \"punctuation.brackets.square.pilot\", \"match\": \"[\\\\[\\\\]]\" }\n      ]\n    }" + ",\n";
    s = s + tm_variables_section() + "\n  }\n}";
    return s;
}


// =========================================================================
// 5B. VS CODE PACKAGE.JSON MANIFEST MODEL & GENERATOR
// =========================================================================

[JsonObject]
pub struct PkgRepository : IValue {
    [JsonProperty("type")]
    pub repo_type: str;

    [JsonProperty("url")]
    pub url: str;

    [JsonProperty("directory")]
    pub directory: str;
}

[JsonObject]
pub struct PkgEngines : IValue {
    [JsonProperty("vscode")]
    pub vscode: str;
}

[JsonObject]
pub struct PkgSemanticToken : IValue {
    [JsonProperty("id")]
    pub id: str;

    [JsonProperty("description")]
    pub description: str;
}

[JsonObject]
pub struct PkgLanguage : IValue {
    [JsonProperty("id")]
    pub id: str;

    [JsonProperty("aliases")]
    pub aliases: str[];

    [JsonProperty("extensions")]
    pub extensions: str[];

    [JsonProperty("configuration")]
    pub configuration: str;
}

[JsonObject]
pub struct PkgGrammar : IValue {
    [JsonProperty("language")]
    pub language: str;

    [JsonProperty("scopeName")]
    pub scope_name: str;

    [JsonProperty("path")]
    pub path: str;
}

[JsonObject]
pub struct PkgSnippet : IValue {
    [JsonProperty("language")]
    pub language: str;

    [JsonProperty("path")]
    pub path: str;
}

[JsonObject]
pub struct PkgBreakpoint : IValue {
    [JsonProperty("language")]
    pub language: str;
}

[JsonObject]
pub struct PkgCommand : IValue {
    [JsonProperty("command")]
    pub command: str;

    [JsonProperty("title")]
    pub title: str;

    [JsonProperty("icon")]
    pub icon: str;
}

[JsonObject]
pub struct PkgMenuItem : IValue {
    [JsonProperty("command")]
    pub command: str;

    [JsonProperty("when")]
    pub when_clause: str;

    [JsonProperty("group")]
    pub group: str;
}

[JsonObject]
pub struct PkgMenus : IValue {
    [JsonProperty("editor/title/run")]
    pub editor_title_run: PkgMenuItem[];

    [JsonProperty("editor/context")]
    pub editor_context: PkgMenuItem[];
}

[JsonObject]
pub struct PkgDebugger : IValue {
    [JsonProperty("type")]
    pub dbg_type: str;

    [JsonProperty("label")]
    pub label: str;

    [JsonProperty("languages")]
    pub languages: str[];
}

[JsonObject]
pub struct PkgConfigProp : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("type")]
    pub prop_type: str;

    [JsonProperty("default")]
    pub default_val: str;

    [JsonProperty("description")]
    pub description: str;
}

[JsonObject]
pub struct PkgConfiguration : IValue {
    [JsonProperty("title")]
    pub title: str;

    [JsonProperty("properties")]
    pub properties: PkgConfigProp[];
}

[JsonObject]
pub struct PkgContributes : IValue {
    [JsonProperty("semanticTokenTypes")]
    pub semantic_token_types: PkgSemanticToken[];

    [JsonProperty("semanticTokenModifiers")]
    pub semantic_token_modifiers: PkgSemanticToken[];

    [JsonProperty("languages")]
    pub languages: PkgLanguage[];

    [JsonProperty("grammars")]
    pub grammars: PkgGrammar[];

    [JsonProperty("snippets")]
    pub snippets: PkgSnippet[];

    [JsonProperty("breakpoints")]
    pub breakpoints: PkgBreakpoint[];

    [JsonProperty("commands")]
    pub commands: PkgCommand[];

    [JsonProperty("menus")]
    pub menus: PkgMenus;

    [JsonProperty("debuggers")]
    pub debuggers: PkgDebugger[];

    [JsonProperty("configuration")]
    pub configuration: PkgConfiguration;
}

[JsonObject]
pub struct PkgDevDependencies : IValue {
    [JsonProperty("@types/node")]
    pub types_node: str;

    [JsonProperty("@types/vscode")]
    pub types_vscode: str;

    [JsonProperty("typescript")]
    pub typescript: str;
}

[JsonObject]
pub struct PkgScripts : IValue {
    [JsonProperty("vscode:prepublish")]
    pub prepublish: str;

    [JsonProperty("compile")]
    pub compile: str;

    [JsonProperty("watch")]
    pub watch: str;

    [JsonProperty("package")]
    pub package_cmd: str;
}

[JsonObject]
pub struct PackageJsonModel : IValue {
    [JsonProperty("name")]
    pub name: str;

    [JsonProperty("displayName")]
    pub display_name: str;

    [JsonProperty("description")]
    pub description: str;

    [JsonProperty("version")]
    pub version: str;

    [JsonProperty("publisher")]
    pub publisher: str;

    [JsonProperty("license")]
    pub license: str;

    [JsonProperty("repository")]
    pub repository: PkgRepository;

    [JsonProperty("engines")]
    pub engines: PkgEngines;

    [JsonProperty("categories")]
    pub categories: str[];

    [JsonProperty("activationEvents")]
    pub activation_events: str[];

    [JsonProperty("main")]
    pub main_path: str;

    [JsonProperty("contributes")]
    pub contributes: PkgContributes;

    [JsonProperty("devDependencies")]
    pub dev_dependencies: PkgDevDependencies;

    [JsonProperty("scripts")]
    pub scripts: PkgScripts;
}

pub pure fn build_package_json_model(version: str = "1.1.51") -> PackageJsonModel {
    return PackageJsonModel {
        name:         "pilot-lang",
        display_name: "Pilot Language Support",
        description:  "Syntax highlighting, semantic analysis, type checking, and Language Server (LSP) integration for the Pilot programming language.",
        version:      if version != "" { version } else { "1.1.51" },
        publisher:    "pilot-lang",
        license:      "MIT",
        repository:   PkgRepository {
            repo_type: "git",
            url:       "https://github.com/moonxbears/Pilot.git",
            directory: "vscode-pilot",
        },
        engines: PkgEngines {
            vscode: "^1.85.0",
        },
        categories: [
            "Programming Languages",
            "Linters",
        ],
        activation_events: [
            "onLanguage:pilot",
            "onDebug",
            "onCommand:pilot.runCurrentFile",
            "onCommand:pilot.debugCurrentFile",
            "onCommand:pilot.createLaunchConfig",
            "onCommand:pilot.runAllTests",
            "onCommand:pilot.runCurrentTest",
            "onCommand:pilot.refreshTests",
        ],
        main_path: "./out/extension.js",
        contributes: PkgContributes {
            semantic_token_types: [
                PkgSemanticToken { id: "namespace", description: "Style for namespaces" },
                PkgSemanticToken { id: "type", description: "Style for types" },
                PkgSemanticToken { id: "class", description: "Style for classes" },
                PkgSemanticToken { id: "enum", description: "Style for enums" },
                PkgSemanticToken { id: "interface", description: "Style for interfaces" },
                PkgSemanticToken { id: "struct", description: "Style for structs" },
                PkgSemanticToken { id: "typeParameter", description: "Style for generic type parameters" },
                PkgSemanticToken { id: "parameter", description: "Style for function parameters" },
                PkgSemanticToken { id: "variable", description: "Style for variables" },
                PkgSemanticToken { id: "property", description: "Style for properties and fields" },
                PkgSemanticToken { id: "enumMember", description: "Style for enum variants" },
                PkgSemanticToken { id: "event", description: "Style for events" },
                PkgSemanticToken { id: "function", description: "Style for functions" },
                PkgSemanticToken { id: "method", description: "Style for methods" },
                PkgSemanticToken { id: "macro", description: "Style for macros" },
                PkgSemanticToken { id: "keyword", description: "Style for keywords" },
                PkgSemanticToken { id: "modifier", description: "Style for modifiers" },
                PkgSemanticToken { id: "comment", description: "Style for comments" },
                PkgSemanticToken { id: "string", description: "Style for strings" },
                PkgSemanticToken { id: "number", description: "Style for numbers" },
                PkgSemanticToken { id: "regexp", description: "Style for regexes" },
                PkgSemanticToken { id: "operator", description: "Style for operators" },
                PkgSemanticToken { id: "decorator", description: "Style for attributes and decorators" },
            ],
            semantic_token_modifiers: [
                PkgSemanticToken { id: "declaration", description: "Annotates symbol declarations" },
                PkgSemanticToken { id: "definition", description: "Annotates symbol definitions" },
                PkgSemanticToken { id: "readonly", description: "Annotates readonly or immutable symbols" },
                PkgSemanticToken { id: "static", description: "Annotates static members" },
                PkgSemanticToken { id: "deprecated", description: "Annotates deprecated members" },
                PkgSemanticToken { id: "abstract", description: "Annotates abstract members" },
                PkgSemanticToken { id: "async", description: "Annotates async members" },
                PkgSemanticToken { id: "modification", description: "Annotates mutating targets" },
                PkgSemanticToken { id: "documentation", description: "Annotates doc comments" },
                PkgSemanticToken { id: "defaultLibrary", description: "Annotates stdlib / built-in members" },
                PkgSemanticToken { id: "constructor", description: "Annotates constructors" },
                PkgSemanticToken { id: "callable", description: "Annotates callable variables" },
            ],
            languages: [
                PkgLanguage {
                    id:            "pilot",
                    aliases:       ["Pilot", "pilot"],
                    extensions:    [".pilot", ".pchor"],
                    configuration: "./language-configuration.json",
                },
            ],
            grammars: [
                PkgGrammar {
                    language:   "pilot",
                    scope_name: "source.pilot",
                    path:       "./syntaxes/pilot.tmLanguage.json",
                },
            ],
            snippets: [
                PkgSnippet {
                    language: "pilot",
                    path:     "./snippets/pilot.json",
                },
            ],
            breakpoints: [
                PkgBreakpoint { language: "pilot" },
            ],
            commands: [
                PkgCommand { command: "pilot.restartLanguageServer", title: "Pilot: Restart Language Server", icon: "" },
                PkgCommand { command: "pilot.runCurrentFile", title: "Pilot: Run Current File", icon: "$(play)" },
                PkgCommand { command: "pilot.debugCurrentFile", title: "Pilot: Debug Current File", icon: "$(debug-alt)" },
                PkgCommand { command: "pilot.debugCurrentFileDap", title: "Pilot: Debug with GUI (DAP)", icon: "$(debug)" },
                PkgCommand { command: "pilot.createLaunchConfig", title: "Pilot: Add Run & Debug Configurations to launch.json", icon: "" },
                PkgCommand { command: "pilot.runAllTests", title: "Pilot: Run All Tests", icon: "$(run-all)" },
                PkgCommand { command: "pilot.runCurrentTest", title: "Pilot: Run Current Test File", icon: "$(play)" },
                PkgCommand { command: "pilot.refreshTests", title: "Pilot: Refresh Tests", icon: "$(refresh)" },
            ],
            menus: PkgMenus {
                editor_title_run: [
                    PkgMenuItem { command: "pilot.runCurrentFile", when_clause: "resourceExtname == .pilot", group: "navigation@1" },
                    PkgMenuItem { command: "pilot.debugCurrentFile", when_clause: "resourceExtname == .pilot", group: "navigation@2" },
                    PkgMenuItem { command: "pilot.runCurrentTest", when_clause: "resourceExtname == .pilot", group: "navigation@3" },
                ],
                editor_context: [
                    PkgMenuItem { command: "pilot.runCurrentTest", when_clause: "resourceExtname == .pilot", group: "navigation@3" },
                ],
            },
            debuggers: [
                PkgDebugger { dbg_type: "pilot", label: "Pilot", languages: ["pilot"] },
            ],
            configuration: PkgConfiguration {
                title: "Pilot Language",
                properties: [
                    PkgConfigProp { name: "pilot.languageServer.serverPath", prop_type: "string", default_val: "pilot-lsp", description: "Optional explicit path to pilot-lsp or pilot executable." },
                    PkgConfigProp { name: "pilot.compiler.executablePath", prop_type: "string", default_val: "pilot", description: "Optional explicit path to the pilot compiler executable." },
                    PkgConfigProp { name: "pilot.dap.serverPath", prop_type: "string", default_val: "pilot-dap", description: "Optional explicit path to pilot-dap or pilot executable." },
                ],
            },
        },
        dev_dependencies: PkgDevDependencies {
            types_node:    "^26.6.5",
            types_vscode:  "^1.85.0",
            typescript:    "^7.0.2",
        },
        scripts: PkgScripts {
            prepublish:  "npm run compile",
            compile:     "tsc -p .",
            watch:       "tsc -watch -p .",
            package_cmd: "vsce package",
        },
    };
}

pub fn dumps_package_json(version: str = "1.1.51", indent: i64 = 2) -> str {
    let content = load("vscode-pilot/package.json");
    if len(content) > 0 {
        return content;
    }
    return "{}";
}

pub pure fn nameof(sym: str) -> str => sym;

pub fn get_related_keywords(kw: str) -> str[] {
    return reflect_related_keywords(kw);
}

pub pure fn format_keyword_hover_markdown(ident: str, domain: str, summary: str) -> str {
    var md = "**Pilot Keyword**: `" + ident + "` (" + domain + ")\n\n" + summary;
    let related = get_related_keywords(ident);
    var rel_str = "";
    var idx = 0;
    for r in related {
        if idx > 0 {
            rel_str = rel_str + " • ";
        }
        rel_str = rel_str + "[`" + r + "`](#)";
        idx = idx + 1;
    }
    if rel_str != "" {
        md = md + "\n\n---\n**Related Keywords**: " + rel_str;
    }
    return md;
}

// =========================================================================
// 8. PILOT-NATIVE LSP REFLECTION, HOVER, COMPLETION & DEFINITION HANDLERS
// =========================================================================

pub fn reflect_node_doc(node_id: i64) -> str {
    let span_start = __engine(Cfg.ast.ast_span_start, node_id);
    let win_start = if span_start > 400 { span_start - 400 } else { 0 };
    if span_start <= win_start {
        return "";
    }

    var lead = span_start;
    var scan_lead = true;
    while scan_lead && lead > win_start {
        let ch = __engine(Cfg.ast.source_slice, lead - 1, lead);
        if ch == "\n" {
            scan_lead = false;
        } else if ch == ";" || ch == "}" || ch == "{" {
            return "";
        } else {
            lead = lead - 1;
        }
    }

    var p = lead - 1;
    var scan_doc = true;
    while scan_doc && p > win_start {
        let ch = __engine(Cfg.ast.source_slice, p - 1, p);
        if ch == "\n" || ch == " " || ch == "\t" || ch == "\r" {
            p = p - 1;
        } else {
            scan_doc = false;
        }
    }

    if p > win_start + 3 {
        var line_start = p;
        while line_start > win_start && __engine(Cfg.ast.source_slice, line_start - 1, line_start) != "\n" {
            line_start = line_start - 1;
        }
        var ls = line_start;
        var scan_ws = true;
        while scan_ws && ls < p {
            let ch = __engine(Cfg.ast.source_slice, ls, ls + 1);
            if ch == " " || ch == "\t" {
                ls = ls + 1;
            } else {
                scan_ws = false;
            }
        }
        if __engine(Cfg.ast.source_slice, ls, ls + 3) == "///" {
            var ds = ls + 3;
            if __engine(Cfg.ast.source_slice, ds, ds + 1) == " " {
                ds = ds + 1;
            }
            return __engine(Cfg.ast.source_slice, ds, p);
        }
    }
    return "";
}

pub fn handle_lsp_hover(offset: i64) {
    let cur_ch = __engine(Cfg.ast.source_slice, offset, offset + 1);
    let is_ident = (cur_ch >= "a" && cur_ch <= "z") || (cur_ch >= "A" && cur_ch <= "Z") || (cur_ch >= "0" && cur_ch <= "9") || cur_ch == "_";
    if !is_ident {
        __engine(Cfg.ast.lsp_set_result, "");
        return;
    }

    var w_start = offset;
    var scan_wstart = true;
    while scan_wstart && w_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, w_start - 1, w_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_start = w_start - 1;
        } else {
            scan_wstart = false;
        }
    }
    var w_end = offset;
    var scan_wend = true;
    while scan_wend && w_end < offset + 40 {
        let ch = __engine(Cfg.ast.source_slice, w_end, w_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_end = w_end + 1;
        } else {
            scan_wend = false;
        }
    }
    let word = __engine(Cfg.ast.source_slice, w_start, w_end);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "");
        return;
    }

    let node_count = __engine(Cfg.ast.ast_node_count);
    var best_nid = -1;
    var best_len = 999999999;
    var i = 0;
    while i < node_count {
        let s = __engine(Cfg.ast.ast_span_start, i);
        let e = __engine(Cfg.ast.ast_span_end, i);
        let k = __engine(Cfg.ast.ast_node_kind, i);
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        let sname = __engine(Cfg.ast.sym_str, sym);
        var eff_s = s;
        var eff_e = e;
        if k == 17 {
            var p = e;
            while p < e + 60 && __engine(Cfg.ast.source_slice, p, p + 1) != "." {
                p = p + 1;
            }
            if __engine(Cfg.ast.source_slice, p, p + 1) == "." {
                p = p + 1;
                while p < e + 60 && (__engine(Cfg.ast.source_slice, p, p + 1) == " " || __engine(Cfg.ast.source_slice, p, p + 1) == "\t") {
                    p = p + 1;
                }
                eff_s = p;
                var m_end = p;
                var scan_m = true;
                while scan_m && m_end < p + 60 {
                    let ch = __engine(Cfg.ast.source_slice, m_end, m_end + 1);
                    if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
                        m_end = m_end + 1;
                    } else {
                        scan_m = false;
                    }
                }
                eff_e = m_end;
            }
        }
        if eff_s <= offset && offset <= eff_e {
            let l = eff_e - eff_s;
            if sname == word {
                if l < best_len {
                    best_len = l;
                    best_nid = i;
                }
            }
        }
        i = i + 1;
    }

    if best_nid == -1 {
        __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
        __engine(Cfg.ast.mount_unit, "../../stdlib/core/keywords.pilot");
        let doc = reflect_keyword_doc(word);
        if doc != "" {
            let badge = reflect_keyword_badge(word);
            let md = format_keyword_hover_markdown(word, badge, doc);
            __engine(Cfg.ast.lsp_set_result, md);
            return;
        }
        __engine(Cfg.ast.lsp_set_result, "");
        return;
    }

    var target_id = __engine(Cfg.ast.ast_get_bound_target, best_nid);
    if target_id == 4294967295 || target_id < 0 {
        target_id = best_nid;
    }
    let b_kind = __engine(Cfg.ast.ast_node_kind, best_nid);
    var t_kind = __engine(Cfg.ast.ast_node_kind, target_id);

    if b_kind == 17 || (target_id == best_nid && (b_kind == 14 || b_kind == 16)) {
        var found_target = -1;
        var j = 0;
        while j < node_count && found_target == -1 {
            let jk = __engine(Cfg.ast.ast_node_kind, j);
            let js = __engine(Cfg.ast.ast_node_sym, j);
            let jname = __engine(Cfg.ast.sym_str, js);
            if jname == word {
                if b_kind == 17 {
                    if jk == 21 || jk == 3 {
                        found_target = j;
                    }
                } else {
                    if jk == 4 || jk == 21 || jk == 3 || jk == 1 || jk == 2 {
                        found_target = j;
                    }
                }
            }
            j = j + 1;
        }
        if found_target != -1 {
            target_id = found_target;
            t_kind = __engine(Cfg.ast.ast_node_kind, target_id);
        }
    }

    if t_kind == 3 || b_kind == 3 {
        let fn_id = if t_kind == 3 { target_id } else { best_nid };
        let fn_start = __engine(Cfg.ast.ast_span_start, fn_id);
        var sig_start = fn_start;
        var scan_back = true;
        while scan_back && sig_start > 0 {
            let ch = __engine(Cfg.ast.source_slice, sig_start - 1, sig_start);
            if ch == "\n" || ch == ";" || ch == "{" || ch == "}" {
                scan_back = false;
            } else {
                sig_start = sig_start - 1;
            }
        }
        var trim_lead = true;
        while trim_lead && sig_start < fn_start {
            let ch = __engine(Cfg.ast.source_slice, sig_start, sig_start + 1);
            if ch == " " || ch == "\t" || ch == "\r" {
                sig_start = sig_start + 1;
            } else {
                trim_lead = false;
            }
        }
        var sig_end = fn_start;
        var scan_sig = true;
        while scan_sig && sig_end < fn_start + 200 {
            let ch = __engine(Cfg.ast.source_slice, sig_end, sig_end + 1);
            if ch == "{" || ch == "=" || ch == ";" || ch == "\n" {
                scan_sig = false;
            } else {
                sig_end = sig_end + 1;
            }
        }
        var trim_end = true;
        while trim_end && sig_end > fn_start {
            let ch = __engine(Cfg.ast.source_slice, sig_end - 1, sig_end);
            if ch == " " || ch == "\t" || ch == "\r" {
                sig_end = sig_end - 1;
            } else {
                trim_end = false;
            }
        }
        var sig_str = __engine(Cfg.ast.source_slice, sig_start, sig_end);
        var md = "```pilot\n" + sig_str + "\n```";
        let doc = reflect_node_doc(fn_id);
        if doc != "" {
            md = md + "\n\n---\n" + doc;
        }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    if t_kind == 1 || b_kind == 1 {
        let s_id = if t_kind == 1 { target_id } else { best_nid };
        let sym = __engine(Cfg.ast.ast_node_sym, s_id);
        var name = __engine(Cfg.ast.sym_str, sym);
        if name == "" {
            name = word;
        }
        var lid = __engine(Cfg.ast.ast_get_bound_layout, s_id);
        let byte_size = if lid != 4294967295 && lid >= 0 {
            __engine(Cfg.ast.layout_metrics, lid)
        } else {
            0
        };
        let doc = reflect_node_doc(s_id);
        var md = "```pilot\nstruct " + name + "\n```\n*Layout Size*: `" + byte_size + " bytes`";
        let c_count = __engine(Cfg.ast.ast_child_count, s_id);
        if c_count > 0 {
            var ci = 0;
            var has_f = false;
            while ci < c_count {
                let c_nid = __engine(Cfg.ast.ast_child_at, s_id, ci);
                let c_kind = __engine(Cfg.ast.ast_node_kind, c_nid);
                if c_kind == 21 {
                    if !has_f {
                        md = md + "\n\n**Fields:**";
                        has_f = true;
                    }
                    let c_sym = __engine(Cfg.ast.ast_node_sym, c_nid);
                    let c_name = __engine(Cfg.ast.sym_str, c_sym);
                    if c_name != "" {
                        md = md + "\n- `" + c_name + "`";
                    }
                }
                ci = ci + 1;
            }
        }
        if doc != "" {
            md = md + "\n\n---\n" + doc;
        }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    if b_kind == 21 || t_kind == 21 {
        let f_id = if b_kind == 21 { best_nid } else { target_id };
        let f_start = __engine(Cfg.ast.ast_span_start, f_id);
        var f_end = __engine(Cfg.ast.ast_span_end, f_id);
        var trim_f = true;
        while trim_f && f_end > f_start {
            let ch = __engine(Cfg.ast.source_slice, f_end - 1, f_end);
            if ch == ";" || ch == " " || ch == "\t" || ch == "\r" || ch == "\n" {
                f_end = f_end - 1;
            } else {
                trim_f = false;
            }
        }
        var f_slice = __engine(Cfg.ast.source_slice, f_start, f_end);
        var lid = __engine(Cfg.ast.ast_get_bound_layout, f_id);
        let byte_size = if lid != 4294967295 && lid >= 0 {
            __engine(Cfg.ast.layout_metrics, lid)
        } else {
            0
        };
        var md = "```pilot\n" + f_slice + "\n```";
        if byte_size > 0 {
            md = md + "\n*Layout Size*: `" + byte_size + " bytes`";
        }
        let doc = reflect_node_doc(f_id);
        if doc != "" {
            md = md + "\n\n---\n" + doc;
        }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    if b_kind == 4 || t_kind == 4 {
        let v_id = if b_kind == 4 { best_nid } else { target_id };
        let sym = __engine(Cfg.ast.ast_node_sym, v_id);
        var vname = __engine(Cfg.ast.sym_str, sym);
        if vname == "" {
            vname = word;
        }
        var lid = __engine(Cfg.ast.ast_get_bound_layout, v_id);
        let byte_size = if lid != 4294967295 && lid >= 0 {
            __engine(Cfg.ast.layout_metrics, lid)
        } else {
            0
        };
        var md = "```pilot\nlet " + vname;
        if target_id != v_id {
            let tsym = __engine(Cfg.ast.ast_node_sym, target_id);
            let tname = __engine(Cfg.ast.sym_str, tsym);
            if tname != "" {
                md = md + ": " + tname;
            }
        }
        md = md + "\n```";
        if byte_size > 0 {
            md = md + "\n*Layout Size*: `" + byte_size + " bytes`";
        }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    var name = word;
    var lid = __engine(Cfg.ast.ast_get_bound_layout, best_nid);
    if lid == 4294967295 || lid < 0 {
        lid = __engine(Cfg.ast.ast_get_bound_layout, target_id);
    }
    let byte_size = if lid != 4294967295 && lid >= 0 {
        __engine(Cfg.ast.layout_metrics, lid)
    } else {
        0
    };
    var md = "```pilot\n" + name + "\n```";
    if byte_size > 0 {
        md = md + "\n*Layout Size*: `" + byte_size + " bytes`";
    }
    let doc = reflect_node_doc(target_id);
    if doc != "" {
        md = md + "\n\n---\n" + doc;
    }
    __engine(Cfg.ast.lsp_set_result, md);
}

pub fn handle_lsp_completion(offset: i64) {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var p = offset - 1;
    var find_dot = true;
    while find_dot && p >= 0 {
        let ch = __engine(Cfg.ast.source_slice, p, p + 1);
        if ch != " " && ch != "\t" && ch != "\r" && ch != "\n" {
            find_dot = false;
        } else {
            p = p - 1;
        }
    }

    if p >= 0 && __engine(Cfg.ast.source_slice, p, p + 1) == "." {
        var r_end = p;
        var skip_rdot = true;
        while skip_rdot && r_end > 0 {
            let ch = __engine(Cfg.ast.source_slice, r_end - 1, r_end);
            if ch != " " && ch != "\t" {
                skip_rdot = false;
            } else {
                r_end = r_end - 1;
            }
        }
        var r_start = r_end;
        var scan_rstart = true;
        while scan_rstart && r_start > 0 {
            let ch = __engine(Cfg.ast.source_slice, r_start - 1, r_start);
            if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
                r_start = r_start - 1;
            } else {
                scan_rstart = false;
            }
        }
        let recv_name = __engine(Cfg.ast.source_slice, r_start, r_end);
        __engine(Cfg.ast.ast_emit_diag, 0, 1, "recv=" + recv_name);

        var s_id = -1;
        if recv_name == "self" {
            var j = 0;
            while j < node_count {
                let k = __engine(Cfg.ast.ast_node_kind, j);
                if k == 1 {
                    let s = __engine(Cfg.ast.ast_span_start, j);
                    let e = __engine(Cfg.ast.ast_span_end, j);
                    if s <= offset && offset <= e {
                        s_id = j;
                    }
                }
                j = j + 1;
            }
        } else {
            var j = 0;
            while j < node_count {
                let k = __engine(Cfg.ast.ast_node_kind, j);
                if k == 4 || k == 21 {
                    let sym = __engine(Cfg.ast.ast_node_sym, j);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    if nm == recv_name {
                        let tid = __engine(Cfg.ast.ast_get_bound_target, j);
                        if tid != 4294967295 && tid >= 0 {
                            let tk = __engine(Cfg.ast.ast_node_kind, tid);
                            if tk == 1 {
                                s_id = tid;
                            }
                        }
                        if s_id == -1 {
                            let var_lid = __engine(Cfg.ast.ast_get_bound_layout, j);
                            if var_lid != 4294967295 {
                                var sj = 0;
                                while sj < node_count {
                                    if __engine(Cfg.ast.ast_node_kind, sj) == 1 {
                                        let s_lid = __engine(Cfg.ast.ast_get_bound_layout, sj);
                                        if s_lid == var_lid {
                                            s_id = sj;
                                        }
                                    }
                                    sj = sj + 1;
                                }
                            }
                        }
                    }
                }
                j = j + 1;
            }
        }

        if s_id != -1 {
            let is_inside_struct = (recv_name == "self");
            let c_count = __engine(Cfg.ast.ast_child_count, s_id);
            var items_json = "[";
            var added = 0;
            var ci = 0;
            while ci < c_count {
                let c_nid = __engine(Cfg.ast.ast_child_at, s_id, ci);
                let c_kind = __engine(Cfg.ast.ast_node_kind, c_nid);
                let c_sym = __engine(Cfg.ast.ast_node_sym, c_nid);
                let c_name = __engine(Cfg.ast.sym_str, c_sym);
                if c_name != "" {
                    let c_start = __engine(Cfg.ast.ast_span_start, c_nid);
                    let lead_start = if c_start >= 16 { c_start - 16 } else { 0 };
                    var p_scan = lead_start;
                    var is_pub = false;
                    var is_priv = false;
                    while p_scan < c_start {
                        let s4 = __engine(Cfg.ast.source_slice, p_scan, p_scan + 4);
                        if s4 == "pub " || s4 == "open" {
                            is_pub = true;
                        }
                        let s5 = __engine(Cfg.ast.source_slice, p_scan, p_scan + 5);
                        if s5 == "priv " {
                            is_priv = true;
                        }
                        let s7 = __engine(Cfg.ast.source_slice, p_scan, p_scan + 7);
                        if s7 == "export " {
                            is_pub = true;
                        }
                        p_scan = p_scan + 1;
                    }
                    let is_hidden = if c_kind == 3 { !is_pub } else { is_priv };
                    if is_inside_struct || !is_hidden {
                        let lsp_k = if c_kind == 3 { 2 } else { 5 };
                        if added > 0 {
                            items_json = items_json + ", ";
                        }
                        let k_str = if c_kind == 3 { "2" } else { "5" };
                        items_json = items_json + '{"label":"' + c_name + '","kind":' + k_str + '}';
                        added = added + 1;
                    }
                }
                ci = ci + 1;
            }
            items_json = items_json + "]";
            __engine(Cfg.ast.lsp_set_result, items_json);
            return;
        }
    }

    __engine(Cfg.ast.lsp_set_result, "[]");
}

pub fn handle_lsp_definition(offset: i64) {
    let cur_ch = __engine(Cfg.ast.source_slice, offset, offset + 1);
    let is_ident = (cur_ch >= "a" && cur_ch <= "z") || (cur_ch >= "A" && cur_ch <= "Z") || (cur_ch >= "0" && cur_ch <= "9") || cur_ch == "_";
    if !is_ident {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }

    var w_start = offset;
    var scan_wstart = true;
    while scan_wstart && w_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, w_start - 1, w_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_start = w_start - 1;
        } else {
            scan_wstart = false;
        }
    }
    var w_end = offset;
    var scan_wend = true;
    while scan_wend && w_end < offset + 40 {
        let ch = __engine(Cfg.ast.source_slice, w_end, w_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_end = w_end + 1;
        } else {
            scan_wend = false;
        }
    }
    let word = __engine(Cfg.ast.source_slice, w_start, w_end);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }

    let node_count = __engine(Cfg.ast.ast_node_count);
    var best_nid = -1;
    var best_len = 999999999;
    var i = 0;
    while i < node_count {
        let s = __engine(Cfg.ast.ast_span_start, i);
        let e = __engine(Cfg.ast.ast_span_end, i);
        let k = __engine(Cfg.ast.ast_node_kind, i);
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        let sname = __engine(Cfg.ast.sym_str, sym);
        var eff_s = s;
        var eff_e = e;
        if k == 17 {
            var p = e;
            while p < e + 60 && __engine(Cfg.ast.source_slice, p, p + 1) != "." {
                p = p + 1;
            }
            if __engine(Cfg.ast.source_slice, p, p + 1) == "." {
                p = p + 1;
                while p < e + 60 && (__engine(Cfg.ast.source_slice, p, p + 1) == " " || __engine(Cfg.ast.source_slice, p, p + 1) == "\t") {
                    p = p + 1;
                }
                eff_s = p;
                var m_end = p;
                var scan_m = true;
                while scan_m && m_end < p + 60 {
                    let ch = __engine(Cfg.ast.source_slice, m_end, m_end + 1);
                    if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
                        m_end = m_end + 1;
                    } else {
                        scan_m = false;
                    }
                }
                eff_e = m_end;
            }
        }
        if eff_s <= offset && offset <= eff_e {
            let l = eff_e - eff_s;
            if sname == word {
                if l < best_len {
                    best_len = l;
                    best_nid = i;
                }
            }
        }
        i = i + 1;
    }
    if best_nid != -1 {
        var target_id = __engine(Cfg.ast.ast_get_bound_target, best_nid);
        if target_id == 4294967295 || target_id < 0 {
            target_id = best_nid;
        }
        let b_kind = __engine(Cfg.ast.ast_node_kind, best_nid);
        if b_kind == 17 || (target_id == best_nid && (b_kind == 14 || b_kind == 16)) {
            var found_target = -1;
            var j = 0;
            while j < node_count && found_target == -1 {
                let jk = __engine(Cfg.ast.ast_node_kind, j);
                let js = __engine(Cfg.ast.ast_node_sym, j);
                let jname = __engine(Cfg.ast.sym_str, js);
                if jname == word {
                    if b_kind == 17 {
                        if jk == 21 || jk == 3 {
                            found_target = j;
                        }
                    } else {
                        if jk == 4 || jk == 21 || jk == 3 || jk == 1 || jk == 2 {
                            found_target = j;
                        }
                    }
                }
                j = j + 1;
            }
            if found_target != -1 {
                target_id = found_target;
            }
        }
        let s = __engine(Cfg.ast.ast_span_start, target_id);
        let e = __engine(Cfg.ast.ast_span_end, target_id);
        let res = "" + s + ":" + e;
        __engine(Cfg.ast.lsp_set_result, res);
        return;
    }
    __engine(Cfg.ast.lsp_set_result, "null");
}

pub fn handle_lsp_references(offset: i64) {
    let cur_ch = __engine(Cfg.ast.source_slice, offset, offset + 1);
    let is_ident = (cur_ch >= "a" && cur_ch <= "z") || (cur_ch >= "A" && cur_ch <= "Z") || (cur_ch >= "0" && cur_ch <= "9") || cur_ch == "_";
    if !is_ident {
        __engine(Cfg.ast.lsp_set_result, "[]");
        return;
    }

    var w_start = offset;
    var scan_wstart = true;
    while scan_wstart && w_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, w_start - 1, w_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_start = w_start - 1;
        } else {
            scan_wstart = false;
        }
    }
    var w_end = offset;
    var scan_wend = true;
    while scan_wend && w_end < offset + 40 {
        let ch = __engine(Cfg.ast.source_slice, w_end, w_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_end = w_end + 1;
        } else {
            scan_wend = false;
        }
    }
    let word = __engine(Cfg.ast.source_slice, w_start, w_end);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "[]");
        return;
    }

    let node_count = __engine(Cfg.ast.ast_node_count);
    var refs_json = "[";
    var added = 0;
    var i = 0;
    while i < node_count {
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        let sname = __engine(Cfg.ast.sym_str, sym);
        if sname == word {
            let s = __engine(Cfg.ast.ast_span_start, i);
            let e = __engine(Cfg.ast.ast_span_end, i);
            let k = __engine(Cfg.ast.ast_node_kind, i);
            var eff_s = s;
            var eff_e = e;
            if k == 17 {
                var p = e;
                while p < e + 60 && __engine(Cfg.ast.source_slice, p, p + 1) != "." {
                    p = p + 1;
                }
                if __engine(Cfg.ast.source_slice, p, p + 1) == "." {
                    p = p + 1;
                    while p < e + 60 && (__engine(Cfg.ast.source_slice, p, p + 1) == " " || __engine(Cfg.ast.source_slice, p, p + 1) == "\t") {
                        p = p + 1;
                    }
                    eff_s = p;
                    var m_end = p;
                    var scan_m = true;
                    while scan_m && m_end < p + 60 {
                        let ch = __engine(Cfg.ast.source_slice, m_end, m_end + 1);
                        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
                            m_end = m_end + 1;
                        } else {
                            scan_m = false;
                        }
                    }
                    eff_e = m_end;
                }
            }
            if added > 0 {
                refs_json = refs_json + ",";
            }
            refs_json = refs_json + '{"start":' + eff_s + ',"end":' + eff_e + '}';
            added = added + 1;
        }
        i = i + 1;
    }
    refs_json = refs_json + "]";
    __engine(Cfg.ast.lsp_set_result, refs_json);
}

pub fn is_keyword_or_seed(w: str) -> bool {
    if w == "" {
        return true;
    }
    // 14 Hardware seed tokens
    if w == nameof(__engine) || w == nameof(struct) || w == nameof(interface) || w == nameof(fn) ||
       w == nameof(let) || w == nameof(ref) || w == nameof(if) || w == nameof(loop) ||
       w == nameof(return) || w == nameof(yield) || w == nameof(defer) || w == nameof(comptime) ||
       w == nameof(quote) || w == nameof(asm) {
        return true;
    }
    __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
    __engine(Cfg.ast.mount_unit, "../../stdlib/core/keywords.pilot");
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == w {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn handle_lsp_prepare_rename(offset: i64) {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var best_nid = -1;
    var best_len = 999999999;
    var i = 0;
    while i < node_count {
        let s = __engine(Cfg.ast.ast_span_start, i);
        let e = __engine(Cfg.ast.ast_span_end, i);
        if s <= offset && offset <= e {
            let l = e - s;
            if l < best_len {
                best_len = l;
                best_nid = i;
            }
        }
        i = i + 1;
    }

    if best_nid != -1 {
        let s = __engine(Cfg.ast.ast_span_start, best_nid);
        let e = __engine(Cfg.ast.ast_span_end, best_nid);
        let sym = __engine(Cfg.ast.ast_node_sym, best_nid);
        var word = __engine(Cfg.ast.sym_str, sym);
        if word == "" {
            word = __engine(Cfg.ast.source_slice, s, e);
        }
        if is_keyword_or_seed(word) {
            __engine(Cfg.ast.lsp_set_result, "null");
        } else {
            __engine(Cfg.ast.lsp_set_result, word);
        }
        return;
    }
    __engine(Cfg.ast.lsp_set_result, "null");
}

pub fn handle_lsp_rename(offset: i64, method_str: str) {
    // 1. Rejection for 14 hardware seed keywords
    if method_str == "textDocument/rename:" + nameof(__engine) ||
       method_str == "textDocument/rename:" + nameof(struct) ||
       method_str == "textDocument/rename:" + nameof(interface) ||
       method_str == "textDocument/rename:" + nameof(fn) ||
       method_str == "textDocument/rename:" + nameof(let) ||
       method_str == "textDocument/rename:" + nameof(ref) ||
       method_str == "textDocument/rename:" + nameof(if) ||
       method_str == "textDocument/rename:" + nameof(loop) ||
       method_str == "textDocument/rename:" + nameof(return) ||
       method_str == "textDocument/rename:" + nameof(yield) ||
       method_str == "textDocument/rename:" + nameof(defer) ||
       method_str == "textDocument/rename:" + nameof(comptime) ||
       method_str == "textDocument/rename:" + nameof(quote) ||
       method_str == "textDocument/rename:" + nameof(asm) {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }

    // 2. Dynamic rejection for all non-seed keywords reflected from keywords.pilot
    __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
    __engine(Cfg.ast.mount_unit, "../../stdlib/core/keywords.pilot");
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine("ast_attr_count", i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if method_str == "textDocument/rename:" + nm {
                    __engine(Cfg.ast.lsp_set_result, "null");
                    return;
                }
            }
        }
        i = i + 1;
    }

    handle_lsp_prepare_rename(offset);
}

// =========================================================================
// 9. TOP-LEVEL LSP DISPATCHER
// =========================================================================

let _lsp_method = __engine(Cfg.ast.lsp_query_method);
let _lsp_offset = __engine(Cfg.ast.lsp_query_offset);

if _lsp_method == "textDocument/hover" {
    handle_lsp_hover(_lsp_offset);
}
if _lsp_method == "textDocument/completion" {
    handle_lsp_completion(_lsp_offset);
}
if _lsp_method == "textDocument/definition" {
    handle_lsp_definition(_lsp_offset);
}
if _lsp_method == "textDocument/prepareRename" {
    handle_lsp_prepare_rename(_lsp_offset);
}
if _lsp_method == "textDocument/references" {
    handle_lsp_references(_lsp_offset);
}
if _lsp_method == "ide-sync" || _lsp_method == "" {
    __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
    __engine(Cfg.ast.mount_unit, "../../stdlib/core/keywords.pilot");
    let tm_model = build_tm_language_model("", "", "", "", "");
    let lc_model = build_language_configuration_model();
    let sn_model = build_snippets_model();
    let pkg_model = build_package_json_model("1.1.51");
    dump(tm_model, "vscode-pilot/syntaxes/pilot.tmLanguage.json");
    dump(lc_model, "vscode-pilot/language-configuration.json");
    dump(sn_model, "vscode-pilot/snippets/pilot.json");
    dump(pkg_model, "vscode-pilot/package.json");
    let verify_pkg = load("vscode-pilot/package.json");
} else {
    if _lsp_method != "textDocument/hover" && _lsp_method != "textDocument/completion" && _lsp_method != "textDocument/definition" && _lsp_method != "textDocument/prepareRename" && _lsp_method != "textDocument/references" {
        handle_lsp_rename(_lsp_offset, _lsp_method);
    }
}
