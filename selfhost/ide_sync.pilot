pure fn tm_strings_section() -> str => "    \"strings\": {\n" +
    "      \"patterns\": [\n" +
    "        {\n" +
    "          \"name\": \"string.quoted.triple.interpolated.pilot\",\n" +
    "          \"begin\": \"(f)(\\\"\\\"\\\")\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.definition.string.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\"\\\"\\\"\",\n" +
    "          \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.string.end.pilot\" } },\n" +
    "          \"patterns\": [\n" +
    "            { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" },\n" +
    "            {\n" +
    "              \"name\": \"meta.interpolation.pilot\",\n" +
    "              \"begin\": \"\\\\{\",\n" +
    "              \"beginCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.begin.pilot\" } },\n" +
    "              \"end\": \"\\\\}\",\n" +
    "              \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.end.pilot\" } },\n" +
    "              \"patterns\": [ { \"include\": \"$self\" } ]\n" +
    "            }\n" +
    "          ]\n" +
    "        },\n" +
    "        { \"name\": \"string.quoted.triple.pilot\", \"begin\": \"\\\"\\\"\\\"\", \"end\": \"\\\"\\\"\\\"\", \"patterns\": [ { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" } ] },\n" +
    "        {\n" +
    "          \"name\": \"string.quoted.double.interpolated.pilot\",\n" +
    "          \"begin\": \"(f)(\\\")\",\n" +
    "          \"beginCaptures\": {\n" +
    "            \"1\": { \"name\": \"storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot\" },\n" +
    "            \"2\": { \"name\": \"punctuation.definition.string.begin.pilot\" }\n" +
    "          },\n" +
    "          \"end\": \"\\\"\",\n" +
    "          \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.string.end.pilot\" } },\n" +
    "          \"patterns\": [\n" +
    "            { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" },\n" +
    "            {\n" +
    "              \"name\": \"meta.interpolation.pilot\",\n" +
    "              \"begin\": \"\\\\{\",\n" +
    "              \"beginCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.begin.pilot\" } },\n" +
    "              \"end\": \"\\\\}\",\n" +
    "              \"endCaptures\": { \"0\": { \"name\": \"punctuation.definition.template-expression.end.pilot\" } },\n" +
    "              \"patterns\": [ { \"include\": \"$self\" } ]\n" +
    "            }\n" +
    "          ]\n" +
    "        },\n" +
    "        { \"name\": \"string.quoted.double.pilot\", \"begin\": \"\\\"\", \"end\": \"\\\"\", \"patterns\": [ { \"name\": \"constant.character.escape.pilot\", \"match\": \"\\\\\\\\.\" } ] },\n" +
    "        { \"name\": \"string.quoted.single.pilot\", \"match\": \"'(?:[^'\\\\\\\\\\n\\r]|\\\\\\\\.)*'\" }\n" +
    "      ]\n" +
    "    }";

pure fn tm_raw_idents_section() -> str => "    \"raw-idents\": {\n" +
