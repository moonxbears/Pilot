// ==============================================================================
// FILE: selfhost/lexer.pilot
// Milestone 61.1: Standalone Self-Hosted TokenTape Scanner & 14-Token Seed Lexer
// ==============================================================================
pub pkg Pilot.SelfHost.Lexer;

pub pure fn nameof(sym: str) -> str => sym;

pub enum TokenTagKind {
    SeedKw,
    Ident,
    IntLit,
    StrLit,
    FStrLit,
    InfixDot,
    PrefixDot,
    CallQuoteShallow,
    CallQuoteDeep,
    CallQuoteAbi,
    CallQuoteSignal,
    CallQuoteAdjoint,
    CallQuoteEffect,
    LParen,
    RParen,
    LBracket,
    RBracket,
    LBrace,
    RBrace,
    Op,
    Punct,
    Eof,
}

fn sh_is_digit(b: i64) -> bool {
    return b >= 48 && b <= 57;
}

fn sh_is_alpha(b: i64) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

fn sh_is_id_char(b: i64) -> bool {
    return sh_is_alpha(b) || sh_is_digit(b);
}

// 14 strict canonical Pilot seed keywords (Zero hardcoded type names)
fn sh_is_seed_kw(w: str) -> bool {
    if w == nameof(__engine) { return true; }
    if w == nameof(struct) { return true; }
    if w == nameof(interface) { return true; }
    if w == nameof(fn) { return true; }
    if w == nameof(let) { return true; }
    if w == nameof(ref) { return true; }
    if w == nameof(if) { return true; }
    if w == nameof(loop) { return true; }
    if w == nameof(return) { return true; }
    if w == nameof(yield) { return true; }
    if w == nameof(defer) { return true; }
    if w == nameof(comptime) { return true; }
    if w == nameof(quote) { return true; }
    if w == nameof(asm) { return true; }
    return false;
}

pub fn sh_tokenize(src: str) -> i64 {
    let tape = __engine("map_new");
    let len = src.len();
    var pos = 0;
    var count = 0;
    var prev_token_end = -1;
    var prev_token_is_infix_predecessor = false;

    // Stack for bracket matching
    let bracket_stack = __engine("map_new");
    var b_top = 0;

    while pos < len {
        let b = src.byte_at(pos);

        // Skip whitespace
        if b == 32 || b == 9 || b == 10 || b == 13 {
            pos = pos + 1;
        } else if b == 47 && pos + 1 < len && src.byte_at(pos + 1) == 47 {
            // Line comment // ...
            pos = pos + 2;
            while pos < len {
                let cb = src.byte_at(pos);
                pos = pos + 1;
                if cb == 10 { break; }
            }
        } else if b == 47 && pos + 1 < len && src.byte_at(pos + 1) == 42 {
            // Block comment /* ... */
            pos = pos + 2;
            while pos + 1 < len {
                let cb1 = src.byte_at(pos);
                let cb2 = src.byte_at(pos + 1);
                if cb1 == 42 && cb2 == 47 {
                    pos = pos + 2;
                    break;
                }
                pos = pos + 1;
            }
        } else if b == 34 || (b == 102 && pos + 1 < len && src.byte_at(pos + 1) == 34) {
            // String literal "..." or f"..."
            let is_fstr = b == 102;
            let start = pos;
            if is_fstr { pos = pos + 1; }
            pos = pos + 1; // skip opening quote
            while pos < len {
                let cb = src.byte_at(pos);
                if cb == 92 && pos + 1 < len { // escape \
                    pos = pos + 2;
                } else if cb == 34 { // closing quote
                    pos = pos + 1;
                    break;
                } else {
                    pos = pos + 1;
                }
            }
            let s_text = src.slice(start, pos);
            let s_tag = if is_fstr { "FStrLit" } else { "StrLit" };
            __engine("map_set", tape, count + "_text", s_text);
            __engine("map_set", tape, count + "_tag", s_tag);
            __engine("map_set", tape, count + "_match", -1);
            prev_token_end = pos;
            prev_token_is_infix_predecessor = true;
            count = count + 1;
        } else if b == 46 { // '.'
            let is_infix = prev_token_is_infix_predecessor && (prev_token_end == pos);
            let dot_tag = if is_infix { "InfixDot" } else { "PrefixDot" };
            __engine("map_set", tape, count + "_text", ".");
            __engine("map_set", tape, count + "_tag", dot_tag);
            __engine("map_set", tape, count + "_match", -1);
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = false;
            count = count + 1;
            pos = pos + 1;
        } else if b == 33 { // '!'
            // Check for call-quote modes (zero whitespace before '(')
            // !( -> ShallowQuote
            // !!( -> DeepSplice
            // !&( -> AbiFrame
            // !^( -> ReactiveSignal
            // !@( -> SymbolicAdjoint
            // !?( -> EffectDryRun
            var call_quote_tag = "";
            var sigil_len = 0;
            if pos + 1 < len && src.byte_at(pos + 1) == 40 { // !(
                call_quote_tag = "CallQuoteShallow";
                sigil_len = 1;
            } else if pos + 2 < len && src.byte_at(pos + 2) == 40 {
                let nb = src.byte_at(pos + 1);
                if nb == 33 { call_quote_tag = "CallQuoteDeep"; sigil_len = 2; }
                else if nb == 38 { call_quote_tag = "CallQuoteAbi"; sigil_len = 2; }
                else if nb == 94 { call_quote_tag = "CallQuoteSignal"; sigil_len = 2; }
                else if nb == 64 { call_quote_tag = "CallQuoteAdjoint"; sigil_len = 2; }
                else if nb == 63 { call_quote_tag = "CallQuoteEffect"; sigil_len = 2; }
            }

            if call_quote_tag != "" {
                let sig_text = src.slice(pos, pos + sigil_len);
                __engine("map_set", tape, count + "_text", sig_text);
                __engine("map_set", tape, count + "_tag", call_quote_tag);
                __engine("map_set", tape, count + "_match", -1);
                prev_token_end = pos + sigil_len;
                prev_token_is_infix_predecessor = false;
                count = count + 1;
                pos = pos + sigil_len;
            } else if pos + 1 < len && src.byte_at(pos + 1) == 61 { // !=
                __engine("map_set", tape, count + "_text", "!=");
                __engine("map_set", tape, count + "_tag", "Op");
                __engine("map_set", tape, count + "_match", -1);
                prev_token_end = pos + 2;
                prev_token_is_infix_predecessor = false;
                count = count + 1;
                pos = pos + 2;
            } else {
                __engine("map_set", tape, count + "_text", "!");
                __engine("map_set", tape, count + "_tag", "Op");
                __engine("map_set", tape, count + "_match", -1);
                prev_token_end = pos + 1;
                prev_token_is_infix_predecessor = false;
                count = count + 1;
                pos = pos + 1;
            }
        } else if b == 40 { // '('
            __engine("map_set", tape, count + "_text", "(");
            __engine("map_set", tape, count + "_tag", "LParen");
            __engine("map_set", tape, count + "_match", -1);
            __engine("map_set", bracket_stack, b_top, count);
            b_top = b_top + 1;
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = false;
            count = count + 1;
            pos = pos + 1;
        } else if b == 41 { // ')'
            __engine("map_set", tape, count + "_text", ")");
            __engine("map_set", tape, count + "_tag", "RParen");
            __engine("map_set", tape, count + "_match", -1);
            if b_top > 0 {
                b_top = b_top - 1;
                let open_idx = __engine("map_get", bracket_stack, b_top);
                __engine("map_set", tape, open_idx + "_match", count);
                __engine("map_set", tape, count + "_match", open_idx);
            }
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = true;
            count = count + 1;
            pos = pos + 1;
        } else if b == 91 { // '['
            __engine("map_set", tape, count + "_text", "[");
            __engine("map_set", tape, count + "_tag", "LBracket");
            __engine("map_set", tape, count + "_match", -1);
            __engine("map_set", bracket_stack, b_top, count);
            b_top = b_top + 1;
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = false;
            count = count + 1;
            pos = pos + 1;
        } else if b == 93 { // ']'
            __engine("map_set", tape, count + "_text", "]");
            __engine("map_set", tape, count + "_tag", "RBracket");
            __engine("map_set", tape, count + "_match", -1);
            if b_top > 0 {
                b_top = b_top - 1;
                let open_idx = __engine("map_get", bracket_stack, b_top);
                __engine("map_set", tape, open_idx + "_match", count);
                __engine("map_set", tape, count + "_match", open_idx);
            }
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = true;
            count = count + 1;
            pos = pos + 1;
        } else if b == 123 { // '{'
            __engine("map_set", tape, count + "_text", "{");
            __engine("map_set", tape, count + "_tag", "LBrace");
            __engine("map_set", tape, count + "_match", -1);
            __engine("map_set", bracket_stack, b_top, count);
            b_top = b_top + 1;
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = false;
            count = count + 1;
            pos = pos + 1;
        } else if b == 125 { // '}'
            __engine("map_set", tape, count + "_text", "}");
            __engine("map_set", tape, count + "_tag", "RBrace");
            __engine("map_set", tape, count + "_match", -1);
            if b_top > 0 {
                b_top = b_top - 1;
                let open_idx = __engine("map_get", bracket_stack, b_top);
                __engine("map_set", tape, open_idx + "_match", count);
                __engine("map_set", tape, count + "_match", open_idx);
            }
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = true;
            count = count + 1;
            pos = pos + 1;
        } else if b == 59 || b == 44 || b == 58 { // ';', ',', ':'
            let p_txt = src.slice(pos, pos + 1);
            __engine("map_set", tape, count + "_text", p_txt);
            __engine("map_set", tape, count + "_tag", "Punct");
            __engine("map_set", tape, count + "_match", -1);
            prev_token_end = pos + 1;
            prev_token_is_infix_predecessor = false;
            count = count + 1;
            pos = pos + 1;
        } else if sh_is_digit(b) {
            let start = pos;
            while pos < len && sh_is_digit(src.byte_at(pos)) {
                pos = pos + 1;
            }
            let num_text = src.slice(start, pos);
            __engine("map_set", tape, count + "_text", num_text);
            __engine("map_set", tape, count + "_tag", "IntLit");
            __engine("map_set", tape, count + "_match", -1);
            prev_token_end = pos;
            prev_token_is_infix_predecessor = true;
            count = count + 1;
        } else if sh_is_alpha(b) {
            let start = pos;
            while pos < len && sh_is_id_char(src.byte_at(pos)) {
                pos = pos + 1;
            }
            let id_text = src.slice(start, pos);
            let tag = if sh_is_seed_kw(id_text) { "SeedKw" } else { "Ident" };
            __engine("map_set", tape, count + "_text", id_text);
            __engine("map_set", tape, count + "_tag", tag);
            __engine("map_set", tape, count + "_match", -1);
            prev_token_end = pos;
            prev_token_is_infix_predecessor = true;
            count = count + 1;
        } else {
            // Multi-char operators e.g. ==, <=, >=, &&, ||, =>, ->
            var op_len = 1;
            if pos + 1 < len {
                let b2 = src.byte_at(pos + 1);
                if (b == 61 && b2 == 61) || // ==
                   (b == 60 && b2 == 61) || // <=
                   (b == 62 && b2 == 61) || // >=
                   (b == 38 && b2 == 38) || // &&
                   (b == 124 && b2 == 124) || // ||
                   (b == 61 && b2 == 62) || // =>
                   (b == 45 && b2 == 62) {  // ->
                    op_len = 2;
                }
            }
            let op_text = src.slice(pos, pos + op_len);
            __engine("map_set", tape, count + "_text", op_text);
            __engine("map_set", tape, count + "_tag", "Op");
            __engine("map_set", tape, count + "_match", -1);
            prev_token_end = pos + op_len;
            prev_token_is_infix_predecessor = false;
            count = count + 1;
            pos = pos + op_len;
        }
    }

    __engine("map_set", tape, "count", count);
    return tape;
}

pub fn sh_token_count(tape: i64) -> i64 {
    return __engine("map_get", tape, "count");
}

pub fn sh_token_text(tape: i64, idx: i64) -> str {
    return __engine("map_get", tape, idx + "_text");
}

pub fn sh_token_tag(tape: i64, idx: i64) -> str {
    return __engine("map_get", tape, idx + "_tag");
}

pub pure fn token_tag_name(kind: TokenTagKind) -> str {
    return "Ident";
}

pub fn sh_token_tag_kind(tape: i64, idx: i64) -> TokenTagKind {
    return ::Ident;
}

pub fn sh_token_matching_bracket(tape: i64, idx: i64) -> i64 {
    let nil;
    let m = __engine("map_get", tape, idx + "_match");
    if m != nil {
        return m;
    }
    return -1;
}
