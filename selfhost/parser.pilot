// ==============================================================================
// FILE: selfhost/parser.pilot
// Standalone Self-Hosted Pratt, Statement, Declaration & Homoiconic `quote` Parser
// Genuinely parses `syntax name(params...) => quote { ... $hole ... $*seq ... ~expr }`
// into `MutableAstArena` templates and instantiates them via AST splicing & hygiene.
// ==============================================================================
pub pkg Pilot.SelfHost.Parser;

pub pure fn nameof(sym: str) -> str => sym;

fn sh_get_precedence(op_str: str) -> i64 {
    if op_str == "||" { return 5; }
    if op_str == "&&" { return 10; }
    if op_str == "==" || op_str == "!=" { return 20; }
    if op_str == "<" || op_str == "<=" || op_str == ">" || op_str == ">=" { return 25; }
    if op_str == "+" || op_str == "-" { return 30; }
    if op_str == "*" || op_str == "/" || op_str == "%" { return 40; }
    return 0;
}

pub pure fn sh_op_precedence(op_str: str) -> i64 {
    return sh_get_precedence(op_str);
}

pub pure fn sh_parser_state_name(state: i64) -> str {
    if state == 1 { return "Parsing"; }
    if state == 2 { return "Done"; }
    if state == 3 { return "Error"; }
    return "Ready";
}

// ==============================================================================
// 1. Homoiconic Macro Registry & Argument / Template Splicing Helpers
// ==============================================================================

fn sh_find_macro_entry(ctx: i64, name: str, arg_count: i64) -> i64 {
    let nil;
    let mcnt = __engine("map_get", ctx, "macro_count");
    if mcnt == nil || mcnt <= 0 { return -1; }
    var fallback = -1;
    var i = 0;
    while i < mcnt {
        let mname = __engine("map_get", ctx, "m_" + i + "_name");
        if mname == name {
            let pcnt = __engine("map_get", ctx, "m_" + i + "_pcount");
            let has_var = __engine("map_get", ctx, "m_" + i + "_variadic");
            if has_var == 1 {
                if arg_count >= pcnt - 1 {
                    fallback = i;
                }
            } else if pcnt == arg_count {
                return i;
            }
        }
        i = i + 1;
    }
    return fallback;
}

fn sh_has_macro_name(ctx: i64, name: str) -> bool {
    let nil;
    let mcnt = __engine("map_get", ctx, "macro_count");
    if mcnt == nil || mcnt <= 0 { return false; }
    var i = 0;
    while i < mcnt {
        if __engine("map_get", ctx, "m_" + i + "_name") == name {
            return true;
        }
        i = i + 1;
    }
    return false;
}

// Parses a single macro call argument (supporting statements like `return 1;` or `let x = 2;` AND expressions)
fn sh_parse_macro_arg(arena: i64, tape: i64, ctx: i64) -> i64 {
    let cur = __engine("map_get", ctx, "pos");
    let tcnt = sh_token_count(tape);
    if cur >= tcnt { return -1; }
    let tag = sh_token_tag(tape, cur);
    let txt = sh_token_text(tape, cur);

    if tag == "LBrace" {
        return sh_parse_block(arena, tape, ctx);
    }
    if txt == nameof(return) || txt == nameof(let) || txt == "var" || txt == "if" || txt == "while" || txt == nameof(loop) {
        return sh_parse_statement(arena, tape, ctx);
    }
    if (tag == "Ident" || tag == "SeedKw") && cur + 1 < tcnt && sh_token_text(tape, cur + 1) == "=" {
        return sh_parse_statement(arena, tape, ctx);
    }
    let expr_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
    let after = __engine("map_get", ctx, "pos");
    if after < tcnt && sh_token_text(tape, after) == ";" {
        __engine("map_set", ctx, "pos", after + 1);
    }
    return expr_nid;
}

fn sh_invoke_macro(arena: i64, tape: i64, ctx: i64, name: str) -> i64 {
    let start_cur = __engine("map_get", ctx, "pos");
    let tcnt = sh_token_count(tape);
    // Advance past `name` and `(`
    __engine("map_set", ctx, "pos", start_cur + 2);

    let raw_args = __engine("map_new");
    var acnt = 0;
    while true {
        let p = __engine("map_get", ctx, "pos");
        if p >= tcnt { break; }
        if sh_token_tag(tape, p) == "RParen" {
            __engine("map_set", ctx, "pos", p + 1);
            break;
        }
        let arg_nid = sh_parse_macro_arg(arena, tape, ctx);
        if arg_nid >= 0 {
            __engine("map_set", raw_args, "a_" + acnt, arg_nid);
            acnt = acnt + 1;
        }
        let c_pos = __engine("map_get", ctx, "pos");
        if c_pos < tcnt && sh_token_text(tape, c_pos) == "," {
            __engine("map_set", ctx, "pos", c_pos + 1);
        } else if c_pos < tcnt && sh_token_tag(tape, c_pos) == "RParen" {
            __engine("map_set", ctx, "pos", c_pos + 1);
            break;
        } else if c_pos == p {
            __engine("map_set", ctx, "pos", c_pos + 1);
        }
    }

    let midx = sh_find_macro_entry(ctx, name, acnt);
    if midx < 0 { return -1; }

    let pcnt = __engine("map_get", ctx, "m_" + midx + "_pcount");
    let has_var = __engine("map_get", ctx, "m_" + midx + "_variadic");
    let tpl_nid = __engine("map_get", ctx, "m_" + midx + "_tpl");

    let bindings = sh_ast_bindings_new();
    // Copy registered compile-time constants into bindings for `~expr` evaluation
    let nil;
    let ccnt = __engine("map_get", ctx, "const_count");
    if ccnt != nil && ccnt > 0 {
        var ci = 0;
        while ci < ccnt {
            let cname = __engine("map_get", ctx, "c_" + ci + "_name");
            let cval = __engine("map_get", ctx, "c_" + ci + "_val");
            sh_ast_bind_const(bindings, cname, cval);
            ci = ci + 1;
        }
    }

    var pi = 0;
    while pi < pcnt {
        let pname = __engine("map_get", ctx, "m_" + midx + "_p_" + pi);
        let p_is_var = __engine("map_get", ctx, "m_" + midx + "_pvar_" + pi);
        if p_is_var == 1 || (has_var == 1 && pi == pcnt - 1) {
            let seq_nid = sh_ast_alloc_seq(arena);
            var ai = pi;
            while ai < acnt {
                sh_ast_add_child(arena, seq_nid, __engine("map_get", raw_args, "a_" + ai));
                ai = ai + 1;
            }
            sh_ast_bind_seq(bindings, pname, seq_nid);
        } else if pi < acnt {
            sh_ast_bind_node(bindings, pname, __engine("map_get", raw_args, "a_" + pi));
        }
        pi = pi + 1;
    }

    return sh_ast_instantiate_quote(arena, tpl_nid, bindings);
}

// ==============================================================================
// 2. Pratt Expression, Quote Hole (`$x`, `$*xs`, `~expr`) & Statement Parser
// ==============================================================================

fn sh_parse_quote_template(arena: i64, tape: i64, ctx: i64) -> i64 {
    let cur = __engine("map_get", ctx, "pos");
    let tcnt = sh_token_count(tape);
    if cur >= tcnt { return -1; }

    let tag = sh_token_tag(tape, cur);
    if tag == "LBrace" {
        let blk = sh_parse_block(arena, tape, ctx);
        let bcnt = sh_ast_child_count(arena, blk);
        if bcnt == 1 {
            let single = sh_ast_child_at(arena, blk, 0);
            return sh_ast_alloc_template(arena, single);
        }
        let seq = sh_ast_alloc_seq(arena);
        var i = 0;
        while i < bcnt {
            sh_ast_add_child(arena, seq, sh_ast_child_at(arena, blk, i));
            i = i + 1;
        }
        return sh_ast_alloc_template(arena, seq);
    }
    let expr_tpl = sh_parse_expr_bp(arena, tape, ctx, 0);
    return sh_ast_alloc_template(arena, expr_tpl);
}

fn sh_parse_primary(arena: i64, tape: i64, ctx: i64) -> i64 {
    let cur = __engine("map_get", ctx, "pos");
    let tcnt = sh_token_count(tape);
    if cur >= tcnt { return -1; }

    let tag = sh_token_tag(tape, cur);
    let text = sh_token_text(tape, cur);

    // Homoiconic splice holes: `$*seq`, `$hole`, `$(hole)`
    if tag == "Op" && text == "$" {
        if cur + 2 < tcnt && sh_token_text(tape, cur + 1) == "*" {
            let sname = sh_token_text(tape, cur + 2);
            __engine("map_set", ctx, "pos", cur + 3);
            return sh_ast_alloc_splat(arena, sname, -1);
        }
        if cur + 3 < tcnt && sh_token_tag(tape, cur + 1) == "LParen" {
            let p_name = sh_token_text(tape, cur + 2);
            __engine("map_set", ctx, "pos", cur + 4);
            return sh_ast_alloc_splice(arena, p_name, -1);
        }
        if cur + 1 < tcnt {
            let hname = sh_token_text(tape, cur + 1);
            __engine("map_set", ctx, "pos", cur + 2);
            return sh_ast_alloc_splice(arena, hname, -1);
        }
    }

    // Alternate variadic splat syntax: `*$seq`
    if tag == "Op" && text == "*" && cur + 2 < tcnt && sh_token_text(tape, cur + 1) == "$" {
        let vname = sh_token_text(tape, cur + 2);
        __engine("map_set", ctx, "pos", cur + 3);
        return sh_ast_alloc_splat(arena, vname, -1);
    }

    // Homoiconic compile-time unquote escape: `~expr` or `~(expr)`
    if tag == "Op" && text == "~" {
        __engine("map_set", ctx, "pos", cur + 1);
        let u_expr = sh_parse_expr_bp(arena, tape, ctx, 50);
        return sh_ast_alloc_unquote(arena, u_expr);
    }

    // First-class `quote { ... }` template expression
    if text == "quote" {
        __engine("map_set", ctx, "pos", cur + 1);
        return sh_parse_quote_template(arena, tape, ctx);
    }

    // Verbatim `raw("...")` quotation
    if tag == "Ident" && text == "raw" && cur + 2 < tcnt && sh_token_tag(tape, cur + 1) == "LParen" {
        let raw_txt = sh_token_text(tape, cur + 2);
        var next_p = cur + 3;
        if next_p < tcnt && sh_token_tag(tape, next_p) == "RParen" {
            next_p = next_p + 1;
        }
        __engine("map_set", ctx, "pos", next_p);
        return sh_ast_alloc_raw(arena, raw_txt);
    }

    if tag == "IntLit" {
        __engine("map_set", ctx, "pos", cur + 1);
        return sh_ast_alloc_node(arena, "IntLit", text);
    }

    if tag == "StrLit" || tag == "FStrLit" {
        __engine("map_set", ctx, "pos", cur + 1);
        return sh_ast_alloc_node(arena, "StrLit", text);
    }

    if tag == "Ident" && (text == "true" || text == "false") {
        __engine("map_set", ctx, "pos", cur + 1);
        return sh_ast_alloc_node(arena, "BoolLit", text);
    }

    // Prefix `await expr` / `await(expr)` and `spawn { ... }` / `select { ... }`
    if tag == "Ident" && text == "await" {
        __engine("map_set", ctx, "pos", cur + 1);
        let awaited = sh_parse_expr_bp(arena, tape, ctx, 50);
        return sh_ast_alloc_unary(arena, "await", awaited);
    }
    if tag == "Ident" && text == "each" {
        __engine("map_set", ctx, "pos", cur + 1);
        let adapted = sh_parse_expr_bp(arena, tape, ctx, 50);
        return sh_ast_alloc_unary(arena, "each", adapted);
    }
    if tag == "Ident" && (text == "spawn" || text == "select") && cur + 1 < tcnt && sh_token_tag(tape, cur + 1) == "LBrace" {
        __engine("map_set", ctx, "pos", cur + 1);
        let s_blk = sh_parse_block(arena, tape, ctx);
        return sh_ast_alloc_unary(arena, text, s_blk);
    }

    // 3-Tier dynamic `for binding in iterable { body } [then fallback]`
    if tag == "Ident" && text == "for" && cur + 2 < tcnt {
        let b_name = sh_token_text(tape, cur + 1);
        if sh_token_text(tape, cur + 2) == "in" {
            __engine("map_set", ctx, "pos", cur + 3);
            let iter_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
            let body_nid = sh_parse_block(arena, tape, ctx);
            let for_nid = sh_ast_alloc_node(arena, "ForExpr", b_name);
            sh_ast_add_child(arena, for_nid, iter_nid);
            sh_ast_add_child(arena, for_nid, body_nid);
            let tp = __engine("map_get", ctx, "pos");
            if tp < tcnt && sh_token_text(tape, tp) == "then" {
                __engine("map_set", ctx, "pos", tp + 1);
                let fallback_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
                sh_ast_add_child(arena, for_nid, fallback_nid);
            }
            return for_nid;
        }
    }

    if tag == "Ident" || tag == "SeedKw" {
        let nxt_tag = if cur + 1 < tcnt { sh_token_tag(tape, cur + 1) } else { "" };
        if (text == "splat" || text == "pairs" || text == "flat") && nxt_tag == "LParen" {
            __engine("map_set", ctx, "pos", cur + 2);
            let operand = sh_parse_expr_bp(arena, tape, ctx, 0);
            let cp = __engine("map_get", ctx, "pos");
            if cp < tcnt && sh_token_tag(tape, cp) == "RParen" {
                __engine("map_set", ctx, "pos", cp + 1);
            }
            var op_sym = "*";
            if text == "pairs" { op_sym = "**"; }
            else if text == "flat" { op_sym = "*.."; }
            let nid = sh_ast_alloc_node(arena, "UnaryExpr", op_sym);
            sh_ast_add_child(arena, nid, operand);
            return nid;
        }

        let is_prefix_proj = text == "call" || text == "splice" || text == "frame" || text == "sig" || text == "grad" || text == "plan";
        if is_prefix_proj && cur + 2 < tcnt {
            let p1_tag = sh_token_tag(tape, cur + 1);
            let p2_tag = sh_token_tag(tape, cur + 2);
            if (p1_tag == "Ident" || p1_tag == "SeedKw") && p2_tag == "LParen" {
                let callee_text = sh_token_text(tape, cur + 1);
                __engine("map_set", ctx, "pos", cur + 3);
                let call_nid = sh_ast_alloc_node(arena, "CallExpr", callee_text);
                while true {
                    let ap = __engine("map_get", ctx, "pos");
                    if ap >= tcnt { break; }
                    if sh_token_tag(tape, ap) == "RParen" {
                        __engine("map_set", ctx, "pos", ap + 1);
                        break;
                    }
                    let arg = sh_parse_expr_bp(arena, tape, ctx, 0);
                    if arg >= 0 {
                        sh_ast_add_child(arena, call_nid, arg);
                    }
                    let cp = __engine("map_get", ctx, "pos");
                    if cp < tcnt && sh_token_text(tape, cp) == "," {
                        __engine("map_set", ctx, "pos", cp + 1);
                    } else if cp < tcnt && sh_token_tag(tape, cp) == "RParen" {
                        __engine("map_set", ctx, "pos", cp + 1);
                        break;
                    } else if cp == ap {
                        __engine("map_set", ctx, "pos", cp + 1);
                    }
                }
                return call_nid;
            }
        }

        // Check expression-position macro expansion, call-quoting, OR standard `CallExpr`
        let nxt_tag = if cur + 1 < tcnt { sh_token_tag(tape, cur + 1) } else { "" };
        let is_cq = nxt_tag == "CallQuoteShallow" || nxt_tag == "CallQuoteDeep" || nxt_tag == "CallQuoteAbi" || nxt_tag == "CallQuoteSignal" || nxt_tag == "CallQuoteAdjoint" || nxt_tag == "CallQuoteEffect";
        if cur + 1 < tcnt && (nxt_tag == "LParen" || is_cq) {
            if !is_cq && sh_has_macro_name(ctx, text) {
                return sh_invoke_macro(arena, tape, ctx, text);
            }
            __engine("map_set", ctx, "pos", cur + 2);
            let call_nid = sh_ast_alloc_node(arena, "CallExpr", text);
            while true {
                let ap = __engine("map_get", ctx, "pos");
                if ap >= tcnt { break; }
                if sh_token_tag(tape, ap) == "RParen" {
                    __engine("map_set", ctx, "pos", ap + 1);
                    break;
                }
                let arg = sh_parse_expr_bp(arena, tape, ctx, 0);
                if arg >= 0 {
                    sh_ast_add_child(arena, call_nid, arg);
                }
                let cp = __engine("map_get", ctx, "pos");
                if cp < tcnt && sh_token_text(tape, cp) == "," {
                    __engine("map_set", ctx, "pos", cp + 1);
                } else if cp < tcnt && sh_token_tag(tape, cp) == "RParen" {
                    __engine("map_set", ctx, "pos", cp + 1);
                    break;
                } else if cp == ap {
                    __engine("map_set", ctx, "pos", cp + 1);
                }
            }
            return call_nid;
        }
        __engine("map_set", ctx, "pos", cur + 1);
        return sh_ast_alloc_node(arena, "IdentExpr", text);
    }

    if (tag == "Op" || tag == "CallQuoteShallow") && (text == "!" || text == "-") {
        __engine("map_set", ctx, "pos", cur + 1);
        let operand = sh_parse_expr_bp(arena, tape, ctx, 50);
        let nid = sh_ast_alloc_node(arena, "UnaryExpr", text);
        sh_ast_add_child(arena, nid, operand);
        return nid;
    }

    if tag == "LParen" {
        __engine("map_set", ctx, "pos", cur + 1);
        let inner = sh_parse_expr_bp(arena, tape, ctx, 0);
        let ncur = __engine("map_get", ctx, "pos");
        if ncur < tcnt && sh_token_tag(tape, ncur) == "RParen" {
            __engine("map_set", ctx, "pos", ncur + 1);
        }
        return inner;
    }

    if tag == "LBrace" {
        return sh_parse_block(arena, tape, ctx);
    }

    __engine("map_set", ctx, "pos", cur + 1);
    return -1;
}

fn sh_parse_expr_bp(arena: i64, tape: i64, ctx: i64, min_bp: i64) -> i64 {
    var lhs = sh_parse_primary(arena, tape, ctx);
    let tcnt = sh_token_count(tape);

    while true {
        let cur = __engine("map_get", ctx, "pos");
        if cur >= tcnt { break; }

        let tag = sh_token_tag(tape, cur);
        let op_text = sh_token_text(tape, cur);

        if tag == "Op" {
            if op_text == "->" && cur + 1 < tcnt && sh_token_tag(tape, cur + 1) == "LBrace" {
                __engine("map_set", ctx, "pos", cur + 2);
                let proj_nid = sh_ast_alloc_node(arena, "ArrowProjection", "->");
                sh_ast_add_child(arena, proj_nid, lhs);
                while __engine("map_get", ctx, "pos") < tcnt && sh_token_tag(tape, __engine("map_get", ctx, "pos")) != "RBrace" {
                    let fp = __engine("map_get", ctx, "pos");
                    let f_txt = sh_token_text(tape, fp);
                    if f_txt != "," {
                        let fnid = sh_ast_alloc_node(arena, "IdentExpr", f_txt);
                        sh_ast_add_child(arena, proj_nid, fnid);
                    }
                    __engine("map_set", ctx, "pos", fp + 1);
                }
                let rb_pos = __engine("map_get", ctx, "pos");
                if rb_pos < tcnt && sh_token_tag(tape, rb_pos) == "RBrace" { __engine("map_set", ctx, "pos", rb_pos + 1); }
                lhs = proj_nid;
                continue;
            }

            let bp = sh_get_precedence(op_text);
            if bp < min_bp || bp == 0 { break; }

            __engine("map_set", ctx, "pos", cur + 1);
            let rhs = sh_parse_expr_bp(arena, tape, ctx, bp + 1);
            let bin_nid = sh_ast_alloc_node(arena, "BinaryExpr", op_text);
            sh_ast_add_child(arena, bin_nid, lhs);
            sh_ast_add_child(arena, bin_nid, rhs);
            lhs = bin_nid;
        } else {
            break;
        }
    }

    return lhs;
}

fn sh_skip_optional_type_annot(tape: i64, ctx: i64) -> void {
    let tcnt = sh_token_count(tape);
    var p = __engine("map_get", ctx, "pos");
    if p < tcnt && sh_token_text(tape, p) == ":" {
        p = p + 1;
        var angle_d = 0;
        while p < tcnt {
            let txt = sh_token_text(tape, p);
            if txt == "<" { angle_d = angle_d + 1; }
            else if txt == ">" && angle_d > 0 { angle_d = angle_d - 1; }
            else if angle_d == 0 && (txt == "=" || txt == ";" || txt == "," || txt == ")") {
                break;
            }
            p = p + 1;
        }
        __engine("map_set", ctx, "pos", p);
    }
}

fn sh_parse_statement(arena: i64, tape: i64, ctx: i64) -> i64 {
    let cur = __engine("map_get", ctx, "pos");
    let tcnt = sh_token_count(tape);
    if cur >= tcnt { return -1; }

    let tag = sh_token_tag(tape, cur);
    let text = sh_token_text(tape, cur);

    // Block statement `{ ... }`
    if tag == "LBrace" {
        return sh_parse_block(arena, tape, ctx);
    }

    // `let name [: Type] = expr;` or `var name [: Type] = expr;`
    if (tag == "SeedKw" && text == nameof(let)) || (tag == "Ident" && text == "var") {
        let is_var = text == "var";
        var vpos = cur + 1;
        var vname = "";
        if vpos < tcnt && (sh_token_text(tape, vpos) == "{" || sh_token_text(tape, vpos) == "[" || sh_token_text(tape, vpos) == "(") {
            let close_tok = if sh_token_text(tape, vpos) == "{" { "}" } else if sh_token_text(tape, vpos) == "[" { "]" } else { ")" };
            var pat_str = sh_token_text(tape, vpos);
            vpos = vpos + 1;
            while vpos < tcnt && sh_token_text(tape, vpos) != close_tok {
                pat_str = pat_str + sh_token_text(tape, vpos);
                vpos = vpos + 1;
            }
            if vpos < tcnt {
                pat_str = pat_str + close_tok;
                vpos = vpos + 1;
            }
            vname = pat_str;
        } else if vpos < tcnt && sh_token_text(tape, vpos) == "$" && vpos + 1 < tcnt {
            vname = "$" + sh_token_text(tape, vpos + 1);
            vpos = vpos + 2;
        } else if vpos < tcnt {
            vname = sh_token_text(tape, vpos);
            vpos = vpos + 1;
        }
        __engine("map_set", ctx, "pos", vpos);
        sh_skip_optional_type_annot(tape, ctx);
        var eq_pos = __engine("map_get", ctx, "pos");
        var init_nid = -1;
        if eq_pos < tcnt && sh_token_text(tape, eq_pos) == "=" {
            __engine("map_set", ctx, "pos", eq_pos + 1);
            init_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
        }
        let end_p = __engine("map_get", ctx, "pos");
        if end_p < tcnt && sh_token_text(tape, end_p) == ";" {
            __engine("map_set", ctx, "pos", end_p + 1);
        }
        let bind_kind = if is_var { "VarStmt" } else { "LetStmt" };
        let bind_nid = sh_ast_alloc_node(arena, bind_kind, vname);
        if init_nid >= 0 {
            sh_ast_add_child(arena, bind_nid, init_nid);
        }
        return bind_nid;
    }

    // `if cond { ... } [else ...]`
    if text == "if" {
        __engine("map_set", ctx, "pos", cur + 1);
        let cond_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
        var then_nid = -1;
        let p_cur = __engine("map_get", ctx, "pos");
        if p_cur < tcnt && sh_token_tag(tape, p_cur) == "LBrace" {
            then_nid = sh_parse_block(arena, tape, ctx);
        }
        let if_nid = sh_ast_alloc_node(arena, "IfExpr", "");
        sh_ast_add_child(arena, if_nid, cond_nid);
        sh_ast_add_child(arena, if_nid, then_nid);
        let e_cur = __engine("map_get", ctx, "pos");
        if e_cur < tcnt && sh_token_text(tape, e_cur) == "else" {
            __engine("map_set", ctx, "pos", e_cur + 1);
            let after_else = __engine("map_get", ctx, "pos");
            let else_nid = if after_else < tcnt && sh_token_tag(tape, after_else) == "LBrace" {
                sh_parse_block(arena, tape, ctx)
            } else {
                sh_parse_statement(arena, tape, ctx)
            };
            if else_nid >= 0 {
                sh_ast_add_child(arena, if_nid, else_nid);
            }
        }
        return if_nid;
    }

    // `while cond { ... }`
    if tag == "Ident" && text == "while" {
        __engine("map_set", ctx, "pos", cur + 1);
        let w_cond = sh_parse_expr_bp(arena, tape, ctx, 0);
        let w_body = sh_parse_block(arena, tape, ctx);
        let w_nid = sh_ast_alloc_node(arena, "WhileStmt", "");
        sh_ast_add_child(arena, w_nid, w_cond);
        sh_ast_add_child(arena, w_nid, w_body);
        return w_nid;
    }

    // `loop { ... }`
    if tag == "SeedKw" && text == nameof(loop) {
        __engine("map_set", ctx, "pos", cur + 1);
        let l_body = sh_parse_block(arena, tape, ctx);
        let l_nid = sh_ast_alloc_node(arena, "LoopStmt", "");
        sh_ast_add_child(arena, l_nid, l_body);
        return l_nid;
    }

    // `return [expr];`
    if tag == "SeedKw" && text == nameof(return) {
        __engine("map_set", ctx, "pos", cur + 1);
        let ret_nid = sh_ast_alloc_node(arena, "ReturnStmt", "");
        let r_cur = __engine("map_get", ctx, "pos");
        if r_cur < tcnt && sh_token_text(tape, r_cur) != ";" && sh_token_tag(tape, r_cur) != "RBrace" {
            let val_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
            if val_nid >= 0 {
                sh_ast_add_child(arena, ret_nid, val_nid);
            }
        }
        let p_cur = __engine("map_get", ctx, "pos");
        if p_cur < tcnt && sh_token_text(tape, p_cur) == ";" {
            __engine("map_set", ctx, "pos", p_cur + 1);
        }
        return ret_nid;
    }

    // `yield [expr];`
    if (tag == "Ident" || tag == "SeedKw") && text == nameof(yield) {
        __engine("map_set", ctx, "pos", cur + 1);
        let y_nid = sh_ast_alloc_node(arena, "YieldStmt", "");
        let y_cur = __engine("map_get", ctx, "pos");
        if y_cur < tcnt && sh_token_text(tape, y_cur) != ";" && sh_token_tag(tape, y_cur) != "RBrace" {
            let val_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
            if val_nid >= 0 { sh_ast_add_child(arena, y_nid, val_nid); }
        }
        let py_cur = __engine("map_get", ctx, "pos");
        if py_cur < tcnt && sh_token_text(tape, py_cur) == ";" { __engine("map_set", ctx, "pos", py_cur + 1); }
        return y_nid;
    }

    // `break [expr];`
    if (tag == "Ident" || tag == "SeedKw") && text == "break" {
        __engine("map_set", ctx, "pos", cur + 1);
        let brk_nid = sh_ast_alloc_node(arena, "BreakStmt", "");
        let b_cur = __engine("map_get", ctx, "pos");
        if b_cur < tcnt && sh_token_text(tape, b_cur) != ";" && sh_token_tag(tape, b_cur) != "RBrace" {
            let val_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
            if val_nid >= 0 { sh_ast_add_child(arena, brk_nid, val_nid); }
        }
        let pb_cur = __engine("map_get", ctx, "pos");
        if pb_cur < tcnt && sh_token_text(tape, pb_cur) == ";" { __engine("map_set", ctx, "pos", pb_cur + 1); }
        return brk_nid;
    }

    // `continue [bounds];`
    if (tag == "Ident" || tag == "SeedKw") && text == "continue" {
        __engine("map_set", ctx, "pos", cur + 1);
        let cont_nid = sh_ast_alloc_node(arena, "ContinueStmt", "");
        let c_cur = __engine("map_get", ctx, "pos");
        if c_cur < tcnt && sh_token_text(tape, c_cur) != ";" && sh_token_tag(tape, c_cur) != "RBrace" {
            let val_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
            if val_nid >= 0 { sh_ast_add_child(arena, cont_nid, val_nid); }
        }
        let pc_cur = __engine("map_get", ctx, "pos");
        if pc_cur < tcnt && sh_token_text(tape, pc_cur) == ";" { __engine("map_set", ctx, "pos", pc_cur + 1); }
        return cont_nid;
    }

    // `context(...) { ... }` ambient contextual scope
    if tag == "Ident" && text == "context" && cur + 1 < tcnt && sh_token_tag(tape, cur + 1) == "LParen" {
        __engine("map_set", ctx, "pos", cur + 2);
        let ctx_nid = sh_ast_alloc_node(arena, "ContextScope", "");
        while __engine("map_get", ctx, "pos") < tcnt && sh_token_tag(tape, __engine("map_get", ctx, "pos")) != "RParen" {
            let p_pos = __engine("map_get", ctx, "pos");
            let b_var = sh_token_text(tape, p_pos);
            var next_p = p_pos + 1;
            if next_p < tcnt && sh_token_text(tape, next_p) == "=" {
                __engine("map_set", ctx, "pos", next_p + 1);
                let b_val = sh_parse_expr_bp(arena, tape, ctx, 0);
                let bind_node = sh_ast_alloc_node(arena, "ContextBinding", b_var);
                sh_ast_add_child(arena, bind_node, b_val);
                sh_ast_add_child(arena, ctx_nid, bind_node);
            } else {
                __engine("map_set", ctx, "pos", next_p);
            }
            let c_pos = __engine("map_get", ctx, "pos");
            if c_pos < tcnt && sh_token_text(tape, c_pos) == "," {
                __engine("map_set", ctx, "pos", c_pos + 1);
            }
        }
        let rp_pos = __engine("map_get", ctx, "pos");
        if rp_pos < tcnt && sh_token_tag(tape, rp_pos) == "RParen" {
            __engine("map_set", ctx, "pos", rp_pos + 1);
        }
        let body_nid = sh_parse_block(arena, tape, ctx);
        sh_ast_add_child(arena, ctx_nid, body_nid);
        return ctx_nid;
    }

    // `steal [from] Target [ [m1, m2, ...] ];`
    if tag == "Ident" && text == "steal" {
        __engine("map_set", ctx, "pos", cur + 1);
        let s_pos = __engine("map_get", ctx, "pos");
        if s_pos < tcnt && sh_token_text(tape, s_pos) == "from" {
            __engine("map_set", ctx, "pos", s_pos + 1);
        }
        let target_pos = __engine("map_get", ctx, "pos");
        let target_name = if target_pos < tcnt { sh_token_text(tape, target_pos) } else { "" };
        __engine("map_set", ctx, "pos", target_pos + 1);
        let steal_nid = sh_ast_alloc_node(arena, "StealDecl", target_name);
        let b_pos = __engine("map_get", ctx, "pos");
        if b_pos < tcnt && sh_token_tag(tape, b_pos) == "LBracket" {
            __engine("map_set", ctx, "pos", b_pos + 1);
            while __engine("map_get", ctx, "pos") < tcnt && sh_token_tag(tape, __engine("map_get", ctx, "pos")) != "RBracket" {
                let m_pos = __engine("map_get", ctx, "pos");
                let m_txt = sh_token_text(tape, m_pos);
                if m_txt != "," {
                    let m_node = sh_ast_alloc_node(arena, "IdentExpr", m_txt);
                    sh_ast_add_child(arena, steal_nid, m_node);
                }
                __engine("map_set", ctx, "pos", m_pos + 1);
            }
            let rb_pos = __engine("map_get", ctx, "pos");
            if rb_pos < tcnt && sh_token_tag(tape, rb_pos) == "RBracket" {
                __engine("map_set", ctx, "pos", rb_pos + 1);
            }
        }
        let end_p = __engine("map_get", ctx, "pos");
        if end_p < tcnt && sh_token_text(tape, end_p) == ";" {
            __engine("map_set", ctx, "pos", end_p + 1);
        }
        return steal_nid;
    }

    // Statement-position homoiconic macro invocation `<macro_name>(...);`
    if (tag == "Ident" || tag == "SeedKw") && cur + 1 < tcnt && sh_token_tag(tape, cur + 1) == "LParen" {
        if sh_has_macro_name(ctx, text) {
            let expanded = sh_invoke_macro(arena, tape, ctx, text);
            let m_after = __engine("map_get", ctx, "pos");
            if m_after < tcnt && sh_token_text(tape, m_after) == ";" {
                __engine("map_set", ctx, "pos", m_after + 1);
            }
            return expanded;
        }
    }

    // Assignment `lhs = rhs;` (including `$lhs = rhs;` inside `quote` templates)
    if (tag == "Ident" || tag == "SeedKw") && cur + 1 < tcnt && sh_token_text(tape, cur + 1) == "=" {
        let lhs_id = sh_ast_alloc_node(arena, "IdentExpr", text);
        __engine("map_set", ctx, "pos", cur + 2);
        let rhs_id = sh_parse_expr_bp(arena, tape, ctx, 0);
        let a_end = __engine("map_get", ctx, "pos");
        if a_end < tcnt && sh_token_text(tape, a_end) == ";" {
            __engine("map_set", ctx, "pos", a_end + 1);
        }
        let asg = sh_ast_alloc_node(arena, "AssignStmt", "=");
        sh_ast_add_child(arena, asg, lhs_id);
        sh_ast_add_child(arena, asg, rhs_id);
        return asg;
    }
    if tag == "Op" && text == "$" && cur + 2 < tcnt && sh_token_text(tape, cur + 2) == "=" {
        let sl_lhs = sh_ast_alloc_splice(arena, sh_token_text(tape, cur + 1), -1);
        __engine("map_set", ctx, "pos", cur + 3);
        let sl_rhs = sh_parse_expr_bp(arena, tape, ctx, 0);
        let sa_end = __engine("map_get", ctx, "pos");
        if sa_end < tcnt && sh_token_text(tape, sa_end) == ";" {
            __engine("map_set", ctx, "pos", sa_end + 1);
        }
        let s_asg = sh_ast_alloc_node(arena, "AssignStmt", "=");
        sh_ast_add_child(arena, s_asg, sl_lhs);
        sh_ast_add_child(arena, s_asg, sl_rhs);
        return s_asg;
    }

    // Default expression / hole statement (`$body`, `$*stmts`, `f(x);`, etc.)
    let e_nid = sh_parse_expr_bp(arena, tape, ctx, 0);
    let s_cur = __engine("map_get", ctx, "pos");
    if s_cur < tcnt && sh_token_text(tape, s_cur) == ";" {
        __engine("map_set", ctx, "pos", s_cur + 1);
    }
    return e_nid;
}

fn sh_parse_block(arena: i64, tape: i64, ctx: i64) -> i64 {
    let cur = __engine("map_get", ctx, "pos");
    let tcnt = sh_token_count(tape);
    if cur >= tcnt || sh_token_tag(tape, cur) != "LBrace" { return -1; }

    __engine("map_set", ctx, "pos", cur + 1);
    let block_nid = sh_ast_alloc_node(arena, "BlockExpr", "");

    while true {
        let p_cur = __engine("map_get", ctx, "pos");
        if p_cur >= tcnt { break; }
        if sh_token_tag(tape, p_cur) == "RBrace" {
            __engine("map_set", ctx, "pos", p_cur + 1);
            break;
        }
        let stmt_nid = sh_parse_statement(arena, tape, ctx);
        if stmt_nid >= 0 {
            let sk = sh_ast_kind_name(arena, stmt_nid);
            if sk == "SeqFragment" {
                let scnt = sh_ast_child_count(arena, stmt_nid);
                var si = 0;
                while si < scnt {
                    sh_ast_add_child(arena, block_nid, sh_ast_child_at(arena, stmt_nid, si));
                    si = si + 1;
                }
            } else {
                sh_ast_add_child(arena, block_nid, stmt_nid);
            }
        } else {
            break;
        }
    }

    return block_nid;
}

// ==============================================================================
// 3. Top-Level `syntax` Template Ingestion, Declarations & `sh_parse_program`
// ==============================================================================

fn sh_parse_syntax_decl(arena: i64, tape: i64, ctx: i64) -> void {
    let tcnt = sh_token_count(tape);
    var pos = __engine("map_get", ctx, "pos") + 1; // skip `syntax`
    if pos >= tcnt { return; }

    let m_name = sh_token_text(tape, pos);
    pos = pos + 1;

    let m_idx = __engine("map_get", ctx, "macro_count");
    __engine("map_set", ctx, "macro_count", m_idx + 1);
    __engine("map_set", ctx, "m_" + m_idx + "_name", m_name);

    var pcount = 0;
    var has_variadic = 0;

    if pos < tcnt && sh_token_tag(tape, pos) == "LParen" {
        pos = pos + 1;
        while pos < tcnt && sh_token_tag(tape, pos) != "RParen" {
            var is_var_p = 0;
            if sh_token_text(tape, pos) == "$" { pos = pos + 1; }
            if pos < tcnt && sh_token_text(tape, pos) == "*" {
                is_var_p = 1;
                has_variadic = 1;
                pos = pos + 1;
            }
            if pos < tcnt && sh_token_text(tape, pos) == "$" { pos = pos + 1; }
            if pos < tcnt && sh_token_tag(tape, pos) != "RParen" && sh_token_text(tape, pos) != "," {
                let p_name = sh_token_text(tape, pos);
                __engine("map_set", ctx, "m_" + m_idx + "_p_" + pcount, p_name);
                __engine("map_set", ctx, "m_" + m_idx + "_pvar_" + pcount, is_var_p);
                pcount = pcount + 1;
                pos = pos + 1;
                // Skip optional `: ast` / `: type` parameter annotation
                if pos < tcnt && sh_token_text(tape, pos) == ":" {
                    pos = pos + 1;
                    while pos < tcnt && sh_token_text(tape, pos) != "," && sh_token_tag(tape, pos) != "RParen" {
                        pos = pos + 1;
                    }
                }
            }
            if pos < tcnt && sh_token_text(tape, pos) == "," {
                pos = pos + 1;
            }
        }
        if pos < tcnt && sh_token_tag(tape, pos) == "RParen" {
            pos = pos + 1;
        }
    }

    __engine("map_set", ctx, "m_" + m_idx + "_pcount", pcount);
    __engine("map_set", ctx, "m_" + m_idx + "_variadic", has_variadic);

    if pos < tcnt && sh_token_text(tape, pos) == "=>" {
        pos = pos + 1;
    }
    if pos < tcnt && sh_token_text(tape, pos) == "quote" {
        pos = pos + 1;
    }
    __engine("map_set", ctx, "pos", pos);
    let tpl_nid = sh_parse_quote_template(arena, tape, ctx);
    __engine("map_set", ctx, "m_" + m_idx + "_tpl", tpl_nid);

    let after = __engine("map_get", ctx, "pos");
    if after < tcnt && sh_token_text(tape, after) == ";" {
        __engine("map_set", ctx, "pos", after + 1);
    }
}

fn sh_capture_fn_sig_tokens(tape: i64, start_idx: i64, end_idx: i64) -> str {
    var sig = "";
    var k = start_idx;
    while k < end_idx {
        let tk = sh_token_text(tape, k);
        if tk == "->" {
            sig = sig + " -> ";
        } else if tk == "," || tk == ":" {
            sig = sig + tk + " ";
        } else {
            sig = sig + tk;
        }
        k = k + 1;
    }
    return sig;
}

pub fn sh_parse_program(src: str) -> i64 {
    let arena = sh_ast_new();
    let root = sh_ast_alloc_node(arena, "Program", "");
    sh_ast_set_root(arena, root);

    let tape = sh_tokenize(src);
    let tcnt = sh_token_count(tape);
    let ctx = __engine("map_new");
    __engine("map_set", ctx, "pos", 0);
    __engine("map_set", ctx, "macro_count", 0);
    __engine("map_set", ctx, "const_count", 0);

    var pos = 0;
    var pending_async = 0;
    while pos < tcnt {
        __engine("map_set", ctx, "pos", pos);
        let tag = sh_token_tag(tape, pos);
        let text = sh_token_text(tape, pos);

        // Skip leading `[Attr(...)]` prefix via O(1) bracket mate
        if tag == "LBracket" {
            let mate = sh_token_matching_bracket(tape, pos);
            pos = if mate > pos { mate + 1 } else { pos + 1 };
        } else if text == "pub" || text == "priv" || text == "pure" || text == "static" || text == "noalloc" {
            pos = pos + 1;
        } else if text == "async" {
            pending_async = 1;
            pos = pos + 1;
        } else if text == "syntax" {
            sh_parse_syntax_decl(arena, tape, ctx);
            pos = __engine("map_get", ctx, "pos");
        } else if text == "const" && pos + 3 < tcnt && sh_token_text(tape, pos + 2) == "=" {
            let cname = sh_token_text(tape, pos + 1);
            __engine("map_set", ctx, "pos", pos + 3);
            let cexpr = sh_parse_expr_bp(arena, tape, ctx, 0);
            let cval = sh_ast_eval_const_expr(arena, cexpr, -1);
            let cidx = __engine("map_get", ctx, "const_count");
            __engine("map_set", ctx, "c_" + cidx + "_name", cname);
            __engine("map_set", ctx, "c_" + cidx + "_val", cval);
            __engine("map_set", ctx, "const_count", cidx + 1);
            var c_after = __engine("map_get", ctx, "pos");
            if c_after < tcnt && sh_token_text(tape, c_after) == ";" {
                c_after = c_after + 1;
            }
            pos = c_after;
        } else if text == nameof(struct) || text == nameof(interface) {
            let decl_k = if text == nameof(struct) { "StructDecl" } else { "InterfaceDecl" };
            pos = pos + 1;
            let d_name = if pos < tcnt { sh_token_text(tape, pos) } else { "" };
            let d_nid = sh_ast_alloc_node(arena, decl_k, d_name);
            sh_ast_add_child(arena, root, d_nid);
            while pos < tcnt && sh_token_tag(tape, pos) != "LBrace" && sh_token_text(tape, pos) != ";" {
                pos = pos + 1;
            }
            if pos < tcnt && sh_token_tag(tape, pos) == "LBrace" {
                let mate_b = sh_token_matching_bracket(tape, pos);
                pos = if mate_b > pos { mate_b + 1 } else { pos + 1 };
            } else if pos < tcnt {
                pos = pos + 1;
            }
        } else if text == "adapter" {
            pos = pos + 1;
            let from_t = if pos < tcnt { sh_token_text(tape, pos) } else { "" };
            pos = pos + 1;
            if pos < tcnt && sh_token_text(tape, pos) == "->" { pos = pos + 1; }
            let to_t = if pos < tcnt { sh_token_text(tape, pos) } else { "" };
            pos = pos + 1;
            let ad_nid = sh_ast_alloc_node(arena, "AdapterDecl", from_t + "->" + to_t);
            sh_ast_add_child(arena, root, ad_nid);
            if pos < tcnt && sh_token_tag(tape, pos) == "LBrace" {
                __engine("map_set", ctx, "pos", pos);
                let body_nid = sh_parse_block(arena, tape, ctx);
                sh_ast_add_child(arena, ad_nid, body_nid);
                pos = __engine("map_get", ctx, "pos");
            }
        } else if text == nameof(fn) {
            pos = pos + 1;
            let fn_name = if pos < tcnt { sh_token_text(tape, pos) } else { "" };
            pos = pos + 1;
            let sig_start = pos;
            let fn_nid = sh_ast_alloc_node(arena, "FnDecl", fn_name);
            if pending_async == 1 {
                sh_ast_set_flags(arena, fn_nid, 64);
                pending_async = 0;
            }
            sh_ast_add_child(arena, root, fn_nid);

            while pos < tcnt && sh_token_tag(tape, pos) != "LBrace" {
                pos = pos + 1;
            }
            __engine("map_set", arena, fn_nid + "_sig", sh_capture_fn_sig_tokens(tape, sig_start, pos));
            __engine("map_set", ctx, "pos", pos);
            let body_nid = sh_parse_block(arena, tape, ctx);
            sh_ast_add_child(arena, fn_nid, body_nid);
            pos = __engine("map_get", ctx, "pos");
        } else {
            let top_stmt = sh_parse_statement(arena, tape, ctx);
            if top_stmt >= 0 {
                let tk = sh_ast_kind_name(arena, top_stmt);
                if tk == "SeqFragment" {
                    let sc = sh_ast_child_count(arena, top_stmt);
                    var si = 0;
                    while si < sc {
                        sh_ast_add_child(arena, root, sh_ast_child_at(arena, top_stmt, si));
                        si = si + 1;
                    }
                } else {
                    sh_ast_add_child(arena, root, top_stmt);
                }
            }
            let next_p = __engine("map_get", ctx, "pos");
            pos = if next_p > pos { next_p } else { pos + 1 };
        }
    }

    return arena;
}

// ==============================================================================
// 4. Homoiconic Quoting, Splicing & Syntax Overload Dispatch Entrypoints
// ==============================================================================

pub fn sh_expand_quote_splice(arena: i64, parent: i64, slot_name: str, node: i64) -> void {
    let nid = sh_ast_alloc_splice(arena, slot_name, node);
    sh_ast_add_child(arena, parent, nid);
}

pub fn sh_expand_quote_splat(arena: i64, parent: i64, slot_name: str, nodes: i64) -> void {
    let nid = sh_ast_alloc_splat(arena, slot_name, nodes);
    sh_ast_add_child(arena, parent, nid);
}

pub fn sh_expand_quote_unquote(arena: i64, parent: i64, expr_nid: i64) -> void {
    let nid = sh_ast_alloc_unquote(arena, expr_nid);
    sh_ast_add_child(arena, parent, nid);
}

pub fn sh_select_syntax_overload(arena: i64, arm_list: i64, arg_count: i64) -> i64 {
    let cnt = sh_ast_child_count(arena, arm_list);
    var i = 0;
    while i < cnt {
        let arm = sh_ast_child_at(arena, arm_list, i);
        if sh_ast_match_syntax_arm(arena, arm, arg_count) {
            return arm;
        }
        i = i + 1;
    }
    return -1;
}
