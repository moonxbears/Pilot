pub pkg Pilot.SelfHost.Parser;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

extern "c" {
    fn strlen(s: str) -> i64;
}

// Operator Precedence Levels
pub const PREC_NONE: i64 = 0;
pub const PREC_ASSIGN: i64 = 1;
pub const PREC_OR: i64 = 2;
pub const PREC_AND: i64 = 3;
pub const PREC_EQUALITY: i64 = 4;
pub const PREC_COMPARISON: i64 = 5;
pub const PREC_TERM: i64 = 6;
pub const PREC_FACTOR: i64 = 7;
pub const PREC_UNARY: i64 = 8;
pub const PREC_CALL: i64 = 9;

pub fn get_binary_precedence(tok_kind: i64) -> i64 {
    if tok_kind == 12 || tok_kind == 13 || tok_kind == 14 { return PREC_FACTOR; } // *, /, %
    if tok_kind == 10 || tok_kind == 11 { return PREC_TERM; }                     // +, -
    if tok_kind >= 18 && tok_kind <= 21 { return PREC_COMPARISON; }               // <, <=, >, >=
    if tok_kind == 16 || tok_kind == 17 { return PREC_EQUALITY; }                 // ==, !=
    return PREC_NONE;
}

pub fn parse_literal_int(s: str) -> i64 {
    var val: i64 = 0;
    var i: i64 = 0;
    let total_len: i64 = strlen(s);
    while i < total_len {
        let c: i64 = s.char_code_at(i);
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48);
        }
        i = i + 1;
    }
    return val;
}

[Layout(c_abi)]
pub struct AttributedDeclNode : IValue {
    pub attributes: str;
    pub decl_src:   str;
    pub kind:       i64;

    pub static pure fn create(attributes: str, decl_src: str, kind: i64) -> AttributedDeclNode => AttributedDeclNode {
        attributes: attributes,
        decl_src:   decl_src,
        kind:       kind,
    };
}

pub pure fn is_attributed_declaration(src: str) -> bool {
    let trimmed = src.trim();
    if !trimmed.starts_with("[") {
        return false;
    }
    let rest = Pilot.SelfHost.ScopeHeader.strip_attributes_prefix(trimmed);
    return rest != "";
}

pub pure fn parse_attributed_declaration(src: str) -> AttributedDeclNode {
    let trimmed = src.trim();
    let attrs = Pilot.SelfHost.ScopeHeader.extract_attributes_prefix(trimmed);
    let decl = Pilot.SelfHost.ScopeHeader.strip_attributes_prefix(trimmed);
    return AttributedDeclNode.create(attrs, decl, Pilot.SelfHost.Ast.NODE_ATTRIBUTED_DECL);
}

pub struct SelfHostParser : IObject {
    pub scope_stack: Pilot.SelfHost.ScopeHeader.ScopeHeaderStack;

    ~self() {}

    pub static fn create() -> SelfHostParser => SelfHostParser {
        scope_stack: Pilot.SelfHost.ScopeHeader.ScopeHeaderStack.create(),
    };

    pub fn push_header(header: Pilot.SelfHost.ScopeHeader.ScopeHeader) -> void {
        self.scope_stack.push(header);
    }

    pub fn pop_header() -> Pilot.SelfHost.ScopeHeader.ScopeHeader {
        return self.scope_stack.pop();
    }

    pub fn current_header() -> Pilot.SelfHost.ScopeHeader.ScopeHeader {
        return self.scope_stack.current();
    }

    pub fn parse_declaration_with_scope(src: str) -> AttributedDeclNode {
        let local = parse_attributed_declaration(src);
        let active_hdr = self.current_header();
        let merged_attrs = Pilot.SelfHost.ScopeHeader.merge_attributes(active_hdr.attributes, local.attributes);
        return AttributedDeclNode.create(merged_attrs, local.decl_src, local.kind);
    }
}
