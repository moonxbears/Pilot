pub pkg Pilot.SelfHost.Parser;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

pub pure fn nameof(sym: str) -> str => sym;

// Operator Precedence Levels (AGENTS.md §5.1: Cascade = 1)
pub const PREC_NONE: i64 = 0;
pub const PREC_CASCADE: i64 = 1;
pub const PREC_ASSIGN: i64 = 2;
pub const PREC_OR: i64 = 3;
pub const PREC_AND: i64 = 4;
pub const PREC_EQUALITY: i64 = 5;
pub const PREC_COMPARISON: i64 = 6;
pub const PREC_TERM: i64 = 7;
pub const PREC_FACTOR: i64 = 8;
pub const PREC_UNARY: i64 = 9;
pub const PREC_CALL: i64 = 10;

pub pure fn get_binary_precedence(tok_kind: i64) -> i64 {
    if tok_kind == 12 || tok_kind == 13 || tok_kind == 14 { return 8; }
    if tok_kind == 10 || tok_kind == 11 { return 7; }
    if tok_kind >= 18 && tok_kind <= 21 { return 6; }
    if tok_kind == 16 || tok_kind == 17 { return 5; }
    return 0;
}

pub fn parse_literal_int(s: str) -> i64 {
    var val: i64 = 0;
    var i: i64 = 0;
    let total_len: i64 = __engine("str_len", s);
    while i < total_len {
        let c: i64 = __engine("str_byte_at", s, i);
        if c >= 48 && c <= 57 {
            val = val * 10 + (c - 48);
        }
        i = i + 1;
    }
    return val;
}

pub pure fn expand_homoiconic_quote_template(macro_name: str, spliced_arg: str) -> str {
    return "/* expanded syntax " + macro_name + " via " + nameof(quote) + " */ " + spliced_arg;
}

[Layout(c_abi)]
pub struct AttributedDeclNode : IValue {
    pub attributes: str;
    pub decl_src:   str;
    pub kind:       i64;

    pub static pure fn create(attributes: str, decl_src: str, kind: i64) -> AttributedDeclNode => AttributedDeclNode {
        attributes: attributes,
        decl_src:   decl_src,
        kind:       kind,
    };
}

pub pure fn is_attributed_declaration(src: str) -> bool {
    let trimmed = src.trim();
    if !trimmed.starts_with("[") {
        return false;
    }
    let rest = Pilot.Core.Syntax.ScopeHeader.strip_attributes_prefix(trimmed);
    return rest != "";
}

pub pure fn parse_attributed_declaration(src: str) -> AttributedDeclNode {
    let trimmed = src.trim();
    let attrs = Pilot.Core.Syntax.ScopeHeader.extract_attributes_prefix(trimmed);
    let decl = Pilot.Core.Syntax.ScopeHeader.strip_attributes_prefix(trimmed);
    return AttributedDeclNode.create(attrs, decl, Pilot.SelfHost.Ast.NODE_ATTRIBUTED_DECL);
}

pub struct SelfHostParser : IObject {
    pub scope_stack: Pilot.Core.Syntax.ScopeHeader.ScopeHeaderStack;

    ~self() {}

    pub static fn create() -> SelfHostParser => SelfHostParser {
        scope_stack: Pilot.Core.Syntax.ScopeHeader.ScopeHeaderStack.create(),
    };

    pub fn push_header(header: Pilot.Core.Syntax.ScopeHeader.ScopeHeader) -> void {
        self.scope_stack.push(header);
    }

    pub fn pop_header() -> Pilot.Core.Syntax.ScopeHeader.ScopeHeader {
        return self.scope_stack.pop();
    }

    pub fn current_header() -> Pilot.Core.Syntax.ScopeHeader.ScopeHeader {
        return self.scope_stack.current();
    }

    pub fn parse_declaration_with_scope(src: str) -> AttributedDeclNode {
        let local = parse_attributed_declaration(src);
        let active_hdr = self.current_header();
        let merged_attrs = Pilot.Core.Syntax.ScopeHeader.merge_attributes(active_hdr.attributes, local.attributes);
        return AttributedDeclNode.create(merged_attrs, local.decl_src, local.kind);
    }
}
