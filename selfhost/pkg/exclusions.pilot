// =========================================================================
// FILE: selfhost/pkg/exclusions.pilot
// Package `without` exclusions in the manifest.
// Used by selfhost/cli/pkg_cmd.pilot, which only the milestone03 Rust test
// reaches; `pilot pkg` has no handler (seam cli.command_handler).
// =========================================================================
pub pkg selfhost.pkg;

fn e_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if haystack.slice(i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

fn e_trim(s: str) -> str {
    let l = s.len();
    if l == 0 { return s; }
    var start = 0;
    while start < l {
        let b = s.byte_at(start);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; }
        start = start + 1;
    }
    var end = l;
    while end > start {
        let b = s.byte_at(end - 1);
        if b != 32 && b != 9 && b != 10 && b != 13 { break; }
        end = end - 1;
    }
    return s.slice(start, end);
}

// -------------------------------------------------------------------------
// 1. MANIFEST-LEVEL PACKAGE EXCLUSIONS (pilot.json)
// -------------------------------------------------------------------------

pub fn add_exclusion_to_manifest_json(json_src: str, pattern: str) -> str {
    var src = json_src;
    let target_key = "\"exclude\":";

    if e_find(src, target_key, 0) < 0 {
        var last_b = src.len() - 1;
        while last_b >= 0 {
            if src.slice(last_b, last_b + 1) == "}" { break; }
            last_b = last_b - 1;
        }
        if last_b < 0 { return src; }
        src = e_trim(src.slice(0, last_b)) + ",\n  \"exclude\": [\n    \"" + pattern + "\"\n  ]\n}";
        return src;
    }

    let idx = e_find(src, target_key, 0);
    let b_open = e_find(src, "[", idx);
    if b_open < 0 { return src; }
    let b_close = e_find(src, "]", b_open);
    if b_close < 0 { return src; }

    let inner = e_trim(src.slice(b_open + 1, b_close));
    // If pattern already exists, return unchanged
    if e_find(inner, "\"" + pattern + "\"", 0) >= 0 {
        return src;
    }

    var new_block = "";
    if inner.len() == 0 {
        new_block = "[\n    \"" + pattern + "\"\n  ]";
    } else {
        new_block = "[\n    " + inner + ",\n    \"" + pattern + "\"\n  ]";
    }

    return src.slice(0, b_open) + new_block + src.slice(b_close + 1, src.len());
}

pub fn remove_exclusion_from_manifest_json(json_src: str, pattern: str) -> str {
    let pat_str = "\"" + pattern + "\"";
    let p_pos = e_find(json_src, pat_str, 0);
    if p_pos < 0 { return json_src; }

    var e_pos = e_find(json_src, "\n", p_pos);
    if e_pos < 0 { e_pos = json_src.len(); }
    else if e_pos < json_src.len() { e_pos = e_pos + 1; }

    var s_pos = p_pos;
    while s_pos > 0 {
        let b = json_src.byte_at(s_pos - 1);
        if b == 10 || b == 13 { break; }
        s_pos = s_pos - 1;
    }

    var out = json_src.slice(0, s_pos) + json_src.slice(e_pos, json_src.len());
    let tc = e_find(out, ",\n  ]", 0);
    if tc >= 0 {
        out = out.slice(0, tc) + "\n  ]" + out.slice(tc + 5, out.len());
    }
    return out;
}

pub fn list_exclusions_summary(json_src: str) -> str {
    let ex_idx = e_find(json_src, "\"exclude\":", 0);
    if ex_idx < 0 {
        return "No package exclusions defined in pilot.json.\n";
    }
    let b_open = e_find(json_src, "[", ex_idx + 10);
    if b_open < 0 { return "No package exclusions defined in pilot.json.\n"; }
    let b_close = e_find(json_src, "]", b_open + 1);
    if b_close < 0 { return "No package exclusions defined in pilot.json.\n"; }

    var count = 0;
    var out = "Configured Package Exclusions:\n";
    var p = b_open + 1;
    while p < b_close {
        let q1 = e_find(json_src, "\"", p);
        if q1 < 0 || q1 >= b_close { break; }
        let q2 = e_find(json_src, "\"", q1 + 1);
        if q2 < 0 || q2 >= b_close { break; }
        let pattern = json_src.slice(q1 + 1, q2);
        count = count + 1;
        out = out + "  - " + pattern + "\n";
        p = q2 + 1;
    }

    if count == 0 {
        return "No package exclusions defined in pilot.json.\n";
    }
    return out + "Total: " + count + " exclusions active.\n";
}

// -------------------------------------------------------------------------
// 2. POST-DEFINITION MEMBER & SYMBOL EXCLUSIONS ('without')
// -------------------------------------------------------------------------

/// One `without` exclusion: `member` removed from `target`, or from every
/// target when `target` is `*` (the bare `without member;` form).
pub struct MemberExclusion {
    pub target: str;
    pub member: str;
}

/// The `without` exclusions of a source text, in source order, plus a
/// lookup keyed by `target::member`.
pub struct SourceExclusions : IObject {
    pub items: List<MemberExclusion>;
    pub keys: Map<str, bool>;
}

fn add_member_exclusion(var ref ex: SourceExclusions, target: str, member: str) {
    ex.items.push(MemberExclusion { target: target, member: member });
    ex.keys.set(target + "::" + member, true);
}

pub fn parse_source_exclusions(src: str) -> SourceExclusions {
    var ex = SourceExclusions { items: [], keys: Map<str, bool>() };
    let w_kw = nameof(without) + " ";

    var p = 0;
    let total_len = src.len();
    while p < total_len {
        let w_idx = e_find(src, w_kw, p);
        if w_idx < 0 { break; }

        let after_w = src.slice(w_idx + w_kw.len(), total_len);
        let b_open = e_find(after_w, "{", 0);
        let semi_pos = e_find(after_w, ";", 0);

        // Case A: Block form: without Target { member1, member2 };
        if b_open >= 0 && (semi_pos < 0 || b_open < semi_pos) {
            let target_name = e_trim(after_w.slice(0, b_open));
            let b_close = e_find(after_w, "}", b_open + 1);
            if b_close >= 0 {
                let inner = after_w.slice(b_open + 1, b_close);
                var ip = 0;
                let ilen = inner.len();
                while ip < ilen {
                    let inxt = e_find(inner, ",", ip);
                    let e_idx = if inxt >= 0 { inxt } else { ilen };
                    var mem = e_trim(inner.slice(ip, e_idx));
                    let sm = e_find(mem, ";", 0);
                    if sm >= 0 { mem = e_trim(mem.slice(0, sm)); }
                    if mem.len() > 0 { add_member_exclusion(ex, target_name, mem); }
                    ip = e_idx + 1;
                }
                p = w_idx + w_kw.len() + b_close + 1;
                continue;
            }
        }

        // Case B: Dot form: without Target.member; or bare without member;
        if semi_pos >= 0 {
            let stmt = e_trim(after_w.slice(0, semi_pos));
            let dot_pos = e_find(stmt, ".", 0);
            if dot_pos >= 0 {
                let target_name = e_trim(stmt.slice(0, dot_pos));
                let mem = e_trim(stmt.slice(dot_pos + 1, stmt.len()));
                if target_name.len() > 0 && mem.len() > 0 { add_member_exclusion(ex, target_name, mem); }
            } else if stmt.len() > 0 {
                add_member_exclusion(ex, "*", stmt);
            }
            p = w_idx + w_kw.len() + semi_pos + 1;
            continue;
        }

        p = w_idx + w_kw.len();
    }
    return ex;
}

/// Whether `member_name` is excluded from `target_name`: by name, by the
/// bare form (`*`), or by a block with no target name.
pub fn is_member_excluded(ref ex: SourceExclusions, target_name: str, member_name: str) -> bool {
    return ex.keys.has(target_name + "::" + member_name)
        || ex.keys.has("*::" + member_name)
        || ex.keys.has("::" + member_name);
}

pub fn format_exclusions_report(ref ex: SourceExclusions) -> str {
    if ex.items.len() == 0 {
        return "No post-definition symbol exclusions ('without') detected.\n";
    }
    var out = "Post-Definition Member Exclusions ('without'):\n";
    for item in ex.items {
        out = out + "  - " + item.target + " " + nameof(without) + " {" + item.member + "}\n";
    }
    return out + "Total: " + ex.items.len() + " symbols excluded.\n";
}
