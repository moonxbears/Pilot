// =========================================================================
// FILE: selfhost/pkg/resolver.pilot
// Milestone 60.7: Advanced Pilot Package Dependency & Version Resolver
// Conforms to the Strict Universal Name-Blind Boundary.
// =========================================================================
pub pkg selfhost.pkg;

fn pad_right(s: str, width: i64) -> str {
    var r = s;
    while r.len() < width {
        r = r + " ";
    }
    return r;
}

pub fn get_default_candidates(dep_name: str) -> str {
    if dep_name == "Pilot.Math" {
        return "1.0.0, 1.1.0, 1.2.0, 1.2.5, 2.0.0";
    }
    if dep_name == "Pilot.Crypto" {
        return "0.7.0, 0.8.0, 0.8.4, 0.9.0";
    }
    if dep_name == "Pilot.Json" {
        return "0.3.0, 0.4.0, 0.4.1, 0.5.0";
    }
    if dep_name == "Pilot.Testing" {
        return "1.0.0, 1.0.1, 1.1.0";
    }
    if dep_name == "Pilot.Net" {
        return "1.9.0, 2.0.0, 2.1.0, 2.2.0";
    }
    // Default fallback semantic progression:
    return "0.1.0, 0.2.0, 1.0.0, 1.1.0, 1.2.0";
}

/// How a dependency entered the resolution.
pub enum DepKind {
    Prod,
    Dev,
    Excluded,
}

/// The lockfile `type` text of `kind` (lockfile data, not a Pilot name).
pub pure fn dep_kind_text(kind: DepKind) -> str {
    if kind == DepKind::Dev { return "dev"; }
    if kind == DepKind::Excluded { return "excluded"; }
    return "prod";
}

/// A dependency with the version picked for it (`-` when excluded).
pub struct ResolvedDep {
    pub name: str;
    pub req: str;
    pub ver: str;
    pub kind: DepKind;
}

/// A dependency no candidate version satisfies.
pub struct DepConflict {
    pub name: str;
    pub req: str;
    pub reason: str;
}

/// The outcome of resolving a manifest: every resolved or excluded
/// dependency, in manifest order (production first), and every conflict.
pub struct DepResolution : IObject {
    pub resolved: List<ResolvedDep>;
    pub conflicts: List<DepConflict>;
}

/// Whether every dependency resolved.
pub pure fn resolution_succeeded(ref r: DepResolution) -> bool => r.conflicts.len() == 0;

fn resolve_one(var ref r: DepResolution, ref mf: PkgManifest, name: str, req: str, kind: DepKind) {
    if is_import_excluded(mf, name) {
        r.resolved.push(ResolvedDep { name: name, req: req, ver: "-", kind: DepKind::Excluded });
        return;
    }
    let candidates = get_default_candidates(name);
    let best_ver = resolve_highest_compatible_version(candidates, req);
    if best_ver.len() > 0 {
        r.resolved.push(ResolvedDep { name: name, req: req, ver: best_ver, kind: kind });
    } else {
        r.conflicts.push(DepConflict {
            name: name,
            req: req,
            reason: "No candidate version in [" + candidates + "] satisfies requirement '" + req + "'",
        });
    }
}

pub fn resolve_package_dependencies(manifest_json: str) -> DepResolution {
    let mf = parse_manifest_json(manifest_json);
    var r = DepResolution { resolved: [], conflicts: [] };
    for d in mf.deps { resolve_one(r, mf, d.name, d.version, DepKind::Prod); }
    for d in mf.dev_deps { resolve_one(r, mf, d.name, d.version, DepKind::Dev); }
    return r;
}

pub fn format_resolution_summary(ref r: DepResolution) -> str {
    var out = pad_right("Package", 22) + pad_right("Requirement", 16) + pad_right("Resolved", 14) + "Status\n";
    out = out + "─────────────────────────────────────────────────────────────\n";

    for d in r.resolved {
        let status = if d.kind == DepKind::Excluded { "[Excluded]" } else if d.kind == DepKind::Dev { "[Dev]" } else { "[Resolved]" };
        out = out + pad_right(d.name, 22) + pad_right(d.req, 16) + pad_right(d.ver, 14) + status + "\n";
    }

    if r.conflicts.len() > 0 {
        out = out + "\nVersion Conflicts Detected:\n";
        for c in r.conflicts {
            out = out + "  ✕ " + c.name + " (" + c.req + "): " + c.reason + "\n";
        }
    }

    out = out + "─────────────────────────────────────────────────────────────\n";
    return out + r.resolved.len() + " packages resolved (" + r.conflicts.len() + " conflicts).\n";
}

pub fn generate_resolved_lockfile_json(pkg_name: str, pkg_ver: str, ref r: DepResolution) -> str {
    var json = "{\n" +
               "  \"lockfileVersion\": 3,\n" +
               "  \"name\": \"" + pkg_name + "\",\n" +
               "  \"version\": \"" + pkg_ver + "\",\n" +
               "  \"packages\": {\n";

    let n = r.resolved.len();
    var i = 0;
    for d in r.resolved {
        i = i + 1;
        if d.kind == DepKind::Excluded { continue; }
        let comma = if i < n { "," } else { "" };
        json = json + "    \"" + d.name + "\": {\n" +
               "      \"version\": \"" + d.ver + "\",\n" +
               "      \"requirement\": \"" + d.req + "\",\n" +
               "      \"type\": \"" + dep_kind_text(d.kind) + "\"\n" +
               "    }" + comma + "\n";
    }

    json = json + "  }\n" +
           "}\n";
    return json;
}

/// Why `target_pkg` is in the dependency graph of the package `root`
/// describes. Takes the resolution and the manifest by value: the text
/// returned then borrows from neither, so the caller may return it
/// (ESCAPE002).
pub fn explain_package_resolution(r: DepResolution, target_pkg: str, root: PkgManifest) -> str {
    let root_pkg = root.name;
    for d in r.resolved {
        if d.name != target_pkg { continue; }
        if d.kind == DepKind::Excluded {
            return target_pkg + " [EXCLUDED]\n" +
                   "└── " + root_pkg + " (root)\n" +
                   "    └── excluded by manifest 'exclude' rule: " + target_pkg + " (" + d.req + ")\n";
        }
        let kind_tag = if d.kind == DepKind::Dev { " (devDependency)" } else { " (dependency)" };
        return target_pkg + " " + d.ver + "\n" +
               "└── " + root_pkg + " (root)\n" +
               "    └── requires: " + target_pkg + " " + d.req + kind_tag + "\n";
    }
    return "Package '" + target_pkg + "' is not present in the dependency graph of '" + root_pkg + "'.\n";
}
