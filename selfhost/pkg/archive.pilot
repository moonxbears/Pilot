// =========================================================================
// FILE: selfhost/pkg/archive.pilot
// Milestone 60.1: .pilpkg Deterministic Package Archive Header & Entry Codec
// =========================================================================
pub pkg Pilot.SelfHost.Pkg.Archive;

pub pure fn nameof(sym: str) -> str => sym;

pub enum ArchiveFormat {
    PilPkgV1,
}

pub pure fn archive_format_header(fmt: ArchiveFormat) -> str {
    if fmt == ::PilPkgV1 {
        return "PILPKG1:";
    }
    return "PILPKG1:";
}

pub pure fn archive_detect_format(archive_blob: str) -> ArchiveFormat {
    let p = ar_find(archive_blob, "PILPKG1:", 0);
    if p == 0 {
        return ::PilPkgV1;
    }
    return ::PilPkgV1;
}

fn ar_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if haystack.slice(i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

fn ar_parse_int(s: str) -> i64 {
    let n = s.len();
    var v = 0;
    var i = 0;
    while i < n {
        let b = s.byte_at(i);
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48);
            i = i + 1;
        } else {
            break;
        }
    }
    return v;
}

pub fn pilpkg_new() -> i64 {
    let ar = __engine("map_new");
    let _s = __engine("map_set", ar, "count", 0);
    return ar;
}

pub fn pilpkg_add_file(ar: i64, rel_path: str, content: str) -> i64 {
    let raw_cnt = __engine("map_get", ar, "count");
    let cnt = if raw_cnt != none { raw_cnt } else { 0 };
    let _p = __engine("map_set", ar, "path:" + cnt, rel_path);
    let _c = __engine("map_set", ar, "content:" + cnt, content);
    let _cnt = __engine("map_set", ar, "count", cnt + 1);
    return cnt + 1;
}

pub fn pilpkg_serialize(ar: i64) -> str {
    let raw_cnt = __engine("map_get", ar, "count");
    let cnt = if raw_cnt != none { raw_cnt } else { 0 };
    let hdr = archive_format_header(::PilPkgV1);
    var out = hdr + cnt + "\n";
    var i = 0;
    while i < cnt {
        let path = __engine("map_get", ar, "path:" + i);
        let content = __engine("map_get", ar, "content:" + i);
        let clen = content.len();
        out = out + path + ":" + clen + "\n" + content + "\n";
        i = i + 1;
    }
    return out;
}

pub fn pilpkg_file_count(archive_blob: str) -> i64 {
    let fmt = archive_detect_format(archive_blob);
    let hdr = archive_format_header(fmt);
    let p = ar_find(archive_blob, hdr, 0);
    if p != 0 {
        return 0;
    }
    let hlen = hdr.len();
    let nl = ar_find(archive_blob, "\n", hlen);
    if nl < 0 { return 0; }
    let cnt_str = archive_blob.slice(hlen, nl);
    return ar_parse_int(cnt_str);
}

pub fn pilpkg_extract_file(archive_blob: str, rel_path: str) -> str {
    let fmt = archive_detect_format(archive_blob);
    let hdr = archive_format_header(fmt);
    let p = ar_find(archive_blob, hdr, 0);
    if p != 0 {
        return "";
    }
    let total_len = archive_blob.len();
    let hdr_nl = ar_find(archive_blob, "\n", 0);
    if hdr_nl < 0 { return ""; }
    var pos = hdr_nl + 1;
    while pos < total_len {
        let line_end = ar_find(archive_blob, "\n", pos);
        if line_end < 0 { break; }
        let meta = archive_blob.slice(pos, line_end);
        let col = ar_find(meta, ":", 0);
        if col < 0 { break; }
        let path = meta.slice(0, col);
        let len_str = meta.slice(col + 1, meta.len());
        let clen = ar_parse_int(len_str);
        let c_start = line_end + 1;
        let c_end = c_start + clen;
        if c_end > total_len { break; }
        if path == rel_path {
            return archive_blob.slice(c_start, c_end);
        }
        pos = c_end + 1; // skip trailing newline
    }
    return "";
}
