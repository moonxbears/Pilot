// =========================================================================
// FILE: selfhost/pkg/archive.pilot
// .pilpkg archive header and entry encoding.
// Reached only by the milestone60 Rust test; no `pilot` command runs it.
// =========================================================================
pub pkg selfhost.pkg;

/// The header every `.pilpkg` v1 blob starts with, followed by the file
/// count and a newline.
pub const PILPKG_V1_HEADER: str = "PILPKG1:";

/// One file packed into an archive: its path relative to the package root
/// and its full text.
pub struct PkgArchiveEntry {
    pub path: str;
    pub content: str;
}

/// An archive being built, files in the order they were added.
pub struct PkgArchive : IObject {
    pub entries: List<PkgArchiveEntry>;
}

pure fn ar_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if haystack.slice(i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

fn ar_parse_int(s: str) -> i64 {
    let n = s.len();
    var v = 0;
    var i = 0;
    while i < n {
        let b = s.byte_at(i);
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48);
            i = i + 1;
        } else {
            break;
        }
    }
    return v;
}

pub fn pilpkg_new() -> PkgArchive => PkgArchive { entries: [] };

/// Adds a file and returns how many files the archive now holds.
pub fn pilpkg_add_file(var ref ar: PkgArchive, rel_path: str, content: str) -> i64 {
    ar.entries.push(PkgArchiveEntry { path: rel_path, content: content });
    return ar.entries.len();
}

pub fn pilpkg_serialize(ref ar: PkgArchive) -> str {
    var out = PILPKG_V1_HEADER + ar.entries.len() + "\n";
    for e in ar.entries {
        out = out + e.path + ":" + e.content.len() + "\n" + e.content + "\n";
    }
    return out;
}

pub fn pilpkg_file_count(archive_blob: str) -> i64 {
    if ar_find(archive_blob, PILPKG_V1_HEADER, 0) != 0 { return 0; }
    let hlen = PILPKG_V1_HEADER.len();
    let nl = ar_find(archive_blob, "\n", hlen);
    if nl < 0 { return 0; }
    return ar_parse_int(archive_blob.slice(hlen, nl));
}

/// The text of `rel_path` in the archive, or `""` when it is not there.
pub fn pilpkg_extract_file(archive_blob: str, rel_path: str) -> str {
    if ar_find(archive_blob, PILPKG_V1_HEADER, 0) != 0 { return ""; }
    let total_len = archive_blob.len();
    let hdr_nl = ar_find(archive_blob, "\n", 0);
    if hdr_nl < 0 { return ""; }
    var pos = hdr_nl + 1;
    while pos < total_len {
        let line_end = ar_find(archive_blob, "\n", pos);
        if line_end < 0 { break; }
        let meta = archive_blob.slice(pos, line_end);
        let col = ar_find(meta, ":", 0);
        if col < 0 { break; }
        let path = meta.slice(0, col);
        let clen = ar_parse_int(meta.slice(col + 1, meta.len()));
        let c_start = line_end + 1;
        let c_end = c_start + clen;
        if c_end > total_len { break; }
        if path == rel_path {
            return archive_blob.slice(c_start, c_end);
        }
        pos = c_end + 1; // skip trailing newline
    }
    return "";
}
