// =========================================================================
pub pkg Pilot.SelfHost.Pkg.Manifest;

pub pure fn nameof(sym: str) -> str => sym;

pub enum ManifestField {
    Name,
    Version,
    License,
    Entry,
    Dependencies,
}

pub pure fn manifest_field_name(field: ManifestField) -> str {
    return "name";
}

fn mf_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if haystack.slice(i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

pub pure fn generate_default_manifest_json(pkg_name: str, version: str = "0.1.0") -> str {
    let nm = if pkg_name != "" { pkg_name } else { "pilot_app" };
    return "{\n" +
           "  \"name\": \"" + nm + "\",\n" +
           "  \"version\": \"" + version + "\",\n" +
           "  \"license\": \"MIT\",\n" +
           "  \"entry\": \"src/main.pilot\",\n" +
           "  \"dependencies\": {}\n" +
           "}";
}

pub pure fn scaffold_canonical_main_pilot(pkg_name: str) -> str {
    return "pub " + nameof(fn) + " main() -> i64 {\n" +
           "    " + nameof(let) + " msg = \"Hello from " + pkg_name + "!\";\n" +
           "    " + nameof(return) + " 0;\n" +
           "}\n";
}

pub fn parse_manifest_json(json_src: str) -> i64 {
    let mf = __engine("map_new");
    let nl = json_src.len();
    
    // Extract "name"
    let n_idx = mf_find(json_src, "\"name\":", 0);
    if n_idx >= 0 {
        let q1 = mf_find(json_src, "\"", n_idx + 7);
        if q1 >= 0 {
            let q2 = mf_find(json_src, "\"", q1 + 1);
            if q2 >= 0 {
                let name = json_src.slice(q1 + 1, q2);
                let _s = __engine("map_set", mf, "name", name);
            }
        }
    }
    
    // Extract "version"
    let v_idx = mf_find(json_src, "\"version\":", 0);
    if v_idx >= 0 {
        let q1 = mf_find(json_src, "\"", v_idx + 10);
        if q1 >= 0 {
            let q2 = mf_find(json_src, "\"", q1 + 1);
            if q2 >= 0 {
                let ver = json_src.slice(q1 + 1, q2);
                let _s = __engine("map_set", mf, "version", ver);
            }
        }
    }

    // Extract dependencies
    var dep_count = 0;
    let d_idx = mf_find(json_src, "\"dependencies\":", 0);
    if d_idx >= 0 {
        let b_open = mf_find(json_src, "{", d_idx + 15);
        if b_open >= 0 {
            let b_close = mf_find(json_src, "}", b_open + 1);
            if b_close >= 0 {
                var p = b_open + 1;
                while p < b_close {
                    let k_q1 = mf_find(json_src, "\"", p);
                    if k_q1 < 0 || k_q1 >= b_close { break; }
                    let k_q2 = mf_find(json_src, "\"", k_q1 + 1);
                    if k_q2 < 0 || k_q2 >= b_close { break; }
                    let d_name = json_src.slice(k_q1 + 1, k_q2);
                    
                    let col = mf_find(json_src, ":", k_q2 + 1);
                    if col < 0 || col >= b_close { break; }
                    let v_q1 = mf_find(json_src, "\"", col + 1);
                    if v_q1 < 0 || v_q1 >= b_close { break; }
                    let v_q2 = mf_find(json_src, "\"", v_q1 + 1);
                    if v_q2 < 0 || v_q2 >= b_close { break; }
                    let d_ver = json_src.slice(v_q1 + 1, v_q2);
                    
                    let _sd = __engine("map_set", mf, "dep:" + d_name, d_ver);
                    let _sdn = __engine("map_set", mf, "dep_name_" + dep_count, d_name);
                    dep_count = dep_count + 1;
                    p = v_q2 + 1;
                }
            }
        }
    }
    let _sc = __engine("map_set", mf, "dep_count", dep_count);

    // Extract devDependencies
    var dev_count = 0;
    let dev_idx = mf_find(json_src, "\"devDependencies\":", 0);
    if dev_idx >= 0 {
        let db_open = mf_find(json_src, "{", dev_idx + 18);
        if db_open >= 0 {
            let db_close = mf_find(json_src, "}", db_open + 1);
            if db_close >= 0 {
                var dp = db_open + 1;
                while dp < db_close {
                    let k_q1 = mf_find(json_src, "\"", dp);
                    if k_q1 < 0 || k_q1 >= db_close { break; }
                    let k_q2 = mf_find(json_src, "\"", k_q1 + 1);
                    if k_q2 < 0 || k_q2 >= db_close { break; }
                    let d_name = json_src.slice(k_q1 + 1, k_q2);
                    
                    let col = mf_find(json_src, ":", k_q2 + 1);
                    if col < 0 || col >= db_close { break; }
                    let v_q1 = mf_find(json_src, "\"", col + 1);
                    if v_q1 < 0 || v_q1 >= db_close { break; }
                    let v_q2 = mf_find(json_src, "\"", v_q1 + 1);
                    if v_q2 < 0 || v_q2 >= db_close { break; }
                    let d_ver = json_src.slice(v_q1 + 1, v_q2);
                    
                    let _sdd = __engine("map_set", mf, "dev_dep:" + d_name, d_ver);
                    let _sddn = __engine("map_set", mf, "dev_dep_name_" + dev_count, d_name);
                    dev_count = dev_count + 1;
                    dp = v_q2 + 1;
                }
            }
        }
    }
    let _scd = __engine("map_set", mf, "dev_dep_count", dev_count);

    // Extract exclusions ("exclude": ["..."])
    var ex_count = 0;
    let ex_idx = mf_find(json_src, "\"exclude\":", 0);
    if ex_idx >= 0 {
        let eb_open = mf_find(json_src, "[", ex_idx + 10);
        if eb_open >= 0 {
            let eb_close = mf_find(json_src, "]", eb_open + 1);
            if eb_close >= 0 {
                var ep = eb_open + 1;
                while ep < eb_close {
                    let q1 = mf_find(json_src, "\"", ep);
                    if q1 < 0 || q1 >= eb_close { break; }
                    let q2 = mf_find(json_src, "\"", q1 + 1);
                    if q2 < 0 || q2 >= eb_close { break; }
                    let ex_val = json_src.slice(q1 + 1, q2);
                    let _sex = __engine("map_set", mf, "exclude_" + ex_count, ex_val);
                    ex_count = ex_count + 1;
                    ep = q2 + 1;
                }
            }
        }
    }
    let _scex = __engine("map_set", mf, "exclude_count", ex_count);
    return mf;
}

pub fn manifest_get_name(mf: i64) -> str {
    let raw = __engine("map_get", mf, "name");
    return if raw != null { raw } else { "" };
}

pub fn manifest_get_field(mf: i64, field: ManifestField) -> str {
    return manifest_get_name(mf);
}

pub fn manifest_get_version(mf: i64) -> str {
    let raw = __engine("map_get", mf, "version");
    return if raw != null { raw } else { "" };
}

pub fn manifest_dep_count(mf: i64) -> i64 {
    let raw = __engine("map_get", mf, "dep_count");
    return if raw != null { raw } else { 0 };
}

pub fn manifest_dep_version(mf: i64, dep_name: str) -> str {
    let raw = __engine("map_get", mf, "dep:" + dep_name);
    return if raw != null { raw } else { "" };
}

pub fn manifest_dep_name(mf: i64, idx: i64) -> str {
    let raw = __engine("map_get", mf, "dep_name_" + idx);
    return if raw != null { raw } else { "" };
}

pub fn manifest_dev_dep_count(mf: i64) -> i64 {
    let raw = __engine("map_get", mf, "dev_dep_count");
    return if raw != null { raw } else { 0 };
}

pub fn manifest_dev_dep_name(mf: i64, idx: i64) -> str {
    let raw = __engine("map_get", mf, "dev_dep_name_" + idx);
    return if raw != null { raw } else { "" };
}

pub fn manifest_dev_dep_version(mf: i64, dep_name: str) -> str {
    let raw = __engine("map_get", mf, "dev_dep:" + dep_name);
    return if raw != null { raw } else { "" };
}

pub fn manifest_exclude_count(mf: i64) -> i64 {
    let raw = __engine("map_get", mf, "exclude_count");
    return if raw != null { raw } else { 0 };
}

pub fn manifest_exclude_item(mf: i64, idx: i64) -> str {
    let raw = __engine("map_get", mf, "exclude_" + idx);
    return if raw != null { raw } else { "" };
}

pub fn is_import_excluded(mf: i64, import_spec: str) -> bool {
    let count = manifest_exclude_count(mf);
    if count <= 0 { return false; }
    var i = 0;
    while i < count {
        let pattern = manifest_exclude_item(mf, i);
        if pattern.len() > 0 {
            if import_spec == pattern || mf_find(import_spec, pattern, 0) >= 0 {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn compute_package_lockfile_json(pkg_name: str, version: str, payload: str) -> str {
    let digest = sha256_hex(payload);
    return "{\n" +
           "  \"lockfileVersion\": 3,\n" +
           "  \"name\": \"" + pkg_name + "\",\n" +
           "  \"version\": \"" + version + "\",\n" +
           "  \"integrity\": \"sha256-" + digest + "\"\n" +
           "}";
}

pub fn verify_lockfile_integrity(lock_json: str, payload: str) -> bool {
    let actual_digest = sha256_hex(payload);
    let expected_tag = "\"integrity\": \"sha256-" + actual_digest + "\"";
    let alt_tag = "\"integrity\":\"sha256-" + actual_digest + "\"";
    return mf_find(lock_json, expected_tag, 0) >= 0 || mf_find(lock_json, alt_tag, 0) >= 0;
}

// =========================================================================
// 3. TWO-TIER MODULE & PACKAGE DEPENDENCY RESOLVER (Pure Pilot)
// =========================================================================

pub fn resolve_package_import_path(import_spec: str) -> str {
    if mf_find(import_spec, "Pilot.Core.Reflect", 0) >= 0 {
        return "stdlib/core/reflect.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Keywords", 0) >= 0 {
        return "stdlib/core/keywords.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Option", 0) >= 0 {
        return "stdlib/core/option.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Result", 0) >= 0 {
        return "stdlib/core/result.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Memory", 0) >= 0 {
        return "stdlib/core/mem.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Meta", 0) >= 0 {
        return "stdlib/core/meta.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Bootstrap", 0) >= 0 {
        return "stdlib/core/bootstrap.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Task", 0) >= 0 {
        return "stdlib/core/task.pilot";
    }
    if mf_find(import_spec, "Pilot.Collections", 0) >= 0 {
        return "stdlib/std/col.pilot";
    }
    if mf_find(import_spec, "Pilot.Crypto", 0) >= 0 {
        return "stdlib/crypto/hash.pilot";
    }
    return "";
}

fn try_mount_candidate_paths(candidate: str) -> i64 {
    // Try path relative to current working directory
    let r1 = __engine("mount_unit", candidate);
    if r1 != null && r1 >= 0 {
        return r1;
    }
    // Try path relative to workspace root (e.g. from subdirectories or test runners)
    let r2 = __engine("mount_unit", "../../" + candidate);
    if r2 != null && r2 >= 0 {
        return r2;
    }
    return -1;
}

pub fn mount_import_unit(import_spec: str) -> i64 {
    // 1. Try standard library direct resolution:
    let stdlib_p = resolve_package_import_path(import_spec);
    if stdlib_p != "" {
        let res = try_mount_candidate_paths(stdlib_p);
        if res >= 0 {
            return res;
        }
    }

    // 2. Strip trailing ".*" or ";"
    var spec = import_spec;
    let n = spec.len();
    if n > 2 && spec.slice(n - 2, n) == ".*" {
        spec = spec.slice(0, n - 2);
    }
    let n2 = spec.len();
    if n2 > 1 && spec.slice(n2 - 1, n2) == ";" {
        spec = spec.slice(0, n2 - 1);
    }

    // Convert namespace dots to directory slashes: "MyPkg.Sub" -> "MyPkg/Sub"
    var rel = "";
    var i = 0;
    let slen = spec.len();
    while i < slen {
        let ch = spec.slice(i, i + 1);
        if ch == "." {
            rel = rel + "/";
        } else {
            rel = rel + ch;
        }
        i = i + 1;
    }

    // 3. Tier 1: Virtual Environment (.pilotvenv/packages/ or venv/packages/)
    let venv_res1 = try_mount_candidate_paths(".pilotvenv/packages/" + rel + ".pilot");
    if venv_res1 >= 0 { return venv_res1; }
    let venv_res2 = try_mount_candidate_paths("venv/packages/" + rel + ".pilot");
    if venv_res2 >= 0 { return venv_res2; }

    // 4. Tier 2: User Project Source (src/ & local)
    let src_res = try_mount_candidate_paths("src/" + rel + ".pilot");
    if src_res >= 0 { return src_res; }
    let local_res = try_mount_candidate_paths(rel + ".pilot");
    if local_res >= 0 { return local_res; }

    // 5. Tier 3: Standard Library Submodules (stdlib/...)
    let std_res = try_mount_candidate_paths("stdlib/" + rel + ".pilot");
    if std_res >= 0 { return std_res; }

    return -1;
}

pub fn mount_all_ast_imports() -> i64 {
    let total = __engine("ast_node_count");
    if total == null || total <= 0 {
        return 0;
    }
    var mounted = 0;
    var idx = 0;
    while idx < total {
        let orig = __engine("ast_orig_kind", idx);
        if orig == 1 { // NodeKind::ImportDecl = 1
            let sym = __engine("ast_node_sym", idx);
            if sym != null && sym != 0 {
                let spec = __engine("sym_str", sym);
                if spec != null && spec != "" {
                    let res = mount_import_unit(spec);
                    if res != null && res >= 0 {
                        mounted = mounted + 1;
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return mounted;
}
