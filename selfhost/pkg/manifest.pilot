// =========================================================================
// FILE: selfhost/pkg/manifest.pilot
// Package manifest (pilot.json) parsing and lockfile generation.
// Reached by the milestone29 and milestone60 Rust tests and by
// selfhost/cli/pkg_cmd.pilot (milestone03 test only); `pilot pkg` has no
// handler (seam cli.command_handler).
// =========================================================================
pub pkg selfhost.pkg;

use std.crypto.hash;

fn mf_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if haystack.slice(i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

pub pure fn generate_default_manifest_json(pkg_name: str, version: str) -> str {
    let nm = if pkg_name != "" { pkg_name } else { "pilot_app" };
    return "{\n" +
           "  \"name\": \"" + nm + "\",\n" +
           "  \"version\": \"" + version + "\",\n" +
           "  \"license\": \"MIT\",\n" +
           "  \"entry\": \"src/main.pilot\",\n" +
           "  \"dependencies\": {}\n" +
           "}";
}

pub pure fn scaffold_canonical_main_pilot(pkg_name: str) -> str {
    return nameof(pub) + " " + nameof(fn) + " main() -> " + nameof(i64) + " {\n" +
           "    " + nameof(let) + " msg = \"Hello from " + pkg_name + "!\";\n" +
           "    " + nameof(return) + " 0;\n" +
           "}\n";
}

/// One dependency entry: the package name and its version requirement.
pub struct ManifestDep {
    pub name: str;
    pub version: str;
}

/// The fields of a `pilot.json` the package tools read.
pub struct PkgManifest : IObject {
    pub name: str;
    pub version: str;
    pub deps: List<ManifestDep>;
    pub dev_deps: List<ManifestDep>;
    pub excludes: List<str>;
}

/// The `"key": "value"` string pairs of the flat JSON object under `key_tag`.
fn mf_parse_dep_object(json_src: str, key_tag: str, var ref out: List<ManifestDep>) {
    let d_idx = mf_find(json_src, key_tag, 0);
    if d_idx < 0 { return; }
    let b_open = mf_find(json_src, "{", d_idx + key_tag.len());
    if b_open < 0 { return; }
    let b_close = mf_find(json_src, "}", b_open + 1);
    if b_close < 0 { return; }
    var p = b_open + 1;
    while p < b_close {
        let k_q1 = mf_find(json_src, "\"", p);
        if k_q1 < 0 || k_q1 >= b_close { break; }
        let k_q2 = mf_find(json_src, "\"", k_q1 + 1);
        if k_q2 < 0 || k_q2 >= b_close { break; }
        let d_name = json_src.slice(k_q1 + 1, k_q2);

        let col = mf_find(json_src, ":", k_q2 + 1);
        if col < 0 || col >= b_close { break; }
        let v_q1 = mf_find(json_src, "\"", col + 1);
        if v_q1 < 0 || v_q1 >= b_close { break; }
        let v_q2 = mf_find(json_src, "\"", v_q1 + 1);
        if v_q2 < 0 || v_q2 >= b_close { break; }
        out.push(ManifestDep { name: d_name, version: json_src.slice(v_q1 + 1, v_q2) });
        p = v_q2 + 1;
    }
}

/// The string value of the top-level `key_tag` (`"name":`), or `""`.
fn mf_string_field(json_src: str, key_tag: str) -> str {
    let idx = mf_find(json_src, key_tag, 0);
    if idx < 0 { return ""; }
    let q1 = mf_find(json_src, "\"", idx + key_tag.len());
    if q1 < 0 { return ""; }
    let q2 = mf_find(json_src, "\"", q1 + 1);
    if q2 < 0 { return ""; }
    return json_src.slice(q1 + 1, q2);
}

pub fn parse_manifest_json(json_src: str) -> PkgManifest {
    var mf = PkgManifest {
        name: mf_string_field(json_src, "\"name\":"),
        version: mf_string_field(json_src, "\"version\":"),
        deps: [],
        dev_deps: [],
        excludes: [],
    };
    mf_parse_dep_object(json_src, "\"dependencies\":", mf.deps);
    mf_parse_dep_object(json_src, "\"devDependencies\":", mf.dev_deps);

    // Extract exclusions ("exclude": ["..."])
    let ex_idx = mf_find(json_src, "\"exclude\":", 0);
    if ex_idx >= 0 {
        let eb_open = mf_find(json_src, "[", ex_idx + 10);
        if eb_open >= 0 {
            let eb_close = mf_find(json_src, "]", eb_open + 1);
            if eb_close >= 0 {
                var ep = eb_open + 1;
                while ep < eb_close {
                    let q1 = mf_find(json_src, "\"", ep);
                    if q1 < 0 || q1 >= eb_close { break; }
                    let q2 = mf_find(json_src, "\"", q1 + 1);
                    if q2 < 0 || q2 >= eb_close { break; }
                    mf.excludes.push(json_src.slice(q1 + 1, q2));
                    ep = q2 + 1;
                }
            }
        }
    }
    return mf;
}

/// The requirement given for `dep_name` in `deps` (the last one when it is
/// listed twice), or `""`.
fn mf_dep_requirement(ref deps: List<ManifestDep>, dep_name: str) -> str {
    var i = deps.len() - 1;
    while i >= 0 {
        if deps[i].name == dep_name { return deps[i].version; }
        i = i - 1;
    }
    return "";
}

/// The name of entry `idx` in `deps`, or `""` past the end.
fn mf_dep_name_at(ref deps: List<ManifestDep>, idx: i64) -> str {
    if idx < 0 || idx >= deps.len() { return ""; }
    return deps[idx].name;
}

pub fn manifest_get_name(ref mf: PkgManifest) -> str => mf.name;

pub fn manifest_get_version(ref mf: PkgManifest) -> str => mf.version;

pub fn manifest_dep_count(ref mf: PkgManifest) -> i64 => mf.deps.len();

pub fn manifest_dep_version(ref mf: PkgManifest, dep_name: str) -> str => mf_dep_requirement(mf.deps, dep_name);

pub fn manifest_dep_name(ref mf: PkgManifest, idx: i64) -> str => mf_dep_name_at(mf.deps, idx);

pub fn manifest_dev_dep_count(ref mf: PkgManifest) -> i64 => mf.dev_deps.len();

pub fn manifest_dev_dep_name(ref mf: PkgManifest, idx: i64) -> str => mf_dep_name_at(mf.dev_deps, idx);

pub fn manifest_dev_dep_version(ref mf: PkgManifest, dep_name: str) -> str => mf_dep_requirement(mf.dev_deps, dep_name);

pub fn manifest_exclude_count(ref mf: PkgManifest) -> i64 => mf.excludes.len();

pub fn manifest_exclude_item(ref mf: PkgManifest, idx: i64) -> str {
    if idx < 0 || idx >= mf.excludes.len() { return ""; }
    return mf.excludes[idx];
}

pub fn is_import_excluded(ref mf: PkgManifest, import_spec: str) -> bool {
    for pattern in mf.excludes {
        if pattern.len() > 0 && (import_spec == pattern || mf_find(import_spec, pattern, 0) >= 0) {
            return true;
        }
    }
    return false;
}

pub fn compute_package_lockfile_json(pkg_name: str, version: str, payload: str) -> str {
    let digest = sha256_hex(payload);
    return "{\n" +
           "  \"lockfileVersion\": 3,\n" +
           "  \"name\": \"" + pkg_name + "\",\n" +
           "  \"version\": \"" + version + "\",\n" +
           "  \"integrity\": \"sha256-" + digest + "\"\n" +
           "}";
}

pub fn verify_lockfile_integrity(lock_json: str, payload: str) -> bool {
    let actual_digest = sha256_hex(payload);
    let expected_tag = "\"integrity\": \"sha256-" + actual_digest + "\"";
    let alt_tag = "\"integrity\":\"sha256-" + actual_digest + "\"";
    return mf_find(lock_json, expected_tag, 0) >= 0 || mf_find(lock_json, alt_tag, 0) >= 0;
}

// =========================================================================
// 3. TWO-TIER MODULE & PACKAGE DEPENDENCY RESOLVER (Pure Pilot)
// =========================================================================

pub fn resolve_package_import_path(import_spec: str) -> str {
    if mf_find(import_spec, "Pilot.Core.Reflect", 0) >= 0 {
        return "stdlib/core/reflect.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Keywords", 0) >= 0 {
        return "stdlib/core/keywords.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Option", 0) >= 0 {
        return "stdlib/core/option.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Result", 0) >= 0 {
        return "stdlib/core/result.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Memory", 0) >= 0 {
        return "stdlib/core/mem.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Meta", 0) >= 0 {
        return "stdlib/core/meta.pilot";
    }
    if mf_find(import_spec, "Pilot.Core.Task", 0) >= 0 {
        return "stdlib/core/task.pilot";
    }
    if mf_find(import_spec, "Pilot.Collections", 0) >= 0 {
        return "stdlib/std/col.pilot";
    }
    if mf_find(import_spec, "Pilot.Crypto", 0) >= 0 {
        return "stdlib/crypto/hash.pilot";
    }
    return "";
}

fn try_mount_candidate_paths(candidate: str) -> i64 {
    // Try path relative to current working directory
    let r1 = __engine("mount_unit", candidate);
    if r1 != none && r1 >= 0 {
        return r1;
    }
    // Try path relative to workspace root (e.g. from subdirectories or test runners)
    let r2 = __engine("mount_unit", "../../" + candidate);
    if r2 != none && r2 >= 0 {
        return r2;
    }
    return -1;
}

pub fn mount_import_unit(import_spec: str) -> i64 {
    // 1. Try standard library direct resolution:
    let stdlib_p = resolve_package_import_path(import_spec);
    if stdlib_p != "" {
        let unit = try_mount_candidate_paths(stdlib_p);
        if unit >= 0 {
            return unit;
        }
    }

    // 2. Strip trailing ".*" or ";"
    var spec = import_spec;
    let n = spec.len();
    if n > 2 && spec.slice(n - 2, n) == ".*" {
        spec = spec.slice(0, n - 2);
    }
    let n2 = spec.len();
    if n2 > 1 && spec.slice(n2 - 1, n2) == ";" {
        spec = spec.slice(0, n2 - 1);
    }

    // Convert namespace dots to directory slashes: "MyPkg.Sub" -> "MyPkg/Sub"
    var rel = "";
    var i = 0;
    let slen = spec.len();
    while i < slen {
        let ch = spec.slice(i, i + 1);
        if ch == "." {
            rel = rel + "/";
        } else {
            rel = rel + ch;
        }
        i = i + 1;
    }

    // 3. Tier 1: Virtual Environment (.pilotvenv/packages/ or venv/packages/)
    let venv_res1 = try_mount_candidate_paths(".pilotvenv/packages/" + rel + ".pilot");
    if venv_res1 >= 0 { return venv_res1; }
    let venv_res2 = try_mount_candidate_paths("venv/packages/" + rel + ".pilot");
    if venv_res2 >= 0 { return venv_res2; }

    // 4. Tier 2: User Project Source (src/ & local)
    let src_res = try_mount_candidate_paths("src/" + rel + ".pilot");
    if src_res >= 0 { return src_res; }
    let local_res = try_mount_candidate_paths(rel + ".pilot");
    if local_res >= 0 { return local_res; }

    // 5. Tier 3: Standard Library Submodules (stdlib/...)
    let std_res = try_mount_candidate_paths("stdlib/" + rel + ".pilot");
    if std_res >= 0 { return std_res; }

    return -1;
}

pub fn mount_all_ast_imports() -> i64 {
    let total = __engine("ast_node_count");
    if total == none || total <= 0 {
        return 0;
    }
    var mounted = 0;
    var idx = 0;
    while idx < total {
        let orig = __engine("ast_orig_kind", idx);
        if orig == 1 { // NodeKind::ImportDecl = 1
            let sym = __engine("ast_node_sym", idx);
            if sym != none && sym != 0 {
                let spec = __engine("sym_str", sym);
                if spec != none && spec != "" {
                    let unit = mount_import_unit(spec);
                    if unit >= 0 {
                        mounted = mounted + 1;
                    }
                }
            }
        }
        idx = idx + 1;
    }
    return mounted;
}

// ==============================================================================
// 6. Comptime Sandbox Policy & Capability Grant Parsing (Milestone 29)
// ==============================================================================

[Layout(c_abi)]
pub struct ComptimeAllowPolicy : IValue {
    pub max_fuel:         u64;
    pub allow_fs_read:    bool;
    pub allow_net:        bool;
    pub allow_env:        bool;
    pub allow_subprocess: bool;
    pub allow_ffi:        bool;
}

pub pure fn comptime_allow_policy_default() -> ComptimeAllowPolicy {
    return ComptimeAllowPolicy {
        max_fuel:         2000000,
        allow_fs_read:    false,
        allow_net:        false,
        allow_env:        false,
        allow_subprocess: false,
        allow_ffi:        false,
    };
}

/// Position just past the JSON key `"key"` and its `:` at or after `start`,
/// or -1.
fn mf_after_key(text: str, key: str, start: i64) -> i64 {
    let at = mf_find(text, "\"" + key + "\"", start);
    if at < 0 { return -1; }
    var i = at + key.len() + 2;
    while i < text.len() && (text.byte_at(i) == 32 || text.byte_at(i) == 9 || text.byte_at(i) == 10 || text.byte_at(i) == 13) {
        i = i + 1;
    }
    if i >= text.len() || text.byte_at(i) != 58 { return -1; } // ':'
    return i + 1;
}

/// The string literals of the JSON array that starts at the first `[` at or
/// after `start`.
fn mf_string_array(text: str, start: i64) -> List<str> {
    var items: List<str> = [];
    let open = mf_find(text, "[", start);
    if open < 0 { return items; }
    var i = open + 1;
    while i < text.len() {
        let b = text.byte_at(i);
        if b == 93 { return items; } // ']'
        if b == 34 { // '"'
            var j = i + 1;
            while j < text.len() && text.byte_at(j) != 34 {
                if text.byte_at(j) == 92 { j = j + 1; }
                j = j + 1;
            }
            items.push(text.slice(i + 1, j));
            i = j + 1;
        } else {
            i = i + 1;
        }
    }
    return items;
}

/// Index of the `}` closing the JSON object that opens at the first `{` at
/// or after `start`, or the text length when it is not closed.
fn mf_object_end(text: str, start: i64) -> i64 {
    let open = mf_find(text, "{", start);
    if open < 0 { return text.len(); }
    var depth = 0;
    var in_str = false;
    var i = open;
    while i < text.len() {
        let b = text.byte_at(i);
        if in_str {
            if b == 92 { i = i + 1; } else if b == 34 { in_str = false; }
        } else if b == 34 {
            in_str = true;
        } else if b == 123 {
            depth = depth + 1;
        } else if b == 125 {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        i = i + 1;
    }
    return text.len();
}

/// Like `mf_after_key`, but only inside `[start, end)`.
fn mf_after_key_within(text: str, key: str, start: i64, end: i64) -> i64 {
    let at = mf_after_key(text, key, start);
    if at < 0 || at > end { return -1; }
    return at;
}

/// Reads the root manifest's `comptime` object: `allow` (a list of
/// capability names), the per-capability lists `read_globs`, `env_vars` and
/// `ffi_targets` (each grants its capability), and `max_fuel`. Capabilities
/// named anywhere else in the manifest grant nothing.
pub fn parse_comptime_allow_policy(manifest_text: str) -> ComptimeAllowPolicy {
    var policy = comptime_allow_policy_default();
    let section = mf_after_key(manifest_text, "comptime", 0);
    if section < 0 { return policy; }
    let end = mf_object_end(manifest_text, section);

    if mf_after_key_within(manifest_text, "read_globs", section, end) >= 0 { policy.allow_fs_read = true; }
    if mf_after_key_within(manifest_text, "env_vars", section, end) >= 0 { policy.allow_env = true; }
    if mf_after_key_within(manifest_text, "ffi_targets", section, end) >= 0 { policy.allow_ffi = true; }

    let allow_at = mf_after_key_within(manifest_text, "allow", section, end);
    var list_at = allow_at;
    while list_at >= 0 && list_at < end && (manifest_text.byte_at(list_at) == 32 || manifest_text.byte_at(list_at) == 10) {
        list_at = list_at + 1;
    }
    if list_at >= 0 && list_at < end && manifest_text.byte_at(list_at) == 91 { // '['
        let caps = mf_string_array(manifest_text, list_at);
        var i = 0;
        while i < caps.len() {
            let c = caps[i];
            if c == "fs.read" { policy.allow_fs_read = true; }
            if c == "net" { policy.allow_net = true; }
            if c == "env" { policy.allow_env = true; }
            if c == "subprocess" { policy.allow_subprocess = true; }
            if c == "ffi" { policy.allow_ffi = true; }
            i = i + 1;
        }
    }

    let fuel_at = mf_after_key_within(manifest_text, "max_fuel", section, end);
    if fuel_at >= 0 {
        var i = fuel_at;
        while i < manifest_text.len() && manifest_text.byte_at(i) == 32 { i = i + 1; }
        var fuel: u64 = 0;
        var digits = 0;
        while i < manifest_text.len() && manifest_text.byte_at(i) >= 48 && manifest_text.byte_at(i) <= 57 {
            fuel = fuel * 10 + (manifest_text.byte_at(i) - 48);
            digits = digits + 1;
            i = i + 1;
        }
        if digits > 0 { policy.max_fuel = fuel; }
    }

    return policy;
}

/// Whether the root policy grants the capability `name`; unknown names are
/// never granted.
pub pure fn comptime_policy_grants(policy: ComptimeAllowPolicy, name: str) -> bool {
    if name == "fs.read" { return policy.allow_fs_read; }
    if name == "net" { return policy.allow_net; }
    if name == "env" { return policy.allow_env; }
    if name == "subprocess" { return policy.allow_subprocess; }
    if name == "ffi" { return policy.allow_ffi; }
    return false;
}

pub fn validate_dependency_comptime_needs(
    root_policy: ComptimeAllowPolicy,
    dep_name: str,
    ref needs: List<str>
) -> str {
    var i = 0;
    while i < needs.len() {
        let n = needs[i];
        if !comptime_policy_grants(root_policy, n) {
            return "CTIME006: Untrusted dependency '" + dep_name + "' requested unapproved comptime capability '" + n + "'; must be granted in root [comptime.grants]";
        }
        i = i + 1;
    }
    return "";
}
