// =========================================================================
// FILE: selfhost/pkg/interop.pilot
// Milestone 60.1: Cross-Ecosystem Package Spec Resolver (cargo:, pip:, npm:)
// =========================================================================
pub pkg Pilot.SelfHost.Pkg.Interop;

pub pure fn nameof(sym: str) -> str => sym;

pub enum Ecosystem {
    Pilot,
    Cargo,
    Pip,
    Npm,
}

fn interop_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = __engine("str_len", haystack);
    let nl = __engine("str_len", needle);
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if __engine("str_slice", haystack, i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

pub fn parse_ecosystem_spec(spec: str) -> str {
    let col = interop_find(spec, ":", 0);
    if col < 0 { return spec; }
    let at = interop_find(spec, "@", col + 1);
    if at < 0 { return spec; }
    let eco = __engine("str_slice", spec, 0, col);
    let pkg = __engine("str_slice", spec, col + 1, at);
    let ver = __engine("str_slice", spec, at + 1, __engine("str_len", spec));
    return eco + "|" + pkg + "|" + ver;
}
