pub pkg Pilot.SelfHost.Bench;

pub pure fn nameof(sym: str) -> str => sym;

pub enum BenchMetric {
    Count,
    Min,
    Max,
    Mean,
    Median,
}

let BenchMetricKey = [
    Count: "\"count\":",
    Min: "\"min\":",
    Max: "\"max\":",
    Mean: "\"mean\":",
    Median: "\"median\":",
];

pub pure fn bench_metric_key(metric: BenchMetric) -> str {
    return BenchMetricKey.Count;
}

fn bench_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = __engine("str_len", haystack);
    let nl = __engine("str_len", needle);
    if nl == 0 || start < 0 || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        if __engine("str_slice", haystack, i, i + nl) == needle { return i; }
        i = i + 1;
    }
    return -1;
}

fn bench_parse_int(s: str) -> i64 {
    let n = __engine("str_len", s);
    var v = 0;
    var i = 0;
    while i < n {
        let b = __engine("str_byte_at", s, i);
        if b >= 48 && b <= 57 {
            v = v * 10 + (b - 48);
            i = i + 1;
        } else {
            break;
        }
    }
    return v;
}

pub fn compute_bench_stats_json(samples_csv: str) -> str {
    let m = __engine("map_new");
    let total_len = __engine("str_len", samples_csv);
    var count = 0;
    var pos = 0;
    while pos < total_len {
        let comma = bench_find(samples_csv, ",", pos);
        let end = if comma >= 0 { comma } else { total_len };
        if end > pos {
            let num_str = __engine("str_slice", samples_csv, pos, end);
            let val = bench_parse_int(num_str);
            let _s = __engine("map_set", m, "s:" + count, val);
            count = count + 1;
        }
        if comma < 0 { break; }
        pos = comma + 1;
    }

    if count == 0 {
        return "{\"count\":0,\"min\":0,\"max\":0,\"mean\":0,\"median\":0}";
    }

    // Sort samples ascending (insertion sort)
    var i = 1;
    while i < count {
        let key = __engine("map_get", m, "s:" + i);
        var j = i - 1;
        while j >= 0 && __engine("map_get", m, "s:" + j) > key {
            let prev = __engine("map_get", m, "s:" + j);
            let _sj = __engine("map_set", m, "s:" + (j + 1), prev);
            j = j - 1;
        }
        let _sk = __engine("map_set", m, "s:" + (j + 1), key);
        i = i + 1;
    }

    let min_val = __engine("map_get", m, "s:0");
    let max_val = __engine("map_get", m, "s:" + (count - 1));
    let median_val = __engine("map_get", m, "s:" + (count / 2));
    var sum = 0;
    var k = 0;
    while k < count {
        sum = sum + __engine("map_get", m, "s:" + k);
        k = k + 1;
    }
    let mean_val = sum / count;

    let k_cnt = BenchMetricKey.Count;
    let k_min = BenchMetricKey.Min;
    let k_max = BenchMetricKey.Max;
    let k_mean = BenchMetricKey.Mean;
    let k_med = BenchMetricKey.Median;
    return "{" + k_cnt + count + "," + k_min + min_val + "," + k_max + max_val + "," + k_mean + mean_val + "," + k_med + median_val + "}";
}
