// ============================================================================
// Pilot Self-Hosted Stage 0 Preprocessor (selfhost/preprocessor.pilot)
// 100% Pilot Conditional Compilation (#define, #undef, #if/#elif/#else/#endif,
// #region/#endregion, #error, #warning, #pragma warning) & PREPROC001-PREPROC008
// ============================================================================

pub struct PreprocDiagnostic {
    pub line: i64;
    pub col: i64;
    pub severity: i64;
    pub code: str;
    pub message: str;
}

pub struct CodeRegion {
    pub name: str;
    pub start_line: i64;
    pub end_line: i64;
}

pub struct WarningSuppression {
    pub warning_code: str;
    pub start_line: i64;
    pub end_line: i64;
}

pub struct IfFrame {
    pub condition_met: bool;
    pub current_branch_active: bool;
    pub has_else_branch: bool;
    pub start_line: i64;
}

pub pure fn is_ws_byte(b: u8) -> bool {
    return b == 32 || b == 9 || b == 13;
}

pub fn trim_ws(s: str) -> str {
    let n = s.len();
    var start = 0;
    while start < n && is_ws_byte(s.byte_at(start)) {
        start = start + 1;
    }
    var end = n;
    while end > start && is_ws_byte(s.byte_at(end - 1)) {
        end = end - 1;
    }
    return s.slice(start, end);
}

pub fn starts_with_str(s: str, prefix: str) -> bool {
    let plen = prefix.len();
    if s.len() < plen {
        return false;
    }
    return s.slice(0, plen) == prefix;
}

pub fn ends_with_str(s: str, suffix: str) -> bool {
    let slen = s.len();
    let xlen = suffix.len();
    if slen < xlen {
        return false;
    }
    return s.slice(slen - xlen, slen) == suffix;
}

pub fn find_substr(s: str, pat: str) -> i64 {
    let slen = s.len();
    let plen = pat.len();
    if plen == 0 {
        return 0;
    }
    if slen < plen {
        return -1;
    }
    var i = 0;
    while i + plen <= slen {
        if s.slice(i, i + plen) == pat {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

pub fn parse_directive_name(content: str) -> str {
    let trimmed = trim_ws(content);
    let n = trimmed.len();
    var i = 0;
    while i < n {
        if is_ws_byte(trimmed.byte_at(i)) {
            return trimmed.slice(0, i);
        }
        i = i + 1;
    }
    return trimmed;
}

pub fn parse_directive_args(content: str) -> str {
    let trimmed = trim_ws(content);
    let n = trimmed.len();
    var i = 0;
    while i < n {
        if is_ws_byte(trimmed.byte_at(i)) {
            return trim_ws(trimmed.slice(i, n));
        }
        i = i + 1;
    }
    return "";
}

pub fn csv_has_symbol(defined_csv: str, sym: str) -> bool {
    let target = trim_ws(sym);
    if target.len() == 0 {
        return false;
    }
    let wrapped = "," + defined_csv + ",";
    let needle = "," + target + ",";
    return find_substr(wrapped, needle) >= 0;
}

pub fn csv_add_symbol(defined_csv: str, sym: str) -> str {
    let target = trim_ws(sym);
    if target.len() == 0 {
        return defined_csv;
    }
    if csv_has_symbol(defined_csv, target) {
        return defined_csv;
    }
    if defined_csv.len() == 0 {
        return target;
    }
    return defined_csv + "," + target;
}

pub fn csv_remove_symbol(defined_csv: str, sym: str) -> str {
    let target = trim_ws(sym);
    if target.len() == 0 || defined_csv.len() == 0 {
        return defined_csv;
    }
    let n = defined_csv.len();
    var out = "";
    var start = 0;
    var i = 0;
    while i <= n {
        if i == n || defined_csv.byte_at(i) == 44 {
            let item = trim_ws(defined_csv.slice(start, i));
            if item.len() > 0 && item != target {
                if out.len() == 0 {
                    out = item;
                } else {
                    out = out + "," + item;
                }
            }
            start = i + 1;
        }
        i = i + 1;
    }
    return out;
}

// Evaluates boolean preprocessor conditions (`DEBUG || (LINUX && !X86)`).
pub fn eval_preproc_condition(expr: str, defined_csv: str) -> bool {
    let trimmed = trim_ws(expr);
    let n = trimmed.len();
    if n == 0 {
        return false;
    }

    // 1. Top-level binary OR (`||`) outside parentheses
    var depth = 0;
    var i = 0;
    while i + 1 < n {
        let b = trimmed.byte_at(i);
        if b == 40 {
            depth = depth + 1;
        } else if b == 41 && depth > 0 {
            depth = depth - 1;
        } else if depth == 0 && b == 124 && trimmed.byte_at(i + 1) == 124 {
            let lhs = trimmed.slice(0, i);
            let rhs = trimmed.slice(i + 2, n);
            if eval_preproc_condition(lhs, defined_csv) {
                return true;
            }
            return eval_preproc_condition(rhs, defined_csv);
        }
        i = i + 1;
    }

    // 2. Top-level binary AND (`&&`) outside parentheses
    depth = 0;
    i = 0;
    while i + 1 < n {
        let b = trimmed.byte_at(i);
        if b == 40 {
            depth = depth + 1;
        } else if b == 41 && depth > 0 {
            depth = depth - 1;
        } else if depth == 0 && b == 38 && trimmed.byte_at(i + 1) == 38 {
            let lhs = trimmed.slice(0, i);
            let rhs = trimmed.slice(i + 2, n);
            if !eval_preproc_condition(lhs, defined_csv) {
                return false;
            }
            return eval_preproc_condition(rhs, defined_csv);
        }
        i = i + 1;
    }

    // 3. Outer parentheses `(...)`
    if trimmed.byte_at(0) == 40 && trimmed.byte_at(n - 1) == 41 {
        return eval_preproc_condition(trimmed.slice(1, n - 1), defined_csv);
    }

    // 4. Unary NOT (`!`)
    if trimmed.byte_at(0) == 33 {
        return !eval_preproc_condition(trimmed.slice(1, n), defined_csv);
    }

    if trimmed == "true" || trimmed == "TRUE" || trimmed == "1" {
        return true;
    }
    if trimmed == "false" || trimmed == "FALSE" || trimmed == "0" {
        return false;
    }
    return csv_has_symbol(defined_csv, trimmed);
}

// Classifies single-directive diagnostic codes (`PREPROC001`..`PREPROC008`).
pub fn classify_directive_code(
    directive: str,
    args: str,
    has_open_if: bool,
    has_else: bool,
    has_open_region: bool
) -> str {
    if directive == "define" {
        if args.len() == 0 {
            return "PREPROC001";
        }
        return "";
    }
    if directive == "undef" || directive == "if" || directive == "region" || directive == "pragma" || directive == "nullable" || directive == "line" {
        return "";
    }
    if directive == "elif" {
        if !has_open_if {
            return "PREPROC002";
        }
        if has_else {
            return "PREPROC003";
        }
        return "";
    }
    if directive == "else" {
        if !has_open_if {
            return "PREPROC002";
        }
        if has_else {
            return "PREPROC003";
        }
        return "";
    }
    if directive == "endif" {
        if !has_open_if {
            return "PREPROC003";
        }
        return "";
    }
    if directive == "error" {
        return "PREPROC005";
    }
    if directive == "warning" {
        return "PREPROC006";
    }
    if directive == "endregion" {
        if !has_open_region {
            return "PREPROC008";
        }
        return "";
    }
    return "PREPROC001";
}

// Validates a source string and returns comma-separated PREPROC001..PREPROC008 diagnostic codes.
pub fn validate_preprocessor_directives(src: str, initial_symbols_csv: str) -> str {
    let n = src.len();
    var cursor = 0;
    var line_num = 1;
    var defined_csv = initial_symbols_csv;
    var if_depth = 0;
    var top_has_else = false;
    var top_active = true;
    var top_met = false;
    var region_depth = 0;
    var diags = "";

    while cursor < n {
        var line_end = cursor;
        while line_end < n && src.byte_at(line_end) != 10 {
            line_end = line_end + 1;
        }
        let line_str = src.slice(cursor, line_end);
        let trimmed = trim_ws(line_str);

        if !(line_num == 1 && starts_with_str(trimmed, "#!")) {
            if trimmed.len() > 0 && trimmed.byte_at(0) == 35 {
                let content = trim_ws(trimmed.slice(1, trimmed.len()));
                let dir = parse_directive_name(content);
                let args = parse_directive_args(content);
                let code = classify_directive_code(dir, args, if_depth > 0, top_has_else, region_depth > 0);
                if code.len() > 0 {
                    if (dir != "error" && dir != "warning") || top_active {
                        diags = csv_add_symbol(diags, code);
                    }
                }
                if dir == "define" && top_active && args.len() > 0 {
                    defined_csv = csv_add_symbol(defined_csv, args);
                } else if dir == "undef" && top_active && args.len() > 0 {
                    defined_csv = csv_remove_symbol(defined_csv, args);
                } else if dir == "if" {
                    if_depth = if_depth + 1;
                    top_has_else = false;
                    let cond = eval_preproc_condition(args, defined_csv);
                    top_met = cond;
                    top_active = cond;
                } else if dir == "elif" && if_depth > 0 && !top_has_else {
                    if top_met {
                        top_active = false;
                    } else {
                        let cond = eval_preproc_condition(args, defined_csv);
                        top_met = cond;
                        top_active = cond;
                    }
                } else if dir == "else" && if_depth > 0 && !top_has_else {
                    top_has_else = true;
                    top_active = !top_met;
                } else if dir == "endif" && if_depth > 0 {
                    if_depth = if_depth - 1;
                    top_has_else = false;
                    top_active = true;
                    top_met = false;
                } else if dir == "region" {
                    region_depth = region_depth + 1;
                } else if dir == "endregion" && region_depth > 0 {
                    region_depth = region_depth - 1;
                }
            }
        }

        if line_end < n {
            cursor = line_end + 1;
        } else {
            cursor = line_end;
        }
        line_num = line_num + 1;
    }

    if if_depth > 0 {
        diags = csv_add_symbol(diags, "PREPROC004");
    }
    if region_depth > 0 {
        diags = csv_add_symbol(diags, "PREPROC007");
    }
    return diags;
}

// Preprocesses raw source and returns active Pilot source with inactive lines replaced by empty lines.
pub fn preprocess_source(src: str, initial_symbols_csv: str) -> str {
    let n = src.len();
    var cursor = 0;
    var line_num = 1;
    var defined_csv = initial_symbols_csv;
    var if_depth = 0;
    var top_has_else = false;
    var top_active = true;
    var top_met = false;
    var out = "";

    while cursor < n {
        var line_end = cursor;
        while line_end < n && src.byte_at(line_end) != 10 {
            line_end = line_end + 1;
        }
        let has_nl = line_end < n;
        let line_str = src.slice(cursor, line_end);
        let trimmed = trim_ws(line_str);
        var emit_line = false;

        if line_num == 1 && starts_with_str(trimmed, "#!") {
            emit_line = false;
        } else if trimmed.len() > 0 && trimmed.byte_at(0) == 35 {
            let content = trim_ws(trimmed.slice(1, trimmed.len()));
            let dir = parse_directive_name(content);
            let args = parse_directive_args(content);
            if dir == "define" && top_active && args.len() > 0 {
                defined_csv = csv_add_symbol(defined_csv, args);
            } else if dir == "undef" && top_active && args.len() > 0 {
                defined_csv = csv_remove_symbol(defined_csv, args);
            } else if dir == "if" {
                if_depth = if_depth + 1;
                top_has_else = false;
                let cond = eval_preproc_condition(args, defined_csv);
                top_met = cond;
                top_active = cond;
            } else if dir == "elif" && if_depth > 0 && !top_has_else {
                if top_met {
                    top_active = false;
                } else {
                    let cond = eval_preproc_condition(args, defined_csv);
                    top_met = cond;
                    top_active = cond;
                }
            } else if dir == "else" && if_depth > 0 && !top_has_else {
                top_has_else = true;
                top_active = !top_met;
            } else if dir == "endif" && if_depth > 0 {
                if_depth = if_depth - 1;
                top_has_else = false;
                top_active = true;
                top_met = false;
            }
            emit_line = false;
        } else {
            emit_line = top_active;
        }

        if emit_line {
            out = out + line_str;
        }
        if has_nl {
            out = out + "\n";
            cursor = line_end + 1;
        } else {
            cursor = line_end;
        }
        line_num = line_num + 1;
    }
    return out;
}

pub fn has_scope_headers(src: str) -> bool {
    let n = src.len();
    var i = 0;
    while i < n {
        let b = src.byte_at(i);
        if b == 58 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

pub fn preprocess_scope_headers(src: str) -> str {
    if has_scope_headers(src) {
        return preprocess_source(src, "");
    }
    return preprocess_source(src, "");
}
