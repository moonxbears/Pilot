// ==============================================================================
// FILE: selfhost/ir/lower.pilot
// F5: lowering the type-checked program to PilIR.
// ==============================================================================
// Reads the linked program the type checker analysed (its snapshot, name
// resolution and inferred types) and builds an `IrModule`. Lowering starts at
// `main` and takes in every function a lowered function calls.
//
// Values are SSA. A `let` binding or a parameter is the value it was given; a
// `var` binding lives in a `stack_slot`, read with `load` and written with
// `store`, so no block parameters are needed to carry it across loops.
// Control flow joins pass values through block parameters (`if` with an
// `else` and the short-circuit `&&` / `||` produce one).
//
// A construct this lowering does not handle yet stops at the seam
// `ir.lower_construct`, naming the node kind.
pub lvl(0) pkg Pilot.SelfHost.Ir.Lower;

use selfhost.check.snapshot.*;
use selfhost.check.types.*;
use selfhost.check.program.*;
use selfhost.check.resolve.*;
use selfhost.check.infer.*;
use selfhost.check.methods.*;
use selfhost.ir.model.*;
use selfhost.ir.layouts.*;
use selfhost.ir.lower_members.*;
use selfhost.ir.lower_switch.*;
use selfhost.ir.lower_try.*;
use selfhost.ir.lower_variant.*;
use selfhost.ir.lower_defer.*;
use selfhost.ir.lower_closure.*;
use selfhost.ir.lower_union.*;
use selfhost.ir.lower_global.*;
use selfhost.ir.lower_unit.*;
use selfhost.ir.lower_setter.*;
use selfhost.ir.lower_destructure.*;

/// The state of one lowering run.
pub struct Lowerer : IObject {
    pub inf: Infer;
    pub ls: IrLayouts;
    pub m: IrModule;
    /// Declaration node -> function index.
    pub fn_index: Map<str, i64>;
    /// Declaration nodes still to lower, in function-index order.
    pub queue: List<i64>;
    /// The receiver type each queued method is lowered for (a bundle's
    /// method is lowered once per type that splices it), or the unknown type.
    pub queue_self: List<i64>;
    /// The engine bindings of the program's `comptime` blocks: the hook word
    /// then its arguments, each as text (`nameof(f)` is `f`).
    pub bindings: List<List<str>>;
    /// The accessor body each queued function lowers (a getter), or -1 for
    /// the declaration's own body.
    pub queue_body: List<i64>;
    /// Per queued function, the type each parameter without an annotation
    /// is specialized to (the unknown type for an annotated one): a function
    /// whose parameters carry no types is lowered once per set of argument
    /// types it is called with.
    pub queue_args: List<List<i64>>;
    /// The field whose accessor is being lowered, or -1.
    pub cur_field: i64;
    /// Declaration node -> binding index.
    pub binding_of: Map<str, i64>;
    // The function being lowered.
    pub f: IrFunction;
    pub cur: u32;
    /// Binding index -> its SSA value (`let`, parameters).
    pub values: Map<str, i64>;
    /// Binding index -> its stack slot (`var`).
    pub slots: Map<str, i64>;
    /// Innermost loop last: the block `continue` goes to and the block `break` goes to.
    pub loop_heads: List<u32>;
    pub loop_exits: List<u32>;
    /// The scope depth (`lower_defer.pilot`) at each loop head and exit, so
    /// `continue` and `break` run the deferred statements they leave.
    pub head_depths: List<i64>;
    pub exit_depths: List<i64>;
    /// Each open block's deferred statements, innermost last.
    pub defers: List<List<i64>>;
    /// Lambda node -> the bindings it captures, and the receiver type it
    /// carries (the unknown type for none); see `lower_closure.pilot`.
    pub lambda_captures: Map<str, List<i64>>;
    pub lambda_self: Map<str, i64>;
    /// Constant -> its pool entry, so each constant is pooled once.
    pub int_pool: Map<str, i64>;
    pub str_pool: Map<str, i64>;
    /// The receiver of the method being lowered, or `ir_no_value()`.
    pub self_value: u32;
    /// Its type.
    pub self_type: i64;
    /// The type the expression being lowered is expected to have (a
    /// binding's annotation, the declared return type), for target-typed
    /// `::Variant`; the unknown type when there is none.
    pub hint: i64;
    /// The declared return type of the function being lowered.
    pub ret_type: i64;
    /// Innermost `try` region last: the block its failures go to, and
    /// whether its catch clause binds a name.
    pub try_blocks: List<u32>;
    pub try_binds: List<bool>;
    /// The type of the failures each region's catch receives: -1 before
    /// the first, the unknown type once two differ.
    pub try_types: List<i64>;
    /// The scope depth at each region's start.
    pub try_depths: List<i64>;
    /// Binding index -> the type the lowering knows for a binding the
    /// checker gives none (a `catch e` whose failures share one type).
    pub known_types: Map<str, i64>;
    /// Name -> top-level bindings of that name (selfhost/ir/lower_global.pilot).
    pub global_named: Map<str, List<i64>>;
    /// Global binding (or kept `comptime` expression) -> module global.
    pub global_of: Map<str, i64>;
    /// Module global -> the node it holds the value of.
    pub global_decls: List<i64>;
    /// The `comptime` nodes scheduled, and those `<start>` already calls.
    pub comptime_nodes: List<i64>;
    pub comptime_called: Map<str, bool>;
    /// `<start>`: the block its prologue continues in, the block of the
    /// top-level statements, and how many globals the prologue has seen.
    pub start_cur: u32;
    pub start_body: u32;
    pub globals_done: i64;
    /// Inside a setter that names no parameter: the value it is given and
    /// its type (selfhost/ir/lower_setter.pilot), else `ir_no_value()`.
    pub setter_arg: u32;
    pub setter_arg_type: i64;
}

/// Lowers `n` expecting type `t` (for target-typed variants).
pub fn lower_hinted(lw: Lowerer, n: i64, t: i64) -> u32 {
    let outer = lw.hint;
    lw.hint = t;
    let v = lower_expr(lw, n);
    lw.hint = outer;
    // A plain value where a failure-capable type is expected is lifted.
    return lift_to(lw, v, type_of(lw.inf, n), t, n);
}

pub fn key(n: i64) -> str => f"{n}";

/// The seed token for engine calls.
pub pure fn engine_token() -> str => "__engine";

/// The text of a binding argument: `nameof(f)` is `f`, a string its value,
/// a name itself.
fn binding_text(p: Program, n: i64) -> str {
    let s = p.s;
    let k = kind(s, n);
    if k == nk_call() {
        let ch = children(s, n);
        return if ch.len() == 2 { binding_text(p, ch[1]) } else { "" };
    }
    if k == nk_str() || k == nk_ident() { return node_name(s, n); }
    // `Cfg.Hooks.receptor`, `33`: what the constant tables make of it.
    return prog_const_text(p, n);
}

/// Every `__engine("<hook>", args..)` call of the linked program whose hook
/// is a string: `[hook, args..]` as text.
fn read_engine_bindings(p: Program) -> List<List<str>> {
    let s = p.s;
    var out: List<List<str>> = [];
    var n = 0;
    while n < s.count {
        if kind(s, n) == nk_call() {
            let ch = children(s, n);
            if ch.len() >= 3 && kind(s, ch[0]) == nk_ident() && node_name(s, ch[0]) == engine_token() && binding_text(p, ch[1]) != "" {
                var row: List<str> = [];
                var i = 1;
                while i < ch.len() {
                    row.push(binding_text(p, ch[i]));
                    i = i + 1;
                }
                out.push(row);
            }
        }
        n = n + 1;
    }
    return out;
}

/// The last argument of the binding `hook(keys.., value)` whose leading
/// arguments are `keys`, or "".
pub fn bound(lw: Lowerer, hook: str, keys: List<str>) -> str {
    for row in lw.bindings {
        if row.len() != keys.len() + 2 || row[0] != hook { continue; }
        var i = 0;
        var same = true;
        while i < keys.len() {
            if row[i + 1] != keys[i] { same = false; }
            i = i + 1;
        }
        if same { return row[row.len() - 1]; }
    }
    return "";
}

/// The binding words (stdlib/core/builtins/native_calls.pilot): a function,
/// method, property, or member of one type answered by an engine operation,
/// and how a list literal is built.
pub pure fn native_fn_hook() -> str => "bind_native_fn";
pub pure fn native_method_hook() -> str => "bind_native_method";
pub pure fn native_property_hook() -> str => "bind_native_property";
pub pure fn native_member_hook() -> str => "bind_native_member";
pub pure fn list_literal_hook() -> str => "bind_list_literal";
pub pure fn list_splat_hook() -> str => "bind_list_splat";
pub pure fn operator_intrinsic_hook() -> str => "bind_operator_intrinsic";
pub pure fn map_literal_hook() -> str => "bind_map_literal";
/// A compile-time question about a type argument (`sizeof(T)`), and the
/// question that asks for its size in bytes.
pub pure fn type_query_hook() -> str => "bind_type_query";
pub pure fn receptor_hook() -> str => "bind_receptor";
/// The receptor category and slot of a call that quotes its argument's
/// name (`RECEPTOR_SYMBOL_QUOTE` in crates/pilot-parser pilot_impls.rs).
pub pure fn symbol_quote_category() -> str => "33";
pub pure fn symbol_quote_slot() -> str => "25";
pub pure fn byte_size_query() -> str => "byte_size";

/// Lowers the program the checker analysed, starting at its `main`.
pub fn lower_program(inf: Infer) -> IrModule => lower_program_rooted(inf, false);

/// Lowers the program; with `every_function`, also every concrete function
/// the user's files declare at top level, whether or not anything calls it
/// (a library emitted to another language, selfhost/transpile/source.pilot).
pub fn lower_program_rooted(inf: Infer, every_function: bool) -> IrModule {
    let p = inf.p;
    let m = ir_module_new();
    let binding_of = Map<str, i64>();
    var b = 0;
    while b < inf.r.site.len() {
        binding_of.set(key(inf.r.site[b]), b);
        b = b + 1;
    }
    let lw = Lowerer {
        inf: inf, ls: layouts_new(p, m), m: m, fn_index: Map<str, i64>(), queue: [], queue_self: [],
        bindings: read_engine_bindings(p), queue_body: [], queue_args: [], cur_field: -1, binding_of: binding_of,
        f: ir_function_new("", ir_physics_new(0, 0, 0, 0, 0)), cur: 0,
        values: Map<str, i64>(), slots: Map<str, i64>(), loop_heads: [], loop_exits: [], head_depths: [], exit_depths: [], defers: [],
        lambda_captures: Map<str, List<i64>>(), lambda_self: Map<str, i64>(),
        int_pool: Map<str, i64>(), str_pool: Map<str, i64>(), self_value: ir_no_value(), self_type: ty_unknown(), hint: ty_unknown(), ret_type: ty_unknown(),
        try_blocks: [], try_binds: [], try_types: [], try_depths: [], known_types: Map<str, i64>(),
        global_named: global_names(p), global_of: Map<str, i64>(), global_decls: [],
        comptime_nodes: [], comptime_called: Map<str, bool>(), start_cur: 0, start_body: 0, globals_done: 0,
        setter_arg: ir_no_value(), setter_arg_type: ty_unknown(),
    };
    // Function 0 is `<start>` (selfhost/ir/lower_global.pilot).
    lw.queue.push(-1);
    lw.queue_self.push(ty_unknown());
    lw.queue_body.push(-1);
    lw.queue_args.push([]);
    m.functions.push(ir_function_new("<start>", layout_unknown(lw.ls)));
    let mains = nl_get(p.fns, "main");
    lower_start(lw, if mains.len() > 0 { mains[mains.len() - 1] } else { -1 });
    if every_function {
        for d in user_functions(lw) { let _ = function_index(lw, d, ty_unknown()); }
    }
    var i = 1;
    var more = true;
    while more {
        while i < lw.queue.len() {
            lower_function(lw, i);
            i = i + 1;
        }
        more = extend_start(lw) || i < lw.queue.len();
    }
    close_start(lw);
    return m;
}

/// Starts lowering into function `f`: no locals, loops, scopes or receiver.
pub fn begin_function(lw: Lowerer, f: IrFunction) {
    lw.f = f;
    lw.values = Map<str, i64>();
    lw.slots = Map<str, i64>();
    lw.loop_heads = [];
    lw.loop_exits = [];
    lw.head_depths = [];
    lw.exit_depths = [];
    lw.defers = [];
    lw.try_blocks = [];
    lw.try_binds = [];
    lw.try_types = [];
    lw.try_depths = [];
    lw.known_types = Map<str, i64>();
    lw.self_value = ir_no_value();
    lw.setter_arg = ir_no_value();
    lw.self_type = ty_unknown();
    lw.cur_field = -1;
    lw.ret_type = ty_unknown();
}

/// The index of the function declared by `decl` for receiver type `self_t`
/// (the unknown type for a free function), queuing it for lowering.
pub fn function_index(lw: Lowerer, decl: i64, self_t: i64) -> i64 => specialized_index(lw, decl, self_t, []);

/// The index of the function declared by `decl` for receiver type `self_t`
/// with its unannotated parameters specialized to `arg_types` (empty, or
/// one type per parameter, unknown where the parameter has its own).
pub fn specialized_index(lw: Lowerer, decl: i64, self_t: i64, arg_types: List<i64>) -> i64 {
    let s = lw.inf.p.s;
    var spec = "";
    var shown = "";
    for t in arg_types {
        spec = spec + f",{t}";
        if shown.len() > 0 { shown = shown + ","; }
        shown = shown + if ty_is_unknown(lw.inf.p.tt, t) { "_" } else { ty_display(lw.inf.p.tt, t).replace(" ", "") };
    }
    let owner = owner_type_decl(lw, decl);
    let recv = if owner < 0 || is_static_decl(s, decl) { ty_unknown() } else if ty_is_named(lw.inf.p.tt, self_t) { self_t } else { owner_type(lw, owner) };
    let k = f"{decl}@{recv}{spec}";
    if lw.fn_index.has(k) { return lw.fn_index.get(k); }
    let idx = lw.queue.len();
    lw.fn_index.set(k, idx);
    lw.queue.push(decl);
    lw.queue_self.push(recv);
    lw.queue_body.push(-1);
    lw.queue_args.push(arg_types);
    let own = if kind(s, decl) == nk_ctor() { s.receiver } else { node_name(s, decl) };
    let type_name = if ty_is_named(lw.inf.p.tt, recv) { ty_display(lw.inf.p.tt, recv) } else if owner >= 0 { node_name(s, owner) } else { "" };
    let base = if type_name.len() > 0 { type_name + "." + own } else { own };
    let name = if spec == "" { base } else { base + "(" + shown + ")" };
    lw.m.functions.push(ir_function_new(name, layout_unknown(lw.ls)));
    return idx;
}

/// The index of the function that runs accessor `body` of field `field` for
/// receiver type `self_t`, queuing it for lowering.
pub fn accessor_index(lw: Lowerer, field: i64, body: i64, self_t: i64) -> i64 {
    let s = lw.inf.p.s;
    let k = f"{field}:{body}@{self_t}";
    if lw.fn_index.has(k) { return lw.fn_index.get(k); }
    let idx = lw.queue.len();
    lw.fn_index.set(k, idx);
    lw.queue.push(field);
    lw.queue_self.push(self_t);
    lw.queue_body.push(body);
    lw.queue_args.push([]);
    lw.m.functions.push(ir_function_new(ty_display(lw.inf.p.tt, self_t) + "." + node_name(s, field), layout_unknown(lw.ls)));
    return idx;
}

pub fn physics_of_type_node(lw: Lowerer, t: i64) -> IrTypePhysics {
    if t < 0 { return layout_unknown(lw.ls); }
    return layout_of(lw.ls, prog_annot_type(lw.inf.p, t));
}

pub fn physics_of(lw: Lowerer, n: i64) -> IrTypePhysics => layout_of(lw.ls, type_of(lw.inf, n));

pub fn lower_function(lw: Lowerer, idx: i64) {
    let s = lw.inf.p.s;
    let decl = lw.queue[idx];
    let f = lw.m.functions[idx];
    begin_function(lw, f);
    if kind(s, decl) == nk_comptime() {
        lower_comptime_run(lw, decl, f);
        return;
    }
    lw.ret_type = if annot(s, decl) >= 0 { prog_annot_type(lw.inf.p, annot(s, decl)) } else if lw.queue_body[idx] < 0 && kind(s, decl) != nk_lambda() { inferred_return(lw, decl) } else { ty_unknown() };
    f.ret_physics = if annot(s, decl) >= 0 { physics_of_type_node(lw, annot(s, decl)) } else { layout_of(lw.ls, lw.ret_type) };
    lw.cur = ir_add_block(f);
    if ty_is_named(lw.inf.p.tt, lw.queue_self[idx]) {
        // A method's receiver is its first parameter.
        lw.self_type = lw.queue_self[idx];
        lw.self_value = ir_add_param(f, lw.cur, layout_of(lw.ls, lw.self_type));
    }
    if is_setter_fn(lw, idx) {
        lower_setters(lw, idx);
        return;
    }
    let accessor = lw.queue_body[idx];
    lw.cur_field = if accessor >= 0 { decl } else { -1 };
    let is_lambda = kind(s, decl) == nk_lambda();
    if is_lambda { lambda_params(lw, decl, f); }
    var params: List<i64> = if accessor >= 0 || is_lambda { [] } else { decl_params(s, decl) };
    if lw.self_value != ir_no_value() && accessor < 0 {
        // `fn f(self, ..)`: the explicit receiver is the receiver parameter.
        let r = receiver_param(s, decl);
        if r >= 0 && lw.binding_of.has(key(r)) { lw.values.set(key(lw.binding_of.get(key(r))), lw.self_value); }
        params = method_params(s, decl);
    }
    let spec = lw.queue_args[idx];
    var pi = 0;
    for param in params {
        let t = if pi < spec.len() { spec[pi] } else { ty_unknown() };
        let given = !ty_is_unknown(lw.inf.p.tt, t);
        let v = ir_add_param(f, lw.cur, if given { layout_of(lw.ls, t) } else { physics_of_type_node(lw, rhs(s, param)) });
        if lw.binding_of.has(key(param)) {
            let b = lw.binding_of.get(key(param));
            lw.values.set(key(b), v);
            if given { lw.known_types.set(key(b), t); }
        }
        pi = pi + 1;
    }
    let body = if accessor >= 0 { accessor } else if is_lambda { rhs(s, decl) } else { decl_body(s, decl) };
    if body < 0 {
        let _ = seam("ir.lower_construct", f"`{node_name(s, decl)}` has no body to lower");
        return;
    }
    // `=> expr` is the returned value, so it is lowered against the return type.
    let v = if kind(s, body) == nk_block() { lower_expr(lw, body) } else { lower_hinted(lw, body, lw.ret_type) };
    if !ir_is_terminated(f, lw.cur) {
        // `=> expr` and a function with a declared return type return the
        // body's value; a block body without one returns nothing.
        let returns_value = annot(s, decl) >= 0 || kind(s, body) != nk_block();
        let args: List<u32> = if returns_value { [coerce(lw, as_member_of(lw, v, value_type(lw, body), lw.ret_type, body), f.ret_physics, body)] } else { [] };
        let _ = ir_emit(f, lw.cur, op_return(), 0, f.ret_physics, args, false, span_start(s, body));
    }
}

// ------------------------------------------------------------------------------
// Emission helpers
// ------------------------------------------------------------------------------

pub fn emit(lw: Lowerer, op: u16, sub: u16, phy: IrTypePhysics, args: List<u32>, n: i64) -> u32 =>
    ir_emit(lw.f, lw.cur, op, sub, phy, args, true, span_start(lw.inf.p.s, n));

pub fn emit_void(lw: Lowerer, op: u16, sub: u16, args: List<u32>, n: i64) {
    let _ = ir_emit(lw.f, lw.cur, op, sub, layout_unknown(lw.ls), args, false, span_start(lw.inf.p.s, n));
}

/// Ends the current block with `unreachable` carrying the runtime error
/// `message`, the one the seed's trap at that place reports.
pub fn emit_trap(lw: Lowerer, message: str, n: i64) {
    let text = emit(lw, op_const_bytes(), 0, layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_str()))), [pool_str(lw, message)], n);
    emit_void(lw, op_unreachable(), 0, [text], n);
}

/// The value of a construct that has none.
pub fn unit_value(lw: Lowerer, n: i64) -> u32 => emit(lw, op_undef(), 0, physics_of(lw, n), [], n);

/// Continues in `b`.
pub fn switch_to(lw: Lowerer, b: u32) { lw.cur = b; }

/// Jumps from the current block to `target` with `args`, unless the current
/// block already ended.
pub fn jump_to(lw: Lowerer, target: u32, args: List<u32>, n: i64) {
    if ir_is_terminated(lw.f, lw.cur) { return; }
    var ops: List<u32> = [target];
    for a in args { ops.push(a); }
    emit_void(lw, op_jump(), 0, ops, n);
}

/// After a terminator, code that follows has no predecessor; it is lowered
/// into a fresh block so every block still ends in one terminator.
pub fn ensure_open(lw: Lowerer) {
    if ir_is_terminated(lw.f, lw.cur) { lw.cur = ir_add_block(lw.f); }
}

pub fn pool_int(lw: Lowerer, v: i64) -> u32 {
    let k = f"{v}";
    if lw.int_pool.has(k) { return lw.int_pool.get(k); }
    lw.m.ints.push(v);
    lw.int_pool.set(k, lw.m.ints.len - 1);
    return lw.m.ints.len - 1;
}

/// The pool index of the float whose binary64 bits are `bits`.
pub fn pool_float(lw: Lowerer, bits: i64) -> u32 {
    var i = 0;
    while i < lw.m.floats.len {
        if lw.m.floats[i] == bits { return i; }
        i = i + 1;
    }
    lw.m.floats.push(bits);
    return lw.m.floats.len - 1;
}

pub fn pool_str(lw: Lowerer, v: str) -> u32 {
    if lw.str_pool.has(v) { return lw.str_pool.get(v); }
    lw.m.strings.push(v);
    lw.str_pool.set(v, lw.m.strings.len - 1);
    return lw.m.strings.len - 1;
}

pub fn intrinsic_index(lw: Lowerer, hook: str) -> u32 {
    var i = 0;
    while i < lw.m.intrinsics.len {
        if lw.m.intrinsics[i] == hook { return i; }
        i = i + 1;
    }
    lw.m.intrinsics.push(hook);
    return lw.m.intrinsics.len - 1;
}

pub fn unsupported(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    return seam("ir.lower_construct", f"node kind {kind(s, n)} (`{node_text(s, n)}`) is not lowered to PilIR yet");
}

// ------------------------------------------------------------------------------
// Expressions and statements
// ------------------------------------------------------------------------------

/// Lowers `n` and returns its value (an `undef` of its type when it has none).
pub fn lower_expr(lw: Lowerer, n: i64) -> u32 {
    ensure_open(lw);
    let s = lw.inf.p.s;
    let k = kind(s, n);
    if k == nk_int() { return emit(lw, op_const_bits(), 0, physics_of(lw, n), [pool_int(lw, lit_value(s, n))], n); }
    if k == nk_float() { return emit(lw, op_const_float(), 0, physics_of(lw, n), [pool_float(lw, lit_value(s, n))], n); }
    if k == nk_bool() { return emit(lw, op_const_bits(), 0, physics_of(lw, n), [pool_int(lw, lit_value(s, n))], n); }
    if k == nk_str() { return emit(lw, op_const_bytes(), 0, physics_of(lw, n), [pool_str(lw, node_name(s, n))], n); }
    if k == nk_ident() { return lower_ident(lw, n); }
    if k == nk_binary() { return lower_binary(lw, n); }
    if k == nk_unary() { return lower_unary(lw, n); }
    if k == nk_call() { return lower_call(lw, n); }
    if k == nk_member() { return lower_member(lw, n); }
    if k == nk_index() { return lower_index(lw, n); }
    if k == nk_list() { return lower_list_literal(lw, n); }
    if k == nk_map() { return lower_map_literal(lw, n); }
    if k == nk_for() { return lower_for(lw, n); }
    if k == nk_block() { return lower_block(lw, n); }
    if k == nk_expr_stmt() { return lower_expr(lw, lhs(s, n)); }
    if k == nk_if() { return lower_if(lw, n); }
    if k == nk_while() { return lower_while(lw, n); }
    if k == nk_match() { return lower_switch(lw, n); }
    if k == nk_tuple() { return lower_tuple(lw, n); }
    if k == nk_none() { return lower_none(lw, n); }
    if k == nk_coalesce() { return lower_coalesce(lw, n); }
    if k == nk_try_propagate() { return lower_try_propagate(lw, n); }
    if k == nk_catch_recovery() { return lower_catch_recovery(lw, n); }
    if k == nk_try() { return lower_try_stmt(lw, n); }
    if k == nk_guard() { return lower_guard(lw, n); }
    if k == nk_defer() { return lower_defer(lw, n); }
    if k == nk_lambda() { return lower_lambda(lw, n); }
    if k == nk_comptime() { return lower_comptime(lw, n); }
    if k == nk_unit_lit() { return lower_unit_literal(lw, n); }
    if k == nk_cascade() { return lower_cascade(lw, n); }
    if k == nk_let() || k == nk_var() || k == nk_const() { return lower_binding(lw, n); }
    if k == nk_assign() { return lower_assign(lw, n); }
    if k == nk_return() { return lower_return(lw, n); }
    if k == nk_break() || k == nk_continue() { return lower_loop_exit(lw, n); }
    return unsupported(lw, n);
}

pub fn lower_block(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let items = children(s, n);
    open_scope(lw);
    var last = ir_no_value();
    var i = 0;
    while i < items.len() {
        let item = items[i];
        let v = lower_expr(lw, item);
        let k = kind(s, item);
        let yields = k == nk_expr_stmt() || k == nk_if() || k == nk_match() || k == nk_block();
        last = if yields { v } else { ir_no_value() };
        i = i + 1;
    }
    close_scope(lw);
    // A block that ended in a terminator has no value to give.
    if ir_is_terminated(lw.f, lw.cur) { return ir_no_value(); }
    return if last == ir_no_value() { unit_value(lw, n) } else { last };
}

pub fn binding_index(lw: Lowerer, ident: i64) -> i64 => lw.inf.r.ref_of[ident];

pub fn lower_ident(lw: Lowerer, n: i64) -> u32 {
    let b = binding_index(lw, n);
    if b < 0 && is_receiver_word(lw, n) { return lw.self_value; }
    if b < 0 && is_backing_word(lw, n) { return lower_backing_read(lw, n); }
    if b < 0 && is_setter_word(lw, n) { return lw.setter_arg; }
    let g = find_global(lw, n);
    if g >= 0 { return lower_global_read(lw, g, n); }
    if b < 0 {
        // `::Low`: a variant of the enum the context expects.
        let t = if ty_is_unknown(lw.inf.p.tt, type_of(lw.inf, n)) { lw.hint } else { type_of(lw.inf, n) };
        if some tag = variant_tag(lw.inf.p, t, node_name(lw.inf.p.s, n)) {
            return emit(lw, op_const_bits(), 0, layout_of(lw.ls, t), [pool_int(lw, tag)], n);
        }
        if some v = lower_variant_name(lw, n) { return v; }
        if some v = lower_function_value(lw, n) { return v; }
    }
    if b < 0 { return unsupported(lw, n); }
    let k = key(b);
    if lw.values.has(k) { return lw.values.get(k); }
    if lw.slots.has(k) { return emit(lw, op_load(), 0, physics_of(lw, n), [lw.slots.get(k)], n); }
    return unsupported(lw, n);
}

pub fn lower_binding(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let value_node = rhs(s, n);
    if is_pattern_let(s, n) { return lower_pattern_let(lw, n); }
    if !lw.binding_of.has(key(n)) { return unsupported(lw, n); }
    let bi = lw.binding_of.get(key(n));
    if value_node >= 0 {
        // A binding keeps the type its value has as far as the lowering
        // knows it when the checker gives it none (a map literal's) or one
        // without the union its value holds (a mixed list).
        let bt = binding_type(lw.inf, bi);
        let vt = value_type(lw, value_node);
        let better = ty_is_unknown(lw.inf.p.tt, bt) || (holds_union(lw.inf.p.tt, vt) && vt != bt);
        if !ty_is_unknown(lw.inf.p.tt, vt) && better { lw.known_types.set(key(bi), vt); }
    }
    let phy = layout_of(lw.ls, binding_type(lw.inf, bi));
    let v = if value_node >= 0 { coerce(lw, lower_hinted(lw, value_node, binding_type(lw.inf, bi)), phy, n) } else { emit(lw, op_undef(), 0, phy, [], n) };
    let b = key(bi);
    if kind(s, n) == nk_var() {
        let slot = emit(lw, op_stack_slot(), 0, phy, [], n);
        emit_void(lw, op_store(), 0, [slot, v], n);
        lw.slots.set(b, slot);
    } else {
        lw.values.set(b, v);
    }
    return v;
}

pub fn lower_assign(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let target = lhs(s, n);
    if kind(s, target) == nk_member() { return lower_field_assign(lw, n); }
    if kind(s, target) == nk_index() { return lower_index_assign(lw, n); }
    if kind(s, target) != nk_ident() { return unsupported(lw, n); }
    if binding_index(lw, target) < 0 && is_backing_word(lw, target) { return lower_backing_write(lw, n); }
    let global = find_global(lw, target);
    if global >= 0 {
        var gv = lower_expr(lw, rhs(s, n));
        if flags(s, n) != 0 {
            let ir_op = arith_opcode(flags(s, n));
            if ir_op == 0 { return unsupported(lw, n); }
            gv = emit(lw, ir_op, 0, physics_of(lw, target), [lower_global_read(lw, global, target), gv], n);
        }
        lower_global_write(lw, global, gv, n);
        return unit_value(lw, n);
    }
    let b = binding_index(lw, target);
    if b < 0 || !lw.slots.has(key(b)) { return unsupported(lw, n); }
    let slot = lw.slots.get(key(b));
    var v = lower_expr(lw, rhs(s, n));
    let op = flags(s, n);
    if op != 0 {
        let ir_op = arith_opcode(op);
        if ir_op == 0 { return unsupported(lw, n); }
        let old = emit(lw, op_load(), 0, physics_of(lw, target), [slot], n);
        v = emit(lw, ir_op, 0, physics_of(lw, target), [old, v], n);
    }
    emit_void(lw, op_store(), 0, [slot, coerce(lw, v, physics_of(lw, target), n)], n);
    return unit_value(lw, n);
}

/// The IR opcode of an arithmetic or bitwise `BinaryOp` code, or 0.
pub fn arith_opcode(op: i64) -> u16 {
    // BinaryOp codes (crates/pilot-ast): Add 1, Sub 2, Mul 3, Div 4, Rem 6,
    // BitAnd 16, BitOr 17, BitXor 18, Shl 19, Shr 20.
    let codes: List<i64> = [1, 2, 3, 4, 6, 16, 17, 18, 19, 20];
    let ops: List<u16> = [op_add(), op_sub(), op_mul(), op_div(), op_rem(), op_bit_and(), op_bit_or(), op_bit_xor(), op_shl(), op_shr()];
    var i = 0;
    while i < codes.len() {
        if codes[i] == op { return ops[i]; }
        i = i + 1;
    }
    return 0;
}

/// The `CmpPred` of a comparison `BinaryOp` code (Eq 8 .. Ge 13), or -1.
pub fn cmp_pred_of(op: i64) -> i64 => if op >= op_eq() && op <= op_ge() { op - op_eq() } else { -1 };

/// `BinaryOp` codes (crates/pilot-ast) of the pipes.
pub pure fn op_pipe() -> i64 => 21;
pub pure fn op_pipe_back() -> i64 => 31;
pub pure fn op_as() -> i64 => 32;

/// The spelling of each `BinaryOp` code, from 1 (crates/pilot-ast
/// `BinaryOp::symbol`); an operator a program binds to a function
/// (`bind_operator_fn`) is found by it.
pub fn binary_op_symbols() -> List<str> => [
    "", "+", "-", "*", "/", "//", "%", "**", "==", "!=", "<", "<=", ">", ">=", "and", "or",
    "&", "|", "^", "<<", ">>", "|>", "??", "..=", "..", "is", ":=", "<-", "union", "intersect",
    "except", "<|", "as", "as view", "<=>", "+|", "-|", "*|", "+%", "-%", "*%", "+?", "-?", "*?",
    "%%", "~>", ">..<", ">..", ":=:",
];

/// `x |> f` / `f <| x` is `f(x)`; `x |> f(y)` is `f(x, y)`.
pub fn lower_pipe(lw: Lowerer, n: i64, value: i64, target: i64) -> u32 {
    let s = lw.inf.p.s;
    let v = lower_expr(lw, value);
    if kind(s, target) == nk_call() {
        let ch = children(s, target);
        var arg_nodes: List<i64> = [];
        var i = 1;
        while i < ch.len() {
            arg_nodes.push(ch[i]);
            i = i + 1;
        }
        let callee = ch[0];
        if kind(s, callee) == nk_member() && (flags(s, callee) == member_implied() || lhs(s, callee) < 0) {
            // `x |> .m(a)`: method `m` called on the piped value.
            return member_call(lw, v, value_type(lw, value), sym_text(s, rhs(s, callee)), arg_nodes, physics_of(lw, n), n);
        }
        return lower_fn_call(lw, callee, [v], arg_nodes, physics_of(lw, n), n);
    }
    return lower_fn_call(lw, target, [v], [], physics_of(lw, n), n);
}

pub fn lower_binary(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let op = flags(s, n);
    if op == op_and() || op == op_or() { return lower_short_circuit(lw, n, op == op_and()); }
    if op == op_pipe() { return lower_pipe(lw, n, lhs(s, n), rhs(s, n)); }
    if op == op_as() { return lower_cast(lw, n, lhs(s, n)); }
    if op == op_coalesce() { return lower_coalesce(lw, n); }
    if op == op_pipe_back() { return lower_pipe(lw, n, rhs(s, n), lhs(s, n)); }
    let symbols = binary_op_symbols();
    let bound_fn = if op > 0 && op < symbols.len() { bound(lw, "bind_operator_fn", [symbols[op]]) } else { "" };
    if bound_fn != "" {
        let fns = nl_get(lw.inf.p.fns, bound_fn);
        if fns.len() != 1 { return unsupported(lw, n); }
        let a = lower_expr(lw, lhs(s, n));
        let b = lower_expr(lw, rhs(s, n));
        return call_decl(lw, fns[0], [a, b], [], physics_of(lw, n), n);
    }
    // A type that declares the operator (`op ==`, `op +`) runs its own.
    if op > 0 && op < symbols.len() {
        let lt = value_type(lw, lhs(s, n));
        if runs_as_code(lw, lt, symbols[op]) {
            let recv = lower_expr(lw, lhs(s, n));
            return member_call(lw, recv, lt, symbols[op], [rhs(s, n)], physics_of(lw, n), n);
        }
    }
    let ir_op = arith_opcode(op);
    let pred = cmp_pred_of(op);
    // An operator with no instruction of its own runs as the engine
    // operation bound to its symbol.
    let native = if ir_op == 0 && pred < 0 && op > 0 && op < symbols.len() { bound(lw, operator_intrinsic_hook(), [symbols[op]]) } else { "" };
    if ir_op == 0 && pred < 0 && native == "" { return unsupported(lw, n); }
    // Each side is lowered against the other's type (`x == none`,
    // `c == ::Red`), as far as the lowering knows it.
    // Arithmetic (`"<" + line`) takes each side as it is.
    let a = if pred < 0 { lower_expr(lw, lhs(s, n)) } else { lower_hinted(lw, lhs(s, n), value_type(lw, rhs(s, n))) };
    let b = if pred < 0 { lower_expr(lw, rhs(s, n)) } else { lower_hinted(lw, rhs(s, n), value_type(lw, lhs(s, n))) };
    if native != "" { return emit(lw, op_call_intrinsic(), intrinsic_index(lw, native), physics_of(lw, n), [a, b], n); }
    if ir_op != 0 { return emit(lw, ir_op, 0, physics_of(lw, n), [a, b], n); }
    return emit(lw, op_cmp(), pred, physics_of(lw, n), [a, b], n);
}

/// `a && b` / `a || b`: `b` runs only when `a` does not decide the result.
pub fn lower_short_circuit(lw: Lowerer, n: i64, is_and: bool) -> u32 {
    let s = lw.inf.p.s;
    let a = lower_expr(lw, lhs(s, n));
    let rhs_block = ir_add_block(lw.f);
    let join = ir_add_block(lw.f);
    let result = ir_add_param(lw.f, join, physics_of(lw, n));
    let args: List<u32> = if is_and { [a, rhs_block, 0, join, 1, a] } else { [a, join, 1, a, rhs_block, 0] };
    emit_void(lw, op_cond_br(), 0, args, n);
    switch_to(lw, rhs_block);
    let b = lower_expr(lw, rhs(s, n));
    jump_to(lw, join, [b], n);
    switch_to(lw, join);
    return result;
}

pub fn lower_unary(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let op = flags(s, n);
    // UnaryExpr flags (crates/pilot-vm lower_expr.rs): 0 neg, 1 identity,
    // 4 bitwise not, 5 logical not.
    if op == 1 { return lower_expr(lw, lhs(s, n)); }
    if op == unary_some() { return lower_some(lw, n); }
    if op != 0 && op != 4 && op != 5 { return unsupported(lw, n); }
    let x = lower_expr(lw, lhs(s, n));
    let phy = physics_of(lw, n);
    if op == 0 {
        // A float negates as `-0.0 - x`, which flips the sign of zero too
        // (IEEE 754-2019 section 6.3); an integer as `0 - x`.
        let zero = if phy.reg_class == reg_class_simd_float() {
            // The bits of -0.0: the sign bit alone.
            emit(lw, op_const_float(), 0, phy, [pool_float(lw, -9223372036854775807 - 1)], n)
        } else {
            emit(lw, op_const_bits(), 0, phy, [pool_int(lw, 0)], n)
        };
        return emit(lw, op_sub(), 0, phy, [zero, x], n);
    }
    if op == 5 {
        // `!x` is `x == false`: a zero constant of the operand value's 1-bit
        // layout (the checker may not know it, as inside a getter).
        // A logical not is a bool, also when the operand's type is unknown
        // (an engine method's result).
        let truth = layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_bool())));
        let xp = lw.f.value_physics[x];
        let f_val = emit(lw, op_const_bits(), 0, if in_register(xp) { xp } else { truth }, [pool_int(lw, 0)], n);
        return emit(lw, op_cmp(), 0, truth, [x, f_val], n);
    }
    let mask = emit(lw, op_const_bits(), 0, phy, [pool_int(lw, -1)], n);
    return emit(lw, op_bit_xor(), 0, phy, [x, mask], n);
}

/// `x as T` and `T(x)`: `x` converted to `T`'s register layout.
pub fn lower_cast(lw: Lowerer, n: i64, value: i64) -> u32 {
    let to = physics_of(lw, n);
    let v = lower_expr(lw, value);
    // A value outside a register (a string) is converted as the seed does:
    // the `cast` fails at run time with the seed's error.
    if !in_register(to) { return unsupported(lw, n); }
    return emit(lw, op_cast(), 0, to, [v], n);
}

/// `sizeof(T)`: the size the checker's layout of `T` gives, as a constant.
/// A type whose layout the checker does not know stops at the lowering seam.
fn lower_type_query(lw: Lowerer, n: i64, query: str, arg: i64) -> u32 {
    let t = type_receiver(lw.inf, arg);
    if query != byte_size_query() || !ty_is_named(lw.inf.p.tt, t) { return unsupported(lw, n); }
    guard some e = type_extent(lw.inf.p, t, 0) else { return unsupported(lw, n); }
    return emit(lw, op_const_bits(), 0, physics_of(lw, n), [pool_int(lw, e.size as i64)], n);
}

/// The seam a call-quote mode stops at, with the seed's message
/// (crates/pilot-vm/src/lower_call.rs QUOTED_CALL_SEAM).
pub fn call_quote_seam() -> str =>
    "SEAM001: unconnected seam `vm.call_quote`: call-quote modes build their carrier values once the type checker exists (F4)";

pub fn lower_call(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let ch = children(s, n);
    // A call-quote mode (`f!(..)`, `sig f(..)`, ..) is recorded in the call's
    // flags; its carrier values do not exist yet, so it stops at the seed's
    // seam, at the callee as the seed reports it.
    if flags(s, n) != 0 {
        emit_trap(lw, call_quote_seam(), ch[0]);
        switch_to(lw, ir_add_block(lw.f));
        return unit_value(lw, n);
    }
    var i = 1;
    let callee = ch[0];
    if kind(s, callee) == nk_ident() && binding_index(lw, callee) < 0 && ch.len() == 2 {
        let query = bound(lw, type_query_hook(), [node_name(s, callee)]);
        if query != "" { return lower_type_query(lw, n, query, ch[1]); }
        if bound(lw, receptor_hook(), [node_name(s, callee), symbol_quote_category()]) == symbol_quote_slot() {
            // `nameof(x)`: the name `x` as a string.
            let k = kind(s, ch[1]);
            if k != nk_ident() && k != nk_str() && k != nk_type_named() { return unsupported(lw, n); }
            return emit(lw, op_const_bytes(), 0, physics_of(lw, n), [pool_str(lw, node_name(s, ch[1]))], n);
        }
    }
    if some v = lower_variant_call(lw, n) { return v; }
    if kind(s, callee) == nk_ident() && binding_index(lw, callee) < 0 {
        let as_type = type_receiver(lw.inf, callee);
        if ty_is_named(lw.inf.p.tt, as_type) && ch.len() == 2 && kind(s, ch[1]) == nk_map() {
            return lower_struct_literal(lw, n, ch[1]);
        }
        // A type the engine holds (`List()`, `Map()`) is built by the engine
        // operation bound to its name, unless the program links a
        // constructor of it.
        let engine_built = bound(lw, native_fn_hook(), [node_name(s, callee)]) != "" && !links_constructor(lw, as_type);
        // A type held in one register converts its one argument.
        if ty_is_named(lw.inf.p.tt, as_type) && ch.len() == 2 && !engine_built && !links_constructor(lw, as_type)
            && kind(s, ch[1]) != nk_call_arg() && in_register(layout_of(lw.ls, as_type)) {
            return lower_cast(lw, n, ch[1]);
        }
        if ty_is_named(lw.inf.p.tt, as_type) && called_fn(lw.inf, n) < 0 && !engine_built { return lower_construction(lw, n, as_type); }
    }
    if kind(s, callee) == nk_member() { return lower_method_call(lw, n); }
    if some v = lower_sibling_call(lw, n) { return v; }
    if some v = lower_target_call(lw, n) { return v; }
    var arg_nodes: List<i64> = [];
    i = 1;
    while i < ch.len() {
        arg_nodes.push(ch[i]);
        i = i + 1;
    }
    return lower_fn_call(lw, callee, [], arg_nodes, physics_of(lw, n), n);
}

/// The top-level function a callee name means: the only one of that name,
/// or, when several units declare one, the one in the caller's own unit;
/// -1 when none or it cannot be told.
pub fn resolve_fn(lw: Lowerer, callee: i64) -> i64 {
    let s = lw.inf.p.s;
    if kind(s, callee) != nk_ident() || binding_index(lw, callee) >= 0 { return -1; }
    let fns = nl_get(lw.inf.p.fns, node_name(s, callee));
    if fns.len() == 1 { return fns[0]; }
    var found = -1;
    for f in fns {
        if unit_of(s, f) == unit_of(s, callee) {
            if found >= 0 { return -1; }
            found = f;
        }
    }
    return found;
}

/// The argument node for each parameter of `params`, after the first
/// `given` which are passed already: positional arguments in order, named
/// ones (`b: 1`) by name, the rest from the parameter's default. None when
/// an argument names no parameter or a parameter gets no value.
pub fn arrange_args(lw: Lowerer, params: List<i64>, given: i64, arg_nodes: List<i64>) -> List<i64>? {
    let s = lw.inf.p.s;
    var slots: List<i64> = [];
    for _p in params { slots.push(-1); }
    var next = given;
    for a in arg_nodes {
        if kind(s, a) == nk_call_arg() {
            var at = -1;
            var i = 0;
            while i < params.len() {
                if node_name(s, params[i]) == node_name(s, a) { at = i; }
                i = i + 1;
            }
            if at < 0 || slots[at] >= 0 { return none; }
            slots[at] = rhs(s, a);
        } else {
            if next >= params.len() { return none; }
            slots[next] = a;
            next = next + 1;
        }
    }
    var i = given;
    while i < params.len() {
        if slots[i] < 0 { slots[i] = field_default(s, params[i]); }
        if slots[i] < 0 { return none; }
        i = i + 1;
    }
    var out: List<i64> = [];
    i = given;
    while i < params.len() {
        out.push(slots[i]);
        i = i + 1;
    }
    return out;
}

/// Calls the function `callee` names with the values `pre` first, then the
/// arguments `arg_nodes`: a top-level function, or the engine operation a
/// native binding names.
pub fn lower_fn_call(lw: Lowerer, callee: i64, pre: List<u32>, arg_nodes: List<i64>, phy: IrTypePhysics, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let decl = resolve_fn(lw, callee);
    if decl >= 0 { return call_decl(lw, decl, pre, arg_nodes, phy, n); }
    if is_value_callee(lw, callee) { return call_value(lw, lower_expr(lw, callee), pre, arg_nodes, phy, n); }
    if kind(s, callee) == nk_ident() && node_name(s, callee) == engine_token() && pre.len() == 0
        && arg_nodes.len() > 0 && kind(s, arg_nodes[0]) == nk_str() {
        // A library body `__engine("<hook>", args..)`: the engine operation itself.
        var args: List<u32> = [];
        var i = 1;
        while i < arg_nodes.len() {
            args.push(engine_arg(lw, lower_expr(lw, arg_nodes[i]), value_type(lw, arg_nodes[i]), arg_nodes[i]));
            i = i + 1;
        }
        return emit(lw, op_call_intrinsic(), intrinsic_index(lw, str_value(s, arg_nodes[0])), phy, args, n);
    }
    let native = if kind(s, callee) == nk_ident() && binding_index(lw, callee) < 0 { bound(lw, native_fn_hook(), [node_name(s, callee)]) } else { "" };
    if native == "" { return unsupported(lw, n); }
    var args: List<u32> = [];
    for v in pre { args.push(v); }
    for a in arg_nodes {
        if kind(s, a) == nk_call_arg() { return unsupported(lw, n); }
        args.push(engine_arg(lw, lower_expr(lw, a), value_type(lw, a), a));
    }
    return emit(lw, op_call_intrinsic(), intrinsic_index(lw, native), phy, args, n);
}

/// Calls top-level function `decl` with `pre` then `arg_nodes` arranged to
/// its parameters.
pub fn call_decl(lw: Lowerer, decl: i64, pre: List<u32>, arg_nodes: List<i64>, phy: IrTypePhysics, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let params = fn_params(s, decl);
    if pre.len() > params.len() { return unsupported(lw, n); }
    guard some nodes = arrange_args(lw, params, pre.len(), arg_nodes) else { return unsupported(lw, n); }
    // An unannotated parameter takes the type of its argument.
    var spec: List<i64> = [];
    var specialized = false;
    var i = 0;
    while i < params.len() {
        var t = ty_unknown();
        if rhs(s, params[i]) < 0 && i >= pre.len() && i - pre.len() < nodes.len() {
            t = value_type(lw, nodes[i - pre.len()]);
            if !ty_is_unknown(lw.inf.p.tt, t) { specialized = true; }
        }
        spec.push(t);
        i = i + 1;
    }
    var args: List<u32> = [];
    i = 0;
    while i < pre.len() {
        args.push(coerce(lw, pre[i], physics_of_type_node(lw, rhs(s, params[i])), n));
        i = i + 1;
    }
    for a in nodes {
        let phy_i = if ty_is_unknown(lw.inf.p.tt, spec[i]) { physics_of_type_node(lw, rhs(s, params[i])) } else { layout_of(lw.ls, spec[i]) };
        args.push(coerce(lw, lower_hinted(lw, a, prog_annot_type(lw.inf.p, rhs(s, params[i]))), phy_i, a));
        i = i + 1;
    }
    let ret = if annot(s, decl) >= 0 { physics_of_type_node(lw, annot(s, decl)) } else { layout_of(lw.ls, inferred_return(lw, decl)) };
    let fi = specialized_index(lw, decl, ty_unknown(), if specialized { spec } else { [] });
    return emit(lw, op_call_direct(), fi, if ret.layout_id != 0 { ret } else { phy }, args, n);
}

pub fn lower_if(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let ch = children(s, n);
    if ch.len() > 3 { return unsupported(lw, n); }
    let cond = lower_expr(lw, ch[0]);
    let then_block = ir_add_block(lw.f);
    let else_block = ir_add_block(lw.f);
    let has_else = ch.len() == 3;
    let join = if has_else { ir_add_block(lw.f) } else { else_block };
    emit_void(lw, op_cond_br(), 0, [cond, then_block, 0, else_block, 0], n);
    switch_to(lw, then_block);
    let tv = lower_expr(lw, ch[1]);
    if !has_else {
        jump_to(lw, join, [], n);
        switch_to(lw, join);
        return unit_value(lw, n);
    }
    let result = ir_add_param(lw.f, join, physics_of(lw, n));
    jump_to(lw, join, [tv], n);
    switch_to(lw, else_block);
    let ev = lower_expr(lw, ch[2]);
    jump_to(lw, join, [ev], n);
    switch_to(lw, join);
    return result;
}

pub fn lower_while(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let head = ir_add_block(lw.f);
    let body = ir_add_block(lw.f);
    let exit = ir_add_block(lw.f);
    jump_to(lw, head, [], n);
    switch_to(lw, head);
    let cond = lower_expr(lw, lhs(s, n));
    emit_void(lw, op_cond_br(), 0, [cond, body, 0, exit, 0], n);
    switch_to(lw, body);
    lw.loop_heads.push(head);
    lw.loop_exits.push(exit);
    lw.head_depths.push(scope_depth(lw));
    lw.exit_depths.push(scope_depth(lw));
    let _ = lower_expr(lw, rhs(s, n));
    let _ = lw.loop_heads.pop();
    let _ = lw.loop_exits.pop();
    let _ = lw.head_depths.pop();
    let _ = lw.exit_depths.pop();
    jump_to(lw, head, [], n);
    switch_to(lw, exit);
    return unit_value(lw, n);
}

/// `for x in a..b` / `a..=b` counts in a stack slot; `for x in e` over any
/// other value runs the enumerator protocol the syntax binds
/// (`get_enumerator()`, then `move_next()` and `current`). `continue` goes
/// to the step.
pub fn lower_for(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let clause = flags(s, n) - 1;
    if clause < 0 || clause >= s.for_clauses.len() || !lw.binding_of.has(key(n)) { return unsupported(lw, n); }
    let c: List<i64> = s.for_clauses[clause];
    let iterable = c[0];
    if c[1] >= 0 { return unsupported(lw, n); }
    let bi = lw.binding_of.get(key(n));
    let var_key = key(bi);
    let ik = kind(s, iterable);
    let is_range = ik == nk_binary() && (flags(s, iterable) == op_range() || flags(s, iterable) == op_range_inclusive());
    // In a function specialized to its argument types the checker may not
    // know the iterable's type; the element type follows from the one the
    // lowering knows.
    let it_t = value_type(lw, iterable);
    var elem_t = binding_type(lw.inf, bi);
    if !is_range {
        // The elements of a mixed list are values of the union.
        let known = element_type(lw.inf.p, it_t);
        if !ty_is_unknown(lw.inf.p.tt, known) && (ty_is_unknown(lw.inf.p.tt, elem_t) || holds_union(lw.inf.p.tt, known)) {
            elem_t = known;
            lw.known_types.set(var_key, elem_t);
        }
    }
    let elem_phy = layout_of(lw.ls, elem_t);
    let head = ir_add_block(lw.f);
    let body = ir_add_block(lw.f);
    let step = ir_add_block(lw.f);
    let exit = ir_add_block(lw.f);
    if is_range {
        let start = coerce(lw, lower_expr(lw, lhs(s, iterable)), elem_phy, iterable);
        let end = coerce(lw, lower_expr(lw, rhs(s, iterable)), elem_phy, iterable);
        let slot = emit(lw, op_stack_slot(), 0, elem_phy, [], n);
        emit_void(lw, op_store(), 0, [slot, start], n);
        jump_to(lw, head, [], n);
        switch_to(lw, head);
        let i = emit(lw, op_load(), 0, elem_phy, [slot], n);
        // CmpPred: 2 is `<`, 3 is `<=`.
        let pred = if flags(s, iterable) == op_range_inclusive() { 3 } else { 2 };
        let more = emit(lw, op_cmp(), pred, layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_bool()))), [i, end], n);
        emit_void(lw, op_cond_br(), 0, [more, body, 0, exit, 0], n);
        switch_to(lw, body);
        lw.values.set(var_key, i);
        lower_loop_body(lw, rhs(s, n), step, exit, n);
        switch_to(lw, step);
        let cur = emit(lw, op_load(), 0, elem_phy, [slot], n);
        let one = emit(lw, op_const_bits(), 0, elem_phy, [pool_int(lw, 1)], n);
        emit_void(lw, op_store(), 0, [slot, emit(lw, op_add(), 0, elem_phy, [cur, one], n)], n);
        jump_to(lw, head, [], n);
        switch_to(lw, exit);
        return unit_value(lw, n);
    }
    if !runs_as_code(lw, it_t, s.enumeration[0]) && native_for(lw, it_t, "[]", native_method_hook()) != "" {
        return lower_for_indexed(lw, n, iterable, it_t, var_key, elem_phy, head, body, step, exit);
    }
    if s.enumeration.len() != 3 { return unsupported(lw, n); }
    let it = lower_expr(lw, iterable);
    let en_t = enumerator_type(lw, it_t);
    if !ty_is_named(lw.inf.p.tt, en_t) { return unsupported(lw, n); }
    let en = member_call(lw, it, it_t, s.enumeration[0], [], layout_of(lw.ls, en_t), n);
    jump_to(lw, head, [], n);
    switch_to(lw, head);
    let more = member_call(lw, en, en_t, s.enumeration[1], [], layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_bool()))), n);
    emit_void(lw, op_cond_br(), 0, [more, body, 0, exit, 0], n);
    switch_to(lw, body);
    lw.values.set(var_key, coerce(lw, property_read(lw, en, en_t, s.enumeration[2], n), elem_phy, n));
    lower_loop_body(lw, rhs(s, n), step, exit, n);
    switch_to(lw, step);
    jump_to(lw, head, [], n);
    switch_to(lw, exit);
    return unit_value(lw, n);
}

/// `for x in xs` over a sequence the engine holds by itself: the elements
/// `xs[0] .. xs[len - 1]`, read with the engine operations bound to the
/// type's `[]` and to `len`.
[StandIn("ir.engine_sequence_for", "slice<T> is { ptr<T>, usize } enumerated by its SliceEnumerator", "the value is the engine's own list, as in the seed, and is indexed by engine operations", "F6")]
fn lower_for_indexed(lw: Lowerer, n: i64, iterable: i64, it_t: i64, var_key: str, elem_phy: IrTypePhysics, head: u32, body: u32, step: u32, exit: u32) -> u32 {
    let s = lw.inf.p.s;
    let len_hook = native_for(lw, it_t, "len", native_property_hook());
    if len_hook == "" { return unsupported(lw, n); }
    let int_phy = layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_int())));
    let bool_phy = layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_bool())));
    let seq = lower_expr(lw, iterable);
    let len = emit(lw, op_call_intrinsic(), intrinsic_index(lw, len_hook), int_phy, [seq], n);
    let slot = emit(lw, op_stack_slot(), 0, int_phy, [], n);
    emit_void(lw, op_store(), 0, [slot, emit(lw, op_const_bits(), 0, int_phy, [pool_int(lw, 0)], n)], n);
    jump_to(lw, head, [], n);
    switch_to(lw, head);
    let i = emit(lw, op_load(), 0, int_phy, [slot], n);
    // CmpPred 2 is `<`.
    emit_void(lw, op_cond_br(), 0, [emit(lw, op_cmp(), 2, bool_phy, [i, len], n), body, 0, exit, 0], n);
    switch_to(lw, body);
    let get = native_for(lw, it_t, "[]", native_method_hook());
    lw.values.set(var_key, emit(lw, op_call_intrinsic(), intrinsic_index(lw, get), elem_phy, [seq, i], n));
    lower_loop_body(lw, rhs(s, n), step, exit, n);
    switch_to(lw, step);
    let cur = emit(lw, op_load(), 0, int_phy, [slot], n);
    let one = emit(lw, op_const_bits(), 0, int_phy, [pool_int(lw, 1)], n);
    emit_void(lw, op_store(), 0, [slot, emit(lw, op_add(), 0, int_phy, [cur, one], n)], n);
    jump_to(lw, head, [], n);
    switch_to(lw, exit);
    return unit_value(lw, n);
}

/// The body of a loop whose `continue` goes to `step` and `break` to `exit`;
/// it falls through to `step`.
fn lower_loop_body(lw: Lowerer, body: i64, step: u32, exit: u32, n: i64) {
    lw.loop_heads.push(step);
    lw.loop_exits.push(exit);
    lw.head_depths.push(scope_depth(lw));
    lw.exit_depths.push(scope_depth(lw));
    let _ = lower_expr(lw, body);
    let _ = lw.loop_heads.pop();
    let _ = lw.loop_exits.pop();
    let _ = lw.head_depths.pop();
    let _ = lw.exit_depths.pop();
    jump_to(lw, step, [], n);
}

pub fn lower_loop_exit(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    // `break` leaves the innermost loop or switch; `continue` goes to the
    // innermost loop's next round.
    let is_break = kind(s, n) == nk_break();
    let targets = if is_break { lw.loop_exits } else { lw.loop_heads };
    if lhs(s, n) >= 0 || targets.len == 0 { return unsupported(lw, n); }
    let target = targets[targets.len - 1];
    let depths = if is_break { lw.exit_depths } else { lw.head_depths };
    run_defers_to(lw, depths[depths.len - 1]);
    jump_to(lw, target, [], n);
    return ir_no_value();
}

pub fn lower_return(lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    var args: List<u32> = [];
    if lhs(s, n) >= 0 {
        let v = lower_hinted(lw, lhs(s, n), lw.ret_type);
        args.push(coerce(lw, as_member_of(lw, v, value_type(lw, lhs(s, n)), lw.ret_type, n), lw.f.ret_physics, n));
    }
    // Deferred statements run after the value is computed.
    run_defers_to(lw, 0);
    if ir_is_terminated(lw.f, lw.cur) { return ir_no_value(); }
    emit_void(lw, op_return(), 0, args, n);
    return ir_no_value();
}
