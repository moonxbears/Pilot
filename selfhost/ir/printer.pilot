// ==============================================================================
// FILE: selfhost/ir/printer.pilot
// Milestone 6.1: First-Class Typed SSA Mid-Level IR Textual Printer & Parser
// Canonical Deterministic Serialization & Round-Trip Parsing
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Ir.Printer;

use Pilot.SelfHost.Ir.Model::*;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// Textual IR Serialization
// ------------------------------------------------------------------------------

pub fn print_physics(phy: IrTypePhysics) -> str {
    let rc = reg_class_name(phy.reg_class);
    let lat = lattice_name(phy.lattice_bits);
    return rc + "[" + phy.bit_width + ":" + lat + "]";
}

pub fn print_instruction(inst: IrInst, args_str: str) -> str {
    let op_str = opcode_name(inst.opcode);
    let phy_str = print_physics(inst.physics);

    if opcode_is_terminator(inst.opcode) {
        if inst.opcode == op_return() {
            return "  return " + args_str + ";";
        }
        if inst.opcode == op_jump() {
            return "  jump " + args_str + ";";
        }
        if inst.opcode == op_cond_br() {
            return "  cond_br " + args_str + ";";
        }
        if inst.opcode == op_unreachable() {
            return "  unreachable;";
        }
        return "  " + op_str + " " + args_str + ";";
    }

    if inst.opcode == op_cmp() {
        let pred = cmp_pred_name(inst.subop);
        return "  v" + inst.result + ": " + phy_str + " = cmp." + pred + " " + args_str + ";";
    }

    if inst.opcode == op_cast() {
        let ck = cast_kind_name(inst.subop);
        return "  v" + inst.result + ": " + phy_str + " = cast." + ck + " " + args_str + ";";
    }

    return "  v" + inst.result + ": " + phy_str + " = " + op_str + " " + args_str + ";";
}

pub fn print_block_header(block_id: u32, params_str: str) -> str {
    return "block" + block_id + "(" + params_str + "):";
}

pub fn print_function_header(fn_name: str, params_str: str, ret_phy: IrTypePhysics, is_pure: bool, is_noalloc: bool) -> str {
    var pfx = "fn ";
    if is_pure { pfx = "pure fn "; }
    if is_noalloc { pfx = "[noalloc] " + pfx; }
    return pfx + fn_name + "(" + params_str + ") -> " + print_physics(ret_phy) + " {";
}

// ------------------------------------------------------------------------------
// Textual IR Round-Trip Parser Helpers
// ------------------------------------------------------------------------------

pub fn parse_ir_find_next_line(text: str, start: usize) -> str {
    let n = text.len();
    if start >= n { return ""; }
    let rem = text.slice(start, n);
    let p = rem.find("\n");
    if p >= 0 {
        return rem.slice(0, p);
    }
    return rem;
}

// Strips leading spaces from one line of textual IR.
fn parse_ir_strip_indent(line: str) -> str {
    var i = 0;
    let n = line.len();
    while i < n && line.byte_at(i) == 32 {
        i = i + 1;
    }
    return line.slice(i, n);
}

// True when `line` is a block header as printed by `print_block_header`:
// `block<digits>(...):`.
pub fn parse_ir_is_block_header(line: str) -> bool {
    let t = parse_ir_strip_indent(line);
    if !t.starts_with("block") || !t.ends_with("):") {
        return false;
    }
    var i = 5;
    let n = t.len();
    var digits = 0;
    while i < n && t.byte_at(i) >= 48 && t.byte_at(i) <= 57 {
        i = i + 1;
        digits = digits + 1;
    }
    return digits > 0 && i < n && t.byte_at(i) == 40;
}

// True when `line` is an instruction as printed by `print_instruction`:
// indented and terminated by `;`.
pub fn parse_ir_is_instruction(line: str) -> bool {
    if !line.starts_with("  ") {
        return false;
    }
    let t = parse_ir_strip_indent(line);
    return t.len() > 1 && t.ends_with(";");
}

pub fn parse_ir_count_blocks(text: str) -> u32 {
    var count: u32 = 0;
    var i = 0;
    let n = text.len();
    while i < n {
        let line = parse_ir_find_next_line(text, i);
        if parse_ir_is_block_header(line) {
            count = count + 1;
        }
        i = i + line.len() + 1;
    }
    return count;
}

pub fn parse_ir_count_instructions(text: str) -> u32 {
    var count: u32 = 0;
    var i = 0;
    let n = text.len();
    while i < n {
        let line = parse_ir_find_next_line(text, i);
        if parse_ir_is_instruction(line) {
            count = count + 1;
        }
        i = i + line.len() + 1;
    }
    return count;
}
