// ==============================================================================
// FILE: selfhost/ir/passes_core.pilot
// Milestone 6.1: First-Class Typed SSA Mid-Level IR Core Optimization Passes
// ConstPropAndFold (x + 0 -> x, constant folding), DeadCodeElim, CfgSimplify
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Ir.PassesCore;

use Pilot.SelfHost.Ir.Model::*;
use Pilot.SelfHost.Ir.PassManager::*;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// Constant Folding & Algebraic Simplification Pass
// ------------------------------------------------------------------------------
pub pure fn pass_name_const_fold() -> str => "ConstPropAndFold";

// Folds binary operations:
// Returns folded integer if foldable, or nil/none marker if not foldable.
pub fn fold_binary_const(op: u16, c1: i64, c2: i64) -> str {
    if op == op_add() {
        return "" + (c1 + c2);
    }
    if op == op_sub() {
        return "" + (c1 - c2);
    }
    if op == op_mul() {
        return "" + (c1 * c2);
    }
    if op == op_div() {
        if c2 != 0 { return "" + (c1 / c2); }
        return "DIV_BY_ZERO";
    }
    if op == op_bit_and() {
        return "" + (c1 & c2);
    }
    if op == op_bit_or() {
        return "" + (c1 | c2);
    }
    if op == op_bit_xor() {
        return "" + (c1 ^ c2);
    }
    if op == op_shl() {
        return "" + (c1 << c2);
    }
    if op == op_shr() {
        return "" + (c1 >> c2);
    }
    if op == op_cmp() {
        // subop cmp
        return "CMP";
    }
    return "NOT_FOLDABLE";
}

// Algebraic identities (e.g. x + 0 -> x, x * 1 -> x, x * 0 -> 0)
// Returns:
// "IDENTITY_ARG1" if result simplifies to operand 1 (e.g. x + 0 -> x)
// "IDENTITY_ARG2" if result simplifies to operand 2 (e.g. 0 + x -> x)
// "ZERO" if result simplifies to constant 0 (e.g. x * 0 -> 0)
// "NONE" if no algebraic simplification applies
pub fn simplify_algebraic_identity(op: u16, arg1_is_const: bool, arg1_val: i64, arg2_is_const: bool, arg2_val: i64) -> str {
    // x + 0 -> x
    if op == op_add() && arg2_is_const && arg2_val == 0 {
        return "IDENTITY_ARG1";
    }
    // 0 + x -> x
    if op == op_add() && arg1_is_const && arg1_val == 0 {
        return "IDENTITY_ARG2";
    }
    // x - 0 -> x
    if op == op_sub() && arg2_is_const && arg2_val == 0 {
        return "IDENTITY_ARG1";
    }
    // x * 1 -> x
    if op == op_mul() && arg2_is_const && arg2_val == 1 {
        return "IDENTITY_ARG1";
    }
    // 1 * x -> x
    if op == op_mul() && arg1_is_const && arg1_val == 1 {
        return "IDENTITY_ARG2";
    }
    // x * 0 -> 0 or 0 * x -> 0
    if op == op_mul() && ((arg1_is_const && arg1_val == 0) || (arg2_is_const && arg2_val == 0)) {
        return "ZERO";
    }
    // x / 1 -> x
    if op == op_div() && arg2_is_const && arg2_val == 1 {
        return "IDENTITY_ARG1";
    }
    // x & 0 -> 0
    if op == op_bit_and() && ((arg1_is_const && arg1_val == 0) || (arg2_is_const && arg2_val == 0)) {
        return "ZERO";
    }
    // x | 0 -> x
    if op == op_bit_or() && arg2_is_const && arg2_val == 0 {
        return "IDENTITY_ARG1";
    }
    // 0 | x -> x
    if op == op_bit_or() && arg1_is_const && arg1_val == 0 {
        return "IDENTITY_ARG2";
    }

    return "NONE";
}

// ------------------------------------------------------------------------------
// Dead Code Elimination Pass
// ------------------------------------------------------------------------------
pub pure fn pass_name_dce() -> str => "DeadCodeElim";

pub pure fn op_has_side_effects(op: u16) -> bool {
    // Terminators, calls, stores, perceus drops, allocations have side effects
    if opcode_is_terminator(op) { return true; }
    if op == op_call_direct() || op == op_call_indirect() || op == op_call_intrinsic() { return true; }
    if op == op_store() || op == op_arena_alloc() { return true; }
    if op == op_perceus_drop() || op == op_perceus_drop_reuse() || op == op_guard_exit_lifo() { return true; }
    return false;
}

pub fn can_eliminate_dead_instruction(op: u16, use_count: u32) -> bool {
    if op_has_side_effects(op) {
        return false;
    }
    return use_count == 0;
}

// ------------------------------------------------------------------------------
// CFG Simplification Pass
// ------------------------------------------------------------------------------
pub pure fn pass_name_cfg_simplify() -> str => "CfgSimplify";

pub fn can_fold_branch(cond_is_const: bool, cond_val: bool) -> str {
    if cond_is_const {
        if cond_val {
            return "TAKE_TRUE";
        } else {
            return "TAKE_FALSE";
        }
    }
    return "DYNAMIC";
}
