// ==============================================================================
// FILE: selfhost/ir/lower_probe.pilot
// Probes in PilIR: the calls the type checker plans around statements.
// ==============================================================================
// The checker's probe plan (selfhost/check/probes.pilot) names, per
// statement, whether to read the text of its target before it runs and which
// function to call after it, with what. The seed carries out the same plan
// (crates/pilot-vm/src/lower_probe.rs). Here it becomes ordinary PilIR, so
// the interpreter and every emitter run it. A call goes before the
// statement, after it, or on every way out of the block it is in (`defer`):
//   - a target's text is `"" + value`, as an f-string shows a value;
//   - the target of a `let` / `var` is its binding, that of an assignment the
//     place it writes, read with the drop plan set aside (a probe only looks).
pub lvl(0) pkg selfhost.ir;

use selfhost.check.*;

/// The probes of the program `p` describes, by statement node, in plan
/// order (`[Debug]` from probes.pilot, then `[Coverage]` from coverage.pilot).
pub fn probe_rows(var ref p: Program) -> Map<str, List<PlannedProbe>> {
    let out = Map<str, List<PlannedProbe>>();
    for pr in probe_plan(p) { add_row(out, pr); }
    for pr in coverage_plan(p) { add_row(out, pr); }
    return out;
}

fn add_row(var ref out: Map<str, List<PlannedProbe>>, pr: PlannedProbe) {
    let k = key(pr.node);
    var rows: List<PlannedProbe> = if out.has(k) { out.get(k) } else { [] };
    rows.push(pr);
    out.set(k, rows);
}

/// A `ProbeAt::Defer` call reached at statement `n`, waiting for its
/// scope's exit (selfhost/ir/lower_defer.pilot).
pub struct DeferredProbe {
    pub probe: PlannedProbe;
    pub n: i64;
}

/// Whether the plan puts a probe around node `n`.
pub fn probed(ref lw: Lowerer, n: i64) -> bool => lw.probes.has(key(n));

fn text_physics(var ref lw: Lowerer) -> IrTypePhysics =>
    layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_str())));

fn text_const(var ref lw: Lowerer, text: str, n: i64) -> u32 =>
    emit(lw, op_const_bytes(), 0, text_physics(lw), [pool_str(lw, text)], n);

/// The value the target of statement `n` holds.
fn target_value(var ref lw: Lowerer, n: i64) -> u32 {
    let s = lw.inf.p.s;
    let saved = lw.plan.at;
    lw.plan.at = Map<str, List<AtRow>>();
    var v = ir_no_value();
    if kind(s, n) == nk_assign() {
        v = lower_expr(lw, lhs(s, n));
    } else if lw.binding_of.has(key(n)) {
        let b = lw.binding_of[key(n)];
        let k = key(b);
        if lw.values.has(k) { v = lw.values[k]; }
        else if lw.slots.has(k) { v = emit(lw, op_load(), 0, layout_of(lw.ls, binding_type(lw.inf, b)), [lw.slots[k]], n); }
    }
    lw.plan.at = saved;
    return v;
}

/// The text of the target of statement `n`.
fn target_text(var ref lw: Lowerer, n: i64) -> u32 {
    let v = target_value(lw, n);
    if v == ir_no_value() { return text_const(lw, "", n); }
    return emit(lw, op_add(), 0, text_physics(lw), [text_const(lw, "", n), v], n);
}

fn rows_at(ref lw: Lowerer, n: i64) -> List<PlannedProbe> => if probed(lw, n) { lw.probes.get(key(n)) } else { [] };

/// Before statement `n` is lowered: its `ProbeAt::Before` calls, its
/// `ProbeAt::Defer` calls registered with the innermost scope, and the text
/// of its target when an after-call captures it (else no value).
pub fn probe_before(var ref lw: Lowerer, n: i64) -> u32 {
    var captured = ir_no_value();
    for row in rows_at(lw, n) {
        if row.at == ProbeAt::Before {
            probe_call(lw, row, n, ir_no_value());
        } else if row.at == ProbeAt::Defer {
            if lw.defers.len() == 0 {
                emit_trap(lw, "internal error: the probe plan defers a call outside any block", n);
                ensure_open(lw);
            } else {
                lw.later_probes.push(DeferredProbe { probe: row, n: n });
                lw.defers[lw.defers.len() - 1].push(0 - lw.later_probes.len());
            }
        } else if row.capture && captured == ir_no_value() {
            captured = target_text(lw, n);
        }
    }
    return captured;
}

/// After statement `n` is lowered: its `ProbeAt::After` calls, `captured`
/// the text `probe_before` read.
pub fn probe_after(var ref lw: Lowerer, n: i64, captured: u32) {
    for row in rows_at(lw, n) {
        if row.at == ProbeAt::After { probe_call(lw, row, n, captured); }
    }
}

/// A deferred probe call, `marker` the `-(index + 1)` its scope holds.
pub fn run_deferred_probe(var ref lw: Lowerer, marker: i64) {
    let entry = lw.later_probes[0 - marker - 1];
    probe_call(lw, entry.probe, entry.n, ir_no_value());
}

/// The text of the binding declared at `node` (a parameter or `let`), `""`
/// when it has no value.
fn binding_text(var ref lw: Lowerer, node: i64, n: i64) -> u32 {
    // A parameter's value is held under its binding.
    let b = if lw.binding_of.has(key(node)) { lw.binding_of[key(node)] } else { node };
    let k = key(b);
    var v = ir_no_value();
    if lw.values.has(k) { v = lw.values[k]; }
    else if lw.slots.has(k) { v = emit(lw, op_load(), 0, layout_of(lw.ls, binding_type(lw.inf, b)), [lw.slots[k]], n); }
    if v == ir_no_value() { return text_const(lw, "", n); }
    return emit(lw, op_add(), 0, text_physics(lw), [text_const(lw, "", n), v], n);
}

/// The call of probe `row` at statement `n`.
fn probe_call(var ref lw: Lowerer, ref row: PlannedProbe, n: i64, captured: u32) {
    if ir_is_terminated(lw.f, lw.cur) { return; }
    let call = row.call;
    let decls = nl_get(lw.inf.p.fns, call);
    if decls.len() != 1 {
        emit_trap(lw, f"internal error: the probe plan calls `{call}`, which the program does not declare once", n);
        ensure_open(lw);
        return;
    }
    let bool_phy = layout_of(lw.ls, prog_slot_type(lw.inf.p, literal_slot(nk_bool())));
    var values: List<u32> = [];
    for a in row.args {
        if a.kind == ProbeArgKind::Text {
            values.push(text_const(lw, a.text, n));
        } else if a.kind == ProbeArgKind::Flag {
            values.push(emit(lw, op_const_bits(), 0, bool_phy, [pool_int(lw, if a.flag { 1 } else { 0 })], n));
        } else if a.kind == ProbeArgKind::TargetText {
            values.push(target_text(lw, n));
        } else if a.kind == ProbeArgKind::BindingText {
            values.push(binding_text(lw, a.node, n));
        } else {
            values.push(if captured == ir_no_value() { text_const(lw, "", n) } else { captured });
        }
    }
    let _ = call_decl(lw, decls[0], values, [], layout_unknown(lw.ls), n);
}
