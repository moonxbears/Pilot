// ==============================================================================
// FILE: selfhost/ir/pass_dce.pilot
// F5: dead-code elimination on PilIR.
// ==============================================================================
// A block no path from the entry reaches is emptied down to `unreachable`
// (its id and parameters stay, so no branch has to be renumbered). An
// instruction whose result no reachable instruction uses is removed when
// removing it cannot change what the program does: it has no effect besides
// its result and cannot fail. Calls, stores, field writes, division and
// remainder (which fail on zero) and every lifecycle and memory operation
// other than `stack_slot` and `load` stay. An operator stays unless its
// operands are numbers in registers (on anything else the seed's operator
// fails at run time), a cast stays unless it converts a register value that
// is not a float (a float may not fit an integer), a field read stays unless
// its record's layout is known, and a load stays unless it reads a stack
// slot (a global may be read before its declaration has run).
pub lvl(0) pkg Pilot.SelfHost.Ir.PassDce;

use selfhost.ir.model.*;
use selfhost.ir.verify.*;
use selfhost.ir.passes.*;

pub struct DeadCodePass : IPilIrPass {
    pub fn name() -> str => "dce";
    pub fn run(f: IrFunction, m: IrModule) -> bool => eliminate_dead_code(f);
}

/// The opcodes whose only effect is their result.
fn removable_opcodes() -> List<u16> => [
    op_const_bits(), op_const_float(), op_const_bytes(), op_undef(),
    op_construct_aggregate(), op_extract_field(),
    op_add(), op_sub(), op_mul(), op_bit_and(), op_bit_or(), op_bit_xor(),
    op_shl(), op_shr(), op_cmp(), op_cast(),
    op_stack_slot(), op_load(), op_global_addr(),
];

/// Whether `v` is a number or boolean in a register.
fn numeric(f: IrFunction, v: u32) -> bool {
    let p = f.value_physics[v];
    return p.layout_id != 0 && p.reg_class < reg_class_aggregate() && p.reg_class != reg_class_raw_ptr();
}

/// Whether running `inst` cannot fail, by what its operands are.
fn cannot_fail(f: IrFunction, inst: IrInst, producers: List<i64>) -> bool {
    let op = inst.opcode;
    let a = ir_args(f, inst);
    if op == op_cmp() && inst.subop <= 1 { return true; }
    if op >= op_add() && op <= op_cmp() {
        for v in a {
            if !numeric(f, v) { return false; }
        }
        return true;
    }
    if op == op_cast() { return numeric(f, a[0]) && f.value_physics[a[0]].reg_class != reg_class_simd_float(); }
    if op == op_extract_field() { return f.value_physics[a[0]].layout_id != 0; }
    if op == op_load() { return producers[a[0]] == op_stack_slot(); }
    return true;
}

/// Removes `f`'s dead blocks and instructions; true when anything changed.
pub fn eliminate_dead_code(f: IrFunction) -> bool {
    let order = ir_compute_dominators(f);
    var reachable: List<bool> = [];
    for _b in f.blocks { reachable.push(false); }
    for b in order { reachable[b] = true; }
    var changed = false;
    for b in f.blocks {
        if reachable[b.id] { continue; }
        let only_end = b.insts.len == 1 && b.insts[0].opcode == op_unreachable();
        if !only_end {
            let span = if b.insts.len > 0 { b.insts[0].span_id } else { 0 };
            b.insts = [ir_inst_new(ir_no_value(), op_unreachable(), 0, f.ret_physics, f.operand_pool.len, 0, span)];
            changed = true;
        }
    }
    // Opcode -> whether it may be removed.
    var removable: List<bool> = [];
    for _n in opcode_names() { removable.push(false); }
    for op in removable_opcodes() { removable[op] = true; }
    // Remove until no instruction loses its last use.
    var again = true;
    while again {
        again = false;
        var uses: List<i64> = [];
        // Value -> the opcode of the instruction that defines it (0 for a
        // block parameter).
        var producers: List<i64> = [];
        for _v in f.value_physics {
            uses.push(0);
            producers.push(0);
        }
        for b in f.blocks {
            if !reachable[b.id] { continue; }
            for inst in b.insts {
                if inst.result != ir_no_value() { producers[inst.result] = inst.opcode; }
                let a = ir_args(f, inst);
                for pos in value_positions(f, inst) { uses[a[pos]] = uses[a[pos]] + 1; }
            }
        }
        for b in f.blocks {
            if !reachable[b.id] { continue; }
            var kept: List<IrInst> = [];
            for inst in b.insts {
                let dead = inst.result != ir_no_value() && uses[inst.result] == 0 && inst.opcode < removable.len() && removable[inst.opcode] && cannot_fail(f, inst, producers);
                if dead { again = true; } else { kept.push(inst); }
            }
            if kept.len() != b.insts.len { b.insts = kept; changed = true; }
        }
    }
    return changed;
}
