// ==============================================================================
// FILE: selfhost/ir/lower_ast.pilot
// Milestone 6.1: AST Lowering to Typed SSA PilIR
// Short-circuit Diamonds (&&, ||, ??), Lexical Cleanup Unwinding, 3-Tier Loops
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Ir.LowerAst;

use Pilot.SelfHost.Ir.Model::*;
use Pilot.SelfHost.Ir.Verifier::*;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// Scope Cleanup Stack (LIFO unwinding for defer and 0b11 IGuard)
// ------------------------------------------------------------------------------
pub fn scope_cleanup_new() -> str {
    return "";
}

pub fn scope_cleanup_push(stack: str, entry: str) -> str {
    return stack + entry + "|";
}

pub fn scope_cleanup_count(stack: str) -> u32 {
    var count: u32 = 0;
    var rem = stack;
    while rem.len() > 0 {
        let p = rem.find("|");
        let seg = if p >= 0 { rem.slice(0, p) } else { rem };
        rem = if p >= 0 { rem.slice(p + 1, rem.len()) } else { "" };
        if seg.len() > 0 {
            count = count + 1;
        }
    }
    return count;
}

// Returns the cleanup entry at `index` (0 = first pushed), or "" when absent.
pub fn scope_cleanup_at(stack: str, index: u32) -> str {
    var cur: u32 = 0;
    var rem = stack;
    while rem.len() > 0 {
        let p = rem.find("|");
        let seg = if p >= 0 { rem.slice(0, p) } else { rem };
        rem = if p >= 0 { rem.slice(p + 1, rem.len()) } else { "" };
        if seg.len() > 0 {
            if cur == index {
                return seg;
            }
            cur = cur + 1;
        }
    }
    return "";
}

// Emits the cleanup entries above `target_depth` in reverse-declaration
// (LIFO) order, each followed by `;`.
pub fn scope_cleanup_unwind_to_depth(stack: str, target_depth: u32) -> str {
    let total = scope_cleanup_count(stack);
    if total <= target_depth {
        return "";
    }
    var out = "";
    var cur = total;
    while cur > target_depth {
        out = out + scope_cleanup_at(stack, cur - 1) + ";";
        cur = cur - 1;
    }
    return out;
}

// ------------------------------------------------------------------------------
// Short-Circuit Diamond Generation (&&, ||, ??)
// ------------------------------------------------------------------------------

pub fn lower_short_circuit_and(lhs_val: str, rhs_val: str, block_true: u32, block_false: u32, block_join: u32) -> str {
    var out = "";
    out = out + "cond_br " + lhs_val + ", block" + block_true + ", block" + block_false + "(false);\n";
    out = out + "block" + block_true + ":\n";
    out = out + "jump block" + block_join + "(" + rhs_val + ");\n";
    out = out + "block" + block_false + ":\n";
    out = out + "jump block" + block_join + "(false);\n";
    return out;
}

pub fn lower_short_circuit_or(lhs_val: str, rhs_val: str, block_true: u32, block_false: u32, block_join: u32) -> str {
    var out = "";
    out = out + "cond_br " + lhs_val + ", block" + block_true + "(true), block" + block_false + ";\n";
    out = out + "block" + block_true + ":\n";
    out = out + "jump block" + block_join + "(true);\n";
    out = out + "block" + block_false + ":\n";
    out = out + "jump block" + block_join + "(" + rhs_val + ");\n";
    return out;
}

pub fn lower_null_coalesce(lhs_val: str, rhs_val: str, block_some: u32, block_none: u32, block_join: u32) -> str {
    var out = "";
    out = out + "cond_br (is_some " + lhs_val + "), block" + block_some + ", block" + block_none + ";\n";
    out = out + "block" + block_some + ":\n";
    out = out + "jump block" + block_join + "(unwrap " + lhs_val + ");\n";
    out = out + "block" + block_none + ":\n";
    out = out + "jump block" + block_join + "(" + rhs_val + ");\n";
    return out;
}

// ------------------------------------------------------------------------------
// 3-Tier Dynamic Loop Lowering
// ------------------------------------------------------------------------------

pub pure fn loop_tier_fixed_scalar()   -> u8 => 1;
pub pure fn loop_tier_mutable_bounds() -> u8 => 2;
pub pure fn loop_tier_worklist_stack() -> u8 => 3;

// Renders a block parameter `name: <physics>` from the value's type physics,
// so the loop header never names a source type.
fn loop_param(name: str, phy: IrTypePhysics) -> str {
    return name + ": " + reg_class_name(phy.reg_class) + "[" + phy.bit_width + ":" + lattice_name(phy.lattice_bits) + "]";
}

// `iter_phy` is the physics of the loop variable; `window_phy` the physics of
// the worklist window carried by a WorklistStack loop.
pub fn lower_loop_header(tier: u8, loop_var: str, iter_phy: IrTypePhysics, window_phy: IrTypePhysics, start_val: str, end_val: str, header_block_id: u32) -> str {
    let head = "block" + header_block_id + "(";
    if tier == loop_tier_fixed_scalar() {
        return head + loop_param(loop_var, iter_phy) + " = " + start_val + ", " + loop_param(loop_var + "_end", iter_phy) + " = " + end_val + "):";
    }
    if tier == loop_tier_mutable_bounds() {
        return head + loop_param(loop_var, iter_phy) + " = " + start_val + ", var " + loop_param(loop_var + "_end", iter_phy) + " = " + end_val + "):";
    }
    return head + loop_param(loop_var + "_worklist", window_phy) + " = " + start_val + "):";
}
