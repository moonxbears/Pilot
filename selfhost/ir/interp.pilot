// ==============================================================================
// FILE: selfhost/ir/interp.pilot
// F5: the PilIR interpreter.
// ==============================================================================
// Runs an `IrModule` so the IR is executable before a native backend exists.
// Values are the interpreter's own values; how an instruction treats them
// follows its physics: a 1-bit register constant is a boolean, a 64-bit
// unsigned register constant is unsigned. Each opcode is run by the handler
// registered for it in `interp_handlers()`; an opcode with none stops at the
// seam `ir.interp_opcode`. Engine operations (`call_intrinsic`) are run by
// the hook registered for them in `interp_hooks()`; a hook with none stops at
// the seam `ir.interp_hook`.
pub lvl(0) pkg Pilot.SelfHost.Ir.Interp;

use selfhost.ir.model.*;

/// One activation of a function.
pub struct IrFrame : IObject {
    pub m: IrModule;
    pub f: IrFunction;
    /// Value id -> its value.
    pub vals: List<any>;
    /// Stack slot cells; a `stack_slot` value is an index into this list.
    pub cells: List<any>;
    /// Where control goes after a terminator: the block, or -1 to return.
    pub next: i64;
    /// Arguments for the next block's parameters.
    pub next_args: List<any>;
    pub ret: any;
    pub handlers: List<any>;
    pub hooks: Map<str, any>;
}

/// Runs `main` (function 0) and returns the exit code `pilot run` would.
pub fn ir_run(m: IrModule) -> i64 {
    let handlers = interp_handlers();
    let hooks = interp_hooks();
    let out = interp_call(m, 0, [], handlers, hooks);
    // `main` without a value exits 0, as on the seed.
    return if out == none { 0 } else { out };
}

fn interp_call(m: IrModule, fi: i64, args: List<any>, handlers: List<any>, hooks: Map<str, any>) -> any {
    let f = m.functions[fi];
    var vals: List<any> = [];
    var i = 0;
    while i < f.value_physics.len {
        vals.push(none);
        i = i + 1;
    }
    let fr = IrFrame { m: m, f: f, vals: vals, cells: [], next: 0, next_args: args, ret: none, handlers: handlers, hooks: hooks };
    while fr.next >= 0 {
        let b = f.blocks[fr.next];
        var p = 0;
        while p < b.params.len {
            fr.vals[b.params[p]] = fr.next_args[p];
            p = p + 1;
        }
        fr.next = -1;
        for inst in b.insts {
            let h = if inst.opcode < handlers.len { handlers[inst.opcode] } else { none };
            if h == none {
                return seam("ir.interp_opcode", f"the IR interpreter has no handler for `{opcode_name(inst.opcode)}`");
            }
            h(fr, inst);
        }
    }
    return fr.ret;
}

fn arg_values(fr: IrFrame, inst: IrInst) -> List<any> {
    var out: List<any> = [];
    for a in ir_args(fr.f, inst) { out.push(fr.vals[a]); }
    return out;
}

fn put(fr: IrFrame, inst: IrInst, v: any) { fr.vals[inst.result] = v; }

/// A constant integer as a value of physics `phy`.
fn bits_value(phy: IrTypePhysics, v: i64) -> any {
    if phy.bit_width == 1 { return v != 0; }
    if phy.reg_class == reg_class_gpr_unsigned() && phy.bit_width >= 64 { return v as u64; }
    return v;
}

fn run_const_bits(fr: IrFrame, inst: IrInst) {
    put(fr, inst, bits_value(inst.physics, fr.m.ints[ir_args(fr.f, inst)[0]]));
}

/// The binary64 value whose bits are `bits`: sign, 11-bit exponent and
/// 52-bit fraction (IEEE 754-2019 section 3.4). Scaling by powers of two is
/// exact, so the result is the value itself.
pub fn f64_from_bits(bits: i64) -> f64 {
    let neg = bits < 0;
    let exp = (bits >> 52) & 2047;
    let frac = bits & 4503599627370495;
    if exp == 2047 {
        if frac != 0 { return 0.0 / 0.0; }
        return if neg { -1.0 / 0.0 } else { 1.0 / 0.0 };
    }
    // Normal: (2^52 + frac) * 2^(exp - 1075); subnormal: frac * 2^-1074.
    var mant = (if exp == 0 { frac } else { frac + 4503599627370496 }) as f64;
    var e = if exp == 0 { -1074 } else { exp - 1075 };
    while e > 0 {
        mant = mant * 2.0;
        e = e - 1;
    }
    while e < 0 {
        mant = mant * 0.5;
        e = e + 1;
    }
    return if neg { -mant } else { mant };
}

fn run_const_float(fr: IrFrame, inst: IrInst) { put(fr, inst, f64_from_bits(fr.m.floats[ir_args(fr.f, inst)[0]])); }

fn run_const_bytes(fr: IrFrame, inst: IrInst) { put(fr, inst, fr.m.strings[ir_args(fr.f, inst)[0]]); }

fn run_undef(fr: IrFrame, inst: IrInst) { put(fr, inst, none); }

fn binary(fr: IrFrame, inst: IrInst) -> List<any> => arg_values(fr, inst);

fn run_add(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] + a[1]); }
fn run_sub(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] - a[1]); }
fn run_mul(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] * a[1]); }
fn run_div(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] / a[1]); }
fn run_rem(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] % a[1]); }
fn run_bit_and(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] & a[1]); }
fn run_bit_or(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] | a[1]); }
fn run_shl(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] << a[1]); }
fn run_shr(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] >> a[1]); }

fn run_bit_xor(fr: IrFrame, inst: IrInst) { let a = binary(fr, inst); put(fr, inst, a[0] ^ a[1]); }

fn run_cmp(fr: IrFrame, inst: IrInst) {
    let a = binary(fr, inst);
    let p = inst.subop;
    var r = false;
    if p == 0 { r = a[0] == a[1]; }
    else if p == 1 { r = a[0] != a[1]; }
    else if p == 2 { r = a[0] < a[1]; }
    else if p == 3 { r = a[0] <= a[1]; }
    else if p == 4 { r = a[0] > a[1]; }
    else { r = a[0] >= a[1]; }
    put(fr, inst, r);
}

fn run_stack_slot(fr: IrFrame, inst: IrInst) {
    fr.cells.push(none);
    put(fr, inst, fr.cells.len - 1);
}

fn run_load(fr: IrFrame, inst: IrInst) { put(fr, inst, fr.cells[fr.vals[ir_args(fr.f, inst)[0]]]); }

fn run_store(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    fr.cells[fr.vals[a[0]]] = fr.vals[a[1]];
}

fn run_call_direct(fr: IrFrame, inst: IrInst) {
    put(fr, inst, interp_call(fr.m, inst.subop, arg_values(fr, inst), fr.handlers, fr.hooks));
}

fn run_call_intrinsic(fr: IrFrame, inst: IrInst) {
    let name = fr.m.intrinsics[inst.subop];
    if !fr.hooks.has(name) {
        put(fr, inst, seam("ir.interp_hook", f"the IR interpreter does not run the engine operation `{name}`"));
        return;
    }
    let hook = fr.hooks.get(name);
    put(fr, inst, hook(arg_values(fr, inst)));
}

/// An aggregate is a record of its field values. Records are shared, not
/// copied, when a value is passed on.
[StandIn("ir.aggregate_by_reference", "a 0b00 value is copied when it is bound or passed (memcpy)", "the IR interpreter shares one record between every copy, as the seed does", "F5")]
fn run_construct_aggregate(fr: IrFrame, inst: IrInst) { put(fr, inst, arg_values(fr, inst)); }

fn run_extract_field(fr: IrFrame, inst: IrInst) {
    let rec: List<any> = fr.vals[ir_args(fr.f, inst)[0]];
    put(fr, inst, rec[inst.subop]);
}

fn run_insert_field(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    let rec: List<any> = fr.vals[a[0]];
    rec[inst.subop] = fr.vals[a[1]];
}

/// A register value converted to the physics of the instruction: a 1-bit
/// register holds a boolean, a 64-bit unsigned register an unsigned value.
/// `cast`: the value converted to the result's register physics, as the
/// seed converts `T(x)`: floats truncate toward zero, integers wrap to the
/// width, a 1-bit value is a boolean, a 32-bit float rounds to binary32.
fn run_cast(fr: IrFrame, inst: IrInst) {
    let v = fr.vals[ir_args(fr.f, inst)[0]];
    let phy = inst.physics;
    put(fr, inst, num_convert(v, reg_class_name(phy.reg_class), phy.bit_width));
}

/// The seed's numeric conversion to register class `class` of `width` bits.
fn num_convert(v: any, class: str, width: i64) -> any => __engine("num_convert", v, class, width);

fn run_jump(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    var args: List<any> = [];
    var i = 1;
    while i < a.len() {
        args.push(fr.vals[a[i]]);
        i = i + 1;
    }
    fr.next = a[0];
    fr.next_args = args;
}

fn run_cond_br(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    let taken = fr.vals[a[0]] == true;
    let at = if taken { 1 } else { 3 + a[2] };
    var args: List<any> = [];
    var i = 0;
    while i < a[at + 1] {
        args.push(fr.vals[a[at + 2 + i]]);
        i = i + 1;
    }
    fr.next = a[at];
    fr.next_args = args;
}

fn run_return(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    fr.ret = if a.len() > 0 { fr.vals[a[0]] } else { none };
    fr.next = -1;
}

/// Opcode -> its handler.
pub fn interp_handlers() -> List<any> {
    var hs: List<any> = [];
    var i = 0;
    while i < opcode_names().len() {
        hs.push(none);
        i = i + 1;
    }
    hs[op_const_bits()] = run_const_bits;
    hs[op_const_bytes()] = run_const_bytes;
    hs[op_const_float()] = run_const_float;
    hs[op_undef()] = run_undef;
    hs[op_add()] = run_add;
    hs[op_sub()] = run_sub;
    hs[op_mul()] = run_mul;
    hs[op_div()] = run_div;
    hs[op_rem()] = run_rem;
    hs[op_bit_and()] = run_bit_and;
    hs[op_bit_or()] = run_bit_or;
    hs[op_bit_xor()] = run_bit_xor;
    hs[op_shl()] = run_shl;
    hs[op_shr()] = run_shr;
    hs[op_cmp()] = run_cmp;
    hs[op_cast()] = run_cast;
    hs[op_construct_aggregate()] = run_construct_aggregate;
    hs[op_extract_field()] = run_extract_field;
    hs[op_insert_field()] = run_insert_field;
    hs[op_stack_slot()] = run_stack_slot;
    hs[op_load()] = run_load;
    hs[op_store()] = run_store;
    hs[op_call_direct()] = run_call_direct;
    hs[op_call_intrinsic()] = run_call_intrinsic;
    hs[op_jump()] = run_jump;
    hs[op_cond_br()] = run_cond_br;
    hs[op_return()] = run_return;
    return hs;
}

/// Engine operation -> the function that runs it. The IR interpreter runs
/// on the seed, so each one is the same operation on the seed's own values.
pub fn interp_hooks() -> Map<str, any> {
    let hooks = Map<str, any>();
    hooks.set("rt_print", (a) => print(a[0]));
    hooks.set("rt_eprint", (a) => eprint(a[0]));
    hooks.set("list_new", (a) => new_list());
    hooks.set("list_push", (a) => list_push(a[0], a[1]));
    hooks.set("list_pop", (a) => list_pop(a[0]));
    hooks.set("list_remove_at", (a) => list_remove_at(a[0], a[1]));
    hooks.set("list_get", (a) => list_get(a[0], a[1]));
    hooks.set("list_set", (a) => list_set(a[0], a[1], a[2]));
    hooks.set("is_null", (a) => a[0] == none);
    hooks.set("num_pow", (a) => a[0] ** a[1]);
    hooks.set("str_len", (a) => a[0].len());
    hooks.set("str_slice", (a) => a[0].slice(a[1], a[2]));
    hooks.set("str_find", (a) => if a.len() > 2 { a[0].find(a[1], a[2]) } else { a[0].find(a[1], 0) });
    hooks.set("str_contains", (a) => a[0].contains(a[1]));
    hooks.set("str_starts_with", (a) => a[0].starts_with(a[1]));
    hooks.set("str_ends_with", (a) => a[0].ends_with(a[1]));
    hooks.set("str_trim", (a) => a[0].trim());
    hooks.set("str_replace", (a) => a[0].replace(a[1], a[2]));
    hooks.set("str_byte_at", (a) => a[0].byte_at(a[1]));
    hooks.set("to_str", (a) => a[0].to_str());
    hooks.set("map_new", (a) => new_map());
    hooks.set("map_get", (a) => map_get(a[0], a[1]));
    hooks.set("map_set", (a) => map_set(a[0], a[1], a[2]));
    hooks.set("map_has", (a) => map_has(a[0], a[1]));
    hooks.set("map_remove", (a) => map_remove(a[0], a[1]));
    return hooks;
}

fn new_list() -> List<any> {
    var xs: List<any> = [];
    return xs;
}

fn list_push(list: any, item: any) -> any {
    let xs: List<any> = list;
    xs.push(item);
    return xs;
}

fn list_pop(list: any) -> any {
    let xs: List<any> = list;
    return xs.pop();
}

fn list_remove_at(list: any, i: any) -> any {
    let xs: List<any> = list;
    return xs.remove_at(i);
}

fn list_get(list: any, i: any) -> any {
    let xs: List<any> = list;
    return xs[i];
}

fn list_set(list: any, i: any, v: any) {
    let xs: List<any> = list;
    xs[i] = v;
}

fn new_map() -> Map<any, any> => Map<any, any>();

fn map_get(map: any, k: any) -> any {
    let m: Map<any, any> = map;
    return m.get(k);
}

fn map_set(map: any, k: any, v: any) -> any {
    let m: Map<any, any> = map;
    m.set(k, v);
    return m;
}

fn map_has(map: any, k: any) -> bool {
    let m: Map<any, any> = map;
    return m.has(k);
}

fn map_remove(map: any, k: any) -> any {
    let m: Map<any, any> = map;
    return m.remove(k);
}
