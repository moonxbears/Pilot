// ==============================================================================
// FILE: selfhost/ir/interp.pilot
// F5: the PilIR interpreter.
// ==============================================================================
// Runs an `IrModule` so the IR is executable before a native backend exists.
// A function is prepared when it is first called and a block when it first
// runs (`IrCode`, `IrSteps`): each instruction's handler and operands are
// looked up once, not on every run, and a constant is placed in the values a
// call starts from instead of being run.
// Values are `IrVal`s (selfhost/ir/interp_value.pilot); how an instruction
// treats them follows its physics: a 1-bit register constant is a boolean, a
// 64-bit unsigned register constant is unsigned. Each opcode is run by the
// handler registered for it in `interp_handlers()`; an opcode with none
// stops at the seam `ir.interp_opcode`. Operators follow the seed's rules
// (selfhost/ir/interp_ops.pilot); engine operations (`call_intrinsic`) run
// as registered in `interp_engine_ops()` (selfhost/ir/interp_engine.pilot),
// and one with none stops at the seam `ir.interp_hook`. Operators, branch
// conditions, engine operations and global reads that fail stop the program
// with the seed's runtime error (selfhost/ir/fault.pilot).
pub lvl(0) pkg selfhost.ir;


/// What runs or prepares one step.
pub type IrStepFn = (IrFrame, IrStep) => void;

/// One instruction prepared for running: what a run needs of it, looked up
/// once, when its block first runs.
pub struct IrStep : IObject {
    /// Its handler (`interp_handlers()`, or the one its preparer chose).
    pub h: IrStepFn;
    pub inst: IrInst;
    /// Its operands, as `ir_args` gives them.
    pub a: List<i64>;
    /// Where its value goes: its result's id, or the spare slot after the
    /// function's last value when it has no result.
    pub result: i64;
    /// The engine operation it calls, by name.
    pub sym: str;
    /// Its operator, for an arithmetic or comparison step.
    pub oper: IrOp;
    /// Its value, for a constant whose value is not placed.
    pub value: IrVal;
    /// The register a cast converts to, or a narrow arithmetic result is
    /// wrapped to: its class and width; and whether a shift count is taken
    /// modulo the width.
    pub rc: u8;
    pub width: i64;
    pub masked: bool;
    /// What runs the engine operation it calls.
    pub engine: IrEngineOp;
    /// Where a branch goes, with the ids of the values it passes (none when
    /// it passes nothing): `then` for a jump and a taken condition.
    pub then_to: i64;
    pub then_ids: List<i64>?;
    pub else_to: i64;
    pub else_ids: List<i64>?;
}

/// A block prepared for running.
pub struct IrSteps : IObject {
    pub params: List<i64>;
    /// How many parameters it has.
    pub arity: i64;
    /// Its instructions in order, without those whose value `IrCode.start`
    /// holds.
    pub steps: List<IrStep>;
    /// How many steps it has.
    pub count: i64;
    /// How many instructions the block has (what a run of it costs).
    pub cost: i64;
}

/// A function prepared for running.
pub struct IrCode : IObject {
    /// Value id -> the value a call starts with: the constant its one
    /// defining instruction gives, else none. One spare slot follows.
    pub start: List<IrVal>;
    /// Value id -> whether `start` holds its constant.
    pub placed: List<bool>;
    /// Block -> its `IrSteps`, or none until it first runs.
    pub blocks: List<IrSteps?>;
}

/// One activation of a function.
pub struct IrFrame : IObject {
    pub ref m: IrModule;
    pub f: IrFunction;
    /// Value id -> its value.
    pub vals: List<IrVal>;
    /// Stack slot cells; a `stack_slot` value is an index into this list.
    pub cells: List<IrVal>;
    /// The module's globals, shared by every frame; a `global_addr` value
    /// is `-1 - g`, so it never collides with a stack slot index.
    pub ref globals: List<IrVal>;
    /// Whether each global's declaration has run (stored it), shared.
    pub ref assigned: List<bool>;
    /// Where control goes after a terminator: the block, or -1 to return.
    pub next: i64;
    /// Arguments for the next block's parameters.
    pub next_args: List<IrVal>;
    pub ret: IrVal;
    pub handlers: List<IrStepFn>;
    pub preparers: List<IrStepFn>;
    /// Function -> its `IrCode`, or none until it is first called; shared.
    pub code: List<IrCode?>;
    pub engine_ops: Map<str, IrEngineOp>;
    /// The program's runtime error, shared by every frame.
    pub fault: IrFault;
    /// The program's script arguments.
    pub args: List<str>;
    /// The steps left, shared by every frame (see `IrBudget`).
    pub budget: IrBudget;
}

/// How far a run may go. `pilot ir run` runs without a limit; evaluating a
/// function while compiling (`ir_eval`) stops after `left` instructions or
/// `max_eval_depth()` nested calls, and stops at anything with an effect: an
/// engine operation outside `eval_engine_ops()`, a store to a global, a
/// call through a function value. A stop is a fault, never a hang.
pub struct IrBudget : IObject {
    /// Instructions left to run; -1 for no limit.
    pub left: i64;
    /// Calls currently open.
    pub depth: i64;
    /// Whether this is an evaluation while compiling.
    pub eval: bool;
    /// The engine operations it may run (`eval_engine_ops()`), when `eval`.
    pub allowed: Map<str, bool>;
}

/// The deepest an evaluation while compiling may nest calls.
pub pure fn max_eval_depth() -> i64 => 200;

/// The engine operations an evaluation while compiling may run: those that
/// only compute (building, reading and changing values it made itself).
/// Printing, reading input, the program's arguments and seams are not.
pub fn eval_engine_ops() -> Map<str, bool> {
    let ops = Map<str, bool>();
    for name in [
        "rt_fault", "list_new", "list_push", "list_extend", "list_pop", "list_remove_at", "is_null",
        "str_len", "str_slice", "str_find", "str_contains", "str_starts_with", "str_ends_with",
        "str_trim", "str_replace", "str_byte_at", "str_from_bytes", "map_values", "map_keys", "to_str",
        "map_new", "map_get", "map_set", "map_has", "map_remove", "value_clone", "list_get", "list_set",
        "num_pow",
    ] {
        ops.set(name, true);
    }
    return ops;
}

/// What evaluating a function while compiling gave: its value when `ok`,
/// else why it stopped; and how many instructions it ran.
pub struct IrEvalResult : IObject {
    pub ok: bool;
    pub value: IrVal;
    pub why: str;
    pub steps: i64;
}

/// A frame for function `fi` of `m` before it runs.
fn top_frame(ref m: IrModule, fi: i64, ref globals: List<IrVal>, ref assigned: List<bool>, args: List<str>, budget: IrBudget) -> IrFrame =>
    IrFrame { m: m, f: m.functions[fi], vals: [], cells: [], globals: globals, assigned: assigned, next: 0, next_args: [], ret: IrVal.Nil, handlers: interp_handlers(), preparers: interp_preparers(), code: no_code(m), engine_ops: interp_engine_ops(), fault: ir_fault_new(), args: args, budget: budget };

/// Runs function `fi` of `m` (which takes nothing) while compiling, with the
/// globals `globals` (those `assigned` marks as set) and at most `fuel`
/// instructions; stops at a runtime error, an effect, or the budget
/// running out.
pub fn ir_eval(ref m: IrModule, fi: i64, ref globals: List<IrVal>, ref assigned: List<bool>, fuel: i64) -> IrEvalResult {
    let top = top_frame(m, fi, globals, assigned, [], IrBudget { left: fuel, depth: 0, eval: true, allowed: eval_engine_ops() });
    let out = interp_call(top, fi, []);
    let steps = if top.budget.left < 0 { fuel } else { fuel - top.budget.left };
    if top.fault.active { return IrEvalResult { ok: false, value: IrVal.Nil, why: top.fault.message, steps: steps }; }
    return IrEvalResult { ok: true, value: out, why: "", steps: steps };
}

/// The engine operation that gives the program its script arguments; the
/// interpreter answers it with the arguments of the program it runs, not
/// those of the tool it runs in.
pub pure fn program_args_op() -> str => "proc_args";

/// Runs function 0 (the lowering's start function, or `main` in hand-written
/// IR) and returns the exit code `pilot run` would: on a runtime error, 1
/// after reporting it with the places in `sources`. `args` are the program's
/// script arguments.
pub fn ir_run(ref m: IrModule, ref sources: IrSourceMap, args: List<str>) -> i64 {
    var globals: List<IrVal> = [];
    var assigned: List<bool> = [];
    for g in m.globals {
        globals.push(IrVal.Nil);
        assigned.push(false);
    }
    let top = top_frame(m, 0, globals, assigned, args, IrBudget { left: -1, depth: 0, eval: false, allowed: Map<str, bool>() });
    let out = interp_call(top, 0, []);
    if top.fault.active {
        report_fault(top.fault, sources);
        return 1;
    }
    // An integer result is the exit code; anything else (`main` without a
    // value) exits 0, as on the seed.
    return ir_int(out) ?? 0;
}

/// A code table for `m` with no function prepared yet.
fn no_code(ref m: IrModule) -> List<IrCode?> {
    var out: List<IrCode?> = [];
    for f in m.functions { out.push(none); }
    return out;
}

/// Calls function `fi` with `args` from frame `caller`.
fn interp_call(var ref caller: IrFrame, fi: i64, args: List<IrVal>) -> IrVal {
    let budget = caller.budget;
    if !budget.eval { return interp_body(caller, fi, args); }
    if budget.depth >= max_eval_depth() {
        raise_fault(caller.fault, "calls nest too deeply to compute while compiling");
        return IrVal.Nil;
    }
    budget.depth = budget.depth + 1;
    let out = interp_body(caller, fi, args);
    budget.depth = budget.depth - 1;
    return out;
}

/// The operands of `inst`, as `ir_args` gives them.
fn operands(ref f: IrFunction, inst: IrInst) -> List<i64> {
    var out: List<i64> = [];
    for a in ir_args(f, inst) { out.push(a as i64); }
    return out;
}

/// Function `fi` prepared for running; prepared on its first call.
/// A value defined by exactly one instruction whose opcode gives the same
/// value on every run (`is_constant_op`) is placed in the values every
/// call starts from, and the instruction is left out of its block's steps.
fn prepared(var ref fr: IrFrame, fi: i64) -> IrCode {
    if some have = fr.code[fi] { return have; }
    let m = fr.m;
    let f = m.functions[fi];
    let no_value = ir_no_value();
    // Value id -> how many instructions and block parameters define it.
    var defs: List<i64> = [];
    var start: List<IrVal> = [];
    var placed: List<bool> = [];
    for phy in f.value_physics {
        defs.push(0);
        start.push(IrVal.Nil);
        placed.push(false);
    }
    // The spare slot an instruction without a result writes to.
    start.push(IrVal.Nil);
    var blocks: List<IrSteps?> = [];
    var found: List<IrInst> = [];
    for b in f.blocks {
        blocks.push(none);
        for p in b.params { defs[p] = defs[p] + 1; }
        for inst in b.insts {
            if inst.result != no_value {
                defs[inst.result] = defs[inst.result] + 1;
                if is_constant_op(inst.opcode) { found.push(inst); }
            }
        }
    }
    for inst in found {
        if defs[inst.result] == 1 {
            start[inst.result] = constant_value(m, f, inst);
            placed[inst.result] = true;
        }
    }
    let code = IrCode { start: start, placed: placed, blocks: blocks };
    fr.code[fi] = code;
    return code;
}

/// Block `b` of the function of `fr` prepared for running.
fn prepare_block(ref fr: IrFrame, ref code: IrCode, ref b: IrBlock) -> IrSteps {
    let f = fr.f;
    let no_value = ir_no_value();
    let spare = code.placed.len() as i64;
    var params: List<i64> = [];
    for p in b.params { params.push(p as i64); }
    var steps: List<IrStep> = [];
    for inst in b.insts {
        let has_result = inst.result != no_value;
        if !(has_result && code.placed[inst.result]) {
            let st = IrStep { h: table_entry(fr.handlers, inst.opcode, run_missing), inst: inst, a: operands(f, inst), result: if has_result { inst.result as i64 } else { spare }, sym: "", oper: IrOp.Add, value: IrVal.Nil, rc: 0, width: 0, masked: false, engine: no_engine_op, then_to: -1, then_ids: none, else_to: -1, else_ids: none };
            let prepare = table_entry(fr.preparers, inst.opcode, prepare_nothing);
            prepare(fr, st);
            steps.push(st);
        }
    }
    return IrSteps { params: params, arity: params.len() as i64, steps: steps, count: steps.len() as i64, cost: b.insts.len };
}

/// The entry of `opcode` in `table`, or `otherwise` past its end.
fn table_entry(ref table: List<IrStepFn>, opcode: u16, otherwise: IrStepFn) -> IrStepFn => if opcode < table.len() { table[opcode] } else { otherwise };

fn interp_body(var ref caller: IrFrame, fi: i64, args: List<IrVal>) -> IrVal {
    let m = caller.m;
    let f = m.functions[fi];
    let code = prepared(caller, fi);
    // Every start value is a constant, so a copy of the list is enough.
    let vals = ir_values_copy(code.start);
    let fr = IrFrame { m: m, f: f, vals: vals, cells: [], globals: caller.globals, assigned: caller.assigned, next: 0, next_args: args, ret: IrVal.Nil, handlers: caller.handlers, preparers: caller.preparers, engine_ops: caller.engine_ops, fault: caller.fault, args: caller.args, budget: caller.budget, code: caller.code };
    let budget = fr.budget;
    let fault = fr.fault;
    let blocks = code.blocks;
    while fr.next >= 0 {
        let at = fr.next;
        if blocks[at] == none { blocks[at] = prepare_block(fr, code, f.blocks[at]); }
        guard some b = blocks[at] else { return IrVal.Nil; };
        if budget.left >= 0 {
            budget.left = budget.left - b.cost;
            if budget.left < 0 {
                raise_fault(fault, "it takes too long to compute while compiling");
                return IrVal.Nil;
            }
        }
        let arity = b.arity;
        if arity > 0 {
            let params = b.params;
            let passed = fr.next_args;
            var p = 0;
            while p < arity {
                vals[params[p]] = passed[p];
                p = p + 1;
            }
        }
        fr.next = -1;
        let steps = b.steps;
        let count = b.count;
        var i = 0;
        while i < count {
            let st = steps[i];
            let h = st.h;
            h(fr, st);
            if fault.active {
                // Unwinding: the failing instruction's place, then each call's.
                fault.spans.push(f.spans[st.inst.span_id]);
                return IrVal.Nil;
            }
            i = i + 1;
        }
    }
    return fr.ret;
}

/// An opcode with no handler: while compiling, the evaluation stops; in a
/// run, the interpreter stops at its seam.
fn run_missing(var ref fr: IrFrame, ref st: IrStep) {
    let name = opcode_name(st.inst.opcode);
    if fr.budget.eval {
        raise_fault(fr.fault, f"`{name}` is not computed while compiling");
        return;
    }
    seam("ir.interp_opcode", f"the IR interpreter has no handler for `{name}`");
}

/// The preparer of an opcode that needs none.
fn prepare_nothing(ref fr: IrFrame, var ref st: IrStep) {}

/// What a step that calls no engine operation holds in its place; never run.
fn no_engine_op(args: List<IrVal>, var ref fault: IrFault) -> IrVal {
    raise_fault(fault, "internal error: a step without an engine operation ran one");
    return IrVal.Nil;
}

/// The values of `ids` in `vals`.
fn values_of(ref vals: List<IrVal>, ref ids: List<i64>) -> List<IrVal> {
    var out: List<IrVal> = [];
    for a in ids { out.push(vals[a]); }
    return out;
}

/// The integer an address, index or count value holds; a value that holds
/// none stops the program.
fn int_value(var ref fr: IrFrame, v: IrVal, what: str) -> i64? {
    if some n = ir_int(v) { return n; }
    raise_fault(fr.fault, f"{what} must be an integer, found {ir_kind(v)}");
    return none;
}

// ------------------------------------------------------------------------------
// Constants
// ------------------------------------------------------------------------------

/// Whether an instruction of `opcode` gives the same value on every run.
fn is_constant_op(opcode: u16) -> bool =>
    opcode == op_const_bits() || opcode == op_const_float() || opcode == op_const_bytes() || opcode == op_undef() || opcode == op_global_addr();

/// The value constant instruction `inst` gives (`is_constant_op`).
fn constant_value(ref m: IrModule, ref f: IrFunction, inst: IrInst) -> IrVal {
    let op = inst.opcode;
    if op == op_const_bits() { return bits_value(inst.physics, m.ints[ir_args(f, inst)[0]]); }
    if op == op_const_float() { return IrVal.Flt(f64_from_bits(m.floats[ir_args(f, inst)[0]])); }
    if op == op_const_bytes() { return IrVal.Text(m.strings[ir_args(f, inst)[0]]); }
    if op == op_global_addr() { return IrVal.Int(-1 - (inst.subop as i64)); }
    return IrVal.Nil;
}

/// A constant integer as a value of physics `phy`.
fn bits_value(phy: IrTypePhysics, v: i64) -> IrVal {
    if phy.bit_width == 1 { return IrVal.Bool(v != 0); }
    if phy.reg_class == reg_class_gpr_unsigned() && phy.bit_width >= 64 { return IrVal.UInt(v as u64); }
    return IrVal.Int(v);
}

/// The binary64 value whose bits are `bits`: sign, 11-bit exponent and
/// 52-bit fraction (IEEE 754-2019 section 3.4). Scaling by powers of two is
/// exact, so the result is the value itself.
pub fn f64_from_bits(bits: i64) -> f64 {
    let neg = bits < 0;
    let exp = (bits >> 52) & 2047;
    let frac = bits & 4503599627370495;
    if exp == 2047 {
        if frac != 0 { return 0.0 / 0.0; }
        return if neg { -1.0 / 0.0 } else { 1.0 / 0.0 };
    }
    // Normal: (2^52 + frac) * 2^(exp - 1075); subnormal: frac * 2^-1074.
    var mant = (if exp == 0 { frac } else { frac + 4503599627370496 }) as f64;
    var e = if exp == 0 { -1074 } else { exp - 1075 };
    while e > 0 {
        mant = mant * 2.0;
        e = e - 1;
    }
    while e < 0 {
        mant = mant * 0.5;
        e = e + 1;
    }
    return if neg { -mant } else { mant };
}

/// A constant whose value is not placed (its result is defined more than
/// once, or it has none): the step holds its value.
fn prepare_constant(ref fr: IrFrame, var ref st: IrStep) { st.value = constant_value(fr.m, fr.f, st.inst); }

fn run_constant(var ref fr: IrFrame, ref st: IrStep) { fr.vals[st.result] = st.value; }

// ------------------------------------------------------------------------------
// Operators
// ------------------------------------------------------------------------------

/// A binary operator (`st.oper`) on the instruction's two operands.
fn run_binary(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    let vals = fr.vals;
    vals[st.result] = ir_binary(st.oper, vals[a[0]], vals[a[1]], fr.fault);
}

/// Whether a register is narrower than 64 bits: an integer register of 2 to
/// 63 bits, or a 32-bit float register.
fn is_narrow_register(phy: IrTypePhysics) -> bool {
    let is_int = phy.reg_class == reg_class_gpr_signed() || phy.reg_class == reg_class_gpr_unsigned();
    if is_int { return phy.bit_width > 1 && phy.bit_width < 64; }
    return phy.reg_class == reg_class_simd_float() && phy.bit_width == 32;
}

/// The operator of an arithmetic opcode.
fn arith_op(opcode: u16) -> IrOp {
    if opcode == op_add() { return IrOp.Add; }
    if opcode == op_sub() { return IrOp.Sub; }
    if opcode == op_mul() { return IrOp.Mul; }
    if opcode == op_div() { return IrOp.Div; }
    if opcode == op_rem() { return IrOp.Rem; }
    if opcode == op_bit_and() { return IrOp.And; }
    if opcode == op_bit_or() { return IrOp.Or; }
    if opcode == op_bit_xor() { return IrOp.Xor; }
    if opcode == op_shl() { return IrOp.Shl; }
    return IrOp.Shr;
}

/// An arithmetic operator. Integers are computed in 64 bits and floats as
/// f64, so a result in a narrower register is wrapped or rounded to it
/// (`run_narrow`).
fn prepare_arith(ref fr: IrFrame, var ref st: IrStep) {
    let op = arith_op(st.inst.opcode);
    st.oper = op;
    let phy = st.inst.physics;
    if !is_narrow_register(phy) {
        if both_signed_64(fr, st) {
            if some h = int_arith_handler(op) { st.h = h; }
        }
        return;
    }
    st.rc = phy.reg_class;
    st.width = phy.bit_width;
    st.masked = (op == IrOp.Shl || op == IrOp.Shr) && phy.reg_class != reg_class_simd_float();
    st.h = run_narrow;
}

/// An arithmetic operator whose result is in a narrow register: wrapped or
/// rounded to it, and a shift count in a narrow integer register is taken
/// modulo the register's width.
fn run_narrow(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    let vals = fr.vals;
    let fault = fr.fault;
    var count = vals[a[1]];
    if st.masked {
        count = ir_bitwise(IrOp.And, count, IrVal.Int(st.width - 1), fault);
        if fault.active { return; }
    }
    let v = ir_binary(st.oper, vals[a[0]], count, fault);
    if fault.active { return; }
    vals[st.result] = ir_wrap(v, st.rc, st.width, fault);
}

/// The operator of each comparison predicate (`CmpPred` 0..5).
const CMP_OPS: List<IrOp> = [IrOp.Eq, IrOp.Ne, IrOp.Lt, IrOp.Le, IrOp.Gt, IrOp.Ge,];

fn prepare_cmp(ref fr: IrFrame, var ref st: IrStep) {
    st.oper = CMP_OPS[st.inst.subop as i64];
    if both_signed_64(fr, st) { st.h = INT_CMP[st.inst.subop as i64]; }
}

/// Whether both operands of the step are signed 64-bit integers by the
/// checker's types: their values are then almost always `Int`s, which the
/// direct handlers (`run_add_ii` ..) compute without the general operator's
/// dispatch, falling back to it for anything else.
fn both_signed_64(ref fr: IrFrame, ref st: IrStep) -> bool {
    let a = st.a;
    if a.len() != 2 { return false; }
    let vp = fr.f.value_physics;
    let p = vp[a[0]];
    let q = vp[a[1]];
    return p.reg_class == reg_class_gpr_signed() && p.bit_width == 64 && q.reg_class == reg_class_gpr_signed() && q.bit_width == 64;
}

/// The direct handler of a signed 64-bit arithmetic operator, if it has one.
fn int_arith_handler(op: IrOp) -> IrStepFn? {
    if op == IrOp.Add { return run_add_ii; }
    if op == IrOp.Sub { return run_sub_ii; }
    if op == IrOp.Mul { return run_mul_ii; }
    return none;
}

fn run_add_ii(var ref fr: IrFrame, ref st: IrStep) {
    let v = fr.vals;
    let x = v[st.a[0]];
    let y = v[st.a[1]];
    switch x {
        case Int(p): switch y {
            case Int(q): { v[st.result] = IrVal.Int(p + q); return; }
            default: {}
        }
        default: {}
    }
    v[st.result] = ir_binary(st.oper, x, y, fr.fault);
}

fn run_sub_ii(var ref fr: IrFrame, ref st: IrStep) {
    let v = fr.vals;
    let x = v[st.a[0]];
    let y = v[st.a[1]];
    switch x {
        case Int(p): switch y {
            case Int(q): { v[st.result] = IrVal.Int(p - q); return; }
            default: {}
        }
        default: {}
    }
    v[st.result] = ir_binary(st.oper, x, y, fr.fault);
}

fn run_mul_ii(var ref fr: IrFrame, ref st: IrStep) {
    let v = fr.vals;
    let x = v[st.a[0]];
    let y = v[st.a[1]];
    switch x {
        case Int(p): switch y {
            case Int(q): { v[st.result] = IrVal.Int(p * q); return; }
            default: {}
        }
        default: {}
    }
    v[st.result] = ir_binary(st.oper, x, y, fr.fault);
}

/// A signed 64-bit comparison: `c` of two `Int`s is -1, 0 or 1.
fn int_cmp_of(var ref fr: IrFrame, ref st: IrStep) -> i64? {
    let v = fr.vals;
    switch v[st.a[0]] {
        case Int(p): switch v[st.a[1]] {
            case Int(q): return if p < q { -1 } else if p > q { 1 } else { 0 };
            default: return none;
        }
        default: return none;
    }
}

fn run_eq_ii(var ref fr: IrFrame, ref st: IrStep) {
    if some c = int_cmp_of(fr, st) { fr.vals[st.result] = IrVal.Bool(c == 0); } else { run_binary(fr, st); }
}

fn run_ne_ii(var ref fr: IrFrame, ref st: IrStep) {
    if some c = int_cmp_of(fr, st) { fr.vals[st.result] = IrVal.Bool(c != 0); } else { run_binary(fr, st); }
}

fn run_lt_ii(var ref fr: IrFrame, ref st: IrStep) {
    if some c = int_cmp_of(fr, st) { fr.vals[st.result] = IrVal.Bool(c < 0); } else { run_binary(fr, st); }
}

fn run_le_ii(var ref fr: IrFrame, ref st: IrStep) {
    if some c = int_cmp_of(fr, st) { fr.vals[st.result] = IrVal.Bool(c <= 0); } else { run_binary(fr, st); }
}

fn run_gt_ii(var ref fr: IrFrame, ref st: IrStep) {
    if some c = int_cmp_of(fr, st) { fr.vals[st.result] = IrVal.Bool(c > 0); } else { run_binary(fr, st); }
}

fn run_ge_ii(var ref fr: IrFrame, ref st: IrStep) {
    if some c = int_cmp_of(fr, st) { fr.vals[st.result] = IrVal.Bool(c >= 0); } else { run_binary(fr, st); }
}

/// The direct handler of each comparison predicate, in `CMP_OPS` order.
const INT_CMP: List<IrStepFn> = [run_eq_ii, run_ne_ii, run_lt_ii, run_le_ii, run_gt_ii, run_ge_ii,];

// ------------------------------------------------------------------------------
// Memory and calls
// ------------------------------------------------------------------------------

fn run_stack_slot(var ref fr: IrFrame, ref st: IrStep) {
    let cells = fr.cells;
    cells.push(IrVal.Nil);
    fr.vals[st.result] = IrVal.Int(cells.len() - 1);
}

fn run_load(var ref fr: IrFrame, ref st: IrStep) {
    let vals = fr.vals;
    guard some addr = int_value(fr, vals[st.a[0]], "an address") else { return; };
    if addr >= 0 {
        vals[st.result] = fr.cells[addr];
        return;
    }
    let g = -1 - addr;
    if !fr.assigned[g] {
        raise_fault(fr.fault, f"`{fr.m.globals[g].name}` is read before its declaration has run");
        return;
    }
    vals[st.result] = fr.globals[g];
}

fn run_store(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    let vals = fr.vals;
    guard some addr = int_value(fr, vals[a[0]], "an address") else { return; };
    if addr >= 0 {
        fr.cells[addr] = vals[a[1]];
        return;
    }
    if fr.budget.eval {
        raise_fault(fr.fault, "a global is changed");
        return;
    }
    fr.globals[-1 - addr] = vals[a[1]];
    fr.assigned[-1 - addr] = true;
}

fn run_call_direct(var ref fr: IrFrame, ref st: IrStep) {
    let vals = fr.vals;
    vals[st.result] = interp_call(fr, st.inst.subop, values_of(vals, st.a));
}

/// `call_indirect f, args..`: the function record `f` names, called with
/// `args` then the record's captured values (selfhost/ir/lower_closure.pilot).
fn run_call_indirect(var ref fr: IrFrame, ref st: IrStep) {
    if fr.budget.eval {
        raise_fault(fr.fault, "a function value is called");
        return;
    }
    let a = values_of(fr.vals, st.a);
    let callee = a[0];
    switch callee {
        case Seq(rec): {
            guard some fi = int_value(fr, rec[0], "a function value's function") else { return; };
            var args: List<IrVal> = [];
            var i = 1;
            while i < a.len() { args.push(a[i]); i = i + 1; }
            i = 1;
            while i < rec.len() { args.push(rec[i]); i = i + 1; }
            fr.vals[st.result] = interp_call(fr, fi, args);
        }
        default: raise_fault(fr.fault, f"cannot call {ir_kind(callee)}");
    }
}

/// An engine operation: what stops it is the same on every run, so it is
/// decided once (an evaluation while compiling runs only what it may; the
/// program's arguments are the interpreter's own; one with no entry in
/// `interp_engine_ops()` stops at its seam).
fn prepare_intrinsic(ref fr: IrFrame, var ref st: IrStep) {
    let name = fr.m.intrinsics[st.inst.subop];
    st.sym = name;
    if fr.budget.eval && !fr.budget.allowed.has(name) {
        st.h = run_intrinsic_refused;
    } else if name == program_args_op() {
        st.h = run_program_args;
    } else if name == "host_op" {
        st.h = run_host_op;
    } else if some op = fr.engine_ops.get(name) {
        st.engine = op;
    } else {
        st.h = run_intrinsic_seam;
    }
}

fn run_intrinsic_refused(var ref fr: IrFrame, ref st: IrStep) {
    raise_fault(fr.fault, f"the engine operation `{st.sym}` is not run while compiling");
}

fn run_program_args(var ref fr: IrFrame, ref st: IrStep) {
    var texts: List<IrVal> = [];
    for a in fr.args { texts.push(IrVal.Text(a)); }
    fr.vals[st.result] = IrVal.Seq(texts);
}

fn run_intrinsic_seam(var ref fr: IrFrame, ref st: IrStep) {
    seam("ir.interp_hook", f"the IR interpreter does not run the engine operation `{st.sym}`");
}

fn run_call_intrinsic(var ref fr: IrFrame, ref st: IrStep) {
    let vals = fr.vals;
    let op = st.engine;
    vals[st.result] = op(values_of(vals, st.a), fr.fault);
}

/// `host_op`: the host's own, except the program's arguments (op 35, sub-op
/// 2), which are the interpreter's: written as the seed writes them
/// (crates/pilot-vm bridge.rs `write_var_out`) — each argument as its
/// 4-byte length then its bytes; the total size to `out_len_ptr`; -44 when
/// they do not fit, -12 when there is something to write and nowhere to
/// write it; else how many arguments there are.
fn run_host_op(var ref fr: IrFrame, ref st: IrStep) {
    let vals = fr.vals;
    let fault = fr.fault;
    let args = values_of(vals, st.a);
    if args.len() >= 7 && ir_int(args[0]) == 35 && ir_int(args[1]) == 2 {
        let buf = ir_int(args[4]) ?? 0;
        let cap = ir_int(args[5]) ?? 0;
        let out_len_ptr = ir_int(args[6]) ?? 0;
        var total = 0;
        for a in fr.args { total = total + 4 + a.len(); }
        if out_len_ptr != 0 {
            let _ = host_checked("host_op", [IrVal.Int(8), IrVal.Int(out_len_ptr), IrVal.Int(total), IrVal.Int(64)], fault);
        }
        if cap < total {
            vals[st.result] = IrVal.Int(-44);
            return;
        }
        if total > 0 && buf == 0 {
            vals[st.result] = IrVal.Int(-12);
            return;
        }
        var off = 0;
        for a in fr.args {
            let _ = host_checked("host_op", [IrVal.Int(8), IrVal.Int(buf + off), IrVal.Int(a.len()), IrVal.Int(32)], fault);
            off = off + 4;
            if a.len() > 0 {
                let _ = host_checked("str_copy_to_ptr", [IrVal.Text(a), IrVal.Int(buf + off), IrVal.Int(a.len())], fault);
                off = off + a.len();
            }
        }
        vals[st.result] = IrVal.Int(fr.args.len());
        return;
    }
    let op = fr.engine_ops.get("host_op") ?? no_engine_op;
    vals[st.result] = op(args, fault);
}

// ------------------------------------------------------------------------------
// Aggregates and casts
// ------------------------------------------------------------------------------

/// An aggregate is a record of its field values. Records are shared, not
/// copied, when a value is passed on. A struct (a layout with a record
/// entry) is held as the seed holds one, a record from field name to value
/// carrying its layout, so it prints as `{ name: value, .. }` wherever it
/// goes; any other aggregate (a tuple, a closure) is a list of its values.
[StandIn("ir.aggregate_by_reference", "a 0b00 value is copied when it is bound or passed (memcpy)", "the IR interpreter shares one record between every copy, as the seed does", "F5")]
fn run_construct_aggregate(var ref fr: IrFrame, ref st: IrStep) {
    let vals = values_of(fr.vals, st.a);
    let layout = st.inst.physics.layout_id;
    if some rec = ir_record_of(fr.m, layout) {
        if rec.names.len() == vals.len() {
            var named = Map<str, IrVal>();
            var i = 0;
            while i < vals.len() {
                named.set(rec.names[i], vals[i]);
                i = i + 1;
            }
            fr.vals[st.result] = IrVal.Rec(named, layout as i64);
            return;
        }
    }
    fr.vals[st.result] = IrVal.Seq(vals);
}

/// The name of field `slot` of a struct record of `layout`, else "".
fn field_name(ref m: IrModule, layout: i64?, slot: i64) -> str {
    guard some l = layout else { return ""; };
    if some rec = ir_record_of(m, l as u32) {
        if slot < rec.names.len() { return rec.names[slot]; }
    }
    return "";
}

fn run_extract_field(var ref fr: IrFrame, ref st: IrStep) {
    let v = fr.vals[st.a[0]];
    let slot = st.inst.subop as i64;
    switch v {
        case Rec(fields, layout): {
            let name = field_name(fr.m, layout, slot);
            fr.vals[st.result] = fields.get(if name != "" { name } else { f"{slot}" }) ?? IrVal.Nil;
        }
        case Seq(items): {
            if slot >= items.len() {
                raise_fault(fr.fault, f"list index {slot} out of bounds for length {items.len()}");
                return;
            }
            fr.vals[st.result] = items[slot];
        }
        default: raise_fault(fr.fault, f"cannot read `{slot}` from {ir_kind(v)}");
    }
}

fn run_insert_field(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    let v = fr.vals[a[0]];
    let slot = st.inst.subop as i64;
    switch v {
        case Rec(fields, layout): {
            let name = field_name(fr.m, layout, slot);
            fields.set(if name != "" { name } else { f"{slot}" }, fr.vals[a[1]]);
        }
        case Seq(items): {
            if slot >= items.len() {
                raise_fault(fr.fault, f"list index {slot} out of bounds for length {items.len()}");
                return;
            }
            items[slot] = fr.vals[a[1]];
        }
        default: raise_fault(fr.fault, f"cannot assign `{slot}` on {ir_kind(v)}");
    }
}

fn prepare_cast(ref fr: IrFrame, var ref st: IrStep) {
    let phy = st.inst.physics;
    st.rc = phy.reg_class;
    st.width = phy.bit_width;
    if is_same_int(fr.f.value_physics[st.a[0]], phy) { st.h = run_same; }
}

/// Whether a cast from register `from` to register `to` changes nothing:
/// into a signed 64-bit integer from a signed integer, which is held as a
/// signed 64-bit integer whatever its width. An unsigned register may hold
/// a value held apart (a character, a 64-bit unsigned value), which the
/// cast converts.
fn is_same_int(from: IrTypePhysics, to: IrTypePhysics) -> bool {
    if to.reg_class != reg_class_gpr_signed() || to.bit_width != 64 || from.bit_width <= 1 { return false; }
    return from.reg_class == reg_class_gpr_signed();
}

/// A cast that changes nothing (`is_same_int`).
fn run_same(var ref fr: IrFrame, ref st: IrStep) { let v = fr.vals; v[st.result] = v[st.a[0]]; }

/// `cast`: the value converted to the result's register physics, as the
/// seed converts `T(x)` (`ir_convert`).
fn run_cast(var ref fr: IrFrame, ref st: IrStep) {
    let vals = fr.vals;
    vals[st.result] = ir_convert(vals[st.a[0]], st.rc, st.width, fr.fault);
}

// ------------------------------------------------------------------------------
// Control
// ------------------------------------------------------------------------------

/// The value ids `count` operands from `from` name, or none when there are
/// none (a branch that passes nothing).
fn passed_ids(ref a: List<i64>, from: i64, count: i64) -> List<i64>? {
    if count == 0 { return none; }
    var out: List<i64> = [];
    var i = 0;
    while i < count {
        out.push(a[from + i]);
        i = i + 1;
    }
    return out;
}

/// `jump target, args..`.
fn prepare_jump(ref fr: IrFrame, var ref st: IrStep) {
    st.then_to = st.a[0];
    st.then_ids = passed_ids(st.a, 1, st.a.len() - 1);
}

fn run_jump(var ref fr: IrFrame, ref st: IrStep) {
    fr.next = st.then_to;
    if some ids = st.then_ids { fr.next_args = values_of(fr.vals, ids); }
}

/// `cond_br c, then, n, args.., else, n, args..`.
fn prepare_cond_br(ref fr: IrFrame, var ref st: IrStep) {
    let a = st.a;
    let other = 3 + a[2];
    st.then_to = a[1];
    st.then_ids = passed_ids(a, 3, a[2]);
    st.else_to = a[other];
    st.else_ids = passed_ids(a, other + 2, a[other + 1]);
}

fn run_cond_br(var ref fr: IrFrame, ref st: IrStep) {
    let vals = fr.vals;
    let c = vals[st.a[0]];
    var taken = false;
    switch c {
        case Bool(b): taken = b;
        default: {
            // Anything but a boolean stops the program with the seed's
            // message.
            raise_fault(fr.fault, f"condition must be a boolean, found {ir_kind(c)}");
            return;
        }
    }
    if taken {
        fr.next = st.then_to;
        if some ids = st.then_ids { fr.next_args = values_of(vals, ids); }
    } else {
        fr.next = st.else_to;
        if some ids = st.else_ids { fr.next_args = values_of(vals, ids); }
    }
}

/// `switch_table index, default, targets..`: goes to target `index`, or to
/// the default when there is none.
fn run_switch_table(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    guard some i = int_value(fr, fr.vals[a[0]], "a switch index") else { return; };
    fr.next = if i >= 0 && i + 2 < a.len() { a[2 + i] } else { a[1] };
}

/// `unreachable [message]`: stops the program with `message`.
fn run_unreachable(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    raise_fault(fr.fault, if a.len() > 0 { ir_display(fr.vals[a[0]]) } else { "entered code the program cannot reach" });
}

fn run_return(var ref fr: IrFrame, ref st: IrStep) {
    let a = st.a;
    fr.ret = if a.len() > 0 { fr.vals[a[0]] } else { IrVal.Nil };
    fr.next = -1;
}

// ------------------------------------------------------------------------------
// Tables
// ------------------------------------------------------------------------------

/// A table holding `entry` for every opcode.
fn opcode_table(entry: IrStepFn) -> List<IrStepFn> {
    var t: List<IrStepFn> = [];
    var i = 0;
    while i < opcode_names().len() {
        t.push(entry);
        i = i + 1;
    }
    return t;
}

/// Opcode -> what prepares its step (sets its operator, value, register or
/// branch targets, and may choose a more exact handler).
pub fn interp_preparers() -> List<IrStepFn> {
    var ps = opcode_table(prepare_nothing);
    for op in [op_const_bits(), op_const_bytes(), op_const_float(), op_undef(), op_global_addr()] { ps[op] = prepare_constant; }
    for op in [op_add(), op_sub(), op_mul(), op_div(), op_rem(), op_bit_and(), op_bit_or(), op_bit_xor(), op_shl(), op_shr()] { ps[op] = prepare_arith; }
    ps[op_cmp()] = prepare_cmp;
    ps[op_cast()] = prepare_cast;
    ps[op_call_intrinsic()] = prepare_intrinsic;
    ps[op_jump()] = prepare_jump;
    ps[op_cond_br()] = prepare_cond_br;
    return ps;
}

/// Opcode -> its handler; `run_missing` for an opcode the interpreter does
/// not run.
pub fn interp_handlers() -> List<IrStepFn> {
    var hs = opcode_table(run_missing);
    for op in [op_const_bits(), op_const_bytes(), op_const_float(), op_undef(), op_global_addr()] { hs[op] = run_constant; }
    for op in [op_add(), op_sub(), op_mul(), op_div(), op_rem(), op_bit_and(), op_bit_or(), op_bit_xor(), op_shl(), op_shr(), op_cmp()] { hs[op] = run_binary; }
    hs[op_cast()] = run_cast;
    hs[op_construct_aggregate()] = run_construct_aggregate;
    hs[op_extract_field()] = run_extract_field;
    hs[op_insert_field()] = run_insert_field;
    hs[op_stack_slot()] = run_stack_slot;
    hs[op_load()] = run_load;
    hs[op_store()] = run_store;
    hs[op_call_direct()] = run_call_direct;
    hs[op_call_indirect()] = run_call_indirect;
    hs[op_call_intrinsic()] = run_call_intrinsic;
    hs[op_jump()] = run_jump;
    hs[op_cond_br()] = run_cond_br;
    hs[op_switch_table()] = run_switch_table;
    hs[op_return()] = run_return;
    hs[op_unreachable()] = run_unreachable;
    return hs;
}
