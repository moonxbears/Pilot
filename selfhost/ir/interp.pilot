// ==============================================================================
// FILE: selfhost/ir/interp.pilot
// F5: the PilIR interpreter.
// ==============================================================================
// Runs an `IrModule` so the IR is executable before a native backend exists.
// Values are the interpreter's own values; how an instruction treats them
// follows its physics: a 1-bit register constant is a boolean, a 64-bit
// unsigned register constant is unsigned. Each opcode is run by the handler
// registered for it in `interp_handlers()`; an opcode with none stops at the
// seam `ir.interp_opcode`. Engine operations (`call_intrinsic`) are the
// seed's own, run under the names registered in `interp_engine_ops()`; one
// with none stops at the seam `ir.interp_hook`. Operators, branch
// conditions, engine operations and global reads that fail stop the program
// with the seed's runtime error (selfhost/ir/fault.pilot).
pub lvl(0) pkg Pilot.SelfHost.Ir.Interp;

use selfhost.ir.model.*;
use selfhost.ir.fault.*;

/// One activation of a function.
pub struct IrFrame : IObject {
    pub m: IrModule;
    pub f: IrFunction;
    /// Value id -> its value.
    pub vals: List<any>;
    /// Stack slot cells; a `stack_slot` value is an index into this list.
    pub cells: List<any>;
    /// The module's globals, shared by every frame; a `global_addr` value
    /// is `-1 - g`, so it never collides with a stack slot index.
    pub globals: List<any>;
    /// Whether each global's declaration has run (stored it), shared.
    pub assigned: List<bool>;
    /// Where control goes after a terminator: the block, or -1 to return.
    pub next: i64;
    /// Arguments for the next block's parameters.
    pub next_args: List<any>;
    pub ret: any;
    pub handlers: List<any>;
    pub engine_ops: Map<str, str>;
    /// The program's runtime error, shared by every frame.
    pub fault: IrFault;
    /// The program's script arguments.
    pub args: List<str>;
    /// The steps left, shared by every frame (see `IrBudget`).
    pub budget: IrBudget;
}

/// How far a run may go. `pilot ir run` runs without a limit; evaluating a
/// function while compiling (`ir_eval`) stops after `left` instructions or
/// `max_eval_depth()` nested calls, and stops at anything with an effect: an
/// engine operation outside `eval_engine_ops()`, a store to a global, a
/// call through a function value. A stop is a fault, never a hang.
pub struct IrBudget : IObject {
    /// Instructions left to run; -1 for no limit.
    pub left: i64;
    /// Calls currently open.
    pub depth: i64;
    /// Whether this is an evaluation while compiling.
    pub eval: bool;
    /// The engine operations it may run (`eval_engine_ops()`), when `eval`.
    pub allowed: Map<str, bool>;
}

/// The deepest an evaluation while compiling may nest calls.
pub pure fn max_eval_depth() -> i64 => 200;

/// The engine operations an evaluation while compiling may run: those that
/// only compute (building, reading and changing values it made itself).
/// Printing, reading input, the program's arguments and seams are not.
pub fn eval_engine_ops() -> Map<str, bool> {
    let ops = Map<str, bool>();
    for name in [
        "rt_fault", "list_new", "list_push", "list_extend", "list_pop", "list_remove_at", "is_null",
        "str_len", "str_slice", "str_find", "str_contains", "str_starts_with", "str_ends_with",
        "str_trim", "str_replace", "str_byte_at", "str_from_bytes", "map_values", "to_str",
        "map_new", "map_get", "map_set", "map_has", "map_remove", "value_clone", "list_get", "list_set",
        "num_pow",
    ] {
        ops.set(name, true);
    }
    return ops;
}

/// Runs function `fi` of `m` (which takes nothing) while compiling, with the
/// globals `globals` (those `assigned` marks as set) and at most `fuel`
/// instructions. Gives `[true, value, steps]`, or `[false, why, steps]`
/// when it stopped: a runtime error, an effect, or the budget running out.
/// `steps` is how many instructions it ran.
pub fn ir_eval(m: IrModule, fi: i64, globals: List<any>, assigned: List<bool>, fuel: i64) -> List<any> {
    let top = IrFrame { m: m, f: m.functions[fi], vals: [], cells: [], globals: globals, assigned: assigned, next: 0, next_args: [], ret: none, handlers: interp_handlers(), engine_ops: interp_engine_ops(), fault: ir_fault_new(), args: [], budget: IrBudget { left: fuel, depth: 0, eval: true, allowed: eval_engine_ops() } };
    let out = interp_call(top, fi, []);
    let steps = if top.budget.left < 0 { fuel } else { fuel - top.budget.left };
    if top.fault.active { return [false, top.fault.message, steps]; }
    return [true, out, steps];
}

/// The engine operation that gives the program its script arguments; the
/// interpreter answers it with the arguments of the program it runs, not
/// those of the tool it runs in.
pub pure fn program_args_op() -> str => "proc_args";

/// Runs function 0 (the lowering's start function, or `main` in hand-written
/// IR) and returns the exit code `pilot run` would: on a runtime error, 1
/// after reporting it with the places in `sources`. `args` are the program's
/// script arguments.
pub fn ir_run(m: IrModule, sources: IrSourceMap, args: List<str>) -> i64 {
    var globals: List<any> = [];
    var assigned: List<bool> = [];
    for g in m.globals {
        globals.push(none);
        assigned.push(false);
    }
    let top = IrFrame { m: m, f: m.functions[0], vals: [], cells: [], globals: globals, assigned: assigned, next: 0, next_args: [], ret: none, handlers: interp_handlers(), engine_ops: interp_engine_ops(), fault: ir_fault_new(), args: args, budget: IrBudget { left: -1, depth: 0, eval: false, allowed: Map<str, bool>() } };
    let out = interp_call(top, 0, []);
    if top.fault.active {
        report_fault(top.fault, sources);
        return 1;
    }
    // `main` without a value exits 0, as on the seed.
    return if out == none { 0 } else { out };
}

/// Calls function `fi` with `args` from frame `caller`.
fn interp_call(caller: IrFrame, fi: i64, args: List<any>) -> any {
    let budget = caller.budget;
    if !budget.eval { return interp_body(caller, fi, args); }
    if budget.depth >= max_eval_depth() {
        raise_fault(caller.fault, "calls nest too deeply to compute while compiling");
        return none;
    }
    budget.depth = budget.depth + 1;
    let out = interp_body(caller, fi, args);
    budget.depth = budget.depth - 1;
    return out;
}

fn interp_body(caller: IrFrame, fi: i64, args: List<any>) -> any {
    let m = caller.m;
    let f = m.functions[fi];
    var vals: List<any> = [];
    var i = 0;
    while i < f.value_physics.len {
        vals.push(none);
        i = i + 1;
    }
    let fr = IrFrame { m: m, f: f, vals: vals, cells: [], globals: caller.globals, assigned: caller.assigned, next: 0, next_args: args, ret: none, handlers: caller.handlers, engine_ops: caller.engine_ops, fault: caller.fault, args: caller.args, budget: caller.budget };
    let handlers = fr.handlers;
    let budget = fr.budget;
    while fr.next >= 0 {
        let b = f.blocks[fr.next];
        if budget.left >= 0 {
            budget.left = budget.left - b.insts.len;
            if budget.left < 0 {
                raise_fault(fr.fault, "it takes too long to compute while compiling");
                return none;
            }
        }
        var p = 0;
        while p < b.params.len {
            fr.vals[b.params[p]] = fr.next_args[p];
            p = p + 1;
        }
        fr.next = -1;
        for inst in b.insts {
            let h = if inst.opcode < handlers.len { handlers[inst.opcode] } else { none };
            if h == none {
                if budget.eval {
                    raise_fault(fr.fault, f"`{opcode_name(inst.opcode)}` is not computed while compiling");
                    return none;
                }
                return seam("ir.interp_opcode", f"the IR interpreter has no handler for `{opcode_name(inst.opcode)}`");
            }
            h(fr, inst);
            if fr.fault.active {
                // Unwinding: the failing instruction's place, then each call's.
                fr.fault.spans.push(f.spans[inst.span_id]);
                return none;
            }
        }
    }
    return fr.ret;
}

/// Engine operation `name` on `args` as the seed runs it; on failure the
/// program stops with the seed's message.
fn checked(fr: IrFrame, name: str, args: List<any>) -> any {
    let r = op_checked(name, args);
    if r[0] == true { return r[1]; }
    raise_fault(fr.fault, r[1]);
    return none;
}

fn arg_values(fr: IrFrame, inst: IrInst) -> List<any> {
    var out: List<any> = [];
    for a in ir_args(fr.f, inst) { out.push(fr.vals[a]); }
    return out;
}

/// Stores the value of `inst`; an instruction with no result (a call made
/// for its effect) stores nothing.
fn put(fr: IrFrame, inst: IrInst, v: any) {
    if inst.result != ir_no_value() { fr.vals[inst.result] = v; }
}

/// A constant integer as a value of physics `phy`.
fn bits_value(phy: IrTypePhysics, v: i64) -> any {
    if phy.bit_width == 1 { return v != 0; }
    if phy.reg_class == reg_class_gpr_unsigned() && phy.bit_width >= 64 { return v as u64; }
    return v;
}

fn run_const_bits(fr: IrFrame, inst: IrInst) {
    put(fr, inst, bits_value(inst.physics, fr.m.ints[ir_args(fr.f, inst)[0]]));
}

/// The binary64 value whose bits are `bits`: sign, 11-bit exponent and
/// 52-bit fraction (IEEE 754-2019 section 3.4). Scaling by powers of two is
/// exact, so the result is the value itself.
pub fn f64_from_bits(bits: i64) -> f64 {
    let neg = bits < 0;
    let exp = (bits >> 52) & 2047;
    let frac = bits & 4503599627370495;
    if exp == 2047 {
        if frac != 0 { return 0.0 / 0.0; }
        return if neg { -1.0 / 0.0 } else { 1.0 / 0.0 };
    }
    // Normal: (2^52 + frac) * 2^(exp - 1075); subnormal: frac * 2^-1074.
    var mant = (if exp == 0 { frac } else { frac + 4503599627370496 }) as f64;
    var e = if exp == 0 { -1074 } else { exp - 1075 };
    while e > 0 {
        mant = mant * 2.0;
        e = e - 1;
    }
    while e < 0 {
        mant = mant * 0.5;
        e = e + 1;
    }
    return if neg { -mant } else { mant };
}

fn run_const_float(fr: IrFrame, inst: IrInst) { put(fr, inst, f64_from_bits(fr.m.floats[ir_args(fr.f, inst)[0]])); }

fn run_const_bytes(fr: IrFrame, inst: IrInst) { put(fr, inst, fr.m.strings[ir_args(fr.f, inst)[0]]); }

fn run_undef(fr: IrFrame, inst: IrInst) { put(fr, inst, none); }

fn binary(fr: IrFrame, inst: IrInst) -> List<any> => arg_values(fr, inst);

/// A binary operator on the instruction's two operands, as the seed's.
fn run_binary(fr: IrFrame, inst: IrInst, symbol: str) { put(fr, inst, checked(fr, symbol, binary(fr, inst))); }

/// Whether a register is narrower than the engine's own numbers: an integer
/// register of 2 to 63 bits, or a 32-bit float register.
fn is_narrow_register(phy: IrTypePhysics) -> bool {
    let is_int = phy.reg_class == reg_class_gpr_signed() || phy.reg_class == reg_class_gpr_unsigned();
    if is_int { return phy.bit_width > 1 && phy.bit_width < 64; }
    return phy.reg_class == reg_class_simd_float() && phy.bit_width == 32;
}

/// An arithmetic operator on the instruction's two operands. The engine
/// computes integers in 64 bits and floats as f64, so a result in a narrower
/// register is wrapped or rounded to it, and a shift count in a narrow
/// integer register is taken modulo the register's width.
fn run_arith(fr: IrFrame, inst: IrInst, symbol: str, is_shift: bool) {
    let phy = inst.physics;
    if !is_narrow_register(phy) {
        run_binary(fr, inst, symbol);
        return;
    }
    var args = binary(fr, inst);
    if is_shift && phy.reg_class != reg_class_simd_float() {
        let width: i64 = phy.bit_width;
        args = [args[0], checked(fr, "&", [args[1], width - 1])];
    }
    let v = checked(fr, symbol, args);
    let bits: i64 = phy.bit_width;
    put(fr, inst, checked(fr, "num_wrap", [v, reg_class_name(phy.reg_class), bits]));
}

fn run_add(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "+", false); }
fn run_sub(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "-", false); }
fn run_mul(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "*", false); }
fn run_div(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "/", false); }
fn run_rem(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "%", false); }
fn run_bit_and(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "&", false); }
fn run_bit_or(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "|", false); }
fn run_bit_xor(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "^", false); }
fn run_shl(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, "<<", true); }
fn run_shr(fr: IrFrame, inst: IrInst) { run_arith(fr, inst, ">>", true); }

/// The operator of each comparison predicate (`CmpPred` 0..5).
fn cmp_symbols() -> List<str> => ["==", "!=", "<", "<=", ">", ">="];

fn run_cmp(fr: IrFrame, inst: IrInst) { run_binary(fr, inst, cmp_symbols()[inst.subop]); }

fn run_stack_slot(fr: IrFrame, inst: IrInst) {
    fr.cells.push(none);
    put(fr, inst, fr.cells.len - 1);
}

fn run_global_addr(fr: IrFrame, inst: IrInst) { put(fr, inst, -1 - inst.subop); }

fn run_load(fr: IrFrame, inst: IrInst) {
    let addr = fr.vals[ir_args(fr.f, inst)[0]];
    if addr >= 0 {
        put(fr, inst, fr.cells[addr]);
        return;
    }
    let g = -1 - addr;
    if !fr.assigned[g] {
        raise_fault(fr.fault, f"`{fr.m.globals[g].name}` is read before its declaration has run");
        return;
    }
    put(fr, inst, fr.globals[g]);
}

fn run_store(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    let addr = fr.vals[a[0]];
    if addr < 0 && fr.budget.eval {
        raise_fault(fr.fault, "a global is changed");
        return;
    }
    if addr < 0 {
        fr.globals[-1 - addr] = fr.vals[a[1]];
        fr.assigned[-1 - addr] = true;
    } else {
        fr.cells[addr] = fr.vals[a[1]];
    }
}

fn run_call_direct(fr: IrFrame, inst: IrInst) {
    put(fr, inst, interp_call(fr, inst.subop, arg_values(fr, inst)));
}

/// `call_indirect f, args..`: the function record `f` names, called with
/// `args` then the record's captured values (selfhost/ir/lower_closure.pilot).
fn run_call_indirect(fr: IrFrame, inst: IrInst) {
    if fr.budget.eval {
        raise_fault(fr.fault, "a function value is called");
        return;
    }
    let a = arg_values(fr, inst);
    let rec: List<any> = a[0];
    var args: List<any> = [];
    var i = 1;
    while i < a.len() { args.push(a[i]); i = i + 1; }
    i = 1;
    while i < rec.len() { args.push(rec[i]); i = i + 1; }
    put(fr, inst, interp_call(fr, rec[0], args));
}

fn run_call_intrinsic(fr: IrFrame, inst: IrInst) {
    let name = fr.m.intrinsics[inst.subop];
    if fr.budget.eval && !fr.budget.allowed.has(name) {
        raise_fault(fr.fault, f"the engine operation `{name}` is not run while compiling");
        return;
    }
    if name == program_args_op() {
        var copy: List<any> = [];
        for a in fr.args { copy.push(a); }
        put(fr, inst, copy);
        return;
    }
    if !fr.engine_ops.has(name) {
        put(fr, inst, seam("ir.interp_hook", f"the IR interpreter does not run the engine operation `{name}`"));
        return;
    }
    put(fr, inst, checked(fr, fr.engine_ops.get(name), arg_values(fr, inst)));
}

/// An aggregate is a record of its field values. Records are shared, not
/// copied, when a value is passed on. A struct (a layout with a record
/// entry) is held as the seed holds one, a map from field name to value
/// tagged with its layout (`record_set_type`), so it prints as
/// `{ name: value, .. }` wherever it goes; any other aggregate (a tuple, a
/// closure) is a list of its values.
[StandIn("ir.aggregate_by_reference", "a 0b00 value is copied when it is bound or passed (memcpy)", "the IR interpreter shares one record between every copy, as the seed does", "F5")]
fn run_construct_aggregate(fr: IrFrame, inst: IrInst) {
    let vals = arg_values(fr, inst);
    let layout = inst.physics.layout_id;
    if some rec = ir_record_of(fr.m, layout) {
        if rec.names.len() == vals.len() {
            var named = Map<str, any>();
            var i = 0;
            while i < vals.len() {
                named.set(rec.names[i], vals[i]);
                i = i + 1;
            }
            put(fr, inst, checked(fr, "record_set_type", [named, layout as i64]));
            return;
        }
    }
    put(fr, inst, vals);
}

/// The name of field `slot` of `v` when `v` is a struct record, else "".
fn field_name(fr: IrFrame, v: any, slot: i64) -> str {
    let layout = checked(fr, "record_type", [v]) ?? -1;
    if layout < 0 { return ""; }
    if some rec = ir_record_of(fr.m, layout as u32) {
        if slot < rec.names.len() { return rec.names[slot]; }
    }
    return "";
}

fn run_extract_field(fr: IrFrame, inst: IrInst) {
    let v = fr.vals[ir_args(fr.f, inst)[0]];
    let name = field_name(fr, v, inst.subop as i64);
    if name != "" {
        let rec: Map<str, any> = v;
        put(fr, inst, rec.get(name));
        return;
    }
    let rec: List<any> = v;
    put(fr, inst, rec[inst.subop]);
}

fn run_insert_field(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    let v = fr.vals[a[0]];
    let name = field_name(fr, v, inst.subop as i64);
    if name != "" {
        let rec: Map<str, any> = v;
        rec.set(name, fr.vals[a[1]]);
        return;
    }
    let rec: List<any> = v;
    rec[inst.subop] = fr.vals[a[1]];
}

/// A register value converted to the physics of the instruction: a 1-bit
/// register holds a boolean, a 64-bit unsigned register an unsigned value.
/// `cast`: the value converted to the result's register physics, as the
/// seed converts `T(x)`: floats truncate toward zero, integers wrap to the
/// width, a 1-bit value is a boolean, a 32-bit float rounds to binary32.
fn run_cast(fr: IrFrame, inst: IrInst) {
    let v = fr.vals[ir_args(fr.f, inst)[0]];
    let phy = inst.physics;
    put(fr, inst, checked(fr, "num_convert", [v, reg_class_name(phy.reg_class), phy.bit_width]));
}

fn run_jump(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    var args: List<any> = [];
    var i = 1;
    while i < a.len() {
        args.push(fr.vals[a[i]]);
        i = i + 1;
    }
    fr.next = a[0];
    fr.next_args = args;
}

fn run_cond_br(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    let taken = checked(fr, "if", [fr.vals[a[0]]]) == true;
    if fr.fault.active { return; }
    let at = if taken { 1 } else { 3 + a[2] };
    var args: List<any> = [];
    var i = 0;
    while i < a[at + 1] {
        args.push(fr.vals[a[at + 2 + i]]);
        i = i + 1;
    }
    fr.next = a[at];
    fr.next_args = args;
}

/// `switch_table index, default, targets..`: goes to target `index`, or to
/// the default when there is none.
fn run_switch_table(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    let i = fr.vals[a[0]];
    fr.next = if i >= 0 && i + 2 < a.len() { a[2 + i] } else { a[1] };
    fr.next_args = [];
}

/// `unreachable [message]`: stops the program with `message`.
fn run_unreachable(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    raise_fault(fr.fault, if a.len() > 0 { fr.vals[a[0]] } else { "entered code the program cannot reach" });
}

fn run_return(fr: IrFrame, inst: IrInst) {
    let a = ir_args(fr.f, inst);
    fr.ret = if a.len() > 0 { fr.vals[a[0]] } else { none };
    fr.next = -1;
}

/// Opcode -> its handler.
pub fn interp_handlers() -> List<any> {
    var hs: List<any> = [];
    var i = 0;
    while i < opcode_names().len() {
        hs.push(none);
        i = i + 1;
    }
    hs[op_const_bits()] = run_const_bits;
    hs[op_const_bytes()] = run_const_bytes;
    hs[op_const_float()] = run_const_float;
    hs[op_undef()] = run_undef;
    hs[op_add()] = run_add;
    hs[op_sub()] = run_sub;
    hs[op_mul()] = run_mul;
    hs[op_div()] = run_div;
    hs[op_rem()] = run_rem;
    hs[op_bit_and()] = run_bit_and;
    hs[op_bit_or()] = run_bit_or;
    hs[op_bit_xor()] = run_bit_xor;
    hs[op_shl()] = run_shl;
    hs[op_shr()] = run_shr;
    hs[op_cmp()] = run_cmp;
    hs[op_cast()] = run_cast;
    hs[op_construct_aggregate()] = run_construct_aggregate;
    hs[op_extract_field()] = run_extract_field;
    hs[op_insert_field()] = run_insert_field;
    hs[op_stack_slot()] = run_stack_slot;
    hs[op_global_addr()] = run_global_addr;
    hs[op_load()] = run_load;
    hs[op_store()] = run_store;
    hs[op_call_direct()] = run_call_direct;
    hs[op_call_indirect()] = run_call_indirect;
    hs[op_call_intrinsic()] = run_call_intrinsic;
    hs[op_jump()] = run_jump;
    hs[op_cond_br()] = run_cond_br;
    hs[op_switch_table()] = run_switch_table;
    hs[op_return()] = run_return;
    hs[op_unreachable()] = run_unreachable;
    return hs;
}

/// Engine operation the lowering calls -> the seed engine operation that
/// runs it. The IR interpreter runs on the seed, so each is the seed's own
/// operation on the seed's own values; indexing reads and writes are the
/// seed's record and list access, and `num_pow` is its `**` operator.
pub fn interp_engine_ops() -> Map<str, str> {
    let ops = Map<str, str>();
    for name in [
        "rt_print", "rt_eprint", "rt_fault", "stdin_read_line", "stdin_read_all",
        "list_new", "list_push", "list_extend", "list_pop", "list_remove_at", "is_null",
        "str_len", "str_slice", "str_find", "str_contains", "str_starts_with", "str_ends_with",
        "str_trim", "str_replace", "str_byte_at", "str_from_bytes", "map_values", "to_str",
        "map_new", "map_get", "map_set", "map_has", "map_remove", "seam_open", "value_clone",
        "scalar_from",
    ] {
        ops.set(name, name);
    }
    ops.set("list_get", "map_get");
    ops.set("list_set", "map_set");
    ops.set("num_pow", "**");
    return ops;
}
