// ==============================================================================
// FILE: selfhost/ir/interp.pilot
// F5: the PilIR interpreter.
// ==============================================================================
// Runs an `IrModule` so the IR is executable before a native backend exists.
// A function is prepared when it is first called and a block when it first
// runs (`IrCode`, `IrSteps`): each instruction's handler and operands are
// looked up once, not on every run, and a constant is placed in the values a
// call starts from instead of being run.
// Values are the interpreter's own values; how an instruction treats them
// follows its physics: a 1-bit register constant is a boolean, a 64-bit
// unsigned register constant is unsigned. Each opcode is run by the handler
// registered for it in `interp_handlers()`; an opcode with none stops at the
// seam `ir.interp_opcode`. Engine operations (`call_intrinsic`) are the
// seed's own, run under the names registered in `interp_engine_ops()`; one
// with none stops at the seam `ir.interp_hook`. Operators, branch
// conditions, engine operations and global reads that fail stop the program
// with the seed's runtime error (selfhost/ir/fault.pilot).
pub lvl(0) pkg Pilot.SelfHost.Ir.Interp;

use selfhost.ir.model.*;
use selfhost.ir.fault.*;

/// One instruction prepared for running: what a run needs of it, looked up
/// once, when its block first runs.
pub struct IrStep : IObject {
    /// Its handler (`interp_handlers()`, or the one its preparer chose), or
    /// none.
    pub h: any;
    pub inst: IrInst;
    /// Its operands, as `ir_args` gives them.
    pub a: List<i64>;
    /// Where its value goes: its result's id, or the spare slot after the
    /// function's last value when it has no result.
    pub result: i64;
    /// What its preparer (`interp_preparers()`) worked out: a name (an
    /// operator, an engine operation, a register class) and a value.
    pub sym: str;
    pub k: any;
}

/// A block prepared for running.
pub struct IrSteps : IObject {
    pub params: List<i64>;
    /// How many parameters it has.
    pub arity: i64;
    /// Its instructions in order, without those whose value `IrCode.start`
    /// holds.
    pub steps: List<IrStep>;
    /// How many steps it has.
    pub count: i64;
    /// How many instructions the block has (what a run of it costs).
    pub cost: i64;
}

/// A function prepared for running.
pub struct IrCode : IObject {
    /// Value id -> the value a call starts with: the constant its one
    /// defining instruction gives, else none. One spare slot follows.
    pub start: List<any>;
    /// Value id -> whether `start` holds its constant.
    pub placed: List<bool>;
    /// Block -> its `IrSteps`, or none until it first runs.
    pub blocks: List<any>;
}

/// One activation of a function.
pub struct IrFrame : IObject {
    pub m: IrModule;
    pub f: IrFunction;
    /// Value id -> its value.
    pub vals: List<any>;
    /// Stack slot cells; a `stack_slot` value is an index into this list.
    pub cells: List<any>;
    /// The module's globals, shared by every frame; a `global_addr` value
    /// is `-1 - g`, so it never collides with a stack slot index.
    pub globals: List<any>;
    /// Whether each global's declaration has run (stored it), shared.
    pub assigned: List<bool>;
    /// Where control goes after a terminator: the block, or -1 to return.
    pub next: i64;
    /// Arguments for the next block's parameters.
    pub next_args: List<any>;
    pub ret: any;
    pub handlers: List<any>;
    pub preparers: List<any>;
    pub constants: List<any>;
    /// Function -> its `IrCode`, or none until it is first called; shared.
    pub code: List<any>;
    pub engine_ops: Map<str, str>;
    /// The program's runtime error, shared by every frame.
    pub fault: IrFault;
    /// The program's script arguments.
    pub args: List<str>;
    /// The steps left, shared by every frame (see `IrBudget`).
    pub budget: IrBudget;
}

/// How far a run may go. `pilot ir run` runs without a limit; evaluating a
/// function while compiling (`ir_eval`) stops after `left` instructions or
/// `max_eval_depth()` nested calls, and stops at anything with an effect: an
/// engine operation outside `eval_engine_ops()`, a store to a global, a
/// call through a function value. A stop is a fault, never a hang.
pub struct IrBudget : IObject {
    /// Instructions left to run; -1 for no limit.
    pub left: i64;
    /// Calls currently open.
    pub depth: i64;
    /// Whether this is an evaluation while compiling.
    pub eval: bool;
    /// The engine operations it may run (`eval_engine_ops()`), when `eval`.
    pub allowed: Map<str, bool>;
}

/// The deepest an evaluation while compiling may nest calls.
pub pure fn max_eval_depth() -> i64 => 200;

/// The engine operations an evaluation while compiling may run: those that
/// only compute (building, reading and changing values it made itself).
/// Printing, reading input, the program's arguments and seams are not.
pub fn eval_engine_ops() -> Map<str, bool> {
    let ops = Map<str, bool>();
    for name in [
        "rt_fault", "list_new", "list_push", "list_extend", "list_pop", "list_remove_at", "is_null",
        "str_len", "str_slice", "str_find", "str_contains", "str_starts_with", "str_ends_with",
        "str_trim", "str_replace", "str_byte_at", "str_from_bytes", "map_values", "map_keys", "to_str",
        "map_new", "map_get", "map_set", "map_has", "map_remove", "value_clone", "list_get", "list_set",
        "num_pow",
    ] {
        ops.set(name, true);
    }
    return ops;
}

/// Runs function `fi` of `m` (which takes nothing) while compiling, with the
/// globals `globals` (those `assigned` marks as set) and at most `fuel`
/// instructions. Gives `[true, value, steps]`, or `[false, why, steps]`
/// when it stopped: a runtime error, an effect, or the budget running out.
/// `steps` is how many instructions it ran.
pub fn ir_eval(m: IrModule, fi: i64, globals: List<any>, assigned: List<bool>, fuel: i64) -> List<any> {
    let top = IrFrame { m: m, f: m.functions[fi], vals: [], cells: [], globals: globals, assigned: assigned, next: 0, next_args: [], ret: none, handlers: interp_handlers(), preparers: interp_preparers(), constants: interp_constants(), code: no_code(m), engine_ops: interp_engine_ops(), fault: ir_fault_new(), args: [], budget: IrBudget { left: fuel, depth: 0, eval: true, allowed: eval_engine_ops() } };
    let out = interp_call(top, fi, []);
    let steps = if top.budget.left < 0 { fuel } else { fuel - top.budget.left };
    if top.fault.active { return [false, top.fault.message, steps]; }
    return [true, out, steps];
}

/// The engine operation that gives the program its script arguments; the
/// interpreter answers it with the arguments of the program it runs, not
/// those of the tool it runs in.
pub pure fn program_args_op() -> str => "proc_args";

/// Runs function 0 (the lowering's start function, or `main` in hand-written
/// IR) and returns the exit code `pilot run` would: on a runtime error, 1
/// after reporting it with the places in `sources`. `args` are the program's
/// script arguments.
pub fn ir_run(m: IrModule, sources: IrSourceMap, args: List<str>) -> i64 {
    var globals: List<any> = [];
    var assigned: List<bool> = [];
    for g in m.globals {
        globals.push(none);
        assigned.push(false);
    }
    let top = IrFrame { m: m, f: m.functions[0], vals: [], cells: [], globals: globals, assigned: assigned, next: 0, next_args: [], ret: none, handlers: interp_handlers(), preparers: interp_preparers(), constants: interp_constants(), code: no_code(m), engine_ops: interp_engine_ops(), fault: ir_fault_new(), args: args, budget: IrBudget { left: -1, depth: 0, eval: false, allowed: Map<str, bool>() } };
    let out = interp_call(top, 0, []);
    if top.fault.active {
        report_fault(top.fault, sources);
        return 1;
    }
    // `main` without a value exits 0, as on the seed.
    return if out == none { 0 } else { out };
}

/// A code table for `m` with no function prepared yet.
fn no_code(m: IrModule) -> List<any> {
    var out: List<any> = [];
    for f in m.functions { out.push(none); }
    return out;
}

/// Calls function `fi` with `args` from frame `caller`.
fn interp_call(caller: IrFrame, fi: i64, args: List<any>) -> any {
    let budget = caller.budget;
    if !budget.eval { return interp_body(caller, fi, args); }
    if budget.depth >= max_eval_depth() {
        raise_fault(caller.fault, "calls nest too deeply to compute while compiling");
        return none;
    }
    budget.depth = budget.depth + 1;
    let out = interp_body(caller, fi, args);
    budget.depth = budget.depth - 1;
    return out;
}

/// The handler or preparer of `opcode` in `table`, or none.
fn table_entry(table: List<any>, opcode: u16) -> any => if opcode < table.len { table[opcode] } else { none };

/// The operands of `inst`, as `ir_args` gives them.
fn operands(f: IrFunction, inst: IrInst) -> List<i64> {
    var out: List<i64> = [];
    for a in ir_args(f, inst) { out.push(a as i64); }
    return out;
}

/// Function `fi` prepared for running; prepared on its first call.
/// A value defined by exactly one instruction, whose opcode has an entry in
/// `interp_constants()`, is the same on every run of that instruction, so
/// it is placed in the values every call starts from and the instruction is
/// left out of its block's steps.
fn prepared(fr: IrFrame, fi: i64) -> IrCode {
    let have = fr.code[fi];
    if have != none { return have; }
    let m = fr.m;
    let f = m.functions[fi];
    let no_value = ir_no_value();
    let constants = fr.constants;
    // Value id -> how many instructions and block parameters define it.
    var defs: List<i64> = [];
    var start: List<any> = [];
    var placed: List<bool> = [];
    for phy in f.value_physics {
        defs.push(0);
        start.push(none);
        placed.push(false);
    }
    // The spare slot an instruction without a result writes to.
    start.push(none);
    var blocks: List<any> = [];
    var found: List<IrInst> = [];
    for b in f.blocks {
        blocks.push(none);
        for p in b.params { defs[p] = defs[p] + 1; }
        for inst in b.insts {
            if inst.result != no_value {
                defs[inst.result] = defs[inst.result] + 1;
                if table_entry(constants, inst.opcode) != none { found.push(inst); }
            }
        }
    }
    for inst in found {
        if defs[inst.result] == 1 {
            let value_of = constants[inst.opcode];
            start[inst.result] = value_of(m, f, inst);
            placed[inst.result] = true;
        }
    }
    let code = IrCode { start: start, placed: placed, blocks: blocks };
    fr.code[fi] = code;
    return code;
}

/// Block `b` of the function of `fr` prepared for running.
fn prepare_block(fr: IrFrame, code: IrCode, b: IrBlock) -> IrSteps {
    let f = fr.f;
    let no_value = ir_no_value();
    let spare = code.placed.len() as i64;
    var params: List<i64> = [];
    for p in b.params { params.push(p as i64); }
    var steps: List<IrStep> = [];
    for inst in b.insts {
        let has_result = inst.result != no_value;
        if !(has_result && code.placed[inst.result]) {
            let st = IrStep { h: table_entry(fr.handlers, inst.opcode), inst: inst, a: operands(f, inst), result: if has_result { inst.result as i64 } else { spare }, sym: "", k: none };
            let prepare = table_entry(fr.preparers, inst.opcode);
            if prepare != none { prepare(fr, st); }
            steps.push(st);
        }
    }
    return IrSteps { params: params, arity: params.len() as i64, steps: steps, count: steps.len() as i64, cost: b.insts.len };
}

fn interp_body(caller: IrFrame, fi: i64, args: List<any>) -> any {
    let m = caller.m;
    let f = m.functions[fi];
    let code = prepared(caller, fi);
    let vals: List<any> = fresh_copy(code.start);
    let fr = IrFrame { m: m, f: f, vals: vals, cells: [], globals: caller.globals, assigned: caller.assigned, next: 0, next_args: args, ret: none, handlers: caller.handlers, preparers: caller.preparers, constants: caller.constants, engine_ops: caller.engine_ops, fault: caller.fault, args: caller.args, budget: caller.budget, code: caller.code };
    let budget = fr.budget;
    let fault = fr.fault;
    let blocks = code.blocks;
    while fr.next >= 0 {
        let at = fr.next;
        if blocks[at] == none { blocks[at] = prepare_block(fr, code, f.blocks[at]); }
        let b: IrSteps = blocks[at];
        if budget.left >= 0 {
            budget.left = budget.left - b.cost;
            if budget.left < 0 {
                raise_fault(fault, "it takes too long to compute while compiling");
                return none;
            }
        }
        let arity = b.arity;
        if arity > 0 {
            let params = b.params;
            let passed = fr.next_args;
            var p = 0;
            while p < arity {
                vals[params[p]] = passed[p];
                p = p + 1;
            }
        }
        fr.next = -1;
        let steps = b.steps;
        let count = b.count;
        var i = 0;
        while i < count {
            let st = steps[i];
            let h = st.h;
            if h == none {
                let inst = st.inst;
                if budget.eval {
                    raise_fault(fault, f"`{opcode_name(inst.opcode)}` is not computed while compiling");
                    return none;
                }
                return seam("ir.interp_opcode", f"the IR interpreter has no handler for `{opcode_name(inst.opcode)}`");
            }
            h(fr, st);
            if fault.active {
                // Unwinding: the failing instruction's place, then each call's.
                fault.spans.push(f.spans[st.inst.span_id]);
                return none;
            }
            i = i + 1;
        }
    }
    return fr.ret;
}

/// Engine operation `name` on `args` as the seed runs it; on failure the
/// program stops with the seed's message.
fn checked(fr: IrFrame, name: str, args: List<any>) -> any {
    let r = op_checked(name, args);
    if r[0] == true { return r[1]; }
    raise_fault(fr.fault, r[1]);
    return none;
}

/// The values of `ids` in `vals`.
fn values_of(vals: List<any>, ids: List<i64>) -> List<any> {
    var out: List<any> = [];
    for a in ids { out.push(vals[a]); }
    return out;
}

/// A constant integer as a value of physics `phy`.
fn bits_value(phy: IrTypePhysics, v: i64) -> any {
    if phy.bit_width == 1 { return v != 0; }
    if phy.reg_class == reg_class_gpr_unsigned() && phy.bit_width >= 64 { return v as u64; }
    return v;
}

fn bits_constant(m: IrModule, f: IrFunction, inst: IrInst) -> any => bits_value(inst.physics, m.ints[ir_args(f, inst)[0]]);

/// The binary64 value whose bits are `bits`: sign, 11-bit exponent and
/// 52-bit fraction (IEEE 754-2019 section 3.4). Scaling by powers of two is
/// exact, so the result is the value itself.
pub fn f64_from_bits(bits: i64) -> f64 {
    let neg = bits < 0;
    let exp = (bits >> 52) & 2047;
    let frac = bits & 4503599627370495;
    if exp == 2047 {
        if frac != 0 { return 0.0 / 0.0; }
        return if neg { -1.0 / 0.0 } else { 1.0 / 0.0 };
    }
    // Normal: (2^52 + frac) * 2^(exp - 1075); subnormal: frac * 2^-1074.
    var mant = (if exp == 0 { frac } else { frac + 4503599627370496 }) as f64;
    var e = if exp == 0 { -1074 } else { exp - 1075 };
    while e > 0 {
        mant = mant * 2.0;
        e = e - 1;
    }
    while e < 0 {
        mant = mant * 0.5;
        e = e + 1;
    }
    return if neg { -mant } else { mant };
}

fn float_constant(m: IrModule, f: IrFunction, inst: IrInst) -> any => f64_from_bits(m.floats[ir_args(f, inst)[0]]);

fn bytes_constant(m: IrModule, f: IrFunction, inst: IrInst) -> any => m.strings[ir_args(f, inst)[0]];

fn undef_constant(m: IrModule, f: IrFunction, inst: IrInst) -> any => none;

fn global_addr_constant(m: IrModule, f: IrFunction, inst: IrInst) -> any => -1 - inst.subop;

/// Opcode -> the value its instruction gives, for the opcodes whose
/// instruction gives the same value on every run.
pub fn interp_constants() -> List<any> {
    var cs: List<any> = [];
    var i = 0;
    while i < opcode_names().len() {
        cs.push(none);
        i = i + 1;
    }
    cs[op_const_bits()] = bits_constant;
    cs[op_const_float()] = float_constant;
    cs[op_const_bytes()] = bytes_constant;
    cs[op_undef()] = undef_constant;
    cs[op_global_addr()] = global_addr_constant;
    return cs;
}

/// A constant whose value is not placed (its result is defined more than
/// once, or it has none): the step holds its value.
fn prepare_constant(fr: IrFrame, st: IrStep) {
    let value_of = fr.constants[st.inst.opcode];
    st.k = value_of(fr.m, fr.f, st.inst);
}

fn run_constant(fr: IrFrame, st: IrStep) { fr.vals[st.result] = st.k; }

/// A binary operator (`st.sym`) on the instruction's two operands, as the
/// seed's.
fn run_binary(fr: IrFrame, st: IrStep) {
    let a = st.a;
    let vals = fr.vals;
    let r = op_checked(st.sym, [vals[a[0]], vals[a[1]]]);
    if r[0] == true {
        vals[st.result] = r[1];
    } else {
        raise_fault(fr.fault, r[1]);
    }
}

/// Whether a register is narrower than the engine's own numbers: an integer
/// register of 2 to 63 bits, or a 32-bit float register.
fn is_narrow_register(phy: IrTypePhysics) -> bool {
    let is_int = phy.reg_class == reg_class_gpr_signed() || phy.reg_class == reg_class_gpr_unsigned();
    if is_int { return phy.bit_width > 1 && phy.bit_width < 64; }
    return phy.reg_class == reg_class_simd_float() && phy.bit_width == 32;
}

/// The operator of each arithmetic opcode.
fn arith_symbols() -> Map<i64, str> {
    let syms = Map<i64, str>();
    syms.set(op_add() as i64, "+");
    syms.set(op_sub() as i64, "-");
    syms.set(op_mul() as i64, "*");
    syms.set(op_div() as i64, "/");
    syms.set(op_rem() as i64, "%");
    syms.set(op_bit_and() as i64, "&");
    syms.set(op_bit_or() as i64, "|");
    syms.set(op_bit_xor() as i64, "^");
    syms.set(op_shl() as i64, "<<");
    syms.set(op_shr() as i64, ">>");
    return syms;
}

/// An arithmetic operator. The engine computes integers in 64 bits and
/// floats as f64, so a result in a narrower register is wrapped or rounded
/// to it (`run_narrow`); any other is the seed's operator (`run_binary`).
fn prepare_arith(fr: IrFrame, st: IrStep) {
    let op = st.inst.opcode;
    st.sym = arith_symbols().get(op as i64);
    let phy = st.inst.physics;
    if !is_narrow_register(phy) { return; }
    let is_shift = op == op_shl() || op == op_shr();
    let bits: i64 = phy.bit_width;
    // [register class, width, whether the count is taken modulo the width]
    st.k = [reg_class_name(phy.reg_class), bits, is_shift && phy.reg_class != reg_class_simd_float()];
    st.h = run_narrow;
}

/// An arithmetic operator whose result is in a narrow register: wrapped or
/// rounded to it, and a shift count in a narrow integer register is taken
/// modulo the register's width.
fn run_narrow(fr: IrFrame, st: IrStep) {
    let a = st.a;
    let vals = fr.vals;
    let k: List<any> = st.k;
    var args: List<any> = [vals[a[0]], vals[a[1]]];
    if k[2] == true {
        let width: i64 = k[1];
        args = [args[0], checked(fr, "&", [args[1], width - 1])];
    }
    let v = checked(fr, st.sym, args);
    vals[st.result] = checked(fr, "num_wrap", [v, k[0], k[1]]);
}

/// The operator of each comparison predicate (`CmpPred` 0..5).
fn cmp_symbols() -> List<str> => ["==", "!=", "<", "<=", ">", ">="];

fn prepare_cmp(fr: IrFrame, st: IrStep) { st.sym = cmp_symbols()[st.inst.subop]; }

fn run_stack_slot(fr: IrFrame, st: IrStep) {
    let cells = fr.cells;
    cells.push(none);
    fr.vals[st.result] = cells.len - 1;
}

fn run_load(fr: IrFrame, st: IrStep) {
    let vals = fr.vals;
    let addr = vals[st.a[0]];
    if addr >= 0 {
        vals[st.result] = fr.cells[addr];
        return;
    }
    let g = -1 - addr;
    if !fr.assigned[g] {
        raise_fault(fr.fault, f"`{fr.m.globals[g].name}` is read before its declaration has run");
        return;
    }
    vals[st.result] = fr.globals[g];
}

fn run_store(fr: IrFrame, st: IrStep) {
    let a = st.a;
    let vals = fr.vals;
    let addr = vals[a[0]];
    if addr >= 0 {
        fr.cells[addr] = vals[a[1]];
        return;
    }
    if fr.budget.eval {
        raise_fault(fr.fault, "a global is changed");
        return;
    }
    fr.globals[-1 - addr] = vals[a[1]];
    fr.assigned[-1 - addr] = true;
}

fn run_call_direct(fr: IrFrame, st: IrStep) {
    let vals = fr.vals;
    vals[st.result] = interp_call(fr, st.inst.subop, values_of(vals, st.a));
}

/// `call_indirect f, args..`: the function record `f` names, called with
/// `args` then the record's captured values (selfhost/ir/lower_closure.pilot).
fn run_call_indirect(fr: IrFrame, st: IrStep) {
    if fr.budget.eval {
        raise_fault(fr.fault, "a function value is called");
        return;
    }
    let a = values_of(fr.vals, st.a);
    let rec: List<any> = a[0];
    var args: List<any> = [];
    var i = 1;
    while i < a.len() { args.push(a[i]); i = i + 1; }
    i = 1;
    while i < rec.len() { args.push(rec[i]); i = i + 1; }
    fr.vals[st.result] = interp_call(fr, rec[0], args);
}

/// An engine operation: what stops it is the same on every run, so it is
/// decided once (an evaluation while compiling runs only what it may; the
/// program's arguments are the interpreter's own; one with no entry in
/// `interp_engine_ops()` stops at its seam).
fn prepare_intrinsic(fr: IrFrame, st: IrStep) {
    let name = fr.m.intrinsics[st.inst.subop];
    st.sym = name;
    if fr.budget.eval && !fr.budget.allowed.has(name) {
        st.h = run_intrinsic_refused;
    } else if name == program_args_op() {
        st.h = run_program_args;
    } else if !fr.engine_ops.has(name) {
        st.h = run_intrinsic_seam;
    } else {
        st.sym = fr.engine_ops.get(name);
    }
}

fn run_intrinsic_refused(fr: IrFrame, st: IrStep) {
    raise_fault(fr.fault, f"the engine operation `{st.sym}` is not run while compiling");
}

fn run_program_args(fr: IrFrame, st: IrStep) {
    var copy: List<any> = [];
    for a in fr.args { copy.push(a); }
    fr.vals[st.result] = copy;
}

fn run_intrinsic_seam(fr: IrFrame, st: IrStep) {
    fr.vals[st.result] = seam("ir.interp_hook", f"the IR interpreter does not run the engine operation `{st.sym}`");
}

fn run_call_intrinsic(fr: IrFrame, st: IrStep) {
    let vals = fr.vals;
    let r = op_checked(st.sym, values_of(vals, st.a));
    if r[0] == true {
        vals[st.result] = r[1];
    } else {
        raise_fault(fr.fault, r[1]);
    }
}

/// An aggregate is a record of its field values. Records are shared, not
/// copied, when a value is passed on. A struct (a layout with a record
/// entry) is held as the seed holds one, a map from field name to value
/// tagged with its layout (`record_set_type`), so it prints as
/// `{ name: value, .. }` wherever it goes; any other aggregate (a tuple, a
/// closure) is a list of its values.
[StandIn("ir.aggregate_by_reference", "a 0b00 value is copied when it is bound or passed (memcpy)", "the IR interpreter shares one record between every copy, as the seed does", "F5")]
fn run_construct_aggregate(fr: IrFrame, st: IrStep) {
    let vals = values_of(fr.vals, st.a);
    let layout = st.inst.physics.layout_id;
    if some rec = ir_record_of(fr.m, layout) {
        if rec.names.len() == vals.len() {
            var named = Map<str, any>();
            var i = 0;
            while i < vals.len() {
                named.set(rec.names[i], vals[i]);
                i = i + 1;
            }
            fr.vals[st.result] = checked(fr, "record_set_type", [named, layout as i64]);
            return;
        }
    }
    fr.vals[st.result] = vals;
}

/// The name of field `slot` of `v` when `v` is a struct record, else "".
fn field_name(fr: IrFrame, v: any, slot: i64) -> str {
    let layout = checked(fr, "record_type", [v]) ?? -1;
    if layout < 0 { return ""; }
    if some rec = ir_record_of(fr.m, layout as u32) {
        if slot < rec.names.len() { return rec.names[slot]; }
    }
    return "";
}

fn run_extract_field(fr: IrFrame, st: IrStep) {
    let v = fr.vals[st.a[0]];
    let slot = st.inst.subop;
    let name = field_name(fr, v, slot as i64);
    if name != "" {
        let rec: Map<str, any> = v;
        fr.vals[st.result] = rec.get(name);
        return;
    }
    let rec: List<any> = v;
    fr.vals[st.result] = rec[slot];
}

fn run_insert_field(fr: IrFrame, st: IrStep) {
    let a = st.a;
    let v = fr.vals[a[0]];
    let slot = st.inst.subop;
    let name = field_name(fr, v, slot as i64);
    if name != "" {
        let rec: Map<str, any> = v;
        rec.set(name, fr.vals[a[1]]);
        return;
    }
    let rec: List<any> = v;
    rec[slot] = fr.vals[a[1]];
}

fn prepare_cast(fr: IrFrame, st: IrStep) {
    let phy = st.inst.physics;
    st.sym = reg_class_name(phy.reg_class);
    st.k = phy.bit_width;
}

/// `cast`: the value converted to the result's register physics, as the
/// seed converts `T(x)`: floats truncate toward zero, integers wrap to the
/// width, a 1-bit value is a boolean, a 32-bit float rounds to binary32.
fn run_cast(fr: IrFrame, st: IrStep) {
    let vals = fr.vals;
    vals[st.result] = checked(fr, "num_convert", [vals[st.a[0]], st.sym, st.k]);
}

/// The value ids `count` operands from `from` name, or none when there are
/// none (a branch that passes nothing).
fn passed_ids(a: List<i64>, from: i64, count: i64) -> any {
    if count == 0 { return none; }
    var out: List<i64> = [];
    var i = 0;
    while i < count {
        out.push(a[from + i]);
        i = i + 1;
    }
    return out;
}

/// `jump target, args..`: `st.k` is the ids of `args`.
fn prepare_jump(fr: IrFrame, st: IrStep) { st.k = passed_ids(st.a, 1, st.a.len() - 1); }

fn run_jump(fr: IrFrame, st: IrStep) {
    fr.next = st.a[0];
    let ids = st.k;
    if ids != none { fr.next_args = values_of(fr.vals, ids); }
}

/// `cond_br c, then, n, args.., else, n, args..`: `st.k` is
/// `[then, ids of its args, else, ids of its args]`.
fn prepare_cond_br(fr: IrFrame, st: IrStep) {
    let a = st.a;
    let other = 3 + a[2];
    st.k = [a[1], passed_ids(a, 3, a[2]), a[other], passed_ids(a, other + 2, a[other + 1])];
}

fn run_cond_br(fr: IrFrame, st: IrStep) {
    let vals = fr.vals;
    let c = vals[st.a[0]];
    var taken = c == true;
    // Anything but a boolean stops the program with the seed's message.
    if !taken && c != false {
        taken = checked(fr, "if", [c]) == true;
        if fr.fault.active { return; }
    }
    let k: List<any> = st.k;
    let at = if taken { 0 } else { 2 };
    fr.next = k[at];
    let ids = k[at + 1];
    if ids != none { fr.next_args = values_of(vals, ids); }
}

/// `switch_table index, default, targets..`: goes to target `index`, or to
/// the default when there is none.
fn run_switch_table(fr: IrFrame, st: IrStep) {
    let a = st.a;
    let i = fr.vals[a[0]];
    fr.next = if i >= 0 && i + 2 < a.len() { a[2 + i] } else { a[1] };
}

/// `unreachable [message]`: stops the program with `message`.
fn run_unreachable(fr: IrFrame, st: IrStep) {
    let a = st.a;
    raise_fault(fr.fault, if a.len() > 0 { fr.vals[a[0]] } else { "entered code the program cannot reach" });
}

fn run_return(fr: IrFrame, st: IrStep) {
    let a = st.a;
    fr.ret = if a.len() > 0 { fr.vals[a[0]] } else { none };
    fr.next = -1;
}

/// A table with no entry for any opcode.
fn opcode_table() -> List<any> {
    var t: List<any> = [];
    var i = 0;
    while i < opcode_names().len() {
        t.push(none);
        i = i + 1;
    }
    return t;
}

/// Opcode -> what prepares its step (sets `sym` and `k`, and may choose a
/// more exact handler), for the opcodes that need it.
pub fn interp_preparers() -> List<any> {
    var ps = opcode_table();
    for op in [op_const_bits(), op_const_bytes(), op_const_float(), op_undef(), op_global_addr()] { ps[op] = prepare_constant; }
    for op in [op_add(), op_sub(), op_mul(), op_div(), op_rem(), op_bit_and(), op_bit_or(), op_bit_xor(), op_shl(), op_shr()] { ps[op] = prepare_arith; }
    ps[op_cmp()] = prepare_cmp;
    ps[op_cast()] = prepare_cast;
    ps[op_call_intrinsic()] = prepare_intrinsic;
    ps[op_jump()] = prepare_jump;
    ps[op_cond_br()] = prepare_cond_br;
    return ps;
}

/// Opcode -> its handler.
pub fn interp_handlers() -> List<any> {
    var hs = opcode_table();
    for op in [op_const_bits(), op_const_bytes(), op_const_float(), op_undef(), op_global_addr()] { hs[op] = run_constant; }
    for op in [op_add(), op_sub(), op_mul(), op_div(), op_rem(), op_bit_and(), op_bit_or(), op_bit_xor(), op_shl(), op_shr(), op_cmp()] { hs[op] = run_binary; }
    hs[op_cast()] = run_cast;
    hs[op_construct_aggregate()] = run_construct_aggregate;
    hs[op_extract_field()] = run_extract_field;
    hs[op_insert_field()] = run_insert_field;
    hs[op_stack_slot()] = run_stack_slot;
    hs[op_load()] = run_load;
    hs[op_store()] = run_store;
    hs[op_call_direct()] = run_call_direct;
    hs[op_call_indirect()] = run_call_indirect;
    hs[op_call_intrinsic()] = run_call_intrinsic;
    hs[op_jump()] = run_jump;
    hs[op_cond_br()] = run_cond_br;
    hs[op_switch_table()] = run_switch_table;
    hs[op_return()] = run_return;
    hs[op_unreachable()] = run_unreachable;
    return hs;
}

/// Engine operation the lowering calls -> the seed engine operation that
/// runs it. The IR interpreter runs on the seed, so each is the seed's own
/// operation on the seed's own values; indexing reads and writes are the
/// seed's record and list access, and `num_pow` is its `**` operator.
pub fn interp_engine_ops() -> Map<str, str> {
    let ops = Map<str, str>();
    for name in [
        "rt_print", "rt_eprint", "rt_fault", "stdin_read_line", "stdin_read_all",
        "list_new", "list_push", "list_extend", "list_pop", "list_remove_at", "is_null",
        "str_len", "str_slice", "str_find", "str_contains", "str_starts_with", "str_ends_with",
        "str_trim", "str_replace", "str_byte_at", "str_from_bytes", "map_values", "map_keys", "to_str",
        "map_new", "map_get", "map_set", "map_has", "map_remove", "seam_open", "value_clone",
        "scalar_from",
    ] {
        ops.set(name, name);
    }
    ops.set("list_get", "map_get");
    ops.set("list_set", "map_set");
    ops.set("num_pow", "**");
    return ops;
}
