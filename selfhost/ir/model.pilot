// ==============================================================================
// FILE: selfhost/ir/model.pilot
// Milestone 6.1: First-Class Typed SSA Mid-Level IR (PilIR) Data Model
// Name-Blind Type Physics, Block Parameters, 34 Orthogonal Opcodes, Target Descriptors
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Ir.Model;

use Pilot.Core.Reflect;
use Pilot.Core.Pending;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// Name-Blind IR Register Classes (Derived strictly from [Bits] & [Layout])
// ------------------------------------------------------------------------------
pub enum RegClass : u8 {
    ::GprSigned   = 0,
    ::GprUnsigned = 1,
    ::SimdFloat   = 2,
    ::SimdVector  = 3,
    ::RawPtr      = 4,
    ::Aggregate   = 5,
    ::Unit        = 6,
    ::Noreturn    = 7,
}

pub pure fn reg_class_gpr_signed()   -> u8 => 0;
pub pure fn reg_class_gpr_unsigned() -> u8 => 1;
pub pure fn reg_class_simd_float()   -> u8 => 2;
pub pure fn reg_class_simd_vector()  -> u8 => 3;
pub pure fn reg_class_raw_ptr()      -> u8 => 4;
pub pure fn reg_class_aggregate()    -> u8 => 5;
pub pure fn reg_class_unit()         -> u8 => 6;
pub pure fn reg_class_noreturn()     -> u8 => 7;

pub fn reg_class_name(rc: u8) -> str {
    if rc == reg_class_gpr_signed()   { return "gpr_signed"; }
    if rc == reg_class_gpr_unsigned() { return "gpr_unsigned"; }
    if rc == reg_class_simd_float()   { return "simd_float"; }
    if rc == reg_class_simd_vector()  { return "simd_vector"; }
    if rc == reg_class_raw_ptr()      { return "raw_ptr"; }
    if rc == reg_class_aggregate()    { return "aggregate"; }
    if rc == reg_class_unit()         { return "unit"; }
    if rc == reg_class_noreturn()     { return "noreturn"; }
    return "unknown";
}

// ------------------------------------------------------------------------------
// 2-Bit Lattice Bits (Hardware Semantic Taxonomy)
// ------------------------------------------------------------------------------
pub enum LatticeBits : u8 {
    ::Value     = 0,
    ::Reference = 1,
    ::Object    = 2,
    ::Guard     = 3,
}

pub pure fn lattice_value()     -> u8 => 0; // 0b00: IValue (Trivial memcpy)
pub pure fn lattice_reference() -> u8 => 1; // 0b01: IReference (Borrowed view)
pub pure fn lattice_object()    -> u8 => 2; // 0b10: IObject (Owned ~self())
pub pure fn lattice_guard()     -> u8 => 3; // 0b11: IGuard (Scoped lease)

pub fn lattice_name(lb: u8) -> str {
    if lb == lattice_value()     { return "IValue"; }
    if lb == lattice_reference() { return "IReference"; }
    if lb == lattice_object()    { return "IObject"; }
    if lb == lattice_guard()     { return "IGuard"; }
    return "UnknownLattice";
}

// ------------------------------------------------------------------------------
// Name-Blind IrTypePhysics Value Type (12 Bytes C-ABI)
// ------------------------------------------------------------------------------
[Layout(c_abi)]
pub struct IrTypePhysics : IValue {
    pub layout_id:    u32;
    pub reg_class:    u8;
    pub bit_width:    u16;
    pub align_pow2:   u8;
    pub lattice_bits: u8;
}

pub pure fn ir_physics_new(layout_id: u32, reg_class: u8, bit_width: u16, align_pow2: u8, lattice_bits: u8) -> IrTypePhysics {
    return IrTypePhysics {
        layout_id:    layout_id,
        reg_class:    reg_class,
        bit_width:    bit_width,
        align_pow2:   align_pow2,
        lattice_bits: lattice_bits,
    };
}

[StandIn("ir.fixed_layout_ids", "layout ids handed out by the type registry from [Bits] and [Layout]", "each helper returns a fixed id (0-3) and fixed register facts", "F4")]
pub pure fn ir_physics_unit() -> IrTypePhysics {
    return IrTypePhysics {
        layout_id:    0,
        reg_class:    reg_class_unit(),
        bit_width:    0,
        align_pow2:   0,
        lattice_bits: lattice_value(),
    };
}

[StandIn("ir.fixed_layout_ids", "layout ids handed out by the type registry from [Bits] and [Layout]", "each helper returns a fixed id (0-3) and fixed register facts", "F4")]
pub pure fn ir_physics_i64() -> IrTypePhysics {
    return IrTypePhysics {
        layout_id:    1,
        reg_class:    reg_class_gpr_signed(),
        bit_width:    64,
        align_pow2:   3,
        lattice_bits: lattice_value(),
    };
}

[StandIn("ir.fixed_layout_ids", "layout ids handed out by the type registry from [Bits] and [Layout]", "each helper returns a fixed id (0-3) and fixed register facts", "F4")]
pub pure fn ir_physics_bool() -> IrTypePhysics {
    return IrTypePhysics {
        layout_id:    2,
        reg_class:    reg_class_gpr_unsigned(),
        bit_width:    1,
        align_pow2:   0,
        lattice_bits: lattice_value(),
    };
}

[StandIn("ir.fixed_layout_ids", "layout ids handed out by the type registry from [Bits] and [Layout]", "each helper returns a fixed id (0-3) and fixed register facts", "F4")]
pub pure fn ir_physics_ptr() -> IrTypePhysics {
    return IrTypePhysics {
        layout_id:    3,
        reg_class:    reg_class_raw_ptr(),
        bit_width:    64,
        align_pow2:   3,
        lattice_bits: lattice_value(),
    };
}

pub pure fn ir_physics_equals(a: IrTypePhysics, b: IrTypePhysics) -> bool {
    return a.layout_id == b.layout_id
        && a.reg_class == b.reg_class
        && a.bit_width == b.bit_width
        && a.align_pow2 == b.align_pow2
        && a.lattice_bits == b.lattice_bits;
}

// ------------------------------------------------------------------------------
// Comparison Predicates & Cast Kinds
// ------------------------------------------------------------------------------
pub enum CmpPred : u8 {
    Eq = 0,
    Ne = 1,
    Lt = 2,
    Le = 3,
    Gt = 4,
    Ge = 5,
}

pub fn cmp_pred_name(p: u16) -> str {
    if p == 0 { return "eq"; }
    if p == 1 { return "ne"; }
    if p == 2 { return "lt"; }
    if p == 3 { return "le"; }
    if p == 4 { return "gt"; }
    if p == 5 { return "ge"; }
    return "cmp_unknown";
}

pub enum CastKind : u8 {
    ZeroExtend      = 0,
    SignExtend      = 1,
    Truncate        = 2,
    FloatPromote    = 3,
    FloatDemote     = 4,
    IntToFloat      = 5,
    FloatToInt      = 6,
    Bitcast         = 7,
    ViewReinterpret = 8,
}

pub fn cast_kind_name(k: u16) -> str {
    if k == 0 { return "zext"; }
    if k == 1 { return "sext"; }
    if k == 2 { return "trunc"; }
    if k == 3 { return "fpromote"; }
    if k == 4 { return "fdemote"; }
    if k == 5 { return "itof"; }
    if k == 6 { return "ftoi"; }
    if k == 7 { return "bitcast"; }
    if k == 8 { return "view_reinterpret"; }
    return "cast_unknown";
}

// ------------------------------------------------------------------------------
// The 34 Orthogonal PilIR Opcodes across 6 Families
// ------------------------------------------------------------------------------

// Family 1: Constants & Aggregates (1..7)
pub pure fn op_const_bits()          -> u16 => 1;
pub pure fn op_const_float()         -> u16 => 2;
pub pure fn op_const_bytes()         -> u16 => 3;
pub pure fn op_undef()               -> u16 => 4;
pub pure fn op_construct_aggregate() -> u16 => 5;
pub pure fn op_extract_field()       -> u16 => 6;
pub pure fn op_insert_field()        -> u16 => 7;

// Family 2: Register Arithmetic & Bitwise (8..20)
pub pure fn op_add()          -> u16 => 8;
pub pure fn op_sub()          -> u16 => 9;
pub pure fn op_mul()          -> u16 => 10;
pub pure fn op_div()          -> u16 => 11;
pub pure fn op_rem()          -> u16 => 12;
pub pure fn op_bit_and()      -> u16 => 13;
pub pure fn op_bit_or()       -> u16 => 14;
pub pure fn op_bit_xor()      -> u16 => 15;
pub pure fn op_shl()          -> u16 => 16;
pub pure fn op_shr()          -> u16 => 17;
pub pure fn op_cmp()          -> u16 => 18;
pub pure fn op_cast()         -> u16 => 19;
pub pure fn op_simd_lane_op() -> u16 => 20;

// Family 3: Memory, Views & Arenas (21..26)
pub pure fn op_stack_slot()   -> u16 => 21;
pub pure fn op_arena_alloc()  -> u16 => 22;
pub pure fn op_load()         -> u16 => 23;
pub pure fn op_store()        -> u16 => 24;
pub pure fn op_ptr_offset()   -> u16 => 25;
pub pure fn op_make_view()    -> u16 => 26;

// Family 4: Explicit 2-Bit Lattice & Perceus Lifecycle (27..33)
pub pure fn op_perceus_dup()        -> u16 => 27;
pub pure fn op_perceus_drop()       -> u16 => 28;
pub pure fn op_perceus_drop_reuse() -> u16 => 29;
pub pure fn op_construct_reuse()    -> u16 => 30;
pub pure fn op_iso_freeze()         -> u16 => 31;
pub pure fn op_guard_enter()        -> u16 => 32;
pub pure fn op_guard_exit_lifo()    -> u16 => 33;

// Family 5: Calls & Homoiconic Projections (34..40)
pub pure fn op_call_direct()       -> u16 => 34;
pub pure fn op_call_indirect()     -> u16 => 35;
pub pure fn op_call_intrinsic()    -> u16 => 36;
pub pure fn op_pack_abi_frame()    -> u16 => 37;
pub pure fn op_init_signal()       -> u16 => 38;
pub pure fn op_diff_adjoint()      -> u16 => 39;
pub pure fn op_begin_effect_plan() -> u16 => 40;

// Family 6: Block Terminators (41..45)
pub pure fn op_jump()         -> u16 => 41;
pub pure fn op_cond_br()      -> u16 => 42;
pub pure fn op_switch_table() -> u16 => 43;
pub pure fn op_return()       -> u16 => 44;
pub pure fn op_unreachable()  -> u16 => 45;

/// Opcode -> its printed name; index 0 is unused.
pub fn opcode_names() -> List<str> => [
    "",
    "const_bits", "const_float", "const_bytes", "undef", "construct_aggregate", "extract_field", "insert_field",
    "add", "sub", "mul", "div", "rem", "bit_and", "bit_or", "bit_xor", "shl", "shr", "cmp", "cast", "simd_lane_op",
    "stack_slot", "arena_alloc", "load", "store", "ptr_offset", "make_view",
    "perceus_dup", "perceus_drop", "perceus_drop_reuse", "construct_reuse", "iso_freeze", "guard_enter", "guard_exit_lifo",
    "call_direct", "call_indirect", "call_intrinsic", "pack_abi_frame", "init_signal", "diff_adjoint", "begin_effect_plan",
    "jump", "cond_br", "switch_table", "return", "unreachable",
];

pub fn opcode_name(op: u16) -> str {
    let names = opcode_names();
    return if op > 0 && op < names.len { names[op] } else { "op_custom_" + op };
}

/// The opcode printed as `name`, or 0.
pub fn opcode_of(name: str) -> u16 {
    let names = opcode_names();
    var i = 1;
    while i < names.len {
        if names[i] == name { return i; }
        i = i + 1;
    }
    return 0;
}

pub pure fn opcode_is_terminator(op: u16) -> bool {
    return op >= op_jump() && op <= op_unreachable();
}

// ------------------------------------------------------------------------------
// Instructions, Blocks, Functions & Modules
// ------------------------------------------------------------------------------
// An instruction is 32 bytes under the C layout rules:
//   result u32 @0, opcode u16 @4, subop u16 @6, physics @8 (12 bytes:
//   layout_id u32, reg_class u8, 1 pad, bit_width u16, align_pow2 u8,
//   lattice_bits u8, 2 pad), args_offset u32 @20, args_len u32 @24,
//   span_id u32 @28.
// Operands live in the function's operand pool; the source span lives in the
// function's span table, so the instruction holds only its index (M6 put two
// span words in the instruction, which made it 38 bytes, not 32).

/// The result id of an instruction that produces no value.
pub pure fn ir_no_value() -> u32 => 4294967295;

[Layout(c_abi)]
pub struct IrInst : IValue {
    pub result:      u32;
    pub opcode:      u16;
    pub subop:       u16;
    pub physics:     IrTypePhysics;
    pub args_offset: u32;
    pub args_len:    u32;
    pub span_id:     u32;
}

/// A basic block. Values flow in through block parameters, never phi nodes;
/// a jump passes one argument per parameter.
pub struct IrBlock : IObject {
    pub id:     u32;
    /// Value ids of the block parameters.
    pub params: List<u32>;
    pub insts:  List<IrInst>;
    /// Ids of the blocks that jump here; filled by `ir_compute_preds`.
    pub preds:  List<u32>;
    /// Immediate dominator, or `ir_no_value()` for the entry block.
    pub idom:   u32;
}

/// A function: its blocks (the first is the entry, whose parameters are the
/// function's), its operands, and the physics of every value it defines.
pub struct IrFunction : IObject {
    pub name:          str;
    pub ret_physics:   IrTypePhysics;
    pub blocks:        List<IrBlock>;
    pub operand_pool:  List<u32>;
    /// Value id -> its physics.
    pub value_physics: List<IrTypePhysics>;
    /// Span id -> byte offset of the source the instruction came from.
    pub spans:         List<i64>;
}

/// A layout the module's values use, named for printing.
pub struct IrLayout : IValue {
    pub name:    str;
    pub physics: IrTypePhysics;
}

/// A lowered program. Constants are pooled: an instruction names a pool
/// entry by index.
pub struct IrModule : IObject {
    /// Layout id -> layout.
    pub layouts:    List<IrLayout>;
    pub functions:  List<IrFunction>;
    /// `const_bits` operands.
    pub ints:       List<i64>;
    /// `const_float` operands, as their IEEE 754 binary64 bits.
    pub floats:     List<i64>;
    /// `const_bytes` operands.
    pub strings:    List<str>;
    /// `call_intrinsic` subops: the engine operations the program calls.
    pub intrinsics: List<str>;
}

pub fn ir_module_new() -> IrModule {
    return IrModule { layouts: [], functions: [], ints: [], floats: [], strings: [], intrinsics: [] };
}

pub fn ir_function_new(name: str, ret: IrTypePhysics) -> IrFunction {
    return IrFunction { name: name, ret_physics: ret, blocks: [], operand_pool: [], value_physics: [], spans: [] };
}

/// Adds an empty block to `f` and returns its id.
pub fn ir_add_block(f: IrFunction) -> u32 {
    let id = f.blocks.len;
    f.blocks.push(IrBlock { id: id, params: [], insts: [], preds: [], idom: ir_no_value() });
    return id;
}

/// A new value of physics `phy` in `f`.
pub fn ir_new_value(f: IrFunction, phy: IrTypePhysics) -> u32 {
    f.value_physics.push(phy);
    return f.value_physics.len - 1;
}

/// Adds a parameter of physics `phy` to block `b` of `f`.
pub fn ir_add_param(f: IrFunction, b: u32, phy: IrTypePhysics) -> u32 {
    let v = ir_new_value(f, phy);
    f.blocks[b].params.push(v);
    return v;
}

/// Appends an instruction to block `b`; returns its result (a new value of
/// physics `phy`, or `ir_no_value()` when `produces` is false).
pub fn ir_emit(f: IrFunction, b: u32, op: u16, sub: u16, phy: IrTypePhysics, args: List<u32>, produces: bool, span: i64) -> u32 {
    let result = if produces { ir_new_value(f, phy) } else { ir_no_value() };
    let offset = f.operand_pool.len;
    for a in args { f.operand_pool.push(a); }
    f.spans.push(span);
    f.blocks[b].insts.push(ir_inst_new(result, op, sub, phy, offset, args.len, f.spans.len - 1));
    return result;
}

/// An instruction: its result (or `ir_no_value()`), opcode and sub-opcode,
/// physics, its operands' place in the function's operand pool, and the id
/// of its source span in the function's span table.
pub pure fn ir_inst_new(result: u32, op: u16, sub: u16, phy: IrTypePhysics, args_offset: u32, args_len: u32, span_id: u32) -> IrInst {
    return IrInst {
        result:      result,
        opcode:      op,
        subop:       sub,
        physics:     phy,
        args_offset: args_offset,
        args_len:    args_len,
        span_id:     span_id,
    };
}

/// The operands of `inst`.
pub fn ir_args(f: IrFunction, inst: IrInst) -> List<u32> {
    var out: List<u32> = [];
    var i: u32 = 0;
    while i < inst.args_len {
        out.push(f.operand_pool[inst.args_offset + i]);
        i = i + 1;
    }
    return out;
}

/// Whether block `b` ends in a terminator.
pub fn ir_is_terminated(f: IrFunction, b: u32) -> bool {
    let insts = f.blocks[b].insts;
    return insts.len > 0 && opcode_is_terminator(insts[insts.len - 1].opcode);
}

/// The blocks a terminator can go to. `jump` is `[target, args..]`;
/// `cond_br` is `[cond, then, n_then, then args.., else, n_else, else args..]`.
pub fn ir_successors(f: IrFunction, inst: IrInst) -> List<u32> {
    var out: List<u32> = [];
    let a = ir_args(f, inst);
    if inst.opcode == op_jump() {
        out.push(a[0]);
    } else if inst.opcode == op_cond_br() {
        out.push(a[1]);
        out.push(a[3 + a[2]]);
    }
    return out;
}

// ------------------------------------------------------------------------------
// Target Descriptor & Multiplatform ABI Physics (from Pilot.Core.Reflect)
// ------------------------------------------------------------------------------

[StandIn("ir.target_defaults", "target descriptor from --target and the compile driver", "backend llvm and little-endian on every target", "F3")]
pub fn target_descriptor_new(os: str, arch: str) -> TargetDescriptor {
    var p_bytes: usize = 8;
    if arch == "wasm32" || arch == "riscv32" {
        p_bytes = 4;
    }

    return TargetDescriptor {
        arch:             arch,
        os:               os,
        pointer_bytes:    p_bytes,
        endian:           "little",
        backend:          "llvm",
        simd_width_bits:  pending("reflect.target_simd_width", "SIMD width of the chosen target CPU, set by --target"),
        cache_line_bytes: pending("reflect.target_cache_line", "cache line size of the chosen target, set by --target"),
        opt_level:        pending("reflect.target_opt_level", "optimisation level set by the compile driver"),
    };
}

// Max register arguments before spilling to stack
pub fn target_max_gpr_args(target: TargetDescriptor) -> u32 {
    if target.os == "windows" && target.arch == "x86_64" {
        return 4; // Win64 calling convention (RCX, RDX, R8, R9)
    }
    if target.arch == "aarch64" {
        return 8; // AAPCS64 (X0..X7)
    }
    if target.arch == "wasm32" {
        return 16; // WebAssembly virtual local arguments
    }
    return 6; // System V AMD64 (RDI, RSI, RDX, RCX, R8, R9)
}

// Caller shadow stack space requirement
pub fn target_caller_shadow_bytes(target: TargetDescriptor) -> u32 {
    if target.os == "windows" && target.arch == "x86_64" {
        return 32; // Win64 mandatory 32-byte shadow space
    }
    return 0;
}
