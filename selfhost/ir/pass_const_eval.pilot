// ==============================================================================
// FILE: selfhost/ir/pass_const_eval.pilot
// Computing functions that take nothing while compiling.
// ==============================================================================
// A function that takes no arguments and whose run has no effect gives the
// same value on every call, so it can be run once, while compiling, by the
// IR interpreter (`ir_eval`, selfhost/ir/interp.pilot). What it gives then
// replaces its calls:
//   - a number, a boolean or a text becomes a constant at every call (a
//     `const_bits`, `const_float` or `const_bytes` of the call's physics),
//     and a `const` holding one is read as that constant;
//   - a value that owns memory (a list, a map, a record) is kept only for a
//     `once` function (a `const` initializer or a zero-argument `pure`
//     function, which the checker keeps every caller from changing,
//     selfhost/check/consts.pilot): it is built once, first thing in
//     `<start>`, into a global marked `ready`, and every call reads that
//     global. A `const`'s own global holds it.
// A run that stops (a runtime error, an effect such as printing, a global
// written, a function value called, or more than `eval_fuel()` steps) leaves
// the function as it is, so this never changes what a program does; at most
// `eval_total_fuel()` steps are spent on one module. Functions are tried in
// rounds, so a `const` read by another is known first.
pub lvl(0) pkg Pilot.SelfHost.Ir.PassConstEval;

use selfhost.ir.model.*;
use selfhost.ir.interp.*;

/// The most instructions one function may run while compiling.
pub pure fn eval_fuel() -> i64 => 100000;

/// The most instructions all functions of one module may run while compiling.
pub pure fn eval_total_fuel() -> i64 => 1000000;

/// What the pass keeps while it works on a module.
struct ConstEval : IObject {
    m: IrModule;
    /// Global -> its value as computed, and whether it is known.
    globals: List<any>;
    assigned: List<bool>;
    /// Function -> 0 not asked, 1 may run while compiling, 2 cannot (it
    /// calls through a function value or runs an engine operation with an
    /// effect, itself or through a function it calls), 3 being asked.
    runnable: List<i64>;
    /// Function -> 1 when computed (its calls are replaced).
    done: List<i64>;
    /// `const` initializer function -> the global `<start>` stores its
    /// value in, or -1.
    init_global: List<i64>;
    /// Where the next built-once value goes in `<start>`'s entry block.
    hoisted: i64;
    fuel: i64;
    allowed: Map<str, bool>;
}

/// Computes what can be computed in `m`; true when it changed anything.
pub fn const_eval_module(m: IrModule) -> bool {
    if m.functions.len == 0 { return false; }
    var globals: List<any> = [];
    var assigned: List<bool> = [];
    for g in m.globals {
        globals.push(none);
        assigned.push(g.ready);
    }
    var runnable: List<i64> = [];
    var done: List<i64> = [];
    var init_global: List<i64> = [];
    for f in m.functions {
        runnable.push(0);
        done.push(0);
        init_global.push(-1);
    }
    let ce = ConstEval { m: m, globals: globals, assigned: assigned, runnable: runnable, done: done, init_global: init_global, hoisted: 0, fuel: eval_total_fuel(), allowed: eval_engine_ops() };
    find_inits(ce);
    var changed = false;
    var progress = true;
    while progress && ce.fuel > 0 {
        progress = false;
        var fi = 1;
        while fi < m.functions.len && ce.fuel > 0 {
            if ce.done[fi] == 0 && takes_nothing(m.functions[fi]) && is_runnable(ce, fi) && try_function(ce, fi) {
                progress = true;
                changed = true;
            }
            fi = fi + 1;
        }
    }
    if keep_fresh_results(ce) { changed = true; }
    return changed;
}

/// The operands of `inst` that are values (a constant's pool index, a
/// branch's targets and argument counts are not).
fn value_operands(f: IrFunction, inst: IrInst) -> List<u32> {
    let a = ir_args(f, inst);
    let op = inst.opcode;
    var out: List<u32> = [];
    if op == op_const_bits() || op == op_const_float() || op == op_const_bytes() { return out; }
    if op == op_jump() {
        var i = 1;
        while i < a.len() { out.push(a[i]); i = i + 1; }
        return out;
    }
    if op == op_cond_br() {
        // [cond, then, n_then, then args.., else, n_else, else args..]
        out.push(a[0]);
        var i = 0;
        while i < a[2] { out.push(a[3 + i]); i = i + 1; }
        let e = 3 + a[2];
        i = 0;
        while i < a[e + 1] { out.push(a[e + 2 + i]); i = i + 1; }
        return out;
    }
    if op == op_switch_table() { return [a[0]]; }
    return a;
}

/// A copy (`value_clone`) of the result of a call to a `once` function that
/// was not computed here copies a value nobody else holds: each such call
/// still builds its own. The call then takes the copy's place (the copy
/// must come right after the call and be its only use).
fn keep_fresh_results(ce: ConstEval) -> bool {
    let m = ce.m;
    var changed = false;
    for f in m.functions {
        let defs = definitions(f);
        // Value id -> how many operands name it.
        var uses: List<i64> = [];
        for p in f.value_physics { uses.push(0); }
        for b in f.blocks {
            for inst in b.insts {
                for a in value_operands(f, inst) {
                    if a < uses.len() { uses[a] = uses[a] + 1; }
                }
            }
        }
        for b in f.blocks {
            var i = 0;
            while i < b.insts.len {
                let inst = b.insts[i];
                if inst.opcode == op_call_intrinsic() && m.intrinsics[inst.subop] == "value_clone" && inst.args_len == 1 {
                    let v = ir_args(f, inst)[0];
                    let k = f"{v}";
                    // Only right after the call, so nothing runs between
                    // where the call was and where it goes.
                    if defs.has(k) && uses[v] == 1 && defs.get(k)[0] == b.id && defs.get(k)[1] == i - 1 {
                        let at = defs.get(k);
                        let call = f.blocks[at[0]].insts[at[1]];
                        if call.opcode == op_call_direct() && call.args_len == 0 && m.functions[call.subop].once && ce.done[call.subop] == 0 {
                            b.insts[i] = ir_inst_new(inst.result, op_call_direct(), call.subop, inst.physics, inst.args_offset, 0, inst.span_id);
                            f.blocks[at[0]].insts[at[1]] = ir_inst_new(call.result, op_undef(), 0, call.physics, call.args_offset, 0, call.span_id);
                            changed = true;
                        }
                    }
                }
                i = i + 1;
            }
        }
    }
    return changed;
}

fn takes_nothing(f: IrFunction) -> bool => f.blocks.len > 0 && f.blocks[0].params.len == 0;

/// The instruction defining each value of `f` (value id -> position as
/// `[block, index]`), for values defined by instructions.
fn definitions(f: IrFunction) -> Map<str, List<i64>> {
    let out = Map<str, List<i64>>();
    var b = 0;
    while b < f.blocks.len {
        var i = 0;
        while i < f.blocks[b].insts.len {
            let r = f.blocks[b].insts[i].result;
            if r != ir_no_value() { out.set(f"{r}", [b, i]); }
            i = i + 1;
        }
        b = b + 1;
    }
    return out;
}

/// The instruction defining value `v` of `f`, or none.
fn def_of(f: IrFunction, defs: Map<str, List<i64>>, v: u32) -> IrInst? {
    let k = f"{v}";
    if !defs.has(k) { return none; }
    let at = defs.get(k);
    return f.blocks[at[0]].insts[at[1]];
}

/// Finds each `const` initializer's global: the only store to that global
/// in the module is in `<start>` and stores the initializer's result.
fn find_inits(ce: ConstEval) {
    let m = ce.m;
    var stores: List<i64> = [];
    for g in m.globals { stores.push(0); }
    for f in m.functions {
        let defs = definitions(f);
        for b in f.blocks {
            for inst in b.insts {
                if inst.opcode != op_store() { continue; }
                if some a = def_of(f, defs, ir_args(f, inst)[0]) {
                    if a.opcode == op_global_addr() { stores[a.subop] = stores[a.subop] + 1; }
                }
            }
        }
    }
    let f = m.functions[0];
    let defs = definitions(f);
    for b in f.blocks {
        for inst in b.insts {
            if inst.opcode != op_store() { continue; }
            let a = ir_args(f, inst);
            if some addr = def_of(f, defs, a[0]) {
                if some v = def_of(f, defs, a[1]) {
                    if addr.opcode == op_global_addr() && stores[addr.subop] == 1 && v.opcode == op_call_direct()
                        && v.args_len == 0 && m.functions[v.subop].once {
                        ce.init_global[v.subop] = addr.subop;
                    }
                }
            }
        }
    }
}

/// Whether function `fi` could run while compiling: it calls no function
/// value and no engine operation outside `eval_engine_ops()`, and neither
/// does any function it calls.
fn is_runnable(ce: ConstEval, fi: i64) -> bool {
    let state = ce.runnable[fi];
    if state == 1 || state == 3 { return true; }
    if state == 2 { return false; }
    ce.runnable[fi] = 3;
    let m = ce.m;
    var ok = true;
    for b in m.functions[fi].blocks {
        for inst in b.insts {
            if !ok { break; }
            let op = inst.opcode;
            if op == op_call_indirect() { ok = false; }
            else if op == op_call_intrinsic() && !ce.allowed.has(m.intrinsics[inst.subop]) { ok = false; }
            else if op == op_call_direct() && (inst.subop == 0 || !is_runnable(ce, inst.subop)) { ok = false; }
        }
    }
    ce.runnable[fi] = if ok { 1 } else { 2 };
    return ok;
}

/// Runs function `fi` while compiling and puts what it gave in place of its
/// calls; true when it did.
fn try_function(ce: ConstEval, fi: i64) -> bool {
    let m = ce.m;
    let f = m.functions[fi];
    let fuel = if ce.fuel < eval_fuel() { ce.fuel } else { eval_fuel() };
    let r = ir_eval(m, fi, ce.globals, ce.assigned, fuel);
    let steps: i64 = r[2];
    ce.fuel = ce.fuel - steps;
    if r[0] != true { return false; }
    let value = r[1];
    let g = ce.init_global[fi];
    if some k = constant_of(m, f, value) {
        ce.done[fi] = 1;
        replace_calls(m, fi, k);
        if g >= 0 {
            ce.globals[g] = value;
            ce.assigned[g] = true;
            replace_loads(m, g, k);
            drop_stores(m, g);
        }
        return true;
    }
    if !f.once || is_scalar_physics(f.ret_physics) { return false; }
    ce.done[fi] = 1;
    var target = g;
    if target < 0 {
        target = m.globals.len;
        m.globals.push(IrGlobal { name: f"once@{f.name}", physics: f.ret_physics, ready: true });
        ce.globals.push(none);
        ce.assigned.push(false);
    }
    m.globals[target] = IrGlobal { name: m.globals[target].name, physics: m.globals[target].physics, ready: true };
    // A `const`'s own store in `<start>` is replaced by the one built first.
    if g >= 0 { drop_stores(m, g); }
    hoist(ce, fi, target);
    ce.globals[target] = value;
    ce.assigned[target] = true;
    replace_calls_with_load(m, fi, target);
    return true;
}

/// Whether physics `p` is a number or a boolean (never a reference).
fn is_scalar_physics(p: IrTypePhysics) -> bool =>
    p.reg_class == reg_class_gpr_signed() || p.reg_class == reg_class_gpr_unsigned() || p.reg_class == reg_class_simd_float();

// ------------------------------------------------------------------------------
// Constants
// ------------------------------------------------------------------------------

/// A constant standing for `value` as the result of `f`: `[opcode, pool
/// index]`, or none when the value has no constant of that physics.
fn constant_of(m: IrModule, f: IrFunction, value: any) -> List<i64>? {
    let p = f.ret_physics;
    if p.layout_id == 0 || value == none { return none; }
    let rc = p.reg_class;
    if (rc == reg_class_gpr_signed() || rc == reg_class_gpr_unsigned()) && p.bit_width == 1 {
        return [op_const_bits() as i64, int_pool(m, if value == true { 1 } else { 0 })];
    }
    if rc == reg_class_gpr_signed() && p.bit_width > 1 && p.bit_width <= 64 {
        let v: i64 = value;
        return [op_const_bits() as i64, int_pool(m, v)];
    }
    if rc == reg_class_gpr_unsigned() && p.bit_width > 1 && p.bit_width < 64 {
        let v: i64 = value as i64;
        return [op_const_bits() as i64, int_pool(m, v)];
    }
    if rc == reg_class_simd_float() && p.bit_width == 64 {
        if some bits = f64_bits(value) { return [op_const_float() as i64, float_pool(m, bits)]; }
        return none;
    }
    // Text: only where the function itself writes text of this physics, so
    // the result is known to be text the emitters write as a constant.
    if writes_text_of(f, p) { return [op_const_bytes() as i64, str_pool(m, value)]; }
    return none;
}

fn writes_text_of(f: IrFunction, p: IrTypePhysics) -> bool {
    for b in f.blocks {
        for inst in b.insts {
            if inst.opcode == op_const_bytes() && inst.physics.layout_id == p.layout_id { return true; }
        }
    }
    return false;
}

fn int_pool(m: IrModule, v: i64) -> i64 {
    var i = 0;
    while i < m.ints.len {
        if m.ints[i] == v { return i; }
        i = i + 1;
    }
    m.ints.push(v);
    return m.ints.len - 1;
}

fn float_pool(m: IrModule, bits: i64) -> i64 {
    var i = 0;
    while i < m.floats.len {
        if m.floats[i] == bits { return i; }
        i = i + 1;
    }
    m.floats.push(bits);
    return m.floats.len - 1;
}

fn str_pool(m: IrModule, v: str) -> i64 {
    var i = 0;
    while i < m.strings.len {
        if m.strings[i] == v { return i; }
        i = i + 1;
    }
    m.strings.push(v);
    return m.strings.len - 1;
}

/// The IEEE 754 binary64 bits of finite, non-zero `x`, worked out by
/// scaling with powers of two (each step exact); none for zero (whose sign
/// this cannot see), infinities and NaN.
pub fn f64_bits(x: f64) -> i64? {
    if x != x || x == 0.0 { return none; }
    var a = x;
    var negative = false;
    if a < 0.0 {
        negative = true;
        a = 0.0 - a;
    }
    if a > 1.7976931348623157e308 { return none; }
    var e = 0;
    var mant = a;
    while mant >= 2.0 {
        mant = mant / 2.0;
        e = e + 1;
    }
    while mant < 1.0 && e > -1022 {
        mant = mant * 2.0;
        e = e - 1;
    }
    var bits = 0;
    if mant < 1.0 {
        // Subnormal: a = mant * 2^-1022 with mant below 1.
        bits = (mant * 4503599627370496.0) as i64;
    } else {
        bits = (e + 1023) * 4503599627370496 + ((mant - 1.0) * 4503599627370496.0) as i64;
    }
    if negative { bits = bits + (-9223372036854775807 - 1); }
    // Only bits that give `x` back exactly are used.
    return if f64_from_bits(bits) == x { bits } else { none };
}

// ------------------------------------------------------------------------------
// Rewriting
// ------------------------------------------------------------------------------

/// Every call of `fi` (with no arguments) becomes constant `k`.
fn replace_calls(m: IrModule, fi: i64, k: List<i64>) {
    for f in m.functions {
        for b in f.blocks {
            var i = 0;
            while i < b.insts.len {
                let inst = b.insts[i];
                if inst.opcode == op_call_direct() && inst.subop == fi && inst.args_len == 0 && inst.result != ir_no_value() {
                    b.insts[i] = constant_inst(f, inst.result, inst.physics, k, inst.span_id);
                }
                i = i + 1;
            }
        }
    }
}

fn constant_inst(f: IrFunction, result: u32, phy: IrTypePhysics, k: List<i64>, span: u32) -> IrInst {
    let offset = f.operand_pool.len;
    f.operand_pool.push(k[1] as u32);
    return ir_inst_new(result, k[0] as u16, 0, phy, offset, 1, span);
}

/// Every read of global `g` (a `load` of its address) becomes constant `k`.
fn replace_loads(m: IrModule, g: i64, k: List<i64>) {
    for f in m.functions {
        let defs = definitions(f);
        for b in f.blocks {
            var i = 0;
            while i < b.insts.len {
                let inst = b.insts[i];
                if inst.opcode == op_load() {
                    if some a = def_of(f, defs, ir_args(f, inst)[0]) {
                        if a.opcode == op_global_addr() && a.subop == g && same_physics(inst.physics, m.globals[g].physics) {
                            b.insts[i] = constant_inst(f, inst.result, inst.physics, k, inst.span_id);
                        }
                    }
                }
                i = i + 1;
            }
        }
    }
}

/// Removes the stores to global `g`, which nothing reads any more (its reads
/// are constants now); dead-code elimination removes what they stored.
fn drop_stores(m: IrModule, g: i64) {
    for f in m.functions {
        let defs = definitions(f);
        for b in f.blocks {
            var out: List<IrInst> = [];
            var touched = false;
            for inst in b.insts {
                var keep = true;
                if inst.opcode == op_store() {
                    if some a = def_of(f, defs, ir_args(f, inst)[0]) {
                        if a.opcode == op_global_addr() && a.subop == g { keep = false; }
                    }
                }
                if keep { out.push(inst); } else { touched = true; }
            }
            if touched { b.insts = out; }
        }
    }
}

fn same_physics(a: IrTypePhysics, b: IrTypePhysics) -> bool =>
    a.layout_id == b.layout_id && a.reg_class == b.reg_class && a.bit_width == b.bit_width;

/// Builds function `fi`'s value into global `g` first thing in `<start>`,
/// after the values built there before it (which it may read).
[StandIn("ir.const_static_data", "a constant that owns memory is laid out as static data in the output, built while compiling", "only a list of numbers, booleans and such lists is laid out as static data, and only in C (selfhost/transpile/static_data.pilot); a map, a record, a list holding text, and every constant in the other emitters and pilot ir run is built once, first thing in <start>, into a global marked ready", "F8")]
fn hoist(ce: ConstEval, fi: i64, g: i64) {
    let start = ce.m.functions[0];
    let f = ce.m.functions[fi];
    let entry = start.blocks[0];
    let addr = ir_new_value(start, ce.m.globals[g].physics);
    let v = ir_new_value(start, f.ret_physics);
    start.spans.push(ir_no_span());
    let span = start.spans.len - 1;
    let a_off = start.operand_pool.len;
    let s_off = a_off;
    start.operand_pool.push(addr);
    start.operand_pool.push(v);
    let added = [
        ir_inst_new(addr, op_global_addr(), g as u16, ce.m.globals[g].physics, a_off, 0, span),
        ir_inst_new(v, op_call_direct(), fi as u16, f.ret_physics, a_off, 0, span),
        ir_inst_new(ir_no_value(), op_store(), 0, ce.m.layouts[0].physics, s_off, 2, span),
    ];
    var insts: List<IrInst> = [];
    var i = 0;
    while i < ce.hoisted {
        insts.push(entry.insts[i]);
        i = i + 1;
    }
    for x in added { insts.push(x); }
    while i < entry.insts.len {
        insts.push(entry.insts[i]);
        i = i + 1;
    }
    entry.insts = insts;
    ce.hoisted = ce.hoisted + added.len();
}

/// Every call of `fi` (with no arguments) other than the one building global
/// `g` reads `g` instead.
fn replace_calls_with_load(m: IrModule, fi: i64, g: i64) {
    var fx = 0;
    for f in m.functions {
        for b in f.blocks {
            var out: List<IrInst> = [];
            var touched = false;
            var i = 0;
            for inst in b.insts {
                let building = fx == 0 && b.id == 0 && is_build_of(f, b, i, g);
                if inst.opcode == op_call_direct() && inst.subop == fi && inst.args_len == 0 && inst.result != ir_no_value() && !building {
                    let addr = ir_new_value(f, m.globals[g].physics);
                    out.push(ir_inst_new(addr, op_global_addr(), g as u16, m.globals[g].physics, f.operand_pool.len, 0, inst.span_id));
                    let off = f.operand_pool.len;
                    f.operand_pool.push(addr);
                    out.push(ir_inst_new(inst.result, op_load(), 0, inst.physics, off, 1, inst.span_id));
                    touched = true;
                } else {
                    out.push(inst);
                }
                i = i + 1;
            }
            if touched { b.insts = out; }
        }
        fx = fx + 1;
    }
}

/// Whether instruction `i` of block `b` of `<start>` is the call `hoist`
/// added to build global `g` (followed by its store into `g`).
fn is_build_of(f: IrFunction, b: IrBlock, i: i64, g: i64) -> bool {
    if i == 0 || i + 1 >= b.insts.len { return false; }
    let before = b.insts[i - 1];
    let after = b.insts[i + 1];
    return before.opcode == op_global_addr() && before.subop == g && after.opcode == op_store()
        && before.span_id == b.insts[i].span_id && after.span_id == b.insts[i].span_id;
}
