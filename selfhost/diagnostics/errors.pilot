// =============================================================================
// FILE: selfhost/diagnostics/errors.pilot
// Pilot Semantic Diagnostics: Error Diagnostic Catalog (Severity 1)
// =============================================================================
// Reference Inspiration: C# (Roslyn), Python (Mypy/Ruff), and Rust (rustc).
// Minimal forward-facing code: structured purely as an extensible diagnostic list.
// =============================================================================
pub pkg Pilot.Diagnostics.Errors;

pub struct ErrorDef : IValue {
    pub code: str;
    pub title: str;
    pub description: str;
    pub category: str;
    pub reference: str;
}

