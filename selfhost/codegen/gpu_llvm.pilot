// ============================================================================
// FILE: selfhost/codegen/gpu_llvm.pilot
// Milestone 56.2: AST-Lowering Direct LLVM IR for NVPTX & AMDGPU + Unified
// 8-Backend GPU Kernel Dispatcher (`emit_arena_gpu_kernel`).
// ============================================================================

[Layout(c_abi)]
pub struct GpuLlvmIrArtifact : IValue {
    pub target_triple: str;
    pub kernel_name: str;
    pub llvm_ir: str;
}

pub fn emit_nvptx_llvm_ir_module(
    kernel_name: str,
    llvm_params: str,
    ssa_body_ops: str
) -> GpuLlvmIrArtifact {
    let triple = "nvptx64-nvidia-cuda";
    let ir = "target triple = \"" + triple + "\"\n\n"
        + "declare i32 @llvm.nvvm.read.ptx.sreg.tid.x() nounwind readnone\n"
        + "declare i32 @llvm.nvvm.read.ptx.sreg.ctaid.x() nounwind readnone\n"
        + "declare i32 @llvm.nvvm.read.ptx.sreg.ntid.x() nounwind readnone\n\n"
        + "define void @" + kernel_name + "(" + llvm_params + ") {\n"
        + "entry:\n"
        + "  %tid = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()\n"
        + "  %bid = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()\n"
        + "  %bdim = call i32 @llvm.nvvm.read.ptx.sreg.ntid.x()\n"
        + "  %off = mul i32 %bid, %bdim\n"
        + "  %gid32 = add i32 %off, %tid\n"
        + "  %idx = sext i32 %gid32 to i64\n"
        + "  " + ssa_body_ops + "\n"
        + "  ret void\n"
        + "}\n\n"
        + "!nvvm.annotations = !{!0}\n"
        + "!0 = !{ptr @" + kernel_name + ", !\"kernel\", i32 1}\n";
    return GpuLlvmIrArtifact {
        target_triple: triple,
        kernel_name: kernel_name,
        llvm_ir: ir,
    };
}

pub fn emit_amdgpu_llvm_ir_module(
    kernel_name: str,
    llvm_params: str,
    ssa_body_ops: str
) -> GpuLlvmIrArtifact {
    let triple = "amdgcn-amd-amdhsa";
    let ir = "target triple = \"" + triple + "\"\n\n"
        + "declare i32 @llvm.amdgcn.workitem.id.x() nounwind readnone\n"
        + "declare i32 @llvm.amdgcn.workgroup.id.x() nounwind readnone\n\n"
        + "define amdgpu_kernel void @" + kernel_name + "(" + llvm_params + ") {\n"
        + "entry:\n"
        + "  %tid = call i32 @llvm.amdgcn.workitem.id.x()\n"
        + "  %bid = call i32 @llvm.amdgcn.workgroup.id.x()\n"
        + "  %off = mul i32 %bid, 64\n"
        + "  %gid32 = add i32 %off, %tid\n"
        + "  %idx = sext i32 %gid32 to i64\n"
        + "  " + ssa_body_ops + "\n"
        + "  ret void\n"
        + "}\n";
    return GpuLlvmIrArtifact {
        target_triple: triple,
        kernel_name: kernel_name,
        llvm_ir: ir,
    };
}

pub fn gl_next_ssa(st: i64, prefix: str) -> str {
    let n = ((__engine("map_get", st, "gl_n") ?? 0)) + 1;
    __engine("map_set", st, "gl_n", n);
    return "%" + prefix + n;
}

pub fn gl_append(st: i64, line: str) -> i64 {
    let cur = "" + __engine("map_get", st, "gl_ops");
    __engine("map_set", st, "gl_ops", cur + "  " + line + "\n");
    return 0;
}

pub fn gl_emit_expr(nid: i64, st: i64, backend: str, want_float: bool) -> str {
    if nid < 0 { return if want_float { "0.0" } else { "0" }; }
    let k = __engine("ast_node_kind", nid);
    let orig = __engine("ast_orig_kind", nid);
    if k == 15 && __engine("ast_node_lit_kind", nid) == 1 {
        let v = __engine("ast_node_raw_bits", nid);
        if want_float { return "" + v + ".0"; }
        return "" + v;
    }
    if k == 14 {
        let nm = __engine("sym_str", __engine("ast_node_sym", nid));
        if ((__engine("map_get", st, "has_ssa_" + nm) ?? 0)) == 1 {
            return "" + __engine("map_get", st, "ssa_" + nm);
        }
        return "%" + nm;
    }
    if orig == 210 {
        let base_nid = __engine("ast_child_at", nid, 0);
        let base_orig = __engine("ast_orig_kind", base_nid);
        var base_ptr = "";
        if base_orig == 210 {
            base_ptr = gl_emit_expr(base_nid, st, backend, false);
        } else {
            let base_nm = __engine("sym_str", __engine("ast_node_sym", base_nid));
            base_ptr = "%" + base_nm;
        }
        let idx_v = gl_emit_expr(__engine("ast_child_at", nid, 1), st, backend, false);
        let gep = gl_next_ssa(st, "gep");
        let ld = gl_next_ssa(st, "ld");
        gl_append(st, gep + " = getelementptr inbounds float, ptr " + base_ptr + ", i64 " + idx_v);
        gl_append(st, ld + " = load float, ptr " + gep + ", align 4");
        return ld;
    }
    if k == 16 && gc_is_gid_call(nid) {
        let tid = gl_next_ssa(st, "tid");
        let bid = gl_next_ssa(st, "bid");
        let off = gl_next_ssa(st, "off");
        let gid32 = gl_next_ssa(st, "gid");
        let gid64 = gl_next_ssa(st, "idx");
        if backend == "nvptx" {
            let bdim = gl_next_ssa(st, "bdim");
            gl_append(st, tid + " = call i32 @llvm.nvvm.read.ptx.sreg.tid.x()");
            gl_append(st, bid + " = call i32 @llvm.nvvm.read.ptx.sreg.ctaid.x()");
            gl_append(st, bdim + " = call i32 @llvm.nvvm.read.ptx.sreg.ntid.x()");
            gl_append(st, off + " = mul i32 " + bid + ", " + bdim);
        } else {
            gl_append(st, tid + " = call i32 @llvm.amdgcn.workitem.id.x()");
            gl_append(st, bid + " = call i32 @llvm.amdgcn.workgroup.id.x()");
            gl_append(st, off + " = mul i32 " + bid + ", 64");
        }
        gl_append(st, gid32 + " = add i32 " + off + ", " + tid);
        gl_append(st, gid64 + " = sext i32 " + gid32 + " to i64");
        return gid64;
    }
    if k == 19 {
        let op = __engine("ast_node_raw_bits", nid);
        let flt = want_float || gs_expr_is_float(nid, st);
        let l = gl_emit_expr(__engine("ast_child_at", nid, 0), st, backend, flt);
        let r = gl_emit_expr(__engine("ast_child_at", nid, 1), st, backend, flt);
        let dst = gl_next_ssa(st, "v");
        if op == 1 {
            gl_append(st, dst + " = " + (if flt { "fadd float " } else { "add i64 " }) + l + ", " + r);
            return dst;
        }
        if op == 2 {
            gl_append(st, dst + " = " + (if flt { "fsub float " } else { "sub i64 " }) + l + ", " + r);
            return dst;
        }
        if op == 3 {
            gl_append(st, dst + " = " + (if flt { "fmul float " } else { "mul i64 " }) + l + ", " + r);
            return dst;
        }
        if op == 4 {
            gl_append(st, dst + " = " + (if flt { "fdiv float " } else { "sdiv i64 " }) + l + ", " + r);
            return dst;
        }
        if op == 10 {
            gl_append(st, dst + " = icmp slt i64 " + l + ", " + r);
            return dst;
        }
        gl_append(st, dst + " = add i64 " + l + ", " + r);
        return dst;
    }
    return "0";
}

pub fn gl_emit_stmt(nid: i64, st: i64, backend: str) -> i64 {
    let k = __engine("ast_node_kind", nid);
    if k == 18 {
        let cc = __engine("ast_child_count", nid);
        var ci = 0;
        while ci < cc {
            gl_emit_stmt(__engine("ast_child_at", nid, ci), st, backend);
            ci = ci + 1;
        }
        return 0;
    }
    if k == 4 {
        let vname = __engine("sym_str", __engine("ast_node_sym", nid));
        if __engine("ast_child_count", nid) > 0 {
            let init_nid = __engine("ast_child_at", nid, 0);
            let flt = gs_expr_is_float(init_nid, st);
            if flt { __engine("map_set", st, "is_flt_" + vname, 1); }
            let sv = gl_emit_expr(init_nid, st, backend, flt);
            __engine("map_set", st, "has_ssa_" + vname, 1);
            __engine("map_set", st, "ssa_" + vname, sv);
        }
        return 0;
    }
    if k == 20 {
        let lhs_nid = __engine("ast_child_at", nid, 0);
        let rhs_nid = __engine("ast_child_at", nid, 1);
        if __engine("ast_orig_kind", lhs_nid) == 210 {
            let base_nid = __engine("ast_child_at", lhs_nid, 0);
            let base_orig = __engine("ast_orig_kind", base_nid);
            var out_ptr = "";
            if base_orig == 210 {
                out_ptr = gl_emit_expr(base_nid, st, backend, false);
            } else {
                let out_nm = __engine("sym_str", __engine("ast_node_sym", base_nid));
                out_ptr = "%" + out_nm;
            }
            let idx_v = gl_emit_expr(__engine("ast_child_at", lhs_nid, 1), st, backend, false);
            let rhs_v = gl_emit_expr(rhs_nid, st, backend, true);
            let gep = gl_next_ssa(st, "outgep");
            gl_append(st, gep + " = getelementptr inbounds float, ptr " + out_ptr + ", i64 " + idx_v);
            gl_append(st, "store float " + rhs_v + ", ptr " + gep + ", align 4");
            return 0;
        }
        let vname = __engine("sym_str", __engine("ast_node_sym", lhs_nid));
        let rv = gl_emit_expr(rhs_nid, st, backend, gs_expr_is_float(rhs_nid, st));
        __engine("map_set", st, "has_ssa_" + vname, 1);
        __engine("map_set", st, "ssa_" + vname, rv);
        return 0;
    }
    if k == 6 {
        let cond_v = gl_emit_expr(__engine("ast_child_at", nid, 0), st, backend, false);
        let lid = ((__engine("map_get", st, "gl_lbl") ?? 0)) + 1;
        __engine("map_set", st, "gl_lbl", lid);
        let l_then = "if.then" + lid;
        let l_end = "if.end" + lid;
        gl_append(st, "br i1 " + cond_v + ", label %" + l_then + ", label %" + l_end);
        let cur = "" + __engine("map_get", st, "gl_ops");
        __engine("map_set", st, "gl_ops", cur + l_then + ":\n");
        gl_emit_stmt(__engine("ast_child_at", nid, 1), st, backend);
        gl_append(st, "br label %" + l_end);
        let cur2 = "" + __engine("map_get", st, "gl_ops");
        __engine("map_set", st, "gl_ops", cur2 + l_end + ":\n");
        return 0;
    }
    if k == 8 && __engine("ast_child_count", nid) > 0 {
        gl_emit_expr(__engine("ast_child_at", nid, 0), st, backend, false);
        return 0;
    }
    return 0;
}

pub fn gl_emit_gpu_llvm_from_arena(backend: str, kernel_name: str) -> str {
    let fn_nid = cg_find_fn_by_name(kernel_name);
    if fn_nid < 0 { return ""; }
    let st = __engine("map_new");
    __engine("map_set", st, "gl_n", 0);
    __engine("map_set", st, "gl_lbl", 0);
    __engine("map_set", st, "gl_ops", "");
    let cc = __engine("ast_child_count", fn_nid);
    var params = "";
    var pi = 1;
    while pi < cc {
        let pch = __engine("ast_child_at", fn_nid, pi);
        if __engine("ast_node_kind", pch) == 21 {
            if params.len() > 0 { params = params + ", "; }
            let pname = __engine("sym_str", __engine("ast_node_sym", pch));
            let ptname = __engine("sym_str", __engine("ast_node_raw_bits", pch));
            let p = cg_resolve_type_physics(ptname);
            if p.reg_class == 6 {
                __engine("map_set", st, "is_ptr_" + pname, 1);
                params = params + "ptr %" + pname;
            } else if p.reg_class == 4 {
                __engine("map_set", st, "is_flt_" + pname, 1);
                params = params + "float %" + pname;
            } else {
                params = params + "i64 %" + pname;
            }
        }
        pi = pi + 1;
    }
    gl_emit_stmt(__engine("ast_child_at", fn_nid, 0), st, backend);
    let body_ops = "" + __engine("map_get", st, "gl_ops");
    if backend == "nvptx" {
        return "target triple = \"nvptx64-nvidia-cuda\"\n\n"
            + "declare i32 @llvm.nvvm.read.ptx.sreg.tid.x() nounwind readnone\n"
            + "declare i32 @llvm.nvvm.read.ptx.sreg.ctaid.x() nounwind readnone\n"
            + "declare i32 @llvm.nvvm.read.ptx.sreg.ntid.x() nounwind readnone\n\n"
            + "define void @" + kernel_name + "(" + params + ") {\n"
            + "entry:\n"
            + body_ops
            + "  ret void\n"
            + "}\n\n"
            + "!nvvm.annotations = !{!0}\n"
            + "!0 = !{ptr @" + kernel_name + ", !\"kernel\", i32 1}\n";
    }
    return "target triple = \"amdgcn-amd-amdhsa\"\n\n"
        + "declare i32 @llvm.amdgcn.workitem.id.x() nounwind readnone\n"
        + "declare i32 @llvm.amdgcn.workgroup.id.x() nounwind readnone\n\n"
        + "define amdgpu_kernel void @" + kernel_name + "(" + params + ") {\n"
        + "entry:\n"
        + body_ops
        + "  ret void\n"
        + "}\n";
}

pub fn emit_arena_gpu_kernel(backend: str, kernel_name: str) -> str {
    if backend == "cuda" || backend == "hip" || backend == "opencl" || backend == "openmp" {
        return gc_emit_c_dialect_kernel(backend, kernel_name);
    }
    if backend == "wgsl" {
        return gs_emit_wgsl_from_arena(kernel_name);
    }
    if backend == "spirv" {
        return gs_emit_spirv_from_arena(kernel_name);
    }
    if backend == "nvptx" || backend == "amdgpu" {
        return gl_emit_gpu_llvm_from_arena(backend, kernel_name);
    }
    return "";
}
