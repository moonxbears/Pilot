// ==============================================================================
// FILE: selfhost/transpile/emit_python.pilot
// `pilot emit python`: PilIR as Python 3 (selfhost/transpile/source.pilot).
// ==============================================================================
// Integers are Python integers wrapped to their register width after every
// operation that can leave it; `/` and `%` on integers truncate toward zero
// as the seed's do. Floats are binary64 only. Records are lists. `print`
// shows values as the seed does (`true`, `1` for 1.0, no exponent).
pub lvl(0) pkg Pilot.SelfHost.Transpile.EmitPython;

use selfhost.ir.model.*;
use selfhost.transpile.source.*;

pub struct PythonDialect : ISourceDialect {
    pub fn language() -> str => "Python";
    pub fn typed() -> bool => false;
    pub fn reserved() -> List<str> => [
        "False", "None", "True", "and", "as", "assert", "async", "await", "break", "class", "continue",
        "def", "del", "elif", "else", "except", "finally", "for", "from", "global", "if", "import",
        "in", "is", "lambda", "nonlocal", "not", "or", "pass", "raise", "return", "try", "while",
        "with", "yield", "print", "int", "float", "str", "list", "len", "math", "sys", "decimal",
        // Builtins and modules the prelude calls: a program function of the
        // same name (`fn bool(..)`) would replace them.
        "abs", "all", "bool", "callable", "dict", "isinstance", "max", "min", "object", "pow", "repr",
        "sorted", "struct", "tuple", "type", "zip",
    ];
    pub fn type_name(p: IrTypePhysics) -> str? {
        if is_float(p) && p.bit_width != 64 && p.bit_width != 32 { return none; }
        if p.reg_class == reg_class_simd_vector() { return none; }
        return "";
    }
    pub fn prelude() -> List<str> => [
        "import decimal, math, struct, sys",
        "",
        "def pilot_wrap(x, bits, signed):",
        "    x &= (1 << bits) - 1",
        "    return x - (1 << bits) if signed and x >> (bits - 1) else x",
        "",
        "def pilot_trap(message):",
        "    print('runtime error: ' + message, file=sys.stderr)",
        "    sys.exit(1)",
        "",
        "def pilot_div(a, b, bits, signed):",
        "    if b == 0:",
        "        pilot_trap('integer division by zero')",
        "    q = abs(a) // abs(b)",
        "    return pilot_wrap(q if (a < 0) == (b < 0) else -q, bits, signed)",
        "",
        "def pilot_rem(a, b, bits, signed):",
        "    if b == 0:",
        "        pilot_trap('integer division by zero')",
        "    q = abs(a) // abs(b)",
        "    return pilot_wrap(a - b * (q if (a < 0) == (b < 0) else -q), bits, signed)",
        "",
        "def pilot_show(x):",
        "    if isinstance(x, bool):",
        "        return 'true' if x else 'false'",
        "    if isinstance(x, float):",
        "        if x != x:",
        "            return 'NaN'",
        "        if x in (float('inf'), float('-inf')):",
        "            return 'inf' if x > 0 else '-inf'",
        "        s = format(decimal.Decimal(repr(x)), 'f')",
        "        return s.rstrip('0').rstrip('.') if '.' in s else s",
        "    if x is None:",
        "        return 'null'",
        "    if isinstance(x, list):",
        "        return '[' + ', '.join(pilot_show(e) for e in x) + ']'",
        "    if isinstance(x, dict):",
        "        return '{ ' + ', '.join(sorted(k + ': ' + pilot_show(v) for k, v in x.items())) + ' }'",
        "    return str(x)",
        "",
        "def pilot_add(a, b):",
        "    if isinstance(a, str) or isinstance(b, str):",
        "        return pilot_show(a) + pilot_show(b)",
        "    return pilot_arith('+', a, b)",
        "def pilot_f32(x):",
        "    try:",
        "        return struct.unpack('f', struct.pack('f', x))[0]",
        "    except OverflowError:",
        "        return math.copysign(math.inf, x)",
        "",
        "def pilot_fdiv(x, y):",
        "    if y == 0:",
        "        return math.nan if x == 0 or x != x else math.copysign(math.inf, x) * math.copysign(1.0, y)",
        "    return x / y",
        "",
        "def pilot_frem(x, y):",
        "    return math.nan if y == 0 or math.isinf(x) else math.fmod(x, y)",
        "pilot_unset = object()",
        "",
        "def pilot_unset_read(message):",
        "    pilot_trap(message)",
        "",
        "def pilot_truth(v):",
        "    if not isinstance(v, bool):",
        "        pilot_trap('condition must be a boolean, found ' + pilot_kind(v))",
        "    return v",
        "",
        "def pilot_convert(v, kind, bits, signed):",
        "    if kind == 'int' and bits >= 64 and (isinstance(v, (list, dict)) or callable(v)):",
        "        return v",
        "    if isinstance(v, bool):",
        "        n = int(v)",
        "    elif pilot_is_num(v):",
        "        n = v",
        "    else:",
        "        pilot_trap('cannot convert ' + pilot_kind(v) + ' to a number')",
        "    if kind == 'bool':",
        "        return n != 0",
        "    if kind == 'float':",
        "        return pilot_f32(float(n)) if bits == 32 else float(n)",
        "    if isinstance(n, float):",
        "        if n != n or math.isinf(n) or not (-9223372036854775808.0 <= math.trunc(n) < (18446744073709551616.0 if not signed else 9223372036854775808.0)):",
        "            pilot_trap(pilot_show(n) + ' does not fit an integer')",
        "        n = math.trunc(n)",
        "    return pilot_wrap(n, bits, signed)",
        "def pilot_proc_args():",
        "    return list(sys.argv[1:])",
        "",
        "def pilot_is_num(x):",
        "    return isinstance(x, (int, float)) and not isinstance(x, bool)",
        "",
        "def pilot_type_error(sym, a, b):",
        "    pilot_trap('cannot apply `' + sym + '` to ' + pilot_kind(a) + ' and ' + pilot_kind(b))",
        "",
        "def pilot_arith(sym, a, b):",
        "    if not (pilot_is_num(a) and pilot_is_num(b)):",
        "        pilot_type_error(sym, a, b)",
        "    if isinstance(a, int) and isinstance(b, int):",
        "        if sym == '/':",
        "            return pilot_div(a, b, 64, True)",
        "        if sym == '%':",
        "            return pilot_rem(a, b, 64, True)",
        "        return pilot_wrap(a + b if sym == '+' else a - b if sym == '-' else a * b, 64, True)",
        "    x, y = float(a), float(b)",
        "    if sym == '+':",
        "        return x + y",
        "    if sym == '-':",
        "        return x - y",
        "    if sym == '*':",
        "        return x * y",
        "    if sym == '%':",
        "        return math.nan if y == 0 or math.isinf(x) else math.fmod(x, y)",
        "    if y == 0:",
        "        return math.nan if x == 0 or x != x else math.copysign(math.inf, x) * math.copysign(1.0, y)",
        "    return x / y",
        "",
        "def pilot_bits(sym, a, b):",
        "    if isinstance(a, bool) and isinstance(b, bool) and sym in ('&', '|', '^'):",
        "        return (a and b) if sym == '&' else (a or b) if sym == '|' else (a != b)",
        "    if not (isinstance(a, int) and isinstance(b, int)) or isinstance(a, bool) or isinstance(b, bool):",
        "        pilot_type_error(sym, a, b)",
        "    n = b & 63",
        "    r = a & b if sym == '&' else a | b if sym == '|' else a ^ b if sym == '^' else a << n if sym == '<<' else a >> n",
        "    return pilot_wrap(r, 64, True)",
        "",
        "def pilot_str_byte_at(s, i):",
        "    raw = s.encode()",
        "    if 0 <= i < len(raw):",
        "        return raw[i]",
        "    pilot_trap('byte index ' + str(i) + ' out of bounds for length ' + str(len(raw)))",
        "def pilot_str_from_bytes(xs):",
        "    if any(isinstance(x, bool) or not isinstance(x, int) or x < 0 or x > 255 for x in xs):",
        "        pilot_trap('`str_from_bytes` takes bytes (0 to 255)')",
        "    try:",
        "        return bytes(xs).decode('utf-8')",
        "    except UnicodeDecodeError:",
        "        return None",
        "def pilot_eq(a, b):",
        "    if isinstance(a, list) and isinstance(b, list):",
        "        return a is b or (len(a) == len(b) and all(pilot_eq(x, y) for x, y in zip(a, b)))",
        "    na = isinstance(a, (int, float)) and not isinstance(a, bool)",
        "    nb = isinstance(b, (int, float)) and not isinstance(b, bool)",
        "    if na and nb:",
        "        return a == b if isinstance(a, int) and isinstance(b, int) else float(a) == float(b)",
        "    if isinstance(a, (str, bool)) and type(a) is type(b):",
        "        return a == b",
        "    return a is b",
        "def pilot_boundary(b, at):",
        "    u = min(max(at, 0), len(b))",
        "    while u < len(b) and (b[u] & 0xC0) == 0x80:",
        "        u += 1",
        "    return u",
        "",
        "def pilot_str_slice(v, a, b):",
        "    if isinstance(v, list):",
        "        n = len(v)",
        "        a, b = min(max(a, 0), n), min(max(b, 0), n)",
        "        return v[a:max(a, b)]",
        "    raw = v.encode()",
        "    a, b = pilot_boundary(raw, a), pilot_boundary(raw, b)",
        "    return raw[a:max(a, b)].decode()",
        "",
        "def pilot_leaves(v, deep, out):",
        "    for e in v:",
        "        if deep and isinstance(e, list):",
        "            pilot_leaves(e, True, out)",
        "        else:",
        "            out.append(e)",
        "",
        "def pilot_list_extend(l, other, deep):",
        "    leaves = []",
        "    pilot_leaves(other, deep is True, leaves)",
        "    l.extend(leaves)",
        "    return l",
        "",
        "def pilot_list_remove_at(l, i):",
        "    return l.pop(pilot_index(l, i))",
        "",
        "def pilot_stdin_read_line():",
        "    line = sys.stdin.readline()",
        "    if line == '':",
        "        return None",
        "    if line.endswith('\\n'):",
        "        line = line[:-1]",
        "    return line[:-1] if line.endswith('\\r') else line",
        "def pilot_kind(x):",
        "    if x is None:",
        "        return 'null'",
        "    if isinstance(x, bool):",
        "        return 'boolean'",
        "    if isinstance(x, int):",
        "        return 'integer'",
        "    if isinstance(x, float):",
        "        return 'float'",
        "    if isinstance(x, str):",
        "        return 'string'",
        "    if isinstance(x, list):",
        "        return 'list'",
        "    if isinstance(x, dict):",
        "        return 'record'",
        "    return 'function'",
        "",
        "def pilot_key(k):",
        "    return k if isinstance(k, str) else pilot_show(k)",
        "",
        "def pilot_index(o, k):",
        "    if isinstance(k, bool) or not isinstance(k, int):",
        "        pilot_trap('list index must be an integer, found ' + pilot_kind(k))",
        "    if k < 0 or k >= len(o):",
        "        pilot_trap('list index ' + str(k) + ' out of bounds for length ' + str(len(o)))",
        "    return k",
        "",
        "def pilot_map_get(o, k):",
        "    if isinstance(o, list):",
        "        return o[pilot_index(o, k)]",
        "    if isinstance(o, str) and isinstance(k, int) and not isinstance(k, bool):",
        "        b = o.encode()",
        "        if 0 <= k < len(b):",
        "            return b[k]",
        "        pilot_trap('string index ' + str(k) + ' out of bounds for length ' + str(len(b)))",
        "    if isinstance(o, dict):",
        "        return o.get(pilot_key(k))",
        "    pilot_trap('cannot read `' + pilot_key(k) + '` from ' + pilot_kind(o))",
        "",
        "def pilot_map_set(o, k, v):",
        "    if isinstance(o, list):",
        "        o[pilot_index(o, k)] = v",
        "        return o",
        "    if isinstance(o, dict):",
        "        o[pilot_key(k)] = v",
        "        return o",
        "    pilot_trap('cannot write `' + pilot_key(k) + '` on ' + pilot_kind(o))",
        "",
        "def pilot_map_has(m, k):",
        "    return pilot_key(k) in m",
        "",
        "def pilot_map_remove(m, k):",
        "    return m.pop(pilot_key(k), None)",
        "",
        "def pilot_list_push(l, x):",
        "    l.append(x)",
        "    return l",
        "",
        "def pilot_list_pop(l):",
        "    if not l:",
        "        pilot_trap('pop from an empty list')",
        "    return l.pop()",
        "",
        "def pilot_str_len(x):",
        "    return len(x.encode()) if isinstance(x, str) else len(x)",
        "",
        "def pilot_num_pow(a, b):",
        "    if isinstance(a, int) and isinstance(b, int) and not isinstance(a, bool):",
        "        if b < 0:",
        "            return float(a) ** b",
        "        return pilot_wrap(pow(a, b, 1 << 64), 64, True)",
        "    try:",
        "        return math.pow(a, b)",
        "    except (ValueError, OverflowError):",
        "        return math.nan if a < 0 else math.inf",
        "",
        "def pilot_rt_assert(cond, note=None):",
        "    if cond is not True:",
        "        pilot_trap('assertion failed' + ('' if note is None else ': ' + pilot_show(note)))",
        "",
        "def pilot_seam_open(id, note=None):",
        "    pilot_trap('SEAM001: unconnected seam `' + id + '`: ' + ('' if note is None else pilot_show(note)))",
        "",
    ];
    pub fn global_decl(name: str, p: IrTypePhysics) -> str? => name + " = pilot_unset";
    pub fn global_read(name: str, message: str) -> str => f"({name} if {name} is not pilot_unset else pilot_unset_read({message}))";
    pub fn global_write(name: str, v: str) -> str => f"{name} = {v}";
    pub fn truth(v: str) -> str? => f"pilot_truth({v})";
    pub fn module_open(protos: List<str>) -> List<str> => [];
    pub fn prototype(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str => "";
    pub fn module_close(entry: str, has_code: bool) -> List<str> {
        if entry == "" { return []; }
        if has_code { return [f"sys.exit({entry}())"]; }
        return [f"{entry}()"];
    }
    pub fn fn_open(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str =>
        f"def {name}({joined(params)}):";
    pub fn fn_close() -> str => "";
    pub fn fn_globals(globals: List<str>) -> List<str> => if globals.len() == 0 { [] } else { ["global " + joined(globals)] };
    pub fn param_prologue(name: str, p: IrTypePhysics) -> List<str> => [];
    pub fn locals(names: List<str>, phys: List<IrTypePhysics>) -> List<str> => [];
    pub fn zero(p: IrTypePhysics) -> str => if is_bool(p) { "False" } else if is_float(p) { "0.0" } else if is_int(p) { "0" } else { "None" };
    pub fn unit_value() -> str? => "None";
    pub fn state_decl(name: str) -> str => name + " = 0";
    pub fn dispatch_open() -> str => "while True:";
    pub fn dispatch_close() -> str => "";
    pub fn case_open(state: str, b: i64, first: bool) -> str => (if first { "if " } else { "elif " }) + f"{state} == {b}:";
    pub fn cases_close() -> str => "";
    pub fn if_open(cond: str) -> str => f"if {cond}:";
    pub fn else_line() -> str => "else:";
    pub fn if_close() -> str => "";
    pub fn assign(lhs: str, rhs: str) -> str => f"{lhs} = {rhs}";
    pub fn parallel_assign(lhs: List<str>, rhs: List<str>, phys: List<IrTypePhysics>) -> List<str> => [joined(lhs) + " = " + joined(rhs)];
    pub fn expr_stmt(e: str) -> str => e;
    pub fn ret(e: str) -> str => if e == "" { "return" } else { "return " + e };
    pub fn trap(message: str) -> str => f"pilot_trap({self.str_lit(message)})";
    pub fn int_lit(digits: str, p: IrTypePhysics) -> str? => digits;
    pub fn bool_lit(b: bool) -> str => py_bool(b);
    pub fn float_lit(text: str, p: IrTypePhysics) -> str? {
        if self.type_name(p) == none { return none; }
        if text == "NaN" { return "math.nan"; }
        if text == "inf" { return "math.inf"; }
        if text == "-inf" { return "-math.inf"; }
        return if p.bit_width == 32 { f"pilot_f32({text})" } else { text };
    }
    pub fn str_lit(raw: str) -> str => escaped(raw, (b) => "\\x" + hex2(b));
    pub fn binary(op: str, a: str, b: str, pa: IrTypePhysics, pb: IrTypePhysics, p: IrTypePhysics) -> str? {
        if is_float(p) {
            let e = if op == "add" { f"{a} + {b}" } else if op == "sub" { f"{a} - {b}" } else if op == "mul" { f"{a} * {b}" }
                else if op == "div" { f"pilot_fdiv({a}, {b})" } else if op == "rem" { f"pilot_frem({a}, {b})" } else { "" };
            if e == "" { return none; }
            return if p.bit_width == 32 { f"pilot_f32({e})" } else { f"({e})" };
        }
        if is_bool(p) {
            if op == "and" { return f"({a} & {b})"; }
            if op == "or" { return f"({a} | {b})"; }
            if op == "xor" { return f"({a} ^ {b})"; }
            return none;
        }
        if !is_int(p) {
            if op == "add" { return f"pilot_add({a}, {b})"; }
            let sym = operator_symbols().get(op);
            let helper = if op == "sub" || op == "mul" || op == "div" || op == "rem" { "pilot_arith" } else { "pilot_bits" };
            return f"{helper}('{sym}', {a}, {b})";
        }
        let w = f"{p.bit_width}, {py_bool(is_signed(p))}";
        if op == "div" { return f"pilot_div({a}, {b}, {w})"; }
        if op == "rem" { return f"pilot_rem({a}, {b}, {w})"; }
        let mask = p.bit_width - 1;
        let e = if op == "add" { f"{a} + {b}" } else if op == "sub" { f"{a} - {b}" } else if op == "mul" { f"{a} * {b}" }
            else if op == "and" { f"{a} & {b}" } else if op == "or" { f"{a} | {b}" } else if op == "xor" { f"{a} ^ {b}" }
            else if op == "shl" { f"{a} << ({b} & {mask})" } else if op == "shr" { f"{a} >> ({b} & {mask})" } else { "" };
        if e == "" { return none; }
        return f"pilot_wrap({e}, {w})";
    }
    pub fn compare(pred: i64, a: str, b: str, p: IrTypePhysics) -> str? {
        // `==` on values that are not numbers or booleans compares as the
        // seed does: lists element by element, other handles by identity.
        if pred <= 1 && !(is_int(p) || is_float(p) || is_bool(p)) {
            let neg = if pred == 1 { "not " } else { "" };
            return f"({neg}pilot_eq({a}, {b}))";
        }
        return f"({a} {cmp_symbol(pred)} {b})";
    }
    pub fn cast(v: str, from: IrTypePhysics, to: IrTypePhysics) -> str? {
        if !(is_int(from) || is_bool(from)) && !(is_float(from) && is_float(to)) {
            // The kind of `v` is checked at run time, as the seed does.
            let kind = if is_bool(to) { "bool" } else if is_float(to) { "float" } else { "int" };
            if !(is_bool(to) || is_float(to) || is_int(to)) || self.type_name(to) == none { return none; }
            return f"pilot_convert({v}, '{kind}', {to.bit_width}, {py_bool(is_signed(to))})";
        }
        if is_bool(to) { return if is_bool(from) { v } else { f"({v} != 0)" }; }
        if is_float(to) {
            if self.type_name(to) == none { return none; }
            return if to.bit_width == 32 { f"pilot_f32(float({v}))" } else { f"float({v})" };
        }
        if !is_int(to) { return none; }
        return f"pilot_wrap(int({v}), {to.bit_width}, {py_bool(is_signed(to))})";
    }
    pub fn call(name: str, args: List<str>) -> str => f"{name}({joined(args)})";
    pub fn intrinsic(name: str, args: List<str>, phys: List<IrTypePhysics>, literal: List<bool>, ret: IrTypePhysics) -> str? {
        var shown: List<str> = [];
        for a in args { shown.push(f"pilot_show({a})"); }
        let text = if shown.len() == 0 { "''" } else { "' '.join([" + joined(shown) + "])" };
        if name == "rt_print" { return f"print({text})"; }
        if name == "rt_eprint" { return f"print({text}, file=sys.stderr)"; }
        let ops = dynamic_engine_ops();
        if ops.has(name) {
            let helper = ops.get(name);
            return if helper == "" { "[]" } else if helper == "{}" { "{}" } else { f"{helper}({joined(args)})" };
        }
        return none;
    }
    pub fn call_value(fv: str, args: List<str>) -> str? {
        var all: List<str> = [];
        for x in args { all.push(x); }
        all.push(f"*{fv}[1:]");
        return f"pilot_fns[{fv}[0]](" + joined(all) + ")";
    }
    pub fn function_table(names: List<str>) -> List<str> => ["pilot_fns = [" + joined(names) + "]"];
    pub fn make_record(values: List<str>) -> str? => "[" + joined(values) + "]";
    pub fn get_field(rec: str, i: i64) -> str? => f"{rec}[{i}]";
    pub fn set_field(rec: str, i: i64, v: str) -> str? => f"{rec}[{i}] = {v}";
}

/// Engine operation -> the Python helper that runs it (`[]` / `{}` for a new
/// list or map).
fn dynamic_engine_ops() -> Map<str, str> {
    let ops = Map<str, str>();
    ops.set("list_new", "");
    ops.set("map_new", "{}");
    ops.set("is_null", "(lambda x: x is None)");
    ops.set("to_str", "pilot_show");
    ops.set("list_get", "pilot_map_get");
    ops.set("list_set", "pilot_map_set");
    for name in ["map_get", "map_set", "map_has", "map_remove", "list_push", "list_pop", "str_len", "num_pow", "rt_assert", "seam_open", "proc_args", "str_slice", "str_byte_at", "str_from_bytes", "list_extend", "list_remove_at", "stdin_read_line"] {
        ops.set(name, "pilot_" + name);
    }
    return ops;
}

pub fn python_dialect() -> ISourceDialect => PythonDialect {};

/// A Python boolean literal.
fn py_bool(b: bool) -> str => if b { "True" } else { "False" };
