// ==============================================================================
// FILE: selfhost/transpile/emit_csharp.pilot
// `pilot emit csharp`: PilIR as C# (selfhost/transpile/source.pilot).
// ==============================================================================
// The program is the static class `PilotProgram`: module variables are its
// static fields, functions its static methods. Integers are the C# integer
// of their width, with `unchecked` wrapping arithmetic as the seed's; shift
// counts are taken modulo the width; division and remainder stop the
// program on a zero divisor and wrap `MinValue / -1`. Booleans are `bool`,
// floats `double` / `float`. Strings appear only as literals passed to
// `print`; records stop at the representation seam. `print` shows values as
// the seed does.
pub lvl(0) pkg Pilot.SelfHost.Transpile.EmitCsharp;

use selfhost.ir.model.*;
use selfhost.transpile.source.*;

pub struct CsharpDialect : ISourceDialect {
    pub fn language() -> str => "C#";
    pub fn typed() -> bool => true;
    pub fn reserved() -> List<str> => [
        "abstract", "as", "base", "bool", "break", "byte", "case", "catch", "char", "checked", "class",
        "const", "continue", "decimal", "default", "delegate", "do", "double", "else", "enum", "event",
        "explicit", "extern", "false", "finally", "fixed", "float", "for", "foreach", "goto", "if",
        "implicit", "in", "int", "interface", "internal", "is", "lock", "long", "namespace", "new", "null",
        "object", "operator", "out", "override", "params", "private", "protected", "public", "readonly",
        "ref", "return", "sbyte", "sealed", "short", "sizeof", "stackalloc", "static", "string", "struct",
        "switch", "this", "throw", "true", "try", "typeof", "uint", "ulong", "unchecked", "unsafe", "ushort",
        "using", "virtual", "void", "volatile", "while", "Main", "PilotProgram", "System", "Console",
        "Environment",
    ];
    pub fn type_name(p: IrTypePhysics) -> str? {
        if is_bool(p) { return "bool"; }
        if is_float(p) {
            if p.bit_width == 64 { return "double"; }
            if p.bit_width == 32 { return "float"; }
            return none;
        }
        if is_int(p) {
            let signed = is_signed(p);
            if p.bit_width == 8 { return if signed { "sbyte" } else { "byte" }; }
            if p.bit_width == 16 { return if signed { "short" } else { "ushort" }; }
            if p.bit_width == 32 { return if signed { "int" } else { "uint" }; }
            if p.bit_width == 64 { return if signed { "long" } else { "ulong" }; }
            return none;
        }
        if p.layout_id == 0 { return "void"; }
        return none;
    }
    pub fn prelude() -> List<str> => ["using System;", "using System.Globalization;", ""];
    pub fn global_decl(name: str, p: IrTypePhysics) -> str? {
        guard some t = self.type_name(p) else { return none; };
        if t == "void" { return none; }
        return f"    static {t} {name} = {self.zero(p)};";
    }
    pub fn module_open(protos: List<str>) -> List<str> => [
        "public static class PilotProgram {",
        "    static void pilot_trap(string message) {",
        "        Console.Error.WriteLine(\"runtime error: \" + message);",
        "        Environment.Exit(1);",
        "    }",
        "    static long pilot_sdiv(long a, long b) {",
        "        if (b == 0) pilot_trap(\"integer division by zero\");",
        "        return b == -1 ? unchecked(-a) : a / b;",
        "    }",
        "    static long pilot_srem(long a, long b) {",
        "        if (b == 0) pilot_trap(\"integer division by zero\");",
        "        return b == -1 ? 0 : a % b;",
        "    }",
        "    static ulong pilot_udiv(ulong a, ulong b) {",
        "        if (b == 0) pilot_trap(\"integer division by zero\");",
        "        return a / b;",
        "    }",
        "    static ulong pilot_urem(ulong a, ulong b) {",
        "        if (b == 0) pilot_trap(\"integer division by zero\");",
        "        return a % b;",
        "    }",
        "    static string pilot_show(long x) { return x.ToString(CultureInfo.InvariantCulture); }",
        "    static string pilot_show(ulong x) { return x.ToString(CultureInfo.InvariantCulture); }",
        "    static string pilot_show(bool x) { return x ? \"true\" : \"false\"; }",
        "    static string pilot_show(string x) { return x; }",
        "    // The shortest digits that read back as x, written without an exponent.",
        "    static string pilot_show(double x) {",
        "        if (double.IsNaN(x)) return \"NaN\";",
        "        if (double.IsPositiveInfinity(x)) return \"inf\";",
        "        if (double.IsNegativeInfinity(x)) return \"-inf\";",
        "        if (x == 0) return 1 / x < 0 ? \"-0\" : \"0\";",
        "        string s = x.ToString(\"R\", CultureInfo.InvariantCulture);",
        "        int e = s.IndexOf('E');",
        "        if (e < 0) return s;",
        "        string mant = s.Substring(0, e);",
        "        int exp = int.Parse(s.Substring(e + 1), CultureInfo.InvariantCulture);",
        "        string sign = \"\";",
        "        if (mant.StartsWith(\"-\")) { sign = \"-\"; mant = mant.Substring(1); }",
        "        int dot = mant.IndexOf('.');",
        "        string ip = dot < 0 ? mant : mant.Substring(0, dot);",
        "        string fp = dot < 0 ? \"\" : mant.Substring(dot + 1);",
        "        string digits = ip + fp;",
        "        int ex = exp - fp.Length;",
        "        if (ex >= 0) return sign + digits + new string('0', ex);",
        "        int k = digits.Length + ex;",
        "        if (k > 0) return sign + digits.Substring(0, k) + \".\" + digits.Substring(k);",
        "        return sign + \"0.\" + new string('0', -k) + digits;",
        "    }",
        "",
    ];
    pub fn prototype(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str => "";
    pub fn module_close(entry: str, has_code: bool) -> List<str> {
        if entry == "" { return ["}"]; }
        let body = if has_code { f"Environment.Exit((int){entry}());" } else { f"{entry}();" };
        return ["    public static void Main() " + "{ " + body + " }", "}"];
    }
    pub fn fn_open(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str {
        var ps: List<str> = [];
        var i = 0;
        while i < params.len() {
            if phys[i].layout_id != 0 { ps.push(f"{self.cs_type(phys[i])} {params[i]}"); }
            i = i + 1;
        }
        return f"public static {self.cs_type(ret)} {name}({joined(ps)}) " + "{";
    }
    pub fn fn_close() -> str => "}";
    pub fn fn_globals(globals: List<str>) -> List<str> => [];
    pub fn param_prologue(name: str, p: IrTypePhysics) -> List<str> => [];
    pub fn locals(names: List<str>, phys: List<IrTypePhysics>) -> List<str> {
        var out: List<str> = [];
        var i = 0;
        while i < names.len() {
            out.push(f"{self.cs_type(phys[i])} {names[i]} = {self.zero(phys[i])};");
            i = i + 1;
        }
        return out;
    }
    pub fn zero(p: IrTypePhysics) -> str => if is_bool(p) { "false" } else if is_float(p) { if p.bit_width == 32 { "0.0f" } else { "0.0" } } else { "0" };
    pub fn unit_value() -> str? => none;
    pub fn state_decl(name: str) -> str => f"int {name} = 0;";
    pub fn dispatch_open() -> str => "for (;;) {";
    pub fn dispatch_close() -> str => "}";
    pub fn case_open(state: str, b: i64, first: bool) -> str => (if first { "" } else { "} else " }) + f"if ({state} == {b}) " + "{";
    pub fn cases_close() -> str => "}";
    pub fn if_open(cond: str) -> str => f"if ({cond}) " + "{";
    pub fn else_line() -> str => "} else {";
    pub fn if_close() -> str => "}";
    pub fn assign(lhs: str, rhs: str) -> str => f"{lhs} = {rhs};";
    pub fn parallel_assign(lhs: List<str>, rhs: List<str>, phys: List<IrTypePhysics>) -> List<str> {
        var text = "{ ";
        var i = 0;
        while i < lhs.len() {
            text = text + f"{self.cs_type(phys[i])} t{i} = {rhs[i]}; ";
            i = i + 1;
        }
        i = 0;
        while i < lhs.len() {
            text = text + f"{lhs[i]} = t{i}; ";
            i = i + 1;
        }
        return [text + "}"];
    }
    pub fn expr_stmt(e: str) -> str => e + ";";
    pub fn ret(e: str) -> str => if e == "" { "return;" } else { f"return {e};" };
    pub fn trap(message: str) -> str => f"pilot_trap({self.str_lit(message)});";
    pub fn int_lit(digits: str, p: IrTypePhysics) -> str? {
        guard some t = self.type_name(p) else { return none; };
        if p.bit_width == 64 { return if is_signed(p) { f"({digits}L)" } else { f"({digits}UL)" }; }
        return f"unchecked(({t}){digits})";
    }
    pub fn bool_lit(b: bool) -> str => if b { "true" } else { "false" };
    pub fn float_lit(text: str, p: IrTypePhysics) -> str? {
        guard some t = self.type_name(p) else { return none; };
        if text == "NaN" { return f"{t}.NaN"; }
        if text == "inf" { return f"{t}.PositiveInfinity"; }
        if text == "-inf" { return f"{t}.NegativeInfinity"; }
        return if p.bit_width == 32 { f"({text}f)" } else { f"({text})" };
    }
    pub fn str_lit(raw: str) -> str => escaped(raw, (b) => "\\u00" + hex2(b));
    pub fn binary(op: str, a: str, b: str, pa: IrTypePhysics, pb: IrTypePhysics, p: IrTypePhysics) -> str? {
        if is_float(p) {
            if op == "add" { return f"({a} + {b})"; }
            if op == "sub" { return f"({a} - {b})"; }
            if op == "mul" { return f"({a} * {b})"; }
            if op == "div" { return f"({a} / {b})"; }
            if op == "rem" { return f"({a} % {b})"; }
            return none;
        }
        if is_bool(p) {
            if op == "and" { return f"({a} & {b})"; }
            if op == "or" { return f"({a} | {b})"; }
            if op == "xor" { return f"({a} ^ {b})"; }
            return none;
        }
        guard some t = self.type_name(p) else { return none; };
        if !is_int(p) { return none; }
        let mask = p.bit_width - 1;
        if op == "add" { return f"unchecked(({t})({a} + {b}))"; }
        if op == "sub" { return f"unchecked(({t})({a} - {b}))"; }
        if op == "mul" { return f"unchecked(({t})({a} * {b}))"; }
        if op == "and" { return f"unchecked(({t})({a} & {b}))"; }
        if op == "or" { return f"unchecked(({t})({a} | {b}))"; }
        if op == "xor" { return f"unchecked(({t})({a} ^ {b}))"; }
        if op == "shl" { return f"unchecked(({t})({a} << (int)({b} & {mask})))"; }
        if op == "shr" { return f"unchecked(({t})({a} >> (int)({b} & {mask})))"; }
        let s = if is_signed(p) { "s" } else { "u" };
        if op == "div" { return f"unchecked(({t})pilot_{s}div({a}, {b}))"; }
        if op == "rem" { return f"unchecked(({t})pilot_{s}rem({a}, {b}))"; }
        return none;
    }
    pub fn compare_op(pred: i64, a: str, b: str, p: IrTypePhysics) -> str? => f"({a} {cmp_symbol(pred)} {b})";
    pub fn cast(v: str, from: IrTypePhysics, to: IrTypePhysics) -> str? {
        guard some t = self.type_name(to) else { return none; };
        if self.type_name(from) == none { return none; }
        if is_bool(to) { return if is_bool(from) { v } else { f"({v} != 0)" }; }
        if is_bool(from) { return f"({v} ? ({t})1 : ({t})0)"; }
        return f"unchecked(({t})({v}))";
    }
    pub fn call(name: str, args: List<str>) -> str => f"{name}({joined(args)})";
    pub fn intrinsic(name: str, args: List<str>, phys: List<IrTypePhysics>, literal: List<bool>) -> str? {
        let stream = if name == "rt_print" { "Console.Out" } else if name == "rt_eprint" { "Console.Error" } else { "" };
        if stream == "" { return none; }
        var shown: List<str> = [];
        var i = 0;
        while i < args.len() {
            if !literal[i] && self.type_name(phys[i]) == none { return none; }
            shown.push(f"pilot_show({args[i]})");
            i = i + 1;
        }
        return f"{stream}.WriteLine(string.Join(\" \", new string[] " + "{ " + joined(shown) + " }))";
    }
    pub fn make_record(values: List<str>) -> str? => none;
    pub fn get_field(rec: str, i: i64) -> str? => none;
    pub fn set_field(rec: str, i: i64, v: str) -> str? => none;

    /// The C# type of `p`; `void` when it has none (the caller checked).
    pub fn cs_type(p: IrTypePhysics) -> str => self.type_name(p) ?? "void";
}

pub fn csharp_dialect() -> ISourceDialect => CsharpDialect {};
