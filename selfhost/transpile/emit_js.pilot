// ==============================================================================
// FILE: selfhost/transpile/emit_js.pilot
// `pilot emit js`: PilIR as JavaScript for Node (selfhost/transpile/source.pilot).
// ==============================================================================
// Integers are `BigInt`s wrapped to their register width (`BigInt.asIntN` /
// `asUintN`), so 64-bit arithmetic is exact; a function converts integer
// arguments it is given as plain numbers. `/` and `%` on integers truncate
// toward zero, as `BigInt`'s do and the seed's do. Floats are numbers
// (`Math.fround` keeps a 32-bit float). Records are arrays. `print` shows
// values as the seed does.
pub lvl(0) pkg Pilot.SelfHost.Transpile.EmitJs;

use selfhost.ir.model.*;
use selfhost.transpile.source.*;

pub struct JsDialect : ISourceDialect {
    pub fn language() -> str => "JavaScript";
    pub fn typed() -> bool => false;
    pub fn reserved() -> List<str> => [
        "break", "case", "catch", "class", "const", "continue", "debugger", "default", "delete", "do",
        "else", "enum", "export", "extends", "false", "finally", "for", "function", "if", "import", "in",
        "instanceof", "let", "new", "null", "return", "super", "switch", "this", "throw", "true", "try",
        "typeof", "var", "void", "while", "with", "yield", "await", "static", "implements", "interface",
        "package", "private", "protected", "public", "arguments", "eval", "undefined", "NaN", "Infinity",
        "process", "console", "BigInt", "Math", "Number", "String", "Object",
    ];
    pub fn type_name(p: IrTypePhysics) -> str? {
        if p.reg_class == reg_class_simd_vector() { return none; }
        return "";
    }
    pub fn prelude() -> List<str> => [
        "\"use strict\";",
        "function pilot_trap(message) {",
        "    process.stderr.write(\"runtime error: \" + message + \"\\n\");",
        "    process.exit(1);",
        "}",
        "function pilot_div(a, b) {",
        "    if (b === 0n) pilot_trap(\"integer division by zero\");",
        "    return a / b;",
        "}",
        "function pilot_rem(a, b) {",
        "    if (b === 0n) pilot_trap(\"integer division by zero\");",
        "    return a % b;",
        "}",
        "function pilot_show(x) {",
        "    if (typeof x === \"number\") {",
        "        if (Number.isNaN(x)) return \"NaN\";",
        "        if (!Number.isFinite(x)) return x > 0 ? \"inf\" : \"-inf\";",
        "        if (Object.is(x, -0)) return \"-0\";",
        "        const s = String(x);",
        "        const m = s.match(/^(-?)(\\d+)(?:\\.(\\d+))?e([+-]\\d+)$/);",
        "        if (!m) return s;",
        "        const frac = m[3] || \"\";",
        "        const digits = m[2] + frac;",
        "        const exp = parseInt(m[4], 10) - frac.length;",
        "        if (exp >= 0) return m[1] + digits + \"0\".repeat(exp);",
        "        const k = digits.length + exp;",
        "        if (k > 0) return m[1] + digits.slice(0, k) + \".\" + digits.slice(k);",
        "        return m[1] + \"0.\" + \"0\".repeat(-k) + digits;",
        "    }",
        "    if (x === null || x === undefined) return \"null\";",
        "    if (Array.isArray(x)) return \"[\" + x.map(pilot_show).join(\", \") + \"]\";",
        "    if (x instanceof Map) return \"{ \" + [...x].map(([k, v]) => k + \": \" + pilot_show(v)).sort().join(\", \") + \" }\";",
        "    return String(x);",
        "}",
        "function pilot_add(a, b) {",
        "    if (typeof a === \"string\" || typeof b === \"string\") return pilot_show(a) + pilot_show(b);",
        "    return pilot_arith(\"+\", a, b);",
        "}",
        "const pilot_unset = Symbol(\"unset\");",
        "function pilot_unset_read(message) {",
        "    pilot_trap(message);",
        "}",
        "function pilot_truth(v) {",
        "    if (typeof v !== \"boolean\") pilot_trap(\"condition must be a boolean, found \" + pilot_kind(v));",
        "    return v;",
        "}",
        "function pilot_convert(v, kind, bits, signed) {",
        "    if (kind === \"int\" && bits >= 64 && (Array.isArray(v) || v instanceof Map || typeof v === \"function\")) return v;",
        "    let n;",
        "    if (typeof v === \"boolean\") n = v ? 1n : 0n;",
        "    else if (pilot_is_num(v)) n = v;",
        "    else pilot_trap(\"cannot convert \" + pilot_kind(v) + \" to a number\");",
        "    if (kind === \"bool\") return Number(n) !== 0;",
        "    if (kind === \"float\") return bits === 32 ? Math.fround(Number(n)) : Number(n);",
        "    if (typeof n === \"number\") {",
        "        const t = Math.trunc(n);",
        "        if (!Number.isFinite(n) || t < -9223372036854775808 || t >= (signed ? 9223372036854775808 : 18446744073709551616)) {",
        "            pilot_trap(pilot_show(n) + \" does not fit an integer\");",
        "        }",
        "        n = BigInt(t);",
        "    }",
        "    return signed ? BigInt.asIntN(bits, n) : BigInt.asUintN(bits, n);",
        "}",
        "function pilot_proc_args() {",
        "    return process.argv.slice(2);",
        "}",
        "function pilot_is_num(x) {",
        "    return typeof x === \"bigint\" || typeof x === \"number\";",
        "}",
        "function pilot_type_error(sym, a, b) {",
        "    pilot_trap(\"cannot apply `\" + sym + \"` to \" + pilot_kind(a) + \" and \" + pilot_kind(b));",
        "}",
        "function pilot_arith(sym, a, b) {",
        "    if (!(pilot_is_num(a) && pilot_is_num(b))) pilot_type_error(sym, a, b);",
        "    if (typeof a === \"bigint\" && typeof b === \"bigint\") {",
        "        if (sym === \"/\") return BigInt.asIntN(64, pilot_div(a, b));",
        "        if (sym === \"%\") return pilot_rem(a, b);",
        "        return BigInt.asIntN(64, sym === \"+\" ? a + b : sym === \"-\" ? a - b : a * b);",
        "    }",
        "    const x = Number(a);",
        "    const y = Number(b);",
        "    if (sym === \"+\") return x + y;",
        "    if (sym === \"-\") return x - y;",
        "    if (sym === \"*\") return x * y;",
        "    if (sym === \"%\") return x % y;",
        "    return x / y;",
        "}",
        "function pilot_bits(sym, a, b) {",
        "    if (typeof a === \"boolean\" && typeof b === \"boolean\" && (sym === \"&\" || sym === \"|\" || sym === \"^\")) {",
        "        return sym === \"&\" ? a && b : sym === \"|\" ? a || b : a !== b;",
        "    }",
        "    if (typeof a !== \"bigint\" || typeof b !== \"bigint\") pilot_type_error(sym, a, b);",
        "    const n = b & 63n;",
        "    const r = sym === \"&\" ? a & b : sym === \"|\" ? a | b : sym === \"^\" ? a ^ b : sym === \"<<\" ? a << n : a >> n;",
        "    return BigInt.asIntN(64, r);",
        "}",
        "function pilot_str_byte_at(s, i) {",
        "    const raw = Buffer.from(s, \"utf8\");",
        "    if (i >= 0n && i < BigInt(raw.length)) return BigInt(raw[Number(i)]);",
        "    pilot_trap(\"byte index \" + i + \" out of bounds for length \" + raw.length);",
        "}",
        "function pilot_eq(a, b) {",
        "    if (Array.isArray(a) && Array.isArray(b)) {",
        "        return a === b || (a.length === b.length && a.every((x, i) => pilot_eq(x, b[i])));",
        "    }",
        "    const na = typeof a === \"bigint\" || typeof a === \"number\";",
        "    const nb = typeof b === \"bigint\" || typeof b === \"number\";",
        "    if (na && nb) return typeof a === typeof b ? a === b : Number(a) === Number(b);",
        "    if ((a === null || a === undefined) && (b === null || b === undefined)) return true;",
        "    return a === b;",
        "}",
        "function pilot_boundary(b, at) {",
        "    let u = Math.min(Math.max(Number(at), 0), b.length);",
        "    while (u < b.length && (b[u] & 0xC0) === 0x80) u++;",
        "    return u;",
        "}",
        "function pilot_str_slice(v, a, b) {",
        "    if (Array.isArray(v)) {",
        "        const n = v.length;",
        "        const x = Math.min(Math.max(Number(a), 0), n);",
        "        const y = Math.min(Math.max(Number(b), 0), n);",
        "        return v.slice(x, Math.max(x, y));",
        "    }",
        "    const raw = Buffer.from(v, \"utf8\");",
        "    const x = pilot_boundary(raw, a);",
        "    const y = pilot_boundary(raw, b);",
        "    return raw.subarray(x, Math.max(x, y)).toString(\"utf8\");",
        "}",
        "function pilot_leaves(v, deep, out) {",
        "    for (const e of v) {",
        "        if (deep && Array.isArray(e)) pilot_leaves(e, true, out);",
        "        else out.push(e);",
        "    }",
        "}",
        "function pilot_list_extend(l, other, deep) {",
        "    const leaves = [];",
        "    pilot_leaves(other, deep === true, leaves);",
        "    l.push(...leaves);",
        "    return l;",
        "}",
        "function pilot_list_remove_at(l, i) {",
        "    return l.splice(pilot_index(l, i), 1)[0];",
        "}",
        "let pilot_stdin = null;",
        "function pilot_stdin_read_line() {",
        "    if (pilot_stdin === null) {",
        "        let text = \"\";",
        "        try { text = require(\"fs\").readFileSync(0, \"utf8\"); } catch (e) { text = \"\"; }",
        "        pilot_stdin = { text: text, at: 0 };",
        "    }",
        "    const s = pilot_stdin;",
        "    if (s.at >= s.text.length) return null;",
        "    let end = s.text.indexOf(\"\\n\", s.at);",
        "    let line;",
        "    if (end < 0) { line = s.text.slice(s.at); s.at = s.text.length; }",
        "    else { line = s.text.slice(s.at, end); s.at = end + 1; }",
        "    return line.endsWith(\"\\r\") ? line.slice(0, -1) : line;",
        "}",
        "function pilot_kind(x) {",
        "    if (x === null || x === undefined) return \"null\";",
        "    if (typeof x === \"boolean\") return \"boolean\";",
        "    if (typeof x === \"bigint\") return \"integer\";",
        "    if (typeof x === \"number\") return \"float\";",
        "    if (typeof x === \"string\") return \"string\";",
        "    if (Array.isArray(x)) return \"list\";",
        "    if (x instanceof Map) return \"record\";",
        "    return \"function\";",
        "}",
        "function pilot_key(k) {",
        "    return typeof k === \"string\" ? k : pilot_show(k);",
        "}",
        "function pilot_index(o, k) {",
        "    if (typeof k !== \"bigint\") pilot_trap(\"list index must be an integer, found \" + pilot_kind(k));",
        "    if (k < 0n || k >= BigInt(o.length)) pilot_trap(\"list index \" + k + \" out of bounds for length \" + o.length);",
        "    return Number(k);",
        "}",
        "function pilot_map_get(o, k) {",
        "    if (Array.isArray(o)) return o[pilot_index(o, k)];",
        "    if (typeof o === \"string\" && typeof k === \"bigint\") {",
        "        const b = Buffer.from(o, \"utf8\");",
        "        if (k >= 0n && k < BigInt(b.length)) return BigInt(b[Number(k)]);",
        "        pilot_trap(\"string index \" + k + \" out of bounds for length \" + b.length);",
        "    }",
        "    if (o instanceof Map) {",
        "        const v = o.get(pilot_key(k));",
        "        return v === undefined ? null : v;",
        "    }",
        "    pilot_trap(\"cannot read `\" + pilot_key(k) + \"` from \" + pilot_kind(o));",
        "}",
        "function pilot_map_set(o, k, v) {",
        "    if (Array.isArray(o)) { o[pilot_index(o, k)] = v; return o; }",
        "    if (o instanceof Map) { o.set(pilot_key(k), v); return o; }",
        "    pilot_trap(\"cannot write `\" + pilot_key(k) + \"` on \" + pilot_kind(o));",
        "}",
        "function pilot_map_has(m, k) {",
        "    return m.has(pilot_key(k));",
        "}",
        "function pilot_map_remove(m, k) {",
        "    const key = pilot_key(k);",
        "    const v = m.has(key) ? m.get(key) : null;",
        "    m.delete(key);",
        "    return v;",
        "}",
        "function pilot_list_push(l, x) {",
        "    l.push(x);",
        "    return l;",
        "}",
        "function pilot_list_pop(l) {",
        "    if (l.length === 0) pilot_trap(\"pop from an empty list\");",
        "    return l.pop();",
        "}",
        "function pilot_str_len(x) {",
        "    if (typeof x === \"string\") return BigInt(Buffer.byteLength(x, \"utf8\"));",
        "    return BigInt(x instanceof Map ? x.size : x.length);",
        "}",
        "function pilot_num_pow(a, b) {",
        "    if (typeof a === \"bigint\" && typeof b === \"bigint\") {",
        "        if (b < 0n) return Math.pow(Number(a), Number(b));",
        "        return BigInt.asIntN(64, a ** b);",
        "    }",
        "    return Math.pow(Number(a), Number(b));",
        "}",
        "function pilot_rt_assert(cond, note) {",
        "    if (cond !== true) pilot_trap(\"assertion failed\" + (note === undefined ? \"\" : \": \" + pilot_show(note)));",
        "}",
        "function pilot_seam_open(id, note) {",
        "    pilot_trap(\"SEAM001: unconnected seam `\" + id + \"`: \" + (note === undefined ? \"\" : pilot_show(note)));",
        "}",
        "",
    ];
    pub fn global_decl(name: str, p: IrTypePhysics) -> str? => f"let {name} = pilot_unset;";
    pub fn global_read(name: str, message: str) -> str => f"({name} !== pilot_unset ? {name} : pilot_unset_read({message}))";
    pub fn global_write(name: str, v: str) -> str => f"{name} = {v};";
    pub fn truth(v: str) -> str? => f"pilot_truth({v})";
    pub fn module_open(protos: List<str>) -> List<str> => [];
    pub fn prototype(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str => "";
    pub fn module_close(entry: str, has_code: bool) -> List<str> {
        if entry == "" { return []; }
        if has_code { return [f"process.exitCode = Number({entry}());"]; }
        return [f"{entry}();"];
    }
    pub fn fn_open(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str =>
        f"function {name}({joined(params)}) " + "{";
    pub fn fn_close() -> str => "}";
    pub fn fn_globals(globals: List<str>) -> List<str> => [];
    pub fn param_prologue(name: str, p: IrTypePhysics) -> List<str> {
        if !is_int(p) { return []; }
        return [f"{name} = {wrap_fn(p)}({p.bit_width}, BigInt({name}));"];
    }
    pub fn locals(names: List<str>, phys: List<IrTypePhysics>) -> List<str> => if names.len() == 0 { [] } else { ["let " + joined(names) + ";"] };
    pub fn zero(p: IrTypePhysics) -> str => if is_bool(p) { "false" } else if is_float(p) { "0" } else if is_int(p) { "0n" } else { "undefined" };
    pub fn unit_value() -> str? => "undefined";
    pub fn state_decl(name: str) -> str => f"let {name} = 0;";
    pub fn dispatch_open() -> str => "for (;;) {";
    pub fn dispatch_close() -> str => "}";
    pub fn case_open(state: str, b: i64, first: bool) -> str => (if first { "" } else { "} else " }) + f"if ({state} === {b}) " + "{";
    pub fn cases_close() -> str => "}";
    pub fn if_open(cond: str) -> str => f"if ({cond}) " + "{";
    pub fn else_line() -> str => "} else {";
    pub fn if_close() -> str => "}";
    pub fn assign(lhs: str, rhs: str) -> str => f"{lhs} = {rhs};";
    pub fn parallel_assign(lhs: List<str>, rhs: List<str>, phys: List<IrTypePhysics>) -> List<str> => ["[" + joined(lhs) + "] = [" + joined(rhs) + "];"];
    pub fn expr_stmt(e: str) -> str => e + ";";
    pub fn ret(e: str) -> str => if e == "" { "return;" } else { f"return {e};" };
    pub fn trap(message: str) -> str => f"pilot_trap({self.str_lit(message)});";
    pub fn int_lit(digits: str, p: IrTypePhysics) -> str? => digits + "n";
    pub fn bool_lit(b: bool) -> str => if b { "true" } else { "false" };
    pub fn float_lit(text: str, p: IrTypePhysics) -> str? {
        if text == "NaN" { return "NaN"; }
        if text == "inf" { return "Infinity"; }
        if text == "-inf" { return "-Infinity"; }
        return if p.bit_width == 32 { f"Math.fround({text})" } else { text };
    }
    pub fn str_lit(raw: str) -> str => escaped(raw, (b) => "\\x" + hex2(b));
    pub fn binary(op: str, a: str, b: str, pa: IrTypePhysics, pb: IrTypePhysics, p: IrTypePhysics) -> str? {
        if is_float(p) {
            let e = if op == "add" { f"{a} + {b}" } else if op == "sub" { f"{a} - {b}" } else if op == "mul" { f"{a} * {b}" }
                else if op == "div" { f"{a} / {b}" } else if op == "rem" { f"{a} % {b}" } else { "" };
            if e == "" { return none; }
            return if p.bit_width == 32 { f"Math.fround({e})" } else { f"({e})" };
        }
        if is_bool(p) {
            if op == "and" { return f"({a} && {b})"; }
            if op == "or" { return f"({a} || {b})"; }
            if op == "xor" { return f"({a} !== {b})"; }
            return none;
        }
        if !is_int(p) {
            if op == "add" { return f"pilot_add({a}, {b})"; }
            let sym = operator_symbols().get(op);
            let helper = if op == "sub" || op == "mul" || op == "div" || op == "rem" { "pilot_arith" } else { "pilot_bits" };
            return f"{helper}(\"{sym}\", {a}, {b})";
        }
        let mask = p.bit_width - 1;
        let e = if op == "add" { f"{a} + {b}" } else if op == "sub" { f"{a} - {b}" } else if op == "mul" { f"{a} * {b}" }
            else if op == "div" { f"pilot_div({a}, {b})" } else if op == "rem" { f"pilot_rem({a}, {b})" }
            else if op == "and" { f"{a} & {b}" } else if op == "or" { f"{a} | {b}" } else if op == "xor" { f"{a} ^ {b}" }
            else if op == "shl" { f"{a} << ({b} & {mask}n)" } else if op == "shr" { f"{a} >> ({b} & {mask}n)" } else { "" };
        if e == "" { return none; }
        return f"{wrap_fn(p)}({p.bit_width}, {e})";
    }
    pub fn compare_op(pred: i64, a: str, b: str, p: IrTypePhysics) -> str? {
        // `==` on values that are not numbers or booleans compares as the
        // seed does: lists element by element, other handles by identity.
        if pred <= 1 && !(is_int(p) || is_float(p) || is_bool(p)) {
            let neg = if pred == 1 { "!" } else { "" };
            return f"({neg}pilot_eq({a}, {b}))";
        }
        return f"({a} {js_cmp(pred)} {b})";
    }
    pub fn cast(v: str, from: IrTypePhysics, to: IrTypePhysics) -> str? {
        if !(is_int(from) || is_bool(from)) && !(is_float(from) && is_float(to)) {
            // The kind of `v` is checked at run time, as the seed does.
            if !(is_bool(to) || is_float(to) || is_int(to)) { return none; }
            let kind = if is_bool(to) { "bool" } else if is_float(to) { "float" } else { "int" };
            return f"pilot_convert({v}, \"{kind}\", {to.bit_width}, {is_signed(to)})";
        }
        if is_bool(to) {
            if is_bool(from) { return v; }
            return if is_int(from) { f"({v} !== 0n)" } else { f"({v} !== 0)" };
        }
        if is_float(to) {
            let n = if is_int(from) { f"Number({v})" } else if is_bool(from) { f"({v} ? 1 : 0)" } else { v };
            return if to.bit_width == 32 { f"Math.fround({n})" } else { n };
        }
        if !is_int(to) { return none; }
        let n = if is_int(from) { v } else if is_bool(from) { f"({v} ? 1n : 0n)" } else { f"BigInt(Math.trunc({v}))" };
        return f"{wrap_fn(to)}({to.bit_width}, {n})";
    }
    pub fn call(name: str, args: List<str>) -> str => f"{name}({joined(args)})";
    pub fn intrinsic(name: str, args: List<str>, phys: List<IrTypePhysics>, literal: List<bool>, ret: IrTypePhysics) -> str? {
        let text = "[" + joined(args) + "].map(pilot_show).join(\" \")";
        if name == "rt_print" { return f"console.log({text})"; }
        if name == "rt_eprint" { return f"console.error({text})"; }
        if name == "list_new" { return "[]"; }
        if name == "map_new" { return "new Map()"; }
        if name == "is_null" { return f"({args[0]} === null || {args[0]} === undefined)"; }
        if name == "to_str" { return f"pilot_show({args[0]})"; }
        if name == "list_get" { return f"pilot_map_get({joined(args)})"; }
        if name == "list_set" { return f"pilot_map_set({joined(args)})"; }
        for helper in ["map_get", "map_set", "map_has", "map_remove", "list_push", "list_pop", "str_len", "num_pow", "rt_assert", "seam_open", "proc_args", "str_slice", "str_byte_at", "list_extend", "list_remove_at", "stdin_read_line"] {
            if name == helper { return f"pilot_{helper}({joined(args)})"; }
        }
        return none;
    }
    pub fn call_value(fv: str, args: List<str>) -> str? {
        var all: List<str> = [];
        for x in args { all.push(x); }
        all.push(f"...{fv}.slice(1)");
        return f"pilot_fns[Number({fv}[0])](" + joined(all) + ")";
    }
    pub fn function_table(names: List<str>) -> List<str> => ["const pilot_fns = [" + joined(names) + "];"];
    pub fn make_record(values: List<str>) -> str? => "[" + joined(values) + "]";
    pub fn get_field(rec: str, i: i64) -> str? => f"{rec}[{i}]";
    pub fn set_field(rec: str, i: i64, v: str) -> str? => f"{rec}[{i}] = {v};";
}

pub fn js_dialect() -> ISourceDialect => JsDialect {};

/// The JavaScript operator of comparison predicate `pred`.
fn js_cmp(pred: i64) -> str => ["===", "!==", "<", "<=", ">", ">="][pred];

/// The `BigInt` function that wraps a value to integer physics `p`.
fn wrap_fn(p: IrTypePhysics) -> str => if is_signed(p) { "BigInt.asIntN" } else { "BigInt.asUintN" };
