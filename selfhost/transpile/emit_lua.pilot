// ============================================================================
// FILE: selfhost/transpile/emit_lua.pilot
// Milestone 57.2: Modular Lua 5.4 Source Emitter (`pilot --emit lua`)
// Emits clean Lua 5.4 modules and functions from Name-Blind Transpile IR.
// ============================================================================

pub pure fn emit_lua_function_source(
    fn_name: str,
    params_list: str,
    body_expr: str
) -> str {
    return "local function " + fn_name + "(" + params_list + ")\n"
        + "  " + nameof(return) + " " + body_expr + "\n"
        + "end\n";
}

pub fn tlua_emit_expr(nid: i64) -> str {
    if nid < 0 { return "0"; }
    let k = __engine("ast_node_kind", nid);
    let ok = __engine("ast_orig_kind", nid);

    if k == 14 {
        return __engine("sym_str", __engine("ast_node_sym", nid));
    }
    if k == 15 {
        let lk = __engine("ast_node_lit_kind", nid);
        if lk == 1 {
            return "" + __engine("ast_node_raw_bits", nid);
        }
        if lk == 2 {
            return __engine("source_slice", __engine("ast_span_start", nid), __engine("ast_span_end", nid));
        }
        if lk == 3 {
            return tir_escape_str_lit(__engine("sym_str", __engine("ast_node_sym", nid)));
        }
        if lk == 4 {
            if __engine("ast_node_raw_bits", nid) != 0 { return "true"; }
            return "false";
        }
        return "0";
    }
    if ok == 206 {
        let inner = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let fl = __engine("ast_node_flags", nid);
        if fl == 5 { return "(not " + inner + ")"; }
        if fl == 4 { return "(~" + inner + ")"; }
        return "(-" + inner + ")";
    }
    if k == 19 {
        let op = __engine("ast_node_raw_bits", nid);
        let lhs = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let rhs = tlua_emit_expr(__engine("ast_child_at", nid, 1));
        if op == 4 { return "(" + lhs + " // " + rhs + ")"; }
        if op == 9 { return "(" + lhs + " ~= " + rhs + ")"; }
        if op == 14 { return "(" + lhs + " and " + rhs + ")"; }
        if op == 15 { return "(" + lhs + " or " + rhs + ")"; }
        if op == 18 { return "(" + lhs + " ~ " + rhs + ")"; }
        return "(" + lhs + " " + tir_binop_sym(op) + " " + rhs + ")";
    }
    if k == 16 {
        let cc = __engine("ast_child_count", nid);
        if cc <= 0 { return "0"; }
        let callee_nid = __engine("ast_child_at", nid, 0);
        let cname = __engine("sym_str", __engine("ast_node_sym", callee_nid));
        if tir_is_struct_literal_call(nid) {
            let map_nid = __engine("ast_child_at", nid, 1);
            let mcc = __engine("ast_child_count", map_nid);
            var fields_s = "";
            var mi = 0;
            while mi + 1 < mcc {
                let k_nid = __engine("ast_child_at", map_nid, mi);
                let v_nid = __engine("ast_child_at", map_nid, mi + 1);
                let fname = __engine("sym_str", __engine("ast_node_sym", k_nid));
                if fields_s.len() > 0 {
                    fields_s = fields_s + ", ";
                }
                fields_s = fields_s + fname + " = " + tlua_emit_expr(v_nid);
                mi = mi + 2;
            }
            return "{ " + fields_s + " }";
        }
        var args_s = "";
        var ai = 1;
        while ai < cc {
            if ai > 1 { args_s = args_s + ", "; }
            args_s = args_s + tlua_emit_expr(__engine("ast_child_at", nid, ai));
            ai = ai + 1;
        }
        return cname + "(" + args_s + ")";
    }
    if k == 17 {
        let recv = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let fld = __engine("sym_str", __engine("ast_node_sym", nid));
        return recv + "." + fld;
    }
    if ok == 210 {
        let base_e = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let idx_e = tlua_emit_expr(__engine("ast_child_at", nid, 1));
        return base_e + "[(" + idx_e + ") + 1]";
    }
    return "0";
}

pub fn tlua_emit_block_body(blk_nid: i64, depth: i64) -> str {
    if blk_nid < 0 { return ""; }
    if __engine("ast_node_kind", blk_nid) != 18 {
        return tlua_emit_stmt(blk_nid, depth);
    }
    let cc = __engine("ast_child_count", blk_nid);
    var out = "";
    var i = 0;
    while i < cc {
        out = out + tlua_emit_stmt(__engine("ast_child_at", blk_nid, i), depth);
        i = i + 1;
    }
    return out;
}

pub fn tlua_emit_stmt(nid: i64, depth: i64) -> str {
    if nid < 0 { return ""; }
    let k = __engine("ast_node_kind", nid);
    let ok = __engine("ast_orig_kind", nid);
    let ind = tir_indent_spaces(depth);

    if k == 18 {
        return tlua_emit_block_body(nid, depth);
    }
    if k == 4 {
        let vname = __engine("sym_str", __engine("ast_node_sym", nid));
        let init_s = if __engine("ast_child_count", nid) > 0 {
            tlua_emit_expr(__engine("ast_child_at", nid, 0))
        } else {
            "0"
        };
        return ind + "local " + vname + " = " + init_s + "\n";
    }
    if k == 20 {
        let lhs = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let rhs = tlua_emit_expr(__engine("ast_child_at", nid, 1));
        return ind + lhs + " = " + rhs + "\n";
    }
    if k == 6 {
        let cond_s = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let then_s = tlua_emit_block_body(__engine("ast_child_at", nid, 1), depth + 1);
        var res = ind + "if " + cond_s + " then\n" + then_s;
        if __engine("ast_child_count", nid) >= 3 {
            let else_s = tlua_emit_block_body(__engine("ast_child_at", nid, 2), depth + 1);
            res = res + ind + "else\n" + else_s;
        }
        return res + ind + "end\n";
    }
    if k == 7 || ok == 106 {
        if ok == 105 {
            let lbody = tlua_emit_block_body(__engine("ast_child_at", nid, 0), depth + 1);
            return ind + "while true do\n" + lbody + ind + "end\n";
        }
        let wcond = tlua_emit_expr(__engine("ast_child_at", nid, 0));
        let wbody = tlua_emit_block_body(__engine("ast_child_at", nid, 1), depth + 1);
        return ind + "while " + wcond + " do\n" + wbody + ind + "end\n";
    }
    if ok == 107 { return ind + "break\n"; }
    if k == 8 {
        if __engine("ast_child_count", nid) > 0 {
            return ind + "return " + tlua_emit_expr(__engine("ast_child_at", nid, 0)) + "\n";
        }
        return ind + "return\n";
    }
    if ok == 110 {
        if __engine("ast_child_count", nid) > 0 {
            return ind + tlua_emit_expr(__engine("ast_child_at", nid, 0)) + "\n";
        }
        return "";
    }
    return ind + tlua_emit_expr(nid) + "\n";
}

pub fn transpile_arena_to_lua() -> str {
    let prog = tir_target_prog_nid();
    if prog < 0 { return ""; }
    let cc = __engine("ast_child_count", prog);
    var out = "";

    // 1. Emit table constructor helpers for composite structs
    var i = 0;
    while i < cc {
        let ch = __engine("ast_child_at", prog, i);
        if __engine("ast_node_kind", ch) == 1 && tir_struct_has_stored_fields(ch) {
            let sname = __engine("sym_str", __engine("ast_node_sym", ch));
            let fcc = __engine("ast_child_count", ch);
            var fparams = "";
            var ffields = "";
            var fi = 0;
            while fi < fcc {
                let fch = __engine("ast_child_at", ch, fi);
                if __engine("ast_node_kind", fch) == 21 {
                    let fname = __engine("sym_str", __engine("ast_node_sym", fch));
                    if fparams.len() > 0 {
                        fparams = fparams + ", ";
                        ffields = ffields + ", ";
                    }
                    fparams = fparams + fname;
                    ffields = ffields + fname + " = " + fname;
                }
                fi = fi + 1;
            }
            out = out + "function new_" + sname + "(" + fparams + ")\n    return { " + ffields + " }\nend\n\n";
        }
        i = i + 1;
    }

    // 2. Emit functions
    i = 0;
    while i < cc {
        let fn_nid = __engine("ast_child_at", prog, i);
        if __engine("ast_node_kind", fn_nid) == 3 && (__engine("ast_decl_flags", fn_nid) & 256) == 0 {
            let fname = __engine("sym_str", __engine("ast_node_sym", fn_nid));
            let fcc = __engine("ast_child_count", fn_nid);
            var params_s = "";
            var pi = 1;
            while pi < fcc {
                let pch = __engine("ast_child_at", fn_nid, pi);
                if __engine("ast_node_kind", pch) == 21 {
                    let pname = __engine("sym_str", __engine("ast_node_sym", pch));
                    if params_s.len() > 0 { params_s = params_s + ", "; }
                    params_s = params_s + pname;
                }
                pi = pi + 1;
            }
            let body_s = if fcc > 0 {
                tlua_emit_block_body(__engine("ast_child_at", fn_nid, 0), 1)
            } else {
                ""
            };
            out = out + "function " + fname + "(" + params_s + ")\n" + body_s + "end\n\n";
        }
        i = i + 1;
    }

    return out;
}
