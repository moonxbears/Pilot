// ============================================================================
// FILE: selfhost/transpile/emit_cpp.pilot
// Milestone 57.2: Modular C++ Source Emitter (`pilot --emit cpp`)
// Maps `(reg_class, bit_width)` physics into C++ types (`std::int64_t`,
// `double`, `bool`, `std::string`) with zero hardcoded Pilot type names.
// ============================================================================

pub pure fn cpp_type_for_physics(reg_class: i64, bit_width: i64) -> str {
    if reg_class == 0 || reg_class == 1 { return "void"; }
    if reg_class == 2 {
        if bit_width <= 8 { return "std::int8_t"; }
        if bit_width <= 16 { return "std::int16_t"; }
        if bit_width <= 32 { return "std::int32_t"; }
        return "std::int64_t";
    }
    if reg_class == 3 {
        if bit_width == 1 { return "bool"; }
        if bit_width <= 8 { return "std::uint8_t"; }
        if bit_width <= 16 { return "std::uint16_t"; }
        if bit_width <= 32 { return "std::uint32_t"; }
        return "std::uint64_t";
    }
    if reg_class == 4 {
        if bit_width <= 32 { return "float"; }
        return "double";
    }
    return "const char*";
}

pub pure fn emit_cpp_function_source(
    fn_name: str,
    param_name: str,
    param_reg: i64,
    param_bits: i64,
    ret_reg: i64,
    ret_bits: i64,
    body_expr: str
) -> str {
    let p_ty = cpp_type_for_physics(param_reg, param_bits);
    let r_ty = cpp_type_for_physics(ret_reg, ret_bits);
    return "#include <cstdint>\n#include <string>\n\n"
        + r_ty + " " + fn_name + "(" + p_ty + " " + param_name + ") {\n"
        + "    " + nameof(return) + " " + body_expr + ";\n"
        + "}\n";
}

pub fn tcpp_map_type_name(type_name: str) -> str {
    if type_name.len() == 0 {
        return "void";
    }
    let ph = tir_resolve_type_physics(type_name);
    if ph.reg_class == 7 {
        return type_name;
    }
    return cpp_type_for_physics(ph.reg_class, ph.bit_width);
}

pub fn tcpp_emit_expr(nid: i64) -> str {
    if nid < 0 { return "0"; }
    let k = __engine("ast_node_kind", nid);
    let ok = __engine("ast_orig_kind", nid);

    if k == 14 {
        return __engine("sym_str", __engine("ast_node_sym", nid));
    }
    if k == 15 {
        let lk = __engine("ast_node_lit_kind", nid);
        if lk == 1 {
            return "static_cast<std::int64_t>(" + __engine("ast_node_raw_bits", nid) + "LL)";
        }
        if lk == 2 {
            return __engine("source_slice", __engine("ast_span_start", nid), __engine("ast_span_end", nid));
        }
        if lk == 3 {
            return tir_escape_str_lit(__engine("sym_str", __engine("ast_node_sym", nid)));
        }
        if lk == 4 {
            if __engine("ast_node_raw_bits", nid) != 0 { return "true"; }
            return "false";
        }
        return "0";
    }
    if ok == 206 {
        let inner = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let fl = __engine("ast_node_flags", nid);
        if fl == 5 { return "(!" + inner + ")"; }
        if fl == 4 { return "(~" + inner + ")"; }
        return "(-" + inner + ")";
    }
    if k == 19 {
        let op = __engine("ast_node_raw_bits", nid);
        let lhs = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let rhs = tcpp_emit_expr(__engine("ast_child_at", nid, 1));
        return "(" + lhs + " " + tir_binop_sym(op) + " " + rhs + ")";
    }
    if k == 16 {
        let cc = __engine("ast_child_count", nid);
        if cc <= 0 { return "0"; }
        let callee_nid = __engine("ast_child_at", nid, 0);
        let cname = __engine("sym_str", __engine("ast_node_sym", callee_nid));
        if tir_is_struct_literal_call(nid) {
            let map_nid = __engine("ast_child_at", nid, 1);
            let mcc = __engine("ast_child_count", map_nid);
            var vals_s = "";
            var mi = 0;
            while mi + 1 < mcc {
                let v_nid = __engine("ast_child_at", map_nid, mi + 1);
                if vals_s.len() > 0 {
                    vals_s = vals_s + ", ";
                }
                vals_s = vals_s + tcpp_emit_expr(v_nid);
                mi = mi + 2;
            }
            return cname + "{ " + vals_s + " }";
        }
        var args_s = "";
        var ai = 1;
        while ai < cc {
            if ai > 1 { args_s = args_s + ", "; }
            args_s = args_s + tcpp_emit_expr(__engine("ast_child_at", nid, ai));
            ai = ai + 1;
        }
        return cname + "(" + args_s + ")";
    }
    if k == 17 {
        let recv = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let fld = __engine("sym_str", __engine("ast_node_sym", nid));
        return recv + "." + fld;
    }
    if ok == 210 {
        let base_e = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let idx_e = tcpp_emit_expr(__engine("ast_child_at", nid, 1));
        return base_e + "[" + idx_e + "]";
    }
    return "0";
}

pub fn tcpp_emit_block_body(blk_nid: i64, depth: i64) -> str {
    if blk_nid < 0 { return ""; }
    if __engine("ast_node_kind", blk_nid) != 18 {
        return tcpp_emit_stmt(blk_nid, depth);
    }
    let cc = __engine("ast_child_count", blk_nid);
    var out = "";
    var i = 0;
    while i < cc {
        out = out + tcpp_emit_stmt(__engine("ast_child_at", blk_nid, i), depth);
        i = i + 1;
    }
    return out;
}

pub fn tcpp_emit_stmt(nid: i64, depth: i64) -> str {
    if nid < 0 { return ""; }
    let k = __engine("ast_node_kind", nid);
    let ok = __engine("ast_orig_kind", nid);
    let ind = tir_indent_spaces(depth);

    if k == 18 {
        return tcpp_emit_block_body(nid, depth);
    }
    if k == 4 {
        let vname = __engine("sym_str", __engine("ast_node_sym", nid));
        let tsym = __engine("ast_node_raw_bits", nid);
        var vty = "auto";
        if tsym != 0 {
            let tname = __engine("sym_str", tsym);
            if tname.len() > 0 {
                vty = tcpp_map_type_name(tname);
            }
        }
        let init_s = if __engine("ast_child_count", nid) > 0 {
            tcpp_emit_expr(__engine("ast_child_at", nid, 0))
        } else {
            "0"
        };
        return ind + vty + " " + vname + " = " + init_s + ";\n";
    }
    if k == 20 {
        let lhs = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let rhs = tcpp_emit_expr(__engine("ast_child_at", nid, 1));
        return ind + lhs + " = " + rhs + ";\n";
    }
    if k == 6 {
        let cond_s = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let then_s = tcpp_emit_block_body(__engine("ast_child_at", nid, 1), depth + 1);
        var res = ind + "if (" + cond_s + ") {\n" + then_s + ind + "}";
        if __engine("ast_child_count", nid) >= 3 {
            let else_s = tcpp_emit_block_body(__engine("ast_child_at", nid, 2), depth + 1);
            res = res + " else {\n" + else_s + ind + "}";
        }
        return res + "\n";
    }
    if k == 7 || ok == 106 {
        if ok == 105 {
            let lbody = tcpp_emit_block_body(__engine("ast_child_at", nid, 0), depth + 1);
            return ind + "while (true) {\n" + lbody + ind + "}\n";
        }
        let wcond = tcpp_emit_expr(__engine("ast_child_at", nid, 0));
        let wbody = tcpp_emit_block_body(__engine("ast_child_at", nid, 1), depth + 1);
        return ind + "while (" + wcond + ") {\n" + wbody + ind + "}\n";
    }
    if ok == 107 { return ind + "break;\n"; }
    if ok == 108 { return ind + "continue;\n"; }
    if k == 8 {
        if __engine("ast_child_count", nid) > 0 {
            return ind + "return " + tcpp_emit_expr(__engine("ast_child_at", nid, 0)) + ";\n";
        }
        return ind + "return;\n";
    }
    if ok == 110 {
        if __engine("ast_child_count", nid) > 0 {
            return ind + tcpp_emit_expr(__engine("ast_child_at", nid, 0)) + ";\n";
        }
        return "";
    }
    return ind + tcpp_emit_expr(nid) + ";\n";
}

pub fn tcpp_fn_signature(fn_nid: i64) -> str {
    let fname = __engine("sym_str", __engine("ast_node_sym", fn_nid));
    let rty = tcpp_map_type_name(tir_fn_return_type_name(fn_nid));
    let fcc = __engine("ast_child_count", fn_nid);
    var params_s = "";
    var pi = 1;
    while pi < fcc {
        let pch = __engine("ast_child_at", fn_nid, pi);
        if __engine("ast_node_kind", pch) == 21 {
            let pname = __engine("sym_str", __engine("ast_node_sym", pch));
            let pty = tcpp_map_type_name(__engine("sym_str", __engine("ast_node_raw_bits", pch)));
            if params_s.len() > 0 { params_s = params_s + ", "; }
            params_s = params_s + pty + " " + pname;
        }
        pi = pi + 1;
    }
    return rty + " " + fname + "(" + params_s + ")";
}

pub fn transpile_arena_to_cpp() -> str {
    let prog = tir_target_prog_nid();
    if prog < 0 { return ""; }
    let cc = __engine("ast_child_count", prog);
    var out = "#include <cstdint>\n\n";

    // 1. Forward struct declarations
    var i = 0;
    while i < cc {
        let ch = __engine("ast_child_at", prog, i);
        if __engine("ast_node_kind", ch) == 1 && tir_struct_has_stored_fields(ch) {
            let sname = __engine("sym_str", __engine("ast_node_sym", ch));
            out = out + "struct " + sname + ";\n";
        }
        i = i + 1;
    }

    // 2. Struct definitions
    i = 0;
    while i < cc {
        let ch = __engine("ast_child_at", prog, i);
        if __engine("ast_node_kind", ch) == 1 && tir_struct_has_stored_fields(ch) {
            let sname = __engine("sym_str", __engine("ast_node_sym", ch));
            out = out + "struct " + sname + " {\n";
            let fcc = __engine("ast_child_count", ch);
            var fi = 0;
            while fi < fcc {
                let fch = __engine("ast_child_at", ch, fi);
                if __engine("ast_node_kind", fch) == 21 {
                    let fname = __engine("sym_str", __engine("ast_node_sym", fch));
                    let fty = tcpp_map_type_name(__engine("sym_str", __engine("ast_node_raw_bits", fch)));
                    out = out + "    " + fty + " " + fname + ";\n";
                }
                fi = fi + 1;
            }
            out = out + "};\n\n";
        }
        i = i + 1;
    }

    // 3. Forward function declarations
    i = 0;
    while i < cc {
        let fn_nid = __engine("ast_child_at", prog, i);
        if __engine("ast_node_kind", fn_nid) == 3 && (__engine("ast_decl_flags", fn_nid) & 256) == 0 {
            out = out + tcpp_fn_signature(fn_nid) + ";\n";
        }
        i = i + 1;
    }
    out = out + "\n";

    // 4. Function definitions
    i = 0;
    while i < cc {
        let fn_nid = __engine("ast_child_at", prog, i);
        if __engine("ast_node_kind", fn_nid) == 3 && (__engine("ast_decl_flags", fn_nid) & 256) == 0 {
            let body_s = if __engine("ast_child_count", fn_nid) > 0 {
                tcpp_emit_block_body(__engine("ast_child_at", fn_nid, 0), 1)
            } else {
                ""
            };
            out = out + tcpp_fn_signature(fn_nid) + " {\n" + body_s + "}\n\n";
        }
        i = i + 1;
    }

    return out;
}
