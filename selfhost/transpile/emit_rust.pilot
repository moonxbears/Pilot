// ==============================================================================
// FILE: selfhost/transpile/emit_rust.pilot
// `pilot emit rust`: PilIR as Rust (selfhost/transpile/source.pilot).
// ==============================================================================
// Integers are Rust integers of their width with the seed's wrapping
// arithmetic (`wrapping_add`, `wrapping_shl`, ..); division and remainder
// stop the program on a zero divisor. Booleans are `bool`, floats `f64` /
// `f32`, and `print` uses Rust's own formatting, which is the seed's.
// Strings appear only as literals passed to `print`; module variables and
// records stop at the representation seam.
pub lvl(0) pkg Pilot.SelfHost.Transpile.EmitRust;

use selfhost.ir.model.*;
use selfhost.transpile.source.*;

pub struct RustDialect : ISourceDialect {
    pub fn language() -> str => "Rust";
    pub fn typed() -> bool => true;
    pub fn reserved() -> List<str> => [
        "as", "break", "const", "continue", "crate", "else", "enum", "extern", "false", "fn", "for", "if",
        "impl", "in", "let", "loop", "match", "mod", "move", "mut", "pub", "ref", "return", "self", "Self",
        "static", "struct", "super", "trait", "true", "type", "unsafe", "use", "where", "while", "async",
        "await", "dyn", "abstract", "become", "box", "do", "final", "macro", "override", "priv", "typeof",
        "unsized", "virtual", "yield", "try", "union", "main", "std", "core", "println", "eprintln",
    ];
    pub fn type_name(p: IrTypePhysics) -> str? {
        if is_bool(p) { return "bool"; }
        if is_float(p) {
            if p.bit_width == 64 || p.bit_width == 32 { return f"f{p.bit_width}"; }
            return none;
        }
        if is_int(p) && (p.bit_width == 8 || p.bit_width == 16 || p.bit_width == 32 || p.bit_width == 64 || p.bit_width == 128) {
            let base = if is_signed(p) { "i" } else { "u" };
            return f"{base}{p.bit_width}";
        }
        if p.layout_id == 0 { return "()"; }
        return none;
    }
    pub fn prelude() -> List<str> => [
        "fn pilot_trap(message: &str) -> ! {",
        "    eprintln!(\"runtime error: {}\", message);",
        "    std::process::exit(1);",
        "}",
        "",
    ];
    pub fn global_decl(name: str, p: IrTypePhysics) -> str? => none;
    pub fn module_open(protos: List<str>) -> List<str> => [];
    pub fn prototype(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str => "";
    pub fn module_close(entry: str, has_code: bool) -> List<str> {
        if entry == "" { return []; }
        if has_code { return ["fn main() " + "{ " + f"std::process::exit({entry}() as i32); " + "}"]; }
        return ["fn main() " + "{ " + f"{entry}(); " + "}"];
    }
    pub fn fn_open(name: str, params: List<str>, phys: List<IrTypePhysics>, ret: IrTypePhysics) -> str {
        var ps: List<str> = [];
        var i = 0;
        while i < params.len() {
            if phys[i].layout_id != 0 { ps.push(f"mut {params[i]}: {self.rust_type(phys[i])}"); }
            i = i + 1;
        }
        let r = if ret.layout_id == 0 { "" } else { " -> " + self.rust_type(ret) };
        return f"fn {name}({joined(ps)}){r} " + "{";
    }
    pub fn fn_close() -> str => "}";
    pub fn fn_globals(globals: List<str>) -> List<str> => [];
    pub fn param_prologue(name: str, p: IrTypePhysics) -> List<str> => [];
    pub fn locals(names: List<str>, phys: List<IrTypePhysics>) -> List<str> {
        var out: List<str> = [];
        var i = 0;
        while i < names.len() {
            out.push(f"let mut {names[i]}: {self.rust_type(phys[i])} = {self.zero(phys[i])};");
            i = i + 1;
        }
        return out;
    }
    pub fn zero(p: IrTypePhysics) -> str => if is_bool(p) { "false" } else if is_float(p) { "0.0" } else { "0" };
    pub fn unit_value() -> str? => none;
    pub fn state_decl(name: str) -> str => f"let mut {name}: u32 = 0;";
    pub fn dispatch_open() -> str => "loop {";
    pub fn dispatch_close() -> str => "}";
    pub fn case_open(state: str, b: i64, first: bool) -> str => (if first { "" } else { "} else " }) + f"if {state} == {b} " + "{";
    pub fn cases_close() -> str => "}";
    pub fn if_open(cond: str) -> str => f"if {cond} " + "{";
    pub fn else_line() -> str => "} else {";
    pub fn if_close() -> str => "}";
    pub fn assign(lhs: str, rhs: str) -> str => f"{lhs} = {rhs};";
    pub fn parallel_assign(lhs: List<str>, rhs: List<str>, phys: List<IrTypePhysics>) -> List<str> {
        var text = "{ ";
        var i = 0;
        while i < lhs.len() {
            text = text + f"let t{i} = {rhs[i]}; ";
            i = i + 1;
        }
        i = 0;
        while i < lhs.len() {
            text = text + f"{lhs[i]} = t{i}; ";
            i = i + 1;
        }
        return [text + "}"];
    }
    pub fn expr_stmt(e: str) -> str => e + ";";
    pub fn ret(e: str) -> str => if e == "" { "return;" } else { f"return {e};" };
    pub fn trap(message: str) -> str => f"pilot_trap({self.str_lit(message)});";
    pub fn int_lit(digits: str, p: IrTypePhysics) -> str? {
        guard some t = self.type_name(p) else { return none; };
        return f"({digits}{t})";
    }
    pub fn bool_lit(b: bool) -> str => if b { "true" } else { "false" };
    pub fn float_lit(text: str, p: IrTypePhysics) -> str? {
        guard some t = self.type_name(p) else { return none; };
        if text == "NaN" { return f"{t}::NAN"; }
        if text == "inf" { return f"{t}::INFINITY"; }
        if text == "-inf" { return f"{t}::NEG_INFINITY"; }
        return f"({text}{t})";
    }
    pub fn str_lit(raw: str) -> str => escaped(raw, (b) => "\\x" + hex2(b));
    pub fn binary(op: str, a: str, b: str, pa: IrTypePhysics, pb: IrTypePhysics, p: IrTypePhysics) -> str? {
        if is_float(p) {
            if op == "add" { return f"({a} + {b})"; }
            if op == "sub" { return f"({a} - {b})"; }
            if op == "mul" { return f"({a} * {b})"; }
            if op == "div" { return f"({a} / {b})"; }
            if op == "rem" { return f"({a} % {b})"; }
            return none;
        }
        if is_bool(p) {
            if op == "and" { return f"({a} & {b})"; }
            if op == "or" { return f"({a} | {b})"; }
            if op == "xor" { return f"({a} ^ {b})"; }
            return none;
        }
        guard some t = self.type_name(p) else { return none; };
        if !is_int(p) { return none; }
        // Operands of another layout of the same width are converted first.
        let x = if pa.layout_id == p.layout_id { a } else { f"({a} as {t})" };
        let y = if pb.layout_id == p.layout_id { b } else { f"({b} as {t})" };
        if op == "add" { return f"{x}.wrapping_add({y})"; }
        if op == "sub" { return f"{x}.wrapping_sub({y})"; }
        if op == "mul" { return f"{x}.wrapping_mul({y})"; }
        if op == "shl" { return f"{x}.wrapping_shl({b} as u32)"; }
        if op == "shr" { return f"{x}.wrapping_shr({b} as u32)"; }
        if op == "and" { return f"({x} & {y})"; }
        if op == "or" { return f"({x} | {y})"; }
        if op == "xor" { return f"({x} ^ {y})"; }
        let guarded = "{ " + f"if {y} == 0 " + "{ pilot_trap(\"integer division by zero\") } else { ";
        if op == "div" { return guarded + f"{x}.wrapping_div({y})" + " } }"; }
        if op == "rem" { return guarded + f"{x}.wrapping_rem({y})" + " } }"; }
        return none;
    }
    pub fn compare_op(pred: i64, a: str, b: str, p: IrTypePhysics) -> str? => f"({a} {cmp_symbol(pred)} {b})";
    pub fn cast(v: str, from: IrTypePhysics, to: IrTypePhysics) -> str? {
        guard some t = self.type_name(to) else { return none; };
        if self.type_name(from) == none { return none; }
        if is_bool(to) {
            if is_bool(from) { return v; }
            return if is_float(from) { f"({v} != 0.0)" } else { f"({v} != 0)" };
        }
        if is_bool(from) && is_float(to) { return f"(({v} as u8) as {t})"; }
        return f"(({v}) as {t})";
    }
    pub fn call(name: str, args: List<str>) -> str => f"{name}({joined(args)})";
    pub fn intrinsic(name: str, args: List<str>, phys: List<IrTypePhysics>, literal: List<bool>) -> str? {
        let mac = if name == "rt_print" { "println!" } else if name == "rt_eprint" { "eprintln!" } else { "" };
        if mac == "" { return none; }
        var holes = "";
        var i = 0;
        while i < args.len() {
            if !literal[i] && self.type_name(phys[i]) == none { return none; }
            if i > 0 { holes = holes + " "; }
            holes = holes + "{}";
            i = i + 1;
        }
        if args.len() == 0 { return mac + "()"; }
        return mac + "(\"" + holes + "\", " + joined(args) + ")";
    }
    pub fn make_record(values: List<str>) -> str? => none;
    pub fn get_field(rec: str, i: i64) -> str? => none;
    pub fn set_field(rec: str, i: i64, v: str) -> str? => none;

    /// The Rust type of `p`; `()` when it has none (the caller checked).
    pub fn rust_type(p: IrTypePhysics) -> str => self.type_name(p) ?? "()";
}

pub fn rust_dialect() -> ISourceDialect => RustDialect {};
