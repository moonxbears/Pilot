// ==============================================================================
// FILE: selfhost/ast.pilot
// Milestone 61.1: 16-Byte Flat AST Node Layout & Arena Descriptors in Pilot
// ==============================================================================
pub pkg Pilot.SelfHost.Ast;

pub pure fn nameof(sym: str) -> str => sym;

pub enum ShNodeKind {
    Program,
    StructDecl,
    InterfaceDecl,
    FnDecl,
    LetStmt,
    VarStmt,
    IfExpr,
    WhileStmt,
    ReturnStmt,
    BlockExpr,
    BinaryExpr,
    UnaryExpr,
    CallExpr,
    IntLit,
    IdentExpr,
    RawQuote,
    TemplateQuote,
    SpliceHole,
    SplatHole,
    SyntaxCaseArm,
}

pub pure fn sh_sizeof_ast_node() -> i64 {
    return 16;
}

pub fn sh_ast_new() -> i64 {
    let arena = __engine("map_new");
    __engine("map_set", arena, "node_count", 0);
    __engine("map_set", arena, "root", -1);
    return arena;
}

pub fn sh_ast_alloc_node(arena: i64, kind_name: str, op_text: str) -> i64 {
    let nid = __engine("map_get", arena, "node_count");
    __engine("map_set", arena, "node_count", nid + 1);
    __engine("map_set", arena, nid + "_kind", kind_name);
    __engine("map_set", arena, nid + "_op", op_text);
    __engine("map_set", arena, nid + "_child_count", 0);
    return nid;
}

pub fn sh_ast_add_child(arena: i64, parent: i64, child: i64) -> void {
    let cnt = __engine("map_get", arena, parent + "_child_count");
    __engine("map_set", arena, parent + "_child_" + cnt, child);
    __engine("map_set", arena, parent + "_child_count", cnt + 1);
}

pub fn sh_ast_set_root(arena: i64, root_nid: i64) -> void {
    __engine("map_set", arena, "root", root_nid);
}

pub fn sh_ast_root(arena: i64) -> i64 {
    let r = __engine("map_get", arena, "root");
    if r != null { return r; }
    return -1;
}

pub fn sh_ast_kind_name(arena: i64, node_id: i64) -> str {
    let k = __engine("map_get", arena, node_id + "_kind");
    if k != null { return k; }
    return "Unknown";
}

pub pure fn sh_node_kind_name(kind: ShNodeKind) -> str {
    return "Program";
}

pub fn sh_ast_kind(arena: i64, node_id: i64) -> ShNodeKind {
    return ::Program;
}

pub fn sh_ast_op_text(arena: i64, node_id: i64) -> str {
    let op = __engine("map_get", arena, node_id + "_op");
    if op != null { return op; }
    return "";
}

pub fn sh_ast_child_count(arena: i64, node_id: i64) -> i64 {
    let cnt = __engine("map_get", arena, node_id + "_child_count");
    if cnt != null { return cnt; }
    return 0;
}

pub fn sh_ast_child_at(arena: i64, node_id: i64, idx: i64) -> i64 {
    let ch = __engine("map_get", arena, node_id + "_child_" + idx);
    if ch != null { return ch; }
    return -1;
}

// Option 1 Quoting Constructors: raw, quote, splice, splat
pub fn sh_ast_alloc_raw(arena: i64, verbatim_code: str) -> i64 {
    let nid = sh_ast_alloc_node(arena, "RawQuote", verbatim_code);
    return nid;
}

pub fn sh_ast_alloc_template(arena: i64, template_body: i64) -> i64 {
    let nid = sh_ast_alloc_node(arena, "TemplateQuote", "");
    if template_body >= 0 {
        sh_ast_add_child(arena, nid, template_body);
    }
    return nid;
}

pub fn sh_ast_alloc_splice(arena: i64, slot_name: str, node: i64) -> i64 {
    let nid = sh_ast_alloc_node(arena, "SpliceHole", slot_name);
    if node >= 0 {
        sh_ast_add_child(arena, nid, node);
    }
    return nid;
}

pub fn sh_ast_alloc_splat(arena: i64, slot_name: str, nodes: i64) -> i64 {
    let nid = sh_ast_alloc_node(arena, "SplatHole", slot_name);
    if nodes >= 0 {
        sh_ast_add_child(arena, nid, nodes);
    }
    return nid;
}

// Syntax Overloading Arm Constructor & Matcher
pub fn sh_ast_alloc_syntax_arm(arena: i64, arity: i64, pattern_tag: str, body: i64) -> i64 {
    let nid = sh_ast_alloc_node(arena, "SyntaxCaseArm", pattern_tag);
    __engine("map_set", arena, nid + "_arity", arity);
    if body >= 0 {
        sh_ast_add_child(arena, nid, body);
    }
    return nid;
}

pub fn sh_ast_syntax_arm_arity(arena: i64, arm_id: i64) -> i64 {
    let a = __engine("map_get", arena, arm_id + "_arity");
    if a != null { return a; }
    return 0;
}

pub fn sh_ast_match_syntax_arm(arena: i64, arm_id: i64, arg_count: i64) -> bool {
    let arity = sh_ast_syntax_arm_arity(arena, arm_id);
    return arity == arg_count;
}
