// ==============================================================================
// selfhost/ast.pilot: AST Node Definitions & Arena Layout for Self-Hosted Pilot
// ==============================================================================

pub pkg Pilot.SelfHost.Ast;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Option.*;
use Pilot.Core.Result.*;
use Pilot.Core.Builtins.*;

// Node Kind Constants
pub const NODE_UNKNOWN: i64 = 0;
pub const NODE_INT_LIT: i64 = 1;
pub const NODE_FLOAT_LIT: i64 = 2;
pub const NODE_STR_LIT: i64 = 3;
pub const NODE_BOOL_LIT: i64 = 4;
pub const NODE_IDENT: i64 = 5;

pub const NODE_LET_STMT: i64 = 101;
pub const NODE_VAR_STMT: i64 = 102;
pub const NODE_ASSIGN_STMT: i64 = 103;
pub const NODE_RETURN_STMT: i64 = 104;
pub const NODE_IF_STMT: i64 = 105;
pub const NODE_WHILE_STMT: i64 = 106;
pub const NODE_FN_DECL: i64 = 107;
pub const NODE_EXPR_STMT: i64 = 108;
pub const NODE_PROGRAM: i64 = 109;

pub const NODE_BINARY_EXPR: i64 = 201;
pub const NODE_UNARY_EXPR: i64 = 202;
pub const NODE_CALL_EXPR: i64 = 203;
pub const NODE_MEMBER_EXPR: i64 = 204;
pub const NODE_INDEX_EXPR: i64 = 205;

// Binary Operator Constants
pub const OP_ADD: i64 = 1;
pub const OP_SUB: i64 = 2;
pub const OP_MUL: i64 = 3;
pub const OP_DIV: i64 = 4;
pub const OP_MOD: i64 = 5;
pub const OP_EQ: i64 = 8;
pub const OP_NE: i64 = 9;
pub const OP_LT: i64 = 10;
pub const OP_LE: i64 = 11;
pub const OP_GT: i64 = 12;
pub const OP_GE: i64 = 13;
pub const OP_AND: i64 = 14;
pub const OP_OR: i64 = 15;

pub fn get_node_kind_name(kind: i64) -> str {
    if kind == 1 { return "IntLit"; }
    if kind == 2 { return "FloatLit"; }
    if kind == 3 { return "StrLit"; }
    if kind == 4 { return "BoolLit"; }
    if kind == 5 { return "Ident"; }
    if kind == 101 { return "LetStmt"; }
    if kind == 104 { return "ReturnStmt"; }
    if kind == 105 { return "IfStmt"; }
    if kind == 106 { return "WhileStmt"; }
    if kind == 107 { return "FnDecl"; }
    if kind == 201 { return "BinaryExpr"; }
    if kind == 203 { return "CallExpr"; }
    return "Unknown";
}
