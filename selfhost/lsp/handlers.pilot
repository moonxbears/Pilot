pub pkg Pilot.SelfHost.Lsp.Handlers;

use Pilot.Core.Genesis.*;
use Pilot.Core.Interfaces.*;
use Pilot.Core.Memory.*;
use Pilot.Core.Meta.*;

pub pure fn nameof(sym: str) -> str => sym;

let Cfg = {
    ast = {
        ast_attr_arg: "ast_attr_arg", ast_attr_count: "ast_attr_count",
        ast_child_at: "ast_child_at", ast_child_count: "ast_child_count",
        ast_emit_diag: "ast_emit_diag", ast_get_bound_layout: "ast_get_bound_layout",
        ast_get_bound_target: "ast_get_bound_target", ast_node_count: "ast_node_count",
        ast_node_kind: "ast_node_kind", ast_node_sym: "ast_node_sym",
        ast_span_end: "ast_span_end", ast_span_start: "ast_span_start",
        layout_metrics: "layout_metrics", lsp_query_method: "lsp_query_method",
        lsp_query_offset: "lsp_query_offset", lsp_set_result: "lsp_set_result",
        mount_unit: "mount_unit", source_slice: "source_slice", sym_str: "sym_str",
    }
};

pub fn reflect_keyword_doc(target_word: str) -> str {
    if target_word == "" { return ""; }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        if __engine(Cfg.ast.ast_node_kind, i) == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, i);
            if (ac == 2 || ac == 3) && __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i)) == target_word {
                return __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_arg, i, 1));
            }
        }
        i = i + 1;
    }
    return "";
}

pub fn reflect_keyword_badge(target_word: str) -> str {
    if target_word == "" { return "Core"; }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    var target_cat_id = -1;
    while i < node_count {
        if __engine(Cfg.ast.ast_node_kind, i) == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, i);
            if (ac == 2 || ac == 3) && __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i)) == target_word {
                target_cat_id = __engine(Cfg.ast.ast_attr_arg, i, 0);
                i = node_count;
            }
        }
        i = i + 1;
    }
    if target_cat_id == -1 { return "Core"; }
    var j = 0;
    while j < node_count {
        if __engine(Cfg.ast.ast_node_kind, j) == 1 && __engine(Cfg.ast.ast_attr_count, j) == 4 && __engine(Cfg.ast.ast_attr_arg, j, 0) == target_cat_id {
            return __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_attr_arg, j, 2));
        }
        j = j + 1;
    }
    return "Core";
}

pub pure fn format_keyword_hover_markdown(ident: str, domain: str, summary: str) -> str {
    return "**Pilot Keyword**: `" + ident + "` (" + domain + ")\n\n" + summary;
}

pub fn reflect_node_doc(node_id: i64) -> str {
    let span_start = __engine(Cfg.ast.ast_span_start, node_id);
    let win_start = if span_start > 400 { span_start - 400 } else { 0 };
    if span_start <= win_start { return ""; }
    var lead = span_start;
    while lead > win_start {
        let ch = __engine(Cfg.ast.source_slice, lead - 1, lead);
        if ch == "\n" { break; }
        if ch == ";" || ch == "}" || ch == "{" { return ""; }
        lead = lead - 1;
    }
    var p = lead - 1;
    while p > win_start {
        let ch = __engine(Cfg.ast.source_slice, p - 1, p);
        if ch != "\n" && ch != " " && ch != "\t" && ch != "\r" { break; }
        p = p - 1;
    }
    if p > win_start + 3 {
        var line_start = p;
        while line_start > win_start && __engine(Cfg.ast.source_slice, line_start - 1, line_start) != "\n" {
            line_start = line_start - 1;
        }
        var ls = line_start;
        while ls < p {
            let ch = __engine(Cfg.ast.source_slice, ls, ls + 1);
            if ch != " " && ch != "\t" { break; }
            ls = ls + 1;
        }
        if __engine(Cfg.ast.source_slice, ls, ls + 3) == "///" {
            var ds = ls + 3;
            if __engine(Cfg.ast.source_slice, ds, ds + 1) == " " { ds = ds + 1; }
            return __engine(Cfg.ast.source_slice, ds, p);
        }
    }
    return "";
}

pub pure fn lsp_str_contains_word(text: str, word: str) -> bool {
    let tlen = text.len();
    let wlen = word.len();
    if wlen == 0 || tlen < wlen { return false; }
    var i = 0;
    while i + wlen <= tlen {
        if text.slice(i, i + wlen) == word {
            let left_ok = if i == 0 { true } else {
                let c = text.slice(i - 1, i);
                !(c >= "a" && c <= "z") && !(c >= "A" && c <= "Z") && !(c >= "0" && c <= "9") && c != "_"
            };
            let right_ok = if i + wlen == tlen { true } else {
                let c = text.slice(i + wlen, i + wlen + 1);
                !(c >= "a" && c <= "z") && !(c >= "A" && c <= "Z") && !(c >= "0" && c <= "9") && c != "_"
            };
            if left_ok && right_ok { return true; }
        }
        i = i + 1;
    }
    return false;
}

pub fn extract_node_signature_str(fn_id: i64) -> str {
    let fn_start = __engine(Cfg.ast.ast_span_start, fn_id);
    if fn_start == 4294967295 || fn_start < 0 {
        let sym = __engine(Cfg.ast.ast_node_sym, fn_id);
        let fn_name = __engine(Cfg.ast.sym_str, sym);
        var res = "pub fn " + fn_name + "(";
        let cc = __engine(Cfg.ast.ast_child_count, fn_id);
        var pidx = 1;
        var pcount = 0;
        while pidx < cc {
            let pid = __engine(Cfg.ast.ast_child_at, fn_id, pidx);
            let psym = __engine(Cfg.ast.ast_node_sym, pid);
            let pname = __engine(Cfg.ast.sym_str, psym);
            if pname != "" {
                if pcount > 0 { res = res + ", "; }
                res = res + pname;
                pcount = pcount + 1;
            }
            pidx = pidx + 1;
        }
        return res + ")";
    }
    var sig_start = fn_start;
    while sig_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, sig_start - 1, sig_start);
        if ch == "\n" || ch == ";" || ch == "{" || ch == "}" { break; }
        sig_start = sig_start - 1;
    }
    while sig_start < fn_start {
        let ch = __engine(Cfg.ast.source_slice, sig_start, sig_start + 1);
        if ch != " " && ch != "\t" && ch != "\r" { break; }
        sig_start = sig_start + 1;
    }
    var sig_end = fn_start;
    while sig_end < fn_start + 200 {
        let ch = __engine(Cfg.ast.source_slice, sig_end, sig_end + 1);
        if ch == "{" || ch == "=" || ch == ";" || ch == "\n" { break; }
        sig_end = sig_end + 1;
    }
    while sig_end > fn_start {
        let ch = __engine(Cfg.ast.source_slice, sig_end - 1, sig_end);
        if ch != " " && ch != "\t" && ch != "\r" { break; }
        sig_end = sig_end - 1;
    }
    return __engine(Cfg.ast.source_slice, sig_start, sig_end);
}

pub fn find_type_decl_node(type_str: str, node_count: i64) -> i64 {
    if type_str == "" { return -1; }
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 || k == 2 {
            let sname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
            if sname != "" && lsp_str_contains_word(type_str, sname) { return i; }
        }
        i = i + 1;
    }
    return -1;
}

pub fn format_type_ref_link(type_str: str, node_count: i64) -> str {
    let tid = find_type_decl_node(type_str, node_count);
    if tid >= 0 {
        let tname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, tid));
        let toff = __engine(Cfg.ast.ast_span_start, tid);
        let lid = __engine(Cfg.ast.ast_get_bound_layout, tid);
        let bsize = if lid != 4294967295 && lid >= 0 { __engine(Cfg.ast.layout_metrics, lid) } else { 0 };
        let sz_note = if bsize > 0 { ", " + bsize + " bytes" } else { "" };
        return "[`" + type_str + "`](#" + tname + ") *(ref [`" + tname + "`](#" + tname + ") @ offset " + toff + sz_note + ")*";
    }
    return "[`" + type_str + "`](#" + type_str + ")";
}

pub fn format_hover_param_list(sig_str: str, node_count: i64) -> str {
    let slen = sig_str.len();
    var p_open = -1;
    var i = 0;
    while i < slen && p_open == -1 {
        if sig_str.slice(i, i + 1) == "(" { p_open = i; }
        i = i + 1;
    }
    if p_open == -1 { return ""; }
    var p_close = -1;
    var depth = 1;
    var j = p_open + 1;
    while j < slen && p_close == -1 {
        let ch = sig_str.slice(j, j + 1);
        if ch == "(" { depth = depth + 1; }
        else if ch == ")" {
            depth = depth - 1;
            if depth == 0 { p_close = j; }
        }
        j = j + 1;
    }
    if p_close <= p_open + 1 { return "\n\n**Parameters:** *(none)*"; }
    let inner = sig_str.slice(p_open + 1, p_close).trim();
    if inner == "" { return "\n\n**Parameters:** *(none)*"; }
    var out = "\n\n**Parameters:**";
    var start_idx = 0;
    let in_len = inner.len();
    var k = 0;
    var comma_depth = 0;
    while k <= in_len {
        let is_sep = if k == in_len { true } else {
            let c = inner.slice(k, k + 1);
            if c == "<" || c == "(" || c == "[" { comma_depth = comma_depth + 1; }
            else if c == ">" || c == ")" || c == "]" { if comma_depth > 0 { comma_depth = comma_depth - 1; } }
            comma_depth == 0 && c == ","
        };
        if is_sep {
            let param_raw = inner.slice(start_idx, k).trim();
            if param_raw != "" {
                var colon_pos = -1;
                var ci = 0;
                let plen = param_raw.len();
                while ci < plen && colon_pos == -1 {
                    if param_raw.slice(ci, ci + 1) == ":" { colon_pos = ci; }
                    ci = ci + 1;
                }
                if colon_pos >= 0 {
                    let pname = param_raw.slice(0, colon_pos).trim();
                    let rhs_raw = param_raw.slice(colon_pos + 1, plen).trim();
                    var eq_pos = -1;
                    var ei = 0;
                    let rlen = rhs_raw.len();
                    while ei < rlen && eq_pos == -1 {
                        if rhs_raw.slice(ei, ei + 1) == "=" && (ei + 1 >= rlen || rhs_raw.slice(ei + 1, ei + 2) != ">") { eq_pos = ei; }
                        ei = ei + 1;
                    }
                    let ptype = if eq_pos >= 0 { rhs_raw.slice(0, eq_pos).trim() } else { rhs_raw };
                    let def_note = if eq_pos >= 0 { " *(default: `" + rhs_raw.slice(eq_pos + 1, rlen).trim() + "`)*" } else { "" };
                    out = out + "\n- `" + pname + "`: " + format_type_ref_link(ptype, node_count) + def_note;
                } else {
                    out = out + "\n- `" + param_raw + "`";
                }
            }
            start_idx = k + 1;
        }
        k = k + 1;
    }
    return out;
}

pub fn format_hover_returns(sig_str: str, node_count: i64) -> str {
    let slen = sig_str.len();
    var arrow_pos = -1;
    var i = 0;
    while i + 2 <= slen && arrow_pos == -1 {
        if sig_str.slice(i, i + 2) == "->" { arrow_pos = i; }
        i = i + 1;
    }
    let unit_ret = "\n\n**Returns:**\n- [`" + nameof(void) + "`](#" + nameof(void) + ")";
    if arrow_pos == -1 { return unit_ret; }
    var ret_part = sig_str.slice(arrow_pos + 2, slen).trim();
    if ret_part == "" { return unit_ret; }
    var r_end = ret_part.len();
    var j = 0;
    while j < r_end {
        let ch = ret_part.slice(j, j + 1);
        if ch == "{" || ch == "=" || ch == ";" { r_end = j; break; }
        j = j + 1;
    }
    ret_part = ret_part.slice(0, r_end).trim();
    if ret_part == "" { return unit_ret; }
    return "\n\n**Returns:**\n- " + format_type_ref_link(ret_part, node_count);
}

pub fn format_hover_overloads(word: str, current_fn_id: i64, node_count: i64) -> str {
    var count = 0;
    var list_md = "";
    var i = 0;
    while i < node_count {
        if i != current_fn_id {
            let k = __engine(Cfg.ast.ast_node_kind, i);
            if k == 3 {
                let sname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
                if sname == word {
                    count = count + 1;
                    let osig = extract_node_signature_str(i);
                    let ooff = __engine(Cfg.ast.ast_span_start, i);
                    if osig != "" { list_md = list_md + "\n" + count + ". `" + osig + "` *(@ offset " + ooff + ")*"; }
                }
            }
        }
        i = i + 1;
    }
    if count > 0 { return "\n\n**Overloads (" + count + "):**" + list_md; }
    return "";
}

pub fn format_hover_type_references(type_name: str, type_id: i64, node_count: i64) -> str {
    var ref_count = 0;
    var ref_md = "";
    var i = 0;
    while i < node_count && ref_count < 8 {
        if i != type_id {
            let k = __engine(Cfg.ast.ast_node_kind, i);
            if k == 3 {
                let sig = extract_node_signature_str(i);
                if lsp_str_contains_word(sig, type_name) {
                    ref_count = ref_count + 1;
                    let fname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
                    ref_md = ref_md + "\n- In [`" + fname + "`](#" + fname + "): `" + sig + "`";
                }
            } else if k == 21 || k == 4 {
                let s = __engine(Cfg.ast.ast_span_start, i);
                let e = __engine(Cfg.ast.ast_span_end, i);
                let f_src = __engine(Cfg.ast.source_slice, s, e).trim();
                if lsp_str_contains_word(f_src, type_name) {
                    ref_count = ref_count + 1;
                    let iname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i));
                    let role = if k == 21 { "Field/Param" } else { "Binding" };
                    ref_md = ref_md + "\n- " + role + " [`" + iname + "`](#" + iname + "): `" + f_src + "`";
                }
            }
        }
        i = i + 1;
    }
    if ref_count > 0 { return "\n\n**Type References (" + ref_count + "):**" + ref_md; }
    return "";
}

pub pure fn extract_ident_at_offset(offset: i64) -> str {
    let cur_ch = __engine(Cfg.ast.source_slice, offset, offset + 1);
    let is_ident = (cur_ch >= "a" && cur_ch <= "z") || (cur_ch >= "A" && cur_ch <= "Z") || (cur_ch >= "0" && cur_ch <= "9") || cur_ch == "_";
    if !is_ident { return ""; }
    var w_start = offset;
    while w_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, w_start - 1, w_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" { w_start = w_start - 1; }
        else { break; }
    }
    var w_end = offset;
    while w_end < offset + 50 {
        let ch = __engine(Cfg.ast.source_slice, w_end, w_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" { w_end = w_end + 1; }
        else { break; }
    }
    return __engine(Cfg.ast.source_slice, w_start, w_end);
}

pub fn find_best_node_for_ident(word: str, offset: i64, node_count: i64) -> i64 {
    var best_nid = -1;
    var best_len = 999999999;
    var i = 0;
    while i < node_count {
        let s = __engine(Cfg.ast.ast_span_start, i);
        let e = __engine(Cfg.ast.ast_span_end, i);
        let k = __engine(Cfg.ast.ast_node_kind, i);
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        let sname = __engine(Cfg.ast.sym_str, sym);
        var eff_s = s;
        var eff_e = e;
        if k == 17 {
            var p = e;
            while p < e + 60 && __engine(Cfg.ast.source_slice, p, p + 1) != "." { p = p + 1; }
            if __engine(Cfg.ast.source_slice, p, p + 1) == "." {
                p = p + 1;
                while p < e + 60 && (__engine(Cfg.ast.source_slice, p, p + 1) == " " || __engine(Cfg.ast.source_slice, p, p + 1) == "\t") { p = p + 1; }
                eff_s = p;
                var m_end = p;
                while m_end < p + 60 {
                    let ch = __engine(Cfg.ast.source_slice, m_end, m_end + 1);
                    if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" { m_end = m_end + 1; }
                    else { break; }
                }
                eff_e = m_end;
            }
        }
        if eff_s <= offset && offset <= eff_e && sname == word {
            let l = eff_e - eff_s;
            if l < best_len {
                best_len = l;
                best_nid = i;
            }
        }
        i = i + 1;
    }
    return best_nid;
}

pub fn resolve_target_node_id(best_nid: i64, word: str, node_count: i64) -> i64 {
    var target_id = __engine(Cfg.ast.ast_get_bound_target, best_nid);
    if target_id == 4294967295 || target_id < 0 { target_id = best_nid; }
    let b_kind = __engine(Cfg.ast.ast_node_kind, best_nid);
    if b_kind == 17 || (target_id == best_nid && (b_kind == 14 || b_kind == 16)) {
        var found_target = -1;
        var j = 0;
        while j < node_count && found_target == -1 {
            let jk = __engine(Cfg.ast.ast_node_kind, j);
            let js = __engine(Cfg.ast.ast_node_sym, j);
            let jname = __engine(Cfg.ast.sym_str, js);
            if jname == word {
                if b_kind == 17 {
                    if jk == 21 || jk == 3 { found_target = j; }
                } else {
                    if jk == 4 || jk == 21 || jk == 3 || jk == 1 || jk == 2 { found_target = j; }
                }
            }
            j = j + 1;
        }
        if found_target != -1 { target_id = found_target; }
    }
    return target_id;
}

pub fn resolve_nested_tree_hover(word: str, offset: i64) -> str {
    let src_len = __engine(Cfg.ast.source_len);
    if src_len <= 0 { return ""; }
    var d_start = offset;
    while d_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, d_start - 1, d_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" || ch == "." { d_start = d_start - 1; }
        else { break; }
    }
    var d_end = offset;
    while d_end < src_len {
        let ch = __engine(Cfg.ast.source_slice, d_end, d_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" { d_end = d_end + 1; }
        else { break; }
    }
    let dotted_prefix = __engine(Cfg.ast.source_slice, d_start, d_end).trim();
    let full_src = __engine(Cfg.ast.source_slice, 0, src_len);
    let p_colon = full_src.find(word + ":");
    let p_eq = full_src.find(word + " =");
    let hit = if p_colon >= 0 && (p_eq < 0 || p_colon < p_eq) { p_colon } else { p_eq };
    if hit < 0 { return ""; }
    var l_end = hit;
    while l_end < src_len {
        let ch = __engine(Cfg.ast.source_slice, l_end, l_end + 1);
        if ch == "\n" || ch == "\r" { break; }
        l_end = l_end + 1;
    }
    let decl_line = __engine(Cfg.ast.source_slice, hit, l_end).trim();
    let hdr = if dotted_prefix.find(".") >= 0 { dotted_prefix } else { word };
    return "```pilot\n" + hdr + " -> " + decl_line + "\n```\n*Declared at*: `offset " + hit + "`";
}

pub fn handle_lsp_hover(offset: i64) {
    let word = extract_ident_at_offset(offset);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "");
        return;
    }

    let node_count = __engine(Cfg.ast.ast_node_count);
    let best_nid = find_best_node_for_ident(word, offset, node_count);

    if best_nid == -1 {
        let tree_md = resolve_nested_tree_hover(word, offset);
        if tree_md != "" {
            __engine(Cfg.ast.lsp_set_result, tree_md);
            return;
        }
        mount_keywords_if_needed();
        let doc = reflect_keyword_doc(word);
        if doc != "" {
            let badge = reflect_keyword_badge(word);
            let md = format_keyword_hover_markdown(word, badge, doc);
            __engine(Cfg.ast.lsp_set_result, md);
            return;
        }
        __engine(Cfg.ast.lsp_set_result, "");
        return;
    }

    let target_id = resolve_target_node_id(best_nid, word, node_count);
    let b_kind = __engine(Cfg.ast.ast_node_kind, best_nid);
    let t_kind = __engine(Cfg.ast.ast_node_kind, target_id);

    if t_kind == 3 || b_kind == 3 {
        let fn_id = if t_kind == 3 { target_id } else { best_nid };
        let sig_str = extract_node_signature_str(fn_id);
        var md = "```pilot\n" + sig_str + "\n```";
        var doc = reflect_node_doc(fn_id);
        if doc == "" { doc = reflect_keyword_doc(word); }
        if doc != "" { md = md + "\n\n---\n" + doc; }
        let params_md = format_hover_param_list(sig_str, node_count);
        if params_md != "" { md = md + params_md; }
        let ret_md = format_hover_returns(sig_str, node_count);
        if ret_md != "" { md = md + ret_md; }
        let overloads_md = format_hover_overloads(word, fn_id, node_count);
        if overloads_md != "" { md = md + overloads_md; }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    if t_kind == 1 || b_kind == 1 || t_kind == 2 || b_kind == 2 {
        let is_iface = t_kind == 2 || (t_kind != 1 && b_kind == 2);
        let s_id = if t_kind == 1 || t_kind == 2 { target_id } else { best_nid };
        var name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, s_id));
        if name == "" { name = word; }
        let lid = __engine(Cfg.ast.ast_get_bound_layout, s_id);
        let byte_size = if lid != 4294967295 && lid >= 0 { __engine(Cfg.ast.layout_metrics, lid) } else { 0 };
        let doc = reflect_node_doc(s_id);
        let kw_hdr = if is_iface { nameof(interface) } else { nameof(struct) };
        var md = "```pilot\n" + kw_hdr + " " + name + "\n```\n*Layout Size*: `" + byte_size + " bytes`";
        let c_count = __engine(Cfg.ast.ast_child_count, s_id);
        if c_count > 0 {
            var ci = 0; var has_f = false; var has_m = false;
            while ci < c_count {
                let c_nid = __engine(Cfg.ast.ast_child_at, s_id, ci);
                let c_kind = __engine(Cfg.ast.ast_node_kind, c_nid);
                if c_kind == 21 {
                    if !has_f { md = md + "\n\n**Fields:**"; has_f = true; }
                    let c_name = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, c_nid));
                    let f_slice = __engine(Cfg.ast.source_slice, __engine(Cfg.ast.ast_span_start, c_nid), __engine(Cfg.ast.ast_span_end, c_nid)).trim();
                    let col_idx = f_slice.find(":");
                    if col_idx >= 0 {
                        var ft = f_slice.slice(col_idx + 1, f_slice.len()).trim();
                        if ft.ends_with(";") { ft = ft.slice(0, ft.len() - 1).trim(); }
                        md = md + "\n- `" + c_name + "`: " + format_type_ref_link(ft, node_count);
                    } else if c_name != "" {
                        md = md + "\n- `" + c_name + "`";
                    }
                } else if c_kind == 3 {
                    if !has_m { md = md + "\n\n**Methods:**"; has_m = true; }
                    let msig = extract_node_signature_str(c_nid);
                    if msig != "" { md = md + "\n- `" + msig + "`"; }
                }
                ci = ci + 1;
            }
        }
        let type_refs_md = format_hover_type_references(name, s_id, node_count);
        if type_refs_md != "" { md = md + type_refs_md; }
        if doc != "" { md = md + "\n\n---\n" + doc; }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    if b_kind == 21 || t_kind == 21 {
        let f_id = if b_kind == 21 { best_nid } else { target_id };
        let f_start = __engine(Cfg.ast.ast_span_start, f_id);
        var f_end = __engine(Cfg.ast.ast_span_end, f_id);
        while f_end > f_start {
            let ch = __engine(Cfg.ast.source_slice, f_end - 1, f_end);
            if ch == ";" || ch == " " || ch == "\t" || ch == "\r" || ch == "\n" { f_end = f_end - 1; } else { break; }
        }
        let f_slice = __engine(Cfg.ast.source_slice, f_start, f_end);
        let lid = __engine(Cfg.ast.ast_get_bound_layout, f_id);
        let byte_size = if lid != 4294967295 && lid >= 0 { __engine(Cfg.ast.layout_metrics, lid) } else { 0 };
        var md = "```pilot\n" + f_slice + "\n```";
        if byte_size > 0 { md = md + "\n*Layout Size*: `" + byte_size + " bytes`"; }
        let col_idx = f_slice.find(":");
        if col_idx >= 0 {
            let ft = f_slice.slice(col_idx + 1, f_slice.len()).trim();
            if ft != "" { md = md + "\n*Type*: " + format_type_ref_link(ft, node_count); }
        }
        let doc = reflect_node_doc(f_id);
        if doc != "" { md = md + "\n\n---\n" + doc; }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    if b_kind == 4 || t_kind == 4 {
        let v_id = if b_kind == 4 { best_nid } else { target_id };
        var vname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, v_id));
        if vname == "" { vname = word; }
        let lid = __engine(Cfg.ast.ast_get_bound_layout, v_id);
        let byte_size = if lid != 4294967295 && lid >= 0 { __engine(Cfg.ast.layout_metrics, lid) } else { 0 };
        var md = "```pilot\n" + nameof(let) + " " + vname;
        var resolved_tname = "";
        if target_id != v_id {
            let tname = __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, target_id));
            if tname != "" { md = md + ": " + tname; resolved_tname = tname; }
        }
        md = md + "\n```";
        if byte_size > 0 { md = md + "\n*Layout Size*: `" + byte_size + " bytes`"; }
        if resolved_tname != "" { md = md + "\n*Type*: " + format_type_ref_link(resolved_tname, node_count); }
        __engine(Cfg.ast.lsp_set_result, md);
        return;
    }

    var name = word;
    var lid = __engine(Cfg.ast.ast_get_bound_layout, best_nid);
    if lid == 4294967295 || lid < 0 { lid = __engine(Cfg.ast.ast_get_bound_layout, target_id); }
    let byte_size = if lid != 4294967295 && lid >= 0 { __engine(Cfg.ast.layout_metrics, lid) } else { 0 };
    var md = "```pilot\n" + name + "\n```";
    if byte_size > 0 { md = md + "\n*Layout Size*: `" + byte_size + " bytes`"; }
    let doc = reflect_node_doc(target_id);
    if doc != "" { md = md + "\n\n---\n" + doc; }
    __engine(Cfg.ast.lsp_set_result, md);
}

pub fn handle_lsp_completion(offset: i64) {
    let node_count = __engine(Cfg.ast.ast_node_count);
    var p = offset - 1;
    while p >= 0 {
        let ch = __engine(Cfg.ast.source_slice, p, p + 1);
        if ch != " " && ch != "\t" && ch != "\r" && ch != "\n" { break; }
        p = p - 1;
    }

    if p >= 0 && __engine(Cfg.ast.source_slice, p, p + 1) == "." {
        var r_end = p;
        while r_end > 0 {
            let ch = __engine(Cfg.ast.source_slice, r_end - 1, r_end);
            if ch != " " && ch != "\t" { break; }
            r_end = r_end - 1;
        }
        var r_start = r_end;
        while r_start > 0 {
            let ch = __engine(Cfg.ast.source_slice, r_start - 1, r_start);
            if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
                r_start = r_start - 1;
            } else { break; }
        }
        let recv_name = __engine(Cfg.ast.source_slice, r_start, r_end);
        __engine(Cfg.ast.ast_emit_diag, 0, 1, "recv=" + recv_name);

        var s_id = -1;
        if recv_name == "self" {
            var j = 0;
            while j < node_count {
                let k = __engine(Cfg.ast.ast_node_kind, j);
                if k == 1 {
                    let s = __engine(Cfg.ast.ast_span_start, j);
                    let e = __engine(Cfg.ast.ast_span_end, j);
                    if s <= offset && offset <= e {
                        s_id = j;
                    }
                }
                j = j + 1;
            }
        } else {
            var j = 0;
            while j < node_count {
                let k = __engine(Cfg.ast.ast_node_kind, j);
                if k == 4 || k == 21 {
                    let sym = __engine(Cfg.ast.ast_node_sym, j);
                    let nm = __engine(Cfg.ast.sym_str, sym);
                    if nm == recv_name {
                        let tid = __engine(Cfg.ast.ast_get_bound_target, j);
                        if tid != 4294967295 && tid >= 0 {
                            let tk = __engine(Cfg.ast.ast_node_kind, tid);
                            if tk == 1 {
                                s_id = tid;
                            }
                        }
                        if s_id == -1 {
                            let var_lid = __engine(Cfg.ast.ast_get_bound_layout, j);
                            if var_lid != 4294967295 {
                                var sj = 0;
                                while sj < node_count {
                                    if __engine(Cfg.ast.ast_node_kind, sj) == 1 {
                                        let s_lid = __engine(Cfg.ast.ast_get_bound_layout, sj);
                                        if s_lid == var_lid {
                                            s_id = sj;
                                        }
                                    }
                                    sj = sj + 1;
                                }
                            }
                        }
                    }
                }
                j = j + 1;
            }
        }

        if s_id != -1 {
            let is_inside_struct = (recv_name == "self");
            let c_count = __engine(Cfg.ast.ast_child_count, s_id);
            var items_json = "[";
            var added = 0;
            var ci = 0;
            while ci < c_count {
                let c_nid = __engine(Cfg.ast.ast_child_at, s_id, ci);
                let c_kind = __engine(Cfg.ast.ast_node_kind, c_nid);
                let c_sym = __engine(Cfg.ast.ast_node_sym, c_nid);
                let c_name = __engine(Cfg.ast.sym_str, c_sym);
                if c_name != "" {
                    let c_start = __engine(Cfg.ast.ast_span_start, c_nid);
                    var is_pub = false;
                    var is_priv = false;
                    if c_start == 4294967295 || c_start < 0 {
                        let df = __engine("ast_decl_flags", c_nid);
                        let vis = df & 15;
                        if vis >= 7 || (vis == 0 && df == 0) { is_pub = true; }
                        else if vis == 0 { is_priv = true; }
                        else { is_pub = true; }
                    } else {
                        let lead_start = if c_start >= 16 { c_start - 16 } else { 0 };
                        var p_scan = lead_start;
                        while p_scan < c_start {
                            let s4 = __engine(Cfg.ast.source_slice, p_scan, p_scan + 4);
                            if s4 == "pub " || s4 == "open" { is_pub = true; }
                            let s5 = __engine(Cfg.ast.source_slice, p_scan, p_scan + 5);
                            if s5 == "priv " { is_priv = true; }
                            let s7 = __engine(Cfg.ast.source_slice, p_scan, p_scan + 7);
                            if s7 == "export " { is_pub = true; }
                            p_scan = p_scan + 1;
                        }
                    }
                    let is_hidden = if c_kind == 3 { !is_pub } else { is_priv };
                    if is_inside_struct || !is_hidden {
                        if added > 0 { items_json = items_json + ", "; }
                        let k_str = if c_kind == 3 { "2" } else { "5" };
                        items_json = items_json + '{"label":"' + c_name + '","kind":' + k_str + '}';
                        added = added + 1;
                    }
                }
                ci = ci + 1;
            }
            items_json = items_json + "]";
            __engine(Cfg.ast.lsp_set_result, items_json);
            return;
        }
    }

    var comp_json = "[";
    var c_count = 0;
    var ci = 0;
    while ci < node_count && c_count < 60 {
        let ck = __engine(Cfg.ast.ast_node_kind, ci);
        if ck == 3 || ck == 1 || ck == 2 {
            let csym = __engine(Cfg.ast.ast_node_sym, ci);
            let cname = __engine(Cfg.ast.sym_str, csym);
            if cname != "" && !cname.starts_with("__") {
                if c_count > 0 { comp_json = comp_json + ", "; }
                let k_val = if ck == 3 { "2" } else if ck == 1 { "7" } else { "8" };
                comp_json = comp_json + '{"label":"' + cname + '","kind":' + k_val + '}';
                c_count = c_count + 1;
            }
        }
        ci = ci + 1;
    }
    comp_json = comp_json + "]";
    __engine(Cfg.ast.lsp_set_result, comp_json);
}

pub fn handle_lsp_definition(offset: i64) {
    let word = extract_ident_at_offset(offset);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    let best_nid = find_best_node_for_ident(word, offset, node_count);
    if best_nid != -1 {
        let target_id = resolve_target_node_id(best_nid, word, node_count);
        let s = __engine(Cfg.ast.ast_span_start, target_id);
        let e = __engine(Cfg.ast.ast_span_end, target_id);
        if s == 4294967295 || s < 0 {
            let res = "{\"targetNode\":" + target_id + ",\"isImported\":true}";
            __engine(Cfg.ast.lsp_set_result, res);
            return;
        }
        let pub_s = if s >= 4 { s - 4 } else { s };
        let ident_s = s + 3;
        let pat = "pub " + nameof(fn) + " " + word;
        let pat_len = 7 + word.len();
        var first_decl = pub_s;
        var first_ident = ident_s;
        var scan_p = 0;
        while scan_p + pat_len <= s {
            if __engine(Cfg.ast.source_slice, scan_p, scan_p + pat_len) == pat {
                first_decl = scan_p;
                first_ident = scan_p + 7;
                scan_p = s + 1;
            } else {
                scan_p = scan_p + 1;
            }
        }
        let res = "{\"start\":" + s + ",\"end\":" + e + ",\"pubStart\":" + pub_s + ",\"identStart\":" + ident_s + ",\"declOffset\":" + first_decl + ",\"identOffset\":" + first_ident + "}";
        __engine(Cfg.ast.lsp_set_result, res);
        return;
    }
    __engine(Cfg.ast.lsp_set_result, "null");
}

pub fn handle_lsp_references(offset: i64) {
    let word = extract_ident_at_offset(offset);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "[]");
        return;
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var refs_json = "[";
    var added = 0;
    var i = 0;
    while i < node_count {
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        let sname = __engine(Cfg.ast.sym_str, sym);
        if sname == word {
            let s = __engine(Cfg.ast.ast_span_start, i);
            let e = __engine(Cfg.ast.ast_span_end, i);
            if s != 4294967295 && s >= 0 {
                let k = __engine(Cfg.ast.ast_node_kind, i);
                var eff_s = s;
                var eff_e = e;
                if k == 17 {
                    var p = e;
                    while p < e + 60 && __engine(Cfg.ast.source_slice, p, p + 1) != "." { p = p + 1; }
                    if __engine(Cfg.ast.source_slice, p, p + 1) == "." {
                        p = p + 1;
                        while p < e + 60 && (__engine(Cfg.ast.source_slice, p, p + 1) == " " || __engine(Cfg.ast.source_slice, p, p + 1) == "\t") { p = p + 1; }
                        eff_s = p;
                        var m_end = p;
                        while m_end < p + 60 {
                            let ch = __engine(Cfg.ast.source_slice, m_end, m_end + 1);
                            if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" { m_end = m_end + 1; }
                            else { break; }
                        }
                        eff_e = m_end;
                    }
                }
                if added > 0 { refs_json = refs_json + ","; }
                refs_json = refs_json + '{"start":' + eff_s + ',"end":' + eff_e + '}';
                added = added + 1;
            }
        }
        i = i + 1;
    }
    refs_json = refs_json + "]";
    __engine(Cfg.ast.lsp_set_result, refs_json);
}

fn mount_unit_safe(path: str) -> i64 {
    let r1 = __engine(Cfg.ast.mount_unit, path);
    if r1 != null && r1 >= 0 { return r1; }
    let r2 = __engine(Cfg.ast.mount_unit, "../../" + path);
    return if r2 != null { r2 } else { -1 };
}

fn mount_keywords_if_needed() {
    if __engine(Cfg.ast.ast_node_count) < 100 {
        mount_unit_safe("stdlib/core/keywords.pilot");
    }
}

fn resolve_import_path(spec: str) -> str {
    if spec.find("Pilot.Core.Reflect") >= 0 { return "stdlib/core/reflect.pilot"; }
    if spec.find("Pilot.Core.Keywords") >= 0 { return "stdlib/core/keywords.pilot"; }
    if spec.find("Pilot.Core.Option") >= 0 { return "stdlib/core/option.pilot"; }
    if spec.find("Pilot.Core.Result") >= 0 { return "stdlib/core/result.pilot"; }
    if spec.find("Pilot.Core.Memory") >= 0 { return "stdlib/core/mem.pilot"; }
    if spec.find("Pilot.Core.Meta") >= 0 { return "stdlib/core/meta.pilot"; }
    if spec.find("Pilot.Core.Bootstrap") >= 0 { return "stdlib/core/bootstrap.pilot"; }
    if spec.find("Pilot.Core.Task") >= 0 { return "stdlib/core/task.pilot"; }
    if spec.find("Pilot.Collections") >= 0 { return "stdlib/collections/list.pilot"; }
    if spec.find("Pilot.Crypto") >= 0 { return "stdlib/crypto/hash.pilot"; }
    return "";
}

pub fn mount_single_import(raw_spec: str) {
    let std_p = resolve_import_path(raw_spec);
    if std_p != "" && mount_unit_safe(std_p) >= 0 { return; }
    var spec = raw_spec;
    let n = spec.len();
    if n > 2 && spec.slice(n - 2, n) == ".*" { spec = spec.slice(0, n - 2); }
    let n2 = spec.len();
    if n2 > 1 && spec.slice(n2 - 1, n2) == ";" { spec = spec.slice(0, n2 - 1); }
    var rel = "";
    var i = 0;
    while i < spec.len() {
        let ch = spec.slice(i, i + 1);
        rel = if ch == "." { rel + "/" } else { rel + ch };
        i = i + 1;
    }
    if mount_unit_safe(".pilotvenv/packages/" + rel + ".pilot") >= 0 { return; }
    if mount_unit_safe("venv/packages/" + rel + ".pilot") >= 0 { return; }
    if mount_unit_safe("src/" + rel + ".pilot") >= 0 { return; }
    if mount_unit_safe(rel + ".pilot") >= 0 { return; }
    let _ = mount_unit_safe("stdlib/" + rel + ".pilot");
}

pub fn mount_doc_imports() {
    let total = __engine(Cfg.ast.ast_node_count);
    var idx = 0;
    while idx < total {
        if __engine("ast_orig_kind", idx) == 1 {
            let sym = __engine(Cfg.ast.ast_node_sym, idx);
            if sym != 0 {
                let spec = __engine(Cfg.ast.sym_str, sym);
                if spec != "" { mount_single_import(spec); }
            }
        }
        idx = idx + 1;
    }
}

pub fn is_keyword_or_seed(w: str) -> bool {
    if w == "" { return true; }
    if w == nameof(__engine) || w == nameof(struct) || w == nameof(interface) || w == nameof(fn) ||
       w == nameof(let) || w == nameof(ref) || w == nameof(if) || w == nameof(loop) ||
       w == nameof(return) || w == nameof(yield) || w == nameof(defer) || w == nameof(comptime) ||
       w == nameof(quote) || w == nameof(asm) {
        return true;
    }
    mount_keywords_if_needed();
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        if __engine(Cfg.ast.ast_node_kind, i) == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, i);
            if (ac == 2 || ac == 3) && __engine(Cfg.ast.sym_str, __engine(Cfg.ast.ast_node_sym, i)) == w {
                return true;
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn handle_lsp_prepare_rename(offset: i64) {
    let word = extract_ident_at_offset(offset);
    if word == "" || is_keyword_or_seed(word) {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    let best_nid = find_best_node_for_ident(word, offset, node_count);
    if best_nid != -1 {
        let sym = __engine(Cfg.ast.ast_node_sym, best_nid);
        let sname = __engine(Cfg.ast.sym_str, sym);
        let sym_name = if sname != "" { sname } else { word };
        __engine(Cfg.ast.lsp_set_result, if is_keyword_or_seed(sym_name) { "null" } else { sym_name });
        return;
    }
    __engine(Cfg.ast.lsp_set_result, word);
}

pub fn handle_lsp_rename(offset: i64, method_str: str) {
    let pfx = "textDocument/rename:";
    if method_str.len() > pfx.len() && method_str.slice(0, pfx.len()) == pfx {
        let target_word = method_str.slice(pfx.len(), method_str.len());
        if is_keyword_or_seed(target_word) {
            __engine(Cfg.ast.lsp_set_result, "null");
            return;
        }
    }
    handle_lsp_prepare_rename(offset);
}

mount_doc_imports();

let _lsp_method = __engine(Cfg.ast.lsp_query_method);
let _lsp_offset = __engine(Cfg.ast.lsp_query_offset);

if _lsp_method == "textDocument/hover" { handle_lsp_hover(_lsp_offset); }
else if _lsp_method == "textDocument/completion" { handle_lsp_completion(_lsp_offset); }
else if _lsp_method == "textDocument/definition" { handle_lsp_definition(_lsp_offset); }
else if _lsp_method == "textDocument/prepareRename" { handle_lsp_prepare_rename(_lsp_offset); }
else if _lsp_method == "textDocument/references" { handle_lsp_references(_lsp_offset); }
else if _lsp_method != "" && _lsp_method != "ide-sync" { handle_lsp_rename(_lsp_offset, _lsp_method); }
