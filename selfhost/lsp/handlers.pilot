    }
    __engine(Cfg.ast.lsp_set_result, "null");
}

pub fn handle_lsp_references(offset: i64) {
    let cur_ch = __engine(Cfg.ast.source_slice, offset, offset + 1);
    let is_ident = (cur_ch >= "a" && cur_ch <= "z") || (cur_ch >= "A" && cur_ch <= "Z") || (cur_ch >= "0" && cur_ch <= "9") || cur_ch == "_";
    if !is_ident {
        __engine(Cfg.ast.lsp_set_result, "[]");
        return;
    }

    var w_start = offset;
    var scan_wstart = true;
    while scan_wstart && w_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, w_start - 1, w_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_start = w_start - 1;
        } else {
            scan_wstart = false;
        }
    }
    var w_end = offset;
    var scan_wend = true;
    while scan_wend && w_end < offset + 40 {
        let ch = __engine(Cfg.ast.source_slice, w_end, w_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_end = w_end + 1;
        } else {
            scan_wend = false;
        }
    }
    let word = __engine(Cfg.ast.source_slice, w_start, w_end);
    if word == "" {
        __engine(Cfg.ast.lsp_set_result, "[]");
        return;
    }

    let node_count = __engine(Cfg.ast.ast_node_count);
    var refs_json = "[";
    var added = 0;
    var i = 0;
    while i < node_count {
        let sym = __engine(Cfg.ast.ast_node_sym, i);
        let sname = __engine(Cfg.ast.sym_str, sym);
        if sname == word {
            let s = __engine(Cfg.ast.ast_span_start, i);
            let e = __engine(Cfg.ast.ast_span_end, i);
            let k = __engine(Cfg.ast.ast_node_kind, i);
            var eff_s = s;
            var eff_e = e;
            if k == 17 {
                var p = e;
                while p < e + 60 && __engine(Cfg.ast.source_slice, p, p + 1) != "." {
                    p = p + 1;
                }
                if __engine(Cfg.ast.source_slice, p, p + 1) == "." {
                    p = p + 1;
                    while p < e + 60 && (__engine(Cfg.ast.source_slice, p, p + 1) == " " || __engine(Cfg.ast.source_slice, p, p + 1) == "\t") {
                        p = p + 1;
                    }
                    eff_s = p;
                    var m_end = p;
                    var scan_m = true;
                    while scan_m && m_end < p + 60 {
                        let ch = __engine(Cfg.ast.source_slice, m_end, m_end + 1);
                        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
                            m_end = m_end + 1;
                        } else {
                            scan_m = false;
                        }
                    }
                    eff_e = m_end;
                }
            }
            if added > 0 {
                refs_json = refs_json + ",";
            }
            refs_json = refs_json + '{"start":' + eff_s + ',"end":' + eff_e + '}';
            added = added + 1;
        }
        i = i + 1;
    }
    refs_json = refs_json + "]";
    __engine(Cfg.ast.lsp_set_result, refs_json);
}

pub fn is_keyword_or_seed(w: str) -> bool {
    if w == "" {
        return true;
    }
    if w == nameof(__engine) || w == nameof(struct) || w == nameof(interface) || w == nameof(fn) ||
       w == nameof(let) || w == nameof(ref) || w == nameof(if) || w == nameof(loop) ||
       w == nameof(return) || w == nameof(yield) || w == nameof(defer) || w == nameof(comptime) ||
       w == nameof(quote) || w == nameof(asm) {
        return true;
    }
    if __engine(Cfg.ast.ast_node_count) < 100 {
        __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
        if __engine(Cfg.ast.ast_node_count) < 100 {
            __engine(Cfg.ast.mount_unit, "../../stdlib/core/keywords.pilot");
        }
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if nm == w {
                    return true;
                }
            }
        }
        i = i + 1;
    }
    return false;
}

pub fn handle_lsp_prepare_rename(offset: i64) {
    let cur_ch = __engine(Cfg.ast.source_slice, offset, offset + 1);
    let is_ident = (cur_ch >= "a" && cur_ch <= "z") || (cur_ch >= "A" && cur_ch <= "Z") || (cur_ch >= "0" && cur_ch <= "9") || cur_ch == "_";
    if !is_ident {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }

    var w_start = offset;
    while w_start > 0 {
        let ch = __engine(Cfg.ast.source_slice, w_start - 1, w_start);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_start = w_start - 1;
        } else {
            break;
        }
    }
    var w_end = offset;
    while w_end < offset + 60 {
        let ch = __engine(Cfg.ast.source_slice, w_end, w_end + 1);
        if (ch >= "a" && ch <= "z") || (ch >= "A" && ch <= "Z") || (ch >= "0" && ch <= "9") || ch == "_" {
            w_end = w_end + 1;
        } else {
            break;
        }
    }
    let word = __engine(Cfg.ast.source_slice, w_start, w_end);
    if is_keyword_or_seed(word) {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }

    let node_count = __engine(Cfg.ast.ast_node_count);
    var best_nid = -1;
    var best_len = 999999999;
    var i = 0;
    while i < node_count {
        let s = __engine(Cfg.ast.ast_span_start, i);
        let e = __engine(Cfg.ast.ast_span_end, i);
        if s <= offset && offset <= e {
            let l = e - s;
            if l < best_len {
                best_len = l;
                best_nid = i;
            }
        }
        i = i + 1;
    }

    if best_nid != -1 {
        let s = __engine(Cfg.ast.ast_span_start, best_nid);
        let e = __engine(Cfg.ast.ast_span_end, best_nid);
        let sym = __engine(Cfg.ast.ast_node_sym, best_nid);
        var sym_name = __engine(Cfg.ast.sym_str, sym);
        if sym_name == "" {
            sym_name = word;
        }
        if is_keyword_or_seed(sym_name) {
            __engine(Cfg.ast.lsp_set_result, "null");
        } else {
            __engine(Cfg.ast.lsp_set_result, sym_name);
        }
        return;
    }
    __engine(Cfg.ast.lsp_set_result, word);
}

pub fn handle_lsp_rename(offset: i64, method_str: str) {
    if method_str == "textDocument/rename:" + nameof(__engine) || method_str == "textDocument/rename:" + nameof(struct) ||
       method_str == "textDocument/rename:" + nameof(interface) || method_str == "textDocument/rename:" + nameof(fn) ||
       method_str == "textDocument/rename:" + nameof(let) || method_str == "textDocument/rename:" + nameof(ref) ||
       method_str == "textDocument/rename:" + nameof(if) || method_str == "textDocument/rename:" + nameof(loop) ||
       method_str == "textDocument/rename:" + nameof(return) || method_str == "textDocument/rename:" + nameof(yield) ||
       method_str == "textDocument/rename:" + nameof(defer) || method_str == "textDocument/rename:" + nameof(comptime) ||
       method_str == "textDocument/rename:" + nameof(quote) || method_str == "textDocument/rename:" + nameof(asm) {
        __engine(Cfg.ast.lsp_set_result, "null");
        return;
    }

    if __engine(Cfg.ast.ast_node_count) < 100 {
        __engine(Cfg.ast.mount_unit, "stdlib/core/keywords.pilot");
        if __engine(Cfg.ast.ast_node_count) < 100 {
            __engine(Cfg.ast.mount_unit, "../../stdlib/core/keywords.pilot");
        }
    }
    let node_count = __engine(Cfg.ast.ast_node_count);
    var i = 0;
    while i < node_count {
        let k = __engine(Cfg.ast.ast_node_kind, i);
        if k == 1 {
            let ac = __engine(Cfg.ast.ast_attr_count, i);
            if ac == 2 || ac == 3 {
                let sym = __engine(Cfg.ast.ast_node_sym, i);
                let nm = __engine(Cfg.ast.sym_str, sym);
                if method_str == "textDocument/rename:" + nm {
                    __engine(Cfg.ast.lsp_set_result, "null");
                    return;
                }
            }
        }
        i = i + 1;
    }

    handle_lsp_prepare_rename(offset);
}

let _lsp_method = __engine(Cfg.ast.lsp_query_method);
let _lsp_offset = __engine(Cfg.ast.lsp_query_offset);

if _lsp_method == "textDocument/hover" {
    handle_lsp_hover(_lsp_offset);
}
if _lsp_method == "textDocument/completion" {
    handle_lsp_completion(_lsp_offset);
}
if _lsp_method == "textDocument/definition" {
    handle_lsp_definition(_lsp_offset);
}
if _lsp_method == "textDocument/prepareRename" {
    handle_lsp_prepare_rename(_lsp_offset);
}
if _lsp_method == "textDocument/references" {
    handle_lsp_references(_lsp_offset);
}
if _lsp_method != "" && _lsp_method != "ide-sync" && _lsp_method != "textDocument/hover" && _lsp_method != "textDocument/completion" && _lsp_method != "textDocument/definition" && _lsp_method != "textDocument/prepareRename" && _lsp_method != "textDocument/references" {
    handle_lsp_rename(_lsp_offset, _lsp_method);
}
