// =========================================================================
// FILE: selfhost/lsp/server.pilot
// Milestone 59.2: Persistent PilVM LSP Server & Content-Length Framing
// Replaces crates/pilot-lsp and crates/pilot-lsp-macros in Pure Pilot.
// =========================================================================
pub pkg Pilot.SelfHost.Lsp.Server;

pub pure fn nameof(sym: str) -> str => sym;

[Layout(c_abi)]
pub struct LspQueryAttr {
    pub method_name: str;
    pub weight:      i32;
}

pub fn encode_lsp_frame(json_payload: str) -> str {
    let byte_len = __engine("str_len", json_payload);
    return "Content-Length: " + byte_len + "\r\n\r\n" + json_payload;
}

pub fn route_lsp_request(method: str, req_id: i64) -> str {
    if method == "initialize" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true}}}}";
    }
    if method == "shutdown" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":null}";
    }
    if method == "textDocument/hover" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```pilot\\n" + nameof(fn) + " resident_pilvm_lsp()\\n```\"}}}";
    }
    if method == "textDocument/completion" {
        return "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":[{\"label\":\"" + nameof(fn) + "\",\"kind\":14},{\"label\":\"" + nameof(struct) + "\",\"kind\":14},{\"label\":\"" + nameof(interface) + "\",\"kind\":14}]}";
    }
    return "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":null}";
}
