// =========================================================================
// FILE: selfhost/lsp/server.pilot
// Milestone 59.2: Persistent PilVM LSP Server & Content-Length Framing
// Replaces crates/pilot-lsp and crates/pilot-lsp-macros in Pure Pilot.
// =========================================================================
pub pkg Pilot.SelfHost.Lsp.Server;

pub pure fn nameof(sym: str) -> str => sym;

fn lsp_find_substr(haystack: str, needle: str, start_pos: i64) -> i64 {
    let h_len = __engine("str_len", haystack);
    let n_len = __engine("str_len", needle);
    if n_len == 0 || start_pos < 0 || start_pos + n_len > h_len {
        return -1;
    }
    var i = start_pos;
    while i + n_len <= h_len {
        if __engine("str_slice", haystack, i, i + n_len) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn lsp_parse_int_at(s: str, start_pos: i64) -> i64 {
    let n = __engine("str_len", s);
    var i = start_pos;
    while i < n {
        let b = __engine("str_byte_at", s, i);
        if b == 32 || b == 9 || b == 58 {
            i = i + 1;
        } else {
            break;
        }
    }
    var val = 0;
    var found = false;
    while i < n {
        let b = __engine("str_byte_at", s, i);
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48);
            found = true;
            i = i + 1;
        } else {
            break;
        }
    }
    if !found {
        return -1;
    }
    return val;
}

fn lsp_extract_json_str_field(json_str: str, key: str) -> str {
    let pat = "\"" + key + "\":\"";
    let idx = lsp_find_substr(json_str, pat, 0);
    if idx < 0 {
        return "";
    }
    let n = __engine("str_len", json_str);
    var i = idx + __engine("str_len", pat);
    var out = "";
    while i < n {
        let b = __engine("str_byte_at", json_str, i);
        if b == 92 && i + 1 < n {
            let nb = __engine("str_byte_at", json_str, i + 1);
            if nb == 110 {
                out = out + "\n";
            } else if nb == 114 {
                out = out + "\r";
            } else if nb == 116 {
                out = out + "\t";
            } else if nb == 34 {
                out = out + "\"";
            } else if nb == 92 {
                out = out + "\\";
            } else {
                out = out + __engine("str_slice", json_str, i + 1, i + 2);
            }
            i = i + 2;
        } else if b == 34 {
            return out;
        } else {
            out = out + __engine("str_slice", json_str, i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

fn lsp_extract_json_int_field(json_str: str, key: str) -> i64 {
    let pat = "\"" + key + "\":";
    let idx = lsp_find_substr(json_str, pat, 0);
    if idx < 0 {
        return -1;
    }
    return lsp_parse_int_at(json_str, idx + __engine("str_len", pat));
}

fn lsp_escape_json_str(s: str) -> str {
    let n = __engine("str_len", s);
    var out = "";
    var i = 0;
    while i < n {
        let b = __engine("str_byte_at", s, i);
        if b == 34 {
            out = out + "\\\"";
        } else if b == 92 {
            out = out + "\\\\";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + __engine("str_slice", s, i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn lsp_extract_hover_signature(doc: str, offset: i64) -> str {
    let n = __engine("str_len", doc);
    if n == 0 {
        return "";
    }
    let cl_off = if offset < 0 { 0 } else { if offset >= n { n - 1 } else { offset } };
    var line_start = cl_off;
    while line_start > 0 {
        let b = __engine("str_byte_at", doc, line_start - 1);
        if b == 10 || b == 123 || b == 125 || b == 59 {
            break;
        }
        line_start = line_start - 1;
    }
    while line_start < n {
        let b = __engine("str_byte_at", doc, line_start);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            line_start = line_start + 1;
        } else {
            break;
        }
    }
    var sig_end = line_start;
    while sig_end < n {
        let b = __engine("str_byte_at", doc, sig_end);
        if b == 123 || b == 59 || b == 10 {
            break;
        }
        sig_end = sig_end + 1;
    }
    while sig_end > line_start {
        let b = __engine("str_byte_at", doc, sig_end - 1);
        if b == 32 || b == 9 || b == 13 {
            sig_end = sig_end - 1;
        } else {
            break;
        }
    }
    return __engine("str_slice", doc, line_start, sig_end);
}

pub pure fn lsp_format_hover_params(sig: str) -> str {
    let slen = __engine("str_len", sig);
    var p_open = -1;
    var i = 0;
    while i < slen && p_open == -1 {
        if __engine("str_slice", sig, i, i + 1) == "(" {
            p_open = i;
        }
        i = i + 1;
    }
    if p_open == -1 { return ""; }

    var p_close = -1;
    var depth = 1;
    var j = p_open + 1;
    while j < slen && p_close == -1 {
        let ch = __engine("str_slice", sig, j, j + 1);
        if ch == "(" {
            depth = depth + 1;
        } else if ch == ")" {
            depth = depth - 1;
            if depth == 0 {
                p_close = j;
            }
        }
        j = j + 1;
    }
    if p_close <= p_open + 1 { return ""; }

    let inner = __engine("str_slice", sig, p_open + 1, p_close).trim();
    if inner == "" { return ""; }

    var out = "\\n\\n**Parameters:**";
    var start_idx = 0;
    let in_len = __engine("str_len", inner);
    var k = 0;
    var comma_depth = 0;
    while k <= in_len {
        let is_sep = if k == in_len { true } else {
            let c = __engine("str_slice", inner, k, k + 1);
            if c == "<" || c == "(" || c == "[" { comma_depth = comma_depth + 1; }
            else if c == ">" || c == ")" || c == "]" { if comma_depth > 0 { comma_depth = comma_depth - 1; } }
            comma_depth == 0 && c == ","
        };
        if is_sep {
            let param_raw = __engine("str_slice", inner, start_idx, k).trim();
            if param_raw != "" {
                var colon_pos = -1;
                var ci = 0;
                let plen = __engine("str_len", param_raw);
                while ci < plen && colon_pos == -1 {
                    if __engine("str_slice", param_raw, ci, ci + 1) == ":" {
                        colon_pos = ci;
                    }
                    ci = ci + 1;
                }
                if colon_pos >= 0 {
                    let pname = __engine("str_slice", param_raw, 0, colon_pos).trim();
                    let ptype = __engine("str_slice", param_raw, colon_pos + 1, plen).trim();
                    out = out + "\\n- `" + pname + "`: [`" + ptype + "`](#" + ptype + ")";
                } else {
                    out = out + "\\n- `" + param_raw + "`";
                }
            }
            start_idx = k + 1;
        }
        k = k + 1;
    }
    return out;
}

pub pure fn lsp_format_hover_returns(sig: str) -> str {
    let slen = __engine("str_len", sig);
    var arrow_pos = -1;
    var i = 0;
    while i + 2 <= slen && arrow_pos == -1 {
        if __engine("str_slice", sig, i, i + 2) == "->" {
            arrow_pos = i;
        }
        i = i + 1;
    }
    if arrow_pos == -1 { return ""; }

    var ret_part = __engine("str_slice", sig, arrow_pos + 2, slen).trim();
    if ret_part == "" { return ""; }

    return "\\n\\n**Returns:**\\n- [`" + ret_part + "`](#" + ret_part + ")";
}

pub pure fn lsp_is_ident_byte(b: i64) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95;
}

pub pure fn lsp_ident_at_offset(doc: str, offset: i64) -> str {
    let n = __engine("str_len", doc);
    if n == 0 || offset < 0 || offset >= n { return ""; }
    var s = offset;
    while s > 0 && lsp_is_ident_byte(__engine("str_byte_at", doc, s - 1)) { s = s - 1; }
    var e = offset;
    while e < n && lsp_is_ident_byte(__engine("str_byte_at", doc, e)) { e = e + 1; }
    if e <= s { return ""; }
    return __engine("str_slice", doc, s, e);
}

pub pure fn lsp_format_hover_overloads(doc: str, ident: str, cur_sig: str) -> str {
    if ident == "" { return ""; }
    let pat = nameof(fn) + " " + ident + "(";
    let plen = __engine("str_len", pat);
    let dlen = __engine("str_len", doc);
    var pos = 0;
    var count = 0;
    var list_md = "";
    while pos + plen <= dlen {
        let hit = lsp_find_substr(doc, pat, pos);
        if hit < 0 { break; }
        let ov_sig = lsp_extract_hover_signature(doc, hit);
        if ov_sig != "" && ov_sig != cur_sig {
            count = count + 1;
            list_md = list_md + "\\n" + count + ". `" + lsp_escape_json_str(ov_sig) + "` *(offset " + hit + ")*";
        }
        pos = hit + plen;
    }
    if count == 0 { return ""; }
    return "\\n\\n**Overloads (" + count + "):**" + list_md;
}

pub pure fn lsp_format_hover_type_refs(doc: str, ident: str, cur_sig: str) -> str {
    if ident == "" { return ""; }
    let pat = ": " + ident;
    let plen = __engine("str_len", pat);
    let dlen = __engine("str_len", doc);
    var pos = 0;
    var count = 0;
    var list_md = "";
    while pos + plen <= dlen && count < 8 {
        let hit = lsp_find_substr(doc, pat, pos);
        if hit < 0 { break; }
        let after_idx = hit + plen;
        let boundary_ok = if after_idx >= dlen { true } else { !lsp_is_ident_byte(__engine("str_byte_at", doc, after_idx)) };
        if boundary_ok {
            let ref_sig = lsp_extract_hover_signature(doc, hit);
            if ref_sig != "" && ref_sig != cur_sig {
                count = count + 1;
                list_md = list_md + "\\n- [`" + lsp_escape_json_str(ref_sig) + "`](#offset-" + hit + ")";
            }
        }
        pos = hit + plen;
    }
    if count == 0 { return ""; }
    return "\\n\\n**Type References (" + count + "):**" + list_md;
}

pub fn encode_lsp_frame(json_payload: str) -> str {
    let byte_len = json_payload.len();
    return "Content-Length: " + byte_len + "\r\n\r\n" + json_payload;
}

pub fn lsp_session_new() -> i64 {
    let sess = __engine("map_new");
    let _init = __engine("map_set", sess, "last_doc", "");
    return sess;
}

pub fn lsp_session_feed_stream(sess: i64, framed_stream: str) -> str {
    let total_len = framed_stream.len();
    var pos = 0;
    var out_frames = "";
    while pos < total_len {
        let cl_idx = lsp_find_substr(framed_stream, "Content-Length:", pos);
        if cl_idx < 0 {
            break;
        }
        let hdr_end = lsp_find_substr(framed_stream, "\r\n\r\n", cl_idx);
        if hdr_end < 0 {
            break;
        }
        let body_len = lsp_parse_int_at(framed_stream, cl_idx + 15);
        let body_start = hdr_end + 4;
        if body_len < 0 || body_start + body_len > total_len {
            break;
        }
        let msg = framed_stream.slice(body_start, body_start + body_len);
        pos = body_start + body_len;

        let method = lsp_extract_json_str_field(msg, "method");
        let req_id = lsp_extract_json_int_field(msg, "id");
        let uri = lsp_extract_json_str_field(msg, "uri");

        if method == "initialize" {
            let init_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true}}}}";
            out_frames = out_frames + encode_lsp_frame(init_json);
        } else if method == "textDocument/didOpen" || method == "textDocument/didChange" {
            var new_text = lsp_extract_json_str_field(msg, "text");
            if uri != "" {
                let _s1 = __engine("map_set", sess, "doc:" + uri, new_text);
            }
            let _s2 = __engine("map_set", sess, "last_doc", new_text);
        } else if method == "textDocument/hover" {
            let offset = lsp_extract_json_int_field(msg, "offset");
            var doc = "";
            if uri != "" {
                doc = __engine("map_get", sess, "doc:" + uri);
            }
            if doc == "" {
                doc = __engine("map_get", sess, "last_doc");
            }
            let sig = lsp_extract_hover_signature(doc, offset);
            let ident = lsp_ident_at_offset(doc, offset);
            let esc_sig = lsp_escape_json_str(sig);
            let p_md = lsp_format_hover_params(sig);
            let r_md = lsp_format_hover_returns(sig);
            let ov_md = lsp_format_hover_overloads(doc, ident, sig);
            let tr_md = lsp_format_hover_type_refs(doc, ident, sig);
            let hover_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```pilot\\n" + esc_sig + "\\n```" + p_md + r_md + ov_md + tr_md + "\"}}}";
            out_frames = out_frames + encode_lsp_frame(hover_json);
        } else if method == "textDocument/completion" {
            let comp_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":[{\"label\":\"" + nameof(fn) + "\",\"kind\":14},{\"label\":\"" + nameof(struct) + "\",\"kind\":14},{\"label\":\"" + nameof(interface) + "\",\"kind\":14}]}";
            out_frames = out_frames + encode_lsp_frame(comp_json);
        } else if method == "shutdown" {
            let shut_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":null}";
            out_frames = out_frames + encode_lsp_frame(shut_json);
        }
    }
    return out_frames;
}
