// =========================================================================
// FILE: selfhost/lsp/server.pilot
// Milestone 59.2: Persistent PilVM LSP Server & Content-Length Framing
// Replaces crates/pilot-lsp and crates/pilot-lsp-macros in Pure Pilot.
// =========================================================================
pub pkg Pilot.SelfHost.Lsp.Server;

pub pure fn nameof(sym: str) -> str => sym;

fn lsp_find_substr(haystack: str, needle: str, start_pos: i64) -> i64 {
    let h_len = haystack.len();
    let n_len = needle.len();
    if n_len == 0 || start_pos < 0 || start_pos + n_len > h_len {
        return -1;
    }
    var i = start_pos;
    while i + n_len <= h_len {
        if haystack.slice(i, i + n_len) == needle {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

fn lsp_parse_int_at(s: str, start_pos: i64) -> i64 {
    let n = s.len();
    var i = start_pos;
    while i < n {
        let b = s.byte_at(i);
        if b == 32 || b == 9 || b == 58 {
            i = i + 1;
        } else {
            break;
        }
    }
    var val = 0;
    var found = false;
    while i < n {
        let b = s.byte_at(i);
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48);
            found = true;
            i = i + 1;
        } else {
            break;
        }
    }
    if !found {
        return -1;
    }
    return val;
}

fn lsp_extract_json_str_field(json_str: str, key: str) -> str {
    let pat = "\"" + key + "\":\"";
    let idx = lsp_find_substr(json_str, pat, 0);
    if idx < 0 {
        return "";
    }
    let n = json_str.len();
    var i = idx + pat.len();
    var out = "";
    while i < n {
        let b = json_str.byte_at(i);
        if b == 92 && i + 1 < n {
            let nb = json_str.byte_at(i + 1);
            if nb == 110 {
                out = out + "\n";
            } else if nb == 114 {
                out = out + "\r";
            } else if nb == 116 {
                out = out + "\t";
            } else if nb == 34 {
                out = out + "\"";
            } else if nb == 92 {
                out = out + "\\";
            } else {
                out = out + json_str.slice(i + 1, i + 2);
            }
            i = i + 2;
        } else if b == 34 {
            return out;
        } else {
            out = out + json_str.slice(i, i + 1);
            i = i + 1;
        }
    }
    return out;
}

fn lsp_extract_json_int_field(json_str: str, key: str) -> i64 {
    let pat = "\"" + key + "\":";
    let idx = lsp_find_substr(json_str, pat, 0);
    if idx < 0 {
        return -1;
    }
    return lsp_parse_int_at(json_str, idx + pat.len());
}

fn lsp_escape_json_str(s: str) -> str {
    let n = s.len();
    var out = "";
    var i = 0;
    while i < n {
        let b = s.byte_at(i);
        if b == 34 {
            out = out + "\\\"";
        } else if b == 92 {
            out = out + "\\\\";
        } else if b == 10 {
            out = out + "\\n";
        } else if b == 13 {
            out = out + "\\r";
        } else if b == 9 {
            out = out + "\\t";
        } else {
            out = out + s.slice(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

fn lsp_position_to_offset(doc: str, line: i64, character: i64) -> i64 {
    let n = doc.len();
    if n == 0 { return 0; }
    if line <= 0 {
        return if character < 0 { 0 } else { if character < n { character } else { n - 1 } };
    }
    var cur_line = 0;
    var i = 0;
    while i < n {
        let b = doc.byte_at(i);
        if b == 10 {
            cur_line = cur_line + 1;
            if cur_line == line {
                let off = i + 1 + character;
                return if off < n { off } else { n - 1 };
            }
        }
        i = i + 1;
    }
    return if character < n { character } else { n - 1 };
}

fn lsp_extract_hover_signature(doc: str, offset: i64) -> str {
    let n = doc.len();
    if n == 0 {
        return "";
    }
    let cl_off = if offset < 0 { 0 } else { if offset >= n { n - 1 } else { offset } };
    var line_start = cl_off;
    while line_start > 0 {
        let b = doc.byte_at(line_start - 1);
        if b == 10 || b == 123 || b == 125 || b == 59 {
            break;
        }
        line_start = line_start - 1;
    }
    while line_start < n {
        let b = doc.byte_at(line_start);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            line_start = line_start + 1;
        } else {
            break;
        }
    }
    var sig_end = line_start;
    while sig_end < n {
        let b = doc.byte_at(sig_end);
        if b == 123 || b == 59 || b == 10 {
            break;
        }
        sig_end = sig_end + 1;
    }
    while sig_end > line_start {
        let b = doc.byte_at(sig_end - 1);
        if b == 32 || b == 9 || b == 13 {
            sig_end = sig_end - 1;
        } else {
            break;
        }
    }
    return doc.slice(line_start, sig_end);
}

pub pure fn lsp_format_hover_params(sig: str) -> str {
    let slen = sig.len();
    var p_open = -1;
    var i = 0;
    while i < slen && p_open == -1 {
        if sig.slice(i, i + 1) == "(" {
            p_open = i;
        }
        i = i + 1;
    }
    if p_open == -1 { return ""; }

    var p_close = -1;
    var depth = 1;
    var j = p_open + 1;
    while j < slen && p_close == -1 {
        let ch = sig.slice(j, j + 1);
        if ch == "(" {
            depth = depth + 1;
        } else if ch == ")" {
            depth = depth - 1;
            if depth == 0 {
                p_close = j;
            }
        }
        j = j + 1;
    }
    if p_close <= p_open + 1 { return ""; }

    let inner = sig.slice(p_open + 1, p_close).trim();
    if inner == "" { return ""; }

    var out = "\\n\\n**Parameters:**";
    var start_idx = 0;
    let in_len = inner.len();
    var k = 0;
    var comma_depth = 0;
    while k <= in_len {
        let is_sep = if k == in_len { true } else {
            let c = inner.slice(k, k + 1);
            if c == "<" || c == "(" || c == "[" { comma_depth = comma_depth + 1; }
            else if c == ">" || c == ")" || c == "]" { if comma_depth > 0 { comma_depth = comma_depth - 1; } }
            comma_depth == 0 && c == ","
        };
        if is_sep {
            let param_raw = inner.slice(start_idx, k).trim();
            if param_raw != "" {
                var colon_pos = -1;
                var ci = 0;
                let plen = param_raw.len();
                while ci < plen && colon_pos == -1 {
                    if param_raw.slice(ci, ci + 1) == ":" {
                        colon_pos = ci;
                    }
                    ci = ci + 1;
                }
                if colon_pos >= 0 {
                    let pname = param_raw.slice(0, colon_pos).trim();
                    let ptype = param_raw.slice(colon_pos + 1, plen).trim();
                    out = out + "\\n- `" + pname + "`: [`" + ptype + "`](#" + ptype + ")";
                } else {
                    out = out + "\\n- `" + param_raw + "`";
                }
            }
            start_idx = k + 1;
        }
        k = k + 1;
    }
    return out;
}

pub pure fn lsp_format_hover_returns(sig: str) -> str {
    let slen = sig.len();
    var arrow_pos = -1;
    var i = 0;
    while i + 2 <= slen && arrow_pos == -1 {
        if sig.slice(i, i + 2) == "->" {
            arrow_pos = i;
        }
        i = i + 1;
    }
    if arrow_pos == -1 { return ""; }

    var ret_part = sig.slice(arrow_pos + 2, slen).trim();
    if ret_part == "" { return ""; }

    return "\\n\\n**Returns:**\\n- [`" + ret_part + "`](#" + ret_part + ")";
}

pub pure fn lsp_is_ident_byte(b: i64) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || (b >= 48 && b <= 57) || b == 95;
}

pub pure fn lsp_ident_at_offset(doc: str, offset: i64) -> str {
    let n = doc.len();
    if n == 0 || offset < 0 || offset >= n { return ""; }
    var s = offset;
    while s > 0 && lsp_is_ident_byte(doc.byte_at(s - 1)) { s = s - 1; }
    var e = offset;
    while e < n && lsp_is_ident_byte(doc.byte_at(e)) { e = e + 1; }
    if e <= s { return ""; }
    return doc.slice(s, e);
}

pub pure fn lsp_format_hover_overloads(doc: str, ident: str, cur_sig: str) -> str {
    if ident == "" { return ""; }
    let pat = nameof(fn) + " " + ident + "(";
    let plen = pat.len();
    let dlen = doc.len();
    var pos = 0;
    var count = 0;
    var list_md = "";
    while pos + plen <= dlen {
        let hit = lsp_find_substr(doc, pat, pos);
        if hit < 0 { break; }
        let ov_sig = lsp_extract_hover_signature(doc, hit);
        if ov_sig != "" && ov_sig != cur_sig {
            count = count + 1;
            list_md = list_md + "\\n" + count + ". `" + lsp_escape_json_str(ov_sig) + "` *(offset " + hit + ")*";
        }
        pos = hit + plen;
    }
    if count == 0 { return ""; }
    return "\\n\\n**Overloads (" + count + "):**" + list_md;
}

pub pure fn lsp_format_hover_type_refs(doc: str, ident: str, cur_sig: str) -> str {
    if ident == "" { return ""; }
    let pat = ": " + ident;
    let plen = pat.len();
    let dlen = doc.len();
    var pos = 0;
    var count = 0;
    var list_md = "";
    while pos + plen <= dlen && count < 8 {
        let hit = lsp_find_substr(doc, pat, pos);
        if hit < 0 { break; }
        let after_idx = hit + plen;
        let boundary_ok = if after_idx >= dlen { true } else { !lsp_is_ident_byte(doc.byte_at(after_idx)) };
        if boundary_ok {
            let ref_sig = lsp_extract_hover_signature(doc, hit);
            if ref_sig != "" && ref_sig != cur_sig {
                count = count + 1;
                list_md = list_md + "\\n- [`" + lsp_escape_json_str(ref_sig) + "`](#offset-" + hit + ")";
            }
        }
        pos = hit + plen;
    }
    if count == 0 { return ""; }
    return "\\n\\n**Type References (" + count + "):**" + list_md;
}

pub fn encode_lsp_frame(json_payload: str) -> str {
    let byte_len = json_payload.len();
    return "Content-Length: " + byte_len + "\r\n\r\n" + json_payload;
}

pub fn lsp_session_new() -> i64 {
    let sess = __engine("map_new");
    let _init = __engine("map_set", sess, "last_doc", "");
    return sess;
}

pub fn lsp_session_feed_stream(sess: i64, framed_stream: str) -> str {
    let total_len = framed_stream.len();
    var pos = 0;
    var out_frames = "";
    while pos < total_len {
        let cl_idx = lsp_find_substr(framed_stream, "Content-Length:", pos);
        if cl_idx < 0 {
            break;
        }
        let hdr_end = lsp_find_substr(framed_stream, "\r\n\r\n", cl_idx);
        if hdr_end < 0 {
            break;
        }
        let body_len = lsp_parse_int_at(framed_stream, cl_idx + 15);
        let body_start = hdr_end + 4;
        if body_len < 0 || body_start + body_len > total_len {
            break;
        }
        let msg = framed_stream.slice(body_start, body_start + body_len);
        pos = body_start + body_len;

        let method = lsp_extract_json_str_field(msg, "method");
        let req_id = lsp_extract_json_int_field(msg, "id");
        let uri = lsp_extract_json_str_field(msg, "uri");

        if method == "initialize" {
            let init_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"capabilities\":{\"textDocumentSync\":1,\"hoverProvider\":true,\"completionProvider\":{\"triggerCharacters\":[\".\"]},\"definitionProvider\":true,\"referencesProvider\":true,\"renameProvider\":{\"prepareProvider\":true}}}}";
            out_frames = out_frames + encode_lsp_frame(init_json);
        } else if method == "textDocument/didOpen" || method == "textDocument/didChange" {
            var new_text = lsp_extract_json_str_field(msg, "text");
            if uri != "" {
                let _s1 = __engine("map_set", sess, "doc:" + uri, new_text);
            }
            let _s2 = __engine("map_set", sess, "last_doc", new_text);
        } else if method == "textDocument/hover" {
            var offset = lsp_extract_json_int_field(msg, "offset");
            var doc = "";
            if uri != "" {
                doc = __engine("map_get", sess, "doc:" + uri);
            }
            if doc == "" {
                doc = __engine("map_get", sess, "last_doc");
            }
            if offset < 0 {
                let l = lsp_extract_json_int_field(msg, "line");
                let c = lsp_extract_json_int_field(msg, "character");
                if l >= 0 {
                    offset = lsp_position_to_offset(doc, l, c);
                } else {
                    offset = 0;
                }
            }
            let sig = lsp_extract_hover_signature(doc, offset);
            let ident = lsp_ident_at_offset(doc, offset);
            let esc_sig = lsp_escape_json_str(sig);
            let p_md = lsp_format_hover_params(sig);
            let r_md = lsp_format_hover_returns(sig);
            let ov_md = lsp_format_hover_overloads(doc, ident, sig);
            let tr_md = lsp_format_hover_type_refs(doc, ident, sig);
            let hover_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"contents\":{\"kind\":\"markdown\",\"value\":\"```pilot\\n" + esc_sig + "\\n```" + p_md + r_md + ov_md + tr_md + "\"}}}";
            out_frames = out_frames + encode_lsp_frame(hover_json);
        } else if method == "textDocument/completion" {
            var doc = "";
            if uri != "" { doc = __engine("map_get", sess, "doc:" + uri); }
            if doc == "" { doc = __engine("map_get", sess, "last_doc"); }

            var comp_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":[" +
                "{\"label\":\"" + nameof(fn) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(struct) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(interface) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(let) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(ref) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(if) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(loop) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(return) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(yield) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(defer) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(comptime) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(quote) + "\",\"kind\":14}," +
                "{\"label\":\"" + nameof(asm) + "\",\"kind\":14}," +
                "{\"label\":\"Pilot.Core.Reflect\",\"kind\":9}," +
                "{\"label\":\"Pilot.Collections\",\"kind\":9}," +
                "{\"label\":\"Pilot.Crypto\",\"kind\":9}";

            if lsp_find_substr(doc, "Pilot.Core", 0) >= 0 {
                comp_json = comp_json +
                    ",{\"label\":\"IAnyValue\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IValue\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IReference\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IObject\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IGuard\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IEnumerable\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IComparable\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IEquatable\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}" +
                    ",{\"label\":\"IDisposable\",\"kind\":8,\"detail\":\"(in Pilot.Core) interface\",\"labelDetails\":{\"description\":\"Pilot.Core\"}}";
            }
            if lsp_find_substr(doc, "Pilot.Core.Reflect", 0) >= 0 {
                comp_json = comp_json +
                    ",{\"label\":\"reflect_category_scope\",\"kind\":3,\"detail\":\"pub fn reflect_category_scope(cat_id: i64) -> str\"}" +
                    ",{\"label\":\"reflect_category_badge\",\"kind\":3,\"detail\":\"pub fn reflect_category_badge(cat_id: i64) -> str\"}" +
                    ",{\"label\":\"reflect_keyword_doc\",\"kind\":3,\"detail\":\"pub fn reflect_keyword_doc(cat_id: i64, word: str) -> str\"}" +
                    ",{\"label\":\"reflect_category_words\",\"kind\":3,\"detail\":\"pub fn reflect_category_words(cat_id: i64) -> str\"}" +
                    ",{\"label\":\"reflect_type_layout\",\"kind\":3,\"detail\":\"pub fn reflect_type_layout(name: str) -> TypeInfo\"}";
            }
            if lsp_find_substr(doc, "Pilot.Collections", 0) >= 0 {
                comp_json = comp_json +
                    ",{\"label\":\"IList\",\"kind\":8,\"detail\":\"(in Pilot.Collections) interface\",\"labelDetails\":{\"description\":\"Pilot.Collections\"}}" +
                    ",{\"label\":\"IMap\",\"kind\":8,\"detail\":\"(in Pilot.Collections) interface\",\"labelDetails\":{\"description\":\"Pilot.Collections\"}}" +
                    ",{\"label\":\"ISet\",\"kind\":8,\"detail\":\"(in Pilot.Collections) interface\",\"labelDetails\":{\"description\":\"Pilot.Collections\"}}" +
                    ",{\"label\":\"List\",\"kind\":7,\"detail\":\"struct List<T>\"}" +
                    ",{\"label\":\"Map\",\"kind\":7,\"detail\":\"struct Map<K, V>\"}" +
                    ",{\"label\":\"Set\",\"kind\":7,\"detail\":\"struct Set<T>\"}" +
                    ",{\"label\":\"Stack\",\"kind\":7,\"detail\":\"struct Stack<T>\"}" +
                    ",{\"label\":\"Queue\",\"kind\":7,\"detail\":\"struct Queue<T>\"}" +
                    ",{\"label\":\"Deque\",\"kind\":7,\"detail\":\"struct Deque<T>\"}" +
                    ",{\"label\":\"LinkedList\",\"kind\":7,\"detail\":\"struct LinkedList<T>\"}" +
                    ",{\"label\":\"BinaryTree\",\"kind\":7,\"detail\":\"struct BinaryTree<T>\"}" +
                    ",{\"label\":\"Graph\",\"kind\":7,\"detail\":\"struct Graph<T>\"}";
            }
            if lsp_find_substr(doc, "Pilot.Crypto", 0) >= 0 {
                comp_json = comp_json +
                    ",{\"label\":\"sha256_hex\",\"kind\":3,\"detail\":\"pub fn sha256_hex(data: str) -> str\"}";
            }
            comp_json = comp_json + "]}";
            out_frames = out_frames + encode_lsp_frame(comp_json);
        } else if method == "textDocument/definition" {
            var offset = lsp_extract_json_int_field(msg, "offset");
            var doc = "";
            if uri != "" { doc = __engine("map_get", sess, "doc:" + uri); }
            if doc == "" { doc = __engine("map_get", sess, "last_doc"); }
            if offset < 0 {
                let l = lsp_extract_json_int_field(msg, "line");
                let c = lsp_extract_json_int_field(msg, "character");
                if l >= 0 {
                    offset = lsp_position_to_offset(doc, l, c);
                } else {
                    offset = 0;
                }
            }
            let ident = lsp_ident_at_offset(doc, offset);
            var def_pos = -1;
            if ident != "" {
                let fn_pat = nameof(fn) + " " + ident;
                let hit1 = lsp_find_substr(doc, fn_pat, 0);
                if hit1 >= 0 { def_pos = hit1; }
                else {
                    let st_pat = nameof(struct) + " " + ident;
                    let hit2 = lsp_find_substr(doc, st_pat, 0);
                    if hit2 >= 0 { def_pos = hit2; }
                    else {
                        let if_pat = nameof(interface) + " " + ident;
                        let hit3 = lsp_find_substr(doc, if_pat, 0);
                        if hit3 >= 0 { def_pos = hit3; }
                    }
                }
            }
            let def_json = if def_pos >= 0 {
                "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":{\"uri\":\"" + uri + "\",\"range\":{\"start\":{\"character\":" + def_pos + "},\"end\":{\"character\":" + (def_pos + ident.len()) + "}}}}"
            } else {
                "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":null}"
            };
            out_frames = out_frames + encode_lsp_frame(def_json);
        } else if method == "shutdown" {
            let shut_json = "{\"jsonrpc\":\"2.0\",\"id\":" + req_id + ",\"result\":null}";
            out_frames = out_frames + encode_lsp_frame(shut_json);
        }
    }
    return out_frames;
}
