// =========================================================================
// FILE: selfhost/lsp/server.pilot
// `pilot lsp`: the Language Server Protocol over standard input and output.
// =========================================================================
// One process serves an editor session. It reads JSON-RPC messages framed
// by `Content-Length` headers and answers:
//   - diagnostics, published for an open file when typing has paused
//     (`lsp_quiet_ms`) and on open and save;
//   - hover and go-to-definition, from the last index of the file.
// Everything it reports comes from the type checker: `lsp_index`
// (selfhost/lsp/index.pilot) runs the checker's passes over the file in the
// checker's VM and gives back its diagnostics and, for every name in the
// file, where it is declared and what to show for it. A file whose text in
// the editor differs from the file on disk is checked as a hidden copy
// beside it (`.<name>.lsp.pilot`), so its `use` lines resolve from its own
// folder; the copy is deleted right after.
pub lvl(0) pkg selfhost.cli;

use std.proc;

/// How long typing must pause, in milliseconds, before an edited file is
/// checked again.
pub pure fn lsp_quiet_ms() -> i64 => 300;

/// JSON-RPC error code for a message that cannot be read.
pub pure fn lsp_parse_error() -> i64 => -32700;

// ----------------------------------------------------------------------------
// JSON in: a message read into its leaves.
// ----------------------------------------------------------------------------

/// A JSON message read into its leaves: each string, number, boolean or
/// null by its dotted path (`params.textDocument.uri`, `params.contentChanges.0.text`),
/// strings decoded, everything else as written. `raw` holds each leaf as
/// written in the message, so an `id` is answered exactly as it was sent.
pub struct JsonLeaves {
    pub values: Map<str, str>;
    pub raw: Map<str, str>;
    pub ok: bool;
}

struct JsonReader {
    text: str;
    at: i64;
    ok: bool;
}

fn json_skip_space(var ref r: JsonReader) {
    while r.at < r.text.len() {
        let b = r.text.byte_at(r.at);
        if b != 32 && b != 9 && b != 10 && b != 13 { return; }
        r.at = r.at + 1;
    }
}

fn hex_value(b: i64) -> i64 {
    if b >= 48 && b <= 57 { return b - 48; }
    if b >= 97 && b <= 102 { return b - 87; }
    if b >= 65 && b <= 70 { return b - 55; }
    return -1;
}

/// Code point `cp` as text (its UTF-8 bytes).
fn utf8_of(cp: i64) -> str {
    var bytes: List<i64> = [];
    if cp < 128 {
        bytes.push(cp);
    } else if cp < 2048 {
        bytes.push(192 + cp / 64);
        bytes.push(128 + cp % 64);
    } else {
        bytes.push(224 + cp / 4096);
        bytes.push(128 + (cp / 64) % 64);
        bytes.push(128 + cp % 64);
    }
    let buf = RawMem.alloc(bytes.len(), 1);
    var i = 0;
    while i < bytes.len() {
        let _ = RawMem.store_int(buf + i, bytes[i], 8);
        i = i + 1;
    }
    let out = str_from_ptr(buf, bytes.len());
    let _ = RawMem.free(buf, bytes.len(), 1);
    return out;
}

/// The pieces of `whole` between occurrences of `sep`.
fn split_on(whole: str, sep: str) -> List<str> {
    var out: List<str> = [];
    var from = 0;
    while true {
        let at = whole.find(sep, from);
        if at < 0 { break; }
        out.push(whole.slice(from, at));
        from = at + sep.len();
    }
    out.push(whole.slice(from, whole.len()));
    return out;
}

/// The decimal integer `digits` (an optional `-`, then digits), or none.
fn int_value(digits: str) -> i64? {
    var i = 0;
    var neg = false;
    if digits.len() > 0 && digits.byte_at(0) == 45 { neg = true; i = 1; }
    if i >= digits.len() { return none; }
    var v = 0;
    while i < digits.len() {
        let b = digits.byte_at(i);
        if b < 48 || b > 57 { return none; }
        v = v * 10 + (b - 48);
        i = i + 1;
    }
    return if neg { 0 - v } else { v };
}

/// `parts` joined pairwise so large payloads avoid quadratic copying.
fn lsp_join(ref parts: List<str>) -> str {
    if parts.len() == 0 { return ""; }
    var level = parts;
    while level.len() > 1 {
        var next: List<str> = [];
        var i = 0;
        while i < level.len() {
            next.push(if i + 1 < level.len() { level[i] + level[i + 1] } else { level[i] });
            i = i + 2;
        }
        level = next;
    }
    return level[0];
}

/// A JSON string starting at the reader (on its opening quote), decoded.
fn json_string(var ref r: JsonReader) -> str {
    r.at = r.at + 1;
    var q = r.text.find("\"", r.at);
    if q < 0 {
        r.at = r.text.len();
        r.ok = false;
        return "";
    }
    var s = r.text.find("\\", r.at);
    if s < 0 || q < s {
        let out = r.text.slice(r.at, q);
        r.at = q + 1;
        return out;
    }
    var parts: List<str> = [];
    while true {
        if s < 0 || q < s {
            if q > r.at { parts.push(r.text.slice(r.at, q)); }
            r.at = q + 1;
            return lsp_join(parts);
        }
        if s > r.at { parts.push(r.text.slice(r.at, s)); }
        if s + 1 >= r.text.len() {
            r.at = r.text.len();
            r.ok = false;
            return lsp_join(parts);
        }
        let e = r.text.byte_at(s + 1);
        r.at = s + 2;
        if e == 110 { parts.push("\n"); }
        else if e == 116 { parts.push("\t"); }
        else if e == 114 { parts.push("\r"); }
        else if e == 98 { parts.push(utf8_of(8)); }
        else if e == 102 { parts.push(utf8_of(12)); }
        else if e == 117 {
            var cp = 0;
            var k = 0;
            while k < 4 {
                let h = if r.at < r.text.len() { hex_value(r.text.byte_at(r.at)) } else { -1 };
                if h < 0 { r.ok = false; return lsp_join(parts); }
                cp = cp * 16 + h;
                r.at = r.at + 1;
                k = k + 1;
            }
            parts.push(utf8_of(cp));
        } else {
            parts.push(r.text.slice(r.at - 1, r.at));
        }
        if q < r.at { q = r.text.find("\"", r.at); }
        if q < 0 {
            r.at = r.text.len();
            r.ok = false;
            return lsp_join(parts);
        }
        s = r.text.find("\\", r.at);
    }
    return "";
}

fn json_value(var ref r: JsonReader, path: str, var ref out: JsonLeaves) {
    json_skip_space(r);
    if r.at >= r.text.len() { r.ok = false; return; }
    let b = r.text.byte_at(r.at);
    if b == 123 {
        r.at = r.at + 1;
        json_skip_space(r);
        if r.at < r.text.len() && r.text.byte_at(r.at) == 125 { r.at = r.at + 1; return; }
        while r.ok {
            json_skip_space(r);
            if r.at >= r.text.len() || r.text.byte_at(r.at) != 34 { r.ok = false; return; }
            let key = json_string(r);
            json_skip_space(r);
            if r.at >= r.text.len() || r.text.byte_at(r.at) != 58 { r.ok = false; return; }
            r.at = r.at + 1;
            json_value(r, if path == "" { key } else { path + "." + key }, out);
            json_skip_space(r);
            if r.at < r.text.len() && r.text.byte_at(r.at) == 44 { r.at = r.at + 1; continue; }
            if r.at < r.text.len() && r.text.byte_at(r.at) == 125 { r.at = r.at + 1; return; }
            r.ok = false;
        }
        return;
    }
    if b == 91 {
        r.at = r.at + 1;
        json_skip_space(r);
        if r.at < r.text.len() && r.text.byte_at(r.at) == 93 { r.at = r.at + 1; return; }
        var i = 0;
        while r.ok {
            json_value(r, path + f".{i}", out);
            i = i + 1;
            json_skip_space(r);
            if r.at < r.text.len() && r.text.byte_at(r.at) == 44 { r.at = r.at + 1; continue; }
            if r.at < r.text.len() && r.text.byte_at(r.at) == 93 { r.at = r.at + 1; return; }
            r.ok = false;
        }
        return;
    }
    let start = r.at;
    if b == 34 {
        let v = json_string(r);
        out.values.set(path, v);
        out.raw.set(path, r.text.slice(start, r.at));
        return;
    }
    while r.at < r.text.len() {
        let c = r.text.byte_at(r.at);
        if c == 44 || c == 125 || c == 93 || c == 32 || c == 9 || c == 10 || c == 13 { break; }
        r.at = r.at + 1;
    }
    if r.at == start { r.ok = false; return; }
    let word = r.text.slice(start, r.at);
    out.values.set(path, word);
    out.raw.set(path, word);
}

/// The leaves of JSON message `text`; `ok` is false when it is not JSON.
pub fn json_leaves(text: str) -> JsonLeaves {
    var out = JsonLeaves { values: Map<str, str>(), raw: Map<str, str>(), ok: true };
    var r = JsonReader { text: text, at: 0, ok: true };
    json_value(r, "", out);
    json_skip_space(r);
    out.ok = r.ok && r.at == text.len();
    return out;
}

fn leaf(ref m: JsonLeaves, path: str) -> str => m.values.get(path) ?? "";

fn leaf_int(ref m: JsonLeaves, path: str) -> i64 => int_value(leaf(m, path)) ?? 0;

// ----------------------------------------------------------------------------
// JSON out.
// ----------------------------------------------------------------------------

/// `text` as a JSON string, quotes included.
pub fn json_quote(text: str) -> str {
    var parts: List<str> = ["\""];
    var run = 0;
    var i = 0;
    while i < text.len() {
        let b = text.byte_at(i);
        var esc = "";
        if b == 34 { esc = "\\\""; }
        else if b == 92 { esc = "\\\\"; }
        else if b == 10 { esc = "\\n"; }
        else if b == 13 { esc = "\\r"; }
        else if b == 9 { esc = "\\t"; }
        else if b < 32 { esc = "\\u00" + (if b < 16 { "0" } else { "1" }) + "0123456789abcdef".slice(b % 16, b % 16 + 1); }
        if esc != "" {
            if i > run { parts.push(text.slice(run, i)); }
            parts.push(esc);
            run = i + 1;
        }
        i = i + 1;
    }
    if text.len() > run { parts.push(text.slice(run, text.len())); }
    parts.push("\"");
    return lsp_join(parts);
}

fn json_range(line: i64, col: i64, end_line: i64, end_col: i64) -> str =>
    f"{{\"start\":{{\"line\":{line},\"character\":{col}}},\"end\":{{\"line\":{end_line},\"character\":{end_col}}}}}";

// ----------------------------------------------------------------------------
// Framing over standard input and output.
// ----------------------------------------------------------------------------

/// The server's input not yet read as messages, and whether input has ended.
pub struct LspInput {
    pub pending: str;
    pub ended: bool;
}

/// Waits up to `timeout_ms` (-1: no limit) for input and appends what came:
/// 1 when something came, 0 when the time ran out, -1 when input ended.
fn lsp_fill(var ref input: LspInput, timeout_ms: i64) -> i64 {
    let fds = RawMem.alloc(16, 8);
    let _ = RawMem.store_int(fds, 0, 64);
    let _ = RawMem.store_int(fds + 8, 1, 32);
    let _ = RawMem.store_int(fds + 12, 0, 32);
    let ready = Fd.poll(fds, 1, timeout_ms);
    let _ = RawMem.free(fds, 16, 8);
    if ready == 0 { return 0; }
    if ready < 0 {
        if ready == -5 || ready == -7 { return 1; }
        input.ended = true;
        return -1;
    }
    let cap = 65536;
    let buf = RawMem.alloc(cap, 1);
    let r = Fd.read(0, buf, cap);
    let got = if r > 0 { str_from_ptr(buf, r) } else { "" };
    let _ = RawMem.free(buf, cap, 1);
    if r == -5 || r == -7 { return 1; }
    if r <= 0 {
        input.ended = true;
        return -1;
    }
    input.pending = input.pending + got;
    return 1;
}

/// The next whole message body in `input`, or none when it has not all come.
/// A header without a usable `Content-Length` gives "" (the message is
/// skipped and answered with a parse error).
fn lsp_take_frame(var ref input: LspInput) -> str? {
    let text = input.pending;
    let head_end = text.find("\r\n\r\n");
    if head_end < 0 { return none; }
    let head = text.slice(0, head_end);
    var length = -1;
    for line in split_on(head, "\r\n") {
        if line.starts_with("Content-Length:") || line.starts_with("content-length:") {
            length = int_value(line.slice(15, line.len()).trim()) ?? -1;
        }
    }
    let body_start = head_end + 4;
    if length < 0 {
        input.pending = text.slice(body_start, text.len());
        return "";
    }
    if text.len() - body_start < length { return none; }
    input.pending = text.slice(body_start + length, text.len());
    return text.slice(body_start, body_start + length);
}

/// Writes `body` as one framed message on standard output. The body ends with
/// a line break, counted in `Content-Length` (JSON allows whitespace after a
/// value): the seed VM's standard output is line-buffered (Rust `LineWriter`,
/// `HostOp::FdWrite` on fd 1), so a frame that does not end in a line break
/// sits in that buffer until the next message and the editor waits on it
/// (PROP-041 would make the write unbuffered).
fn lsp_send(json: str) {
    let body = json + "\n";
    let framed = f"Content-Length: {body.len()}\r\n\r\n" + body;
    let n = framed.len();
    let buf = RawMem.alloc(n, 1);
    let _ = str_copy_to_ptr(framed, buf, n);
    var off = 0;
    while off < n {
        let w = Fd.write(1, buf + off, n - off);
        if w <= 0 { break; }
        off = off + w;
    }
    let _ = RawMem.free(buf, n, 1);
}

fn lsp_reply(id_raw: str, result: str) {
    lsp_send("{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + ",\"result\":" + result + "}");
}

fn lsp_reply_error(id_raw: str, code: i64, message: str) {
    lsp_send("{\"jsonrpc\":\"2.0\",\"id\":" + id_raw + f",\"error\":{{\"code\":{code},\"message\":" + json_quote(message) + "}}");
}

// ----------------------------------------------------------------------------
// The index of a file, read back from `lsp_index`'s records.
// ----------------------------------------------------------------------------

/// A name written in the file: where it is, where it is declared, and what
/// to show for it.
pub struct LspName : IValue {
    pub line: i64;
    pub col: i64;
    pub end_col: i64;
    pub def_file: str;
    pub def_line: i64;
    pub def_col: i64;
    pub hover: str;
}

/// What the server knows about one open file.
pub struct LspFile {
    pub text: str;
    /// The text changed since the last check.
    pub dirty: bool;
    pub diagnostics: str;
    pub names: List<LspName>;
}

/// `lsp_field` undone.
fn unfield(text: str) -> str {
    if text.find("\\") < 0 { return text; }
    var out = "";
    var i = 0;
    while i < text.len() {
        let b = text.byte_at(i);
        if b == 92 && i + 1 < text.len() {
            let e = text.byte_at(i + 1);
            out = out + if e == 110 { "\n" } else if e == 116 { "\t" } else { text.slice(i + 1, i + 2) };
            i = i + 2;
            continue;
        }
        out = out + text.slice(i, i + 1);
        i = i + 1;
    }
    return out;
}

fn int_of(digits: str) -> i64 => int_value(digits) ?? 0;

/// The file at `path` is `shown_as` to the editor (the hidden copy is the file).
fn editor_path(path: str, checked: str, shown_as: str) -> str => if path == checked { shown_as } else { path };

/// The diagnostics a seed check found (`host_check`: the program does not
/// parse or link), as a JSON list.
fn seed_diagnostics(ref diags: List<HostDiag>, text: str) -> str {
    var out = "";
    for d in diags {
        let a = offset_place(text, d.start as i64);
        let b = offset_place(text, d.end as i64);
        let item = "{\"range\":" + json_range(a.0, a.1, b.0, b.1) + f",\"severity\":{d.severity},\"code\":" + json_quote(d.code) + ",\"source\":\"pilot\",\"message\":" + json_quote(d.message) + "}";
        out = if out == "" { item } else { out + "," + item };
    }
    return "[" + out + "]";
}

/// The 0-based line and byte column of `offset` in `text`.
fn offset_place(text: str, offset: i64) -> (i64, i64) {
    var line = 0;
    var start = 0;
    var i = 0;
    while i < offset && i < text.len() {
        if text.byte_at(i) == 10 {
            line = line + 1;
            start = i + 1;
        }
        i = i + 1;
    }
    return (line, offset - start);
}

/// The path of a `file://` URI.
fn uri_path(uri: str) -> str {
    var p = if uri.starts_with("file://") { uri.slice(7, uri.len()) } else { uri };
    return p.replace("%20", " ").replace("%3A", ":").replace("%40", "@");
}

fn path_uri(path: str) -> str => "file://" + path.replace(" ", "%20");

/// The folders a relative path `lsp_index` gives is relative to: the
/// server's working folder (the editor's workspace, `PWD`) and the
/// toolchain's folder (the one holding `stdlib/`, above the `pilot` running).
pub struct LspRoots : IValue {
    pub cwd: str;
    pub toolchain: str;
}

fn parent_dir(path: str) -> str {
    var slash = -1;
    var at = path.find("/");
    while at >= 0 {
        slash = at;
        at = path.find("/", at + 1);
    }
    return if slash > 0 { path.slice(0, slash) } else { "" };
}

fn lsp_roots() -> LspRoots {
    var toolchain = "";
    if some exe = proc.current_exe() {
        var dir = parent_dir(exe);
        while dir != "" && toolchain == "" {
            if File.exists(dir + "/stdlib") { toolchain = dir; }
            dir = parent_dir(dir);
        }
    }
    return LspRoots { cwd: Env.get("PWD"), toolchain: toolchain };
}

/// An absolute form of a path `lsp_index` gives.
fn absolute(path: str, ref roots: LspRoots) -> str {
    if path.starts_with("/") { return path; }
    if roots.cwd != "" && File.exists(roots.cwd + "/" + path) { return roots.cwd + "/" + path; }
    if roots.toolchain != "" { return roots.toolchain + "/" + path; }
    return path;
}

/// The folder and the hidden copy a changed text of `path` is checked as.
fn hidden_copy(path: str) -> str {
    let dir = parent_dir(path) + "/";
    let base = path.slice(dir.len(), path.len());
    let stem = if base.ends_with(".pilot") { base.slice(0, base.len() - 6) } else { base };
    return dir + "." + stem + ".lsp.pilot";
}

/// Checks `file` (open at `uri`) and indexes it.
fn lsp_check(var ref file: LspFile, uri: str, ref roots: LspRoots) {
    if uri.find(":") >= 0 && !uri.starts_with("file://") {
        file.dirty = false;
        file.diagnostics = "[]";
        file.names = [];
        return;
    }
    let path = uri_path(uri);
    let on_disk = if File.exists(path) { File.read_text(path) } else { "" };
    var checked = path;
    var copied = false;
    if file.text != on_disk || !File.exists(path) {
        checked = hidden_copy(path);
        copied = File.write_text(checked, file.text);
        if !copied { checked = path; }
    }
    file.dirty = false;
    var seed: List<HostDiag> = [];
    for d in host_check(checked) {
        if d.file == checked { seed.push(d); }
    }
    if seed.len > 0 {
        file.diagnostics = seed_diagnostics(seed, file.text);
        if copied { let _ = File.delete(checked); }
        return;
    }
    let records = lsp_records(checked) ?? "";
    if copied { let _ = File.delete(checked); }
    var diags = "";
    var names: List<LspName> = [];
    let here = absolute(checked, roots);
    for rec in split_on(records, "\n") {
        let f = split_on(rec, "\t");
        if f.len() < 9 || absolute(unfield(f[1]), roots) != here { continue; }
        if f[0] == "D" {
            let item = "{\"range\":" + json_range(int_of(f[2]), int_of(f[3]), int_of(f[4]), int_of(f[5])) + ",\"severity\":" + f[6] + ",\"code\":" + json_quote(unfield(f[7])) + ",\"source\":\"pilot\",\"message\":" + json_quote(unfield(f[8])) + "}";
            diags = if diags == "" { item } else { diags + "," + item };
        } else if f[0] == "S" {
            let def = absolute(unfield(f[5]), roots);
            names.push(LspName {
                line: int_of(f[2]), col: int_of(f[3]), end_col: int_of(f[4]),
                def_file: editor_path(def, here, absolute(path, roots)),
                def_line: int_of(f[6]), def_col: int_of(f[7]), hover: unfield(f[8]),
            });
        }
    }
    file.diagnostics = "[" + diags + "]";
    file.names = names;
}

/// The file `lsp_index` lives in, linked after the type checker's files.
pub fn lsp_index_file() -> str => "selfhost/lsp/index.pilot";

fn publish(uri: str, ref file: LspFile) {
    lsp_send("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + json_quote(uri) + ",\"diagnostics\":" + file.diagnostics + "}}");
}

/// The name of `file` at `line`/`col`, if one is indexed there.
fn name_at(ref file: LspFile, line: i64, col: i64) -> LspName? {
    for n in file.names {
        if n.line == line && n.col <= col && col <= n.end_col { return n; }
    }
    return none;
}

fn capabilities() -> str =>
    "{\"capabilities\":{\"textDocumentSync\":{\"openClose\":true,\"change\":1,\"save\":{\"includeText\":false}},\"hoverProvider\":true,\"definitionProvider\":true},\"serverInfo\":{\"name\":\"pilot lsp\"}}";

// ----------------------------------------------------------------------------
// The session.
// ----------------------------------------------------------------------------

/// Serves one editor session until `exit` or the end of input; the exit code.
pub fn lsp_serve() -> i64 {
    var input = LspInput { pending: "", ended: false };
    var files = Map<str, LspFile>();
    var in_order = Map<str, bool>();
    var order: List<str> = [];
    var shut = false;
    let roots = lsp_roots();
    while true {
        if some body = lsp_take_frame(input) {
            let m = json_leaves(body);
            let id_raw = m.raw.get("id") ?? "null";
            if !m.ok {
                lsp_reply_error(id_raw, lsp_parse_error(), "the message is not JSON");
                continue;
            }
            let method = leaf(m, "method");
            let uri = leaf(m, "params.textDocument.uri");
            if method == "initialize" {
                lsp_reply(id_raw, capabilities());
            } else if method == "shutdown" {
                shut = true;
                lsp_reply(id_raw, "null");
            } else if method == "exit" {
                return if shut { 0 } else { 1 };
            } else if method == "textDocument/didOpen" {
                let text = leaf(m, "params.textDocument.text");
                if some prev = files.get(uri) {
                    if !prev.dirty && prev.text == text {
                        publish(uri, prev);
                        continue;
                    }
                } else if !in_order.has(uri) {
                    in_order.set(uri, true);
                    order.push(uri);
                }
                var f = LspFile { text: text, dirty: false, diagnostics: "[]", names: [] };
                lsp_check(f, uri, roots);
                publish(uri, f);
                files.set(uri, f);
            } else if method == "textDocument/didChange" {
                if some f = files.get(uri) {
                    let next_text = leaf(m, "params.contentChanges.0.text");
                    if next_text != f.text || f.dirty {
                        var g = f;
                        g.text = next_text;
                        g.dirty = true;
                        files.set(uri, g);
                    }
                }
            } else if method == "textDocument/didSave" {
                if some f = files.get(uri) {
                    var g = f;
                    g.dirty = true;
                    files.set(uri, g);
                }
            } else if method == "textDocument/didClose" {
                files.remove(uri);
                lsp_send("{\"jsonrpc\":\"2.0\",\"method\":\"textDocument/publishDiagnostics\",\"params\":{\"uri\":" + json_quote(uri) + ",\"diagnostics\":[]}}");
            } else if method == "textDocument/hover" || method == "textDocument/definition" {
                var result = "null";
                if some f = files.get(uri) {
                    var cur = f;
                    if cur.dirty {
                        lsp_check(cur, uri, roots);
                        publish(uri, cur);
                        files.set(uri, cur);
                    }
                    if some n = name_at(cur, leaf_int(m, "params.position.line"), leaf_int(m, "params.position.character")) {
                        let range = json_range(n.line, n.col, n.line, n.end_col);
                        result = if method == "textDocument/hover" {
                            "{\"contents\":{\"kind\":\"markdown\",\"value\":" + json_quote(n.hover) + "},\"range\":" + range + "}"
                        } else {
                            "{\"uri\":" + json_quote(path_uri(n.def_file)) + ",\"range\":" + json_range(n.def_line, n.def_col, n.def_line, n.def_col) + "}"
                        };
                    }
                }
                lsp_reply(id_raw, result);
            } else if m.raw.has("id") && method != "" {
                lsp_reply_error(id_raw, -32601, "not handled: " + method);
            }
            continue;
        }
        var waiting = false;
        for u in order {
            if some f = files.get(u) { if f.dirty { waiting = true; } }
        }
        let got = lsp_fill(input, if waiting { lsp_quiet_ms() } else { -1 });
        if got < 0 { return if shut { 0 } else { 1 }; }
        if got == 0 {
            // Typing paused: check every file edited since its last check.
            for u in order {
                if some f = files.get(u) {
                    if f.dirty {
                        var g = f;
                        lsp_check(g, u, roots);
                        publish(u, g);
                        files.set(u, g);
                    }
                }
            }
        }
    }
    return 0;
}

/// The records `lsp_index` gives for the file at `path`, or none when the
/// program does not link.
fn lsp_records(path: str) -> str? {
    var tool = cli_checker_files();
    tool.push(lsp_index_file());
    let quoted = path.replace("\\", "\\\\").replace("\"", "\\\"");
    return host_program_text(path, tool, cli_checker_decls(), f"lsp_index(\"{quoted}\");");
}

/// `pilot lsp --index <file>`: what the server knows about a file, as text
/// (for tests and for looking at it): the seed's diagnostics when the file
/// does not parse or link, otherwise `lsp_index`'s records.
pub fn lsp_index_text(path: str) -> str? {
    var seed = "";
    for d in host_check(path) {
        if d.file == path { seed = seed + f"seed\t{d.code}\t{d.start}\t{d.end}\t" + d.message.replace("\t", " ").replace("\n", " ") + "\n"; }
    }
    if seed != "" { return seed; }
    return lsp_records(path);
}
