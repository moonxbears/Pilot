pub pkg Pilot.SelfHost.Lsp.IdeDb;

use Pilot.SelfHost.Db.Revision::*;
use Pilot.SelfHost.Db.Engine::*;
use Pilot.SelfHost.Db.Queries::*;
use Pilot.SelfHost.Db.CacheIo::*;

pub pure fn nameof(sym: str) -> str => sym;

pub enum IdeParseState {
    Normal,
    InLineComment,
    InBlockComment,
    InString,
    InChar,
}

fn is_ident_byte(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95;
}

pub fn extract_item_tree_signature(source: str) -> str {
    let n = source.len();
    let fn_kw = nameof(fn);
    var sig = "";
    var fn_body_depth = 0;
    var pending_fn_body = false;
    var paren_depth = 0;
    var i = 0;
    while i < n {
        let b = source.byte_at(i);
        // Handle line comments //
        if b == 47 && i + 1 < n && source.byte_at(i + 1) == 47 {
            i = i + 2;
            while i < n && source.byte_at(i) != 10 {
                i = i + 1;
            }
        } else if b == 47 && i + 1 < n && source.byte_at(i + 1) == 42 {
            // Handle block comments /* ... */
            i = i + 2;
            var in_blk = true;
            while i + 1 < n && in_blk {
                if source.byte_at(i) == 42 && source.byte_at(i + 1) == 47 {
                    in_blk = false;
                    i = i + 2;
                } else {
                    i = i + 1;
                }
            }
        } else if b == 34 || b == 39 {
            // Handle string or char literal (skipping escaped chars so braces inside strings never affect depth)
            let quote_b = b;
            let lit_start = i;
            i = i + 1;
            var in_lit = true;
            while i < n && in_lit {
                let cb = source.byte_at(i);
                if cb == 92 {
                    i = i + 2;
                } else if cb == quote_b {
                    in_lit = false;
                    i = i + 1;
                } else {
                    i = i + 1;
                }
            }
            if fn_body_depth == 0 {
                sig = sig + source.slice(lit_start, i);
            }
        } else if fn_body_depth > 0 {
            if b == 123 {
                fn_body_depth = fn_body_depth + 1;
            } else if b == 125 {
                fn_body_depth = fn_body_depth - 1;
                if fn_body_depth == 0 {
                    sig = sig + "{}";
                }
            }
            i = i + 1;
        } else {
            // fn_body_depth == 0: we are in top-level / struct / interface / fn header
            if is_ident_byte(b) {
                let w_start = i;
                while i < n && is_ident_byte(source.byte_at(i)) {
                    i = i + 1;
                }
                let word = source.slice(w_start, i);
                if word == fn_kw {
                    pending_fn_body = true;
                    paren_depth = 0;
                }
                sig = sig + word;
            } else {
                if b == 40 {
                    paren_depth = paren_depth + 1;
                } else if b == 41 {
                    if paren_depth > 0 {
                        paren_depth = paren_depth - 1;
                    }
                }
                if pending_fn_body && paren_depth == 0 {
                    if b == 59 {
                        // Interface or extern fn prototype ending in ';'
                        pending_fn_body = false;
                        sig = sig + ";";
                    } else if b == 123 {
                        // Opening '{' of executable fn body
                        pending_fn_body = false;
                        fn_body_depth = 1;
                    } else {
                        sig = sig + source.slice(i, i + 1);
                    }
                } else {
                    sig = sig + source.slice(i, i + 1);
                }
                i = i + 1;
            }
        }
    }
    return sig;
}

pub fn apply_doc_span_edit(doc: str, start_byte: i64, end_byte: i64, replacement: str) -> str {
    let n = doc.len();
    let s = if start_byte < 0 { 0 } else { if start_byte > n { n } else { start_byte } };
    let e = if end_byte < s { s } else { if end_byte > n { n } else { end_byte } };
    let prefix = doc.slice(0, s);
    let suffix = doc.slice(e, n);
    return prefix + replacement + suffix;
}

pub fn should_early_cutoff(old_source: str, new_source: str) -> i64 {
    let s1 = extract_item_tree_signature(old_source);
    let s2 = extract_item_tree_signature(new_source);
    if s1 == s2 {
        return 1;
    }
    return 0;
}

// ------------------------------------------------------------------------------
// PilotDb-backed LSP Document & Query Bridge
// ------------------------------------------------------------------------------

pub fn lsp_db_new() -> i64 {
    return pilotdb_new();
}

pub fn lsp_db_update_document(db: i64, uri: str, new_source: str) {
    let canon_uri = db_canonicalize_uri(uri);
    let fid = canon_uri.len() + 0;
    __engine("map_set", db, "uri_to_fid_" + canon_uri, fid);
    pilotdb_set_file_source(db, fid, new_source, durability_volatile());
}

pub fn lsp_db_get_document(db: i64, uri: str) -> str {
    let canon_uri = db_canonicalize_uri(uri);
    let fid = __engine("map_get", db, "uri_to_fid_" + canon_uri);
    if fid == none { return ""; }
    return pilotdb_get_file_source(db, fid + 0);
}

pub fn lsp_db_query_diagnostics(db: i64, uri: str) -> str {
    let canon_uri = db_canonicalize_uri(uri);
    let fid = __engine("map_get", db, "uri_to_fid_" + canon_uri);
    if fid == none { return ""; }
    return query_file_diagnostics(db, fid + 0);
}
