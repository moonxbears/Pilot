// ==============================================================================
// FILE: selfhost/loader/link_lines.pilot
// The files each of several programs links, as text for the CLI.
// ==============================================================================
// `pilot test --changed` (selfhost/cli/test_changed.pilot) runs this as a
// self-hosted tool: the loader resolves every program's `use` declarations
// exactly as it does when the program is run (`mg_link_plan`).
pub lvl(0) pkg Pilot.SelfHost.Loader.LinkLines;

use std.text;
use Pilot.SelfHost.Loader.ModuleGraph;

/// The separator between the entries `mg_link_lines` is given.
pub pure fn link_lines_separator() -> str => "|";

/// For each program in `entries` (paths separated by
/// `link_lines_separator()`), one line: the program, then each file it links,
/// separated by tabs, in link order. A program that does not link (a missing
/// package, a file it cannot read) gives its path and then `!`.
pub fn mg_link_lines(entries: str, toolchain_root: str) -> str {
    var lines: List<str> = [];
    for entry in text.split_text(entries, link_lines_separator()) {
        if entry.len() == 0 { continue; }
        let g = mg_build_graph(entry, toolchain_root);
        var fields: List<str> = [entry];
        if g.diagnostics.len() > 0 {
            fields.push("!");
        } else {
            for id in g.topo_order { fields.push(g.units[id.raw].file_path); }
        }
        lines.push(text.join_text(fields, "\t"));
    }
    return text.join_text(lines, "\n");
}
