// ==============================================================================
// FILE: selfhost/loader/pragma_filter.pilot
// Milestone 2.2: Pure-Pilot Pragma Interval Solver & Diagnostic Suppressor
// Replaces pipeline.rs:27-49 (#pragma warning/no_hardcode disable|restore)
// ==============================================================================
pub lvl(0) pkg selfhost.loader;

/// One stretch of source, `start_offset` to `end_offset` (bytes, end
/// excluded), where a `#pragma ... disable` turned off the diagnostic `code`,
/// or every warning when `is_all_warnings`.
pub struct PragmaInterval {
    pub start_offset: i64;
    pub end_offset: i64;
    pub code: str;
    pub is_all_warnings: bool;
}

/// A `#pragma ... disable` not yet restored: the key it opened (a code, or
/// `__ALL__`) and the offset of its line.
struct PragmaOpen {
    pub key: str;
    pub start: i64;
    pub closed: bool;
}

// ------------------------------------------------------------------------------
// String Utilities
// ------------------------------------------------------------------------------

pub pure fn pf_trim(s: str) -> str {
    let l = s.len();
    var start: i64 = 0;
    while start < l {
        let b = s.byte_at(start);
        if b != 32 && b != 9 && b != 13 && b != 10 { break; }
        start = start + 1;
    }
    var end: i64 = l;
    while end > start {
        let b = s.byte_at(end - 1);
        if b != 32 && b != 9 && b != 13 && b != 10 { break; }
        end = end - 1;
    }
    return s.slice(start, end);
}

pub pure fn pf_starts_with(s: str, pfx: str) -> bool {
    let sl = s.len();
    let pl = pfx.len();
    if pl > sl { return false; }
    let sub = s.slice(0, pl);
    return sub == pfx;
}

pub pure fn pf_find(haystack: str, needle: str, start: i64) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 { return if start <= hl { start as i64 } else { -1 }; }
    if nl > hl || start + nl > hl { return -1; }
    var i = start;
    while i + nl <= hl {
        var j = 0;
        while j < nl && haystack.byte_at(i + j) == needle.byte_at(j) {
            j = j + 1;
        }
        if j == nl { return i as i64; }
        i = i + 1;
    }
    return -1;
}

pub fn pragma_solve_intervals(src: str) -> List<PragmaInterval> {
    var list: List<PragmaInterval> = [];
    // Every interval starts at a `#pragma` line: none, no scan.
    if pf_find(src, "#pragma", 0) < 0 { return list; }
    var opened: List<PragmaOpen> = [];
    let sl = src.len();
    var cur: i64 = 0;

    while cur < sl {
        let nl = pf_find(src, "\n", cur);
        let line_end = if nl >= 0 { nl as i64 } else { sl };
        let line = src.slice(cur, line_end);
        let line_len = line_end - cur;
        let tr = pf_trim(line);

        var is_pragma = false;
        var is_disable = false;
        var is_restore = false;
        var code_arg = "";
        var is_all = false;

        if pf_starts_with(tr, "#pragma warning disable") {
            is_pragma = true;
            is_disable = true;
            code_arg = pf_trim(tr.slice(23, tr.len()));
            if code_arg.len() == 0 { is_all = true; }
        } else if pf_starts_with(tr, "#pragma warning restore") {
            is_pragma = true;
            is_restore = true;
            code_arg = pf_trim(tr.slice(23, tr.len()));
            if code_arg.len() == 0 { is_all = true; }
        } else if pf_starts_with(tr, "#pragma no_hardcode disable") {
            is_pragma = true;
            is_disable = true;
            code_arg = "HARD001";
        } else if pf_starts_with(tr, "#pragma no_hardcode restore") {
            is_pragma = true;
            is_restore = true;
            code_arg = "HARD001";
        }

        if is_pragma {
            let key = if is_all { "__ALL__" } else { code_arg };
            if is_disable {
                opened.push(PragmaOpen { key: key, start: cur, closed: false });
            } else if is_restore {
                let count = opened.len() as i64;
                var k: i64 = 0;
                while k < count {
                    let o = opened[k];
                    if !o.closed && o.key == key {
                        list.push(PragmaInterval {
                            start_offset: o.start,
                            end_offset: cur + line_len,
                            code: code_arg,
                            is_all_warnings: is_all,
                        });
                        opened[k] = PragmaOpen { key: o.key, start: o.start, closed: true };
                        break;
                    }
                    k = k + 1;
                }
            }
        }

        cur = if nl >= 0 { (nl + 1) as i64 } else { sl };
    }

    // Flush unclosed intervals to EOF
    for o in opened {
        if !o.closed {
            let whole = o.key == "__ALL__";
            list.push(PragmaInterval {
                start_offset: o.start,
                end_offset: sl,
                code: if whole { "" } else { o.key },
                is_all_warnings: whole,
            });
        }
    }

    return list;
}

pub fn pragma_is_suppressed(ref intervals: List<PragmaInterval>, offset: i64, diag_code: str, is_error: bool) -> bool {
    for iv in intervals {
        if offset >= iv.start_offset && offset < iv.end_offset {
            if iv.is_all_warnings {
                if !is_error { return true; }
            } else if iv.code == diag_code {
                return true;
            }
        }
    }
    return false;
}
