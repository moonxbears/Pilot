// ==============================================================================
// FILE: selfhost/loader/module_graph.pilot
// The module graph: which source files make up a program, and in what order
// they are linked.
//
// `pilot run` calls `mg_link_plan` before it compiles a program. Starting from
// the entry file, the loader reads each file's `pkg` and `use` declarations
// (parsed by the seed parser, never scanned as text), resolves every `use` to
// the files that declare that package, and orders the files so each comes
// after the files it imports. The implicit prelude (`Pilot.Core.Prelude`) is
// linked before everything else, so every program has it without a `use`.
//
// Resolving `use A.B.C`:
//   - the path names a package, or an item of a package (`use A.B.Item`);
//   - `.*`, `::*` and a `.{X, Y}` selection name the package before them;
//   - a package is looked up first where its name says (`std.col` ->
//     `stdlib/std/col.pilot`, `Pilot.Core.Option` -> `stdlib/core/option.pilot`),
//     then in an index of the `pkg` declarations of every file under the
//     search roots, built the first time the convention misses.
//
// Diagnostics: MOD001 for a `use` that names no package, MOD002 for an import
// cycle. Each points at the `use` declaration that closes it.
// ==============================================================================
pub lvl(0) pkg selfhost.loader;

use Pilot.Core.File;
use selfhost.diagnostics.*;

/// One `pkg` or `use` declaration at the head of a file.
[Layout(c_abi)]
pub struct HeaderDecl : IValue {
    pub is_package: bool;
    pub path: str;
    pub alias: str;
    pub offset: u32;
}

/// The `pkg` and `use` declarations at the head of a source file, as the
/// seed parser reads them.
fn mg_is_ident_start(b: u8) -> bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

fn mg_is_ident_char(b: u8) -> bool {
    return mg_is_ident_start(b) || (b >= 48 && b <= 57);
}

fn mg_skip_ws_and_comments(src: str, start: i64) -> i64 {
    let n = src.len();
    var i = start;
    while i < n {
        let b = src.byte_at(i);
        if b == 32 || b == 9 || b == 10 || b == 13 {
            i = i + 1;
            continue;
        }
        if b == 47 && i + 1 < n {
            let b2 = src.byte_at(i + 1);
            if b2 == 47 {
                i = i + 2;
                while i < n && src.byte_at(i) != 10 { i = i + 1; }
                continue;
            }
            if b2 == 42 {
                i = i + 2;
                while i + 1 < n && !(src.byte_at(i) == 42 && src.byte_at(i + 1) == 47) {
                    i = i + 1;
                }
                if i + 1 < n { i = i + 2; } else { i = n; }
                continue;
            }
        }
        break;
    }
    return i;
}

fn mg_skip_string(src: str, start: i64, qchar: i64) -> i64 {
    let n = src.len();
    var i = start + 1;
    while i < n {
        let b = src.byte_at(i);
        if b == 92 {
            i = i + 2;
            continue;
        }
        if b == qchar { return i + 1; }
        i = i + 1;
    }
    return n;
}

fn mg_read_dotted_path(src: str, ref pos: i64) -> str {
    let n = src.len();
    var i = mg_skip_ws_and_comments(src, pos);
    let start = i;
    while i < n {
        let b = src.byte_at(i);
        if mg_is_ident_char(b) || b == 46 || b == 42 {
            i = i + 1;
            continue;
        }
        if b == 58 && i + 1 < n && src.byte_at(i + 1) == 58 {
            i = i + 2;
            continue;
        }
        break;
    }
    pos = i;
    return src.slice(start, i);
}

fn mg_scan_unit_header(src: str) -> List<HeaderDecl> {
    var decls: List<HeaderDecl> = [];
    let n = src.len();
    var i = 0;
    var brace_depth = 0;
    var bracket_depth = 0;
    var paren_depth = 0;
    while i < n {
        i = mg_skip_ws_and_comments(src, i);
        if i >= n { break; }
        let b = src.byte_at(i);
        if b == 34 || b == 39 {
            i = mg_skip_string(src, i, b);
            continue;
        }
        if b == 123 { brace_depth = brace_depth + 1; i = i + 1; continue; }
        if b == 125 { if brace_depth > 0 { brace_depth = brace_depth - 1; } i = i + 1; continue; }
        if b == 91 { bracket_depth = bracket_depth + 1; i = i + 1; continue; }
        if b == 93 { if bracket_depth > 0 { bracket_depth = bracket_depth - 1; } i = i + 1; continue; }
        if b == 40 { paren_depth = paren_depth + 1; i = i + 1; continue; }
        if b == 41 { if paren_depth > 0 { paren_depth = paren_depth - 1; } i = i + 1; continue; }
        if b == 35 && brace_depth == 0 {
            while i < n && src.byte_at(i) != 10 { i = i + 1; }
            continue;
        }
        if mg_is_ident_start(b) {
            let tok_start = i;
            i = i + 1;
            while i < n && mg_is_ident_char(src.byte_at(i)) { i = i + 1; }
            let word = src.slice(tok_start, i);
            if brace_depth == 0 && bracket_depth == 0 && paren_depth == 0 {
                if word == "pkg" {
                    let pkg_path = mg_read_dotted_path(src, i);
                    if pkg_path != "" {
                        decls.push(HeaderDecl { is_package: true, path: pkg_path, alias: "", offset: tok_start as u32 });
                    }
                    while i < n && src.byte_at(i) != 59 { i = i + 1; }
                    if i < n { i = i + 1; }
                    continue;
                }
                if word == "use" {
                    let use_path = mg_read_dotted_path(src, i);
                    var alias = "";
                    i = mg_skip_ws_and_comments(src, i);
                    if i + 2 <= n && src.slice(i, i + 2) == "as" && (i + 2 == n || !mg_is_ident_char(src.byte_at(i + 2))) {
                        i = mg_skip_ws_and_comments(src, i + 2);
                        let a_start = i;
                        while i < n && mg_is_ident_char(src.byte_at(i)) { i = i + 1; }
                        alias = src.slice(a_start, i);
                    }
                    if use_path != "" {
                        decls.push(HeaderDecl { is_package: false, path: use_path, alias: alias, offset: tok_start as u32 });
                    }
                    while i < n && src.byte_at(i) != 59 {
                        if src.byte_at(i) == 123 {
                            i = i + 1;
                            var d = 1;
                            while i < n && d > 0 {
                                if src.byte_at(i) == 123 { d = d + 1; }
                                else if src.byte_at(i) == 125 { d = d - 1; }
                                i = i + 1;
                            }
                        } else {
                            i = i + 1;
                        }
                    }
                    if i < n { i = i + 1; }
                    continue;
                }
                if word == "fn" || word == "struct" || word == "interface" || word == "enum" || word == "comptime" {
                    break;
                }
            }
            continue;
        }
        i = i + 1;
    }
    return decls;
}

pub struct UnitHeader : IValue {
    pub decls: List<HeaderDecl>;

    /// The header of the file at `path`, or `none` when it cannot be read.
    pub static fn read(path: str) -> UnitHeader? {
        if !File.exists(path) { return none; }
        let src = File.read_text(path);
        return UnitHeader { decls: mg_scan_unit_header(src) };
    }

    /// The package the file declares, or `""`.
    pub fn package_name() -> str {
        for d in .decls {
            if d.is_package { return d.path; }
        }
        return "";
    }
}

/// One file of the program.
pub struct ModuleNode : IObject {
    pub id: FileUnitId;
    pub pkg_name: str;
    pub file_path: str;
    /// Units this one imports, and the offset of the `use` naming each.
    pub deps: List<i64>;
    pub dep_offsets: List<u32>;

    ~self() {
    }
}

/// A loader error, at a byte offset of a file.
[Layout(c_abi)]
pub struct ModuleDiagnostic : IValue {
    pub code: str;
    pub message: str;
    pub file_path: str;
    pub offset: u32;
}

pub struct ModuleGraph : IObject {
    pub units: List<ModuleNode>;
    /// Unit index by normalized file path.
    pub by_path: Map<str, i64>;
    /// Files declaring each package, from the roots indexed so far.
    pub pkg_files: Map<str, List<str>>;
    /// How many of `roots` (in order) `pkg_files` covers.
    pub indexed: i64;
    /// The `pkg` declarations found under each root so far, as package and
    /// file by turns; shared by the graphs one tool run builds.
    pub root_index: Map<str, List<str>>;
    pub roots: List<str>;
    pub topo_order: List<FileUnitId>;
    pub diagnostics: List<ModuleDiagnostic>;

    ~self() {
    }
}

/// The package every program links without importing it.
pub pure fn mg_prelude_package() -> str => "Pilot.Core.Prelude";

/// The genesis package (`stdlib/core/core.pilot`). The toolchain reads it
/// before any program, so importing it links nothing.
pub pure fn mg_genesis_package() -> str => "Pilot.Core.Genesis";

pub pure fn mg_unit_span(fid: FileUnitId, start: u32, end: u32) -> SourceSpan => source_span_new(fid.raw, start, end);

// ------------------------------------------------------------------------------
// Paths
// ------------------------------------------------------------------------------

/// Uses `/` separators, an upper-case drive letter, and no leading `./`.
pub pure fn mg_normalize_path(p: str) -> str {
    var s = p.replace("\\", "/");
    if s.len() >= 2 && s.byte_at(1) == 58 {
        let b = s.byte_at(0);
        if b >= 97 && b <= 122 {
            let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            s = upper.slice(b - 97, b - 96) + s.slice(1, s.len());
        }
    }
    while s.starts_with("./") && s.len() > 2 {
        s = s.slice(2, s.len());
    }
    return s;
}

pub pure fn mg_to_lower(s: str) -> str {
    let lower = "abcdefghijklmnopqrstuvwxyz";
    var out = "";
    var i = 0;
    while i < s.len() {
        let b = s.byte_at(i) as i64;
        if b >= 65 && b <= 90 {
            out = out + lower.slice(b - 65, b - 64);
        } else {
            out = out + s.slice(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

/// The directory part of `path`, or `"."`.
pub pure fn mg_dir_of(path: str) -> str {
    var i = path.len();
    while i > 0 {
        if path.byte_at(i - 1) == 47 { return path.slice(0, i - 1); }
        i = i - 1;
    }
    return ".";
}

pub pure fn mg_lines(text: str) -> List<str> {
    var out: List<str> = [];
    var start = 0;
    loop {
        let nl = text.find("\n", start);
        if nl < 0 {
            if start < text.len() { out.push(text.slice(start, text.len())); }
            break;
        }
        if nl > start { out.push(text.slice(start, nl)); }
        start = nl + 1;
    }
    return out;
}

/// Where packages are looked for: the entry file's directory, then the
/// standard library of the toolchain at `toolchain_root`, then its
/// self-hosted compiler (`selfhost.*`, one package per directory).
pub fn mg_default_search_roots(entry_dir: str, toolchain_root: str) -> List<str> {
    return [
        mg_normalize_path(entry_dir),
        mg_normalize_path(toolchain_root + "/stdlib"),
        mg_normalize_path(toolchain_root + "/selfhost"),
    ];
}

// ------------------------------------------------------------------------------
// Package resolution
// ------------------------------------------------------------------------------

/// The package a `use` path names, before any `.*`, `::*` or selection.
pub pure fn mg_import_package(spec: str) -> str {
    var p = spec.replace("::", ".");
    let brace = p.find("{", 0);
    if brace >= 0 { p = p.slice(0, brace); }
    while p.ends_with(".") || p.ends_with("*") {
        p = p.slice(0, p.len() - 1);
    }
    return p;
}

/// Where the name of `pkg` says it lives under `root`.
pub fn mg_conventional_paths(root: str, pkg: str) -> List<str> {
    if pkg == "Pilot.Core.Bridge.Lang" { return [f"{root}/core/bridge_lang.pilot"]; }
    if pkg == "Pilot.Core.HostRaw"     { return [f"{root}/core/host_raw.pilot"]; }
    if pkg == "Pilot.Core.OsAbi"       { return [f"{root}/core/os_abi.pilot"]; }
    let rel = pkg.replace(".", "/");
    var sub = rel;
    if mg_to_lower(sub).starts_with("pilot/") { sub = sub.slice(6, sub.len()); }
    let lower = mg_to_lower(sub);
    return [
        f"{root}/{rel}.pilot",
        f"{root}/{lower}.pilot",
        f"{root}/{lower}/{lower}.pilot",
    ];
}

/// The `pkg` declarations of the source files under `root`, as package and
/// file by turns; read once per tool run.
pub fn mg_root_pairs(ref g: ModuleGraph, root: str) -> List<str> {
    if !g.root_index.has(root) {
        var found: List<str> = [];
        for file in mg_lines(File.walk_files(root)) {
            if !file.ends_with(".pilot") { continue; }
            let path = mg_normalize_path(file);
            guard some h = UnitHeader.read(path) else { continue; };
            let pkg = h.package_name();
            if pkg == "" { continue; }
            found.push(pkg);
            found.push(path);
        }
        g.root_index.set(root, found);
    }
    return g.root_index[root];
}

/// The search root `path` lies under (the longest one containing it), or
/// `""` when none does. `.` contains every relative path.
pub fn mg_root_of(ref g: ModuleGraph, path: str) -> str {
    var best = "";
    for root in g.roots {
        let inside = (root == "." && !path.starts_with("/")) || path.starts_with(root + "/");
        if inside && root.len() > best.len() { best = root; }
    }
    return best;
}

/// Every file under `root` declaring package `pkg`. A package's files all
/// live under one root.
pub fn mg_package_members(ref g: ModuleGraph, root: str, pkg: str) -> List<str> {
    var out: List<str> = [];
    if root == "" { return out; }
    let pairs = mg_root_pairs(g, root);
    var i = 0;
    while i < pairs.len() {
        if pairs[i] == pkg { out.push(pairs[i + 1]); }
        i = i + 2;
    }
    return out;
}

/// Adds the `pkg` declarations under the next root not yet indexed.
pub fn mg_index_next_root(var ref g: ModuleGraph) {
    let pairs = mg_root_pairs(g, g.roots[g.indexed]);
    g.indexed = g.indexed + 1;
    var i = 0;
    while i < pairs.len() {
        if !g.pkg_files.has(pairs[i]) { g.pkg_files.set(pairs[i], []); }
        g.pkg_files.get(pairs[i]).push(pairs[i + 1]);
        i = i + 2;
    }
}

/// The files declaring package `pkg`; empty when none does. Roots are
/// indexed in order only as far as needed, so a package under an earlier
/// root hides one of the same name under a later root.
pub fn mg_package_files(var ref g: ModuleGraph, pkg: str) -> List<str> {
    if g.pkg_files.has(pkg) { return g.pkg_files[pkg]; }
    if g.indexed == 0 {
        for root in g.roots {
            for path in mg_conventional_paths(root, pkg) {
                if !File.exists(path) { continue; }
                guard some h = UnitHeader.read(path) else { continue; };
                if h.package_name() == pkg { return [mg_normalize_path(path)]; }
            }
        }
    }
    while g.indexed < g.roots.len() {
        mg_index_next_root(g);
        if g.pkg_files.has(pkg) { return g.pkg_files[pkg]; }
    }
    return [];
}

/// The package a `use` path imports: the package it names, or the package
/// whose item it names. `""` when it names neither.
pub fn mg_resolve_import_package(var ref g: ModuleGraph, spec: str) -> str {
    let pkg = mg_import_package(spec);
    if mg_package_files(g, pkg).len() > 0 { return pkg; }
    var i = pkg.len();
    while i > 0 {
        if pkg.byte_at(i - 1) == 46 {
            let parent = pkg.slice(0, i - 1);
            if mg_package_files(g, parent).len() > 0 { return parent; }
            return "";
        }
        i = i - 1;
    }
    return "";
}

/// The files a `use` path imports: those of `mg_resolve_import_package`.
/// Empty when it names no package.
pub fn mg_resolve_import_path(var ref g: ModuleGraph, spec: str) -> List<str> {
    let pkg = mg_resolve_import_package(g, spec);
    if pkg == "" { return []; }
    return mg_package_files(g, pkg);
}

// ------------------------------------------------------------------------------
// Graph construction
// ------------------------------------------------------------------------------

/// A new unit for the file at `path` whose header is `h`.
pub fn mg_extract_package_info(path: str, id: u32, h: UnitHeader) -> ModuleNode {
    return ModuleNode {
        id: file_unit_id_new(id),
        pkg_name: h.package_name(),
        file_path: path,
        deps: [],
        dep_offsets: [],
    };
}

fn mg_report(var ref g: ModuleGraph, code: str, message: str, path: str, offset: u32) {
    g.diagnostics.push(ModuleDiagnostic { code: code, message: message, file_path: path, offset: offset });
}

/// The unit for `path`, adding it (and the units it imports) when new.
/// `-1` when the file cannot be read.
fn mg_unit_for(var ref g: ModuleGraph, path: str) -> i64 {
    if g.by_path.has(path) { return g.by_path[path]; }
    guard some h = UnitHeader.read(path) else { return -1; };
    let id = g.units.len() as i64;
    let node = mg_extract_package_info(path, id, h);
    g.units.push(node);
    g.by_path.set(path, id);
    // A package is all the files declaring it: they load together and see
    // each other without importing, so no edge joins them.
    let own = h.package_name();
    if own != "" {
        for f in mg_package_members(g, mg_root_of(g, path), own) {
            if f != path { mg_unit_for(g, f); }
        }
    }
    for d in h.decls {
        if d.is_package || mg_import_package(d.path) == mg_genesis_package() { continue; }
        let pkg = mg_resolve_import_package(g, d.path);
        if pkg == "" {
            mg_report(g, "MOD001", f"no package `{mg_import_package(d.path)}` for `use {d.path}`", path, d.offset);
            continue;
        }
        if pkg == own { continue; }
        for f in mg_package_files(g, pkg) {
            if f == path { continue; }
            let dep = mg_unit_for(g, f);
            if dep >= 0 {
                node.deps.push(dep);
                node.dep_offsets.push(d.offset);
            }
        }
    }
    return id;
}

/// Depth-first visit: appends `u` after everything it imports and after the
/// other files of its package (so the entry file stays last). `state` is 0
/// for unvisited, 1 while `u`'s imports are being visited, 2 when done.
fn mg_visit(var ref g: ModuleGraph, u: i64, var ref state: List<i64>, var ref stack: List<i64>) {
    state[u] = 1;
    stack.push(u);
    let node = g.units[u];
    var i = 0;
    while i < node.deps.len() {
        let d = node.deps[i];
        if state[d] == 1 {
            // Named by package: files of one package on the path count once.
            var cycle = "";
            var last = "";
            var k = 0;
            var on = false;
            while k < stack.len() {
                if stack[k] == d { on = true; }
                let name = g.units[stack[k]].pkg_name;
                if on && name != last {
                    cycle = cycle + name + " -> ";
                    last = name;
                }
                k = k + 1;
            }
            cycle = cycle + g.units[d].pkg_name;
            mg_report(g, "MOD002", f"import cycle: {cycle}", node.file_path, node.dep_offsets[i]);
        } else if state[d] == 0 {
            mg_visit(g, d, state, stack);
        }
        i = i + 1;
    }
    if node.pkg_name != "" {
        for f in mg_package_members(g, mg_root_of(g, node.file_path), node.pkg_name) {
            if g.by_path.has(f) {
                let sib = g.by_path[f];
                if state[sib] == 0 { mg_visit(g, sib, state, stack); }
            }
        }
    }
    let _ = stack.pop();
    state[u] = 2;
    // A unit index: one per loaded file.
    g.topo_order.push(file_unit_id_new(u as u32));
}

/// The module graph of the program whose entry file is `entry_file`.
pub fn mg_build_graph(entry_file: str, toolchain_root: str) -> ModuleGraph => mg_build_graph_sharing(entry_file, toolchain_root, [:], []);

/// `mg_build_graph`, taking the `pkg` declarations of a root already in
/// `root_index` from there and adding those of each root it has to read.
/// The files under the roots must not change between the graphs sharing it.
/// The files `extras` names are entry points too, linked (with what they
/// import) after the prelude and before the program (PROP-013).
pub fn mg_build_graph_sharing(entry_file: str, toolchain_root: str, root_index: Map<str, List<str>>, ref extras: List<str>) -> ModuleGraph {
    let entry = mg_normalize_path(entry_file);
    let g = ModuleGraph {
        units: [],
        by_path: [:],
        pkg_files: [:],
        indexed: 0,
        root_index: root_index,
        roots: mg_default_search_roots(mg_dir_of(entry), toolchain_root),
        topo_order: [],
        diagnostics: [],
    };
    var starts: List<i64> = [];
    for f in mg_package_files(g, mg_prelude_package()) {
        let u = mg_unit_for(g, f);
        if u >= 0 { starts.push(u); }
    }
    for extra in extras {
        let path = mg_normalize_path(extra);
        let u = mg_unit_for(g, path);
        if u < 0 {
            mg_report(g, "MOD001", f"cannot read `{path}`", path, 0);
            return g;
        }
        starts.push(u);
    }
    let main_unit = mg_unit_for(g, entry);
    if main_unit < 0 {
        mg_report(g, "MOD001", f"cannot read `{entry}`", entry, 0);
        return g;
    }
    starts.push(main_unit);
    var state: List<i64> = [];
    for _ in g.units { state.push(0); }
    for u in starts {
        if state[u] == 0 { mg_visit(g, u, state, []); }
    }
    return g;
}

/// What the host needs to link the program: `[paths, diagnostics]`, the
/// unit files in link order (entry last) and each diagnostic as
/// `[code, message, path, offset]`.
pub fn mg_link_plan(entry_file: str, toolchain_root: str) -> List<any> => mg_link_plan_with(entry_file, toolchain_root, []);

/// `mg_link_plan`, with the files `extras` names (and what they import)
/// linked after the prelude and before the program, in the same pass; a
/// file the program links already is linked once.
pub fn mg_link_plan_with(entry_file: str, toolchain_root: str, ref extras: List<str>) -> List<any> {
    let g = mg_build_graph_sharing(entry_file, toolchain_root, [:], extras);
    var paths: List<str> = [];
    for id in g.topo_order {
        paths.push(g.units[id.raw].file_path);
    }
    var diags: List<any> = [];
    for d in g.diagnostics {
        diags.push([d.code, d.message, d.file_path, d.offset]);
    }
    return [paths, diags];
}
