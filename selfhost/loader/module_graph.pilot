// ==============================================================================
// FILE: selfhost/loader/module_graph.pilot
// The module graph: which source files make up a program, and in what order
// they are linked.
//
// `pilot run` calls `mg_link_plan` before it compiles a program. Starting from
// the entry file, the loader reads each file's `pkg` and `use` declarations
// (parsed by the seed parser, never scanned as text), resolves every `use` to
// the files that declare that package, and orders the files so each comes
// after the files it imports. The implicit prelude (`Pilot.Core.Prelude`) is
// linked before everything else, so every program has it without a `use`.
//
// Resolving `use A.B.C`:
//   - the path names a package, or an item of a package (`use A.B.Item`);
//   - `.*`, `::*` and a `.{X, Y}` selection name the package before them;
//   - a package is looked up first where its name says (`std.col` ->
//     `stdlib/std/col.pilot`, `Pilot.Core.Option` -> `stdlib/core/option.pilot`),
//     then in an index of the `pkg` declarations of every file under the
//     search roots, built the first time the convention misses.
//
// Diagnostics: MOD001 for a `use` that names no package, MOD002 for an import
// cycle. Each points at the `use` declaration that closes it.
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Loader.ModuleGraph;

use Pilot.Core.File;
use Pilot.Diagnostics.Model;

/// One `pkg` or `use` declaration at the head of a file.
[Layout(c_abi)]
pub struct HeaderDecl : IValue {
    pub is_package: bool;
    pub path: str;
    pub alias: str;
    pub offset: u32;
}

/// The `pkg` and `use` declarations at the head of a source file, as the
/// seed parser reads them.
pub struct UnitHeader : IValue {
    pub decls: List<HeaderDecl>;

    /// The header of the file at `path`, or `none` when it cannot be read.
    pub static fn read(path: str) -> UnitHeader? {
        let raw = __engine("unit_header", path);
        if raw == none { return none; }
        var decls: List<HeaderDecl> = [];
        for d in raw {
            decls.push(HeaderDecl { is_package: d[0], path: d[1], alias: d[2], offset: d[3] });
        }
        return UnitHeader { decls: decls };
    }

    /// The package the file declares, or `""`.
    pub fn package_name() -> str {
        for d in .decls {
            if d.is_package { return d.path; }
        }
        return "";
    }
}

/// One file of the program.
pub struct ModuleNode : IObject {
    pub id: FileUnitId;
    pub pkg_name: str;
    pub file_path: str;
    /// Units this one imports, and the offset of the `use` naming each.
    pub deps: List<i64>;
    pub dep_offsets: List<u32>;

    ~self() {
    }
}

/// A loader error, at a byte offset of a file.
[Layout(c_abi)]
pub struct ModuleDiagnostic : IValue {
    pub code: str;
    pub message: str;
    pub file_path: str;
    pub offset: u32;
}

pub struct ModuleGraph : IObject {
    pub units: List<ModuleNode>;
    /// Unit index by normalized file path.
    pub by_path: Map<str, i64>;
    /// Files declaring each package, once the index is built.
    pub pkg_files: Map<str, List<str>>;
    pub indexed: bool;
    pub roots: List<str>;
    pub topo_order: List<FileUnitId>;
    pub diagnostics: List<ModuleDiagnostic>;

    ~self() {
    }
}

/// The package every program links without importing it.
pub pure fn mg_prelude_package() -> str => "Pilot.Core.Prelude";

/// The genesis package (`stdlib/core/core.pilot`). The toolchain reads it
/// before any program, so importing it links nothing.
pub pure fn mg_genesis_package() -> str => "Pilot.Core.Genesis";

pub pure fn mg_unit_span(fid: FileUnitId, start: u32, end: u32) -> SourceSpan => source_span_new(fid.raw, start, end);

// ------------------------------------------------------------------------------
// Paths
// ------------------------------------------------------------------------------

/// Uses `/` separators, an upper-case drive letter, and no leading `./`.
pub pure fn mg_normalize_path(p: str) -> str {
    var s = p.replace("\\", "/");
    if s.len() >= 2 && s.byte_at(1) == 58 {
        let b = s.byte_at(0);
        if b >= 97 && b <= 122 {
            let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
            s = upper.slice(b - 97, b - 96) + s.slice(1, s.len());
        }
    }
    while s.starts_with("./") && s.len() > 2 {
        s = s.slice(2, s.len());
    }
    return s;
}

pub pure fn mg_to_lower(s: str) -> str {
    let lower = "abcdefghijklmnopqrstuvwxyz";
    var out = "";
    var i = 0;
    while i < s.len() {
        let b = s.byte_at(i);
        if b >= 65 && b <= 90 {
            out = out + lower.slice(b - 65, b - 64);
        } else {
            out = out + s.slice(i, i + 1);
        }
        i = i + 1;
    }
    return out;
}

/// The directory part of `path`, or `"."`.
pub pure fn mg_dir_of(path: str) -> str {
    var i = path.len();
    while i > 0 {
        if path.byte_at(i - 1) == 47 { return path.slice(0, i - 1); }
        i = i - 1;
    }
    return ".";
}

pub pure fn mg_lines(text: str) -> List<str> {
    var out: List<str> = [];
    var start = 0;
    loop {
        let nl = text.find("\n", start);
        if nl < 0 {
            if start < text.len() { out.push(text.slice(start, text.len())); }
            break;
        }
        if nl > start { out.push(text.slice(start, nl)); }
        start = nl + 1;
    }
    return out;
}

/// Where packages are looked for: the entry file's directory, then the
/// standard library of the toolchain at `toolchain_root`.
pub fn mg_default_search_roots(entry_dir: str, toolchain_root: str) -> List<str> {
    return [mg_normalize_path(entry_dir), mg_normalize_path(toolchain_root + "/stdlib")];
}

// ------------------------------------------------------------------------------
// Package resolution
// ------------------------------------------------------------------------------

/// The package a `use` path names, before any `.*`, `::*` or selection.
pub pure fn mg_import_package(spec: str) -> str {
    var p = spec.replace("::", ".");
    let brace = p.find("{", 0);
    if brace >= 0 { p = p.slice(0, brace); }
    while p.ends_with(".") || p.ends_with("*") {
        p = p.slice(0, p.len() - 1);
    }
    return p;
}

/// Where the name of `pkg` says it lives under `root`.
pub fn mg_conventional_paths(root: str, pkg: str) -> List<str> {
    let rel = pkg.replace(".", "/");
    var sub = rel;
    if mg_to_lower(sub).starts_with("pilot/") { sub = sub.slice(6, sub.len()); }
    let lower = mg_to_lower(sub);
    return [
        f"{root}/{rel}.pilot",
        f"{root}/{lower}.pilot",
        f"{root}/{lower}/{lower}.pilot",
    ];
}

/// Indexes the `pkg` declaration of every source file under the roots.
pub fn mg_build_index(g: ModuleGraph) {
    g.indexed = true;
    for root in g.roots {
        for file in mg_lines(File.walk_files(root)) {
            if !file.ends_with(".pilot") { continue; }
            let path = mg_normalize_path(file);
            guard some h = UnitHeader.read(path) else { continue; };
            let pkg = h.package_name();
            if pkg == "" { continue; }
            if !g.pkg_files.has(pkg) { g.pkg_files.set(pkg, []); }
            g.pkg_files.get(pkg).push(path);
        }
    }
}

/// The files declaring package `pkg`; empty when none does.
pub fn mg_package_files(g: ModuleGraph, pkg: str) -> List<str> {
    if !g.indexed {
        for root in g.roots {
            for path in mg_conventional_paths(root, pkg) {
                if !File.exists(path) { continue; }
                guard some h = UnitHeader.read(path) else { continue; };
                if h.package_name() == pkg { return [mg_normalize_path(path)]; }
            }
        }
        mg_build_index(g);
    }
    if g.pkg_files.has(pkg) { return g.pkg_files.get(pkg); }
    return [];
}

/// The files a `use` path imports: the package it names, or the package
/// whose item it names. Empty when it names neither.
pub fn mg_resolve_import_path(g: ModuleGraph, spec: str) -> List<str> {
    let pkg = mg_import_package(spec);
    let files = mg_package_files(g, pkg);
    if files.len() > 0 { return files; }
    var i = pkg.len();
    while i > 0 {
        if pkg.byte_at(i - 1) == 46 {
            return mg_package_files(g, pkg.slice(0, i - 1));
        }
        i = i - 1;
    }
    return [];
}

// ------------------------------------------------------------------------------
// Graph construction
// ------------------------------------------------------------------------------

/// A new unit for the file at `path` whose header is `h`.
pub fn mg_extract_package_info(path: str, id: u32, h: UnitHeader) -> ModuleNode {
    return ModuleNode {
        id: file_unit_id_new(id),
        pkg_name: h.package_name(),
        file_path: path,
        deps: [],
        dep_offsets: [],
    };
}

fn mg_report(g: ModuleGraph, code: str, message: str, path: str, offset: u32) {
    g.diagnostics.push(ModuleDiagnostic { code: code, message: message, file_path: path, offset: offset });
}

/// The unit for `path`, adding it (and the units it imports) when new.
/// `-1` when the file cannot be read.
fn mg_unit_for(g: ModuleGraph, path: str) -> i64 {
    if g.by_path.has(path) { return g.by_path.get(path); }
    guard some h = UnitHeader.read(path) else { return -1; };
    let id = g.units.len();
    let node = mg_extract_package_info(path, id, h);
    g.units.push(node);
    g.by_path.set(path, id);
    for d in h.decls {
        if d.is_package || mg_import_package(d.path) == mg_genesis_package() { continue; }
        let files = mg_resolve_import_path(g, d.path);
        if files.len() == 0 {
            mg_report(g, "MOD001", f"no package `{mg_import_package(d.path)}` for `use {d.path}`", path, d.offset);
            continue;
        }
        for f in files {
            if f == path { continue; }
            let dep = mg_unit_for(g, f);
            if dep >= 0 {
                node.deps.push(dep);
                node.dep_offsets.push(d.offset);
            }
        }
    }
    return id;
}

/// Depth-first visit: appends `u` after everything it imports. `state` is
/// 0 for unvisited, 1 while `u`'s imports are being visited, 2 when done.
fn mg_visit(g: ModuleGraph, u: i64, state: List<i64>, stack: List<i64>) {
    state[u] = 1;
    stack.push(u);
    let node = g.units[u];
    var i = 0;
    while i < node.deps.len() {
        let d = node.deps[i];
        if state[d] == 1 {
            var cycle = "";
            var k = 0;
            var on = false;
            while k < stack.len() {
                if stack[k] == d { on = true; }
                if on { cycle = cycle + g.units[stack[k]].pkg_name + " -> "; }
                k = k + 1;
            }
            cycle = cycle + g.units[d].pkg_name;
            mg_report(g, "MOD002", f"import cycle: {cycle}", node.file_path, node.dep_offsets[i]);
        } else if state[d] == 0 {
            mg_visit(g, d, state, stack);
        }
        i = i + 1;
    }
    let _ = stack.pop();
    state[u] = 2;
    g.topo_order.push(file_unit_id_new(u));
}

/// The module graph of the program whose entry file is `entry_file`.
pub fn mg_build_graph(entry_file: str, toolchain_root: str) -> ModuleGraph {
    let entry = mg_normalize_path(entry_file);
    let g = ModuleGraph {
        units: [],
        by_path: [:],
        pkg_files: [:],
        indexed: false,
        roots: mg_default_search_roots(mg_dir_of(entry), toolchain_root),
        topo_order: [],
        diagnostics: [],
    };
    var starts: List<i64> = [];
    for f in mg_package_files(g, mg_prelude_package()) {
        let u = mg_unit_for(g, f);
        if u >= 0 { starts.push(u); }
    }
    let main_unit = mg_unit_for(g, entry);
    if main_unit < 0 {
        mg_report(g, "MOD001", f"cannot read `{entry}`", entry, 0);
        return g;
    }
    starts.push(main_unit);
    var state: List<i64> = [];
    for _ in g.units { state.push(0); }
    for u in starts {
        if state[u] == 0 { mg_visit(g, u, state, []); }
    }
    return g;
}

/// What the host needs to link the program: `[paths, diagnostics]`, the
/// unit files in link order (entry last) and each diagnostic as
/// `[code, message, path, offset]`.
pub fn mg_link_plan(entry_file: str, toolchain_root: str) -> List<any> {
    let g = mg_build_graph(entry_file, toolchain_root);
    var paths: List<str> = [];
    for id in g.topo_order {
        paths.push(g.units[id.raw].file_path);
    }
    var diags: List<any> = [];
    for d in g.diagnostics {
        diags.push([d.code, d.message, d.file_path, d.offset]);
    }
    return [paths, diags];
}
