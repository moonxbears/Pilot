// ==============================================================================
// FILE: selfhost/loader/module_graph.pilot
// Milestone 2.1: Pure-Pilot Topological DAG Resolver & Module Graph
// Replaces Rust load_program & hardcoded path heuristics (MOD001 - MOD004)
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Loader.ModuleGraph;

[Layout(c_abi)]
pub struct FileUnitId : IValue {
    pub raw: u32;
}

[Layout(c_abi)]
pub struct SourceSpan : IValue {
    pub file_id: FileUnitId;
    pub start: u32;
    pub end: u32;
}

[Layout(c_abi)]
pub struct ModuleNode : IValue {
    pub id: FileUnitId;
    pub pkg_name: str;
    pub file_path: str;
    pub content_hash: u64;
    pub clearance_lvl: i32;
}

[Layout(c_abi)]
pub struct ModuleDiagnostic : IValue {
    pub code: str;
    pub message: str;
    pub file_path: str;
    pub line: usize;
    pub column: usize;
}

pub struct ModuleGraph : IObject {
    pub units: List<ModuleNode>;
    pub pkg_to_unit: Map<str, FileUnitId>;
    pub edges: Map<u32, List<FileUnitId>>;
    pub topo_order: List<FileUnitId>;
    pub diagnostics: List<ModuleDiagnostic>;

    ~self() {
    }
}

// ------------------------------------------------------------------------------
// Internal dynamic list and map helpers built on VM map primitives
// ------------------------------------------------------------------------------

pub fn glist_new() -> i64 {
    let m = __engine("map_new");
    __engine("map_set", m, "count", 0);
    return m;
}

pub fn glist_len(list: i64) -> usize {
    return __engine("map_get", list, "count") + 0;
}

pub fn glist_push(list: i64, item: any) -> usize {
    let idx = glist_len(list);
    __engine("map_set", list, idx, item);
    __engine("map_set", list, "count", idx + 1);
    return idx + 1;
}

pub fn glist_get(list: i64, idx: usize) -> any {
    return __engine("map_get", list, idx);
}

pub fn glist_get_str(list: i64, idx: usize) -> str {
    return __engine("map_get", list, idx);
}

pub fn glist_pop(list: i64) -> str {
    let n = glist_len(list);
    if n == 0 { return ""; }
    let last = glist_get_str(list, n - 1);
    __engine("map_set", list, "count", n - 1);
    return last;
}

pub fn gmap_new() -> i64 {
    return __engine("map_new");
}

pub fn gmap_set(m: i64, key: str, val: any) -> i64 {
    __engine("map_set", m, key, val);
    return m;
}

pub fn gmap_set_int(m: i64, key: str, val: i64) -> i64 {
    __engine("map_set", m, key, val);
    return m;
}

pub fn gmap_get_int(m: i64, key: str) -> i64 {
    return __engine("map_get", m, key) as i64;
}

pub fn gmap_contains(m: i64, key: str) -> bool {
    let v = __engine("map_get", m, key);
    return !v.is_null();
}

// ------------------------------------------------------------------------------
// String Utilities
// ------------------------------------------------------------------------------

pub pure fn mg_trim(s: str) -> str {
    let l = s.len();
    var start: usize = 0;
    while start < l && (s.byte_at(start) == 32 || s.byte_at(start) == 9 || s.byte_at(start) == 13 || s.byte_at(start) == 10) {
        start = start + 1;
    }
    var end: usize = l;
    while end > start && (s.byte_at(end - 1) == 32 || s.byte_at(end - 1) == 9 || s.byte_at(end - 1) == 13 || s.byte_at(end - 1) == 10) {
        end = end - 1;
    }
    return s.slice(start, end);
}

pub pure fn mg_starts_with(s: str, pfx: str) -> bool {
    let sl = s.len();
    let pl = pfx.len();
    if pl > sl { return false; }
    var i: usize = 0;
    while i < pl {
        if s.byte_at(i) != pfx.byte_at(i) { return false; }
        i = i + 1;
    }
    return true;
}

pub pure fn mg_ends_with(s: str, sfx: str) -> bool {
    let sl = s.len();
    let xl = sfx.len();
    if xl > sl { return false; }
    var i: usize = 0;
    while i < xl {
        if s.byte_at(sl - xl + i) != sfx.byte_at(i) { return false; }
        i = i + 1;
    }
    return true;
}

pub pure fn mg_find(haystack: str, needle: str, start: usize) -> i64 {
    let hl = haystack.len();
    let nl = needle.len();
    if nl == 0 { return start as i64; }
    if start + nl > hl { return -1; }
    var i: usize = start;
    while i + nl <= hl {
        var j: usize = 0;
        var m: bool = true;
        while j < nl {
            if haystack.byte_at(i + j) != needle.byte_at(j) {
                m = false;
                break;
            }
            j = j + 1;
        }
        if m { return i as i64; }
        i = i + 1;
    }
    return -1;
}

pub pure fn mg_to_lower(s: str) -> str {
    let l = s.len();
    var out = "";
    var i: usize = 0;
    while i < l {
        let b = s.byte_at(i);
        if b >= 65 && b <= 90 {
            let lower_char = (b + 32) as char;
            out = out + f"{lower_char}";
        } else {
            let ch = b as char;
            out = out + f"{ch}";
        }
        i = i + 1;
    }
    return out;
}

pub pure fn mg_replace_char(s: str, from_b: u8, to_b: u8) -> str {
    let l = s.len();
    var out = "";
    var i: usize = 0;
    while i < l {
        let b = s.byte_at(i);
        if b == from_b {
            let ch = to_b as char;
            out = out + f"{ch}";
        } else {
            let ch = b as char;
            out = out + f"{ch}";
        }
        i = i + 1;
    }
    return out;
}

// ------------------------------------------------------------------------------
// Declarative Package Search Table (Zero Rust Hardcoding)
// ------------------------------------------------------------------------------

pub fn mg_default_search_roots() -> i64 {
    let roots = glist_new();
    let _ = glist_push(roots, ".");
    let _ = glist_push(roots, "src");
    let _ = glist_push(roots, "stdlib");
    let _ = glist_push(roots, "stdlib/core");
    let _ = glist_push(roots, "selfhost");
    return roots;
}

pub fn mg_resolve_import_path(import_spec: str, roots: i64) -> str {
    var raw = mg_trim(import_spec);
    while raw.len() > 0 && (raw.byte_at(raw.len() - 1) == 59 || raw.byte_at(raw.len() - 1) == 42 || raw.byte_at(raw.len() - 1) == 46 || raw.byte_at(raw.len() - 1) == 32) {
        raw = raw.slice(0, raw.len() - 1);
    }
    let rel_slash = mg_replace_char(raw, 46, 47); // '.' -> '/'
    var sub = rel_slash;
    if mg_starts_with(sub, "Pilot/") {
        sub = sub.slice(6, sub.len());
    } else if mg_starts_with(sub, "pilot/") {
        sub = sub.slice(6, sub.len());
    }
    let lower_sub = mg_to_lower(sub);

    let count = glist_len(roots);
    var i: usize = 0;
    while i < count {
        let r = glist_get_str(roots, i);
        let c1 = f"{r}/{rel_slash}.pilot";
        if __engine("fs_exists", c1) == true { return c1; }
        let c2 = f"{r}/{sub}.pilot";
        if __engine("fs_exists", c2) == true { return c2; }
        let c3 = f"{r}/{lower_sub}.pilot";
        if __engine("fs_exists", c3) == true { return c3; }
        let c4 = f"{r}/{lower_sub}/{lower_sub}.pilot";
        if __engine("fs_exists", c4) == true { return c4; }
        i = i + 1;
    }

    let direct = f"{raw}.pilot";
    if __engine("fs_exists", direct) == true { return direct; }
    if __engine("fs_exists", raw) == true { return raw; }

    return "";
}

// ------------------------------------------------------------------------------
// Package & Import Header Extraction
// ------------------------------------------------------------------------------

pub fn mg_extract_package_info(src: str, out_imports: i64) -> ModuleNode {
    var pkg_name = "Main";
    var lvl: i32 = 0;
    let sl = src.len();
    var cur: usize = 0;

    while cur < sl {
        let nl = mg_find(src, "\n", cur);
        let line_end = if nl >= 0 { nl as usize } else { sl };
        let line = mg_trim(src.slice(cur, line_end));

        if mg_starts_with(line, "pub lvl(") {
            let end_lvl = mg_find(line, ")", 8);
            if end_lvl > 8 {
                let lvl_str = mg_trim(line.slice(8, end_lvl as usize));
                if lvl_str == "0" { lvl = 0; }
                else if lvl_str == "1" { lvl = 1; }
                else if lvl_str == "2" { lvl = 2; }
                else if lvl_str == "3" { lvl = 3; }
                else if lvl_str == "Cfg.Tokens.ring_genesis" { lvl = 0; }
            }
        }

        if mg_starts_with(line, "pkg ") || mg_find(line, " pkg ", 0) >= 0 {
            let p_idx = mg_find(line, "pkg ", 0);
            if p_idx >= 0 {
                let rest = mg_trim(line.slice((p_idx + 4) as usize, line.len()));
                var sc_idx = mg_find(rest, ";", 0);
                if sc_idx < 0 { sc_idx = rest.len() as i64; }
                pkg_name = mg_trim(rest.slice(0, sc_idx as usize));
            }
        } else if mg_starts_with(line, "use ") {
            let rest = mg_trim(line.slice(4, line.len()));
            var sc_idx = mg_find(rest, ";", 0);
            if sc_idx < 0 { sc_idx = rest.len() as i64; }
            let imp = mg_trim(rest.slice(0, sc_idx as usize));
            if imp.len() > 0 {
                let _ = glist_push(out_imports, imp);
            }
        }

        cur = if nl >= 0 { (nl + 1) as usize } else { sl };
    }

    return ModuleNode {
        id: FileUnitId { raw: 0 },
        pkg_name: pkg_name,
        file_path: "",
        content_hash: sl as u64,
        clearance_lvl: lvl,
    };
}

// ------------------------------------------------------------------------------
// Module Graph Construction & Transitive DAG Resolution
// ------------------------------------------------------------------------------

pub fn mg_build_graph(entry_file: str) -> ModuleGraph {
    let roots = mg_default_search_roots();
    let units = glist_new();
    let pkg_map = gmap_new();
    let path_map = gmap_new();
    let edges = gmap_new();
    let diags = glist_new();
    let queue = glist_new();

    let _ = glist_push(queue, entry_file);

    while glist_len(queue) > 0 {
        let cur_path = glist_pop(queue);
        if gmap_contains(path_map, cur_path) {
            continue;
        }

        let src = __engine("fs_read_text", cur_path);
        if src.len() == 0 && !__engine("fs_exists", cur_path) {
            let diag = ModuleDiagnostic {
                code: "MOD001",
                message: f"Unresolved module path: '{cur_path}'",
                file_path: cur_path,
                line: 1,
                column: 1,
            };
            let _ = glist_push(diags, diag);
            continue;
        }

        let unit_id = glist_len(units) as u32;
        let file_imports = glist_new();
        var node = mg_extract_package_info(src, file_imports);
        node.id = FileUnitId { raw: unit_id };
        node.file_path = cur_path;

        if gmap_contains(pkg_map, node.pkg_name) {
            let prev_id = gmap_get_int(pkg_map, node.pkg_name) as usize;
            let prev_node = glist_get(units, prev_id);
            if prev_node.clearance_lvl != node.clearance_lvl {
                let diag = ModuleDiagnostic {
                    code: "MOD004",
                    message: f"Conflicting clearance ring for package '{node.pkg_name}': lvl({node.clearance_lvl}) vs lvl({prev_node.clearance_lvl})",
                    file_path: cur_path,
                    line: 1,
                    column: 1,
                };
                let _ = glist_push(diags, diag);
            }
        } else {
            let _ = gmap_set_int(pkg_map, node.pkg_name, unit_id as i64);
        }

        let _ = glist_push(units, node);
        let _ = gmap_set_int(path_map, cur_path, unit_id as i64);

        let dep_list = glist_new();
        let imp_count = glist_len(file_imports);
        var j: usize = 0;
        while j < imp_count {
            let imp_str = glist_get_str(file_imports, j);
            let dep_path = mg_resolve_import_path(imp_str, roots);
            if dep_path.len() > 0 {
                let _ = glist_push(dep_list, dep_path);
                if !gmap_contains(path_map, dep_path) {
                    let _ = glist_push(queue, dep_path);
                }
            } else {
                let diag = ModuleDiagnostic {
                    code: "MOD001",
                    message: f"Unresolved import '{imp_str}' in {cur_path}",
                    file_path: cur_path,
                    line: 1,
                    column: 1,
                };
                let _ = glist_push(diags, diag);
            }
            j = j + 1;
        }
        let _ = gmap_set(edges, f"{unit_id}", dep_list);
    }

    let topo = glist_new();
    let num_units = glist_len(units);
    var u: usize = 0;
    while u < num_units {
        let _ = glist_push(topo, FileUnitId { raw: u as u32 });
        u = u + 1;
    }

    return ModuleGraph {
        units: units,
        pkg_to_unit: pkg_map,
        edges: edges,
        topo_order: topo,
        diagnostics: diags,
    };
}
