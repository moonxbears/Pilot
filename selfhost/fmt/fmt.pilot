// ============================================================================
// FILE: selfhost/fmt/fmt.pilot
// `pilot fmt`: lays tokens out as canonical Pilot (Milestone 53.3).
// ============================================================================
// The tokens come from the token tape (`pilot.lex`), lexed by the table built
// from the token declarations, so the formatter sees exactly the tokens the
// compiler does. The layout then:
//   - puts one statement on a line (`;`), opens a block after `{` and closes
//     it on its own line (`}` joins a following `else`/`catch`), and indents
//     blocks 4 spaces;
//   - spaces tokens by what they are (`fmt_needs_space`);
//   - breaks a `( .. )` group with a comma one item a line when it does not
//     fit in `max_width` columns.
// A comment that ends its line keeps a line of its own (or the end of the
// code line it follows); a literal with its own lexer modes (an f-string and
// its holes) is kept as written. The `readable` and `compact` styles rewrite
// paired surface forms (`f!^(x)` <-> `sig f(x)`, `T?` <-> `opt<T>`, ..) on the
// tokens first; they see single-token operands only (the CST rewrite of
// whole expressions is `cli.command_handler`'s M4 row).
pub pkg selfhost.fmt;

use std.text;
use pilot.fmt;
use Pilot.Core.Lex.Patterns;
use pilot.lex.build;
use pilot.lex.modes;
use pilot.lex;
use selfhost.lex;

/// What the layout needs to know of a token: a comment that ends its line,
/// a word (a name or keyword), or anything else.
pub enum FmtTokKind : u8 { Comment, Word, Other, }

/// One token as the layout reads it.
pub struct FmtTok : IValue {
    pub kind: FmtTokKind;
    pub text: str;
}

/// The width a line may reach before a `( .. )` group on it is broken.
pub const FMT_MAX_WIDTH: i64 = 100;

/// The narrowest width the layout accepts.
const FMT_MIN_WIDTH: i64 = 20;

/// The spaces a block is indented by.
const FMT_INDENT: i64 = 4;

/// The style named `name` (`pilot fmt --style`).
pub fn fmt_style_named(name: str) -> FmtStyle? {
    if name == "preserve" || name == "" { return FmtStyle::Preserve; }
    if name == "readable" { return FmtStyle::Readable; }
    if name == "compact" { return FmtStyle::Compact; }
    return none;
}

fn indent(depth: i64) -> str {
    var out = "";
    var i = 0;
    while i < depth * FMT_INDENT {
        out = out + " ";
        i = i + 1;
    }
    return out;
}

/// `s` without the spaces, tabs and carriage returns that end it.
fn trim_end(s: str) -> str {
    var end = s.len() as i64;
    while end > 0 {
        let b = s.byte_at(end - 1) as i64;
        if b != 32 && b != 9 && b != 13 { break; }
        end = end - 1;
    }
    return s.slice(0, end);
}

/// Whether byte `b` can be part of a name: a letter, `_`, or a byte of a
/// UTF-8 sequence (names may be any Unicode identifier).
fn word_byte(b: i64) -> bool => (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95 || b >= 128;

/// Whether `t` is a name or a keyword: word bytes and digits only, not
/// starting with a digit.
fn is_word(t: str) -> bool {
    if t.len() == 0 || !word_byte(t.byte_at(0) as i64) { return false; }
    var i = 1;
    while i < t.len() as i64 {
        let b = t.byte_at(i) as i64;
        if !word_byte(b) && !(b >= 48 && b <= 57) { return false; }
        i = i + 1;
    }
    return true;
}

fn action_of(ref m: ModalLexer, ref tape: TokenTape, i: i64) -> TokenAction {
    let fam = tape.family_index(i);
    return m.tables[m.mode_of[fam]].actions[m.decl_of(fam)];
}

/// The tokens of `src`, read from its tape, as the layout takes them:
///   - a token that enters a lexer mode starts a literal that runs until
///     the token that leaves the last mode entered (an f-string and its
///     holes): one token, its source as written;
///   - trivia (a comment, a `#` line, the shebang) that ends its line is a
///     `Comment`, without the spaces that end it; other trivia stays inline;
///   - a call-quote opener (`!`, `!!`, `!&`, `!^`, `!@`, `!?`, one token,
///     stdlib/core/lex/seed_forms.pilot) touching the token before it,
///     joined with the `(` after it (`!(`, `!!(`, ..), is one token.
pub fn fmt_tokens(ref m: ModalLexer, ref tape: TokenTape, src: str) -> List<FmtTok> {
    var out: List<FmtTok> = [];
    let n = tape.len();
    var i = 0;
    while i < n {
        let act = action_of(m, tape, i);
        if act.enters != "" {
            var depth = 0;
            var j = i;
            while j < n {
                let a = action_of(m, tape, j);
                if a.enters != "" { depth = depth + 1; }
                if a.leaves { depth = depth - 1; }
                if depth <= 0 { break; }
                j = j + 1;
            }
            if j >= n { j = n - 1; }
            out.push(FmtTok { kind: FmtTokKind::Other, text: src.slice(tape.start(i), tape.end(m, src, j)) });
            i = j + 1;
            continue;
        }
        let text = tape.text(m, src, i);
        if act.role == TokenRole::Trivia {
            let ends_line = i + 1 >= n || tape.newline_before(m, src, i + 1);
            if ends_line {
                out.push(FmtTok { kind: FmtTokKind::Comment, text: trim_end(text) });
            } else {
                out.push(FmtTok { kind: FmtTokKind::Other, text: text });
            }
            i = i + 1;
            continue;
        }
        if text.starts_with("!") && i > 0 && tape.touches_next(m, src, i - 1) {
            var joined = text;
            var j = i;
            var found = -1;
            while found < 0 && j + 1 < n && j < i + 2 && tape.touches_next(m, src, j) {
                joined = joined + tape.text(m, src, j + 1);
                j = j + 1;
                if is_open_group_tok(joined) { found = j; }
            }
            if found >= 0 {
                out.push(FmtTok { kind: FmtTokKind::Other, text: joined });
                i = found + 1;
                continue;
            }
        }
        out.push(FmtTok { kind: if is_word(text) { FmtTokKind::Word } else { FmtTokKind::Other }, text: text });
        i = i + 1;
    }
    return out;
}

pub fn is_kw_spaced_before_lparen(w: str) -> bool {
    return w == nameof(if)
        || w == nameof(while)
        || w == nameof(until)
        || w == nameof(for)
        || w == nameof(switch)
        || w == nameof(return)
        || w == nameof(yield)
        || w == nameof(catch)
        || w == nameof(guard);
}

pub pure fn is_open_group_tok(t: str) -> bool {
    return t == "(" || t == "!(" || t == "!!(" || t == "!&(" || t == "!^(" || t == "!@(" || t == "!?(";
}

pub fn is_generic_lead_prev(prev2: str, prev: str) -> bool {
    if prev2 == ":" || prev2 == "->" || prev2 == "as" || prev2 == nameof(fn)
        || prev2 == nameof(struct) || prev2 == nameof(interface) || prev2 == nameof(let)
        || prev2 == nameof(var) || prev2 == "bundle" || prev2 == "facet" || prev2 == "ext" {
        return true;
    }
    return prev == nameof(opt) || prev == nameof(res) || prev == "sig" || prev == "grad" || prev == "plan"
        || prev == "array" || prev == "simd" || prev == "ptr" || prev == "ref" || prev == "iso"
        || prev == "span" || prev == "step" || prev == "from" || prev == "until" || prev == "map"
        || prev == "frame" || prev == "List" || prev == "Map";
}

pub pure fn is_binary_or_assign_op(t: str) -> bool {
    return t == "->" || t == "=>" || t == "=" || t == "==" || t == "!="
        || t == "<=" || t == ">=" || t == "&&"
        || t == "||" || t == "+" || t == "*" || t == "/" || t == "%"
        || t == "&" || t == "|" || t == "^" || t == "<<" || t == ">>"
        || t == "??" || t == "+=" || t == "-=" || t == "*=" || t == "/="
        || t == "<=>" || t == ":=:" || t == "~>";
}

pub fn can_precede_unary_minus(prev: str) -> bool {
    if prev.len() == 0 {
        return true;
    }
    return is_open_group_tok(prev) || prev == "[" || prev == "{" || prev == "," || prev == ";"
        || prev == ":" || prev == "!" || is_binary_or_assign_op(prev) || prev == "-"
        || prev == nameof(return) || prev == nameof(yield);
}

/// Whether a space goes between `prev` (after `prev2`) and `cur`.
pub fn fmt_needs_space(prev2: str, prev: str, cur: str) -> bool {
    if prev.len() == 0 || cur.len() == 0 {
        return false;
    }
    if cur == "," || cur == ";" || cur == ")" || cur == "]" || cur == "." || cur == "?." || cur == "::" || cur == ":" || cur == "?" {
        return false;
    }
    if is_open_group_tok(prev) || prev == "[" || prev == "." || prev == "?." || prev == "::" {
        return false;
    }
    // `!` after an operand is the error type's (`T ! E`); otherwise it is
    // `not` and touches what it negates.
    if prev == "!" {
        return is_word(prev2) && !is_kw_spaced_before_lparen(prev2);
    }
    if (prev == "-" || prev == "*" || prev == "**" || prev == "*..") && can_precede_unary_minus(prev2) {
        return false;
    }
    if cur == "{" {
        return true;
    }
    if cur == "<" && is_generic_lead_prev(prev2, prev) {
        return false;
    }
    if prev == "<" && (is_generic_lead_prev("", prev2) || prev2.len() == 0 || cur == ">") {
        return false;
    }
    if cur == ">" && (prev2 == "<" || prev2 == "," || prev == ">") {
        return false;
    }
    if is_open_group_tok(cur) || cur == "[" {
        return is_kw_spaced_before_lparen(prev) || prev == ":" || prev == "," || prev == ";" || is_binary_or_assign_op(prev) || prev == "-";
    }
    return true;
}

/// Tokens `[from, to)` on one line.
fn render_flat(ref toks: List<FmtTok>, from: i64, to: i64) -> str {
    var out = string_builder_new();
    var prev2 = "";
    var prev = "";
    var i = from;
    while i < to {
        let t = toks[i].text;
        if fmt_needs_space(prev2, prev, t) { out.append(" "); }
        out.append(t);
        prev2 = prev;
        prev = t;
        i = i + 1;
    }
    return out.to_string();
}

/// The `)` closing the group opened at `open`: `-1` when the group holds a
/// `{`, `}`, `;` or a comment, or is never closed.
fn find_clean_rparen(ref toks: List<FmtTok>, open: i64) -> i64 {
    var depth = 1;
    var i = open + 1;
    while i < toks.len() as i64 {
        let t = toks[i].text;
        if toks[i].kind == FmtTokKind::Comment || t == "{" || t == "}" || t == ";" { return -1; }
        if is_open_group_tok(t) {
            depth = depth + 1;
        } else if t == ")" {
            depth = depth - 1;
            if depth == 0 { return i; }
        }
        i = i + 1;
    }
    return -1;
}

/// Whether the group `[open, close]` has a comma outside its inner groups.
fn has_top_comma(ref toks: List<FmtTok>, open: i64, close: i64) -> bool {
    var depth = 0;
    var i = open + 1;
    while i < close {
        let t = toks[i].text;
        if is_open_group_tok(t) || t == "[" {
            depth = depth + 1;
        } else if (t == ")" || t == "]") && depth > 0 {
            depth = depth - 1;
        } else if t == "," && depth == 0 {
            return true;
        }
        i = i + 1;
    }
    return false;
}

/// The columns the rest of the statement takes after the `)` at `close`, up
/// to and with a `{` or `;`.
fn tail_width(ref toks: List<FmtTok>, close: i64) -> i64 {
    var end = close + 1;
    while end < toks.len() as i64 {
        let t = toks[end].text;
        if toks[end].kind == FmtTokKind::Comment || t == "}" || is_open_group_tok(t) { break; }
        end = end + 1;
        if t == "{" || t == ";" { break; }
    }
    if end <= close + 1 { return 0; }
    let sample = render_flat(toks, close, end);
    return if sample.len() > 1 { sample.len() as i64 - 1 } else { 0 };
}

/// The group `[open, close]` broken one item a line, one level deeper than
/// `depth`, its `)` back at `depth`.
fn render_broken(ref toks: List<FmtTok>, open: i64, close: i64, depth: i64) -> str {
    let inner = indent(depth + 1);
    var out = string_builder_new();
    out.append(toks[open].text + "\n");
    var item = open + 1;
    var nest = 0;
    var i = open + 1;
    while i <= close {
        var split = i == close;
        if !split {
            let t = toks[i].text;
            if is_open_group_tok(t) || t == "[" {
                nest = nest + 1;
            } else if (t == ")" || t == "]") && nest > 0 {
                nest = nest - 1;
            } else if t == "," && nest == 0 {
                split = true;
            }
        }
        if split {
            let text = render_flat(toks, item, i);
            if text.len() > 0 {
                out.append(inner + text + (if i < close { ",\n" } else { "\n" }));
            }
            item = i + 1;
        }
        i = i + 1;
    }
    out.append(indent(depth) + ")");
    return out.to_string();
}

fn word(text: str) -> FmtTok => FmtTok { kind: FmtTokKind::Word, text: text };
fn punct(text: str) -> FmtTok => FmtTok { kind: FmtTokKind::Other, text: text };

fn text_at(ref toks: List<FmtTok>, i: i64) -> str => if i >= 0 && i < toks.len() as i64 { toks[i].text } else { "" };
fn word_at(ref toks: List<FmtTok>, i: i64) -> bool => i >= 0 && i < toks.len() as i64 && toks[i].kind == FmtTokKind::Word;

/// The readable call-quote keyword of each compact opener, in pairs.
const CALL_QUOTES: List<str> = ["!(", "call", "!!(", "splice", "!&(", "frame", "!^(", "sig", "!@(", "grad", "!?(", "plan",];

/// The readable unpack call of each compact sigil, in pairs.
const UNPACKS: List<str> = ["*..", "flat", "**", "pairs", "*", "splat",];

/// The other half of `t`'s pair in `pairs` (`from` 0: `t` is a compact
/// form; 1: a readable one), or "".
fn paired(ref pairs: List<str>, t: str, from: i64) -> str {
    var i = 0;
    while i + 1 < pairs.len() as i64 {
        if pairs[i + from] == t { return pairs[i + 1 - from]; }
        i = i + 2;
    }
    return "";
}

/// Whether token `i` is in a type position: after `:`, `->`, `<` or `,`.
fn type_position(ref toks: List<FmtTok>, i: i64) -> bool {
    let p = text_at(toks, i - 1);
    return p == ":" || p == "->" || p == "<" || p == ",";
}

/// `toks` rewritten into `style`.
pub fn fmt_restyle(ref toks: List<FmtTok>, style: FmtStyle) -> List<FmtTok> {
    if style == FmtStyle::Preserve { return toks; }
    let total = toks.len() as i64;
    var out: List<FmtTok> = [];
    var i = 0;
    while i < total {
        let t = toks[i].text;
        if style == FmtStyle::Readable {
            // f!^(x) -> sig f(x), ..
            let kw = paired(CALL_QUOTES, text_at(toks, i + 1), 0);
            if word_at(toks, i) && kw != "" {
                out.push(word(kw));
                out.push(toks[i]);
                out.push(punct("("));
                i = i + 2;
                continue;
            }
            // *..x -> flat(x), **x -> pairs(x), *x -> splat(x)
            let unpack = paired(UNPACKS, t, 0);
            if unpack != "" && (i == 0 || can_precede_unary_minus(text_at(toks, i - 1))) && word_at(toks, i + 1) {
                out.push(word(unpack));
                out.push(punct("("));
                out.push(toks[i + 1]);
                out.push(punct(")"));
                i = i + 2;
                continue;
            }
            // T? -> opt<T>
            if word_at(toks, i) && text_at(toks, i + 1) == "?" && type_position(toks, i) {
                out.push(word(nameof(opt)));
                out.push(punct("<"));
                out.push(toks[i]);
                out.push(punct(">"));
                i = i + 2;
                continue;
            }
            // T ! E -> res<T, E>
            if word_at(toks, i) && text_at(toks, i + 1) == "!" && word_at(toks, i + 2) && type_position(toks, i) {
                out.push(word(nameof(res)));
                out.push(punct("<"));
                out.push(toks[i]);
                out.push(punct(","));
                out.push(toks[i + 2]);
                out.push(punct(">"));
                i = i + 3;
                continue;
            }
        } else {
            // sig f(x) -> f!^(x), ..
            let opener = paired(CALL_QUOTES, t, 1);
            if word_at(toks, i) && opener != "" && word_at(toks, i + 1) && text_at(toks, i + 2) == "(" {
                out.push(toks[i + 1]);
                out.push(punct(opener));
                i = i + 3;
                continue;
            }
            // splat(x) -> *x, pairs(x) -> **x, flat(x) -> *..x
            let sigil = paired(UNPACKS, t, 1);
            if word_at(toks, i) && sigil != "" && text_at(toks, i + 1) == "(" && word_at(toks, i + 2) && text_at(toks, i + 3) == ")" {
                out.push(punct(sigil));
                out.push(toks[i + 2]);
                i = i + 4;
                continue;
            }
            // opt<T> -> T?
            if t == nameof(opt) && text_at(toks, i + 1) == "<" && word_at(toks, i + 2) && text_at(toks, i + 3) == ">" {
                out.push(toks[i + 2]);
                out.push(punct("?"));
                i = i + 4;
                continue;
            }
            // res<T, E> -> T ! E
            if t == nameof(res) && text_at(toks, i + 1) == "<" && word_at(toks, i + 2) && text_at(toks, i + 3) == ","
                && word_at(toks, i + 4) && text_at(toks, i + 5) == ">" {
                out.push(toks[i + 2]);
                out.push(punct("!"));
                out.push(toks[i + 4]);
                i = i + 6;
                continue;
            }
        }
        out.push(toks[i]);
        i = i + 1;
    }
    return out;
}

/// The lines being laid out: the finished text and the line in progress.
struct Layout : IObject {
    done: StringBuilder;
    line: str;
    depth: i64;
    prev2: str;
    prev: str;

    /// Ends the line in progress (if any) with `tail` and a newline.
    fn flush(var ref self, tail: str) {
        if self.line.len() > 0 {
            self.done.append(self.line + tail + "\n");
            self.line = "";
        }
        self.prev2 = "";
        self.prev = "";
    }

    /// Adds `t` to the line in progress, spaced after what came before.
    fn add(var ref self, t: str) {
        if self.line.len() == 0 {
            self.line = indent(self.depth) + t;
        } else {
            if fmt_needs_space(self.prev2, self.prev, t) { self.line = self.line + " "; }
            self.line = self.line + t;
        }
        self.prev2 = self.prev;
        self.prev = t;
    }
}

/// `toks` laid out in lines `max_width` columns wide, blocks indented.
pub fn fmt_layout(ref toks: List<FmtTok>, max_width: i64) -> str {
    let width = if max_width < FMT_MIN_WIDTH { FMT_MIN_WIDTH } else { max_width };
    let total = toks.len() as i64;
    var l = Layout { done: string_builder_new(), line: "", depth: 0, prev2: "", prev: "" };
    var parens = 0;
    var i = 0;
    while i < total {
        let t = toks[i].text;
        if toks[i].kind == FmtTokKind::Comment {
            if l.line.len() > 0 {
                l.flush(" " + t);
            } else {
                l.done.append(indent(l.depth) + t + "\n");
                l.flush("");
            }
            i = i + 1;
        } else if t == "{" && parens == 0 {
            if text_at(toks, i + 1) == "}" {
                l.add("{}");
                i = i + 2;
                if text_at(toks, i) == ";" {
                    l.line = l.line + ";";
                    i = i + 1;
                }
                l.flush("");
            } else {
                if l.line.len() == 0 { l.line = indent(l.depth) + "{"; } else { l.line = l.line + " {"; }
                l.flush("");
                l.depth = l.depth + 1;
                i = i + 1;
            }
        } else if t == "}" && parens == 0 {
            l.flush("");
            if l.depth > 0 { l.depth = l.depth - 1; }
            let next = text_at(toks, i + 1);
            if next == nameof(else) || next == nameof(catch) {
                l.line = indent(l.depth) + "}";
                l.prev = "}";
                i = i + 1;
            } else if next == ";" || next == "," {
                l.done.append(indent(l.depth) + "}" + next + "\n");
                i = i + 2;
            } else {
                l.done.append(indent(l.depth) + "}\n");
                i = i + 1;
            }
        } else if t == ";" && parens == 0 {
            if l.line.len() == 0 { l.line = indent(l.depth); }
            l.flush(";");
            i = i + 1;
        } else if is_open_group_tok(t) && parens == 0 {
            let close = find_clean_rparen(toks, i);
            if close > i && has_top_comma(toks, i, close) {
                if l.line.len() == 0 {
                    l.line = indent(l.depth);
                } else if fmt_needs_space(l.prev2, l.prev, t) {
                    l.line = l.line + " ";
                }
                let flat = render_flat(toks, i, close + 1);
                if l.line.len() + flat.len() + tail_width(toks, close) <= width {
                    l.line = l.line + flat;
                } else {
                    // The broken group's last line, its `)`, carries on.
                    let broken = render_broken(toks, i, close, l.depth);
                    var last_nl = broken.len() as i64 - 1;
                    while last_nl >= 0 && broken.byte_at(last_nl) as i64 != 10 { last_nl = last_nl - 1; }
                    l.done.append(l.line + broken.slice(0, last_nl + 1));
                    l.line = broken.slice(last_nl + 1, broken.len());
                }
                l.prev2 = "(";
                l.prev = ")";
                i = close + 1;
            } else {
                l.add(t);
                parens = parens + 1;
                i = i + 1;
            }
        } else {
            if is_open_group_tok(t) {
                parens = parens + 1;
            } else if t == ")" && parens > 0 {
                parens = parens - 1;
            }
            l.add(t);
            i = i + 1;
        }
    }
    l.flush("");
    return l.done.to_string();
}

/// `pilot fmt <file>`: the file formatted, printed; with `check`, exit 1
/// (naming the file) when formatting would change it; with `write`, the
/// file rewritten in place.
pub fn fmt_main(path: str, style_name: str, check: bool, write: bool) -> i64 {
    guard some style = fmt_style_named(style_name) else {
        eprint(f"error: no formatting style `{style_name}`");
        return 2;
    };
    let built = program_lexer();
    if !built.ok() { return 1; }
    let src = File.read_text(path);
    let tb = build_tape(built.lexer, src);
    if !tb.ok() {
        for e in tb.errors { eprint(f"{e.code}: {e.message} of {path}"); }
        return 1;
    }
    let formatted = fmt_layout(fmt_restyle(fmt_tokens(built.lexer, tb.tape, src), style), FMT_MAX_WIDTH);
    if check {
        if formatted == src { return 0; }
        print(f"{path} is not formatted");
        return 1;
    }
    if write {
        if formatted != src && !File.write_text(path, formatted) {
            eprint(f"error: could not write `{path}`");
            return 1;
        }
        return 0;
    }
    if formatted.len() > 0 { print(formatted.slice(0, formatted.len() - 1)); }
    return 0;
}
