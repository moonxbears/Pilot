// ==============================================================================
// selfhost/adapter/absorb_proto.pilot
// Ring 3 / Self-Host Compiler: Protocol Buffers v2/v3 Absorber & Wire Codec (`use proto`)
// Package: Pilot.SelfHost.Adapter.AbsorbProto (Milestone 20)
// ==============================================================================

pub lvl(0) pkg Pilot.SelfHost.Adapter.AbsorbProto;

use Pilot.SelfHost.Adapter.AbsorbSql;
use std.text;

// ------------------------------------------------------------------------------
// 1. Protobuf Wire Types & Tag Packing
// ------------------------------------------------------------------------------

pub enum ProtoWireType : u8 {
    Varint = 0,
    Fixed64 = 1,
    LengthDelimited = 2,
    Fixed32 = 5,
}

pub pure fn proto_make_tag(field_number: i64, wire_type: i64) -> i64 {
    return (field_number << 3) | (wire_type & 7);
}

pub pure fn proto_tag_field_number(tag: i64) -> i64 {
    return tag >> 3;
}

pub pure fn proto_tag_wire_type(tag: i64) -> i64 {
    return tag & 7;
}

// ------------------------------------------------------------------------------
// 2. ZigZag 64-Bit Arithmetic & Varint Coding
// ------------------------------------------------------------------------------

pub pure fn proto_zigzag_encode64(n: i64) -> i64 {
    // (n << 1) ^ (n >> 63)
    let sign_shift = if n < 0 { -1 } else { 0 };
    return (n << 1) ^ sign_shift;
}

pub pure fn proto_zigzag_decode64(n: i64) -> i64 {
    // (n >> 1) ^ -(n & 1)
    let low_bit = n & 1;
    let sign_mask = if low_bit != 0 { -1 } else { 0 };
    return (n >> 1) ^ sign_mask;
}

/// Base-128 varint of `val` read as an unsigned 64-bit value, so a negative
/// `int64` takes the full ten bytes, as protobuf encodes it.
pub fn proto_encode_varint(val: i64) -> List<i64> {
    var out: List<i64> = [];
    var v = val;
    var more = true;
    while more {
        var byte = v & 127;
        // Logical shift right by 7: clear the 7 sign bits an arithmetic shift
        // copies in (0x01FFFFFFFFFFFFFF keeps the low 57 bits).
        v = (v >> 7) & 144115188075855871;
        if v != 0 {
            byte = byte | 128;
            out.push(byte);
        } else {
            out.push(byte);
            more = false;
        }
    }
    return out;
}

pub struct ProtoVarintResult : IValue {
    pub value:       i64,
    pub bytes_read:  i64,
    pub is_valid:    bool,
    pub err_message: str,
}

pub fn proto_decode_varint(bytes: List<i64>, offset: i64) -> ProtoVarintResult {
    var result: i64 = 0;
    var shift: i64 = 0;
    var count: i64 = 0;
    var idx = offset;
    let end_idx = bytes.len() as i64;

    while idx < end_idx {
        if count >= 10 { break; }
        let b = bytes.get(idx);
        idx = idx + 1;
        count = count + 1;
        result = result | ((b & 127) << shift);
        if (b & 128) == 0 {
            return ProtoVarintResult {
                value:       result,
                bytes_read:  count,
                is_valid:    true,
                err_message: "",
            };
        }
        shift = shift + 7;
    }

    return ProtoVarintResult {
        value:       0,
        bytes_read:  count,
        is_valid:    false,
        err_message: "SCH005: Truncated wire varint at offset " + ("" + offset),
    };
}

/// Where one field sits in an encoded message.
pub struct ProtoFieldSpan : IValue {
    pub found:       bool,
    pub wire_type:   i64,
    /// The decoded value of a varint, 64-bit or 32-bit field.
    pub value:       i64,
    /// For a length-delimited field, where its payload starts and how long it is.
    pub offset:      i64,
    pub len:         i64,
    pub err_message: str,
}

fn proto_span_err(msg: str) -> ProtoFieldSpan {
    return ProtoFieldSpan { found: false, wire_type: 0, value: 0, offset: 0, len: 0, err_message: msg };
}

/// Little-endian fixed-width integer of `width` bytes at `at`.
fn proto_read_fixed(bytes: List<i64>, at: i64, width: i64) -> i64 {
    var v: i64 = 0;
    var k = width - 1;
    while k >= 0 {
        v = (v << 8) | (bytes.get(at + k) & 255);
        k = k - 1;
    }
    return v;
}

/// Finds field `field_number` in the encoded message `bytes`. Every record is
/// walked so a malformed packet is caught; for a field that appears more than
/// once the last occurrence wins, as the protobuf spec says for scalars.
pub fn proto_wire_find_field(bytes: List<i64>, field_number: i64) -> ProtoFieldSpan {
    var hit = proto_span_err("");
    let n = bytes.len() as i64;
    var pos: i64 = 0;
    while pos < n {
        let tag = proto_decode_varint(bytes, pos);
        if !tag.is_valid { return proto_span_err(tag.err_message); }
        pos = pos + tag.bytes_read;
        let wt = proto_tag_wire_type(tag.value);
        let fnum = proto_tag_field_number(tag.value);
        var value: i64 = 0;
        var start: i64 = pos;
        var len: i64 = 0;
        if wt == 0 {
            let v = proto_decode_varint(bytes, pos);
            if !v.is_valid { return proto_span_err(v.err_message); }
            value = v.value;
            pos = pos + v.bytes_read;
        } else if wt == 1 || wt == 5 {
            let width: i64 = if wt == 1 { 8 } else { 4 };
            if pos + width > n {
                return proto_span_err("SCH005: Truncated fixed-width field at offset " + ("" + pos));
            }
            value = proto_read_fixed(bytes, pos, width);
            pos = pos + width;
        } else if wt == 2 {
            let l = proto_decode_varint(bytes, pos);
            if !l.is_valid { return proto_span_err(l.err_message); }
            start = pos + l.bytes_read;
            len = l.value;
            if len < 0 || start + len > n {
                return proto_span_err("SCH005: Length-delimited field runs past the packet at offset " + ("" + pos));
            }
            pos = start + len;
        } else {
            return proto_span_err("SCH005: Unsupported wire type " + ("" + wt) + " at offset " + ("" + pos));
        }
        if fnum == field_number {
            hit = ProtoFieldSpan { found: true, wire_type: wt, value: value, offset: start, len: len, err_message: "" };
        }
    }
    return hit;
}

// ------------------------------------------------------------------------------
// 3. Protobuf AST
// ------------------------------------------------------------------------------

pub struct ProtoFieldDef : IValue {
    pub name:         str,
    pub field_number: i64,
    pub field_type:   str,
    pub is_repeated:  bool,
    pub is_packed:    bool,
    pub oneof_group:  str,
}

pub struct ProtoMessageDef : IObject {
    pub name:             str,
    pub fields:           List<ProtoFieldDef>,
    pub reserved_numbers: List<i64>,
    ~self() {}
}

pub fn proto_message_new(name: str) -> ProtoMessageDef {
    return ProtoMessageDef {
        name:             name,
        fields:           [],
        reserved_numbers: [],
    };
}

pub fn proto_message_find_field(msg: ProtoMessageDef, name: str) -> i64 {
    var i = 0;
    while i < msg.fields.len() {
        let f = msg.fields.get(i);
        if f.name == name {
            return i as i64;
        }
        i = i + 1;
    }
    return -1;
}

pub struct ProtoDoc : IObject {
    pub syntax:       str,
    pub package_name: str,
    pub messages:     List<ProtoMessageDef>,
    pub services:     List<str>,
    ~self() {}
}

pub fn proto_doc_new(syntax: str) -> ProtoDoc {
    return ProtoDoc {
        syntax:       syntax,
        package_name: "",
        messages:     [],
        services:     [],
    };
}

// ------------------------------------------------------------------------------
// 4. Protobuf `.proto` Parser & Reserved Tag Check (SCH003)
// ------------------------------------------------------------------------------

pub fn proto_parse_source(src: str) -> ProtoDoc {
    var doc = proto_doc_new("proto3");
    let n = src.len();
    var pos = 0;

    // Check syntax
    let syn_idx = src.find("syntax");
    if syn_idx >= 0 {
        if src.contains("\"proto2\"") {
            doc.syntax = "proto2";
        }
    }

    // Check package
    let pkg_idx = src.find("package");
    if pkg_idx >= 0 {
        var p_st = (pkg_idx + 7) as usize;
        while p_st < n && sql_is_space(src.byte_at(p_st)) { p_st = p_st + 1; }
        var p_en = p_st;
        while p_en < n && src.byte_at(p_en) != 59 { p_en = p_en + 1; }
        doc.package_name = sql_trim(src.slice(p_st, p_en));
    }

    // Parse messages
    while pos < n {
        let m_idx = src.find("message", pos);
        if m_idx < 0 { break; }
        var m_st = (m_idx + 7) as usize;
        while m_st < n && sql_is_space(src.byte_at(m_st)) { m_st = m_st + 1; }
        var m_en = m_st;
        while m_en < n && sql_is_alnum(src.byte_at(m_en)) { m_en = m_en + 1; }
        let msg_name = src.slice(m_st, m_en);
        pos = m_en;

        while pos < n && src.byte_at(pos) != 123 { pos = pos + 1; } // '{'
        pos = pos + 1;

        var msg = proto_message_new(msg_name);

        while pos < n && src.byte_at(pos) != 125 { // '}'
            while pos < n && sql_is_space(src.byte_at(pos)) { pos = pos + 1; }
            if pos >= n || src.byte_at(pos) == 125 { break; }

            var f_end = pos;
            while f_end < n && src.byte_at(f_end) != 59 { f_end = f_end + 1; }
            let line = sql_trim(src.slice(pos, f_end));
            pos = f_end + 1;

            if line.len() == 0 { continue; }

            // Check field line: e.g. "repeated int32 values = 1 [packed=true];"
            let eq_idx = line.find("=");
            if eq_idx > 0 {
                let lhs = sql_trim(line.slice(0, eq_idx as usize));
                let rhs = sql_trim(line.slice((eq_idx + 1) as usize, line.len()));

                let is_repeated = lhs.starts_with("repeated");
                var clean_lhs = lhs;
                if is_repeated {
                    clean_lhs = sql_trim(lhs.slice(8, lhs.len()));
                }

                // lhs has TYPE NAME
                let sp_idx = clean_lhs.find(" ");
                var f_type = "int32";
                var f_name = clean_lhs;
                if sp_idx > 0 {
                    f_type = clean_lhs.slice(0, sp_idx as usize);
                    f_name = sql_trim(clean_lhs.slice((sp_idx + 1) as usize, clean_lhs.len()));
                }

                // rhs has NUMBER [OPT]
                var num_end = 0;
                let rn = rhs.len();
                var f_num: i64 = 0;
                while num_end < rn && rhs.byte_at(num_end) >= 48 && rhs.byte_at(num_end) <= 57 {
                    f_num = f_num * 10 + (rhs.byte_at(num_end) - 48);
                    num_end = num_end + 1;
                }

                let is_packed = rhs.contains("packed=true");

                msg.fields.push(ProtoFieldDef {
                    name:         f_name,
                    field_number: f_num,
                    field_type:   f_type,
                    is_repeated:  is_repeated,
                    is_packed:    is_packed,
                    oneof_group:  "",
                });
            }
        }
        if pos < n && src.byte_at(pos) == 125 { pos = pos + 1; }

        doc.messages.push(msg);
    }

    return doc;
}

pub struct ProtoValidationResult : IValue {
    pub is_ok:       bool,
    pub err_message: str,
}

pub fn proto_validate_reserved_tags(msg: ProtoMessageDef) -> ProtoValidationResult {
    var i = 0;
    while i < msg.fields.len() {
        let f = msg.fields.get(i);
        // Reserved field numbers: 19000 to 19999
        if f.field_number >= 19000 && f.field_number <= 19999 {
            return ProtoValidationResult {
                is_ok:       false,
                err_message: "SCH003: Field '" + f.name + "' uses reserved field number " + ("" + f.field_number),
            };
        }
        i = i + 1;
    }
    return ProtoValidationResult {
        is_ok:       true,
        err_message: "",
    };
}

// ------------------------------------------------------------------------------
// 5. Synthesis of Dual Owned 0b10 Builder & Zero-Copy 0b01 Wire View
// ------------------------------------------------------------------------------

/// Whether `type_name` (possibly package-qualified) names a message in `doc`.
fn proto_doc_has_message(doc: ProtoDoc, type_name: str) -> bool {
    var short = type_name;
    var i = type_name.len();
    while i > 0 {
        i = i - 1;
        if type_name.byte_at(i) == 46 { // '.'
            short = type_name.slice(i + 1, type_name.len());
            break;
        }
    }
    for m in doc.messages {
        if m.name == short { return true; }
    }
    return false;
}

/// The wire type a declared field is encoded with (protobuf encoding guide):
/// fixed64/sfixed64/double use 1, fixed32/sfixed32/float use 5, strings,
/// bytes and messages are length-delimited (2), and every other scalar and
/// every enum is a varint (0).
pub fn proto_field_wire_type(doc: ProtoDoc, f: ProtoFieldDef) -> i64 {
    let t = f.field_type;
    if t == "fixed64" || t == "sfixed64" || t == "double" { return 1; }
    if t == "fixed32" || t == "sfixed32" || t == "float" { return 5; }
    if t == "string" || t == "bytes" { return 2; }
    if proto_doc_has_message(doc, t) { return 2; }
    return 0;
}

[StandIn("proto.packet_bytes", "borrowed slice<u8> wire view (0b01)", "generated views hold an owned List<i64>, one byte per element", "F7")]
pub fn proto_synthesize_dual_views(doc: ProtoDoc, msg: ProtoMessageDef) -> str {
    var out: List<str> = ["// ------------------------------------------------------------------\n"];
    out.push("// 0b10 Owned Mutable Builder\n");
    out.push("pub struct " + msg.name + " : IObject {\n");
    var i = 0;
    while i < msg.fields.len() {
        let f = msg.fields.get(i);
        out.push("    pub " + f.name + ": " + f.field_type + ";\n");
        i = i + 1;
    }
    out.push("    ~self() {}\n");
    out.push("}\n\n");

    out.push("// 0b01 Zero-Copy Borrowed Wire View\n");
    out.push("pub struct " + msg.name + "View : IReference {\n");
    out.push("    pub packet: List<i64>;\n");
    var j = 0;
    while j < msg.fields.len() {
        let f = msg.fields.get(j);
        let find = "proto_wire_find_field(self.packet, " + ("" + f.field_number) + ")";
        let wire = proto_field_wire_type(doc, f);
        if f.is_repeated || wire == 2 {
            // Repeated, packed and length-delimited fields hand back the span.
            out.push("    pub fn " + f.name + "_span(ref self) -> ProtoFieldSpan => " + find + ";\n");
        } else if f.field_type.starts_with("sint") {
            out.push("    pub fn get_" + f.name + "(ref self) -> " + f.field_type + " => proto_zigzag_decode64(" + find + ".value);\n");
        } else {
            out.push("    pub fn get_" + f.name + "(ref self) -> " + f.field_type + " => " + find + ".value;\n");
        }
        j = j + 1;
    }
    out.push("}\n");

    return text.join_text(out, "");
}
