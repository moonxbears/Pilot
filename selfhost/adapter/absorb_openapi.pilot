// ==============================================================================
// selfhost/adapter/absorb_openapi.pilot
// Ring 3 / Self-Host Compiler: OpenAPI 3.0/3.1 Schema & Route Absorber (`use openapi`)
// Package: Pilot.SelfHost.Adapter.AbsorbOpenApi (Milestone 20)
// ==============================================================================

pub lvl(0) pkg Pilot.SelfHost.Adapter.AbsorbOpenApi;

use std.text;

// ------------------------------------------------------------------------------
// 1. OpenAPI Property & Schema AST
// ------------------------------------------------------------------------------

pub struct OpenApiProperty : IValue {
    pub name:        str,
    pub prop_type:   str,
    pub is_required: bool,
    pub ref_target:  str,
}

pub struct OpenApiSchema : IObject {
    pub name:         str,
    pub schema_type:  str, // "object", "array", "union", "primitive"
    pub properties:   List<OpenApiProperty>,
    pub all_of:       List<str>, // Names of spliced bundles
    pub one_of:       List<str>, // Tagged union variants
    pub is_recursive: bool,
    ~self() {}
}

pub fn openapi_schema_new(name: str, stype: str) -> OpenApiSchema {
    return OpenApiSchema {
        name:         name,
        schema_type:  stype,
        properties:   [],
        all_of:       [],
        one_of:       [],
        is_recursive: false,
    };
}

pub fn openapi_schema_find_prop(s: OpenApiSchema, prop_name: str) -> i64 {
    var i = 0;
    while i < s.properties.len() {
        let p = s.properties.get(i);
        if p.name == prop_name {
            return i as i64;
        }
        i = i + 1;
    }
    return -1;
}

// ------------------------------------------------------------------------------
// 2. OpenAPI Operations & Client Route AST
// ------------------------------------------------------------------------------

pub struct OpenApiOperation : IValue {
    pub path:            str,
    pub http_method:     str, // "GET", "POST", "PUT", "DELETE"
    pub operation_id:    str,
    pub path_params:     List<str>,
    /// The `format` (or, without one, the `type`) of each path parameter.
    pub path_param_types: List<str>,
    pub request_schema:  str,
    pub response_schema: str,
}

pub struct OpenApiDoc : IObject {
    pub title:      str,
    pub version:    str,
    pub schemas:    List<OpenApiSchema>,
    pub operations: List<OpenApiOperation>,
    ~self() {}
}

pub fn openapi_doc_new(title: str, version: str) -> OpenApiDoc {
    return OpenApiDoc {
        title:      title,
        version:    version,
        schemas:    [],
        operations: [],
    };
}

pub fn openapi_doc_find_schema(doc: OpenApiDoc, name: str) -> i64 {
    var i = 0;
    while i < doc.schemas.len() {
        let s = doc.schemas.get(i);
        if s.name == name {
            return i as i64;
        }
        i = i + 1;
    }
    return -1;
}

// ------------------------------------------------------------------------------
// 3. $ref Resolution & DAG Cycle Detection
// ------------------------------------------------------------------------------

pub fn openapi_resolve_ref(ref_str: str) -> str {
    // E.g. "#/components/schemas/User" -> "User"
    let n = ref_str.len();
    var idx = n;
    while idx > 0 {
        idx = idx - 1;
        if ref_str.byte_at(idx) == 47 { // '/'
            return ref_str.slice(idx + 1, n);
        }
    }
    return ref_str;
}

/// Index of `name` in `doc.schemas`' names, or -1.
fn oa_schema_index(doc: OpenApiDoc, name: str) -> i64 {
    return openapi_doc_find_schema(doc, name);
}

/// The schemas `s` refers to by value: property `$ref`s, `allOf` splices and
/// `oneOf` variants.
fn oa_schema_edges(s: OpenApiSchema) -> List<str> {
    var out: List<str> = [];
    for p in s.properties {
        if p.ref_target.len() > 0 { out.push(p.ref_target); }
    }
    for a in s.all_of { out.push(a); }
    for o in s.one_of { out.push(o); }
    return out;
}

/// Whether schema `start` can reach itself through `$ref` edges.
fn oa_reaches_self(doc: OpenApiDoc, start: i64) -> bool {
    var seen: List<i64> = [];
    var stack: List<str> = oa_schema_edges(doc.schemas.get(start as usize));
    while stack.len() > 0 {
        let name = stack.pop();
        let idx = oa_schema_index(doc, name);
        if idx < 0 { continue; }
        if idx == start { return true; }
        var visited = false;
        for v in seen { if v == idx { visited = true; } }
        if visited { continue; }
        seen.push(idx);
        for e in oa_schema_edges(doc.schemas.get(idx as usize)) { stack.push(e); }
    }
    return false;
}

/// Marks every schema that lies on a `$ref` cycle (directly or through other
/// schemas) as recursive, so its layout gets indirected (SCH004). Returns how
/// many there are.
pub fn openapi_detect_recursion(var ref doc: OpenApiDoc) -> i64 {
    var recursive_count: i64 = 0;
    var i: i64 = 0;
    while i < doc.schemas.len() as i64 {
        if oa_reaches_self(doc, i) {
            var s = doc.schemas.get(i as usize);
            s.is_recursive = true;
            doc.schemas.set(i as usize, s);
            recursive_count = recursive_count + 1;
        }
        i = i + 1;
    }
    return recursive_count;
}

// ------------------------------------------------------------------------------
// 4. JSON Span Reader
// ------------------------------------------------------------------------------
// Walks the spec text in place: a value is named by the offset where it
// starts, and nothing is copied until a string is read.

pure fn oa_is_ws(b: i64) -> bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn oa_ws(src: str, p: i64) -> i64 {
    var i = p;
    while i < src.len() as i64 && oa_is_ws(src.byte_at(i)) { i = i + 1; }
    return i;
}

/// `p` is at an opening '"'; returns the offset just past the closing one.
fn oa_skip_string(src: str, p: i64) -> i64 {
    let n = src.len() as i64;
    var i = p + 1;
    while i < n {
        let b = src.byte_at(i);
        if b == 92 { i = i + 2; continue; } // backslash escape
        if b == 34 { return i + 1; }
        i = i + 1;
    }
    return n;
}

/// Offset just past the JSON value that starts at `p`.
fn oa_skip_value(src: str, p: i64) -> i64 {
    let n = src.len() as i64;
    let i = oa_ws(src, p);
    if i >= n { return n; }
    let b = src.byte_at(i);
    if b == 34 { return oa_skip_string(src, i); }
    if b == 123 || b == 91 { // '{' or '['
        var depth: i64 = 0;
        var k = i;
        while k < n {
            let c = src.byte_at(k);
            if c == 34 { k = oa_skip_string(src, k); continue; }
            if c == 123 || c == 91 { depth = depth + 1; }
            if c == 125 || c == 93 {
                depth = depth - 1;
                if depth == 0 { return k + 1; }
            }
            k = k + 1;
        }
        return n;
    }
    // number, true, false, null
    var k = i;
    while k < n {
        let c = src.byte_at(k);
        if c == 44 || c == 125 || c == 93 || oa_is_ws(c) { break; }
        k = k + 1;
    }
    return k;
}

/// The text of the JSON string at `p`, with `\"`, `\\`, `\/`, `\n` and `\t`
/// unescaped; "" if `p` is not at a string.
fn oa_string_at(src: str, p: i64) -> str {
    if p < 0 { return ""; }
    let i = oa_ws(src, p);
    if i >= src.len() as i64 || src.byte_at(i) != 34 { return ""; }
    let end = oa_skip_string(src, i) - 1;
    var out = "";
    var at = i + 1;
    var k = i + 1;
    while k < end {
        if src.byte_at(k) == 92 && k + 1 < end {
            let e = src.byte_at(k + 1);
            out = out + src.slice(at, k);
            if e == 110 { out = out + "\n"; }
            else if e == 116 { out = out + "\t"; }
            else { out = out + src.slice(k + 1, k + 2); }
            k = k + 2;
            at = k;
            continue;
        }
        k = k + 1;
    }
    return out + src.slice(at, end);
}

/// Offsets of the keys of the object at `p` (each at its '"'); empty if `p`
/// is not at an object.
fn oa_member_keys(src: str, p: i64) -> List<i64> {
    var keys: List<i64> = [];
    if p < 0 { return keys; }
    let n = src.len() as i64;
    var i = oa_ws(src, p);
    if i >= n || src.byte_at(i) != 123 { return keys; }
    i = oa_ws(src, i + 1);
    while i < n && src.byte_at(i) == 34 {
        keys.push(i);
        i = oa_ws(src, oa_skip_string(src, i));
        if i < n && src.byte_at(i) == 58 { i = i + 1; } // ':'
        i = oa_ws(src, oa_skip_value(src, i));
        if i < n && src.byte_at(i) == 44 { i = oa_ws(src, i + 1); } // ','
    }
    return keys;
}

/// Offset of the value that follows the key at `key_at`.
fn oa_member_value(src: str, key_at: i64) -> i64 {
    var i = oa_ws(src, oa_skip_string(src, key_at));
    if i < src.len() as i64 && src.byte_at(i) == 58 { i = i + 1; }
    return oa_ws(src, i);
}

/// Offset of member `key`'s value in the object at `p`, or -1.
fn oa_get(src: str, p: i64, key: str) -> i64 {
    if p < 0 { return -1; }
    for k in oa_member_keys(src, p) {
        if oa_string_at(src, k) == key { return oa_member_value(src, k); }
    }
    return -1;
}

/// Offsets of the elements of the array at `p`.
fn oa_elements(src: str, p: i64) -> List<i64> {
    var out: List<i64> = [];
    if p < 0 { return out; }
    let n = src.len() as i64;
    var i = oa_ws(src, p);
    if i >= n || src.byte_at(i) != 91 { return out; }
    i = oa_ws(src, i + 1);
    while i < n && src.byte_at(i) != 93 {
        out.push(i);
        i = oa_ws(src, oa_skip_value(src, i));
        if i < n && src.byte_at(i) == 44 { i = oa_ws(src, i + 1); }
    }
    return out;
}

fn oa_get_string(src: str, p: i64, key: str) -> str {
    let v = oa_get(src, p, key);
    if v < 0 { return ""; }
    return oa_string_at(src, v);
}

// ------------------------------------------------------------------------------
// 5. OpenAPI 3.x Absorber (JSON)
// ------------------------------------------------------------------------------

/// The schema a schema object names: its `$ref` target, or `List<T>` for an
/// array whose `items` is a `$ref`; "" for an inline schema.
fn oa_schema_ref_name(src: str, schema_at: i64) -> str {
    let r = oa_get_string(src, schema_at, "$ref");
    if r.len() > 0 { return openapi_resolve_ref(r); }
    let items = oa_get(src, schema_at, "items");
    let ir = oa_get_string(src, items, "$ref");
    if ir.len() > 0 { return "List<" + openapi_resolve_ref(ir) + ">"; }
    return "";
}

/// `format` when the schema has one, else its `type`.
fn oa_type_name(src: str, schema_at: i64) -> str {
    let f = oa_get_string(src, schema_at, "format");
    if f.len() > 0 { return f; }
    return oa_get_string(src, schema_at, "type");
}

/// Adds the members of `properties` in the schema object at `at` to `schema`.
fn oa_read_properties(src: str, at: i64, var ref schema: OpenApiSchema) {
    var required: List<str> = [];
    for r in oa_elements(src, oa_get(src, at, "required")) { required.push(oa_string_at(src, r)); }
    let props = oa_get(src, at, "properties");
    for k in oa_member_keys(src, props) {
        let pname = oa_string_at(src, k);
        let pv = oa_member_value(src, k);
        var is_req = false;
        for r in required { if r == pname { is_req = true; } }
        let target = oa_schema_ref_name(src, pv);
        let direct = oa_get_string(src, pv, "$ref");
        schema.properties.push(OpenApiProperty {
            name:        pname,
            prop_type:   if target.len() > 0 { target } else { oa_type_name(src, pv) },
            is_required: is_req,
            // Only a direct `$ref` is stored by value; a list of T is not.
            ref_target:  if direct.len() > 0 { openapi_resolve_ref(direct) } else { "" },
        });
    }
}

fn oa_read_schema(src: str, name: str, at: i64) -> OpenApiSchema {
    let stype = oa_get_string(src, at, "type");
    var schema = openapi_schema_new(name, if stype.len() > 0 { stype } else { "object" });
    oa_read_properties(src, at, var schema);
    for part in oa_elements(src, oa_get(src, at, "allOf")) {
        let r = oa_get_string(src, part, "$ref");
        if r.len() > 0 {
            schema.all_of.push(openapi_resolve_ref(r));
        } else {
            oa_read_properties(src, part, var schema);
        }
    }
    let variants = oa_elements(src, oa_get(src, at, "oneOf"));
    if variants.len() > 0 {
        schema.schema_type = "union";
        for v in variants {
            let r = oa_get_string(src, v, "$ref");
            if r.len() > 0 { schema.one_of.push(openapi_resolve_ref(r)); }
        }
    }
    return schema;
}

/// The HTTP method an OpenAPI path-item key names, or "" for other keys
/// (`parameters`, `summary`, ..).
fn oa_http_method(key: str) -> str {
    if key == "get" { return "GET"; }
    if key == "put" { return "PUT"; }
    if key == "post" { return "POST"; }
    if key == "delete" { return "DELETE"; }
    if key == "options" { return "OPTIONS"; }
    if key == "head" { return "HEAD"; }
    if key == "patch" { return "PATCH"; }
    if key == "trace" { return "TRACE"; }
    return "";
}

/// The `$ref` name of the first media type's schema under `content`.
fn oa_content_schema(src: str, holder_at: i64) -> str {
    let content = oa_get(src, holder_at, "content");
    for mk in oa_member_keys(src, content) {
        return oa_schema_ref_name(src, oa_get(src, oa_member_value(src, mk), "schema"));
    }
    return "";
}

fn oa_path_template_params(path_str: str) -> List<str> {
    var out: List<str> = [];
    var scan_p = 0;
    let pn = path_str.len();
    while scan_p < pn {
        if path_str.byte_at(scan_p) == 123 { // '{'
            let cl = path_str.find("}", scan_p + 1);
            if cl > scan_p {
                out.push(path_str.slice(scan_p + 1, cl));
                scan_p = cl;
            }
        }
        scan_p = scan_p + 1;
    }
    return out;
}

/// The type of path parameter `pname` from a `parameters` array, or "".
fn oa_param_type(src: str, params_at: i64, pname: str) -> str {
    for e in oa_elements(src, params_at) {
        if oa_get_string(src, e, "name") == pname && oa_get_string(src, e, "in") == "path" {
            return oa_type_name(src, oa_get(src, e, "schema"));
        }
    }
    return "";
}

fn oa_read_operation(src: str, path_str: str, item_at: i64, method: str, op_at: i64) -> OpenApiOperation {
    let names = oa_path_template_params(path_str);
    var types: List<str> = [];
    for pname in names {
        var t = oa_param_type(src, oa_get(src, op_at, "parameters"), pname);
        if t.len() == 0 { t = oa_param_type(src, oa_get(src, item_at, "parameters"), pname); }
        types.push(t);
    }
    var response = "";
    let responses = oa_get(src, op_at, "responses");
    for rk in oa_member_keys(src, responses) {
        let code = oa_string_at(src, rk);
        if response.len() == 0 && code.starts_with("2") {
            response = oa_content_schema(src, oa_member_value(src, rk));
        }
    }
    return OpenApiOperation {
        path:             path_str,
        http_method:      method,
        operation_id:     oa_get_string(src, op_at, "operationId"),
        path_params:      names,
        path_param_types: types,
        request_schema:   oa_content_schema(src, oa_get(src, op_at, "requestBody")),
        response_schema:  response,
    };
}

/// Absorbs an OpenAPI 3.x document written as JSON: `info`, every schema
/// under `components/schemas`, and every operation under `paths`.
pub fn openapi_parse_spec(src: str) -> OpenApiDoc {
    let root = oa_ws(src, 0);
    let info = oa_get(src, root, "info");
    var doc = openapi_doc_new(oa_get_string(src, info, "title"), oa_get_string(src, info, "version"));

    let schemas = oa_get(src, oa_get(src, root, "components"), "schemas");
    for k in oa_member_keys(src, schemas) {
        doc.schemas.push(oa_read_schema(src, oa_string_at(src, k), oa_member_value(src, k)));
    }

    let paths = oa_get(src, root, "paths");
    for pk in oa_member_keys(src, paths) {
        let path_str = oa_string_at(src, pk);
        let item_at = oa_member_value(src, pk);
        for mk in oa_member_keys(src, item_at) {
            let method = oa_http_method(oa_string_at(src, mk));
            if method.len() > 0 {
                doc.operations.push(oa_read_operation(src, path_str, item_at, method, oa_member_value(src, mk)));
            }
        }
    }

    openapi_detect_recursion(var doc);
    return doc;
}

// ------------------------------------------------------------------------------
// 6. Synthesis of Pilot Client & Server Interfaces
// ------------------------------------------------------------------------------

pub fn openapi_synthesize_client_interface(doc: OpenApiDoc) -> str {
    var out: List<str> = ["// Client Interface synthesized for " + doc.title + " v" + doc.version + "\n"];
    out.push("pub interface IApiClient {\n");

    var i = 0;
    while i < doc.operations.len() {
        let op = doc.operations.get(i);
        var param_sig = "";
        var p = 0;
        while p < op.path_params.len() {
            if p > 0 { param_sig = param_sig + ", "; }
            param_sig = param_sig + op.path_params.get(p) + ": " + op.path_param_types.get(p);
            p = p + 1;
        }
        if op.request_schema.len() > 0 {
            if param_sig.len() > 0 { param_sig = param_sig + ", "; }
            param_sig = param_sig + "body: " + op.request_schema;
        }
        var ret_ty = "void";
        if op.response_schema.len() > 0 {
            ret_ty = op.response_schema;
        }
        out.push("    fn " + op.operation_id + "(" + param_sig + ") -> " + ret_ty + ";\n");
        i = i + 1;
    }

    out.push("}\n");
    return text.join_text(out, "");
}
