// ==============================================================================
// selfhost/adapter/wasm_runtime.pilot
// Ring 3 / Self-Host Compiler: Capability-Sandboxed In-Process WASM 2.0 Runtime
// Package: Pilot.SelfHost.Adapter.WasmRuntime (Milestone 19)
// ==============================================================================

pub lvl(0) pkg Pilot.SelfHost.Adapter.WasmRuntime;

use Pilot.SelfHost.Adapter.WitParser;
use Pilot.SelfHost.Adapter.WitAbi;

// ------------------------------------------------------------------------------
// 1. WASM Binary Magic & Constants
// ------------------------------------------------------------------------------

pub pure fn wasm_magic_bytes() -> i64 {
    // 0x6D736100 in decimal = 1836278016 ('\0asm' little-endian)
    return 1836278016;
}

pub pure fn wasm_supported_version() -> i64 {
    return 1;
}

pub pure fn wasm_page_size() -> i64 {
    return 65536; // 64 KiB per WASM page
}

// ------------------------------------------------------------------------------
// 2. Sandboxed Linear Memory (0b10 : IObject)
// ------------------------------------------------------------------------------

pub struct WasmMemory : IObject {
    pub pages:     i64,
    pub max_pages: i64,
    pub bytes:     List<i64>,
}

pub fn wasm_memory_new(initial_pages: i64, max_pages: i64) -> WasmMemory {
    var p = initial_pages;
    if p < 1 { p = 1; }
    var mp = max_pages;
    if mp < p { mp = p; }
    return WasmMemory {
        pages:     p,
        max_pages: mp,
        bytes:     [],
    };
}

pub fn wasm_memory_byte_len(mem: WasmMemory) -> i64 {
    return mem.pages * wasm_page_size();
}

pub fn wasm_memory_grow(var ref mem: WasmMemory, delta_pages: i64) -> WasmResult {
    if delta_pages < 0 {
        return wasm_err("WASM003: Invalid negative page count for memory.grow");
    }
    let prev_pages = mem.pages;
    let new_pages = prev_pages + delta_pages;
    if new_pages > mem.max_pages {
        return wasm_err("WASM003: Linear memory grow exceeds maximum allocated pages (" + mem.max_pages.to_str() + ")");
    }
    mem.pages = new_pages;
    return wasm_ok_int(prev_pages);
}

pub fn wasm_memory_check_bounds(mem: WasmMemory, offset: i64, size: i64) -> WasmResult {
    if offset < 0 || size < 0 {
        return wasm_err("WASM003: Negative linear memory offset or size");
    }
    let total_len = wasm_memory_byte_len(mem);
    if (offset + size) > total_len {
        return wasm_err("WASM003: Linear memory access out-of-bounds: " + (offset + size).to_str() + " > " + total_len.to_str());
    }
    return wasm_ok_int(1);
}

pub fn wasm_memory_store_byte(var ref mem: WasmMemory, offset: i64, val: i64) -> WasmResult {
    let chk = wasm_memory_check_bounds(mem, offset, 1);
    if chk.is_err() {
        return chk;
    }
    // Dynamically expand byte storage list as needed
    while mem.bytes.len() <= (offset as usize) {
        mem.bytes.push(0);
    }
    mem.bytes.set(offset as usize, val & 255);
    return wasm_ok_int(1);
}

pub fn wasm_memory_load_byte(mem: WasmMemory, offset: i64) -> WasmResult {
    let chk = wasm_memory_check_bounds(mem, offset, 1);
    if chk.is_err() {
        return chk;
    }
    if (offset as usize) < mem.bytes.len() {
        return wasm_ok_int(mem.bytes.get(offset as usize));
    }
    return wasm_ok_int(0);
}

pub fn wasm_memory_store_i32(var ref mem: WasmMemory, offset: i64, val: i64) -> WasmResult {
    let b0 = val & 255;
    let b1 = (val >> 8) & 255;
    let b2 = (val >> 16) & 255;
    let b3 = (val >> 24) & 255;
    let r0 = wasm_memory_store_byte(var mem, offset + 0, b0);
    if r0.is_err() { return r0; }
    let r1 = wasm_memory_store_byte(var mem, offset + 1, b1);
    if r1.is_err() { return r1; }
    let r2 = wasm_memory_store_byte(var mem, offset + 2, b2);
    if r2.is_err() { return r2; }
    let r3 = wasm_memory_store_byte(var mem, offset + 3, b3);
    return r3;
}

pub fn wasm_memory_load_i32(mem: WasmMemory, offset: i64) -> WasmResult {
    let b0 = wasm_memory_load_byte(mem, offset + 0);
    if b0.is_err() { return b0; }
    let b1 = wasm_memory_load_byte(mem, offset + 1);
    if b1.is_err() { return b1; }
    let b2 = wasm_memory_load_byte(mem, offset + 2);
    if b2.is_err() { return b2; }
    let b3 = wasm_memory_load_byte(mem, offset + 3);
    if b3.is_err() { return b3; }

    let v = b0.unwrap() | (b1.unwrap() << 8) | (b2.unwrap() << 16) | (b3.unwrap() << 24);
    return wasm_ok_int(v);
}

pub fn wasm_memory_store_str(var ref mem: WasmMemory, offset: i64, s: str) -> WasmResult {
    let slen = s.len() as i64;
    let chk = wasm_memory_check_bounds(mem, offset, slen);
    if chk.is_err() {
        return chk;
    }
    var i = 0;
    while i < slen {
        let b = s.byte_at(i as usize);
        let res_st = wasm_memory_store_byte(var mem, offset + i, b);
        if res_st.is_err() {
            return res_st;
        }
        i = i + 1;
    }
    return wasm_ok_int(slen);
}

/// Length of the UTF-8 sequence that starts with lead byte `b`, or 0 when
/// `b` cannot start one (RFC 3629).
pure fn wasm_utf8_seq_len(b: i64) -> i64 {
    if b < 128 { return 1; }
    if b >= 194 && b <= 223 { return 2; }
    if b >= 224 && b <= 239 { return 3; }
    if b >= 240 && b <= 244 { return 4; }
    return 0;
}

/// Checks that `len` bytes at `offset` are well-formed UTF-8 (RFC 3629:
/// no overlong forms, no surrogates, nothing above U+10FFFF). WASM004 if not.
pub fn wasm_memory_validate_utf8(mem: WasmMemory, offset: i64, len: i64) -> WasmResult {
    let chk = wasm_memory_check_bounds(mem, offset, len);
    if chk.is_err() {
        return chk;
    }
    var i: i64 = 0;
    while i < len {
        let b0 = wasm_memory_load_byte(mem, offset + i).unwrap();
        let n = wasm_utf8_seq_len(b0);
        if n == 0 || i + n > len {
            return wasm_err("WASM004: Invalid UTF-8 lead byte " + b0.to_str() + " at offset " + (offset + i).to_str());
        }
        var k: i64 = 1;
        while k < n {
            let bk = wasm_memory_load_byte(mem, offset + i + k).unwrap();
            var lo: i64 = 128;
            var hi: i64 = 191;
            if k == 1 {
                if b0 == 224 { lo = 160; }
                if b0 == 237 { hi = 159; }
                if b0 == 240 { lo = 144; }
                if b0 == 244 { hi = 143; }
            }
            if bk < lo || bk > hi {
                return wasm_err("WASM004: Invalid UTF-8 continuation byte " + bk.to_str() + " at offset " + (offset + i + k).to_str());
            }
            k = k + 1;
        }
        i = i + n;
    }
    return wasm_ok_int(len);
}

/// Reads a string of `len` bytes at `offset`. The bytes are checked as UTF-8
/// here; turning them into a `str` needs a bytes-to-string intrinsic the seed
/// does not have yet.
pub fn wasm_memory_load_str(mem: WasmMemory, offset: i64, len: i64) -> WasmResult {
    let valid = wasm_memory_validate_utf8(mem, offset, len);
    if valid.is_err() {
        return valid;
    }
    return seam("wasm.load_str", "a str built from validated linear-memory bytes");
}

// ------------------------------------------------------------------------------
// 3. WasmInstanceLease (0b11 : IGuard) - Fuel & Sandboxed Isolation Guard
// ------------------------------------------------------------------------------

pub struct WasmInstanceLease : IGuard {
    pub lease_id:       i64,
    pub fuel_limit:     i64,
    pub fuel_consumed:  i64,
    pub active_borrows: i64,
    pub is_active:      bool,
}

pub fn wasm_lease_new(lease_id: i64, fuel_limit: i64) -> WasmInstanceLease {
    return WasmInstanceLease {
        lease_id:       lease_id,
        fuel_limit:     fuel_limit,
        fuel_consumed:  0,
        active_borrows: 0,
        is_active:      true,
    };
}

pub fn wasm_lease_consume_fuel(var ref lease: WasmInstanceLease, amount: i64) -> WasmResult {
    if !lease.is_active {
        return wasm_err("WASM003: Attempt to consume fuel on inactive WasmInstanceLease");
    }
    lease.fuel_consumed = lease.fuel_consumed + amount;
    if lease.fuel_limit > 0 && lease.fuel_consumed > lease.fuel_limit {
        return wasm_err("WASM003: WASM execution trapped: Fuel limit exhausted (" + lease.fuel_consumed.to_str() + " > " + lease.fuel_limit.to_str() + ")");
    }
    return wasm_ok_int(1);
}

pub fn wasm_lease_acquire_borrow(var ref lease: WasmInstanceLease) -> void {
    lease.active_borrows = lease.active_borrows + 1;
}

pub fn wasm_lease_release_borrow(var ref lease: WasmInstanceLease) -> WasmResult {
    if lease.active_borrows <= 0 {
        return wasm_err("WASM005: Underflow in active borrow release");
    }
    lease.active_borrows = lease.active_borrows - 1;
    return wasm_ok_int(1);
}

pub fn wasm_lease_exit(var ref lease: WasmInstanceLease) -> WasmResult {
    if lease.active_borrows > 0 {
        return wasm_err("WASM005: Resource borrow still active at component boundary exit (" + lease.active_borrows.to_str() + " borrows unreleased)");
    }
    lease.is_active = false;
    return wasm_ok_int(1);
}

// ------------------------------------------------------------------------------
// 4. WASM Function Export & Bytecode Instructions
// ------------------------------------------------------------------------------

pub struct WasmExportDef : IValue {
    pub name:         str,
    pub param_count:  i64,
    pub result_count: i64,
    pub code_offset:  i64,
}

pub struct WasmInstance : IObject {
    pub module_name:    str,
    pub memory:         WasmMemory,
    pub resource_table: WasmResourceTable,
    pub exports:        List<WasmExportDef>,
    pub fuel_limit:     i64,
    pub fuel_used:      i64,
}

pub fn wasm_instance_new(name: str, initial_pages: i64, max_pages: i64, fuel: i64) -> WasmInstance {
    return WasmInstance {
        module_name:    name,
        memory:         wasm_memory_new(initial_pages, max_pages),
        resource_table: wasm_resource_table_new(),
        exports:        [],
        fuel_limit:     fuel,
        fuel_used:      0,
    };
}

pub fn wasm_instance_add_export(var ref inst: WasmInstance, name: str, params: i64, results: i64) -> void {
    let exp = WasmExportDef {
        name:         name,
        param_count:  params,
        result_count: results,
        code_offset:  inst.exports.len() as i64,
    };
    inst.exports.push(exp);
}

pub fn wasm_instance_find_export_idx(inst: WasmInstance, name: str) -> i64 {
    var i = 0;
    while i < inst.exports.len() {
        let e = inst.exports.get(i);
        if e.name == name {
            return i as i64;
        }
        i = i + 1;
    }
    return -1;
}

// ------------------------------------------------------------------------------
// 5. Binary WASM Module Header Validator
// ------------------------------------------------------------------------------

pub fn wasm_validate_header(magic: i64, version: i64) -> WasmResult {
    if magic != wasm_magic_bytes() {
        return wasm_err("WASM001: Invalid binary WASM magic word (" + magic.to_str() + " != " + wasm_magic_bytes().to_str() + ")");
    }
    if version != wasm_supported_version() {
        return wasm_err("WASM001: Unsupported WASM version (" + version.to_str() + " != " + wasm_supported_version().to_str() + ")");
    }
    return wasm_ok_int(1);
}

// ------------------------------------------------------------------------------
// 6. Sandboxed WASM Interpreter Execution Core
// ------------------------------------------------------------------------------

pub fn wasm_invoke(var ref inst: WasmInstance, export_name: str, args: List<i64>) -> WasmResult {
    let exp_idx = wasm_instance_find_export_idx(inst, export_name);
    if exp_idx < 0 {
        return wasm_err("WASM002: Export '" + export_name + "' not found in module '" + inst.module_name + "'");
    }
    let exp = inst.exports.get(exp_idx as usize);

    // Verify argument count matches
    if args.len() as i64 != exp.param_count {
        return wasm_err("WASM002: Parameter count mismatch for '" + export_name + "': expected " + exp.param_count.to_str() + ", got " + (args.len() as i64).to_str());
    }

    // Running the export means decoding its code section and interpreting
    // the instructions under the instance's fuel and memory limits.
    return seam("wasm.interpret", "a WASM code-section decoder and instruction interpreter");
}

// ------------------------------------------------------------------------------
// 7. PilIR AOT Lifter Bridge
// ------------------------------------------------------------------------------

pub fn wasm_lift_to_pilir_bridge(func_name: str, params: List<str>, return_ty: str) -> str {
    return seam("wasm.lift_pilir", "lifting a decoded WASM function body into PilIR");
}
