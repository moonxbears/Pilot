// ==============================================================================
// FILE: selfhost/adapter/cpp_mangle.pilot
// Milestone 15.1: Native C++ Class, RAII, Vtable & Exception Boundary Adapter
// Bidirectional Itanium C++ ABI & MSVC x64 Name Mangler and Demangler
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Adapter.CppMangle;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// 1. C++ Type Representation (0b10 : IObject)
// ------------------------------------------------------------------------------

pub enum CppTypeKind : u8 {
    ::Void       = 0,
    ::Bool       = 1,
    ::Char       = 2,
    ::SChar      = 3,
    ::UChar      = 4,
    ::Short      = 5,
    ::UShort     = 6,
    ::Int        = 7,
    ::UInt       = 8,
    ::Long       = 9,
    ::ULong      = 10,
    ::LongLong   = 11,
    ::ULongLong  = 12,
    ::Float      = 13,
    ::Double     = 14,
    ::Pointer    = 15,
    ::LValueRef  = 16,
    ::RValueRef  = 17,
    ::Named      = 18,
}

pub struct CppType : IObject {
    pub kind:         CppTypeKind;
    pub name:         str;
    pub is_const:     bool;
    pub pointee_name: str;
}

pub pure fn cpp_type_primitive(kind: CppTypeKind) -> CppType {
    return CppType {
        kind:         kind,
        name:         "",
        is_const:     false,
        pointee_name: "",
    };
}

pub pure fn cpp_type_pointer(target_name: str, is_const: bool) -> CppType {
    return CppType {
        kind:         CppTypeKind::Pointer,
        name:         "",
        is_const:     is_const,
        pointee_name: target_name,
    };
}

pub pure fn cpp_type_lvalue_ref(target_name: str, is_const: bool) -> CppType {
    return CppType {
        kind:         CppTypeKind::LValueRef,
        name:         "",
        is_const:     is_const,
        pointee_name: target_name,
    };
}

pub pure fn cpp_type_rvalue_ref(target_name: str) -> CppType {
    return CppType {
        kind:         CppTypeKind::RValueRef,
        name:         "",
        is_const:     false,
        pointee_name: target_name,
    };
}

pub pure fn cpp_type_named(name: str, is_const: bool) -> CppType {
    return CppType {
        kind:         CppTypeKind::Named,
        name:         name,
        is_const:     is_const,
        pointee_name: "",
    };
}

// ------------------------------------------------------------------------------
// 2. Operator Mappings (Itanium & MSVC)
// ------------------------------------------------------------------------------

pub pure fn itanium_operator_code(name: str) -> str {
    if name == "operator+" { return "pl"; }
    if name == "operator-" { return "mi"; }
    if name == "operator*" { return "ml"; }
    if name == "operator/" { return "dv"; }
    if name == "operator%" { return "rm"; }
    if name == "operator&" { return "an"; }
    if name == "operator|" { return "or"; }
    if name == "operator^" { return "eo"; }
    if name == "operator=" { return "aS"; }
    if name == "operator+=" { return "pL"; }
    if name == "operator-=" { return "mI"; }
    if name == "operator*=" { return "mL"; }
    if name == "operator/=" { return "dV"; }
    if name == "operator==" { return "eq"; }
    if name == "operator!=" { return "ne"; }
    if name == "operator<" { return "lt"; }
    if name == "operator>" { return "gt"; }
    if name == "operator<=" { return "le"; }
    if name == "operator>=" { return "ge"; }
    if name == "operator!" { return "nt"; }
    if name == "operator&&" { return "aa"; }
    if name == "operator||" { return "oo"; }
    if name == "operator++" { return "pp"; }
    if name == "operator--" { return "mm"; }
    if name == "operator[]" { return "ix"; }
    if name == "operator()" { return "cl"; }
    if name == "operator->" { return "pt"; }
    return "";
}

pub pure fn itanium_code_to_operator(code: str) -> str {
    if code == "pl" { return "operator+"; }
    if code == "mi" { return "operator-"; }
    if code == "ml" { return "operator*"; }
    if code == "dv" { return "operator/"; }
    if code == "rm" { return "operator%"; }
    if code == "an" { return "operator&"; }
    if code == "or" { return "operator|"; }
    if code == "eo" { return "operator^"; }
    if code == "aS" { return "operator="; }
    if code == "pL" { return "operator+="; }
    if code == "mI" { return "operator-="; }
    if code == "mL" { return "operator*="; }
    if code == "dV" { return "operator/="; }
    if code == "eq" { return "operator=="; }
    if code == "ne" { return "operator!="; }
    if code == "lt" { return "operator<"; }
    if code == "gt" { return "operator>"; }
    if code == "le" { return "operator<="; }
    if code == "ge" { return "operator>="; }
    if code == "nt" { return "operator!"; }
    if code == "aa" { return "operator&&"; }
    if code == "oo" { return "operator||"; }
    if code == "pp" { return "operator++"; }
    if code == "mm" { return "operator--"; }
    if code == "ix" { return "operator[]"; }
    if code == "cl" { return "operator()"; }
    if code == "pt" { return "operator->"; }
    return "";
}

pub pure fn msvc_operator_code(name: str) -> str {
    if name == "operator+" { return "?H"; }
    if name == "operator-" { return "?G"; }
    if name == "operator*" { return "?D"; }
    if name == "operator/" { return "?K"; }
    if name == "operator%" { return "?L"; }
    if name == "operator=" { return "?4"; }
    if name == "operator==" { return "?8"; }
    if name == "operator!=" { return "?9"; }
    if name == "operator[]" { return "?A"; }
    if name == "operator()" { return "?R"; }
    if name == "operator->" { return "?C"; }
    return "";
}

// ------------------------------------------------------------------------------
// 3. Itanium C++ ABI Mangling (_ZN...E)
// ------------------------------------------------------------------------------

pub pure fn itanium_mangle_type(ty: ref<CppType>) -> str {
    var out = "";
    if ty.is_const && ty.kind != CppTypeKind::LValueRef && ty.kind != CppTypeKind::RValueRef {
        out = out + "K";
    }

    if ty.kind == CppTypeKind::Void { return out + "v"; }
    if ty.kind == CppTypeKind::Bool { return out + "b"; }
    if ty.kind == CppTypeKind::Char { return out + "c"; }
    if ty.kind == CppTypeKind::SChar { return out + "a"; }
    if ty.kind == CppTypeKind::UChar { return out + "h"; }
    if ty.kind == CppTypeKind::Short { return out + "s"; }
    if ty.kind == CppTypeKind::UShort { return out + "t"; }
    if ty.kind == CppTypeKind::Int { return out + "i"; }
    if ty.kind == CppTypeKind::UInt { return out + "j"; }
    if ty.kind == CppTypeKind::Long { return out + "l"; }
    if ty.kind == CppTypeKind::ULong { return out + "m"; }
    if ty.kind == CppTypeKind::LongLong { return out + "x"; }
    if ty.kind == CppTypeKind::ULongLong { return out + "y"; }
    if ty.kind == CppTypeKind::Float { return out + "f"; }
    if ty.kind == CppTypeKind::Double { return out + "d"; }

    if ty.kind == CppTypeKind::Pointer {
        out = out + "P";
        if ty.is_const { out = out + "K"; }
        if ty.pointee_name == "void" { return out + "v"; }
        if ty.pointee_name == "ch" + "ar" { return out + "c"; }
        if ty.pointee_name == "int" { return out + "i"; }
        return out + ("" + ty.pointee_name.len()) + ty.pointee_name;
    }

    if ty.kind == CppTypeKind::LValueRef {
        out = out + "R";
        if ty.is_const { out = out + "K"; }
        if ty.pointee_name == "int" { return out + "i"; }
        if ty.pointee_name == "ch" + "ar" { return out + "c"; }
        if ty.pointee_name == "double" { return out + "d"; }
        return out + ("" + ty.pointee_name.len()) + ty.pointee_name;
    }

    if ty.kind == CppTypeKind::RValueRef {
        out = out + "O";
        if ty.is_const { out = out + "K"; }
        if ty.pointee_name == "int" { return out + "i"; }
        return out + ("" + ty.pointee_name.len()) + ty.pointee_name;
    }

    if ty.kind == CppTypeKind::Named {
        if ty.name == "std::string_view" {
            return out + "St17basic_string_viewIcSt11char_traitsIcEE";
        }
        if ty.name.starts_with("std::") {
            let sub = ty.name.slice(5, ty.name.len());
            return out + "St" + ("" + sub.len()) + sub;
        }
        return out + ("" + ty.name.len()) + ty.name;
    }

    return out + "v";
}

pub pure fn mangle_itanium(
    ns_path: slice<str>,
    fn_name: str,
    is_const_method: bool,
    is_ctor_dtor: u8,
    param_types: slice<CppType>
) -> str {
    var out = "_Z";
    let is_nested = ns_path.len() > 0 || is_const_method;

    if is_nested {
        out = "_ZN";
        if is_const_method {
            out = out + "K";
        }

        var i: usize = 0;
        while i < ns_path.len() {
            let part = ns_path[i];
            if i == 0 && part == "std" {
                out = out + "St";
            } else {
                out = out + ("" + part.len()) + part;
            }
            i = i + 1;
        }

        if is_ctor_dtor == 1 { out = out + "C1"; }
        else if is_ctor_dtor == 2 { out = out + "C2"; }
        else if is_ctor_dtor == 3 { out = out + "D1"; }
        else if is_ctor_dtor == 4 { out = out + "D0"; }
        else if is_ctor_dtor == 5 { out = out + "D2"; }
        else {
            let op_code = itanium_operator_code(fn_name);
            if op_code != "" {
                out = out + op_code;
            } else {
                out = out + ("" + fn_name.len()) + fn_name;
            }
        }
        out = out + "E";
    } else {
        let op_code = itanium_operator_code(fn_name);
        if op_code != "" {
            out = out + op_code;
        } else {
            out = out + ("" + fn_name.len()) + fn_name;
        }
    }

    // Parameters
    if param_types.len() == 0 {
        out = out + "v";
    } else {
        var p: usize = 0;
        while p < param_types.len() {
            out = out + itanium_mangle_type(param_types[p]);
            p = p + 1;
        }
    }

    return out;
}

// ------------------------------------------------------------------------------
// 4. MSVC x64 Mangling (?name@ns@@...)
// ------------------------------------------------------------------------------

pub pure fn msvc_mangle_type(ty: ref<CppType>) -> str {
    if ty.kind == CppTypeKind::Void { return "X"; }
    if ty.kind == CppTypeKind::Bool { return "_N"; }
    if ty.kind == CppTypeKind::Char { return "D"; }
    if ty.kind == CppTypeKind::Int { return "H"; }
    if ty.kind == CppTypeKind::UInt { return "I"; }
    if ty.kind == CppTypeKind::LongLong { return "_J"; }
    if ty.kind == CppTypeKind::ULongLong { return "_K"; }
    if ty.kind == CppTypeKind::Float { return "M"; }
    if ty.kind == CppTypeKind::Double { return "N"; }

    if ty.kind == CppTypeKind::Pointer {
        if ty.is_const { return "PEB" + ty.pointee_name + "@@"; }
        return "PEA" + ty.pointee_name + "@@";
    }

    if ty.kind == CppTypeKind::LValueRef {
        if ty.is_const { return "AEB" + ty.pointee_name + "@@"; }
        return "AEA" + ty.pointee_name + "@@";
    }

    if ty.kind == CppTypeKind::Named {
        return "U" + ty.name + "@@";
    }

    return "X";
}

pub pure fn mangle_msvc_x64(
    ns_path: slice<str>,
    fn_name: str,
    access: u8,
    is_virtual: bool,
    param_types: slice<CppType>,
    ret_type: ref<CppType>
) -> str {
    var out = "?";

    // Symbol name or ctor/dtor
    if fn_name == "__ctor" || fn_name == "?0" {
        out = out + "?0";
    } else if fn_name == "__dtor" || fn_name == "?1" {
        out = out + "?1";
    } else {
        let op_code = msvc_operator_code(fn_name);
        if op_code != "" {
            out = out + op_code;
        } else {
            out = out + fn_name + "@";
        }
    }

    // Scopes in reverse order
    if ns_path.len() > 0 {
        var i: usize = ns_path.len();
        while i > 0 {
            i = i - 1;
            out = out + ns_path[i] + "@";
        }
    }
    out = out + "@";

    // Access and calling convention
    if access == 3 {
        // Global / static free function (x64 __cdecl / fastcall)
        out = out + "YA";
    } else if is_virtual {
        if access == 0 { out = out + "UEAA"; }
        else if access == 1 { out = out + "MEAA"; }
        else { out = out + "EEAA"; }
    } else {
        // Non-virtual member
        if access == 0 { out = out + "QEAA"; }
        else if access == 1 { out = out + "IEAA"; }
        else { out = out + "AEAA"; }
    }

    // Return type
    out = out + msvc_mangle_type(ret_type);

    // Parameters
    if param_types.len() == 0 {
        out = out + "XZ";
    } else {
        var p: usize = 0;
        while p < param_types.len() {
            out = out + msvc_mangle_type(param_types[p]);
            p = p + 1;
        }
        out = out + "@Z";
    }

    return out;
}

// ------------------------------------------------------------------------------
// 5. Demangling Helpers
// ------------------------------------------------------------------------------

pub pure fn demangle_itanium_type_code(code: str) -> str {
    if code == "v" { return "void"; }
    if code == "b" { return "bo" + "ol"; }
    if code == "c" { return "ch" + "ar"; }
    if code == "i" { return "int"; }
    if code == "j" { return "unsigned int"; }
    if code == "d" { return "double"; }
    if code == "f" { return "float"; }
    if code == "x" { return "long long"; }
    if code == "y" { return "unsigned long long"; }
    return code;
}

pub pure fn demangle_itanium(mangled: str) -> str {
    if !mangled.starts_with("_Z") {
        return mangled;
    }

    var cursor: usize = 2;
    var is_const = false;
    var is_nested = false;

    if mangled.slice(cursor, cursor + 2) == "NK" {
        is_nested = true;
        is_const = true;
        cursor = cursor + 2;
    } else if mangled.slice(cursor, cursor + 1) == "N" {
        is_nested = true;
        cursor = cursor + 1;
    }

    var parts: List<str> = [];
    var last_class = "";

    if is_nested {
        while cursor < mangled.len() && mangled.byte_at(cursor as i64) != 69 { // 69 == 'E'
            let b = mangled.byte_at(cursor as i64);
            // Check St (std namespace)
            if b == 83 && mangled.byte_at((cursor + 1) as i64) == 116 {
                parts.push("std");
                cursor = cursor + 2;
                continue;
            }
            // Check C1 / C2 (constructor)
            if b == 67 && (mangled.byte_at((cursor + 1) as i64) == 49 || mangled.byte_at((cursor + 1) as i64) == 50) {
                parts.push(last_class);
                cursor = cursor + 2;
                continue;
            }
            // Check D0 / D1 / D2 (destructor)
            if b == 68 && (mangled.byte_at((cursor + 1) as i64) >= 48 && mangled.byte_at((cursor + 1) as i64) <= 50) {
                parts.push("~" + last_class);
                cursor = cursor + 2;
                continue;
            }
            // Check digits
            if b >= 48 && b <= 57 {
                var len_val: usize = 0;
                while cursor < mangled.len() && mangled.byte_at(cursor as i64) >= 48 && mangled.byte_at(cursor as i64) <= 57 {
                    len_val = len_val * 10 + (mangled.byte_at(cursor as i64) - 48) as usize;
                    cursor = cursor + 1;
                }
                let part_name = mangled.slice(cursor, cursor + len_val);
                parts.push(part_name);
                last_class = part_name;
                cursor = cursor + len_val;
                continue;
            }
            // Check operator codes (2 chars)
            let op_candidate = mangled.slice(cursor, cursor + 2);
            let op_name = itanium_code_to_operator(op_candidate);
            if op_name != "" {
                parts.push(op_name);
                cursor = cursor + 2;
                continue;
            }
            cursor = cursor + 1;
        }
        if cursor < mangled.len() && mangled.byte_at(cursor as i64) == 69 {
            cursor = cursor + 1; // skip 'E'
        }
    } else {
        // Non-nested _Z<len><name>
        var len_val: usize = 0;
        while cursor < mangled.len() && mangled.byte_at(cursor as i64) >= 48 && mangled.byte_at(cursor as i64) <= 57 {
            len_val = len_val * 10 + (mangled.byte_at(cursor as i64) - 48) as usize;
            cursor = cursor + 1;
        }
        let fn_name = mangled.slice(cursor, cursor + len_val);
        parts.push(fn_name);
        cursor = cursor + len_val;
    }

    // Assemble path
    var full_name = "";
    var p_idx: usize = 0;
    while p_idx < parts.len() {
        if p_idx > 0 { full_name = full_name + "::"; }
        full_name = full_name + parts[p_idx];
        p_idx = p_idx + 1;
    }

    // Parameters
    var params_str = "()";
    let rem = mangled.slice(cursor, mangled.len());
    if rem != "v" && rem != "" {
        var param_list: List<str> = [];
        var r_idx: usize = 0;
        while r_idx < rem.len() {
            let ch = rem.slice(r_idx, r_idx + 1);
            let ty_name = demangle_itanium_type_code(ch);
            param_list.push(ty_name);
            r_idx = r_idx + 1;
        }
        var p_out = "(";
        var q: usize = 0;
        while q < param_list.len() {
            if q > 0 { p_out = p_out + ", "; }
            p_out = p_out + param_list[q];
            q = q + 1;
        }
        params_str = p_out + ")";
    }

    var result = full_name + params_str;
    if is_const {
        result = result + " const";
    }
    return result;
}

pub pure fn demangle_msvc_x64(mangled: str) -> str {
    if !mangled.starts_with("?") {
        return mangled;
    }

    var cursor: usize = 1;
    var fn_name = "";

    if mangled.slice(cursor, cursor + 2) == "?0" {
        fn_name = "__ctor";
        cursor = cursor + 2;
    } else if mangled.slice(cursor, cursor + 2) == "?1" {
        fn_name = "__dtor";
        cursor = cursor + 2;
    } else {
        let first_at = mangled.find("@");
        if first_at >= 1 {
            fn_name = mangled.slice(cursor, first_at as usize);
            cursor = (first_at + 1) as usize;
        }
    }

    // Read scopes until @@
    var scopes: List<str> = [];
    while cursor < mangled.len() {
        if mangled.slice(cursor, cursor + 1) == "@" {
            cursor = cursor + 1;
            break;
        }
        let next_at = mangled.slice(cursor, mangled.len()).find("@");
        if next_at < 0 { break; }
        let sc = mangled.slice(cursor, cursor + next_at as usize);
        scopes.push(sc);
        cursor = cursor + (next_at as usize) + 1;
    }

    // Reverse scopes
    var rev_scopes: List<str> = [];
    if scopes.len() > 0 {
        var s: usize = scopes.len();
        while s > 0 {
            s = s - 1;
            rev_scopes.push(scopes[s]);
        }
    }

    // Resolve ctor / dtor name from class name
    if rev_scopes.len() > 0 {
        let class_name = rev_scopes[rev_scopes.len() - 1];
        if fn_name == "__ctor" { fn_name = class_name; }
        else if fn_name == "__dtor" { fn_name = "~" + class_name; }
    }

    var full = "";
    var k: usize = 0;
    while k < rev_scopes.len() {
        full = full + rev_scopes[k] + "::";
        k = k + 1;
    }
    full = full + fn_name;

    return full + "()";
}
