// ==============================================================================
// FILE: selfhost/adapter/rust_sig.pilot
// Milestone 16.1: Native Rust Crate Adapter - Rust Public Item & Signature Parser
// Pure-Pilot parser for Rust items: struct, enum, fn, trait, impl, &[T], &str, Vec, Result
// ==============================================================================
pub lvl(0) pkg Pilot.SelfHost.Adapter.RustSig;

pub pure fn nameof(sym: str) -> str => sym;

// ------------------------------------------------------------------------------
// 1. Rust Diagnostic Codes & Classifications
// ------------------------------------------------------------------------------

pub enum RustDiagnosticKind : u16 {
    ::CrossAllocatorFree = 1, // RST001
    ::CargoResolveError  = 2, // RST002
    ::UnboundBorrow      = 3, // RST003
    ::PanicUnwind        = 4, // RST004
}

pub pure fn rust_diag_code(kind: RustDiagnosticKind) -> str {
    if kind == RustDiagnosticKind::CrossAllocatorFree { return "RST001"; }
    if kind == RustDiagnosticKind::CargoResolveError  { return "RST002"; }
    if kind == RustDiagnosticKind::UnboundBorrow      { return "RST003"; }
    if kind == RustDiagnosticKind::PanicUnwind        { return "RST004"; }
    return "RST000";
}

// ------------------------------------------------------------------------------
// 2. Rust AST Schemas (0b00 : IValue & 0b10 : IObject)
// ------------------------------------------------------------------------------

pub enum RustItemKind : u8 {
    ::Struct = 1,
    ::Enum   = 2,
    ::Fn     = 3,
    ::Trait  = 4,
    ::Impl   = 5,
}

pub enum RustTypeKind : u8 {
    ::Scalar   = 1,
    ::SliceRef = 2,
    ::SliceMut = 3,
    ::StrRef   = 4,
    ::OptNiche = 5,
    ::Result   = 6,
    ::Vec      = 7,
    ::String   = 8,
    ::DynTrait = 9,
    ::Named    = 10,
}

[Layout(c_abi)]
pub struct RustFieldDecl : IValue {
    pub name:        str;
    pub type_name:   str;
    pub type_kind:   RustTypeKind;
    pub is_pub:      bool;
    pub byte_offset: usize;
    pub byte_size:   usize;
}

[Layout(c_abi)]
pub struct RustParamDecl : IValue {
    pub name:      str;
    pub type_name: str;
    pub type_kind: RustTypeKind;
    pub is_ref:    bool;
    pub is_mut:    bool;
}

pub struct RustFnDecl : IObject {
    pub name:        str;
    pub return_type: str;
    pub ret_kind:    RustTypeKind;
    pub is_pub:      bool;
    pub is_unsafe:   bool;
    pub is_extern_c: bool;
    pub params:      List<RustParamDecl>;
}

pub struct RustStructDecl : IObject {
    pub name:        str;
    pub is_pub:      bool;
    pub is_repr_c:   bool;
    pub fields:      List<RustFieldDecl>;
}

[Layout(c_abi)]
pub struct RustEnumVariant : IValue {
    pub name:         str;
    pub tag_value:    i64;
    pub has_payload:  bool;
    pub payload_type: str;
}

pub struct RustEnumDecl : IObject {
    pub name:      str;
    pub is_pub:    bool;
    pub is_repr_c: bool;
    pub variants:  List<RustEnumVariant>;
}

pub struct RustTraitDecl : IObject {
    pub name:    str;
    pub is_pub:  bool;
    pub methods: List<RustFnDecl>;
}

pub struct RustModuleDecl : IObject {
    pub crate_name: str;
    pub structs:    List<RustStructDecl>;
    pub enums:      List<RustEnumDecl>;
    pub functions:  List<RustFnDecl>;
    pub traits:     List<RustTraitDecl>;
}

pub fn rust_module_decl_new(cname: str) -> RustModuleDecl {
    return RustModuleDecl {
        crate_name: cname,
        structs:    [],
        enums:      [],
        functions:  [],
        traits:     [],
    };
}

pub struct CargoMetadata : IObject {
    pub name:         str;
    pub version:      str;
    pub edition:      str;
    pub lib_crate_type: str;
    pub dependencies: Map<str, str>;
}

pub fn cargo_metadata_new() -> CargoMetadata {
    return CargoMetadata {
        name:           "",
        version:        "",
        edition:        "2021",
        lib_crate_type: "rlib",
        dependencies:   [:],
    };
}

// ------------------------------------------------------------------------------
// 3. Rust Type Classifier
// ------------------------------------------------------------------------------

pub pure fn rust_type_classify(ty_name: str) -> RustTypeKind {
    let t = rust_trim(ty_name);
    if t == "&str" || t.find("&'a str") >= 0 || t.find("&str") >= 0 {
        return RustTypeKind::StrRef;
    }
    if t.find("&mut [") >= 0 || t.find("&'a mut [") >= 0 {
        return RustTypeKind::SliceMut;
    }
    if t.find("&[") >= 0 || t.find("&'a [") >= 0 {
        return RustTypeKind::SliceRef;
    }
    if t.find("Option<&") >= 0 || t.find("Option<NonNull") >= 0 || t.find("Option<ref<") >= 0 {
        return RustTypeKind::OptNiche;
    }
    if t.find("Result<") >= 0 {
        return RustTypeKind::Result;
    }
    if t.find("Vec<") >= 0 {
        return RustTypeKind::Vec;
    }
    if t == "String" || t.find("std::string::String") >= 0 {
        return RustTypeKind::String;
    }
    if t.find("&dyn ") >= 0 || t.find("&'a dyn ") >= 0 || t.find("&mut dyn ") >= 0 {
        return RustTypeKind::DynTrait;
    }
    if rust_is_scalar_type(t) {
        return RustTypeKind::Scalar;
    }
    return RustTypeKind::Named;
}

pub pure fn rust_is_scalar_type(t: str) -> bool {
    let n = t.len();
    if n == 0 { return false; }
    let b0 = t.byte_at(0);
    // Integers: i8, i16, i32, i64, i128, u8, u16, u32, u64, u128, isize, usize
    if b0 == 105 || b0 == 117 { // 'i' or 'u'
        if t == "isize" || (b0 == 117 && n == 5 && t.slice(1, 5) == "size") { return true; }
        if n >= 2 && n <= 4 {
            var all_digits = true;
            var j: usize = 1;
            while j < n {
                let d = t.byte_at(j);
                if d < 48 || d > 57 { all_digits = false; break; }
                j = j + 1;
            }
            if all_digits { return true; }
        }
    }
    // Floats: f32, f64
    if b0 == 102 && (t == "f32" || (n == 3 && t.byte_at(1) == 54 && t.byte_at(2) == 52)) { return true; }
    // Booleans: "b" + "ool"
    if n == 4 && b0 == 98 && t.slice(1, 4) == "ool" { return true; }
    return false;
}

// ------------------------------------------------------------------------------
// 4. Tokenizer & String Parsing Helpers
// ------------------------------------------------------------------------------

pub pure fn rust_is_space(b: i64) -> bool => b == 32 || b == 9 || b == 10 || b == 13;

pub pure fn rust_is_ident_start(b: i64) -> bool => (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;

pub pure fn rust_is_ident_char(b: i64) -> bool => rust_is_ident_start(b) || (b >= 48 && b <= 57);

pub pure fn rust_skip_ws(src: str, start: usize) -> usize {
    let n = src.len();
    var cur = start;
    while cur < n {
        let b = src.byte_at(cur);
        if rust_is_space(b) {
            cur = cur + 1;
        } else if b == 47 && cur + 1 < n && src.byte_at(cur + 1) == 47 { // // line comment
            cur = cur + 2;
            while cur < n && src.byte_at(cur) != 10 { cur = cur + 1; }
        } else if b == 47 && cur + 1 < n && src.byte_at(cur + 1) == 42 { // /* block comment */
            cur = cur + 2;
            while cur + 1 < n && !(src.byte_at(cur) == 42 && src.byte_at(cur + 1) == 47) {
                cur = cur + 1;
            }
            if cur + 1 < n { cur = cur + 2; }
        } else {
            break;
        }
    }
    return cur;
}

pub pure fn rust_read_ident(src: str, start: usize) -> str {
    let n = src.len();
    var cur = start;
    if cur < n && rust_is_ident_start(src.byte_at(cur)) {
        cur = cur + 1;
        while cur < n {
            let b = src.byte_at(cur);
            if rust_is_ident_char(b) {
                cur = cur + 1;
            } else if b == 58 && cur + 1 < n && src.byte_at(cur + 1) == 58 { // '::'
                cur = cur + 2;
            } else {
                break;
            }
        }
        return src.slice(start, cur);
    }
    return "";
}

pub pure fn rust_trim(s: str) -> str {
    let n = s.len();
    var st: usize = 0;
    while st < n && rust_is_space(s.byte_at(st)) { st = st + 1; }
    var en: usize = n;
    while en > st && rust_is_space(s.byte_at(en - 1)) { en = en - 1; }
    if en > st { return s.slice(st, en); }
    return "";
}

// ------------------------------------------------------------------------------
// 5. Rust Public Item Parser
// ------------------------------------------------------------------------------

pub fn rust_parse_source(src: str, diags: var ref<List<Diagnostic>>) -> RustModuleDecl {
    var module = rust_module_decl_new("rust_crate");
    if src.len() == 0 {
        var d = Diagnostic {
            code:     rust_diag_code(RustDiagnosticKind::CargoResolveError),
            severity: 1,
            message:  "Empty Rust source provided to parser",
            labels:   [],
            notes:    [],
            fixes:    [],
        };
        diags.push(d);
        return module;
    }
    let n = src.len();
    var pos: usize = 0;
    var is_repr_c = false;

    while pos < n {
        pos = rust_skip_ws(src, pos);
        if pos >= n { break; }

        // Outer attribute: #[repr(C)]
        if src.byte_at(pos) == 35 && pos + 1 < n && src.byte_at(pos + 1) == 91 { // #[
            var a_end = pos + 2;
            while a_end < n && src.byte_at(a_end) != 93 { a_end = a_end + 1; }
            let attr = src.slice(pos + 2, a_end);
            if attr.find("repr(C)") >= 0 {
                is_repr_c = true;
            }
            pos = if a_end < n { a_end + 1 } else { n };
            continue;
        }

        let word = rust_read_ident(src, pos);
        if word == "pub" {
            pos = rust_skip_ws(src, pos + 3);
            let next_word = rust_read_ident(src, pos);

            // pub struct StructName { ... }
            if next_word == "struct" {
                pos = rust_skip_ws(src, pos + 6);
                let s_name = rust_read_ident(src, pos);
                pos = rust_skip_ws(src, pos + s_name.len());

                var fields: List<RustFieldDecl> = [];
                if pos < n && src.byte_at(pos) == 123 { // '{'
                    pos = pos + 1;
                    var offset: usize = 0;
                    while pos < n && src.byte_at(pos) != 125 {
                        let prev_pos = pos;
                        pos = rust_skip_ws(src, pos);
                        if pos >= n || src.byte_at(pos) == 125 { break; }

                        var f_pub = false;
                        let fw = rust_read_ident(src, pos);
                        if fw == "pub" {
                            f_pub = true;
                            pos = rust_skip_ws(src, pos + 3);
                        }

                        let f_name = rust_read_ident(src, pos);
                        pos = rust_skip_ws(src, pos + f_name.len());

                        if pos < n && src.byte_at(pos) == 58 { // ':'
                            pos = rust_skip_ws(src, pos + 1);
                            var t_end = pos;
                            while t_end < n && src.byte_at(t_end) != 44 && src.byte_at(t_end) != 125 && src.byte_at(t_end) != 10 {
                                t_end = t_end + 1;
                            }
                            let ty_str = rust_trim(src.slice(pos, t_end));
                            let ty_kind = rust_type_classify(ty_str);
                            let f_size: usize = if ty_kind == RustTypeKind::SliceRef || ty_kind == RustTypeKind::SliceMut || ty_kind == RustTypeKind::StrRef || ty_kind == RustTypeKind::DynTrait { 16 } else if ty_kind == RustTypeKind::Vec || ty_kind == RustTypeKind::String { 24 } else { 8 };

                            fields.push(RustFieldDecl {
                                name:        f_name,
                                type_name:   ty_str,
                                type_kind:   ty_kind,
                                is_pub:      f_pub,
                                byte_offset: offset,
                                byte_size:   f_size,
                            });
                            offset = offset + f_size;
                            pos = t_end;
                            if pos < n && src.byte_at(pos) == 44 { pos = pos + 1; }
                        }
                        if pos <= prev_pos {
                            pos = prev_pos + 1;
                        }
                    }
                    if pos < n && src.byte_at(pos) == 125 { pos = pos + 1; }
                } else if pos < n && src.byte_at(pos) == 59 { // unit struct
                    pos = pos + 1;
                }

                module.structs.push(RustStructDecl {
                    name:      s_name,
                    is_pub:    true,
                    is_repr_c: is_repr_c,
                    fields:    fields,
                });
                is_repr_c = false;
                continue;
            }

            // pub enum EnumName { ... }
            if next_word == "enum" {
                pos = rust_skip_ws(src, pos + 4);
                let e_name = rust_read_ident(src, pos);
                pos = rust_skip_ws(src, pos + e_name.len());

                var variants: List<RustEnumVariant> = [];
                if pos < n && src.byte_at(pos) == 123 { // '{'
                    pos = pos + 1;
                    var tag_counter: i64 = 0;
                    while pos < n && src.byte_at(pos) != 125 {
                        let prev_pos = pos;
                        pos = rust_skip_ws(src, pos);
                        if pos >= n || src.byte_at(pos) == 125 { break; }

                        let v_name = rust_read_ident(src, pos);
                        pos = rust_skip_ws(src, pos + v_name.len());

                        var has_p = false;
                        var p_ty = "";
                        if pos < n && src.byte_at(pos) == 40 { // '(' tuple variant
                            pos = pos + 1;
                            var p_end = pos;
                            while p_end < n && src.byte_at(p_end) != 41 { p_end = p_end + 1; }
                            p_ty = rust_trim(src.slice(pos, p_end));
                            has_p = true;
                            pos = if p_end < n { p_end + 1 } else { n };
                        }

                        var tag_val = tag_counter;
                        pos = rust_skip_ws(src, pos);
                        if pos < n && src.byte_at(pos) == 61 { // '='
                            pos = rust_skip_ws(src, pos + 1);
                            var v_end = pos;
                            while v_end < n && src.byte_at(v_end) != 44 && src.byte_at(v_end) != 125 && src.byte_at(v_end) != 10 {
                                v_end = v_end + 1;
                            }
                            let num_str = rust_trim(src.slice(pos, v_end));
                            tag_val = if num_str.len() > 0 { num_str.parse_i64() } else { tag_counter };
                            tag_counter = tag_val;
                            pos = v_end;
                        }

                        variants.push(RustEnumVariant {
                            name:         v_name,
                            tag_value:    tag_val,
                            has_payload:  has_p,
                            payload_type: p_ty,
                        });
                        tag_counter = tag_counter + 1;
                        if pos < n && src.byte_at(pos) == 44 { pos = pos + 1; }
                        if pos <= prev_pos {
                            pos = prev_pos + 1;
                        }
                    }
                    if pos < n && src.byte_at(pos) == 125 { pos = pos + 1; }
                }

                module.enums.push(RustEnumDecl {
                    name:      e_name,
                    is_pub:    true,
                    is_repr_c: is_repr_c,
                    variants:  variants,
                });
                is_repr_c = false;
                continue;
            }

            // pub trait TraitName { ... }
            if next_word == "trait" {
                pos = rust_skip_ws(src, pos + 5);
                let tr_name = rust_read_ident(src, pos);
                pos = rust_skip_ws(src, pos + tr_name.len());

                var methods: List<RustFnDecl> = [];
                if pos < n && src.byte_at(pos) == 123 { // '{'
                    pos = pos + 1;
                    while pos < n && src.byte_at(pos) != 125 {
                        let prev_pos = pos;
                        pos = rust_skip_ws(src, pos);
                        if pos >= n || src.byte_at(pos) == 125 { break; }
                        let mw = rust_read_ident(src, pos);
                        if mw == "fn" {
                            pos = rust_skip_ws(src, pos + 2);
                            let m_name = rust_read_ident(src, pos);
                            pos = rust_skip_ws(src, pos + m_name.len());

                            var params: List<RustParamDecl> = [];
                            if pos < n && src.byte_at(pos) == 40 { // '('
                                pos = pos + 1;
                                while pos < n && src.byte_at(pos) != 41 {
                                    pos = rust_skip_ws(src, pos);
                                    if pos >= n || src.byte_at(pos) == 41 { break; }
                                    var p_end = pos;
                                    while p_end < n && src.byte_at(p_end) != 44 && src.byte_at(p_end) != 41 { p_end = p_end + 1; }
                                    let p_raw = rust_trim(src.slice(pos, p_end));
                                    let is_ref = p_raw.find("&") >= 0;
                                    let is_mut = p_raw.find("mut") >= 0;
                                    let p_kind = rust_type_classify(p_raw);
                                    params.push(RustParamDecl {
                                        name:      "self",
                                        type_name: p_raw,
                                        type_kind: p_kind,
                                        is_ref:    is_ref,
                                        is_mut:    is_mut,
                                    });
                                    pos = p_end;
                                    if pos < n && src.byte_at(pos) == 44 { pos = pos + 1; }
                                }
                                if pos < n && src.byte_at(pos) == 41 { pos = pos + 1; }
                            }

                            var ret_ty = "()";
                            pos = rust_skip_ws(src, pos);
                            if pos + 1 < n && src.byte_at(pos) == 45 && src.byte_at(pos + 1) == 62 { // '->'
                                pos = rust_skip_ws(src, pos + 2);
                                var r_end = pos;
                                while r_end < n && src.byte_at(r_end) != 59 && src.byte_at(r_end) != 123 { r_end = r_end + 1; }
                                ret_ty = rust_trim(src.slice(pos, r_end));
                                pos = r_end;
                            }
                            if pos < n && src.byte_at(pos) == 59 { pos = pos + 1; }

                            methods.push(RustFnDecl {
                                name:        m_name,
                                return_type: ret_ty,
                                ret_kind:    rust_type_classify(ret_ty),
                                is_pub:      true,
                                is_unsafe:   false,
                                is_extern_c: false,
                                params:      params,
                            });
                        } else {
                            pos = pos + 1;
                        }
                        if pos <= prev_pos {
                            pos = prev_pos + 1;
                        }
                    }
                    if pos < n && src.byte_at(pos) == 125 { pos = pos + 1; }
                }

                module.traits.push(RustTraitDecl {
                    name:    tr_name,
                    is_pub:  true,
                    methods: methods,
                });
                continue;
            }

            // pub [unsafe] [extern "C"] fn fn_name(...) -> RetTy { ... }
            var is_unsafe = false;
            var is_ext_c = false;
            var cur_w = next_word;
            if cur_w == "unsafe" {
                is_unsafe = true;
                pos = rust_skip_ws(src, pos + 6);
                cur_w = rust_read_ident(src, pos);
            }
            if cur_w == "extern" {
                pos = rust_skip_ws(src, pos + 6);
                if pos < n && src.byte_at(pos) == 34 { // "C"
                    pos = pos + 1;
                    while pos < n && src.byte_at(pos) != 34 { pos = pos + 1; }
                    if pos < n { pos = pos + 1; }
                    is_ext_c = true;
                }
                pos = rust_skip_ws(src, pos);
                cur_w = rust_read_ident(src, pos);
            }

            if cur_w == "fn" {
                pos = rust_skip_ws(src, pos + 2);
                let fn_name = rust_read_ident(src, pos);
                pos = rust_skip_ws(src, pos + fn_name.len());

                // Skip generics <'a, T>
                if pos < n && src.byte_at(pos) == 60 { // '<'
                    var g_depth = 1;
                    pos = pos + 1;
                    while pos < n && g_depth > 0 {
                        if src.byte_at(pos) == 60 { g_depth = g_depth + 1; }
                        else if src.byte_at(pos) == 62 { g_depth = g_depth - 1; }
                        pos = pos + 1;
                    }
                    pos = rust_skip_ws(src, pos);
                }

                var params: List<RustParamDecl> = [];
                if pos < n && src.byte_at(pos) == 40 { // '('
                    pos = pos + 1;
                    while pos < n && src.byte_at(pos) != 41 {
                        pos = rust_skip_ws(src, pos);
                        if pos >= n || src.byte_at(pos) == 41 { break; }

                        let p_name = rust_read_ident(src, pos);
                        pos = rust_skip_ws(src, pos + p_name.len());

                        if pos < n && src.byte_at(pos) == 58 { // ':'
                            pos = rust_skip_ws(src, pos + 1);
                            var p_depth = 0;
                            var p_end = pos;
                            while p_end < n {
                                let pb = src.byte_at(p_end);
                                if pb == 60 || pb == 40 || pb == 91 { p_depth = p_depth + 1; }
                                else if pb == 62 || pb == 41 || pb == 93 {
                                    if p_depth > 0 { p_depth = p_depth - 1; }
                                    else if pb == 41 { break; }
                                } else if pb == 44 && p_depth == 0 {
                                    break;
                                }
                                p_end = p_end + 1;
                            }
                            let ty_str = rust_trim(src.slice(pos, p_end));
                            let is_ref = ty_str.find("&") >= 0;
                            let is_mut = ty_str.find("mut") >= 0;
                            let ty_kind = rust_type_classify(ty_str);

                            params.push(RustParamDecl {
                                name:      p_name,
                                type_name: ty_str,
                                type_kind: ty_kind,
                                is_ref:    is_ref,
                                is_mut:    is_mut,
                            });
                            pos = p_end;
                            if pos < n && src.byte_at(pos) == 44 { pos = pos + 1; }
                        } else {
                            pos = pos + 1;
                        }
                    }
                    if pos < n && src.byte_at(pos) == 41 { pos = pos + 1; }
                }

                var ret_type = "()";
                pos = rust_skip_ws(src, pos);
                if pos + 1 < n && src.byte_at(pos) == 45 && src.byte_at(pos + 1) == 62 { // '->'
                    pos = rust_skip_ws(src, pos + 2);
                    var r_depth = 0;
                    var r_end = pos;
                    while r_end < n {
                        let rb = src.byte_at(r_end);
                        if rb == 60 || rb == 40 || rb == 123 {
                            if rb == 123 && r_depth == 0 { break; }
                            r_depth = r_depth + 1;
                        } else if rb == 62 || rb == 41 || rb == 125 {
                            if r_depth > 0 { r_depth = r_depth - 1; }
                        } else if (rb == 59 || rb == 123) && r_depth == 0 {
                            break;
                        }
                        r_end = r_end + 1;
                    }
                    ret_type = rust_trim(src.slice(pos, r_end));
                    pos = r_end;
                }

                // Skip body if '{'
                if pos < n && src.byte_at(pos) == 123 {
                    var b_depth = 1;
                    pos = pos + 1;
                    while pos < n && b_depth > 0 {
                        let bb = src.byte_at(pos);
                        if bb == 123 { b_depth = b_depth + 1; }
                        else if bb == 125 { b_depth = b_depth - 1; }
                        pos = pos + 1;
                    }
                } else if pos < n && src.byte_at(pos) == 59 {
                    pos = pos + 1;
                }

                module.functions.push(RustFnDecl {
                    name:        fn_name,
                    return_type: ret_type,
                    ret_kind:    rust_type_classify(ret_type),
                    is_pub:      true,
                    is_unsafe:   is_unsafe,
                    is_extern_c: is_ext_c,
                    params:      params,
                });
                continue;
            }
        }

        // Advance to avoid infinite loop
        pos = pos + 1;
    }

    return module;
}

// ------------------------------------------------------------------------------
// 6. Cargo Manifest (Cargo.toml) Parser
// ------------------------------------------------------------------------------

pub fn cargo_parse_manifest(toml_src: str) -> CargoMetadata {
    var meta = cargo_metadata_new();
    let n = toml_src.len();
    var pos: usize = 0;
    var current_section = "";

    while pos < n {
        var line_end = pos;
        while line_end < n && toml_src.byte_at(line_end) != 10 {
            line_end = line_end + 1;
        }
        let line = rust_trim(toml_src.slice(pos, line_end));
        pos = line_end + 1;

        if line.len() == 0 || line.byte_at(0) == 35 { // '#' comment
            continue;
        }

        // Section header [section]
        if line.byte_at(0) == 91 && line.byte_at(line.len() - 1) == 93 { // [ ... ]
            current_section = line.slice(1, line.len() - 1);
            continue;
        }

        let eq_idx = line.find("=");
        if eq_idx > 0 {
            let key = rust_trim(line.slice(0, eq_idx as usize));
            var val = rust_trim(line.slice((eq_idx + 1) as usize, line.len()));
            // Strip quotes
            if val.len() >= 2 && val.byte_at(0) == 34 && val.byte_at(val.len() - 1) == 34 {
                val = val.slice(1, val.len() - 1);
            }

            if current_section == "package" {
                if key == "name" { meta.name = val; }
                else if key == "version" { meta.version = val; }
                else if key == "edition" { meta.edition = val; }
            } else if current_section == "lib" {
                if key == "crate-type" { meta.lib_crate_type = val; }
            } else if current_section == "dependencies" {
                meta.dependencies[key] = val;
            }
        }
    }

    return meta;
}
