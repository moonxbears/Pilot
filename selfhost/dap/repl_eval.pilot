// =========================================================================
// FILE: selfhost/dap/repl_eval.pilot
// Milestone 59.3: On-the-Fly Debug Console REPL Expression Evaluator
// Evaluates watch expressions against active PilVM register environment map.
// =========================================================================
pub pkg Pilot.SelfHost.Dap.ReplEval;

pub pure fn nameof(sym: str) -> str => sym;

pub enum ReplTokenType {
    Number,
    Ident,
    Op,
    OpenParen,
    CloseParen,
}

fn repl_is_ident_char(b: i64) -> bool {
    return (b >= 97 && b <= 122) || (b >= 65 && b <= 90) || (b >= 48 && b <= 57) || b == 95;
}

fn repl_apply_op(op_b: i64, lhs: i64, rhs: i64) -> i64 {
    if op_b == 43 { return lhs + rhs; }
    if op_b == 45 { return lhs - rhs; }
    if op_b == 42 { return lhs * rhs; }
    if op_b == 47 { return if rhs != 0 { lhs / rhs } else { 0 }; }
    if op_b == 37 { return if rhs != 0 { lhs % rhs } else { 0 }; }
    return lhs;
}

fn repl_prec(op_b: i64) -> i64 {
    if op_b == 42 || op_b == 47 || op_b == 37 {
        return 2;
    }
    if op_b == 43 || op_b == 45 {
        return 1;
    }
    return 0;
}

pub fn eval_dap_watch_expr(env_map: i64, expr_src: str) -> i64 {
    let n = expr_src.len();
    let st = __engine("map_new");
    var v_top = 0;
    var o_top = 0;
    var i = 0;
    while i < n {
        let b = expr_src.byte_at(i);
        if b == 32 || b == 9 || b == 13 || b == 10 {
            i = i + 1;
        } else if b >= 48 && b <= 57 {
            var num = 0;
            while i < n {
                let db = expr_src.byte_at(i);
                if db >= 48 && db <= 57 {
                    num = num * 10 + (db - 48);
                    i = i + 1;
                } else {
                    break;
                }
            }
            let _sv = __engine("map_set", st, "v" + v_top, num);
            v_top = v_top + 1;
        } else if repl_is_ident_char(b) {
            let start = i;
            while i < n && repl_is_ident_char(expr_src.byte_at(i)) {
                i = i + 1;
            }
            let ident = expr_src.slice(start, i);
            let raw_val = __engine("map_get", env_map, ident);
            let val = if raw_val != none { raw_val } else { 0 };
            let _sv = __engine("map_set", st, "v" + v_top, val);
            v_top = v_top + 1;
        } else if b == 40 {
            let _so = __engine("map_set", st, "o" + o_top, 40);
            o_top = o_top + 1;
            i = i + 1;
        } else if b == 41 {
            while o_top > 0 {
                let top_op = __engine("map_get", st, "o" + (o_top - 1));
                if top_op == 40 {
                    o_top = o_top - 1;
                    break;
                }
                o_top = o_top - 1;
                let rhs = __engine("map_get", st, "v" + (v_top - 1));
                let lhs = __engine("map_get", st, "v" + (v_top - 2));
                v_top = v_top - 2;
                let res = repl_apply_op(top_op, lhs, rhs);
                let _sv = __engine("map_set", st, "v" + v_top, res);
                v_top = v_top + 1;
            }
            i = i + 1;
        } else if b == 43 || b == 45 || b == 42 || b == 47 || b == 37 {
            let cur_p = repl_prec(b);
            while o_top > 0 {
                let top_op = __engine("map_get", st, "o" + (o_top - 1));
                if top_op != 40 && repl_prec(top_op) >= cur_p && v_top >= 2 {
                    o_top = o_top - 1;
                    let rhs = __engine("map_get", st, "v" + (v_top - 1));
                    let lhs = __engine("map_get", st, "v" + (v_top - 2));
                    v_top = v_top - 2;
                    let res = repl_apply_op(top_op, lhs, rhs);
                    let _sv = __engine("map_set", st, "v" + v_top, res);
                    v_top = v_top + 1;
                } else {
                    break;
                }
            }
            let _so = __engine("map_set", st, "o" + o_top, b);
            o_top = o_top + 1;
            i = i + 1;
        } else {
            i = i + 1;
        }
    }
    while o_top > 0 && v_top >= 2 {
        let top_op = __engine("map_get", st, "o" + (o_top - 1));
        o_top = o_top - 1;
        if top_op != 40 {
            let rhs = __engine("map_get", st, "v" + (v_top - 1));
            let lhs = __engine("map_get", st, "v" + (v_top - 2));
            v_top = v_top - 2;
            let res = repl_apply_op(top_op, lhs, rhs);
            let _sv = __engine("map_set", st, "v" + v_top, res);
            v_top = v_top + 1;
        }
    }
    if v_top > 0 {
        return __engine("map_get", st, "v" + (v_top - 1));
    }
    return 0;
}

pub fn format_dap_evaluate_response(seq: i64, result_repr: str) -> str {
    return "{\"seq\":" + seq + ",\"type\":\"response\",\"request_seq\":" + seq + ",\"success\":true,\"command\":\"evaluate\",\"body\":{\"result\":\"" + result_repr + "\",\"variablesReference\":0}}";
}
