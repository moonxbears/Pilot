// =========================================================================
// FILE: selfhost/dap/vm_controller.pilot
// Milestone 59.3: VmHook Breakpoint & Step State Machine over pc_spans
// Steps real PilVirtualMachine bytecode without a duplicate AST interpreter.
// =========================================================================
pub pkg Pilot.SelfHost.Dap.VmController;

pub pure fn nameof(sym: str) -> str => sym;

pub enum StepMode {
    Continue = 0,
    StepIn = 1,
    StepOver = 2,
    StepOut = 3,
}

// Step mode constants: 0 = Continue, 1 = StepIn, 2 = StepOver, 3 = StepOut
pub fn should_pause_at_pc(
    step_mode: i64,
    cur_line: i64,
    last_stopped_line: i64,
    breakpoint_line: i64,
    cur_call_depth: i64,
    target_call_depth: i64
) -> i64 {
    if cur_line <= 1 {
        return 0;
    }

    let raw_val = __engine("map_get", __engine("get_env"), "call_line");
    let call_line = if raw_val != none { raw_val } else { -1 };

    if cur_line == breakpoint_line && cur_line != last_stopped_line {
        let _new = __engine("map_new");
        let _s = __engine("map_set", __engine("get_env"), "call_line", cur_line);
        return 1;
    }
    if step_mode == 1 {
        // StepIn: pause at the first statement inside callee (new line and not the call site)
        if cur_line != last_stopped_line && cur_line != call_line {
            return 1;
        }
    }
    if step_mode == 2 {
        // StepOver: pause when back at target_call_depth or lower, on a new statement
        if cur_call_depth <= target_call_depth && cur_line != last_stopped_line && cur_line != call_line {
            let _s = __engine("map_set", __engine("get_env"), "call_line", cur_line);
            return 1;
        }
    }
    if step_mode == 3 {
        // StepOut: pause when popped to a shallower call depth, on the statement following the call
        if cur_call_depth < target_call_depth && cur_line != last_stopped_line && cur_line != call_line {
            let _s = __engine("map_set", __engine("get_env"), "call_line", cur_line);
            return 1;
        }
    }
    return 0;
}
