// ==============================================================================
// FILE: selfhost/attr_weaver.pilot
// 100% Pilot-Hosted Weight-Sorted Compile-Time Attribute Weaver
// Table-Driven Open-Registry Architecture (Milestone 21):
// Replaces closed if/else chains and O(N^2) scans with O(1) WeaverProtocolRegistry
// indexed by base IAttribute sub-interfaces + deterministic (weight DESC, idx ASC)
// topological attribute scheduler.
// ==============================================================================

pub pkg Pilot.SelfHost.AttrWeaver;

extern fn __engine(operation: string, ...args: i64) -> i64;

let WeaverHooks = {
    ast_node_count: "ast_node_count",
    ast_node_kind: "ast_node_kind",
    ast_orig_kind: "ast_orig_kind",
    ast_node_sym: "ast_node_sym",
    ast_attr_decl_count: "ast_attr_decl_count",
    ast_attr_name: "ast_attr_name",
    ast_attr_decl_arg_count: "ast_attr_decl_arg_count",
    ast_attr_decl_arg: "ast_attr_decl_arg",
    ast_base_count: "ast_base_count",
    ast_base_at: "ast_base_at",
    ast_emit_diag: "ast_emit_diag",
    sym_str: "sym_str",
    str_len: "str_len",
    str_byte_at: "str_byte_at",
};

// Protocol Pillar IDs matching stdlib/core/meta.pilot:
//   0 = Metadata / Layout (IAttribute)
//   1 = Structural Type Weaver (ITypeWeaverAttribute)
//   2 = Function AOP Interceptor (IInterceptor)
//   3 = Structural Field Weaver (IFieldWeaverAttribute)
//   4 = Computed Formula Getter (IFormulaAttribute)
//   5 = Reactive Setter Validator (IReactiveAttribute)
//   6 = Hierarchical Interface Inherited (IInheritedAttribute)
//   7 = Declarative ECS Archetype Rule (IEcsRule)
//   8 = Metaprogramming Patch (IPatchAttribute)

pub struct ProtocolRegistryEntry : IValue {
    pub name: str;
    pub protocol_id: i64;
}

pub struct DeclIndexEntry : IValue {
    pub name: str;
    pub node_id: i64;
}

pub struct ArenaDeclIndex : IObject {
    pub entries: List<DeclIndexEntry>;

    pub static fn build(node_count: i64) -> ArenaDeclIndex {
        var idx = ArenaDeclIndex { entries: [] };
        var i = 0;
        while i < node_count {
            let k = __engine(WeaverHooks.ast_node_kind, i);
            if k == 1 || k == 2 {
                let s = __engine(WeaverHooks.ast_node_sym, i);
                let nm = __engine(WeaverHooks.sym_str, s);
                let entry = DeclIndexEntry { name: nm, node_id: i };
                idx.entries.push(entry);
            }
            i = i + 1;
        }
        return idx;
    }

    pub fn find(ref self, name: str) -> i64 {
        let suffixed = name + "Attr";
        var i = 0;
        let n = self.entries.len();
        while i < n {
            let e = self.entries.get(i);
            if e.name == name || e.name == suffixed {
                return e.node_id;
            }
            i = i + 1;
        }
        return -1;
    }
}

pub struct WeaverProtocolRegistry : IObject {
    pub entries: List<ProtocolRegistryEntry>;

    pub static fn create() -> WeaverProtocolRegistry {
        var reg = WeaverProtocolRegistry { entries: [] };

        // The pillar interfaces. An attribute's pillar is never registered by
        // its name: it is derived from the interfaces its `...Attr`
        // declaration implements (see `classify_attribute`).
        reg.register("ITypeWeaverAttribute", 1);
        reg.register("IInterceptor", 2);
        reg.register("IFieldWeaverAttribute", 3);
        reg.register("IFormulaAttribute", 4);
        reg.register("IReactiveAttribute", 5);
        reg.register("IInheritedAttribute", 6);
        reg.register("IEcsRule", 7);
        reg.register("IPatchAttribute", 8);

        return reg;
    }

    pub fn register(var ref self, name: str, protocol_id: i64) {
        let entry = ProtocolRegistryEntry { name: name, protocol_id: protocol_id };
        self.entries.push(entry);
    }

    pub fn lookup(ref self, name: str) -> i64 {
        var i = 0;
        let n = self.entries.len();
        while i < n {
            let entry = self.entries.get(i);
            if entry.name == name {
                return entry.protocol_id;
            }
            i = i + 1;
        }
        return 0;
    }

    /// The pillar of `[attr_name]`, derived from the interfaces its
    /// `<attr_name>` / `<attr_name>Attr` struct declaration implements,
    /// following interface bases transitively. -1 when the declaration is not
    /// in the arena: an undeclared attribute has no pillar to check.
    pub fn classify_attribute(ref self, attr_name: str, node_count: i64) -> i64 {
        let decl_nid = find_attr_struct_node(attr_name, node_count);
        if decl_nid < 0 {
            return -1;
        }
        return self.pillar_of_bases(decl_nid, node_count, 0);
    }

    /// The first pillar reached through the bases of `decl_nid`, or 0 (plain
    /// metadata) when none of them leads to a pillar interface.
    pub fn pillar_of_bases(ref self, decl_nid: i64, node_count: i64, depth: i64) -> i64 {
        if depth > node_count {
            return 0;
        }
        let bc = __engine(WeaverHooks.ast_base_count, decl_nid);
        var bi = 0;
        while bi < bc {
            let bsym = __engine(WeaverHooks.ast_base_at, decl_nid, bi);
            let bname = __engine(WeaverHooks.sym_str, bsym);
            let pid = self.lookup(bname);
            if pid > 0 {
                return pid;
            }
            let iface_nid = find_interface_node(bname, node_count);
            if iface_nid >= 0 && iface_nid != decl_nid {
                let inherited = self.pillar_of_bases(iface_nid, node_count, depth + 1);
                if inherited > 0 {
                    return inherited;
                }
            }
            bi = bi + 1;
        }
        return 0;
    }
}

/// The interface declaration named `name`, or -1.
pub fn find_interface_node(name: str, node_count: i64) -> i64 {
    var i = 0;
    while i < node_count {
        if __engine(WeaverHooks.ast_node_kind, i) == 2 {
            let nm = __engine(WeaverHooks.sym_str, __engine(WeaverHooks.ast_node_sym, i));
            if nm == name {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

pub fn find_attr_struct_node(attr_name: str, node_count: i64) -> i64 {
    let suffixed = attr_name + "Attr";
    var i = 0;
    while i < node_count {
        if __engine(WeaverHooks.ast_node_kind, i) == 1 {
            let s = __engine(WeaverHooks.ast_node_sym, i);
            let nm = __engine(WeaverHooks.sym_str, s);
            if nm == attr_name || nm == suffixed {
                return i;
            }
        }
        i = i + 1;
    }
    return -1;
}

pub fn classify_attr_pillar(attr_name: str, node_count: i64) -> i64 {
    var reg = WeaverProtocolRegistry.create();
    return reg.classify_attribute(attr_name, node_count);
}

pub fn extract_attr_weight(nid: i64, attr_idx: i64) -> i64 {
    let argc = __engine(WeaverHooks.ast_attr_decl_arg_count, nid, attr_idx);
    if argc <= 0 {
        return 10;
    }
    let last_val = __engine(WeaverHooks.ast_attr_decl_arg, nid, attr_idx, argc - 1);
    return last_val;
}

// Returns packed top-weighted attribute index for deterministic weaving
pub fn highest_weight_attr_index(nid: i64) -> i64 {
    let ac = __engine(WeaverHooks.ast_attr_decl_count, nid);
    if ac <= 0 {
        return -1;
    }
    var best_idx = 0;
    var best_weight = extract_attr_weight(nid, 0);
    var k = 1;
    while k < ac {
        let w = extract_attr_weight(nid, k);
        if w > best_weight {
            best_weight = w;
            best_idx = k;
        }
        k = k + 1;
    }
    return best_idx;
}

// Returns comma-separated attribute names attached to nid sorted in strictly descending
// order of weight: i32 (default 10 if 0 args), preserving original attachment order on ties (idx ASC).
pub fn weave_sorted_attr_names(nid: i64) -> str {
    let ac = __engine(WeaverHooks.ast_attr_decl_count, nid);
    if ac <= 0 {
        return "";
    }
    var out = "";
    var step = 0;
    var has_prev = false;
    var prev_w = 0;
    var prev_idx = -1;
    while step < ac {
        var found = false;
        var best_w = 0;
        var best_idx = -1;
        var k = 0;
        while k < ac {
            let w = extract_attr_weight(nid, k);
            var eligible = true;
            if has_prev {
                eligible = (w < prev_w) || (w == prev_w && k > prev_idx);
            }
            if eligible {
                if !found || (w > best_w) || (w == best_w && k < best_idx) {
                    found = true;
                    best_w = w;
                    best_idx = k;
                }
            }
            k = k + 1;
        }
        if found {
            let asym = __engine(WeaverHooks.ast_attr_name, nid, best_idx);
            let aname = __engine(WeaverHooks.sym_str, asym);
            if step > 0 {
                out = out + "," + aname;
            } else {
                out = aname;
            }
            has_prev = true;
            prev_w = best_w;
            prev_idx = best_idx;
        }
        step = step + 1;
    }
    return out;
}

// Validates and weaves attributes on nid; returns 1 if nid carries an ECS IEcsRule (Pillar 7)
pub fn weave_node_attributes(nid: i64, node_count: i64) -> i64 {
    let ac = __engine(WeaverHooks.ast_attr_decl_count, nid);
    if ac <= 0 {
        return 0;
    }
    let kind = __engine(WeaverHooks.ast_node_kind, nid);
    var ecs_count = 0;
    var idx = 0;
    while idx < ac {
        let asym = __engine(WeaverHooks.ast_attr_name, nid, idx);
        let aname = __engine(WeaverHooks.sym_str, asym);
        let pillar = classify_attr_pillar(aname, node_count);

        if pillar == 7 {
            ecs_count = ecs_count + 1;
        }

        // Pillar 4 & 5 (IFormulaAttribute, IReactiveAttribute) require backing storage
        if kind == 2 {
            if pillar == 4 || pillar == 5 {
                let msg = "ATTR001: Reactive or formula attribute '[" + aname
                    + "]' cannot be attached to a 0-byte interface declaration";
                __engine(WeaverHooks.ast_emit_diag, nid, 1, msg);
            }
        }

        // Pillar 2 (IInterceptor) targets callable FnDecl (kind == 3) or StructDecl/InterfaceDecl
        if kind == 4 || kind == 21 {
            if pillar == 2 {
                let fmsg = "ATTR002: Function interceptor attribute '[" + aname
                    + "]' cannot be attached to a non-callable field or binding";
                __engine(WeaverHooks.ast_emit_diag, nid, 1, fmsg);
            }
        }

        idx = idx + 1;
    }
    return ecs_count;
}

// Entry point: scans entire RawAstArena, validates attribute pillars, sorts weights, and returns total ECS rules woven
pub fn weave_unit_attributes() -> i64 {
    let node_count = __engine(WeaverHooks.ast_node_count);
    var total_ecs_rules = 0;
    var nid = 0;
    while nid < node_count {
        total_ecs_rules = total_ecs_rules + weave_node_attributes(nid, node_count);
        nid = nid + 1;
    }
    return total_ecs_rules;
}
