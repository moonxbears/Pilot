{
    "name": "pilot-lang",
    "displayName": "Pilot Language Support",
    "description": "Syntax highlighting, semantic analysis, type checking, and Language Server (LSP) integration for the Pilot programming language.",
    "version": "1.1.51",
    "publisher": "pilot-lang",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/moonxbears/Pilot.git",
        "directory": "vscode-pilot"
    },
    "engines": {
        "vscode": "^1.85.0"
    },
    "categories": [
        "Programming Languages",
        "Linters"
    ],
    "activationEvents": [
        "onLanguage:pilot",
        "onDebug",
        "onCommand:pilot.runCurrentFile",
        "onCommand:pilot.debugCurrentFile",
        "onCommand:pilot.createLaunchConfig"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "languages": [
            {
                "id": "pilot",
                "aliases": [
                    "Pilot",
                    "pilot"
                ],
                "extensions": [
                    ".pilot"
                ],
                "configuration": "./language-configuration.json"
            }
        ],
        "grammars": [
            {
                "language": "pilot",
                "scopeName": "source.pilot",
                "path": "./syntaxes/pilot.tmLanguage.json"
            }
        ],
        "snippets": [
            {
                "language": "pilot",
                "path": "./snippets/pilot.json"
            }
        ],
        "commands": [
            {
                "command": "pilot.restartLanguageServer",
                "title": "Pilot: Restart Language Server"
            },
            {
                "command": "pilot.runCurrentFile",
                "title": "Pilot: Run Current File",
                "icon": "$(play)"
            },
            {
                "command": "pilot.debugCurrentFile",
                "title": "Pilot: Debug Current File",
                "icon": "$(debug-alt)"
            },
            {
                "command": "pilot.createLaunchConfig",
                "title": "Pilot: Add Run \u0026 Debug Configurations to launch.json"
            }
        ],
        "menus": {
            "editor/title/run": [
                {
                    "command": "pilot.runCurrentFile",
                    "when": "resourceExtname == .pilot",
                    "group": "navigation@1"
                },
                {
                    "command": "pilot.debugCurrentFile",
                    "when": "resourceExtname == .pilot",
                    "group": "navigation@2"
                }
            ]
        },
        "debuggers": [
            {
                "type": "pilot",
                "label": "Pilot",
                "languages": [
                    "pilot"
                ],
                "configurationAttributes": {
                    "launch": {
                        "required": [
                            "program"
                        ],
                        "properties": {
                            "program": {
                                "type": "string",
                                "description": "Path to the .pilot script to run or debug.",
                                "default": "${file}"
                            },
                            "mode": {
                                "type": "string",
                                "description": "Execution mode: \u0027run\u0027 for standard execution, \u0027debug\u0027 for interactive terminal debugging.",
                                "enum": [
                                    "run",
                                    "debug"
                                ],
                                "default": "run"
                            },
                            "args": {
                                "type": "array",
                                "description": "Command line arguments passed to the script.",
                                "items": {
                                    "type": "string"
                                },
                                "default": []
                            },
                            "pilotPath": {
                                "type": "string",
                                "description": "Path to the pilot executable (default: \u0027pilot\u0027)",
                                "default": "pilot"
                            }
                        }
                    }
                },
                "initialConfigurations": [
                    {
                        "type": "pilot",
                        "request": "launch",
                        "name": "Pilot: Run Current File",
                        "mode": "run",
                        "program": "${file}",
                        "args": []
                    },
                    {
                        "type": "pilot",
                        "request": "launch",
                        "name": "Pilot: Debug Current File",
                        "mode": "debug",
                        "program": "${file}",
                        "args": []
                    }
                ],
                "configurationSnippets": [
                    {
                        "label": "Pilot: Run Current File",
                        "description": "Run the currently open Pilot file",
                        "body": {
                            "type": "pilot",
                            "request": "launch",
                            "name": "Pilot: Run Current File",
                            "mode": "run",
                            "program": "^\"\\${file}\"",
                            "args": []
                        }
                    },
                    {
                        "label": "Pilot: Debug Current File",
                        "description": "Start an interactive debugger session for the current Pilot file",
                        "body": {
                            "type": "pilot",
                            "request": "launch",
                            "name": "Pilot: Debug Current File",
                            "mode": "debug",
                            "program": "^\"\\${file}\"",
                            "args": []
                        }
                    }
                ]
            }
        ],
        "configuration": {
            "title": "Pilot Language",
            "properties": {
                "pilot.languageServer.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional explicit path to pilot-lsp or pilot executable."
                },
                "pilot.compiler.executablePath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional explicit path to the pilot compiler executable."
                },
                "pilot.dap.serverPath": {
                    "type": "string",
                    "default": "",
                    "description": "Optional explicit path to pilot-dap or pilot executable."
                }
            }
        }
    },
    "devDependencies": {
        "@types/node": "^26.6.5",
        "@types/vscode": "^1.85.0",
        "typescript": "^7.0.2"
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p .",
        "watch": "tsc -watch -p .",
        "package": "vsce package"
    }
}