# ==============================================================================
# Concept 05: Algebraic Class Composition (Class Math) & Typestate Classes
# ==============================================================================

println("==================================================");
println(" PILOT SHOWCASE: Class Math & Typestates");
println("==================================================");

# 1. Algebraic Class Composition (Class Math: |, -, &)
println("\n--- 1. Algebraic Class Composition (Class Math) ---");

class IdentityModule {
    let username: str = "captain_eva";
    def verify_token(self) {
        return "TOKEN_VALID_992";
    }
}

class SecurityModule {
    let permissions = [ "read_telemetry", "launch_thrusters" ];
    def check_clearance(self) {
        return "LEVEL_5_CLEAR";
    }
}

class BillingModule {
    let credit_balance: float = 7500.0;
    def deduct_credits(self, amount: float) {
        self.credit_balance = self.credit_balance - amount;
        return self.credit_balance;
    }
}

# Union (|): Combines properties and methods from both classes
class Commander = IdentityModule | SecurityModule;
println("Defined Union: class Commander = IdentityModule | SecurityModule;");

let cmd = Commander();
println("Commander Instance Created:");
println("  Username:        " + cmd.username);
println("  Verify Token:    " + cmd.verify_token());
println("  Permissions:     " + cmd.permissions);
println("  Check Clearance: " + cmd.check_clearance());

# Subtraction (-): Removes specific traits or methods
class GuestUser = IdentityModule - SecurityModule;
println("\nDefined Subtraction: class GuestUser = IdentityModule - SecurityModule;");
let guest = GuestUser();
println("Guest Instance Created: Username=" + guest.username);


# 2. Typestate Classes (Morphing Types & Compile-Time State Machines)
println("\n--- 2. Typestate Classes (Morphing State Machines) ---");

class NetworkSocket {
    state Disconnected {
        def connect(self, host: str, port: int) {
            println("  [TRANSITION] Connecting to " + host + ":" + port + "...");
            self.transition_to("Connected");
            return self;
        }
    }

    state Connected {
        def transmit(self, message: str) {
            println("  [TRANSMIT] Sending encrypted packet: '" + message + "'");
            return "ACK: 200 OK";
        }

        def disconnect(self) {
            println("  [TRANSITION] Closing socket and releasing buffer...");
            self.transition_to("Disconnected");
            return self;
        }
    }
}

let socket = NetworkSocket();
println("Initial socket created. Current State: " + socket.current_state());

# Morph state from Disconnected -> Connected
let active_socket = socket.connect("api.pilot-lang.org", 443);
println("Current State: " + active_socket.current_state());

let reply = active_socket.transmit("GET /telemetry/stream HTTP/1.1");
println("Server Response: " + reply);

# Morph state from Connected -> Disconnected
let idle_socket = active_socket.disconnect();
println("Current State: " + idle_socket.current_state());

println("\n>>> Concept 05 Demonstration Complete! <<<\n");
