{
  "Function Definition": {
    "prefix": "def",
    "body": [
      "def ${1:function_name}(${2:param}: ${3:int}) -> ${4:void} {",
      "\t$0",
      "}"
    ],
    "description": "Define a type-safe Pilot function"
  },
  "Guard Precondition": {
    "prefix": "guard",
    "body": [
      "guard ${1:condition} else {",
      "\treturn ${2:false}",
      "}"
    ],
    "description": "Mandatory early-exit precondition"
  },
  "Guard Let Unwrap": {
    "prefix": "guardlet",
    "body": [
      "guard let ${1:val} = ${2:optional_expr} else {",
      "\treturn ${3:null}",
      "}"
    ],
    "description": "Null-safe unwrap with mandatory early exit"
  },
  "Defer Cleanup": {
    "prefix": "defer",
    "body": [
      "defer {",
      "\t$0",
      "}"
    ],
    "description": "Schedule cleanup at scope/function exit"
  },
  "Hard Real-Time Function": {
    "prefix": "hardrt",
    "body": [
      "@hard_realtime",
      "@wcet(${1:250us})",
      "def ${2:control_step}(${3:cmd}: ${4:int}) -> void {",
      "\tnoalloc {",
      "\t\tfor ${5:i} in 0..${6:64} bounded ${6:64} {",
      "\t\t\t$0",
      "\t\t}",
      "\t}",
      "}"
    ],
    "description": "Deterministic zero-allocation hard real-time routine"
  },
  "Soft Real-Time Deadline": {
    "prefix": "deadline",
    "body": [
      "deadline ${1:10ms} jitter ${2:500us} {",
      "\t$0",
      "} on_missed {",
      "\t${3:handle_missed_deadline()}",
      "}"
    ],
    "description": "Soft real-time deadline block with on_missed handler"
  },
  "Actor Definition": {
    "prefix": "actor",
    "body": [
      "actor ${1:ActorName} {",
      "\tvar ${2:state}: ${3:int} = 0",
      "",
      "\tasync def ${4:handle}(self, ${5:msg}: ${6:str}) -> void {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Concurrent message-driven Actor"
  },
  "Channel Select": {
    "prefix": "select",
    "body": [
      "select {",
      "\tcase ${1:msg} = <-${2:in_ch} {",
      "\t\t$0",
      "\t}",
      "\ttimeout ${3:50ms} {",
      "\t\tpass",
      "\t}",
      "}"
    ],
    "description": "CSP channel multiplexing select block"
  },
  "LINQ Relational Query": {
    "prefix": "from",
    "body": [
      "let ${1:results} = (from ${2:u} in ${3:users} with index(${4:id})",
      "\twhere ${2:u}.${5:active} == True",
      "\torder by ${2:u}.${6:created_at} desc",
      "\tselect ${2:u})"
    ],
    "description": "In-memory or database LINQ relational query"
  },
  "Postgres Upsert": {
    "prefix": "insert",
    "body": [
      "let ${1:id} = insert into ${2:db.users} (${3:name}, ${4:email})",
      "\tvalues (${5:name_val}, ${6:email_val})",
      "\ton conflict (${4:email}) do update set ${3:name} = ${5:name_val}",
      "\treturning id"
    ],
    "description": "Postgres-style INSERT ... ON CONFLICT ... RETURNING"
  },
  "C# Property": {
    "prefix": "property",
    "body": [
      "property ${1:name}: ${2:float} {",
      "\tget {",
      "\t\treturn self._${1:name}",
      "\t}",
      "\tset(v) {",
      "\t\tself._${1:name} = v",
      "\t}",
      "}"
    ],
    "description": "C#-style property with get and set accessors"
  },
  "UDSA Unit of Measure": {
    "prefix": "unit",
    "body": [
      "unit ${1:speed} = ${2:meter} / ${3:second}"
    ],
    "description": "First-class dimensional unit of measure"
  },
  "Closure Arrow": {
    "prefix": "lambda",
    "body": [
      "[${1:capture}](${2:args}) => ${3:expression}"
    ],
    "description": "Modern Pilot closure with captures: [capture](args) => expr"
  },
  "Closure Block": {
    "prefix": "lambdablock",
    "body": [
      "[${1:capture}](${2:args}) => {",
      "\t$0",
      "}"
    ],
    "description": "Modern Pilot closure block with captures: [capture](args) => { ... }"
  },
  "Macro Definition": {
    "prefix": "macro",
    "body": [
      "macro ${1:macro_name}(${2:param}) {",
      "\t$0",
      "}"
    ],
    "description": "Define compile-time macro"
  },
  "Cascade Chaining": {
    "prefix": "cascade",
    "body": [
      "${1:object}..${2:method1}()",
      "\t..let ${3:result} = ${4:method2}()",
      "\t..${5:method3}($3)"
    ],
    "description": "Cascade operator chaining with partial assignment"
  },
  "Nameof Operator": {
    "prefix": "nameof",
    "body": [
      "nameof(${1:symbol})"
    ],
    "description": "Get symbol name as string"
  },
  "Static Method": {
    "prefix": "staticdef",
    "body": [
      "public static def ${1:name}(${2:param}: ${3:int}) -> ${4:void} {",
      "\t$0",
      "}"
    ],
    "description": "Define a static method"
  },
  "Pattern Matching Match": {
    "prefix": "match",
    "body": [
      "match ${1:expr} {",
      "\tcase [${2:first}, ..var ${3:rest}] when ${4:condition} => ${5:/* handle */}",
      "\tcase { ${6:prop}: ${7:val} } => ${8:/* handle */}",
      "\tcase _ => ${9:/* fallback */}",
      "}"
    ],
    "description": "C#-style pattern matching match statement with slice & property patterns"
  },
  "Collection Expression": {
    "prefix": "collexpr",
    "body": [
      "[${1:item1}, ..${2:spread_collection}, ${3:item2}]"
    ],
    "description": "C#-style collection expression with spread element"
  },
  "Conditional Compilation If": {
    "prefix": "#if",
    "body": [
      "#if ${1:DEBUG}",
      "\t$0",
      "#else",
      "\t",
      "#endif"
    ],
    "description": "Conditional compilation block with #if, #else, and #endif"
  },
  "Code Region": {
    "prefix": "#region",
    "body": [
      "#region ${1:RegionName}",
      "$0",
      "#endregion"
    ],
    "description": "Collapsible code region"
  },
  "Define Symbol": {
    "prefix": "#define",
    "body": [
      "#define ${1:SYMBOL}"
    ],
    "description": "Define a conditional compilation symbol"
  },
  "Pragma Warning Disable": {
    "prefix": "#pragma",
    "body": [
      "#pragma warning disable ${1:PILOT101}",
      "$0",
      "#pragma warning restore ${1:PILOT101}"
    ],
    "description": "Suppress and restore compiler diagnostics with #pragma"
  },
  "Python Foreign Import": {
    "prefix": "importpy",
    "body": [
      "from python:${1:math} import ${2:sin, cos}"
    ],
    "description": "Import functions, classes, or modules from Python"
  },
  "C# Foreign Import": {
    "prefix": "importcs",
    "body": [
      "from csharp:${1:System.IO} import ${2:File, Path}"
    ],
    "description": "Import types and namespaces from C# / .NET"
  },
  "Rust Foreign Import": {
    "prefix": "importrs",
    "body": [
      "from rust:\"${1:libcrypto}\" import ${2:sha256_hash}"
    ],
    "description": "Import native symbols from a compiled Rust crate/shared library"
  },
  "Extern FFI Block": {
    "prefix": "extern",
    "body": [
      "extern \"${1|rust,csharp,python,c|}\" ${2|lib,assembly,module|} \"${3:target}\" {",
      "\t${4|fn,def|} ${5:function_name}(${6:param}: ${7:i32}) -> ${8:void};",
      "}"
    ],
    "description": "Declare foreign function interfaces (FFI) and external types"
  },
  "Inline Foreign Block": {
    "prefix": "foreignblock",
    "body": [
      "${1|python,csharp,rust|} {",
      "\t$0",
      "}"
    ],
    "description": "Inline foreign language block (Python, C#, Rust)"
  },
  "Lisp Defmacro Definition": {
    "prefix": "defmacro",
    "body": [
      "defmacro ${1:macro_name}(${2:ast}: AstNode) -> AstNode {",
      "\tlet ${3:tmp} = gensym(\"${4:g}\")",
      "\tquasiquote {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Define a Lisp-style homoiconic compile-time AST macro"
  },
  "Quasiquote Template": {
    "prefix": "quasiquote",
    "body": [
      "quasiquote {",
      "\t$0",
      "}"
    ],
    "description": "Lisp-style quasiquote template with $ unquote and $@ splicing"
  },
  "Root Object to_string": {
    "prefix": "to_string",
    "body": [
      "def to_string(self) -> str {",
      "\treturn $\"${1:ClassName}({$0})\"",
      "}"
    ],
    "description": "Override the root object to_string representation method"
  },
  "Root Object equals": {
    "prefix": "equals",
    "body": [
      "def equals(self, other: any) -> bool {",
      "\tguard let o = other as ${1:Type} else { return false }",
      "\treturn ${2:self.id == o.id}",
      "}"
    ],
    "description": "Override the root object equals comparison method"
  },
  "Root Object hash": {
    "prefix": "hash",
    "body": [
      "def hash(self) -> int {",
      "\treturn ${1:hash(self.id)}",
      "}"
    ],
    "description": "Override the root object hash function method"
  },
  "Root Object clone": {
    "prefix": "clone",
    "body": [
      "def clone(self) -> ${1:Type} {",
      "\treturn ${1:Type}($0)",
      "}"
    ],
    "description": "Override the root object clone copying method"
  },
  "Root Object deconstruct": {
    "prefix": "deconstruct",
    "body": [
      "def deconstruct(self) -> ${1:tuple} {",
      "\treturn ($0)",
      "}"
    ],
    "description": "Override root object pattern matching deconstruction"
  }
}
