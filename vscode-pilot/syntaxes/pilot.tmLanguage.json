{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pilot",
  "scopeName": "source.pilot",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#polyglot-blocks" },
    { "include": "#raw-dsl" },
    { "include": "#strings" },
    { "include": "#raw-idents" },
    { "include": "#attributes" },
    { "include": "#quote-splices" },
    { "include": "#symbols" },
    { "include": "#declarations" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#primitives" },
    { "include": "#call-targets" },
    { "include": "#constants" },
    { "include": "#object-keys" },
    { "include": "#numbers" },
    { "include": "#operators" },
    { "include": "#punctuation" },
    { "include": "#variables" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.documentation.pilot", "match": "///.*$" },
        { "name": "comment.block.documentation.pilot", "begin": "/\\*\\*", "end": "\\*/" },
        { "name": "comment.line.double-slash.pilot", "match": "//.*$" },
        { "name": "comment.block.pilot", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.pilot",
          "match": "^\\s*(#(?:define|undef|if|elif|else|endif|region|endregion|error|warning|pragma|line))\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.pilot" },
            "2": { "name": "string.unquoted.preprocessor.pilot" }
          }
        }
      ]
    },
    "polyglot-blocks": {
      "patterns": [
        {
          "begin": "\\b(python|py)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.python" }, { "include": "$self" } ]
        },
        {
          "begin": "\\b(js|javascript)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.js" }, { "include": "$self" } ]
        },
        {
          "begin": "\\b(sql|postgres|postgresql)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.sql" }, { "include": "$self" } ]
        },
        {
          "begin": "\\b(c)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.c" }, { "include": "$self" } ]
        },
        {
          "begin": "\\b(cpp)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.cpp" }, { "include": "$self" } ]
        },
        {
          "begin": "\\b(rust)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.rust" }, { "include": "$self" } ]
        },
        {
          "begin": "\\b(lua)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [ { "include": "source.lua" }, { "include": "$self" } ]
        }
      ]
    },
    "raw-dsl": {
      "patterns": [
        { "name": "string.unquoted.raw.dsl.pilot", "begin": "```[a-zA-Z0-9_]*", "end": "```" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.interpolated.pilot",
          "begin": "(f)(\"\"\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot" },
            "2": { "name": "punctuation.definition.string.begin.pilot" }
          },
          "end": "\"\"\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.pilot" } },
          "patterns": [
            { "name": "constant.character.escape.pilot", "match": "\\\\." },
            {
              "name": "meta.interpolation.pilot",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.pilot" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.pilot" } },
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        { "name": "string.quoted.triple.pilot", "begin": "\"\"\"", "end": "\"\"\"", "patterns": [ { "name": "constant.character.escape.pilot", "match": "\\\\." } ] },
        {
          "name": "string.quoted.double.interpolated.pilot",
          "begin": "(f)(\")",
          "beginCaptures": {
            "1": { "name": "storage.type.string.interpolated.pilot keyword.other.string.interpolated.pilot" },
            "2": { "name": "punctuation.definition.string.begin.pilot" }
          },
          "end": "\"",
          "endCaptures": { "0": { "name": "punctuation.definition.string.end.pilot" } },
          "patterns": [
            { "name": "constant.character.escape.pilot", "match": "\\\\." },
            {
              "name": "meta.interpolation.pilot",
              "begin": "\\{",
              "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.pilot" } },
              "end": "\\}",
              "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.pilot" } },
              "patterns": [ { "include": "$self" } ]
            }
          ]
        },
        { "name": "string.quoted.double.pilot", "begin": "\"", "end": "\"", "patterns": [ { "name": "constant.character.escape.pilot", "match": "\\\\." } ] },
        { "name": "string.quoted.single.pilot", "match": "'(?:[^'\\\\\n\r]|\\\\.)*'" }
      ]
    },
    "raw-idents": {
      "patterns": [
        { "name": "variable.other.escaped.pilot", "match": "`[^`\\r\\n]+`" }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.pilot",
          "begin": "\\[(?=\\s*(?:(?:var|let)\\s+[a-z_][A-Za-z0-9_]*\\s*=\\s*)?[A-Z][A-Za-z0-9_]*(?:\\(|$|\\s*[\\]\\,]))",
          "beginCaptures": { "0": { "name": "punctuation.brackets.square.pilot" } },
          "end": "\\]",
          "endCaptures": { "0": { "name": "punctuation.brackets.square.pilot" } },
          "patterns": [
            { "match": "\\b(let|var)\\b", "name": "keyword.declaration.variable.pilot keyword.other.pilot" },
            { "match": "\\b([A-Z][A-Za-z0-9_]*)\\b", "name": "entity.name.function.decorator.pilot support.type.decorator.pilot" },
            { "include": "#comments" },
            { "include": "#strings" },
            { "include": "#constants" },
            { "include": "#numbers" },
            { "include": "#primitives" },
            { "include": "#call-targets" },
            { "include": "#punctuation" },
            { "include": "#variables" }
          ]
        }
      ]
    },
    "quote-splices": {
      "patterns": [
        { "name": "variable.other.metavariable.splice.pilot", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "punctuation.operator.unquote.pilot", "match": "~(?=[A-Za-z_(])" }
      ]
    },
    "symbols": {
      "patterns": [
        { "name": "constant.other.symbol.pilot", "match": "(?<![:a-zA-Z0-9_]):[a-zA-Z_][a-zA-Z0-9_]*(?:/[a-zA-Z_][a-zA-Z0-9_]*)?" }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.function.declaration.pilot",
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.function.pilot keyword.control.pilot" },
            "2": { "name": "entity.name.function.pilot" }
          }
        },
        {
          "name": "meta.operator.declaration.pilot",
          "match": "\\b(op)\\s+([^\\s\\(\\);\\{]+)",
          "captures": {
            "1": { "name": "keyword.declaration.operator.pilot keyword.control.pilot" },
            "2": { "name": "entity.name.function.operator.pilot" }
          }
        },
        {
          "name": "meta.type.declaration.pilot",
          "match": "\\b(struct|interface|enum|actor|state|type)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.declaration.type.pilot keyword.control.pilot" },
            "2": { "name": "entity.name.type.pilot" }
          }
        },
        {
          "name": "meta.distributive.binding.pilot",
          "match": "\\b(let|var)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?=<|\\{)",
          "captures": {
            "1": { "name": "keyword.declaration.variable.pilot keyword.other.pilot" },
            "2": { "name": "entity.name.type.struct.pilot" }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "meta.syntax.declaration.type-construct.pilot",
          "match": "\\b(syntax)\\s+(type_construct)\\b",
          "captures": {
            "1": { "name": "keyword.control.syntax.pilot" },
            "2": { "name": "keyword.control.type-construct.pilot" }
          }
        },
        { "name": "keyword.control.syntax.pilot", "match": "\\b(syntax|quote|macro)\\b" },
        { "name": "keyword.control.seed.pilot", "match": "\\b(__engine|struct|interface|fn|let|ref|if|loop|return|yield|defer|comptime|quote|asm)\\b" },
        { "name": "keyword.control.flow.pilot", "match": "\\b(if|else|while|until|for|in|then|loop|break|continue|return|yield|defer|switch|case|default|guard|try|catch)\\b" },
        { "name": "keyword.declaration.pilot", "match": "\\b(struct|interface|enum|actor|state|type|fn|let|var|ref|const)\\b" },
        { "name": "keyword.other.property.pilot", "match": "\\b(get|set)\\b" },
        { "name": "variable.language.property.pilot", "match": "\\b(field|value)\\b" },
        { "name": "keyword.other.lifecycle.pilot", "match": "\\b(scope|enter|exit)\\b" },
        { "name": "keyword.other.contract.pilot", "match": "\\b(requires|ensures|old)\\b" },
        { "name": "keyword.other.adapter.pilot", "match": "\\b(context|adapter|each)\\b" },
        { "name": "keyword.other.collision.pilot", "match": "\\b(coalesce|with|without|as)\\b" },
        { "name": "keyword.control.concurrency.pilot", "match": "\\b(async|await|spawn|atomic|sync|isolate|select|timeout|bounded|noalloc|region|deadline|within|periodic|priority|jitter)\\b" },
        { "name": "keyword.control.database.pilot", "match": "\\b(database|transaction|commit|rollback|savepoint|connect|from|where|order|ascending|descending|insert|into|values|update|delete)\\b" },
        { "name": "keyword.control.foreign.pilot", "match": "\\b(extern|assembly|module|lib)\\b" },
        { "name": "keyword.other.query.pilot", "match": "\\b(sizeof|alignof|offsetof|fields_of|nameof|assert|blueprint|cue|role|route|unit|pkg|use|ext|op)\\b" }
      ]
    },
    "modifiers": {
      "patterns": [
        { "name": "storage.modifier.visibility.pilot", "match": "\\b(pub|priv|prot|pkg|int|file|open|export|lvl[0-9]*|lvl)\\b" },
        { "name": "storage.modifier.pilot", "match": "\\b()\\b" }
      ]
    },
    "primitives": {
      "patterns": [
        { "name": "support.type.primitive.pilot entity.name.type.primitive.pilot", "match": "\\b(void|never|bool|char|i8|i16|i32|i64|i128|isize|u8|u16|u32|u64|u128|usize|f16|f32|f64|f128|str|ptr|slice|stride|array|tuple|option|result|union|range|span|step|from|until|full|splat|pairs|expand|map|frame|type|ast)\\b" },
        { "name": "support.type.system.pilot entity.name.type.pilot", "match": "\\b(ArenaScope|AstContext|CallExpr|ClampAttr|Dual|EffectPlan|FormulaAttr|HardRealtimeAttr|IdeContextPolicy|IdePresentationPolicy|IdeTokenAttr|InheritPolicy|KernelAttr|LspKind|LspMod|OnChangeAttr|PatchAttr|PatchPart|PatchReplaceAttr|Quantity|RangeEnumerator|RangeWindow|RuleAttr|Signal|SliceBuffer|SliceEnumerator|SpanEnumerator|StrideEnumerator|TraceSpanAttr|WcetAttr|ZeroRuntimeAttr)\\b" },
        { "name": "entity.name.type.interface.pilot", "match": "\\bI[A-Z][A-Za-z0-9_]*\\b" },
        { "name": "entity.name.type.pilot", "match": "\\b[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "call-targets": {
      "patterns": [
        {
          "name": "meta.function.call.quoted.pilot",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(!!|!&|!\\^|!@|!\\?|!)(?=\\s*\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.pilot" },
            "2": { "name": "punctuation.operator.call-quote.pilot" }
          }
        },
        {
          "name": "meta.method.call.pilot",
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": { "1": { "name": "entity.name.function.member.pilot" } }
        },
        {
          "name": "meta.property.access.pilot",
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": { "1": { "name": "variable.other.property.pilot" } }
        },
        { "name": "entity.name.type.struct.constructor.pilot", "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\(|\\{|<)" },
        { "name": "entity.name.function.call.pilot", "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()" }
      ]
    },
    "constants": {
      "patterns": [
        {
          "match": "(::)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "punctuation.separator.enum.pilot" },
            "2": { "name": "variable.other.enummember.pilot constant.other.enum.pilot" }
          }
        },
        { "name": "constant.language.boolean.pilot", "match": "\\b(true|false)\\b" },
        { "name": "constant.language.null.pilot", "match": "\\b(none|null)\\b" },
        { "name": "variable.language.self.pilot", "match": "\\bself\\b" }
      ]
    },
    "object-keys": {
      "patterns": [
        {
          "match": "(?<![a-zA-Z0-9_])([a-zA-Z_][a-zA-Z0-9_]*)\\s*(:)(?!:)",
          "captures": {
            "1": { "name": "meta.object-literal.key.pilot meta.property-name.pilot variable.other.property.pilot" },
            "2": { "name": "punctuation.separator.key-value.pilot" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.hex.pilot", "match": "\\b0[xX][0-9a-fA-F_]+(?:[a-zA-Z]+)?\\b" },
        { "name": "constant.numeric.binary.pilot", "match": "\\b0[bB][01_]+(?:[a-zA-Z]+)?\\b" },
        { "name": "constant.numeric.octal.pilot", "match": "\\b0[oO][0-7_]+(?:[a-zA-Z]+)?\\b" },
        {
          "match": "\\b([0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?)(ns|us|ms|s|Hz|kHz|MHz|GHz|B|KB|MB|GB|TB)?\\b",
          "captures": {
            "1": { "name": "constant.numeric.pilot" },
            "2": { "name": "keyword.other.unit.pilot" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "punctuation.operator.call-quote.pilot", "match": "!!|!&|!\\^|!@|!\\?" },
        { "name": "punctuation.operator.cascade.pilot", "match": "\\?\\.\\.|\\.\\." },
        { "name": "punctuation.operator.pipeline.pilot", "match": "\\|>|<\\||=>|->|<-" },
        { "name": "punctuation.operator.range.pilot", "match": ">\\.\\.<|\\*\\.\\.|\\.\\.<|\\.\\.=|>=|<=|>\\.\\." },
        { "name": "punctuation.operator.null-safe.pilot", "match": "\\?\\?|\\?" },
        { "name": "punctuation.operator.comparison.pilot", "match": "==|!=|<=|>=|<=>|<|>" },
        { "name": "punctuation.operator.assignment.pilot", "match": ":=:|:=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|=" },
        { "name": "punctuation.operator.logical.pilot", "match": "&&|\\|\\||!" },
        { "name": "punctuation.operator.spread.pilot", "match": "\\*\\.\\.|\\*\\*|\\*" },
        { "name": "punctuation.operator.arithmetic.pilot", "match": "%%|\\*%|\\*\\?|\\*\\||\\+%|\\+\\?|\\+\\||-%|-\\?|-\\||<<|>>|~>|%|&|\\+|-|/|\\^|\\||~" }
      ]
    },
    "punctuation": {
      "patterns": [
        { "name": "punctuation.terminator.statement.pilot", "match": ";" },
        { "name": "punctuation.separator.comma.pilot", "match": "," },
        { "name": "punctuation.separator.colon.pilot", "match": ":" },
        { "name": "punctuation.accessor.dot.pilot", "match": "\\." },
        { "name": "punctuation.brackets.curly.pilot", "match": "[{}]" },
        { "name": "punctuation.brackets.round.pilot", "match": "[()]" },
        { "name": "punctuation.brackets.square.pilot", "match": "[\\[\\]]" }
      ]
    },
    "variables": {
      "patterns": [
        { "name": "variable.other.readwrite.pilot", "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b" }
      ]
    }
  }
}