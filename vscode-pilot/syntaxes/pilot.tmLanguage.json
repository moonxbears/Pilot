{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pilot",
  "scopeName": "source.pilot",
  "patterns": [
    { "include": "#comments" },
    { "include": "#preprocessor" },
    { "include": "#strings" },
    { "include": "#raw-idents" },
    { "include": "#attributes" },
    { "include": "#distributive-headers" },
    { "include": "#quote-splices" },
    { "include": "#numbers" },
    { "include": "#call-targets" },
    { "include": "#keywords" },
    { "include": "#modifiers" },
    { "include": "#primitives" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        { "name": "comment.line.double-slash.pilot", "match": "//.*$" },
        { "name": "comment.block.pilot", "begin": "/\\*", "end": "\\*/" }
      ]
    },
    "preprocessor": {
      "patterns": [
        { "name": "meta.preprocessor.pilot keyword.control.directive.pilot", "match": "^\\s*#(if|elif|else|endif|define|undef|region|endregion|pragma)\\b" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.interpolated.pilot",
          "begin": "f\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.pilot", "match": "\\\\." },
            { "name": "meta.interpolation.pilot", "begin": "\\{", "end": "\\}", "patterns": [{ "include": "$self" }] }
          ]
        },
        {
          "name": "string.quoted.double.pilot",
          "begin": "\"",
          "end": "\"",
          "patterns": [{ "name": "constant.character.escape.pilot", "match": "\\\\." }]
        }
      ]
    },
    "raw-idents": {
      "patterns": [
        { "name": "variable.other.escaped.pilot", "match": "`[^`\\r\\n]+`" }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.pilot",
          "match": "\\[\\s*(?:(var|let)\\s+([a-z_][A-Za-z0-9_]*)\\s*=\\s*)?([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.pilot" },
            "2": { "name": "variable.other.readwrite.pilot" },
            "3": { "name": "entity.name.function.decorator.pilot" }
          }
        }
      ]
    },
    "distributive-headers": {
      "patterns": [
        {
          "name": "meta.distributive.binding.pilot",
          "match": "\\b(let|var)\\s+([A-Z][A-Za-z0-9_]*)\\s*(?=<|\\{)",
          "captures": {
            "1": { "name": "storage.type.pilot" },
            "2": { "name": "entity.name.type.struct.pilot" }
          }
        }
      ]
    },
    "quote-splices": {
      "patterns": [
        { "name": "variable.other.metavariable.splice.pilot", "match": "\\$[A-Za-z_][A-Za-z0-9_]*" },
        { "name": "keyword.operator.unquote.pilot", "match": "~(?=[A-Za-z_(])" }
      ]
    },
    "call-targets": {
      "patterns": [
        { "name": "constant.other.enum-variant.pilot", "match": "::([A-Za-z_][A-Za-z0-9_]*)" },
        { "name": "entity.name.type.struct.constructor.pilot", "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(?=\\(|\\{|<)" },
        { "name": "entity.name.function.call.pilot", "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=(?:!!|!&|!\\^|!@|!\\?|!)?\\()" }
      ]
    },
    "keywords": {
      "patterns": [
        { "name": "keyword.control.seed.pilot", "match": "\\b(__engine|struct|interface|fn|let|ref|if|loop|return|yield|defer|comptime|quote|asm)\\b" },
        { "name": "entity.name.function.macro.syntax.pilot", "match": "\\b(blueprint|break|case|catch|continue|cue|default|for|guard|op|pkg|role|route|state|switch|syntax|try|unit|until|use|while)\\b" }
      ]
    },
    "modifiers": {
      "patterns": [
        { "name": "storage.modifier.pilot", "match": "\\b(const|export|ext|file|int|iso|lvl|partial|pkg|priv|pub|pure|static|var|lvl[0-9]+)\\b" }
      ]
    },
    "primitives": {
      "patterns": [
        { "name": "storage.type.primitive.pilot", "match": "\\b(ArenaScope|AstContext|CallExpr|ClampAttr|Dual|EffectPlan|FormulaAttr|HardRealtimeAttr|IdeContextPolicy|IdePresentationPolicy|IdeTokenAttr|InheritPolicy|KernelAttr|LspKind|LspMod|OnChangeAttr|PatchAttr|PatchPart|PatchReplaceAttr|Quantity|RangeEnumerator|RangeWindow|RuleAttr|Signal|SliceBuffer|SliceEnumerator|SpanEnumerator|StrideEnumerator|TraceSpanAttr|WcetAttr|ZeroRuntimeAttr|after|array|ast|bool|char|expand|f128|f16|f32|f64|fn|frame|from|full|grid|i128|i16|i32|i64|i8|isize|map|never|open|option|order|pairs|pin|ptr|range|result|ring|signal|simd|slice|span|splat|step|str|stride|tuple|type|u128|u16|u32|u64|u8|union|until|usize|void)\\b" },
        { "name": "entity.name.type.interface.pilot", "match": "\\bI[A-Z][A-Za-z0-9_]*\\b" }
      ]
    },
    "numbers": {
      "patterns": [
        { "name": "constant.numeric.pilot", "match": "\\b0[xXbBoO][0-9a-fA-F_]+\\b|\\b[0-9][0-9_]*(?:\\.[0-9_]+)?(?:[eE][+-]?[0-9_]+)?(?:[a-zA-Z]+)?\\b" }
      ]
    },
    "operators": {
      "patterns": [
        { "name": "keyword.operator.call-quote.pilot", "match": "!!|!&|!\\^|!@|!\\?" },
        { "name": "keyword.operator.pilot", "match": ">\.\.<|\*\.\.|\.\.<|\.\.=|:=:|<=>|>\.\.|!=|%%|\*%|\*\*|\*\?|\*\||\+%|\+\?|\+\||-%|-\?|-\||\.\.|<<|<=|==|>=|>>|\?\?|~>|!|%|&|\*|\+|-|/|<|>|\?|\^|\||~" }
      ]
    }
  }
}