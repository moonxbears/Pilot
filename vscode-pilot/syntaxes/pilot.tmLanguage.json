{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Pilot",
  "scopeName": "source.pilot",
  "patterns": [
    { "include": "#preprocessor" },
    { "include": "#comments" },
    { "include": "#raw-dsl" },
    { "include": "#polyglot-blocks" },
    { "include": "#strings" },
    { "include": "#decorators" },
    { "include": "#adt-variants" },
    { "include": "#declarations" },
    { "include": "#symbols" },
    { "include": "#realtime-literals" },
    { "include": "#numbers" },
    { "include": "#keywords-control" },
    { "include": "#keywords-database" },
    { "include": "#keywords-concurrency" },
    { "include": "#keywords-realtime" },
    { "include": "#keywords-udsa" },
    { "include": "#keywords-csharp" },
    { "include": "#constants" },
    { "include": "#types" },
    { "include": "#function-calls" },
    { "include": "#operators" },
    { "include": "#variables" }
  ],
  "repository": {
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.pilot",
          "match": "^\\s*(#\\s*(?:define|undef|if|elif|else|endif|region|endregion|error|warning|pragma|line|nullable))\\b(.*)$",
          "captures": {
            "1": { "name": "keyword.control.directive.pilot" },
            "2": { "name": "string.unquoted.preprocessor.pilot" }
          }
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.documentation.pilot",
          "begin": "/\\*\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.documentation.pilot",
          "match": "///.*$"
        },
        {
          "name": "comment.block.pilot",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.pilot",
          "match": "//.*$"
        },
        {
          "name": "comment.line.number-sign.pilot",
          "match": "#.*$"
        }
      ]
    },
    "raw-dsl": {
      "patterns": [
        {
          "name": "string.unquoted.raw.dsl.pilot",
          "begin": "```[a-zA-Z0-9_]*",
          "end": "```"
        }
      ]
    },
    "polyglot-blocks": {
      "patterns": [
        {
          "begin": "\\b(python|py)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [
            { "include": "source.python" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\b(js|javascript)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [
            { "include": "source.js" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\b(sql|postgres|postgresql)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [
            { "include": "source.sql" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\b(c|cpp)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [
            { "include": "source.c" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\b(lua)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [
            { "include": "source.lua" },
            { "include": "$self" }
          ]
        },
        {
          "begin": "\\b(java)\\s*(\\{)",
          "beginCaptures": {
            "1": { "name": "keyword.control.foreign.pilot" },
            "2": { "name": "punctuation.section.block.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.block.end.pilot" }
          },
          "patterns": [
            { "include": "source.java" },
            { "include": "$self" }
          ]
        },
        {
          "name": "keyword.control.foreign.pilot",
          "match": "\\b(extern|assembly|module|lib)\\b"
        },
        {
          "name": "keyword.control.foreign.pilot",
          "match": "\\b(python|csharp|rust|js|javascript|java|asm|cpp|c|lua|sql|postgres|postgresql|mysql)\\s*(?=\\{|\"\"\"|```|:)"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.pilot",
          "begin": "([rR])(\"\"\"|''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.pilot" }
          },
          "end": "\\2"
        },
        {
          "name": "string.quoted.raw.pilot",
          "begin": "([rR])\"",
          "beginCaptures": {
            "1": { "name": "storage.type.string.pilot" }
          },
          "end": "\""
        },
        {
          "name": "string.quoted.triple.pilot",
          "begin": "([fF$]{0,2})(\"\"\"|''')",
          "beginCaptures": {
            "1": { "name": "storage.type.string.pilot" }
          },
          "end": "\\2",
          "patterns": [
            { "name": "constant.character.escape.brace.pilot", "match": "\\{\\{|\\}\\}" },
            { "include": "#string-interpolation" },
            { "name": "constant.character.escape.pilot", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.double.pilot",
          "begin": "([fF$]{0,2})\"",
          "beginCaptures": {
            "1": { "name": "storage.type.string.pilot" }
          },
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.brace.pilot", "match": "\\{\\{|\\}\\}" },
            { "include": "#string-interpolation" },
            { "name": "constant.character.escape.pilot", "match": "\\\\." }
          ]
        },
        {
          "name": "string.quoted.single.pilot",
          "begin": "([fF$]{0,2})'",
          "beginCaptures": {
            "1": { "name": "storage.type.string.pilot" }
          },
          "end": "'",
          "patterns": [
            { "name": "constant.character.escape.brace.pilot", "match": "\\{\\{|\\}\\}" },
            { "include": "#string-interpolation" },
            { "name": "constant.character.escape.pilot", "match": "\\\\." }
          ]
        }
      ]
    },
    "string-interpolation": {
      "patterns": [
        {
          "name": "meta.embedded.line.pilot",
          "begin": "\\{",
          "beginCaptures": {
            "0": { "name": "punctuation.section.embedded.begin.pilot" }
          },
          "end": "\\}",
          "endCaptures": {
            "0": { "name": "punctuation.section.embedded.end.pilot" }
          },
          "patterns": [
            { "include": "$self" }
          ]
        }
      ]
    },
    "decorators": {
      "patterns": [
        {
          "name": "entity.name.function.decorator.pilot",
          "match": "(?:^|(?<=\\s|\\(|\\[|\\{|,))@[a-zA-Z_][a-zA-Z0-9_.]*"
        }
      ]
    },
    "adt-variants": {
      "patterns": [
        {
          "match": "^\\s*(\\|)\\s*([A-Z][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.operator.adt.pilot" },
            "2": { "name": "entity.name.type.variant.pilot" }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "match": "\\b((?:(?:public|private|protected|internal|static|partial|comptime|async|pure|override|virtual|abstract|sealed|final|readonly)\\s+)*)(def|fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.pilot" },
            "2": { "name": "keyword.declaration.function.pilot" },
            "3": { "name": "entity.name.function.pilot" }
          }
        },
        {
          "match": "\\b((?:(?:public|private|protected|internal|static|partial|comptime|async|pure|override|virtual|abstract|sealed|final|readonly)\\s+)*)(class|struct|record|interface|protocol|enum|actor|model|table|schema|unit|dsl|domain|macro|type|extension|adapter|converter|database|state)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.pilot" },
            "2": { "name": "keyword.declaration.type.pilot" },
            "3": { "name": "entity.name.type.pilot" }
          }
        },
        {
          "match": "\\b((?:(?:public|private|protected|internal|static|partial|readonly)\\s+)*)(property)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "storage.modifier.pilot" },
            "2": { "name": "keyword.declaration.property.pilot" },
            "3": { "name": "variable.other.property.pilot" }
          }
        },
        {
          "match": "\\b(public|private|protected|internal|static|partial|comptime|pure|async|override|virtual|abstract|sealed|final|readonly|mut|immut|ref|dynamic|params)\\b",
          "name": "storage.modifier.pilot"
        },
        {
          "match": "\\b(let|var|const|mut|immut)\\s+(?:(mut)\\s+)?([a-zA-Z_][a-zA-Z0-9_]*)(?!\\s*\\()",
          "captures": {
            "1": { "name": "storage.type.variable.pilot" },
            "2": { "name": "storage.modifier.pilot" },
            "3": { "name": "variable.other.readwrite.pilot" }
          }
        },
        {
          "match": "\\b(let|var|const|mut|immut)\\b",
          "name": "storage.type.variable.pilot"
        }
      ]
    },
    "symbols": {
      "patterns": [
        {
          "name": "constant.other.symbol.pilot",
          "match": "(?<![a-zA-Z0-9_:]):[a-zA-Z_][a-zA-Z0-9_./]*\\b"
        }
      ]
    },
    "realtime-literals": {
      "patterns": [
        {
          "match": "\\b([0-9]+(?:\\.[0-9]+)?)(ns|us|ms|s|min|h)\\b",
          "captures": {
            "1": { "name": "constant.numeric.duration.pilot" },
            "2": { "name": "keyword.other.unit.duration.pilot" }
          }
        },
        {
          "match": "\\b([0-9]+(?:\\.[0-9]+)?)(Hz|kHz|MHz|GHz)\\b",
          "captures": {
            "1": { "name": "constant.numeric.frequency.pilot" },
            "2": { "name": "keyword.other.unit.frequency.pilot" }
          }
        },
        {
          "match": "\\b([0-9]+(?:\\.[0-9]+)?)(B|KB|MB|GB|TB)\\b",
          "captures": {
            "1": { "name": "constant.numeric.memory.pilot" },
            "2": { "name": "keyword.other.unit.memory.pilot" }
          }
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.pilot",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.bin.pilot",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.oct.pilot",
          "match": "\\b0[oO][0-7_]+\\b"
        },
        {
          "name": "constant.numeric.float.pilot",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.pilot",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords-control": {
      "patterns": [
        {
          "match": "\\b(for)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s+(in)\\b",
          "captures": {
            "1": { "name": "keyword.control.flow.pilot" },
            "2": { "name": "variable.other.readwrite.pilot" },
            "3": { "name": "keyword.control.flow.pilot" }
          }
        },
        {
          "name": "keyword.control.flow.pilot",
          "match": "\\b(comptime|guard|defer|if|elif|else|then|for|while|loop|match|case|when|try|except|catch|finally|with|as|return|yield|raise|throw|break|continue|pass|assert|import|from|global|in|is|some|default)\\b"
        },
        {
          "name": "keyword.operator.logical.pilot",
          "match": "\\b(and|or|not)\\b"
        }
      ]
    },
    "keywords-database": {
      "patterns": [
        {
          "name": "keyword.other.sql.pilot",
          "match": "\\b(select|where|join|inner|left|right|full|cross|outer|on|group|by|having|order|asc|desc|ascending|descending|limit|offset|distinct|into|insert|values|update|set|delete|returning|conflict|do|nothing|over|partition|window|transaction|commit|rollback|savepoint|to|connect|database|model|table|schema|index|indexed|lookup|union|all|intersect|difference)\\b"
        }
      ]
    },
    "keywords-concurrency": {
      "patterns": [
        {
          "name": "keyword.control.concurrency.pilot",
          "match": "\\b(async|await|spawn|parallel|chan|channel|actor|atomic|sync|lock|isolate|timeout)\\b"
        }
      ]
    },
    "keywords-realtime": {
      "patterns": [
        {
          "name": "keyword.control.realtime.pilot",
          "match": "\\b(realtime|deadline|on_missed|within|fallback|period|periodic|priority|jitter|bounded|noalloc|stackalloc|region|wcet|hard_rt|soft_rt)\\b"
        }
      ]
    },
    "keywords-udsa": {
      "patterns": [
        {
          "name": "keyword.other.udsa.pilot",
          "match": "\\b(dsl|domain|unit|macro|defmacro|defkeyword|quote|quasiquote|splice|unquote|unquote_splicing|gensym|macroexpand|eval|cons|car|cdr|atom|list_ast)\\b"
        }
      ]
    },
    "keywords-csharp": {
      "patterns": [
        {
          "name": "keyword.other.csharp.pilot",
          "match": "\\b(property|get|set|operator|extension|adapter|converter|each|repeat|context|requires|ensures|state|pure|lambda|nameof|params|args|kwargs|static|partial|steal|contracts|delegate)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.pilot",
          "match": "\\b(True|False|true|false|None|none|null|undefined)\\b"
        },
        {
          "name": "variable.language.pilot",
          "match": "\\b(self|this|super)\\b"
        },
        {
          "name": "constant.other.caps.pilot",
          "match": "\\b[A-Z][A-Z0-9_]{2,}\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.pilot",
          "match": "\\b(char|str|string|i8|i16|i32|int|i64|u8|u16|u32|uint|u64|f8|f16|f32|float|f64|decimal|double|complex|tuple|Tuple|list|List|range|map|Map|dict|Dict|set|Set|frozenset|bool|bytes|bytearray|memoryview|void|any|symbol|dynamic|Table|Dataset|Relation|Channel|Chan|Result|Option|Span|Memory|SliceBuffer|SharedBuffer|RangeWindow|NativeArray|NativeMap|AstNode|matrix\\d+x\\d+)\\b"
        },
        {
          "name": "entity.name.type.pilot",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "function-calls": {
      "patterns": [
        {
          "name": "entity.name.function.macro.pilot",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?:!!|!&|!\\^|!@|!\\?|!)\\s*(?=[\\(\\{\\[])"
        },
        {
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.member.pilot" }
          }
        },
        {
          "match": "(?<=\\.)([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "variable.other.property.pilot" }
          }
        },
        {
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
          "captures": {
            "1": { "name": "entity.name.function.call.pilot" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.cascade.pilot",
          "match": "(\\?\\.\\.|\\.\\.(?=\\s*(?:let\\b|var\\b|[a-zA-Z_\\[])))"
        },
        {
          "name": "keyword.operator.range.pilot",
          "match": "(\\.\\.\\.|\\.\\.=|\\.\\.<|\\.\\.)"
        },
        {
          "name": "keyword.operator.pipeline.pilot",
          "match": "(\\|>|<\\||<-|->|=>)"
        },
        {
          "name": "keyword.operator.nullsafe.pilot",
          "match": "(\\?\\?=|\\?\\?|!\\.|\\?\\.|!\\?|\\?)"
        },
        {
          "name": "keyword.operator.jsonb.pilot",
          "match": "(->>|@>|<@)"
        },
        {
          "name": "keyword.operator.pattern.pilot",
          "match": "@"
        },
        {
          "name": "keyword.operator.callquote.pilot",
          "match": "(!!|!&|!\\^|!@|!\\?|~)"
        },
        {
          "name": "keyword.operator.comparison.pilot",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.assignment.pilot",
          "match": "(:=|\\+=|-=|\\*=|/=|%=|&=|\\|=|\\^=|<<=|>>=|\\*\\*=|//=|=)"
        },
        {
          "name": "keyword.operator.arithmetic.pilot",
          "match": "(\\+|-|\\*\\*|\\*|//|/|%)"
        },
        {
          "name": "keyword.operator.bitwise.pilot",
          "match": "(<<|>>|&|\\||\\^|~)"
        }
      ]
    },
    "variables": {
      "patterns": [
        {
          "name": "variable.other.readwrite.pilot",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
