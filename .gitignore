# Pilot: files git does not track.

# Rust seed build output and every cache under it (target/cache/lex, ...)
/target/

# C runtime header left by an old, deleted C emitter; the live C runtime is
# runtime/c/
pilot_runtime.h
**/pilot_runtime.h

# .pilc caches written next to sources
**/.pilc-cache/
**/.pilc-precompiled/

# Commit message drafts
commit.txt

# VS Code extension build and dependencies
vscode-pilot/node_modules/
vscode-pilot/out/
vscode-pilot/dist/
vscode-pilot/server/
*.vsix

# Python (tools/pilot-kernel) and virtual environments
__pycache__/
*.py[cod]
*.egg-info/
/.venv/
/venv/
/.pilotvenv/

# Editors and operating systems
.idea/
.DS_Store
Thumbs.db
