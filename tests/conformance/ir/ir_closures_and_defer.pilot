// F5: closures capture by value when evaluated, nest, carry the method's
// receiver, and named functions pass as values; `defer` runs when `?`
// leaves a function.
struct Scale {
    k: i64;

    fn by(self) -> fn<i64, i64> => (x) => x * .k;
}

fn twice(f: fn<i64, i64>, x: i64) -> i64 => f(f(x));

fn inc(x: i64) -> i64 => x + 1;

fn adder(a: i64) -> fn<i64, fn<i64, i64>> => (b) => (c) => a + b + c;

fn checked(x: i64?) -> i64? {
    defer print("checked done");
    let v = x?;
    return v * 10;
}

fn main() {
    var base = 5;
    let add_base = (x) => x + base;
    base = 100;
    print(add_base(1));
    print(twice(inc, 3));
    print(adder(1)(2)(3));
    let s = Scale { k: 3 };
    print(twice(s.by(), 2));
    print(checked(4) ?? -1);
    print(checked(none) ?? -1);
}
