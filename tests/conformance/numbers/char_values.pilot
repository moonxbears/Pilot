// A `char` is one Unicode scalar value. A one-character literal where a
// char is expected is that character; `as` converts between a char and its
// code point; chars compare by code point and are shown as the character.
//
// Expected output, worked by hand:
//   'A' is U+0041 = 65; 66 is 'B'; '€' is U+20AC = 8364; 'é' is U+00E9 = 233.
//   'A' < 'B' (65 < 66); a == 'A'; a != 'B'.
//   next('A') = 66 = 'B'; next('z') = 123 = '{'.
//   "" + 'A' + 'B' = "AB"; f"{a}{e}" = "A€".
//   is_digit('7') true, is_digit('x') false; digit value of '7' = 55 - 48 = 7.
//   0x1F600 as char is the grinning face, 4 UTF-8 bytes long as a string.
fn next(c: char) -> char => (c as u32 + 1) as char;

fn is_digit(c: char) -> bool => c >= '0' && c <= '9';

fn main() {
    let a: char = 'A';
    print(a);
    print(a as i64);
    let b: char = 66 as char;
    print(b);
    let e: char = '€';
    print(e as i64);
    let acute: char = 'é';
    print(acute as u32);
    print(a < b);
    print(a == 'A');
    print(a != 'B');
    print(next(a));
    print(next('z'));
    print("" + a + b);
    print(f"{a}{e}");
    print(is_digit('7'));
    print(is_digit('x'));
    let seven: char = '7';
    print(seven as i64 - '0' as i64);
    let face: char = 0x1F600 as char;
    let shown = "" + face;
    print(shown.len());
}
