// A separator before the decimal point (LIT001, PROP-021 slice 21D). The number patterns
// (stdlib/core/lex/numbers.pilot) allow a `_` only between two digits, so
// `1_.5` is not one number. Expected, worked by hand: its longest number is
// `1`, and `_.5` follows it.
fn main() {
    print(1_.5);
}
