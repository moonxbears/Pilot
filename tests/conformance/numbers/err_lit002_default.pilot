// A literal with no type around it lands in the integer literal type,
// `i64` (LIT002, PROP-021 slice 21D). Expected, worked by hand: `i64` holds
// -2^63 ..= 2^63 - 1 = -9223372036854775808 ..= 9223372036854775807, and
// 9223372036854775808 = 2^63 is one past the top.
fn main() {
    let x = 9223372036854775808;
    print(x);
}
