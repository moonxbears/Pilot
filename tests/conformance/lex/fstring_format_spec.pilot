// A hole's format spec (stdlib/core/lex/strings.pilot `format_spec`): `:`,
// then a run with no space, quote, bracket, brace or `:`, spaces around it,
// right before the hole's `}`. It is one token, so a `#` in it no longer
// starts a directive line (was known bug lex.fstring_format_spec). Whether
// the run is a pattern of `# 0 , _ .` is the parser's check, not the lexer's.
//
// Expected, worked by hand, family:text per token, spaces not shown:
//   f"{n:#_###}"   fstring_open:f" hole_open:{ name:n format_spec::#_###
//                  }:} fstring_close:"
//   f"{x: 0.00 }"  the spaces belong to the spec: format_spec:: 0.00 
//                  (its text ends in the space before `}`)
//   f"{a::b}"      a spec has no `:`, so `::` wins: ::::: then name:b
//   f"{n:#x#}"     not a pattern, still one spec: format_spec::#x#
//   f"{v:x y}"     a space inside: no spec, so `:`, name:x, name:y
//   {a:0}          outside a hole a `:` is a `:`: {:{ name:a ::: integer:0 }:}
//   f"{#}"         no `#` line in a hole: the `#` starts no token, ?:#
// The tape of the first source closes every bracket: true.
use Pilot.Core.Lex.Lexicon;
use Pilot.Core.Lex.Operators;
use pilot.lex.modes;
use pilot.lex.cache;
use pilot.lex;

fn show(ref m: ModalLexer, src: str) {
    var out = "";
    for l in lex_modal(m, src) {
        if modal_family(m, l) != "space" {
            out = out + modal_lexeme_text(m, src, l) + " ";
        }
    }
    print(out);
}

fn main() {
    let built = build_modes_cached(core_modes(operator_tokens([], [])), LEX_CACHE_DIR);
    print(built.ok());
    show(built.lexer, "f\"{n:#_###}\"");
    show(built.lexer, "f\"{x: 0.00 }\"");
    show(built.lexer, "f\"{a::b}\"");
    show(built.lexer, "f\"{n:#x#}\"");
    show(built.lexer, "f\"{v:x y}\"");
    show(built.lexer, "{a:0}");
    show(built.lexer, "f\"{#}\"");
    print(build_tape(built.lexer, "f\"{n:#_###}\"").ok());
}
