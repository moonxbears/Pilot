// Every token family declared so far that lexes in one table (PROP-021
// slices 21B and 21C): numbers, names, seed words and keyword literals,
// trivia and the shebang, strings and the structural delimiters. No two of them tie (no LEX002), and a line of Pilot lexes
// into the families the parser expects.
//
// Expected, worked by hand:
//   families: 45 numbers + 1 name + 14 seed words + 1 keyword_literal
//             + 5 trivia + 1 shebang + 6 strings + 14 delimiters (the 13,
//             with `.` split into prefix_dot and infix_dot) + 26 seed forms
//             (strings: plain, raw and byte, each quoted once and three
//             times)
//             = 113, where
//     numbers: 5 (integer per radix: dec, hex, bin, oct; float), 5 of
//       them suffixed, and each of the 5 again before a seed word, once per
//       length of the letter-led words (fn/if 2, let/ref/asm 3, loop 4,
//       yield/defer/quote 5, struct/return 6, comptime 8, interface 9:
//       7 lengths) = 5 + 5 + 35;
//     seed forms: no operators are declared here, so all 20 spellings of
//       seed_forms.pilot, plus its 6 call-quote openers.
//   `fn main() { let x = 0xFF; } // done` (spaces not shown):
//   fn name ( ) { let name = hex_integer ; } line_comment
use Pilot.Core.Lex.Lexicon;
use pilot.lex.build;
use pilot.lex.cache;

fn main() {
    let built = build_table_cached(core_tokens(), LEX_CACHE_DIR);
    print(built.ok());
    print(built.table.names.len());
    let src = "fn main() { let x = 0xFF; } // done";
    var out = "";
    for l in lex_all(built.table, src) {
        let family = if l.decl < 0 { "?" } else { built.table.names[l.decl] };
        if family != "space" {
            out = out + family + " ";
        }
    }
    print(out);
}
