// `order` is a query clause word that is not built yet
// (docs/keyword_roadmap.md K9). As a clause of a query it stops the build
// at the seam `keyword.unbuilt`, instead of the generic "query clause is
// not supported". Nothing runs, so nothing is printed.
fn main() {
    let xs = [3, 1, 2];
    let ys = from x in xs order x select x;
    print(ys.len());
}
