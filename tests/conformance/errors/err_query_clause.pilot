// A query clause other than `where` between `from` and `select` is not
// silently skipped: it is rejected with SYN001. (`skip` is no keyword;
// the registered clause words, such as `order`, stop at a seam instead:
// err_order_unbuilt.)
fn main() {
    let xs: List<i64> = [2, 1];
    print(from x in xs skip x select x);
}
