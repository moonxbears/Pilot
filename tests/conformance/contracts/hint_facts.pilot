// `assume(cond)` and `unreachable()` state facts (stdlib/core/hint.pilot).
// While the facts hold, the program runs as if they were not written.
// `unreachable()` returns `never`, so it fits a branch of any type.
fn sign(n: i64) -> str {
    assume(n != 0);
    let s: str = if n > 0 { "positive" } else if n < 0 { "negative" } else { unreachable() };
    return s;
}

fn digit(d: i64) -> i64 {
    switch d {
        case 0: return 10;
        case 1: return 20;
        default: unreachable();
    }
    return 0;
}

fn main() {
    print(sign(5));
    print(sign(-2));
    // 10 + 20 = 30.
    print(digit(0) + digit(1));
}
