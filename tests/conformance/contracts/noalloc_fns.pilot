// A `noalloc` function takes no heap memory (NOALLOC001 reports what it
// must not do). Arithmetic on scalars, value structs, reading lists it is
// given and calling other `noalloc` functions are all allowed.
struct Point : IValue {
    pub x: i64;
    pub y: i64;
}

noalloc fn dot(a: Point, b: Point) -> i64 => a.x * b.x + a.y * b.y;

noalloc fn clamp(v: i64, lo: i64, hi: i64) -> i64 {
    if v < lo { return lo; }
    if v > hi { return hi; }
    return v;
}

noalloc fn sum_clamped(xs: List<i64>, hi: i64) -> i64 {
    var total = 0;
    var i = 0;
    while i < xs.len() {
        total = total + clamp(xs[i], 0, hi);
        i = i + 1;
    }
    return total;
}

fn main() {
    // 1*3 + 2*4 = 11.
    print(dot(Point { x: 1, y: 2 }, Point { x: 3, y: 4 }));
    // clamp to [0, 5]: 0 + 2 + 5 + 5 = 12.
    print(sum_clamped([-4, 2, 9, 5], 5));
}
