// str.slice and str.byte_at take i64 positions (PROP-005 D2 (a)) and clamp
// them to the text: a position below 0 reads as 0, one past the end as the
// length, and a slice whose start is not before its end is empty.
// "pilot" is p=112 i=105 l=108 o=111 t=116, length 5.
fn main() {
    let s = "pilot";
    let n: i64 = s.len();
    print(s.slice(1, 3));          // "il"
    print(s.slice(n - 2, n));      // "ot"
    print(s.slice(-3, 2));         // start 0: "pi"
    print(s.slice(3, 99));         // end 5: "ot"
    print(s.slice(4, 2).len());    // empty: 0
    print(s.byte_at(0));           // 112
    print(s.byte_at(n - 1));       // 116
    var total: i64 = 0;
    var i: i64 = 0;
    while i < n {
        total = total + (s.byte_at(i) as i64);
        i = i + 1;
    }
    print(total);                  // 112 + 105 + 108 + 111 + 116 = 552
}
