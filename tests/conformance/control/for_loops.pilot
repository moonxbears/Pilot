// `for` over half-open and closed ranges and over lists, with break/continue.
fn main() {
    var sum = 0;
    for i in 0..5 {
        sum = sum + i;
    }
    print(sum);
    var closed = 0;
    for i in 1..=4 {
        closed = closed + i;
    }
    print(closed);
    let xs = [3, 1, 4, 1, 5,];
    var odd = 0;
    for x in xs {
        if x % 2 == 0 {
            continue;
        }
        if x == 5 {
            break;
        }
        odd = odd + x;
    }
    print(odd);
    for w in ["a", "b",] {
        print(w);
    }
}
