// `become f(x);` is a guaranteed tail call: the callee reuses the caller's
// frame, so a chain of any length runs in constant stack. Ordinary calls
// stop at the seed's 10,000-frame limit; this chain is 1,000,000 deep.
//
// Expected output, worked by hand:
//   count(1000000, 0) adds 1 per step: 1000000.
//   is_even(1000001) alternates even/odd 1,000,001 times and ends in
//   is_odd(0) = false.
//   sum_to(100000, 0) = 100000 * 100001 / 2 = 5000050000.
fn count(n: i64, acc: i64) -> i64 {
    if n == 0 { return acc; }
    become count(n - 1, acc + 1);
}

fn is_even(n: i64) -> bool {
    if n == 0 { return true; }
    become is_odd(n - 1);
}

fn is_odd(n: i64) -> bool {
    if n == 0 { return false; }
    become is_even(n - 1);
}

fn sum_to(n: i64, acc: i64) -> i64 {
    if n == 0 { return acc; }
    become sum_to(n - 1, acc + n);
}

fn main() {
    print(count(1000000, 0));
    print(is_even(1000001));
    print(sum_to(100000, 0));
}
