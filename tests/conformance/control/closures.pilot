// Lambdas, captured variables (by value), named functions as values,
// nested closures and calling a computed function value.
fn apply(f: (i64) => i64, x: i64) -> i64 {
    return f(x);
}

fn twice(f: (i64) => i64, x: i64) -> i64 => f(f(x));

fn double(x: i64) -> i64 => x * 2;

fn make_adder(n: i64) -> (i64) => i64 {
    return (x) => x + n;
}

fn make_counter_from(start: i64) -> () => i64 {
    let base = start * 10;
    return () => {
        let inner = (k) => k + base;
        return inner(start);
    };
}

fn main() {
    let square = (x) => x * x;
    print(square(7));
    print(apply(square, 5));
    print(apply(double, 21));
    print(twice((x) => x + 3, 10));

    let add5 = make_adder(5);
    print(add5(10));
    print(apply(make_adder(100), 1));

    var offset = 1;
    let snap = (x) => x + offset;
    offset = 50;
    print(snap(1));

    let counter = make_counter_from(4);
    print(counter());

    print(make_adder(2)(40));

    let fns = [square, double, add5];
    var i = 0;
    while i < fns.len() {
        let f = fns[i];
        print(f(3));
        i = i + 1;
    }
}
