// if / else if / else as statements and expressions, while, loop + break/continue.
fn classify(n: i64) -> str {
    if n < 0 {
        return "negative";
    } else if n == 0 {
        return "zero";
    } else {
        return "positive";
    }
}

fn main() {
    print(classify(-4));
    print(classify(0));
    print(classify(9));
    let parity = if 7 % 2 == 0 { "even" } else { "odd" };
    print(parity);
    var i = 0;
    var total = 0;
    while i < 10 {
        i = i + 1;
        if i % 2 == 0 {
            continue;
        }
        total = total + i;
    }
    print(total);
    var n = 0;
    loop {
        n = n + 1;
        if n == 4 {
            break;
        }
    }
    print(n);
}
