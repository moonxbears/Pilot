// F2: `for` walks ranges, lists and any value implementing the enumerator
// protocol (`get_enumerator`, `move_next`, `current`).
struct Countdown {
    var n: i64;
    var current: i64 = 0;
    fn get_enumerator() -> Countdown => Countdown { n: .n };
    fn move_next() -> bool {
        if .n <= 0 { return false; }
        .current = .n;
        .n = .n - 1;
        return true;
    }
}

// The element type is unknown here, so the loop picks its walk at run time.
fn total(xs) -> i64 {
    var sum = 0;
    for x in xs { sum = sum + x; }
    return sum;
}

fn main() {
    let c = Countdown { n: 3 };
    for v in c { print(v); }
    for v in c {
        if v == 2 { continue; }
        print(v * 10);
    }
    for i in 0..3 { print(i); }
    for i in 1..=2 { print(i); }
    print(total([4, 5, 6]));
    print(total(Countdown { n: 4 }));
    print(c.n);
}
