// Assertions that hold do nothing, and each side of a comparison is
// evaluated exactly once. `tick()` adds 1 to the counter each call, and it
// is called once per assertion below: 7 assertions call it, so the counter
// ends at 7. Every comparison holds: 1 == 1, 2 != 3, 3 < 4, 4 <= 4, 5 > 1,
// 6 >= 6, and `tick() == 7` is the seventh call.
var counter = 0;

fn tick() -> i64 {
    counter = counter + 1;
    return counter;
}

fn main() {
    assert(tick() == 1);
    assert(tick() != 3);
    assert(tick() < 4, "third");
    assert(tick() <= 4);
    assert(tick() > 1);
    assert(tick() >= 6, "sixth");
    let ok = tick() == 7;
    assert(ok);
    print(counter);
}
