// `continue` skips the rest of this pass and starts the next one, in
// `for` and `while` loops; the loop variable still advances.
//
// Expected output, worked by hand:
//   0..6 skipping even numbers: 1, 3, 5.
//   while i < 5, skipping 2 (i is advanced before `continue`): 1, 3, 4, 5.
//   sum of 1..=10 skipping multiples of 3 (3, 6, 9): 55 - 18 = 37.
fn main() {
    for n in 0..6 {
        if n % 2 == 0 { continue; }
        print(n);
    }
    var i = 0;
    while i < 5 {
        i = i + 1;
        if i == 2 { continue; }
        print(i);
    }
    var sum = 0;
    for m in 1..=10 {
        if m % 3 == 0 { continue; }
        sum = sum + m;
    }
    print(sum);
}
