// guard (boolean and `some` forms) and postfix `?` propagating none.
fn find(xs: i64[], want: i64) -> i64? {
    var i = 0;
    while i < xs.len() {
        if xs[i] == want {
            return i;
        }
        i = i + 1;
    }
    return none;
}

fn index_plus_one(xs: i64[], want: i64) -> i64? {
    let i = find(xs, want)?;
    return i + 1;
}

fn checked(n: i64) -> str {
    guard n >= 0 else {
        return "negative";
    }
    guard some idx = find([10, 20, 30], n) else {
        return "missing";
    }
    return f"found at {idx}";
}

fn main() {
    print(checked(-1));
    print(checked(20));
    print(checked(25));
    print(index_plus_one([5, 6, 7], 7) ?? -1);
    print(index_plus_one([5, 6, 7], 9) ?? -1);
}
