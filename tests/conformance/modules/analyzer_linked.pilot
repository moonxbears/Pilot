// F3: the checker reads the whole linked program. `IGreeter` is declared in
// lib/greeters.pilot; a struct here that leaves out one of its methods is
// reported by the type checker (TYPE006), which needs the interface from the
// other file.
use lib.greeters;

struct Polite : IGreeter {
    pub name: str;
    pub fn greet() -> str => shout("hello " + .name);
}

fn main() {
    let p = Polite { name: "ada" };
    print(p.greet());
}
