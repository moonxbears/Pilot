// F7: assigning an owned local a new value must drop the value it held.
// Until the PilIR drop pass does that, the assignment stops at the
// `own.reassign` seam instead of leaking the old value silently.
struct Res {
    pub name: str;

    ~self() {
        print(f"drop {self.name}");
    }
}

fn main() {
    var r = Res { name: "a" };
    print(r.name);
    r = Res { name: "b" };
    print("unreachable");
}
