// `==` and `!=` compare lists and tuples element by element, recursively.
fn main() {
    let a = [1, 2, 3];
    var b = [1, 2];
    print(a == b);
    b.push(3);
    print(a == b);
    print(a != b);
    print([[1, "x"], [2.0]] == [[1, "x"], [2]]);
    print([1, [2, 3]] == [1, [2, 4]]);
    print((1, "a") == (1, "a"));
    print([] == []);
    print(a == 3);
}
