// F7: replacing an element a list owns must drop the element it held. Until
// the drop pass does that, the assignment stops at the
// `own.element_replace` seam.
struct Res {
    pub name: str;

    ~self() {
        print(f"drop {self.name}");
    }
}

fn main() {
    print("before");
    var rs: List<Res> = [Res { name: "a" }];
    rs[0] = Res { name: "b" };
    print(rs.len());
}
