// A `while` loop inside a `syntax` rule's `quote { .. }` keeps its
// condition (known bug parser.rule_template_while until PROP-009 step 2: the
// template dropped the condition, and the checker reported QUOTE003 for the
// `$n` the rule's expansion inside the quote left unattached).
//
// Expected output, worked by hand: count_to(3) prints i = 0, 1, 2 and
// stops when i < 3 fails at i = 3.
pub syntax {
    count_to ( $n:Expr ) => quote { {
        var i = 0;
        while i < $n {
            print(i);
            i = i + 1;
        }
    } };
}

fn main() {
    count_to(3);
}
