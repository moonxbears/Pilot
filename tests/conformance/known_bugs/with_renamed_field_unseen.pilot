// `*Bundle with { count as hits }` stores the bundle's `count` under the
// name `hits`; the bundle's own methods keep working on that field.
//
// Expected output, worked by hand: hits starts at 2; bump() is hits + 1 =
// 3; current() reads hits: 2.
struct CountBundle {
    pub count: i64;
    pub fn bump() -> i64 => .count + 1;
    pub fn current() -> i64 => .count;
}

struct Gauge {
    *CountBundle with { count as hits };
    pub name: str;
}

fn main() {
    let g = Gauge { hits: 2, name: "g" };
    print(g.hits);
    print(g.bump());
    print(g.current());
}
