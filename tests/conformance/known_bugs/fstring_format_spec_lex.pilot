// An f-string hole may end in a format spec after `:` (`{n:#_###}`, see
// text/fstring_format_patterns). The f-string modes of
// stdlib/core/lex/strings.pilot (PROP-021 slice 21C) lex a hole with the
// ordinary tokens only, so `#_###}"` reads as a `#` line to the end of the
// line: the hole's `}` and the closing quote are swallowed, and the tape
// reports the hole's `{` as never closed (LEX006).
//
// Expected, worked by hand: `f"{n:#_###}"` is one f-string whose hole holds
// `n` and the spec `#_###`; every bracket closes, so the tape is ok: "true".
use Pilot.Core.Lex.Lexicon;
use Pilot.Core.Lex.Operators;
use pilot.lex.modes;
use pilot.lex;

fn main() {
    let built = build_modes(core_modes(operator_tokens([], [])));
    let tb = build_tape(built.lexer, "f\"{n:#_###}\"");
    print(tb.ok());
}
