// KNOWN BUG seed.u64_right_shift: `>>` on a u64 with the top bit set does not
// shift in zeros, so u64 xorshift diverges from the reference after one step.
// Expected values: xorshift64 (13, 7, 17) from seed 12345678, computed with
// 64-bit unsigned arithmetic.
fn main() {
    var x: u64 = 12345678;
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    print(x);
    x = x ^ (x << 13);
    x = x ^ (x >> 7);
    x = x ^ (x << 17);
    print(x);
}
