// A binding named `set` used as the sequence of a `for` loop. `set` is
// also the property-setter word, and the loop head loses the name: the
// loop does not run and the binding is reported unused.
fn total(set: List<i64>) -> i64 {
    var n = 0;
    for x in set { n = n + x; }
    return n;
}

fn main() {
    let xs: List<i64> = [1, 2, 3];
    print(total(xs));
}
