// A block or an `if .. else` whose value is a collecting `for` (`yield`)
// must give that list. Today the program prints nothing at all, not even
// the `print` before it, and exits 0 (found building PROP-009 step 1a).
//
// Expected output, worked by hand:
//   0 is printed first.
//   { for x in [1, 2, 3] { yield x * 10; } } is [10, 20, 30].
//   xs.len() > 9 is false, so the else branch gives [1 + 1, 2 + 1, 3 + 1] = [2, 3, 4].
fn main() {
    let xs: List<i64> = [1, 2, 3];
    print(0);
    let big = {
        for x in xs { yield x * 10; }
    };
    print(big);
    let c = if xs.len() > 9 { for x in xs { yield x; } } else { for x in xs { yield x + 1; } };
    print(c);
}
