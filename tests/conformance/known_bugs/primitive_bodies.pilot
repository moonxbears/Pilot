// `List<T>` declares members written in Pilot over the engine-backed ones
// (stdlib/core/primitives/list.pilot: `contains`, `add`, `clear`). `List`
// needs no import, but the seed links those bodies only into a program that
// imports Pilot.Core.Primitives.List, so here the calls fail.
fn main() {
    var xs: List<i64> = [1, 2];
    print(xs.contains(2));
    xs.add(3);
    print(xs.len());
}
