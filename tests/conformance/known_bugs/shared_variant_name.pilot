// KNOWN BUG seed.shared_variant_name: when two enums have a variant with the
// same name, `::Variant` passed as a call argument is an undefined name, even
// though the parameter type says which enum it is.
enum Shape : u8 {
    Dot,
    Value,
}

enum Slot : u8 {
    Empty,
    Value,
}

fn is_value(s: Slot) -> bool => s == ::Value;

fn main() {
    print(is_value(::Value));
}
