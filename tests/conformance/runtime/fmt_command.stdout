// sum of squares
fn sq(x: i64) -> i64 {
    return x * x;
}
fn main() {
    let xs = [1, 2, 3];
    var t = 0;
    for x in xs {
        t = t + sq(x);
    }
    // add
    if t > 10 && !done {
        print(t);
    } else {
        print(0);
    }
}

