// `pilot test --timeout S`: a case still running S seconds after it started
// fails as timed out and is killed, and the run goes on without waiting.
//
// Fixtures in tests/tool_fixtures/test_timeout/ (D below), in path order:
//   patient (sleeps 12 s, tag `timeout=40`), quick (prints at once),
//   sleeper (spins 60 s), slow_patient (sleeps 12 s, tag `slow`).
// With `--timeout 10`, worked by hand:
//   - quick passes;
//   - patient's own limit is 40 s and slow_patient's 4 * 10 = 40 s, so
//     both finish their 12 s and pass;
//   - sleeper is still spinning at 10 s: FAIL, `timed out after 10 s`.
//   So 3 passed, 1 failed, exit 1, and the run ends well before the
//   sleeper's 60 s: under 40 s.
// The same on --ir and --emit c (the waits are in the programs, so they last
// as long on every engine).
// `--timeout x` is not a number: an error, exit 2.
use std.proc;
use std.text;

const D: str = "tests/tool_fixtures/test_timeout";

fn summary(s: str) -> str {
    var out = "";
    for line in text.split_text(s, "\n") {
        if line.starts_with("FAIL ") || line.starts_with("  timed out") || line.starts_with("RESULT") {
            out = out + line + "\n";
        }
    }
    return out;
}

fn show(args: List<str>) {
    let t0 = Clock.now_ns(1);
    let out = proc.run(proc.pilot_cli_path(), args, "");
    let took = (Clock.now_ns(1) - t0) / 1000000000;
    print(summary(out.stdout) + f"exit {out.exit_code}, under 40 s: {took < 40}");
}

fn main() {
    show(["test", D, "--timeout", "10"]);
    show(["test", "--ir", D, "--timeout", "10"]);
    show(["test", "--emit", "c", D, "--timeout", "10"]);
    let bad = proc.run(proc.pilot_cli_path(), ["test", D, "--timeout", "x"], "");
    print(bad.stderr + f"exit {bad.exit_code}");
}
