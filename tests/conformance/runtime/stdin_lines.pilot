// Standard input, read line by line until it ends (F3). `read_line` gives
// `str?`: none once the input has ended.
use std.io;

fn main() {
    var count = 0;
    var total = 0;
    var reading = true;
    while reading {
        if some line = io.read_line() {
            count = count + 1;
            total = total + line.len();
            print(f"{count}: [{line}]");
        } else {
            reading = false;
        }
    }
    print(f"{count} lines, {total} bytes");
}
