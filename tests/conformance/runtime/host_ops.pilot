// Acceptance test for the HostOp owners (PROP-002a §3 & §7, Amendment A1):
// exercises implemented HostOps, through their [EngineOp] owner methods
// (RawMem, Fd, File, Thread, Process, Clock, Entropy, Ffi), against external
// OS and memory ground truth:
//   - SlabAlloc / SlabRealloc / SlabFree, LoadInt / StoreInt, LoadFloat / StoreFloat
//   - MemSet / MemCopy / MemCmp (-1, 0, 1 on lexicographic byte sequences)
//   - AtomicInt (store, load, add, cas_ok)
//   - FdOpen on a missing path -> -3 (-E_NOENT)
//   - FdOpen + FdWrite + FdPread + FdSeekSync + FdRead + FdClose, then FdRead -> -11 (-E_BADF)
//   - FsStat (regular file kind=1, size=5), FsMkdir, FsReadDir, FsRemove
//   - FsRenameLink across distinct mount points (/dev/shm -> /tmp) -> -17 (-E_EXDEV)
//   - FdPipeDup (pipe) + IoPoll + FdWrite + FdRead + FdClose
//   - ThreadCtl (parallelism >= 1), ProcSignal (self_pid > 0), ClockNowNs (> 0), SleepNs (0)
//   - OsRandom fills requested 32-byte buffer
//   - FfiCall with mismatched arch_kind=6 (wasm32_c) -> -43 (-E_NOSYS)
use Pilot.Core.OsAbi;
use Pilot.Core.HostRaw;
use Pilot.Core.File;
use Pilot.Core.Env;

fn write_ascii(dst: i64, s: str) -> i64 {
    var i = 0;
    while i < s.len() {
        let _ = RawMem.store_int(dst + i, s.byte_at(i) as i64, 8);
        i = i + 1;
    }
    return s.len();
}

fn main() {
    // 1. Slab + Load/Store + MemSet/MemCopy/MemCmp + AtomicInt
    let buf = RawMem.alloc(128, 8);
    let _ = RawMem.fill(buf, 0, 128);
    let _ = write_ascii(buf, "abc");
    let _ = write_ascii(buf + 16, "abd");
    let _ = write_ascii(buf + 32, "abc");
    print(RawMem.compare(buf, buf + 16, 3));
    print(RawMem.compare(buf, buf + 32, 3));
    print(RawMem.compare(buf + 16, buf, 3));

    let _ = RawMem.copy(buf + 48, buf + 16, 3);
    print(RawMem.compare(buf + 48, buf + 16, 3));

    let _ = RawMem.store_int(buf + 64, -42, 32);
    print(RawMem.load_int(buf + 64, 32, 1));
    let _ = RawMem.store_float(buf + 72, 3.5, 64);
    print(RawMem.load_float(buf + 72, 64));

    let _ = RawMem.atomic_int(1, buf + 80, 0, 10, 5);
    let prev = RawMem.atomic_int(3, buf + 80, 0, 5, 5);
    let ok = RawMem.atomic_int(9, buf + 80, 15, 20, 5);
    let fin = RawMem.atomic_int(0, buf + 80, 0, 0, 5);
    print(f"{prev},{ok},{fin}");

    let grown = RawMem.realloc(buf, 128, 256, 8);
    print(RawMem.load_int(grown + 80, 64, 1));

    // 2. FdOpen missing path -> -3 (ENOENT)
    let path_buf = RawMem.alloc(256, 8);
    let miss_len = write_ascii(path_buf, "/tmp/pilot_bridge_missing_path_987654321.txt");
    print(Fd.open_path(path_buf, miss_len, 1, 0));

    // 3. File create, write, pread, seek, read, close, then EBADF (-11)
    let pid = Process.send_signal(2, 0, 0);
    let tmp_path = f"/tmp/pilot_bridge_test_{pid}.txt";
    let tmp_len = write_ascii(path_buf, tmp_path);
    // flags: READ(1) | WRITE(2) | CREAT(4) | TRUNC(8) = 15, mode 0o600 = 384
    let fd = Fd.open_path(path_buf, tmp_len, 15, 384);
    let msg_len = write_ascii(grown, "hello");
    let wn = Fd.write(fd, grown, msg_len);
    let pr = Fd.pread(fd, grown + 32, 3, 1);
    let pos = Fd.seek_sync(0, fd, 0);
    let rn = Fd.read(fd, grown + 64, 5);
    let c0 = Fd.close(fd);
    let bad = Fd.read(fd, grown + 64, 5);
    print(f"{wn},{pr},{pos},{rn},{c0},{bad}");

    // 4. FsStat on tmp_path (kind=1 regular file, size=5)
    let stat_buf = RawMem.alloc(72, 8);
    let st_rc = File.stat(1, path_buf, tmp_len, stat_buf);
    let st_kind = RawMem.load_int(stat_buf + 0, 64, 0);
    let st_size = RawMem.load_int(stat_buf + 8, 64, 0);
    let tmp_dev = RawMem.load_int(stat_buf + 48, 64, 0);
    print(f"{st_rc},{st_kind},{st_size}");

    // 5. FsRenameLink cross-filesystem (/dev/shm -> /tmp) -> -17 (EXDEV)
    let shm_dir = "/dev/shm";
    let shm_dir_len = write_ascii(path_buf + 128, shm_dir);
    let shm_stat = RawMem.alloc(72, 8);
    var exdev_rc = -17;
    if File.stat(1, path_buf + 128, shm_dir_len, shm_stat) == 0 {
        let shm_dev = RawMem.load_int(shm_stat + 48, 64, 0);
        if shm_dev != tmp_dev {
            let shm_file = f"/dev/shm/pilot_exdev_{pid}.txt";
            let shm_len = write_ascii(path_buf + 128, shm_file);
            let sfd = Fd.open_path(path_buf + 128, shm_len, 14, 384);
            if sfd >= 0 {
                let _ = Fd.close(sfd);
                let dst_file = f"/tmp/pilot_exdev_dst_{pid}.txt";
                let dst_len = write_ascii(grown + 128, dst_file);
                exdev_rc = File.rename_link(0, path_buf + 128, shm_len, grown + 128, dst_len, 0);
                let _ = File.remove(path_buf + 128, shm_len, 0);
                let _ = File.remove(grown + 128, dst_len, 0);
            }
        }
    }
    print(exdev_rc);
    let _ = File.remove(path_buf, tmp_len, 0);

    // 6. FsMkdir + FsReadDir + FsRemove
    let sub_dir = f"/tmp/pilot_bridge_dir_{pid}";
    let sub_len = write_ascii(path_buf, sub_dir);
    let mk_rc = File.mkdir(path_buf, sub_len, 1, 448);
    let f_in_dir = f"{sub_dir}/item.txt";
    let f_len = write_ascii(path_buf + 128, f_in_dir);
    let ifd = Fd.open_path(path_buf + 128, f_len, 14, 384);
    let _ = Fd.close(ifd);
    let out_len_ptr = RawMem.alloc(8, 8);
    let dir_cnt = File.read_dir(path_buf, sub_len, grown, 256, out_len_ptr);
    let rm_rc = File.remove(path_buf, sub_len, 1);
    print(f"{mk_rc},{dir_cnt},{rm_rc}");

    // 7. FdPipeDup + IoPoll
    let pipe_fds = RawMem.alloc(16, 8);
    let p_rc = Fd.pipe_dup(0, pipe_fds, 0);
    let rfd = RawMem.load_int(pipe_fds, 64, 1);
    let wfd = RawMem.load_int(pipe_fds + 8, 64, 1);
    let _ = write_ascii(grown, "ok");
    let _ = Fd.write(wfd, grown, 2);
    let poll_buf = RawMem.alloc(16, 8);
    let _ = RawMem.store_int(poll_buf, rfd, 64);
    let _ = RawMem.store_int(poll_buf + 8, 1, 32);
    let _ = RawMem.store_int(poll_buf + 12, 0, 32);
    let ready = Fd.poll(poll_buf, 1, 50);
    let pr_n = Fd.read(rfd, grown + 16, 2);
    let _ = Fd.close(rfd);
    let _ = Fd.close(wfd);
    print(f"{p_rc},{ready},{pr_n}");

    // 8. ThreadCtl, ClockNowNs, SleepNs, OsRandom
    let cpus = Thread.ctl(2, 0);
    let t0 = Clock.now_ns(1);
    let sl = Clock.sleep_ns(1000);
    let rnd = Entropy.fill(grown, 32);
    print(f"{cpus >= 1},{pid > 0},{t0 > 0},{sl},{rnd}");

    // 9. FfiCall mismatched arch_kind=6 (wasm32_c) -> -43 (E_NOSYS)
    let abi_desc = RawMem.alloc(32, 8);
    let ret_regs = RawMem.alloc(80, 16);
    let _ = RawMem.fill(abi_desc, 0, 32);
    let _ = RawMem.fill(ret_regs, 0, 80);
    let _ = RawMem.store_int(abi_desc + 0, 6, 32);
    let _ = RawMem.store_int(abi_desc + 12, 65535, 16);
    let ffi_rc = Ffi.call_raw(4096, abi_desc, 0, 0, 0, ret_regs);
    print(ffi_rc);

    let _ = RawMem.free(abi_desc, 32, 8);
    let _ = RawMem.free(ret_regs, 80, 16);
    let _ = RawMem.free(poll_buf, 16, 8);
    let _ = RawMem.free(pipe_fds, 16, 8);
    let _ = RawMem.free(out_len_ptr, 8, 8);
    let _ = RawMem.free(shm_stat, 72, 8);
    let _ = RawMem.free(stat_buf, 72, 8);
    let _ = RawMem.free(path_buf, 256, 8);
    let _ = RawMem.free(grown, 256, 8);
}
