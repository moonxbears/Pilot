// A function may hold more `let`s than it has registers for locals, as
// long as few are in scope at once: a block's locals end with the block.
// sum(0..=129) = 8385; pick(2): a = 21, b = 107, 3*107 + 21*(0+1+2) = 384;
// pick(-1): a = -6, 321 - 6*3 = 303.

fn pick(n: i64) -> i64 {
    let a = if n > 0 { let x = n * 10; x + 1 } else { let y = n - 5; y };
    let b = { let z = 7; z } + { let w = 100; w };
    var total = 0;
    var i = 0;
    while i < 3 {
        let t = i * a;
        { let u = t + b; total = total + u; }
        i = i + 1;
    }
    return total;
}

