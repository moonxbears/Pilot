// GRAM008: `_ _` is two holes side by side with no symbol between them, so
// the pattern names no fixity (PROP-018 §1).
struct Money : IValue {
    pub cents: i64;
    pub pure op _ _ (rhs: Money) -> Money => Money { cents: .cents + rhs.cents };
}

fn main() {
    print(Money { cents: 5 }.cents);
}
