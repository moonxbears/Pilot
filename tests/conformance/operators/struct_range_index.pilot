// A struct that declares `op _[_]` taking a range gets `p[1 ..= 6]` as a
// call of that operator with the range 1..=6, built as a value of the
// operator's parameter type (PROP-027). A string index by a range is still
// a slice.
//
// Expected, worked by hand: the operator prints its receiver's text and
// the range's two ends -> "d[1..6]".
use Pilot.Core.Primitives.Span;

pub struct Pat : IObject {
    pub text: str;

    pub pure op _[_] (r: span<i64>) -> Pat => Pat { text: f"{.text}[{r.start}..{r.end}]" };
}

fn p(t: str) -> Pat => Pat { text: t };

fn main() {
    let d = p("d");
    print(d[1 ..= 6].text);
}
