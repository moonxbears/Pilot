// An operator a struct declares applies to any value of that type,
// including the result of another operator call or of a method call:
// `a + b + c` is `(a + b) + c`. The seed finds the left operand's type from
// the declared return type of the operator or method that made it
// (PROP-026; before, it fell back to the machine `+`).
//
// Expected, worked by hand: `+` wraps its operands in parentheses, so
// e | f -> "(e | f)", a + b + c -> "((a b) c)", and `wrap` puts its
// text in brackets, so a.wrap() + b -> "([a] b)".
pub struct Pat : IObject {
    pub text: str;

    pub pure op + (rhs: Pat) -> Pat => Pat { text: f"({.text} {rhs.text})" };
    pub pure op | (rhs: Pat) -> Pat => Pat { text: f"({.text} | {rhs.text})" };
    pub fn wrap(self) -> Pat => Pat { text: f"[{.text}]" };
}

fn p(t: str) -> Pat => Pat { text: t };

fn main() {
    let e = p("e");
    let f = p("f");
    print((e | f).text);
    let a = p("a");
    let b = p("b");
    let c = p("c");
    print((a.wrap() + b).text);
    print((a + b + c).text);
}
