// F7: a postfix `?` that leaves the function must drop the owned values
// still live. Until the PilIR drop pass does that, the `?` stops at the
// `own.try_exit` seam.
struct Res {
    pub name: str;

    ~self() {
        print(f"drop {self.name}");
    }
}

fn half(n: i64) -> i64? {
    if n % 2 == 0 { return n / 2; }
    return none;
}

fn run(n: i64) -> i64? {
    let r = Res { name: "a" };
    let h = half(n)?;
    print(r.name);
    return h;
}

fn main() {
    print("before");
    print(run(4) ?? -1);
}
