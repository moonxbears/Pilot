// Enum variants that carry values: construction (qualified, `::` and bare),
// field access, and `switch` patterns that bind or test the values.
enum Shape {
    Circle(r: f64),
    Rect(w: f64, h: f64),
    Empty,
}

fn area(s: Shape) -> f64 {
    return switch s {
        case Circle(r): 3.0 * r * r;
        case Rect(w, h) if w == h: w * w;
        case Rect(w, h): w * h;
        case Empty: 0.0;
    };
}

fn kind(s: Shape) -> str {
    switch s {
        case Shape.Rect(1.0, _): return "thin rect";
        case Rect: return "rect";
        case Circle: return "circle";
        default: return "nothing";
    }
}

fn main() {
    let shapes = [Shape.Circle(2.0), Shape::Rect(3.0, 3.0), Rect(2.0, 5.0), Shape.Empty, Rect(1.0, 9.0)];
    for i in 0..shapes.len() {
        print(f"{area(shapes[i])} {kind(shapes[i])}");
    }
    print(Shape.Circle(1.5).r);
}
