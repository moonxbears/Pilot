// RFC 8259 JSON texts parsed by std.polyglot.transport.json: the two
// examples of RFC 8259 §13, the scalar texts of §13, number grammar (§6),
// string escapes (§7) and texts the grammar rejects. Expected values come
// from Python's json module on the same texts.
use std.polyglot.transport.json;

fn show_err(src: str) {
    let r = json_parse(src);
    if r.is_ok {
        print(f"accepted {src}");
    } else {
        print("rejected");
    }
}

fn main() {
    let image = json_parse("{\n  \"Image\": {\n      \"Width\":  800,\n      \"Height\": 600,\n      \"Title\":  \"View from 15th Floor\",\n      \"Thumbnail\": {\n          \"Url\":    \"http://www.example.com/image/481989943\",\n          \"Height\": 125,\n          \"Width\":  100\n      },\n      \"Animated\" : false,\n      \"IDs\": [116, 943, 234, 38793]\n    }\n}\n")?;
    print(image.query_path("Image.Width").num_val);
    print(image.query_path("Image.Title").str_val);
    print(image.query_path("Image.Thumbnail.Url").str_val);
    print(image.query_path("Image.Thumbnail.Height").num_val);
    print(image.query_path("Image.Animated").bool_val);
    let ids = image.query_path("Image.IDs");
    print(ids.len());
    print(ids.get_at(3).num_val);

    let places = json_parse("[\n  {\n     \"precision\": \"zip\",\n     \"Latitude\":  37.7668,\n     \"Longitude\": -122.3959,\n     \"Address\":   \"\",\n     \"City\":      \"SAN FRANCISCO\",\n     \"State\":     \"CA\",\n     \"Zip\":       \"94107\",\n     \"Country\":   \"US\"\n  },\n  {\n     \"precision\": \"zip\",\n     \"Latitude\":  37.371991,\n     \"Longitude\": -122.026020,\n     \"Address\":   \"\",\n     \"City\":      \"SUNNYVALE\",\n     \"State\":     \"CA\",\n     \"Zip\":       \"94085\",\n     \"Country\":   \"US\"\n  }\n]\n")?;
    print(places.len());
    print(places.get_at(0).get("Latitude").num_val);
    print(places.get_at(0).get("Longitude").num_val);
    print(places.get_at(1).get("Latitude").num_val);
    print(places.get_at(1).get("Longitude").num_val);
    print(places.get_at(1).get("City").str_val);
    print(places.get_at(0).get("Address").str_val.len());

    print((json_parse("\"Hello world!\"")?).str_val);
    print((json_parse("42")?).num_val);
    print((json_parse("true")?).bool_val);
    print((json_parse(" null ")?).kind == JsonKind::Null);

    print((json_parse("-0")?).num_val);
    print((json_parse("0.1")?).num_val);
    print((json_parse("1e-7")?).num_val);
    print((json_parse("123.456e-2")?).num_val);
    print((json_parse("2.5E+3")?).num_val);
    print((json_parse("-1.5e2")?).num_val);

    let esc = (json_parse("\"a\\\"b\\\\c\\/d\\ne\\u0041\\t\"")?).str_val;
    print(esc.len());
    print(esc.slice(0, 7));
    print(esc.byte_at(8));
    print(esc.slice(9, 10));

    let spaced = json_parse("  [ 1 ,\n\t2 , {\"k\" : [ ] , \"m\":{}} ]  ")?;
    print(spaced.len());
    print(spaced.get_at(2).get("k").len());
    print(spaced.stringify());

    show_err("01");
    show_err("1.");
    show_err(".5");
    show_err("[1, 2,]");
    show_err("{\"a\" 1}");
    show_err("[1] 2");
    show_err("\"tab\there\"");
    show_err("1e400");
    show_err("tru");
    show_err("");
}
