// `*..x` in a list literal gives the leaves of `x`: every list inside it is
// opened, at any depth, so the literal is a list of the leaves' type.
//
// Expected, worked by hand:
//   flat = [[1, 2], [3]]           leaves 1, 2, 3       -> [1, 2, 3]
//   deep = [[[4], [5, 6]], [[7]]]  leaves 4, 5, 6, 7    -> [4, 5, 6, 7]
//   with a plain item and a `*` item around it: 0, then 1 2 3, then the
//   two lists of `deep` unopened by `*`: their leaves are not reached, so
//   the sum adds only the ints -> 0 + 1 + 2 + 3 = 6
fn main() {
    let flat: List<List<i64>> = [[1, 2,], [3,],];
    let leaves: List<i64> = [*..flat];
    print(leaves);
    let deep: List<List<List<i64>>> = [[[4,], [5, 6,],], [[7,],],];
    let more: List<i64> = [*..deep];
    print(more);
    let mixed: List<i64> = [0, *..flat];
    var sum = 0;
    for x in mixed { sum = sum + x; }
    print(sum);
}
