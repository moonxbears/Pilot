// Inside a list literal, `*xs` adds xs's elements and `*..xs` adds its leaves
// at any depth. `splat(xs)` and `flat(xs)` are the readable spellings.
fn main() {
    let xs = [1, 2, 3];
    print([0, *xs, 99]);
    let nested = [[1, [2, 3]], [4]];
    print([*..nested, 5]);
    print([*nested]);
    print([splat(xs), flat(nested)]);
}
