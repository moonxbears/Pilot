// std.text.regex flags and Unicode classes against Python 3.12's `re`
// (Unicode 15.0, without re.ASCII unless the `a` flag is given). Each line:
// the leftmost match (byte offsets), then every match. Flags are given to
// `compile_with` or written inline; an error prints its code and Python's
// offset (all inline-flag errors are REGEX007, an unclosed scoped group
// REGEX001). Generated by a Python script that ran `re` on the same cases.
use std.text.regex;

fn show(p: str, flags: List<RegexFlag>, t: str) {
    let r = compile_with(p, flags);
    if !r.is_ok {
        print(f"error {r.err_val.code()} at {r.err_val.pos}");
        return;
    }
    let re = r.ok_val;
    var line = "none";
    if some m = re.find(t) {
        line = f"{m.start}..{m.end} [{m.text}]";
    }
    line = line + " |";
    for m in re.find_all(t) {
        line = line + f" {m.start}..{m.end} [{m.text}]";
    }
    print(line);
}

fn main() {
    show("hello", [RegexFlag::IgnoreCase], "Say HeLLo there");
    show("(?i)hello", [], "Say HeLLo there");
    show("[a-z]+", [RegexFlag::IgnoreCase], "123 ABCdef");
    show("[^a-z]+", [RegexFlag::IgnoreCase], "abcXYZ123def");
    show("(?i)σ+", [], "ΣΣ σς end");
    show("(?i)k", [], "K and k");
    show("(?i)k", [RegexFlag::Ascii], "K and K");
    show("(?ia)k", [], "K and K");
    show("(?i)straße", [], "STRASSE STRAẞE");
    show("(?i)é+", [], "cafÉé!");
    show("(?i)ǆ", [], "ǅ");
    show("(?i)[à-ö]+", [], "XÀÉÖy");
    show("(?i)\\bfoo\\b", [], "a FOO b");
    show("a(?i:b)c", [], "abc aBc ABC aBC");
    show("(?i)a(?-i:b)c", [], "ABC AbC aBc");
    show("(?i:a|b)+c", [], "ABAbc");
    show("^\\w+", [RegexFlag::Multiline], "ab cd\nef gh\n\nij");
    show("\\w+$", [RegexFlag::Multiline], "ab cd\nef gh\nij\n");
    show("(?m)^$", [], "a\n\nb\n");
    show("^\\w+", [], "ab cd\nef");
    show("\\w+$", [], "ab\ncd\n");
    show("a.c", [RegexFlag::DotAll], "a\nc");
    show("(?s)a.+", [], "xa\nb\nc");
    show("(?s:a.)b", [], "a\nb");
    show("a.c", [], "a\nc abc");
    show(" a b  # comment\\n c ", [RegexFlag::Verbose], "xx abc");
    show("(?x) [ ]+ \\d+ ", [], "x   42");
    show("(?x)a\\ b", [], "a b");
    show("(?x)a#b", [], "a#b a");
    show("(?mi)^AB", [], "x\nab");
    show("\\w+", [], "naïve café 日本語 x_1");
    show("\\w+", [RegexFlag::Ascii], "naïve café x_1");
    show("(?a)\\w+", [], "naïve café");
    show("\\d+", [], "x ٣٤5 ０９ 12");
    show("\\d+", [RegexFlag::Ascii], "x ٣٤5 12");
    show("\\s+", [], "a  b c");
    show("\\s+", [RegexFlag::Ascii], "a b c");
    show("\\W+", [], "ab, é!ü");
    show("[\\w-]+", [], "über-straße x");
    show("[^\\W\\d]+", [], "ab12çd3");
    show("\\bcafé\\b", [], "un café.");
    show("\\bcafé\\b", [RegexFlag::Ascii], "un cafés.");
    show("\\D+", [], "١٢abc٣");
    show("[\\s\\d]+", [], "ab 　٣ c");
    show("(?u)\\w+", [], "ñu");
    show("a(?i)b", [], "ab");
    show("(?-a:x)", [], "x");
    show("(?i", [], "x");
    show("(?i-i:a)", [], "a");
    show("(?-:a)", [], "a");
    show("(?i:a", [], "a");
}
