// Ed25519 against the published test vectors of RFC 8032 section 7.1
// (TEST 1: empty message; TEST 2: the one-byte message 0x72). Each key,
// signature and message below is copied from the RFC, never from this
// implementation. Expected output, by hand:
//   the public key from each secret key matches the RFC   -> true, true
//   the signature of each message matches the RFC         -> true, true
//   each RFC signature verifies under its public key      -> true, true
//   TEST 1's signature does not verify for message 0x72   -> false
//   TEST 2's signature with its last byte changed fails   -> false
use std.crypto.ed25519;

fn main() {
    let sk1 = "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60";
    let pk1 = "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a";
    let sig1 = "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b";
    let sk2 = "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb";
    let pk2 = "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c";
    let sig2 = "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00";
    print(ed25519_public_key_hex(sk1) == pk1);
    print(ed25519_public_key_hex(sk2) == pk2);
    print(ed25519_sign_hex(sk1, "") == sig1);
    print(ed25519_sign_hex(sk2, "72") == sig2);
    print(ed25519_verify_hex(pk1, "", sig1));
    print(ed25519_verify_hex(pk2, "72", sig2));
    print(ed25519_verify_hex(pk1, "72", sig1));
    print(ed25519_verify_hex(pk2, "72", sig2.slice(0, 126) + "01"));
}
