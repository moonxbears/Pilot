// An `=> expr` function body is compiled against the declared return type,
// as `return` and a typed `let` are, so a target-typed variant whose name
// two enums share (`::Shared`) resolves there. It used to be DECL001
// "undefined" (known bug seed.expr_body_variant_hint, fixed by PROP-015 A).
//
// Expected, by hand: `Shade` is { Light = 0, Shared = 1 }, so each of the
// three lines prints 1.
enum Tone : u8 {
    Shared,
    Loud,
}

enum Shade : u8 {
    Light,
    Shared,
}

fn by_return() -> Shade { return ::Shared; }
fn by_arrow() -> Shade => ::Shared;

fn main() {
    let s: Shade = ::Shared;
    print(s as i64);
    print(by_return() as i64);
    print(by_arrow() as i64);
}
