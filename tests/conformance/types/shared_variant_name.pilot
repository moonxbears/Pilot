// F4: when two enums have a variant with the same name, `::Variant` passed
// as a call argument takes its enum from the parameter type.
enum Shape : u8 {
    Dot,
    Value,
}

enum Slot : u8 {
    Empty,
    Value,
}

fn is_value(s: Slot) -> bool => s == ::Value;

fn main() {
    print(is_value(::Value));
}
