// The symbolic type forms are `syntax type_construct` rules
// (stdlib/core/syntax/type_construct.pilot): `T[]` is `slice<T>`, `T?` is
// `option<T>`, `T ! E` is `result<T, E>` and `(A) => R` is `fn<A, R>`.
// Each symbolic form and its readable twin hold the same values.
//
// Expected output, worked by hand:
//   first of i64[] [4, 5] is 4; of slice<i64> [6] is 6.
//   half(8): 8 is even -> 4; half(3) is none -> "none" via `??` -1 -> -1.
//   parse_digit("7") is ok 7; "x" fails with "not a digit".
//   twice applies (n) => n + 3 twice to 1: 1 + 3 + 3 = 7.
fn first(xs: i64[]) -> i64 => xs[0];
fn first_long(xs: slice<i64>) -> i64 => xs[0];

fn half(n: i64) -> i64? {
    if n % 2 == 0 { return n / 2; }
    return none;
}

fn parse_digit(s: str) -> i64 ! str {
    if s == "7" { return 7; }
    return fail("not a digit");
}

fn twice(f: (i64) => i64, x: i64) -> i64 => f(f(x));

fn main() {
    let a: List<i64> = [4, 5];
    print(first(a));
    let b: List<i64> = [6];
    print(first_long(b));
    print(half(8) ?? -1);
    print(half(3) ?? -1);
    let d = parse_digit("7") catch e => -1;
    print(d);
    let bad = parse_digit("x") catch e => { print(e); -1 };
    print(bad);
    print(twice((n) => n + 3, 1));
}
