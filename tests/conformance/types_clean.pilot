// A well-typed program: the type checker reports nothing, and it runs.
// Generic functions and structs, optional and fallible values, closures,
// enums switched over exhaustively, numeric literals of several widths.
struct Pair {
    pub left: i64;
    pub right: i64;
}

struct Holder<T: IAnyValue> {
    pub item: T;
}

enum Shade {
    Light,
    Dark,
}

fn first_of<T: IAnyValue>(a: T, _b: T) -> T {
    return a;
}

fn find(key: i64) -> Pair? {
    if key > 0 {
        return Pair { left: key, right: key * 2 };
    }
    return none;
}

fn halve(n: i64) -> i64 ! str {
    if n % 2 != 0 {
        return result<i64, str>.err("odd");
    }
    return n / 2;
}

fn quarter(n: i64) -> i64 ! str {
    let h = halve(n)?;
    return halve(h);
}

fn shade_name(s: Shade) -> str {
    return switch s {
        case ::Light: "light";
        case ::Dark: "dark";
    };
}

fn sign(n: i64) -> i64 {
    if n > 0 {
        return 1;
    } else if n < 0 {
        return -1;
    }
    return 0;
}

fn spin(limit: i64) -> i64 {
    var k = 0;
    while true {
        k = k + 1;
        if k >= limit {
            return k;
        }
    }
}

fn main() {
    let small: i32 = 7;
    let ratio: f64 = 2.5;
    let total = small as i64 + 1;
    print(total);
    print(ratio * 2.0);

    let h = Holder<str> { item: "kept" };
    print(h.item);
    print(first_of(3, 4));

    if some p = find(5) {
        print(p.left + p.right);
    }
    let missing = find(-1);
    print(missing == none);

    let q = find(2) ?? Pair { left: 0, right: 0 };
    print(q.right);

    print(quarter(8) catch e => -1);
    print(quarter(6) catch e => -1);

    let double = (x) => x * 2;
    print(double(21));

    print(shade_name(Shade::Dark));
    print(sign(-9));
    print(spin(3));

    let items: i64[] = [1, 2, 3];
    var sum = 0;
    for v in items {
        sum = sum + v;
    }
    print(sum);
}
