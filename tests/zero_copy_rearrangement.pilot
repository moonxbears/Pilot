// Zero-Copy Type Rearrangement, SliceMap Lens Projections & Compile-Time Offset Swizzling Test Suite

struct PacketRecord {
    timestamp: u64
    flow_id: u32
    flags: u16
    payload: Slice[u8]
}

struct FlowSummary {
    payload: Slice[u8]
    flow_id: u32
}

struct Rgba {
    r: u8
    g: u8
    b: u8
    a: u8
}

struct Vector3 {
    x: f32
    y: f32
    z: f32
}

def main() {
    print("=== TIER A: Isomorphic Bit-Cast ===");
    let color = Rgba(r: 255, g: 128, b: 64, a: 32);
    let u32_val = color as u32;
    print("Rgba as u32:", u32_val);

    let unpacked = u32_val as (u8, u8, u8, u8);
    print("u32 as tuple:", unpacked);

    let v1 = Vector3(x: 1.0, y: 2.0, z: 3.0);
    let v2 = Vector3(x: 4.0, y: 5.0, z: 6.0);
    let vec_slice = [v1, v2];
    let f32_slice = vec_slice as Slice[f32];
    print("Slice[Vector3] as Slice[f32]:", f32_slice);
    print("f32_slice len:", len(f32_slice));

    print("=== TIER B: Compile-Time Offset Swizzling ===");
    let p1 = PacketRecord(timestamp: 1000, flow_id: 0x1A2B, flags: 1, payload: [10, 20, 30]);
    let p2 = PacketRecord(timestamp: 2000, flow_id: 0x3C4D, flags: 2, payload: [40, 50, 60]);
    let buffer = [p1, p2];

    let summaries = buffer as SliceView[FlowSummary];
    print("SliceView len:", len(summaries));
    print("summaries[0].flow_id:", summaries[0].flow_id);
    print("summaries[0].payload:", summaries[0].payload);
    print("summaries[1].flow_id:", summaries[1].flow_id);
    print("summaries[1].payload:", summaries[1].payload);

    let single_view = p1 as view FlowSummary;
    print("single_view.flow_id:", single_view.flow_id);
    print("single_view.payload:", single_view.payload);

    print("=== TIER C: Zero-Copy SliceMap Projections ===");
    let by_flow = buffer.map_view(key: .flow_id, val: .payload);
    print("by_flow[0x1A2B]:", by_flow[0x1A2B]);
    print("by_flow[0x3C4D]:", by_flow[0x3C4D]);

    let by_time = buffer.map_view(key: .timestamp, val: self);
    let t_rec = by_time[1000];
    print("by_time[1000].flow_id:", t_rec.flow_id);

    let keys_slice = by_flow.keys;
    let vals_slice = by_flow.values;
    print("by_flow.keys:", keys_slice);
    print("by_flow.values:", vals_slice);

    let inverted = by_flow.invert();
    let search_key = [10, 20, 30];
    print("inverted lookup:", inverted[search_key]);

    let soa_keys = [101, 102, 103];
    let soa_vals = [999, 888, 777];
    let soa_map = SliceMap.from_soa(keys: soa_keys, vals: soa_vals);
    print("soa_map[102]:", soa_map[102]);
    print("soa_map[103]:", soa_map[103]);

    print("ALL TESTS PASSED SUCCESSFULLY");
}
