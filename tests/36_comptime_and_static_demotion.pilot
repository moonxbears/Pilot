// =============================================================================
// Test 36: Rigorous Runtime-to-Compile-Time Demotion & First-Class `comptime`
// =============================================================================

println("=== Test 36: Comptime & Static Demotion ===");

// 1. First-class `comptime def` and `comptime(...)` evaluation
comptime def compute_factorial(n: int) -> int {
    var acc = 1;
    for i in 2..=n {
        acc = acc * i;
    }
    return acc;
}

const FACT_6 = comptime(compute_factorial(6));
comptime assert FACT_6 == 720, "6! must equal 720 at compile time";
assert FACT_6 == 720;

// 2. `comptime { ... }` block producing a frozen array in `.rodata`
let CUBES = comptime {
    var items = [];
    for i in 1..=6 {
        items.append(i * i * i);
    }
    return items;
};

assert CUBES.is_frozen == true;
assert CUBES[0] == 1;
assert CUBES[5] == 216;

// 3. Frozen minimal perfect-hash lookup table (`PilotFrozenMap`)
const OPCODE_TABLE = comptime({
    "NOP": 0,
    "ADD": 10,
    "SUB": 20,
    "MUL": 30,
    "DIV": 40,
    "HALT": 255
});

assert OPCODE_TABLE.is_frozen == true;
assert OPCODE_TABLE.is_perfect_hash == true;
assert OPCODE_TABLE["ADD"] + OPCODE_TABLE["MUL"] + OPCODE_TABLE["HALT"] == 295;

// 4. `comptime` function parameters (compile-time specialization & loop unrolling)
def fixed_poly(x: int, comptime degree: int) -> int {
    var result = 0;
    var power = 1;
    for d in 0..=degree {
        result += power;
        power = power * x;
    }
    return result;
}

// 1 + 3 + 9 + 27 = 40
let poly_val = fixed_poly(3, 3);
assert poly_val == 40;

// 5. Lexical Upvalue Display (`LoadUpvalue` / `StoreUpvalue`)
def make_stepper(initial: int, step: int) -> int {
    var current = initial;
    def advance(times: int) -> int {
        current += step * times;
        return current;
    }
    let first = advance(2);
    let second = advance(3);
    return first + second;
}

// first = 10 + 6 = 16, second = 16 + 9 = 25 -> 41
assert make_stepper(10, 3) == 41;

// 6. Static Field Slot Indexing (`GetFieldSlot` / `SetFieldSlot`) & DTO `->` Projection
struct RawFrame {
    var seq: int;
    var tag: str;
    var payload: int;
}

struct CompactFrame {
    var payload: int;
    var seq: int;
}

@zero_runtime
def transform_frame(f: RawFrame) -> CompactFrame {
    f.payload = f.payload + 50;
    return f -> CompactFrame;
}

var raw = RawFrame(7, "telemetry", 450);
let compact = transform_frame(raw);
assert compact.seq == 7;
assert compact.payload == 500;

// 7. Compile-time unit erasure (`<unit_expr>`) and O(1) `with context` display slots
def compute_impulse(force: float, dt: float, context gain: float = 1.0) -> float {
    let base_impulse = 10.0<N> * 2.5<s>;
    return (base_impulse + (force * dt)) * gain;
}

let imp_default = compute_impulse(20.0, 1.5);
var imp_boosted = 0.0;
with context(gain = 2.0) {
    imp_boosted = compute_impulse(20.0, 1.5);
}
assert imp_default == 55.0;
assert imp_boosted == 110.0;

println("[PASS] Test 36: Comptime & Static Demotion succeeded!");
