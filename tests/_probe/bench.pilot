use std.text.regex;

fn main() {
    var text = "";
    var i = 0;
    while i < 2000 {
        text = text + f"user{i}@host{i % 7}.example.com wrote 2024-0{i % 9 + 1}-1{i % 10} some filler words here; ";
        i = i + 1;
    }
    let email = must_compile(r"(\w+)@(\w+)\.com");
    let date = must_compile(r"\d{4}-\d\d-\d\d");
    let lit = must_compile(r"filler");
    print(email.find_all(text).len());
    print(date.find_all(text).len());
    print(lit.find_all(text).len());
    print(text.len());
}
