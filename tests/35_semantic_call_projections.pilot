// ============================================================================
// Milestone 18: Advanced Semantic Call Projections (!^, !@, !?)
// ============================================================================

def ComputeImpulse(mass: float, velocity: float) -> float:
    return 0.5 * mass * (velocity * velocity)

// ─── 1. Mode 6: Symbolic Adjoint Differentiation + CSE (`fn!@(a, b)`) ───
let dual = ComputeImpulse!@(10.0, 5.0)
assert(dual == (125.0, 12.5, 50.0), "ComputeImpulse!@(10.0, 5.0) must equal (125.0, 12.5, 50.0)")
assert(dual.Value == 125.0, "Primal value must be 125.0")
assert(dual.dP_0 == 12.5, "d(ComputeImpulse)/d(mass) must be 12.5")
assert(dual.dP_1 == 50.0, "d(ComputeImpulse)/d(velocity) must be 50.0")
assert(dual.d_mass == 12.5, "Named gradient d_mass must be 12.5")
assert(dual.d_velocity == 50.0, "Named gradient d_velocity must be 50.0")
assert(dual.cse_count >= 1, "CSE must eliminate shared (velocity * velocity) subexpression")

let (primalVal, dMass, dVel) = ComputeImpulse!@(10.0, 5.0)
assert(primalVal == 125.0 and dMass == 12.5 and dVel == 50.0, "Tuple destructuring of Dual value")

// ─── 2. Mode 7: Copy-on-Write Transactional Effect Dry-Run (`fn!?(a, b)`) ───
class RecordBox:
    def __init__(self, v: int):
        self.Val = v

def MutateRecord(rec, newVal: int) -> int:
    let prev = rec.Val
    rec.Val = newVal
    return rec.Val + prev

let rec = RecordBox(10)
let plan = MutateRecord!?(rec, 42)

// Live memory is untouched during dry-run!
assert(rec.Val == 10, "Live record must remain unmutated (10) after dry-run MutateRecord!?(rec, 42)")
assert(plan.Value == 52, "Dry-run return value must reflect shadow read-after-write (42 + 10 = 52)")
assert(plan.diff_count == 1, "Dry-run must capture exactly 1 StoreField diff")
assert(plan.Diffs[0].Kind == "StoreField", "Captured diff kind must be StoreField")
assert(plan.Diffs[0].OldValue == 10 and plan.Diffs[0].NewValue == 42, "Diff must log 10 -> 42")

let committedVal = plan.Commit()
assert(committedVal == 52, "Commit() returns plan value")
assert(rec.Val == 42, "After Commit(), live record field is updated to 42")

// ─── 3. Mode 5: Glitch-Free Reactive Signal Graph (`fn!^(a, b)`) ───
class Ship:
    def __init__(self, m: float, v: float):
        self.Mass = m
        self.Vel = v

let ship = Ship(10.0, 5.0)
let impulseSig = ComputeImpulse!^(ship.Mass, ship.Vel)
assert(impulseSig.Value == 125.0, "Initial reactive signal value must be 125.0")
assert(impulseSig.Rank == 1, "Computed signal from source properties has topological Rank 1")

// Mutating ship.Mass automatically propagates through the reactive signal graph!
ship.Mass = 20.0
assert(impulseSig.Value == 250.0, "Reactive signal updates to 250.0 when ship.Mass = 20.0")

ship.Vel = 10.0
assert(impulseSig.Value == 1000.0, "Reactive signal updates to 1000.0 when ship.Vel = 10.0")

// Diamond dependency graph (A -> B, C -> D) glitch-free single evaluation per wave:
def Scale2(x: float) -> float:
    return x * 2.0

def Scale3(x: float) -> float:
    return x * 3.0

def Combine(b: float, c: float) -> float:
    return b + c

let srcA = signal(4.0, "srcA")
let sigB = Scale2!^(srcA)
let sigC = Scale3!^(srcA)
let sigD = Combine!^(sigB, sigC)

assert(sigD.Value == 20.0, "Initial diamond sink D = 4*2 + 4*3 = 20.0")
assert(sigD.Rank == 2, "Diamond sink D has topological Rank 2")
let evalsBefore = sigD.EvalCount
srcA.set(10.0)
assert(sigD.Value == 50.0, "Updated diamond sink D = 10*2 + 10*3 = 50.0")
assert(sigD.EvalCount == evalsBefore + 1, "Glitch-free topological queue must evaluate diamond sink D exactly once")

println("35_semantic_call_projections: ALL PASSED")
