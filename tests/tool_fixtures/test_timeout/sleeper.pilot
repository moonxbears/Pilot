// A case that sleeps 60 s, then prints what its .stdout expects; with
// `--timeout 10` it is reported as timed out long before. It sleeps rather
// than spins, so a run that cannot stop it (seam `bridge.proc_signal`) leaves
// no CPU busy.
fn main() {
    Clock.sleep_ns(60000000000);
    print("done");
}
