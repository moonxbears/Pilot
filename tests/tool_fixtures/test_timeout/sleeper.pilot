// A case that spins for 60 s, then prints what its .stdout expects; with
// `--timeout 10` it is reported as timed out long before, and killed
// (PROP-028), so it does not keep a CPU busy for the rest of the minute.
fn main() {
    let end = Clock.now_ns(1) + 60000000000;
    while Clock.now_ns(1) < end {}
    print("done");
}
