// Test 37: Compile-Time Generator Metaprogramming
// Demonstrates in-class generator: and comptime: blocks with loop unrolling,
// heterogeneous sequences, tuple unpacking, and templated member synthesis.

class Apples {
    // 1. Heterogeneous loop unrolling over strings and numeric ranges
    generator:
        for i in ["test", "also_test", 1..=3] {
            var f"field_{i}": int = 0;

            def f"get_{i}"(self) -> int {
                return self.f"field_{i}";
            }

            def f"set_{i}"(self, v: int) {
                self.f"field_{i}" = v;
            }
        }

    // 2. Tuple unrolling with key-value defaults
    generator:
        for (prop, default_val) in [("alpha", 10), ("beta", 20)] {
            var f"config_{prop}": int = default_val;

            def f"get_config_{prop}"(self) -> int {
                return self.f"config_{prop}";
            }
        }

    // 3. Compile-time conditional generation inside loops
    generator:
        for item in ["flag", 100] {
            if item is str {
                var f"is_str_{item}": bool = true;
            } else {
                var f"num_{item}": int = 42;
            }
        }
}

// Verification: Instantiate and test generated fields & methods
let a = Apples();

// Test unrolled field access & setters
a.set_test(101);
a.set_also_test(202);
a.set_1(303);
a.set_2(404);
a.set_3(505);

assert(a.get_test() == 101);
assert(a.get_also_test() == 202);
assert(a.get_1() == 303);
assert(a.get_2() == 404);
assert(a.get_3() == 505);

// Test tuple unrolling
assert(a.get_config_alpha() == 10);
assert(a.get_config_beta() == 20);

// Test conditional generation
assert(a.is_str_flag == true);
assert(a.num_100 == 42);