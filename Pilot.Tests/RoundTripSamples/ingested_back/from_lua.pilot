def gcd(a, b) {
    var x = a;
    var y = b;
    while y != 0 {
        let rem = x % y;
        x = y;
        y = rem;
    }
    return x;
}
def compute_weighted_sum(limit, scale) {
    let base_bonus = (limit + 2) * scale;
    var total = base_bonus;
    for i in 1..limit {
        if i % 2 == 0 {
            total = total + i * scale;
        } elif i == 5 {
            total = total + 10;
        } else {
            total = total + i;
        }
    }
    return total;
}
