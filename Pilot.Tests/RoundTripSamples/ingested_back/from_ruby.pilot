// Converted & optimized from Ruby to Pilot


// Pilot Bidirectional Multi-Language Round-Trip Showcase
// Exercises enums, ADTs, type extensions, classes, typed functions,
// while/for loops, elif branching, precedence, comprehensions, f-strings, and assertions.
enum Priority { Low = 1, Medium = 2, High = 3 }
type Shape = Circle(r: any) | Rect(w: any, h: any);

extend i64 {
    def doubled(self) {
        return self * 2;
    }
}

class Counter {
    def step(self, x, delta) {
        return x + delta;
    }
}

def gcd(a, b) {
    var x = a;
    var y = b;
    while y != 0 {
        let rem = x % y;
        x = y;
        y = rem;
    }
    return x;
}

def compute_weighted_sum(limit, scale) {
    let base_bonus = (limit + 2) * scale;
    var total = base_bonus;
    for i in 1..limit {
        if i % 2 == 0 {
            total += i * scale;
        } elif i == 5 {
            total += 10;
        } else {
            total += i;
        }
    }
    return total;
}

const BASE_SCALE = 3;
let g = gcd(48, 18);
let weighted = compute_weighted_sum(5, BASE_SCALE);
let squares = [x * x for x in 1..6 if x > 2];
assert g == 6;
assert weighted == 53;
println(f"GCD={g}, Weighted={weighted}");
